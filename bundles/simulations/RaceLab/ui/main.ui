<logic src="../logic/main.logic" />
<data><collection name="scenarios" as="scenarios" /></data>
<style>
.rl{--bg:#080f0d;--panel:#111d18;--panel2:#17271f;--line:#33483b;--ink:#f4f2e8;--muted:#b1c1b5;--gold:#e9c77e;--green:#a8e1b7;background:var(--bg);color:var(--ink);min-height:100%;font:15px/1.5 system-ui,-apple-system,sans-serif}.rl *{box-sizing:border-box}.rl button,.rl input,.rl select,.rl textarea{font:inherit}.rl button{cursor:pointer}.rl button:focus-visible,.rl input:focus-visible,.rl select:focus-visible,.rl textarea:focus-visible{outline:3px solid #a6e6cb;outline-offset:3px}.top{border-bottom:1px solid #ffffff15;background:#0d1813}.top-inner{max-width:1680px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:15px;padding:17px 32px}.brand{font:700 25px Georgia,serif;letter-spacing:-1px}.brand em{color:var(--gold);font-style:normal}.top-meta{display:flex;align-items:center;gap:10px}.top-badge,.tag{border:1px solid #ffffff2b;border-radius:30px;padding:6px 11px;color:#c1d0c5;font-size:10px;letter-spacing:.7px;font-weight:700;text-transform:uppercase;white-space:nowrap}.live-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#80d5a0;margin-right:6px}.shell{max-width:1680px;margin:auto;padding:30px 32px}.intro{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:22px}.intro h1{font:normal clamp(32px,4.2vw,55px)/1.02 Georgia,serif;letter-spacing:-1.5px;margin:8px 0}.intro p,.muted{color:var(--muted);margin:0}.eyebrow{color:var(--gold);font-size:10px;font-weight:800;letter-spacing:1.7px;text-transform:uppercase}.intro-stat{border-left:1px solid #445349;padding-left:20px;min-width:126px}.intro-stat strong{display:block;font:normal 25px Georgia,serif}.intro-stat span{font-size:11px;color:var(--muted)}.notice{border:1px solid #6d5b38;background:#2b2518;color:#efdaa9;border-radius:10px;padding:11px 14px;margin:0 0 20px;font-size:12px;line-height:1.5}.workspace{display:grid;grid-template-columns:minmax(0,1.9fr) minmax(310px,.8fr);gap:18px;align-items:start}.stack{display:grid;gap:18px;min-width:0}.card{background:var(--panel);border:1px solid var(--line);border-radius:15px;overflow:hidden;min-width:0}.card-head{padding:18px 20px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:15px}.card-head h2{font:normal 24px/1.1 Georgia,serif;margin:3px 0 0}.body{padding:20px}.broadcast{background:#07120c}.scene{height:clamp(380px,44vw,610px);min-height:380px;position:relative;overflow:hidden;background:#1b3829}.canvas{position:absolute;inset:0}.fallback{position:absolute;inset:0;display:grid;place-content:center;text-align:center;background:radial-gradient(ellipse at center,#315a3a,#10251a 70%);color:#d9e9d8}.fallback strong{font:normal 34px Georgia,serif}.fallback span{font-size:13px}.overlay{position:absolute;inset:0;pointer-events:none;display:flex;flex-direction:column;justify-content:space-between;padding:17px;background:linear-gradient(180deg,#06100acc 0%,transparent 24%,transparent 66%,#05110de6 100%)}.scorebar{display:flex;align-items:stretch;gap:2px}.racebadge,.phase,.distance{background:#0a1711df;border:1px solid #ffffff35;padding:8px 12px}.racebadge{border-radius:7px 0 0 7px;color:var(--gold);font-size:10px;font-weight:800;letter-spacing:1.2px}.phase{font-weight:800;font-size:12px;text-transform:uppercase;letter-spacing:.7px}.distance{border-radius:0 7px 7px 0;margin-left:auto;text-align:right;font-variant-numeric:tabular-nums}.distance strong{display:block;font-size:16px}.distance span{display:block;color:#c2d3c6;font-size:10px}.scene-caption{display:flex;align-items:end;justify-content:space-between;gap:12px}.scene-caption strong{font:normal 26px Georgia,serif;text-shadow:0 2px 10px #000}.scene-caption span{display:block;color:#d3e0d5;font-size:11px}.scene-legend{font-size:10px;color:#e5eee7;text-align:right}.progress{height:5px;background:#4a6652}.progress-fill{height:5px;background:var(--gold);max-width:100%;min-width:0}.control-row{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:14px 18px}.rl button{min-height:42px;border:1px solid #4b6253;color:var(--ink);background:#20342a;border-radius:8px;padding:8px 12px;font-weight:650}.rl button.primary{background:var(--gold);border-color:var(--gold);color:#1d2417}.rl button.active{color:#172b1d;background:#bddfc4;border-color:#bddfc4}.rl button.quiet{background:transparent}.rl button:hover{filter:brightness(1.12)}.controls-label{font-size:10px;text-transform:uppercase;letter-spacing:1px;color:var(--muted);font-weight:700;margin-left:6px}.control-group{display:flex;gap:4px}.control-group button{min-width:42px}.control-group .active{font-weight:800}.leaders{border-top:1px solid #ffffff1e;padding:12px 18px 15px}.leader-head{display:flex;justify-content:space-between;gap:10px;margin-bottom:10px}.leader-strip{display:flex;gap:7px;overflow:auto;padding-bottom:4px;scrollbar-width:thin}.runner-chip{flex:0 0 auto;min-width:115px;max-width:155px;display:flex;gap:8px;align-items:center;padding:8px 9px;background:#1a2d22;border:1px solid #46604c;border-radius:8px}.runner-chip .rank{color:var(--gold);font-weight:800;font-size:13px}.chip-name{font-size:11px;line-height:1.2;white-space:normal}.chip-name strong{display:block;font-size:11px}.swatch{flex:none;width:8px;height:28px;border-radius:3px}.help,.small{font-size:12px;color:var(--muted);line-height:1.55}.formrow{display:flex;flex-wrap:wrap;gap:9px;align-items:end}.formrow>div{flex:1;min-width:90px}.rl label{display:block;color:var(--muted);font-size:12px;font-weight:650;margin:12px 0 6px}.rl input,.rl select,.rl textarea{width:100%;min-height:44px;background:#0b1711;border:1px solid #4b6253;color:var(--ink);padding:9px 11px;border-radius:8px;font-size:16px}.rl textarea{min-height:170px;resize:vertical;font-family:monospace;font-size:12px;line-height:1.6}.divider{height:1px;background:var(--line);margin:20px 0}.result{background:#0c1b13;border:1px solid #55785b;border-radius:12px;padding:16px;margin-top:16px}.result strong{font:normal 38px Georgia,serif;color:var(--gold)}.button-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:17px}.button-row .primary{flex:1}.error{color:#ffc2b2}.field-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.horse{display:flex;align-items:center;gap:10px;text-align:left;min-width:0!important;padding:10px!important;background:#15271c!important;border-color:#3a5041!important}.field-card{min-width:0;border:1px solid #3a5041;border-radius:8px;overflow:hidden;background:#15271c}.field-card .horse{width:100%;border:0!important;border-radius:0!important}.fold{color:var(--muted)}.fold summary{cursor:pointer;font-weight:700;color:var(--ink);font-size:14px}.field-card .fold{padding:0 11px 10px;font-size:11px}.field-card .fold summary{font-size:11px;color:#bcd6c0}.field-card .fold p{margin:7px 0 0}.result textarea{min-height:90px;font-size:11px}.horse.chosen{background:#283f2a!important;border-color:#d7be7b!important}.horse.inactive{opacity:.55}.saddle{display:grid;place-items:center;flex:none;border-radius:6px;width:33px;height:33px;font-weight:850;font-size:13px;color:#122118;background:#e4d3a1}.horse-name{font-size:13px;font-weight:750;overflow-wrap:anywhere}.horse-sub{font-size:10px;color:#b7c9ba;line-height:1.4}.tickmark{margin-left:auto;color:var(--gold);font-size:18px}.finish-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}.finish-row{display:flex;align-items:center;gap:10px;background:#182a20;border:1px solid #354e3c;border-radius:8px;padding:9px 11px;min-width:0}.finish-rank{color:var(--gold);font:normal 20px Georgia,serif;width:25px;flex:none}.finish-name{font-weight:700;min-width:0;overflow-wrap:anywhere}.finish-gap{margin-left:auto;color:var(--muted);font-size:11px;white-space:nowrap}.finish-outcome{background:#243925;border:1px solid #526f50;border-radius:9px;padding:12px 14px;margin-bottom:14px;font-size:13px}.forecast-table{width:100%;border-collapse:collapse;font-size:13px}.forecast-table th{text-align:left;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.8px;padding:10px 9px;border-bottom:1px solid var(--line)}.forecast-table td{padding:10px 9px;border-bottom:1px solid #ffffff12;vertical-align:top}.forecast-table th:not(:first-child),.forecast-table td:not(:first-child){text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}.forecast-name{font-weight:750}.forecast-row-detail{margin-top:5px}.forecast-row-detail summary{font-size:11px;color:#a8c1ac}.forecast-row-detail p{margin:6px 0;line-height:1.5}.forecast-value{color:#efd697;font-weight:750}.foot{margin:24px 0;color:#a0b3a5;font-size:12px}.rl a{color:#e7cc8e}@media(max-width:1050px){.workspace{grid-template-columns:1fr}.scene{height:490px}.field-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.top-inner{padding:15px 22px}.shell{padding:25px 22px}}@media(max-width:620px){.top-inner{padding:14px}.top-badge{font-size:9px}.shell{padding:20px 13px}.intro{display:block}.intro-stat{display:none}.intro h1{font-size:37px}.scene{height:320px;min-height:320px}.overlay{padding:10px}.scorebar{gap:1px}.racebadge,.phase,.distance{padding:7px 8px}.scene-caption strong{font-size:21px}.scene-legend{max-width:115px}.field-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.finish-grid{grid-template-columns:1fr}.body,.card-head{padding:16px}.card-head{flex-wrap:wrap}.card-head .tag{white-space:normal}.control-row{padding:12px;gap:6px}.control-row>button{flex:1}.controls-label{width:auto}.leader-strip{margin-right:-4px}.rl textarea{font-size:12px}.top-meta .top-badge:first-child{display:none}}@media(max-width:360px){.field-grid{grid-template-columns:1fr}.racebadge{display:none}.scene{height:280px;min-height:280px}.horse{min-height:54px}}
.ensemble{border-color:#6a714b}.batch-summary{color:var(--gold);font-weight:750;margin:0 0 16px}.ensemble h3{font-size:15px;margin:0 0 6px}.batch-progress{width:100%;height:10px;accent-color:var(--gold)}.combo-list{display:grid;gap:7px}.combo-row{display:flex;gap:10px;align-items:center;padding:11px 0;border-bottom:1px solid #ffffff14;font-size:13px}.combo-rank{color:var(--gold);width:18px;flex:none}.combo-name{min-width:0;flex:1;overflow-wrap:anywhere}.combo-row strong{color:var(--gold);text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}.combo-row small{display:block;font-size:11px;color:var(--muted);font-weight:400;margin-top:4px}.ensemble-fold{margin-top:18px}.ensemble-fold textarea{margin-top:12px}.consensus-grid{display:grid;grid-template-columns:1fr 1fr;gap:5px 20px}.consensus-row{display:flex;justify-content:space-between;gap:10px;font-size:12px;padding:6px 0;border-bottom:1px solid #ffffff12}@media(max-width:620px){.consensus-grid{grid-template-columns:1fr}.forecast-table{font-size:12px}.forecast-table th,.forecast-table td{padding:9px 5px}.forecast-table th{font-size:9px}.combo-row{font-size:12px}}

/* Responsive refinement: content order matches keyboard order at every width. */
.workspace{grid-template-areas:"race studio" "race tools";grid-template-rows:auto 1fr}
.studio-stack{grid-area:studio}.race-stack{grid-area:race}.tools-stack{grid-area:tools}
.rl{overflow-wrap:break-word}.rl :where(button,input,select,textarea){max-width:100%;touch-action:manipulation}
.rl button{min-height:44px}.rl button:disabled{cursor:default;filter:none;opacity:.55}
.rl button:focus-visible,.rl a:focus-visible,.rl summary:focus-visible{outline:3px solid #a6e6cb;outline-offset:3px}
.rl h1,.rl h2,.rl h3,.rl p{overflow-wrap:anywhere}.card-head>div{min-width:0}
.rl section[id]{scroll-margin-top:16px}.section-nav{display:flex;flex-wrap:wrap;gap:7px;margin:0 0 18px}
.section-nav a{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:8px 14px;border:1px solid var(--line);border-radius:9px;background:#122219;text-decoration:none;font-size:13px;font-weight:700}
.section-nav a:hover{background:#203b2a}.ticket-fold{margin-top:18px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:4px 0 10px}
.fold summary{min-height:44px;display:list-item;padding:11px 0;line-height:1.5;overflow-wrap:anywhere}
.fold summary::marker{color:var(--gold)}.fold[open]>summary{color:var(--gold)}.field-card .fold{padding-bottom:4px}
.field-card .fold summary,.forecast-row-detail summary{font-size:12px}.forecast-row-detail{margin-top:3px}
.horse-copy{min-width:0;flex:1}.horse-sub{overflow-wrap:anywhere}.horse{min-height:82px}.horse .tickmark{flex:none}
.forecast-wrap{max-width:100%;min-width:0}.forecast-table{table-layout:fixed}.forecast-table th:first-child{width:54%}
.forecast-table th:nth-child(2){width:18%}.forecast-table th:nth-child(3){width:28%}
.forecast-table th{white-space:normal!important;overflow-wrap:anywhere}.forecast-table td:first-child{overflow-wrap:anywhere}
.forecast-table .small{font-size:11px}.forecast-row-detail p{font-size:12px;white-space:normal}
.rl textarea{max-height:65vh;overflow:auto;tab-size:2}.rl textarea[readonly]{color:#c6dccd;min-height:150px}
.control-setting{display:flex;align-items:center;gap:7px}.control-group{min-width:0}.control-group button{min-width:44px}
.camera-setting{flex:1;min-width:280px}.camera-setting .control-group{flex:1}.camera-setting button{flex:1}
.controls-label{margin:0}.leader-head{flex-wrap:wrap}.leader-strip{overscroll-behavior-x:contain;scroll-snap-type:x proximity}.runner-chip{scroll-snap-align:start}
.batch-summary{font-size:13px}.ensemble .help{margin:6px 0 12px}.ensemble-fold{margin-top:10px;border-top:1px solid #ffffff12}
.ensemble-fold[open]{padding-bottom:10px}.ensemble-fold .button-row{margin-top:10px}
.consensus-row>span{min-width:0;overflow-wrap:anywhere}.consensus-row strong{flex:none;font-variant-numeric:tabular-nums}
@media(max-width:1050px){
 .workspace{grid-template-columns:minmax(0,1fr);grid-template-areas:"studio" "race" "tools";grid-template-rows:auto auto auto}
 .studio-stack>.card>.body{display:block}.studio-stack .formrow{display:inline-flex;vertical-align:top;width:calc(50% - 7px);margin-right:7px}
 .studio-stack .button-row .primary{flex:1 1 100%}.tools-stack{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}
 .tools-stack>#horse-data{grid-column:1/-1}.field-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:620px){
 .top-inner{gap:8px}.brand{font-size:24px}.top-meta{gap:0}.top-badge{font-size:8px;padding:6px 8px;letter-spacing:.4px}
 .shell{padding:18px 12px;padding-bottom:max(24px,env(safe-area-inset-bottom))}.intro{margin-bottom:16px}.intro h1{font-size:clamp(30px,8.8vw,38px)}.intro p{font-size:13px}
 .notice{font-size:12px;padding:11px 12px;margin-bottom:14px}.section-nav{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:5px;margin-bottom:14px}.section-nav a{font-size:11px;padding:7px 4px}
 .workspace,.stack{gap:14px}.body,.card-head{padding:14px}.card-head{gap:10px}.card-head h2{font-size:23px}.card-head>button{width:100%}
 .studio-stack .formrow{display:flex;width:100%;margin-right:0}.studio-stack .formrow>div{min-width:110px}.studio-stack .body>.help:first-child{margin-top:0}
 .studio-stack .button-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.studio-stack .button-row .primary{grid-column:1/-1}
 .tools-stack{grid-template-columns:minmax(0,1fr)}.tools-stack>#horse-data{grid-column:auto}
 .control-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;padding:12px}.control-row>button{width:100%;font-size:13px;padding:9px 6px;min-width:0}
 .control-row>button:first-child{grid-column:1/-1}.control-setting{grid-column:1/-1;min-width:0;display:grid;grid-template-columns:40px minmax(0,1fr);padding-top:4px}
 .control-group{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px}.control-group button{width:100%;font-size:12px;padding:8px 4px}
 .scene{height:340px;min-height:300px}.scorebar{display:grid;grid-template-columns:minmax(0,1fr) auto}.racebadge{display:none}.phase{border-radius:7px 0 0 7px;font-size:10px;align-content:center}.distance{margin:0;max-width:135px}.distance strong{font-size:13px}
 .scene-caption{align-items:end}.scene-caption strong{font-size:20px}.scene-caption span{font-size:9px}.scene-legend{font-size:9px;max-width:80px}.leaders{padding:12px}.leader-head .small{font-size:11px}
 .field-grid{grid-template-columns:minmax(0,1fr)}.horse{min-height:78px}.horse-name{font-size:14px}.horse-sub{font-size:11px}.field-card .fold summary{font-size:12px}
 .rl textarea{font-size:16px;line-height:1.45;min-height:160px}.rl textarea[readonly]{font-size:13px}.result textarea{font-size:13px}
 .forecast-table,.forecast-table tbody{display:block}.forecast-table thead{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
 .forecast-table tr{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));padding:10px 12px;margin:9px 0;border:1px solid #3a5041;border-radius:10px;background:#13251b}
 .forecast-table td{display:block;min-width:0;border:0;padding:6px 0;text-align:left!important;white-space:normal!important;font-size:14px}
 .forecast-table td:first-child{grid-column:1/-1}.forecast-table td[data-label]::before{content:attr(data-label);display:block;color:var(--muted);font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px}
 .forecast-name{font-size:14px}.forecast-row-detail summary{font-size:12px;padding-bottom:6px}.forecast-table .small{font-size:12px}.forecast-value{font-size:17px!important}
 .combo-row{align-items:start;gap:7px;font-size:12px}.combo-row strong{padding-top:1px}.combo-row small{font-size:11px}.combo-rank{width:15px}
 .button-row>button{flex:1 1 130px}.finish-row{gap:8px;padding:10px}.finish-name{font-size:13px}.finish-gap{font-size:11px}
}
@media(max-width:360px){.scene{height:300px;min-height:280px}.top-badge{max-width:112px;white-space:normal;text-align:center}.shell{padding-left:10px;padding-right:10px}.body,.card-head{padding:12px}.forecast-table tr{padding:8px 10px}}
@media(prefers-reduced-motion:reduce){.rl *{scroll-behavior:auto!important}.rl progress{transition:none}}
.sampling-fold{margin-bottom:14px}.evidence-coverage{margin:12px 0 18px}.consensus-row strong small{display:block;white-space:normal;font-weight:400}

.history-check-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:15px}.history-check{min-width:0;padding:14px;border:1px solid #3a5041;border-radius:10px;background:#13251b}.history-check h3{margin:0;font:700 14px/1.45 system-ui,sans-serif;color:var(--gold)}.history-check>p{margin:8px 0}.history-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 10px;margin:16px 0}.history-metrics div{min-width:0}.history-metrics dt{font-size:10px;line-height:1.45;color:var(--muted);text-transform:uppercase;letter-spacing:.35px}.history-metrics dd{margin:3px 0 0;font-size:16px;font-weight:700;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.history-metrics .history-wide{grid-column:1/-1}.history-sources{display:flex;flex-wrap:wrap;gap:8px 18px}.history-sources a{display:inline-flex;align-items:center;min-height:44px}.analysis-stage{margin:8px 0 0}.fallback{padding:26px}.fallback span{display:block;max-width:36em;margin:10px auto 0;line-height:1.6}.scene-legend{max-width:130px}@media(max-width:620px){.history-check-grid{grid-template-columns:minmax(0,1fr)}.history-check{padding:12px}.history-metrics{gap:10px}.history-metrics dd{font-size:15px}.scene-legend{max-width:85px}.fallback{padding:22px}.fallback strong{font-size:28px}.fallback span{font-size:12px;max-width:24em}}

/* Compact mobile workflow; sticky controls stay inside the app scroll area. */
.import-feedback:empty{display:none}.import-feedback{overflow-wrap:anywhere}.mobile-action-strip{display:none}.assumption-controls{margin-top:14px;border-top:1px solid var(--line);padding-top:2px}.setting-summary{display:block;font-size:11px;line-height:1.55;font-weight:400;color:var(--muted);letter-spacing:0;margin:4px 0 0}.full-field-fold>summary{padding:12px;border:1px solid #49614e;border-radius:9px;background:#14291c}.full-field-fold[open]>summary{margin-bottom:12px}.full-field-fold .forecast-wrap{margin-top:6px}.runner-toggle{display:block;width:calc(100% - 22px);margin:0 11px 4px;font-size:12px!important;min-height:44px!important;color:#d6c49e!important}.runner-toggle:hover{background:#23382a!important}.assumption-controls .formrow{width:100%!important}.full-field-fold summary{min-height:56px}.rl textarea,.rl input{min-width:0}.forecast-wrap,.field-grid,.runner-profiles-fold{min-width:0}
@media(max-width:620px){
 .mobile-action-strip{display:block;position:sticky;top:env(safe-area-inset-top,0px);z-index:20;border:1px solid #536b57;border-radius:11px;background:#0e2017;box-shadow:0 4px 14px #0005;padding:8px;margin:0 0 14px}
 .mobile-action-buttons{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.mobile-action-buttons button{min-width:0;min-height:48px;padding:8px 4px;font-size:12px;line-height:1.3;overflow-wrap:anywhere}
 .dock-status{font-size:11px;line-height:1.45;margin:6px 1px 1px;max-height:3em;overflow:auto;overflow-wrap:anywhere}.dock-status.error{font-weight:650}
 .mobile-inline-action{display:none!important}.studio-stack .scenario-actions{grid-template-columns:repeat(2,minmax(0,1fr))}.scenario-actions .mobile-inline-action{display:none!important}
 .rl section[id]{scroll-margin-top:126px}.rl :where(input,select,textarea,button,summary,a):focus{scroll-margin-top:126px;scroll-margin-bottom:24px}
 .ticket-fold{margin-top:10px}.assumption-controls{margin-top:10px}.assumption-controls summary{font-size:13px}.setting-summary{font-size:11px}.full-field-fold>summary{padding:11px;font-size:13px}.runner-profiles-fold .field-grid{gap:10px}
 .rl .help a,.rl .small a{display:inline-flex;align-items:center;min-height:44px;padding-top:7px;padding-bottom:7px;line-height:1.45}.rl summary{min-height:44px!important}.rl input,.rl select,.rl textarea:not([readonly]){font-size:16px!important}.field-card .fold summary{padding-top:12px;padding-bottom:12px}
}
@media(max-width:360px){.mobile-action-strip{padding:7px}.mobile-action-buttons{gap:5px}.mobile-action-buttons button{font-size:11px}.dock-status{font-size:10px}}
.graphics-setting{flex:1 1 170px;gap:8px}.graphics-setting label{margin:0;font-size:10px;text-transform:uppercase;letter-spacing:1px}.graphics-setting select{width:auto;min-width:145px;max-width:220px;margin:0}@media(max-width:620px){.graphics-setting{width:100%}.graphics-setting select{flex:1;max-width:none}}

/* Camera gestures sit between the canvas and the pointer-transparent score overlay. */
.scene .canvas{z-index:0}.camera-gesture{position:absolute;inset:0;z-index:1;background:transparent;touch-action:none;cursor:grab;user-select:none;-webkit-user-select:none}.camera-gesture:active{cursor:grabbing}.camera-gesture:focus-visible{outline:3px solid #a6e6cb;outline-offset:-5px}.scene .overlay{z-index:2;pointer-events:none}.camera-tools{border-top:1px solid #ffffff1e;padding:12px 18px 15px;background:#0c1d13}.camera-tools-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.camera-zoom-control{display:grid;grid-template-columns:44px minmax(70px,auto) 44px;align-items:center;gap:6px}.camera-zoom-control button{padding:5px;min-height:44px;font-size:22px;line-height:1}.camera-zoom-value{text-align:center;color:var(--gold);font-size:13px;font-weight:750;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.camera-reset{min-width:100px}.camera-drag-choice{display:flex;align-items:center;gap:12px;margin-top:10px}.camera-mode-buttons{display:grid;grid-template-columns:repeat(3,minmax(72px,1fr));gap:6px}.camera-mode-buttons button{min-height:44px;padding:8px 12px;font-size:13px}.camera-tools>.help{margin:9px 0 0}.camera-adjustments{margin-top:8px;border-top:1px solid #ffffff15}.camera-adjustments>summary{font-size:13px}.camera-adjust-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.camera-adjust-block{min-width:0}.camera-adjust-block>.controls-label{display:block;margin:0 0 7px}.camera-button-pair,.camera-pan-buttons{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}.camera-pan-block{grid-column:1/-1}.camera-pan-buttons{grid-template-columns:repeat(4,minmax(0,1fr))}.camera-adjust-grid button{min-width:0;min-height:44px;font-size:12px;padding:8px 6px}.camera-adjustments>.help{margin:12px 0 0}@media(max-width:620px){.camera-tools{padding:12px}.camera-tools-head{gap:8px}.camera-zoom-control{grid-template-columns:44px minmax(54px,1fr) 44px;gap:4px}.camera-reset{min-width:86px;font-size:12px;padding:8px}.camera-drag-choice{display:grid;grid-template-columns:65px minmax(0,1fr);gap:8px}.camera-mode-buttons{grid-template-columns:repeat(3,minmax(0,1fr))}.camera-mode-buttons button{padding:8px 5px;font-size:12px}.camera-adjust-grid{gap:10px}.camera-adjustments>summary{font-size:12px}.camera-pan-buttons{grid-template-columns:repeat(2,minmax(0,1fr))}.camera-tools .help{font-size:11px}}@media(max-width:360px){.camera-tools{padding:10px}.camera-zoom-control{grid-template-columns:44px 49px 44px;gap:3px}.camera-reset{min-width:80px;padding:8px 5px}.camera-zoom-value{font-size:12px}.camera-adjust-grid{grid-template-columns:minmax(0,1fr)}.camera-pan-block{grid-column:auto}}

/* Simple is the default; one action bar serves both modes and every width. */
.mode-switch{display:flex;gap:5px;flex:none}.mode-switch button{min-height:44px;padding:8px 14px;font-size:13px}.simple-mode .shell{max-width:1100px}.simple-mode .workspace{display:block}.simple-mode .race-stack{display:grid;gap:16px}.race-actions{border:1px solid #53664e;border-radius:12px;background:#14241b;padding:13px 15px;margin:0 0 16px;box-shadow:0 5px 18px #0002}.race-actions-main{display:grid;grid-template-columns:minmax(100px,150px) minmax(0,1fr);gap:14px;align-items:end}.going-control label{margin:0 0 5px}.race-action-buttons{display:grid;grid-template-columns:1.35fr 1fr 1fr;gap:8px}.race-action-buttons button{min-height:46px;min-width:0;padding:9px 10px}.action-status{margin:8px 0 0;color:var(--muted);font-size:12px;overflow-wrap:anywhere}.race-actions .batch-progress{margin-top:8px}.analysis-notice{margin:6px 0 0;font-size:12px;line-height:1.4;color:var(--gold)}.settings-changed{color:var(--gold);font-size:12px;margin:0 0 14px}.retained-settings{display:flex;align-items:center;gap:16px;padding:11px 14px;border:1px solid var(--line);border-radius:10px;margin:0 0 16px;background:#122018}.retained-settings p{margin:0;flex:1;font-size:12px;color:var(--muted)}.retained-settings button{font-size:12px;flex:none}.ticket-card .body{padding-top:4px;padding-bottom:4px}.ticket-card .ticket-fold{margin:0;border:0;padding:0}.ticket-runner-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin:14px 0}.ticket-runner{display:flex;gap:8px;align-items:center;text-align:left;min-width:0;font-size:12px!important;overflow-wrap:anywhere}.ticket-runner>span{font-size:11px;font-weight:800;opacity:.8;flex:none}.ticket-summary{border-top:1px solid var(--line);padding-top:12px;margin:10px 0 14px;color:var(--gold);font-size:13px}.simple-forecast-head,.simple-forecast-list li{display:grid;grid-template-columns:minmax(0,1fr) 72px 72px;gap:12px;align-items:center}.simple-forecast-head{font-size:11px;text-transform:uppercase;color:var(--muted);padding:5px 0 8px;border-bottom:1px solid var(--line)}.simple-forecast-head span:not(:first-child),.simple-forecast-list li>strong,.simple-forecast-list li>span:last-child{text-align:right;font-variant-numeric:tabular-nums}.simple-forecast-list{padding:0;margin:0;list-style:none}.simple-forecast-list li{padding:12px 0;border-bottom:1px solid #ffffff12;font-size:14px}.simple-forecast-list li>strong{color:var(--gold)}.simple-runner-name{min-width:0;overflow-wrap:anywhere;font-weight:650}.simple-forecast .help:first-child{margin-top:0}.simple-mode .scene{height:clamp(360px,47vw,540px)}.simple-mode .control-row{padding-bottom:10px}.simple-mode .camera-tools{padding-top:10px}.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.scenario-actions{display:flex!important}.scenario-actions button{flex:1 1 auto}.simple-mode .leaders{padding-top:10px}.simple-mode .model-notice{margin-bottom:14px}
@media(max-width:1050px){.advanced-mode .workspace{grid-template-areas:"studio" "race" "tools"}.studio-stack .formrow{width:100%;margin-right:0}.ticket-runner-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:620px){.mode-switch button{font-size:12px;padding:8px 10px}.top-inner{padding:9px 12px}.brand{font-size:22px}.simple-mode .intro h1{font-size:32px}.race-actions{position:sticky;top:0;z-index:35;margin-bottom:14px;padding:10px;border-radius:10px;box-shadow:0 5px 15px #0005}.race-actions-main{grid-template-columns:minmax(0,1fr);gap:9px}.going-control{display:grid;grid-template-columns:auto minmax(0,1fr);gap:12px;align-items:center}.going-control label{margin:0;font-size:12px}.going-control select{min-height:44px;padding-top:7px;padding-bottom:7px}.race-action-buttons{gap:5px;grid-template-columns:1.2fr .85fr 1.05fr}.race-action-buttons button{font-size:12px;padding:7px 4px;line-height:1.25}.action-status{font-size:11px;line-height:1.4;max-height:3.1em;overflow:auto}.race-actions .batch-progress{margin-top:6px}.retained-settings{display:block;padding:10px 12px}.retained-settings button{margin-top:7px}.rl section[id]{scroll-margin-top:175px}.rl :where(button,input,select,textarea,summary,a):focus-visible{scroll-margin-top:175px}.simple-mode .scene{height:320px;min-height:320px}.simple-mode .race-stack{gap:14px}.simple-forecast-head,.simple-forecast-list li{grid-template-columns:minmax(0,1fr) 52px 52px;gap:8px}.simple-forecast-list li{font-size:13px}.ticket-runner-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.ticket-runner{padding:9px 8px!important}.simple-mode .scene-legend{display:none}.simple-mode .intro{margin-bottom:12px}.model-notice{font-size:11px}}
@media(max-width:360px){.brand{font-size:20px}.mode-switch button{padding:8px 9px}.simple-mode .scene{height:280px;min-height:280px}.simple-mode .intro h1{font-size:29px}.simple-forecast-head,.simple-forecast-list li{grid-template-columns:minmax(0,1fr) 48px 48px;gap:6px}.race-action-buttons button{font-size:11px}.ticket-runner-grid{grid-template-columns:minmax(0,1fr)}}

/* v0.11 tools remain disclosures in Advanced; Simple keeps a brief summary. */
.history-source-note{display:block;margin-top:5px}.history-source-note a{display:inline-flex;align-items:center;min-height:44px}.research-active-note{display:block;margin-top:5px;font-weight:750}.freshness-strip{margin:0 0 14px;border:1px solid var(--line);border-radius:10px;background:#101f17;padding:0 13px}.freshness-strip>details>summary{font-size:12px}.freshness-summary{font-weight:400;color:var(--muted);margin-left:10px}.freshness-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;padding:8px 0}.freshness-item{display:flex;flex-direction:column;gap:4px;padding:9px;border:1px solid #ffffff16;border-radius:7px;font-size:12px;min-width:0;overflow-wrap:anywhere}.freshness-item small{color:var(--gold)}.freshness-item a{display:inline-flex;align-items:center;min-height:44px}.freshness-warning{font-size:11px;color:var(--gold);margin:0 0 9px}.model-settings{border-bottom:1px solid var(--line);padding-bottom:8px;margin-bottom:8px}.research-settings{padding:10px;border:1px solid #71603c;border-radius:8px;background:#242317;margin-top:12px}.research-coefficients{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-bottom:12px}.research-coefficients>div{min-width:0}.research-coefficients label{font-size:11px}.portfolio-lab>.body{padding-top:5px;padding-bottom:5px}.portfolio-lab>div>details>summary{font-size:18px}.portfolio-toolbar{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}.portfolio-json{margin:8px 0;border-top:1px solid #ffffff18}.portfolio-json textarea{min-height:150px}.nested-wizard{border-top:1px solid #ffffff18;border-bottom:1px solid #ffffff18;margin:12px 0;padding-bottom:6px}.nested-wizard>summary{font-size:13px}.portfolio-ticket-list{display:grid;gap:12px;margin:14px 0}.portfolio-ticket{padding:13px;border:1px solid #45604b;border-radius:10px;background:#0d1c14;min-width:0}.portfolio-ticket-head{display:flex;align-items:center;justify-content:space-between;gap:10px}.portfolio-ticket-head strong{min-width:0;overflow-wrap:anywhere;color:var(--gold)}.portfolio-ticket-head button{font-size:12px;flex:none}.portfolio-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px 10px}.portfolio-fields>div{min-width:0}.portfolio-fields .help{margin:5px 0 0;font-size:11px}.ticket-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;border-top:1px solid #ffffff19;padding-top:10px;margin:13px 0 0}.ticket-metrics dt{font-size:10px;color:var(--muted);line-height:1.4}.ticket-metrics dd{margin:5px 0 0;font-size:13px;font-weight:750;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.portfolio-exact-summary{border-top:1px solid var(--line);margin-top:16px;padding-top:10px}.portfolio-exact-summary>p:first-child{display:flex;justify-content:space-between;gap:12px;font-size:14px}.portfolio-exact-summary>p>span{color:var(--gold);font-weight:750}.portfolio-probabilities{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.portfolio-probabilities>div{padding:10px;border-radius:8px;background:#1c3022;min-width:0}.portfolio-probabilities span{display:block;color:var(--muted);font-size:11px}.portfolio-probabilities strong{display:block;color:var(--gold);font-size:19px;margin-top:4px;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.payout-fold{margin:15px 0 5px;border-top:1px solid var(--line)}.payout-case-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin:12px 0}.payout-case{padding:11px;background:#0d1c14;border:1px solid #3e5545;border-radius:8px;min-width:0}.payout-case>strong{display:block;font-size:12px;overflow-wrap:anywhere}.payout-case dl{margin:10px 0 0}.payout-case dl>div{display:flex;justify-content:space-between;align-items:baseline;gap:10px;font-size:11px;margin:5px 0}.payout-case dt{color:var(--muted)}.payout-case dd{margin:0;font-weight:700;text-align:right;font-variant-numeric:tabular-nums}.portfolio-hero{display:flex;align-items:baseline;justify-content:space-between;gap:15px;margin:0;font-size:14px}.portfolio-hero strong{font:normal 30px Georgia,serif;color:var(--gold);white-space:nowrap}.simple-portfolio .card-head h2{font-size:22px}.comparison-fold{border-top:1px solid #ffffff18;padding-bottom:5px}.comparison-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:10px 0}.comparison-item{background:#0d1c14;border:1px solid #3d5243;border-radius:8px;padding:10px;min-width:0;font-size:11px;overflow-wrap:anywhere}.comparison-item>strong{font-size:13px;color:var(--gold)}.comparison-item p{margin:8px 0}.comparison-item small{display:block;color:var(--muted)}.contribution-list{margin:5px 0;font-size:11px}.contribution-list>div{border-top:1px solid #ffffff18;padding:9px 0}.contribution-list dt{display:flex;justify-content:space-between;gap:6px;align-items:baseline}.contribution-list dd{margin:5px 0 0;color:var(--ink);font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.contribution-list dd small{display:block;color:var(--muted);font-size:10px;margin-top:4px}.evidence-status{font-size:9px;color:var(--gold);font-weight:600;text-align:right;flex:none}.runner-research h4{margin:14px 0 6px;color:var(--gold);font-size:11px}.research-facts>div{border-bottom:1px solid #ffffff15;padding:7px 0;font-size:11px}.research-facts small{display:block;color:var(--muted)}.research-facts a{display:inline-flex;align-items:center;min-height:44px;overflow-wrap:anywhere}.research-conflict{border-left:2px solid var(--gold);padding-left:8px;color:#e9d4a8;font-size:11px}.field-review{border:1px solid #7b6b43;border-radius:9px;background:#232719;padding:12px;margin:12px 0}.field-review h3{font-size:16px;margin:0 0 8px}.field-diff-list{max-height:350px;overflow:auto;overscroll-behavior:contain}.field-diff-list>div{padding:10px 0;border-top:1px solid #ffffff20;font-size:12px}.field-diff-list dl{display:grid;grid-template-columns:62px minmax(0,1fr);gap:5px 8px;margin:6px 0 0}.field-diff-list dt{color:var(--muted);font-size:11px}.field-diff-list dd{margin:0;overflow-wrap:anywhere}.replay-tools{border-top:1px solid #ffffff1e;padding:0 18px 10px}.replay-tools>summary{font-size:13px}.replay-tools input[type=range]{padding:0;background:transparent;accent-color:var(--gold);touch-action:pan-y}.chapter-buttons{display:flex;flex-wrap:wrap;gap:6px;margin-top:7px}.chapter-buttons button{font-size:11px;flex:1;padding:7px 8px}.replay-settings-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.replay-settings-row>div{min-width:0}.race-minimap{border:1px solid #3b5544;border-radius:8px;background:#0a1911;padding:8px;margin-top:12px}.race-minimap svg{display:block;width:100%;height:auto;max-height:220px}.race-minimap .help{font-size:10px;margin:4px 0 0}
@media(max-width:1050px){.portfolio-probabilities{grid-template-columns:repeat(2,minmax(0,1fr))}.comparison-list{grid-template-columns:repeat(2,minmax(0,1fr))}.research-coefficients{grid-template-columns:minmax(0,1fr)}.research-coefficients label{font-size:12px}}
@media(max-width:620px){.section-nav{grid-template-columns:repeat(3,minmax(0,1fr))}.freshness-strip{padding:0 11px}.freshness-summary{display:block;margin-left:0;font-size:11px}.freshness-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.freshness-item{font-size:11px}.portfolio-fields{grid-template-columns:minmax(0,1fr)}.portfolio-ticket{padding:11px}.portfolio-ticket-head{align-items:flex-start}.ticket-metrics{grid-template-columns:minmax(0,1fr)}.ticket-metrics>div{display:flex;justify-content:space-between;align-items:baseline;gap:12px}.ticket-metrics dt{font-size:11px}.ticket-metrics dd{margin:0;text-align:right}.portfolio-probabilities strong{font-size:18px}.payout-case-list,.comparison-list,.replay-settings-row{grid-template-columns:minmax(0,1fr)}.portfolio-hero{display:block}.portfolio-hero strong{display:block;margin-top:5px}.portfolio-toolbar button{width:100%}.replay-tools{padding:0 12px 10px}.chapter-buttons{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}.chapter-buttons button{min-width:0}.evidence-status{max-width:95px;white-space:normal}.field-review .button-row{display:grid;grid-template-columns:minmax(0,1fr)}.portfolio-lab>.body{padding-top:4px;padding-bottom:4px}.freshness-warning{font-size:10px}}
@media(max-width:360px){.freshness-grid{grid-template-columns:minmax(0,1fr)}.portfolio-probabilities{gap:5px}.portfolio-probabilities>div{padding:9px}.portfolio-ticket-head strong{font-size:13px}}

/* v0.12 diagnostics are folded; blind review excludes the regular application. */
.audit-panel>.body{padding-top:5px;padding-bottom:5px}.audit-panel>div>details>summary{font-size:18px}.audit-section{border-top:1px solid var(--line);margin-top:10px;padding-bottom:8px}.market-source-link{margin:3px 0}.market-source-link a{display:inline-flex;align-items:center;min-height:44px;font-size:12px;overflow-wrap:anywhere}.audit-feedback{font-size:12px;color:var(--gold);overflow-wrap:anywhere}.audit-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px 12px}.audit-form-grid>div{min-width:0}.audit-form-grid label{font-size:12px}.audit-check{display:flex!important;align-items:center;gap:10px;min-height:44px;margin:5px 0!important;font-size:12px!important;cursor:pointer}.rl .audit-check input{flex:none;width:22px!important;height:22px;min-height:22px;margin:0;padding:0;accent-color:var(--gold)}.audit-check span{min-width:0;overflow-wrap:anywhere}.audit-checkboxes{display:flex;flex-wrap:wrap;gap:2px 18px;margin:8px 0}.audit-section textarea{min-height:140px}.manual-odds-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 14px;margin:15px 0}.manual-odds-row{display:grid;grid-template-columns:minmax(0,1fr) 90px;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid #ffffff18}.manual-odds-row label{margin:0;font-size:12px;min-width:0;overflow-wrap:anywhere}.manual-odds-row small{display:block;color:var(--muted);font-weight:400;margin-top:3px}.manual-odds-row input{min-width:0}.comparison-table-wrap{max-width:100%;min-width:0;margin-top:14px}.audit-table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:11px}.audit-table caption{text-align:left;color:var(--muted);font-size:12px;padding:8px 0}.audit-table th,.audit-table td{padding:10px 7px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top;overflow-wrap:anywhere}.audit-table th{color:var(--gold);font-size:10px}.audit-table th:first-child{width:31%}.audit-table td>strong{display:block;font-variant-numeric:tabular-nums}.audit-table td>small{display:block;margin-top:5px;color:var(--muted);font-size:10px}.shortlist-label{display:block;color:var(--gold);font-size:10px;margin:5px 0}.discrepancy-detail{margin-top:5px;font-size:11px}.discrepancy-detail summary{font-size:11px}.discrepancy-detail a{display:inline-flex;align-items:center;min-height:44px}.probability-chart,.market-coverage{border-top:1px solid var(--line);padding-top:4px;margin-top:12px}.probability-bars{display:grid;gap:14px}.probability-bar-runner{min-width:0;padding:12px;border:1px solid #3b5543;border-radius:8px;background:#0c1a12}.probability-bar-runner>strong{display:block;font-size:12px;overflow-wrap:anywhere;margin-bottom:8px}.probability-bar-line{display:grid;grid-template-columns:61px minmax(0,1fr) 64px;align-items:center;gap:8px;font-size:10px;min-height:25px}.probability-bar-line>div{height:9px;border-radius:5px;background:#ffffff0b;overflow:hidden}.probability-bar-line i{display:block;height:100%;max-width:100%;min-width:0;border-radius:5px}.baseline-bar{background:#9ec7ae}.research-bar{background:#e9c77e}.market-bar{background:#9dbddd}.probability-bar-line b{text-align:right;font-variant-numeric:tabular-nums}.money-limit{padding:10px 12px;border:1px solid #71613e;background:#252117;color:#efdaa9;font-size:12px;border-radius:8px}.bias-stat-grid,.ablation-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:12px 0}.bias-stat-grid>article,.ablation-grid>article{padding:12px;background:#0d1c14;border:1px solid #3d5544;border-radius:9px;min-width:0;overflow-wrap:anywhere}.bias-stat-grid strong{display:block;font-size:13px}.bias-stat-grid article>span{display:block;font-size:11px;color:var(--muted);margin:4px 0}.bias-stat-grid dl{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px;font-size:11px;margin:10px 0 0}.bias-stat-grid dd{margin:0;font-weight:700;color:var(--gold)}.bias-band-list>div{padding:10px 0;border-bottom:1px solid #ffffff18;font-size:12px}.bias-band-list span,.bias-band-list small{display:block;color:var(--muted);margin-top:5px}.ablation-grid h3{font-size:13px;color:var(--gold);margin:0 0 8px}.ablation-grid p{margin:8px 0;font-size:12px}.annotation-disputes p{padding-left:10px;border-left:2px solid var(--gold);font-size:12px;overflow-wrap:anywhere}.simple-audit h2{font:normal 21px Georgia,serif;margin:0 0 8px}.simple-audit .body{padding-top:14px;padding-bottom:14px}.simple-audit p{margin:6px 0}.blind-shell{max-width:1300px}.blind-intro h1{font:normal 30px Georgia,serif;margin:5px 0}.blind-intro{margin-bottom:18px}.blind-intro p{font-size:13px}.blind-card-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;align-items:start}.blind-card h2{font-size:22px}.blind-card h3{font-size:12px;color:var(--gold);margin:0 0 8px}.blind-facts{font-size:12px;white-space:pre-wrap;overflow-wrap:anywhere}.blind-score-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.blind-score-grid>div{min-width:0}.blind-score-grid label{font-size:11px}.blind-card textarea{min-height:100px}.blind-actions{margin:18px 0;padding:14px;border:1px solid var(--line);border-radius:10px;background:#101f17;display:flex;gap:10px;align-items:center;flex-wrap:wrap}.blind-actions p{flex:1 1 100%;margin:0}.blind-card .body>label{font-size:12px}
@media(max-width:1050px){.blind-card-grid{grid-template-columns:minmax(0,1fr)}.blind-score-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.manual-odds-list{grid-template-columns:minmax(0,1fr)}}
@media(max-width:620px){.audit-form-grid,.bias-stat-grid,.ablation-grid,.blind-score-grid{grid-template-columns:minmax(0,1fr)}.audit-checkboxes{display:block}.audit-table,.audit-table tbody{display:block}.audit-table thead{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.audit-table tr{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));padding:10px 0;border-bottom:1px solid var(--line);gap:8px}.audit-table td{display:block;border:0;padding:6px;min-width:0;background:#0c1a13;border-radius:6px;font-size:12px}.audit-table td:first-child,.audit-table td[colspan]{grid-column:1/-1;background:transparent;padding:3px 0}.audit-table td:not(:first-child)::before{content:attr(data-label);display:block;color:var(--gold);font-size:10px;font-weight:700;margin-bottom:6px}.audit-table td>small{font-size:11px}.audit-table td:first-child>strong{font-size:14px}.audit-table caption{display:block}.probability-bar-line{grid-template-columns:55px minmax(0,1fr) 60px;gap:6px}.probability-bar-runner{padding:10px}.blind-intro h1{font-size:27px}.blind-actions{display:grid;grid-template-columns:minmax(0,1fr)}.audit-panel>.body{padding-top:4px;padding-bottom:4px}.manual-odds-row{grid-template-columns:minmax(0,1fr) 86px}}
@media(max-width:360px){.audit-panel>div>details>summary{font-size:16px}.audit-table tr{gap:5px}.probability-bar-line{grid-template-columns:50px minmax(0,1fr) 54px;gap:4px;font-size:9px}.manual-odds-row{grid-template-columns:minmax(0,1fr) 78px}.bias-stat-grid dl{grid-template-columns:minmax(0,1fr)}.bias-stat-grid dd{margin-bottom:4px}}

/* v0.13 shared analysis size and bounded box searches. */
.race-actions-main{grid-template-columns:minmax(260px,360px) minmax(0,1fr)}.race-inputs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.race-inputs>div{min-width:0}.race-inputs label{margin:0 0 5px;font-size:12px}.race-day-strip{margin:0 0 14px;padding:0 13px;background:#111f19;border:1px solid #3c5141;border-radius:10px}.race-day-strip>details>summary{font-size:13px}.race-day-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:8px 0}.race-day-grid>div{min-width:0;padding:11px;border:1px solid #ffffff18;border-radius:8px}.race-day-grid h3{margin:0 0 7px;font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--gold)}.race-day-grid strong{font-size:19px}.race-day-grid p{font-size:12px;margin:6px 0;overflow-wrap:anywhere}.race-day-grid a{display:flex;align-items:center;min-height:44px;font-size:12px;overflow-wrap:anywhere}.race-day-warning{font-size:12px;color:#ecd4a3;padding-left:9px;border-left:2px solid var(--gold);overflow-wrap:anywhere}.box-search-controls{display:grid;grid-template-columns:minmax(0,1.2fr) 90px minmax(0,1fr);gap:12px;align-items:end}.box-search-controls>div{min-width:0}.box-search-controls button{min-height:46px}.box-candidate-controls{margin-top:12px;border-top:1px solid #ffffff1c}.box-search-status{margin:13px 0 6px;color:var(--gold)}.ranked-box-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:13px 0}.ranked-box{padding:13px;border:1px solid #47614c;background:#0e1e15;border-radius:10px;min-width:0}.ranked-box:first-child{border-color:#8d7c4b;background:#1a291c}.ranked-box-head{display:flex;align-items:start;gap:10px}.ranked-box-head>div{min-width:0}.box-rank{display:grid;place-items:center;width:29px;height:29px;flex:none;border:1px solid #8b784b;border-radius:50%;font-size:13px;color:var(--gold)}.ranked-box h3{margin:0;font-size:17px;letter-spacing:.3px;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.box-runner-names{font-size:11px;color:var(--muted);margin:7px 0 0;overflow-wrap:anywhere}.ranked-box-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin:13px 0}.ranked-box-metrics>div{min-width:0}.ranked-box-metrics dt{font-size:10px;color:var(--muted)}.ranked-box-metrics dd{margin:4px 0 0;font-size:14px;font-weight:700;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.ranked-box-metrics>div:first-child dd{color:var(--gold);font-size:21px}.ranked-box>button{width:100%;font-size:12px}.box-ranking-notes,.diversified-boxes{border-top:1px solid var(--line);padding-top:3px;margin-top:12px}.diversified-boxes>button{margin:6px 8px 4px 0}.diversified-box-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:12px 0}.diversified-box-list>article{padding:11px;border:1px solid #3e5745;border-radius:8px;background:#0d1c14;min-width:0}.diversified-box-list h3{font-size:14px;margin:0;overflow-wrap:anywhere}.diversified-box-list dl{font-size:11px;margin:10px 0 0}.diversified-box-list dl>div{display:flex;justify-content:space-between;gap:10px;margin:7px 0}.diversified-box-list dt{color:var(--muted)}.diversified-box-list dd{margin:0;text-align:right;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.simple-mode .ranked-box-list{grid-template-columns:repeat(3,minmax(0,1fr))}
@media(max-width:1050px){.race-actions-main{grid-template-columns:minmax(230px,1fr) minmax(0,1.35fr)}.race-day-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.race-day-grid>div:last-child{grid-column:1/-1}.simple-mode .ranked-box-list{grid-template-columns:minmax(0,1fr)}.ranked-box-list{grid-template-columns:minmax(0,1fr)}}
@media(max-width:620px){.race-actions-main{grid-template-columns:minmax(0,1fr)}.race-inputs{gap:9px}.race-inputs .going-control{display:block}.race-inputs label{font-size:11px;margin:0 0 4px}.race-inputs select{padding:7px 8px;min-height:44px}.rl section[id]{scroll-margin-top:195px}.rl :where(button,input,select,textarea,summary,a):focus-visible{scroll-margin-top:195px}.race-day-strip{padding:0 11px}.race-day-grid{grid-template-columns:minmax(0,1fr)}.race-day-grid>div:last-child{grid-column:auto}.race-day-warning{font-size:11px}.box-search-controls{grid-template-columns:minmax(0,1fr) 80px;gap:8px}.box-search-controls button{width:100%;grid-column:1/-1}.ranked-box{padding:12px}.diversified-box-list{grid-template-columns:minmax(0,1fr)}.ranked-box-metrics dd{font-size:13px}.ranked-box-metrics>div:first-child dd{font-size:20px}.box-suggestions .card-head h2{font-size:23px}}
@media(max-width:360px){.race-inputs{gap:7px}.race-day-grid>div{padding:9px}.ranked-box-metrics{gap:8px}.ranked-box h3{font-size:16px}.ranked-box-metrics dt{font-size:10px}}

.race-day-alert{margin:10px 0;padding:13px 15px;border:1px solid #a18b50;border-radius:10px;background:#28301e;color:#f4f2e8}.race-day-alert strong{color:#f3d78c}.race-day-alert p{margin:5px 0;font-size:13px;line-height:1.4}.race-day-alert a{display:inline-flex;align-items:center;min-height:44px;color:#e9c77e;font-weight:700}

/* Keep paste-ready tickets outside optional analysis disclosures. */
.box-copy-panel{padding:14px;margin:14px 0 18px;border:1px solid #9c8953;border-radius:11px;background:#1b2d1e;min-width:0}.box-copy-head{display:flex;align-items:center;justify-content:space-between;gap:14px}.box-copy-head>div{min-width:0}.box-copy-head h3{margin:0;color:var(--gold);font-size:17px;overflow-wrap:anywhere}.box-copy-head p{margin:5px 0 0;font-size:11px;color:var(--muted)}.box-number-copy{flex:none}.box-number-copy button{min-height:46px;font-size:13px;padding:10px 14px!important}.box-copy-panel>label{font-size:12px;margin:10px 0 6px}.box-copy-panel textarea[readonly]{font:500 16px/1.65 ui-monospace,SFMono-Regular,Consolas,monospace!important;min-height:88px;max-height:245px;white-space:pre;overflow:auto;resize:vertical;background:#0a1810;border-color:#64816a;padding:10px 12px;tab-size:2}.box-copy-panel>.help{font-size:11px;margin:9px 0 0}.box-copy-panel #box-copy-fallback{color:#b7cabd}
@media(max-width:620px){.box-copy-panel{padding:12px}.box-copy-head{display:block}.box-copy-head h3{font-size:17px}.box-number-copy{display:flex!important;width:100%;margin-top:12px}.box-number-copy button{width:100%;justify-content:center;min-height:48px;font-size:14px}.box-copy-panel textarea[readonly]{max-height:220px;padding:9px 10px}.box-copy-panel>.help{font-size:11px;line-height:1.5}}
@media(max-width:360px){.box-copy-panel{padding:10px}.box-copy-head h3{font-size:16px}}
.box-collection-controls{display:flex;align-items:end;gap:10px;flex-wrap:wrap;margin:12px 0}.box-collection-controls>div{flex:1 1 180px}.box-collection-list{max-height:360px;overflow:auto;border:1px solid #405947;border-radius:8px;padding:0 10px}.box-collection-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(110px,150px);gap:10px;align-items:center;padding:9px 0;border-bottom:1px solid #35473b}.box-collection-row:last-child{border-bottom:0}.box-collection-row strong{overflow-wrap:anywhere}.box-collection-row p{margin:3px 0}.box-collection-row input{width:100%}@media(max-width:480px){.box-collection-row{grid-template-columns:minmax(0,1fr) 120px}.box-collection-controls button{width:100%}}</style>
<App style={{padding:0,overflow:"auto"}}><div className={interfaceMode === "simple" ? "rl simple-mode" : "rl advanced-mode"}>#if (blindReviewActive)<header className="top"><div className="top-inner"><div className="brand">◈ Race<em>Lab</em></div><button className="quiet" @click={exitBlindReview}>Exit blind review</button></div></header><main className="shell blind-shell"><section className="card blind-intro"><div className="card-head"><div><div className="eyebrow">Independent annotation workspace</div><h1>Blind research review</h1></div></div><div className="body"><p>Score the supplied structured facts before viewing the shortlist or market. Horse names, saddlecloths, trainer names, odds and selections are hidden here.</p><p className="help">Opaque labels reduce identity cues; distinctive records can still reveal a runner. This cannot guarantee a fully blind review. Unknown evidence stays unknown, and your scores are analyst hypotheses, never verified results.</p><div className="audit-form-grid"><div><label htmlFor="blind-reviewer">Reviewer ID</label><input id="blind-reviewer" :bind={blindReviewerId} autoComplete="off" placeholder="Independent reviewer ID" /></div><div><label htmlFor="blind-authored">Authored at · exact time with timezone</label><input id="blind-authored" :bind={blindAuthoredAt} autoComplete="off" placeholder="YYYY-MM-DDTHH:mm:ss+11:00" /></div><div><label htmlFor="blind-cutoff">Evidence cutoff · exact time with timezone</label><input id="blind-cutoff" :bind={blindEvidenceCutoff} autoComplete="off" placeholder="YYYY-MM-DDTHH:mm:ss+11:00" /></div></div><label className="audit-check"><input type="checkbox" :bind={blindPostOutcome} /><span>I have viewed the race outcome · mark this as post-outcome review</span></label><p className="help">Enter the actual authored time and evidence cutoff. Post-outcome reviews must not be used as pre-race validation.</p><p className="audit-feedback" role="status">{blindReviewMessage}</p></div></section><div className="blind-card-grid">#each (review in blindRows) key={review.id}<article className="card blind-card"><div className="card-head"><h2>{review.id}</h2></div><div className="body"><h3>Structured facts</h3><p className="blind-facts">{review.factsText}</p><p className="help">{review.missingText}</p><div className="blind-score-grid"><div><label htmlFor={"blind-trip-"+review.id}>Flat-trip hypothesis</label><select id={"blind-trip-"+review.id} value={review.trip} @change={(value) => updateBlindScore(review.id,"trip",value)}><option value="">Not scored</option><option value="positive">Positive</option><option value="mixed">Mixed</option><option value="unproven">Unproven</option><option value="negative">Negative</option></select></div><div><label htmlFor={"blind-recency-"+review.id}>Recent-form hypothesis</label><select id={"blind-recency-"+review.id} value={review.recency} @change={(value) => updateBlindScore(review.id,"recency",value)}><option value="">Not scored</option><option value="positive">Positive</option><option value="mixed">Mixed</option><option value="negative">Negative</option></select></div><div><label htmlFor={"blind-surface-"+review.id}>Surface hypothesis</label><select id={"blind-surface-"+review.id} value={review.surface} @change={(value) => updateBlindScore(review.id,"surface",value)}><option value="">Not scored</option><option value="soft_evidence">Soft evidence</option><option value="uncertain">Uncertain</option><option value="unknown_untried">Unknown / untried</option></select></div></div><label htmlFor={"blind-rationale-"+review.id}>Rationale · use the facts, not desired chances</label><textarea id={"blind-rationale-"+review.id} value={review.rationale} @change={(value) => updateBlindScore(review.id,"rationale",value)}></textarea><label htmlFor={"blind-uncertainty-"+review.id}>Uncertainty and missing evidence</label><textarea id={"blind-uncertainty-"+review.id} value={review.uncertainty} @change={(value) => updateBlindScore(review.id,"uncertainty",value)}></textarea></div></article>#empty<p className="small">No eligible review records are available.</p>#end</div><div className="blind-actions"><button className="primary" @click={saveBlindReview}>Save blind review</button><button className="quiet" @click={exitBlindReview}>Return to RaceLab</button><p className="small" role="status">{blindReviewMessage}</p></div></main>#else<header className="top"><div className="top-inner"><div className="brand">◈ Race<em>Lab</em></div><div className="mode-switch" role="group" aria-label="Interface mode"><button className={interfaceMode === "simple" ? "active" : "quiet"} aria-pressed={interfaceMode === "simple"} @click={setInterfaceMode("simple")}>Simple</button><button className={interfaceMode === "advanced" ? "active" : "quiet"} aria-pressed={interfaceMode === "advanced"} @click={setInterfaceMode("advanced")}>Advanced</button></div></div></header><main className="shell"><div className="intro"><div><div className="eyebrow">Melbourne Cup · 3 November 2026</div><h1>Flemington Race Lab</h1><p>{interfaceMode === "simple" ? "Run a simulation. Watch the race. See the result." : "Compare thousands of possible races. Explore the probabilities. Watch a sample."}</p></div><div className="intro-stat"><strong>3,200 m</strong><span>Flemington · Melbourne</span></div></div><div className="notice model-notice"><strong>Experimental model.</strong> Chances are uncalibrated estimates; the animation shows one possible race. Check race-day changes to the dated field. <span className="history-source-note">Race-day history uses reviewed flat career and going records; see <a href="#race-day-conditions">sources and limitations</a>.</span> #if (modelPreset === "research_sensitivity")<span className="research-active-note">Research what-if enabled · uncalibrated.</span>#end #if (interfaceMode === "advanced"){historicalSignalText}#end</div><section className="freshness-strip" aria-label="Data freshness"><details className="fold"><summary><span>Data snapshot</span><span className="freshness-summary">{freshnessSummary}</span></summary><div className="freshness-grid">#each (item in freshnessRows) key={item.id}<div className="freshness-item"><strong>{item.label}</strong><span>{item.value}</span><small>{item.status}</small>#if (item.sourceUrl)<a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">{item.sourceLabel} ↗</a>#end</div>#end</div><p className="help">Data is bundled or supplied by you. Changes are not fetched automatically; review official race-day declarations before updating the field.</p>#if (sourceWarningText)<p className="freshness-warning">{sourceWarningText}</p>#end</details></section><aside className="race-day-alert" aria-label="Check current race conditions"><strong>Check before using these picks</strong><p>Last bundled field report: {raceDayFieldAsOf}. Track: {raceDayTrack} · {raceDayTrackAsOf}.</p><p>{raceDayConflict}</p><p>This is an offline snapshot. Check the official report, update any scratchings or going, then rerun the simulation before placing a bet. If unresolved, compare Good and Soft as scenarios; neither is a confirmed live rating.</p><a href={raceDayScratchUrl} target="_blank" rel="noopener noreferrer">Check official scratchings and track ↗</a> · <a href={raceDayTabtouchUrl} target="_blank" rel="noopener noreferrer">TABtouch listing ↗</a> · <a href={raceDayThirdPartyUrl} target="_blank" rel="noopener noreferrer">Racing &amp; Sports listing ↗</a></aside><section id="race-day-conditions" className="race-day-strip" aria-label="Reported race-day conditions"><details className="fold"><summary>Race-day conditions<span className="setting-summary">Reported track: {raceDayTrack} · {raceDayTrackAsOf}</span></summary><div className="race-day-grid"><div><h3>Reported track</h3><strong>{raceDayTrack}</strong><p>{raceDayTrackAsOf}</p><a href={raceDayTrackUrl} target="_blank" rel="noopener noreferrer">Official track report ↗</a></div><div><h3>Weather forecast</h3><p>{raceDayForecast}</p><a href={raceDayWeatherUrl} target="_blank" rel="noopener noreferrer">Bureau of Meteorology ↗</a></div><div><h3>Field and scratchings</h3><p>{raceDayFieldAsOf}</p><a href={raceDayFieldUrl} target="_blank" rel="noopener noreferrer">Official field ↗</a><a href={raceDayScratchUrl} target="_blank" rel="noopener noreferrer">Scratching report ↗</a></div></div><p className="help">These are dated source snapshots, not a live feed. Your Going scenario remains a manual choice. Weather is context only; rain probability is not converted into a track rating or model coefficient.</p>#if (raceDayWarning)<p className="race-day-warning">{raceDayWarning}</p>#end</details></section>#if (interfaceMode === "advanced")<nav className="section-nav" aria-label="RaceLab sections"><a href="#race-view">Watch race</a><a href="#field-forecast">Forecast</a><a href="#box-suggestions">Boxes</a><a href="#portfolio-lab">Portfolio</a><a href="#market-audit">Market &amp; audit</a><a href="#horse-profiles">Horses</a><a href="#horse-data">JSON data</a></nav>#end<section id="race-actions" className="race-actions" aria-label="Simulation and race controls"><div className="race-actions-main"><div className="race-inputs"><div className="going-control"><label htmlFor="going">Going scenario</label><select id="going" :bind={going} @change={recordGoingSelection}><option value="good">Good</option><option value="soft">Soft</option><option value="heavy">Heavy</option></select></div><details className="fold going-source"><summary>Going source (optional)</summary><p className="help">Your selected scenario remains manual. Source details are your notes, not a verified live rating. Changes are recorded for this session and included in results JSON.</p><label htmlFor="going-source-note">Source note</label><input id="going-source-note" type="text" maxLength="500" :bind={goingSourceNote} @change={recordGoingSource} placeholder="e.g. official report checked at 1 pm" /><label htmlFor="going-source-url">Source URL (optional)</label><input id="going-source-url" type="url" maxLength="1000" :bind={goingSourceUrl} @change={recordGoingSource} placeholder="https://…" /></details><div className="trial-control"><label htmlFor="trials">Simulations</label><select id="trials" :bind={trials} @change={refreshTrialSettings}><option value="1000">1,000</option><option value="5000">5,000</option><option value="20000">20,000</option><option value="100000">100,000</option></select></div></div><div className="race-action-buttons"><button className="primary" @click={newRace} disabled={analysisRunning}>{analysisRunning ? "Running…" : "Run & watch"}</button><button @click={playRace} disabled={!hasResult && !analysisRunning} aria-label={analysisRunning ? pendingAction === "play" ? "Cancel queued playback" : "Play sampled race when ready" : running ? "Pause sampled race" : "Play sampled race"}>{analysisRunning ? pendingAction === "play" ? "Cancel play" : "Play when ready" : running ? "Pause" : raceComplete ? "Replay" : "Play"}</button><button @click={skipRace}>Skip to result</button></div></div><p id="run-status" className="action-status" role="status">{message}</p>#if (analysisNotice)<p className="analysis-notice" role="status">{analysisNotice}</p>#end#if (analysisRunning)<progress className="batch-progress" max={analysisTarget} value={analysisCompleted} aria-label="Simulation progress"></progress>#end#if (error)<p id="run-error" className="error action-status" role="alert">{error}</p>#end</section>#if (interfaceMode === "simple" && advancedSettingsActive)<div className="retained-settings"><p><strong>Your settings are retained.</strong> {advancedSettingsSummary}</p><button className="quiet" @click={setInterfaceMode("advanced")}>Review in Advanced</button></div>#end#if (hasResult && resultKey !== going+"|"+pace+"|"+barrierMode+"|"+historyMode+"|"+trials+"|"+selectionText+"|"+stake+"|"+fieldText+"|"+modelPreset+"|"+ratingScale+"|"+tripScale+"|"+recencyScale+"|"+softScale+"|"+portfolioMode+"|"+portfolioText+"|"+hypotheticalDividend+"|"+researchClamp+"|"+acceptedSnapshotId)<p className="settings-changed">Settings changed. Run &amp; watch again to update the results. Ticket-only changes keep the same sampled race.</p>#end<div className="workspace">#if (interfaceMode === "advanced")<aside className="stack studio-stack" aria-label="Race setup"><section id="race-setup" className="card"><div className="card-head"><div><div className="eyebrow">Race studio</div><h2>Set the scenario</h2></div><span className="tag">3200 m</span></div><div className="body"><p className="help">Fine-tune the simulation. These settings are retained in Simple mode.</p><details className="fold model-settings"><summary>Model preset &amp; rating scale<span className="setting-summary">{modelPreset === "baseline" ? "Original model" : modelPreset === "ratings_only" ? "Ratings only" : "Research what-if"} · divisor {ratingScale}</span></summary><label htmlFor="model-preset">Model preset</label><select id="model-preset" value={modelPreset} @change={(value) => setModelPreset(value)}><option value="baseline">Original model · v0.10 baseline</option><option value="ratings_only">Ratings only</option><option value="research_sensitivity">Research what-if · uncalibrated</option><option value="validated_features" disabled={true}>Validated model · unavailable</option></select><label htmlFor="rating-scale">Rating divisor</label><select id="rating-scale" :bind={ratingScale} @change={refreshModelSettings}><option value="4">4 · more concentrated</option><option value="6">6</option><option value="8">8 · original assumption</option><option value="12">12</option><option value="16">16 · flatter</option></select><p className="help">This divisor is an assumption, not a fitted calibration. The runner inspector shows which inputs the selected preset uses. Displayed kilograms, jockey and trainer receive no independent numerical adjustment.</p>#if (modelPreset === "research_sensitivity")<div className="research-settings"><p className="help"><strong>Optional analyst hypotheses.</strong> All coefficients start at zero. Unknown trip or ground evidence is neutral. These adjustments do not establish better predictions.</p><div className="research-coefficients"><div><label htmlFor="trip-scale">Flat-trip coefficient</label><input id="trip-scale" type="number" min="0" max="0.12" step="0.01" inputMode="decimal" :bind={tripScale} @change={refreshModelSettings} /></div><div><label htmlFor="recency-scale">Recent-form coefficient</label><input id="recency-scale" type="number" min="0" max="0.12" step="0.01" inputMode="decimal" :bind={recencyScale} @change={refreshModelSettings} /></div><div><label htmlFor="soft-scale">Soft-evidence coefficient</label><input id="soft-scale" type="number" min="0" max="0.12" step="0.01" inputMode="decimal" :bind={softScale} @change={refreshModelSettings} /></div></div><button className="quiet" @click={applyResearchPilot}>Load illustrative pilot values</button><p className="help">Combined log-adjustment cap: ±{researchClamp}. The pilot changes derived strengths, never the published rating. Soft evidence adds no Heavy-ground bonus. Combining it with cautious history can count related evidence twice; treat that combination as an overlap sensitivity.</p></div>#end<div className="button-row"><button className="quiet" @click={resetModelBaseline}>Reset to original model</button></div></details><details className="fold assumption-controls"><summary>History, barrier &amp; pace settings<span className="setting-summary">{historyMode} history · {barrierMode} barrier · {pace} pace</span></summary><p className="help">Published ratings and, when enabled, limited track and going history inform this experimental model. Missing evidence is not the same as a poor record.</p><div className="formrow"><div><label htmlFor="history-mode">Historical evidence</label><select id="history-mode" :bind={historyMode} @change={refreshScenarioAssumptions}><option value="cautious">Cautious adjustment</option><option value="off">Off</option></select></div><div><label htmlFor="pace">Pace</label><select id="pace" :bind={pace} @change={refreshScenarioAssumptions}><option value="slow">Slow</option><option value="moderate">Moderate</option><option value="fast">Fast</option></select></div></div><div className="formrow"><div><label htmlFor="barrier">Barrier effect</label><select id="barrier" :bind={barrierMode} @change={refreshScenarioAssumptions}><option value="modest">Modest (assumption)</option><option value="off">Off</option></select></div></div></details><div className="button-row scenario-actions"><button @click={simulate} disabled={analysisRunning}>Analyze without playback</button><button @click={saveScenario}>Save settings</button><button @click={loadScenario}>Load settings</button></div><p className="help">Each batch starts with fresh randomness, then derives a separate seed for every trial. The animation shows its first trial. Restart preserves that sample; the replay code restores the whole batch.</p>#if (hasResult && resultKey === going+"|"+pace+"|"+barrierMode+"|"+historyMode+"|"+trials+"|"+selectionText+"|"+stake+"|"+fieldText+"|"+modelPreset+"|"+ratingScale+"|"+tripScale+"|"+recencyScale+"|"+softScale+"|"+portfolioMode+"|"+portfolioText+"|"+hypotheticalDividend+"|"+researchClamp+"|"+acceptedSnapshotId)<div className="result">#if (portfolioMode)<div className="eyebrow">Exact model chance any ticket pays</div><strong>{portfolioSummary.anyText}</strong><p className="help">Overlaps counted once. Conditional on an uncalibrated model; actual dividend unknown.</p>#else<div className="eyebrow">Exact model box coverage</div><strong>{coverage}</strong><div className="small">{intervalText}</div><div className="divider"></div><div>{ticketText}</div><p className="help">Simulation sampling interval only; model and real-world uncertainty are not included. Percentages are unvalidated.</p>#end<details className="fold"><summary>Save this replay code</summary><div className="small">Generated run ID: {replaySeed}</div><p className="help">Copy the complete code to restore this race, field, ticket and settings in RaceLab 0.13. The internally generated random value and model version are included. It is for reproducibility, not a prediction.</p><textarea aria-label="Replay code" value={replayCode} readOnly={true}></textarea></details></div>#end</div></section>
</aside>#end<div className="stack race-stack"><section id="race-view" className="card broadcast" aria-label="3D race replay"><div className="scene">#if (renderScene)<div className="canvas"><Scene3D fill={true} objects={objects} staticObjects={courseObjects} lights={lights} camera={camera} orbitControls={false} antialias={true} shadows={graphicsDetail === "detailed"} maxPixelRatio={graphicsDetail === "detailed" ? 1.5 : 1} environment={{ url: "assets/env/sunny-meadow.hdr", background: true, backgroundIntensity: 0.92 }} environmentIntensity={0.62} toneMapping="agx" toneMappingExposure={1.04} effects={graphicsDetail === "detailed" ? { ambientOcclusion: { radius: 0.45, intensity: 0.48 }, bloom: { strength: 0.14, radius: 0.35, threshold: 1.05 } } : {}} /></div><div className="camera-gesture" role="group" aria-label="Interactive race camera" aria-describedby="camera-help camera-keyboard-help" tabIndex={0} @mousedown={cameraPointerDown} @mousemove={(event) => cameraGesture.active && cameraPointerMove(event)} @mouseup={cameraPointerEnd} @mouseleave={cameraPointerEnd} @touchstart={cameraTouchStart} @touchmove={(event) => cameraGesture.active && cameraTouchMove(event)} @touchend={cameraPointerEnd} @touchcancel={cameraPointerEnd} @keydown={(event) => { !event.altKey && !event.ctrlKey && !event.metaKey && ["ArrowLeft","ArrowRight","ArrowUp","ArrowDown","+","=","-","_","0","Home"].includes(event.key) && event.preventDefault(); cameraKey(event); }} @blur={cameraPointerEnd}></div>#else<div className="fallback"><strong>Text race view</strong><span>{sceneFallbackText}</span></div>#end<div className="overlay"><div className="scorebar"><div className="racebadge">RACELAB<br />FLEMINGTON</div><div className="phase">{racePhase}</div><div className="distance"><strong>{progressText}</strong><span>{clockText}</span></div></div><div className="scene-caption"><div><span>THE 2026 CUP · ONE POSSIBLE RACE</span><strong>One sampled race</strong></div><div className="scene-legend">{renderScene ? "Interactive camera · drag to explore" : "Live order and results below"}</div></div></div></div>
<div className="progress" aria-label="Replay progress"><div className="progress-fill" style={{width:progressPercent + "%"}}></div></div>
<div className="control-row"><button className="quiet" disabled={!sceneSupported} @click={toggleScene}>{!sceneSupported ? "Text only (25+)" : showScene ? "Text view" : "3D view"}</button>#if (interfaceMode === "advanced")<button @click={resetRace}>Restart sample</button><div className="control-setting"><span className="controls-label">Speed</span><div className="control-group" role="group" aria-label="Playback speed"><button className={playbackSpeed === "1" ? "active" : "quiet"} aria-pressed={playbackSpeed === "1"} @click={setSpeed(1)}>1×</button><button className={playbackSpeed === "4" ? "active" : "quiet"} aria-pressed={playbackSpeed === "4"} @click={setSpeed(4)}>4×</button><button className={playbackSpeed === "12" ? "active" : "quiet"} aria-pressed={playbackSpeed === "12"} @click={setSpeed(12)}>12×</button></div></div><div className="control-setting camera-setting"><span className="controls-label">View</span><div className="control-group" role="group" aria-label="Camera view"><button className={cameraMode === "broadcast" ? "active" : "quiet"} aria-pressed={cameraMode === "broadcast"} @click={setCamera("broadcast")}>Broadcast</button><button className={cameraMode === "follow" ? "active" : "quiet"} aria-pressed={cameraMode === "follow"} @click={setCamera("follow")}>Follow</button><button className={cameraMode === "overview" ? "active" : "quiet"} aria-pressed={cameraMode === "overview"} @click={setCamera("overview")}>Overhead</button></div></div><div className="control-setting graphics-setting"><label htmlFor="horse-detail">Horse detail</label><select id="horse-detail" :bind={graphicsDetail} @change={refreshGraphics}><option value="balanced">Balanced · lighter</option><option value="detailed">Detailed</option></select></div>#end</div>
#if (renderScene)<div className="camera-tools" aria-label="Camera controls"><div className="camera-tools-head"><div className="camera-zoom-control" role="group" aria-label="Camera zoom"><button aria-label="Zoom camera out" title="Zoom out" @click={cameraZoom(1.25)}>−</button><output className="camera-zoom-value" aria-label="Camera zoom level">{cameraZoomText}</output><button aria-label="Zoom camera in" title="Zoom in" @click={cameraZoom(0.8)}>+</button></div><button className="quiet camera-reset" @click={resetCameraView}>Reset view</button></div>#if (interfaceMode === "advanced")<div className="camera-drag-choice"><span className="controls-label">Drag mode</span><div className="camera-mode-buttons" role="group" aria-label="Drag interaction"><button className={cameraDragMode === "orbit" ? "active" : "quiet"} aria-pressed={cameraDragMode === "orbit"} @click={setCameraDragMode("orbit")}>Rotate</button><button className={cameraDragMode === "pan" ? "active" : "quiet"} aria-pressed={cameraDragMode === "pan"} @click={setCameraDragMode("pan")}>Pan</button><button className={cameraDragMode === "zoom" ? "active" : "quiet"} aria-pressed={cameraDragMode === "zoom"} @click={setCameraDragMode("zoom")}>Zoom</button></div></div>#end<p id="camera-help" className="help">{interfaceMode === "simple" ? "Drag to turn the view. Use + or − to zoom." : cameraHint}</p>#if (interfaceMode === "advanced")<details className="fold camera-adjustments"><summary>Turn, tilt &amp; move the camera</summary><div className="camera-adjust-grid"><div className="camera-adjust-block" role="group" aria-label="Camera rotation"><span className="controls-label">Turn</span><div className="camera-button-pair"><button aria-label="Turn camera left" @click={cameraRotate(-15)}>↶ Left</button><button aria-label="Turn camera right" @click={cameraRotate(15)}>Right ↷</button></div></div><div className="camera-adjust-block" role="group" aria-label="Camera tilt"><span className="controls-label">Tilt</span><div className="camera-button-pair"><button aria-label="Tilt camera up" @click={cameraTilt(10)}>↑ Up</button><button aria-label="Tilt camera down" @click={cameraTilt(-10)}>↓ Down</button></div></div><div className="camera-adjust-block camera-pan-block" role="group" aria-label="Camera pan"><span className="controls-label">Move the view</span><div className="camera-pan-buttons"><button aria-label="Pan camera left" @click={cameraPan(-1,0)}>← Left</button><button aria-label="Pan camera right" @click={cameraPan(1,0)}>Right →</button><button aria-label="Pan camera up" @click={cameraPan(0,1)}>↑ Up</button><button aria-label="Pan camera down" @click={cameraPan(0,-1)}>↓ Down</button></div></div></div><p id="camera-keyboard-help" className="help">Keyboard on the scene: arrows turn or tilt, Shift + arrows pan, + / − zoom, and 0 resets the view. Camera changes keep following the selected race view.</p></details>#else<p id="camera-keyboard-help" className="visually-hidden">Focus the scene to use arrow keys to turn or tilt, plus or minus to zoom, and zero to reset. Tab moves to the next control.</p>#end</div>#end
#if (interfaceMode === "advanced")<details className="fold replay-tools"><summary>Replay timeline &amp; horse focus</summary><label htmlFor="replay-timeline">Replay time · {clockText}</label><input id="replay-timeline" type="range" min="0" max={replayEndSeconds} step="0.25" value={seekValue} disabled={!hasResult} @change={(value) => seekRace(value)} /><div className="chapter-buttons" role="group" aria-label="Seek by distance remaining"><button disabled={!hasResult} @click={seekChapter(2400)}>2400 m left</button><button disabled={!hasResult} @click={seekChapter(1600)}>1600 m left</button><button disabled={!hasResult} @click={seekChapter(800)}>800 m left</button><button disabled={!hasResult} @click={seekChapter(400)}>400 m left</button><button disabled={!hasResult} @click={seekChapter(0)}>Finish</button></div><p className="help">Seeking pauses this same sampled race. It never draws a new finish.</p><div className="replay-settings-row"><div><label htmlFor="focus-horse">Follow horse</label><select id="focus-horse" :bind={focusHorseId} @change={refreshFocus}><option value="">Race leader</option>#each (horse in field) key={horse.id}#if (horse.active !== false)<option value={horse.id}>{horse.number} · {horse.name}</option>#end#end</select></div><div><label htmlFor="scene-interval">Scene updates</label><select id="scene-interval" :bind={frameInterval} @change={refreshFrameBudget}><option value="33">About 30 updates / second</option><option value="66">About 15 updates / second</option><option value="100">About 10 updates / second</option></select></div></div><p className="help">Horse focus applies to the Follow camera preset. Update frequency is not measured display FPS. The sampled result and timing stay the same.</p><div className="race-minimap"><svg viewBox="0 0 100 30" role="img" aria-label="Illustrative course map with live runner positions"><path d={miniMap.path} fill="none" stroke="#52745b" strokeWidth={1.6} /><circle cx={miniMap.start.x} cy={miniMap.start.y} r={0.7} fill="#b7c6bd" /><circle cx={miniMap.finish.x} cy={miniMap.finish.y} r={0.8} fill="#e9c77e" />#each (marker in miniMap.markers) key={marker.id}<circle cx={marker.x} cy={marker.y} r={marker.focused ? 0.8 : marker.leader ? 0.65 : 0.4} fill={marker.focused ? "#9fe4c6" : marker.leader ? "#e9c77e" : "#edf1e9"} stroke="#0b1711" strokeWidth={0.12} />#end</svg><p className="help">Gold: leader / finish · mint: focused runner. Approximate course, illustrative positions.</p></div></details>#end<Loop interval={Number(frameInterval)} running={running} @tick={tick} /><Loop interval={33} running={analysisRunning} @tick={stepBatch} /><Loop interval={30} running={boxBusy} @tick={stepBoxSearch} /><Loop interval={1000} running={true} @tick={watchAppState} /><Loop interval={50} running={diagnosticsPending} @tick={runQueuedMarketDiagnostics} />
<div className="leaders"><div className="leader-head"><span className="eyebrow">{leaderboardLabel}</span><span className="small">{leaderboardNote}</span></div><div className="leader-strip">#each (runner in leaderboard) key={runner.id}<div className="runner-chip"><span className="rank">{runner.position}</span><span className="swatch" style={{background:runner.colour}}></span><span className="chip-name"><strong>{runner.number} · {runner.name}</strong>{runner.gap}</span></div>#empty<span className="small">Simulate a race to see the runners.</span>#end</div></div></section>
#if (hasResult && raceComplete && resultKey === going+"|"+pace+"|"+barrierMode+"|"+historyMode+"|"+trials+"|"+selectionText+"|"+stake+"|"+fieldText+"|"+modelPreset+"|"+ratingScale+"|"+tripScale+"|"+recencyScale+"|"+softScale+"|"+portfolioMode+"|"+portfolioText+"|"+hypotheticalDividend+"|"+researchClamp+"|"+acceptedSnapshotId)
<section className="card"><div className="card-head"><div><div className="eyebrow">One possible finish</div><h2>Full race result</h2></div><span className="tag">Illustrative</span></div><div className="body"><div className="finish-outcome">{portfolioMode ? sampledPortfolioText : !ticketPresent ? "Sample complete. No boxed trifecta was selected." : boxWon ? "✓ Your boxed trifecta covered this sampled finish." : "Your boxed trifecta did not cover this sampled finish."}</div><div className="finish-grid">#each (runner in finishRows) key={runner.id}<div className="finish-row"><span className="finish-rank">{runner.position}</span><span className="swatch" style={{background:runner.colour}}></span><span className="finish-name">{runner.number} · {runner.name}</span><span className="finish-gap">{runner.gap}</span></div>#end</div><p className="help">These are model-generated placings and illustrative time gaps for one sample, not actual race results.</p></div></section>#end
#if (interfaceMode === "simple")<section id="simple-forecast" className="card simple-forecast"><div className="card-head"><div><div className="eyebrow">Across many simulated races</div><h2>Leading chances</h2></div></div><div className="body">#if (hasResult && resultKey === going+"|"+pace+"|"+barrierMode+"|"+historyMode+"|"+trials+"|"+selectionText+"|"+stake+"|"+fieldText+"|"+modelPreset+"|"+ratingScale+"|"+tripScale+"|"+recencyScale+"|"+softScale+"|"+portfolioMode+"|"+portfolioText+"|"+hypotheticalDividend+"|"+researchClamp+"|"+acceptedSnapshotId)<p className="help">Top five by model win chance. Every active runner is included in the simulations.</p><div className="simple-forecast-head"><span>Runner</span><span>Win</span><span>Top 3</span></div><ol className="simple-forecast-list">#each (runner in forecastRows.slice(0,5)) key={runner.id}<li><span className="simple-runner-name">{runner.number} · {runner.name}</span><strong>{runner.winText}</strong><span>{runner.exactTop3Text}</span></li>#end</ol><p className="help">Model estimates, not guarantees. The race above is one possible outcome.</p><button className="quiet" @click={setInterfaceMode("advanced")}>View full analysis</button>#else<p className="small">Run &amp; watch to see the leading chances and a fresh race.</p>#end</div></section>#end<section id="box-suggestions" className="card box-suggestions"><div className="card-head"><div><div className="eyebrow">Compare sets of runners</div><h2>Top boxed trifectas</h2></div></div><div className="body"><p className="help">Three-horse boxes rank by exact model probability across all active runners by default. Larger boxes use sampled hits within a candidate pool. A box covers its runners in any first-three order; every active horse remains in the race.</p><div className="box-search-controls"><div><label htmlFor="box-size">Horses per box</label><select id="box-size" :bind={boxSize} @change={checkBoxFreshness}><option value="3">3 horses · 6 combinations</option><option value="4">4 horses · 24 combinations</option><option value="5">5 horses · 60 combinations</option><option value="6">6 horses · 120 combinations</option><option value="7">7 horses · 210 combinations</option><option value="8">8 horses · 336 combinations</option><option value="9">9 horses · 504 combinations</option><option value="10">10 horses · 720 combinations</option></select></div><div className="box-count-control"><label htmlFor="box-count">Box count</label><input id="box-count" type="number" inputMode="numeric" min="1" max="25" step="1" :bind={boxCount} @change={checkBoxFreshness} /></div><button @click={calculateBoxSuggestions} disabled={boxBusy || analysisRunning}>{boxBusy ? "Ranking boxes…" : hasResult ? "Rank boxes from this batch" : "Run batch & rank boxes"}</button></div>#if (interfaceMode === "advanced")<details className="fold box-candidate-controls"><summary>Choose the search candidates</summary><label htmlFor="box-candidates">Candidate saddlecloth numbers · maximum 12</label><input id="box-candidates" :bind={boxCandidateText} @change={checkBoxFreshness} autoComplete="off" spellCheck={false} placeholder="Leave blank for the default pool" /><p className="help">Blank searches every active runner for 3-horse boxes; larger boxes use up to 12 runners selected by simulated top-three frequency. Enter up to 12 active runners to restrict the search.</p></details>#end<p className="small box-search-status" role="status">{boxStatus}</p>#if (boxBusy)<button className="quiet" @click={cancelBoxSuggestions}>Cancel search</button>#end#if (boxError)<p className="error" role="alert">{boxError}</p>#end#if (boxPoolText)<p className="help">{boxPoolText}</p>#end#if (boxDiversifiedRows.length > 0)<div className="box-copy-panel" role="region" aria-label="Generated box numbers"><div className="box-copy-head"><div><h3>{boxDiversifiedRows.length} generated boxed {boxDiversifiedRows.length === 1 ? "ticket" : "tickets"}</h3><p>{boxSize} horses per box · all generated boxes included</p></div><CopyButton className="box-number-copy" value={boxNumbersText} label="Copy box numbers" copiedLabel="Box numbers copied" variant="primary" size="md" /></div><p id="box-copy-help" className="help">Numbers only. Each line is one separate boxed ticket covering those horses in any first-three order; it is not one ordered trifecta.</p><p className="help box-set-cost">This set contains {boxDiversifiedRows.length * Number(boxSize) * (Number(boxSize) - 1) * (Number(boxSize) - 2)} ordered selections across all tickets, costing ${boxDiversifiedRows.length * Number(boxSize) * (Number(boxSize) - 1) * (Number(boxSize) - 2)} at $1 per selection. Overlapping selections are paid for again. For example, 25 four-horse boxes cost $600 at full unit; $150 would be 25% flexi, subject to the bookmaker’s rules and minimums. Flexi scales any payout.</p><label htmlFor="box-numbers">All box numbers · one ticket per line</label><textarea id="box-numbers" value={boxNumbersText} readOnly={true} spellCheck={false} wrap="off" rows={Math.min(8,Math.max(2,boxDiversifiedRows.length))} aria-describedby="box-copy-help box-copy-fallback"></textarea><p id="box-copy-fallback" className="help">If copying is unavailable, select and copy the text above. Names, odds and probabilities are kept out of this list.</p></div><details className="fold box-collection"><summary>25-box stake &amp; settlement calculator</summary><p className="help">Every amount below is the <strong>total stake per ticket</strong>, not the stake per combination. Flexi percentages use a $1 per ordered outcome unit. Overlapping tickets cost again; union coverage counts overlap once. No bets are placed.</p>#if (boxCollectionDefaultInfo)<p className="help">{boxCollectionDefaultInfo}</p>#end<div className="box-collection-controls"><div><label htmlFor="collection-all-stake">Stake per ticket (AUD)</label><input id="collection-all-stake" type="number" inputMode="decimal" min="0.01" step="0.01" :bind={boxCollectionAllStake} /></div><button className="quiet" @click={applyBoxCollectionStake}>Apply to all</button></div><div className="box-collection-controls"><div><label htmlFor="collection-operator">Stake validation</label><select id="collection-operator" :bind={boxCollectionProfile} @change={calculateBoxCollection}><option value="generic">Generic research calculator</option><option value="tab">TAB published flexi checks</option></select></div><button className="quiet" @click={setBoxCollectionFullUnit}>Set 100% of $1 unit for every box</button></div>#if (boxCollectionFullUnitPreview)<p className="help">{boxCollectionFullUnitPreview} Review the combined total before using it.</p>#end<p className="help">TAB checks use published minimum investment, increments and minimum percentage. Passing them does not guarantee acceptance: check current operator, channel and product rules. <a href="https://help.tab.com.au/betting-on-racing/what-is-flexi-betting" target="_blank" rel="noopener noreferrer">TAB flexi betting rules</a>.</p>#if (boxCollectionValidation)<p className="help" role="status">{boxCollectionValidation}</p>#end#if (boxCollectionSummary)<p className="help">{boxCollectionSummary}</p>#end#if (boxCollectionError)<p className="error" role="alert">{boxCollectionError}</p>#end<div className="box-collection-list">#each (ticket in boxCollectionRows) key={ticket.id}<div className="box-collection-row"><div><strong>#{ticket.rank} · {ticket.selectionText}</strong><p className="help">{ticket.combinations} ordered outcomes · {ticket.flexiText}</p></div><div><label htmlFor={"collection-"+ticket.id}>Total stake (AUD)</label><input id={"collection-"+ticket.id} type="number" inputMode="decimal" min="0.01" step="0.01" value={ticket.stake} @change={(value) => setBoxCollectionStake(ticket.id,value)} /></div></div>#end</div><div className="box-collection-controls"><div><label htmlFor="collection-finish">First three horse numbers (optional)</label><input id="collection-finish" type="text" placeholder="e.g. 1, 2, 3" :bind={boxCollectionFinish} @change={calculateBoxCollection} /></div><div><label htmlFor="collection-dividend">Declared $1 dividend (optional)</label><input id="collection-dividend" type="number" inputMode="decimal" min="0" step="0.01" :bind={boxCollectionDividend} @change={calculateBoxCollection} /></div><button className="quiet" @click={calculateBoxCollection}>Calculate scenario</button></div><p className="help">The entered finish and dividend are illustrative. Actual bookmaker minimums, dividend rules and rounding may differ.</p>#if (boxCollectionSettleError)<p className="error" role="alert">{boxCollectionSettleError}</p>#end#if (boxCollectionOutcome)<p className="help">{boxCollectionOutcome}</p>#end#if (boxCollectionReceiptText)<div className="box-collection-receipt"><h4>Review your receipt before copying</h4><p className="help">Check the ticket stakes, combinations, percentage basis and total outlay. This is a calculation, not a betslip.</p><textarea id="collection-receipt" value={boxCollectionReceiptText} readOnly={true} spellCheck={false} rows={6} aria-label="Collection receipt"></textarea><CopyButton value={boxCollectionReceiptText} label="Copy receipt" copiedLabel="Receipt copied" variant="secondary" size="md" /></div>#end#if (boxCollectionCopy)<CopyButton value={boxCollectionCopy} label="Copy boxes and stakes" copiedLabel="Copied" variant="secondary" size="md" />#end</details>#end<div className="ranked-box-list">#each (box in boxTopRows.slice(0,interfaceMode === "simple" ? 3 : 10)) key={box.id}<article className="ranked-box"><div className="ranked-box-head"><span className="box-rank">{box.rank}</span><div><h3>{box.selectionText}</h3>#if (box.runnersText)<p className="box-runner-names">{box.runnersText}</p>#end</div></div><dl className="ranked-box-metrics"><div><dt>Exact model coverage</dt><dd>{box.exactText}</dd></div><div><dt>Sampled coverage</dt><dd>{box.sampledText}</dd></div><div><dt>Hits in this batch</dt><dd>{box.hitText}</dd></div><div><dt>Ordered combinations</dt><dd>{box.combinationText}</dd></div></dl><button className="quiet" @click={applySuggestedBox(box.id)}>Use this quick box</button></article>#empty<p className="small">Rank boxes of your chosen size; a simulation batch runs first if needed. Larger boxes cover more outcomes and require more combinations.</p>#end</div><p className="help">100,000 simulations reduce sampling noise, not model uncertainty. These rankings do not guarantee a winner or a payout. Selection-adjusted uncertainty is not shown.</p>#if (interfaceMode === "simple")<button className="quiet" @click={setInterfaceMode("advanced")}>More boxes &amp; search options</button>#else<details className="fold box-ranking-notes"><summary>What these rankings mean</summary><p className="help">Three-horse boxes are ordered by exact model probability, across all active runners unless you specify a pool. Larger boxes are ordered by sampled hit count within the stated pool; the greedy set need not be globally optimal. Sampled coverage is a diagnostic from this batch. Changing the search size or candidates does not resample the race or change horse strengths.</p><p className="help">Results are ranked within the stated pool. Exact three-horse rankings are optimal only within that pool and under this model, which is not calibrated to real-world results. Larger boxes have more combinations. No actual dividend or expected monetary return is inferred.</p></details>#end#if (boxDiversifiedRows.length > 0)<details className="fold diversified-boxes"><summary>{boxDiversifiedRows.length} boxes with incremental coverage</summary><p className="small">{boxDiverseStatus}</p><p className="help">For 3-horse boxes, distinct sets cover disjoint outcomes and the highest exact-model probabilities maximize model coverage within the stated pool. Larger boxes use greedy simulated coverage; overlap is counted once and the set may not be globally optimal.</p><div className="diversified-box-list">#each (box in boxDiversifiedRows) key={box.id}<article><h3>{box.rank} · {box.selectionText}</h3>#if (box.runnersText)<p className="box-runner-names">{box.runnersText}</p>#end<dl><div><dt>Individual exact coverage</dt><dd>{box.exactText}</dd></div><div><dt>Individual sampled coverage</dt><dd>{box.sampledText}</dd></div><div><dt>Additional coverage</dt><dd>{box.marginalText}</dd></div><div><dt>Combined coverage so far</dt><dd>{box.unionText}</dd></div></dl></article>#end</div><CopyButton value={boxSuggestionsText} label="Copy detailed analysis" /><button @click={useDiversifiedPortfolio} disabled={boxDiversifiedRows.length > 6}>Use these boxes as a portfolio</button>#if (boxDiversifiedRows.length > 6)<p className="help">Portfolio Lab supports up to six; copy/export the full set, or reduce the count.</p>#else<p className="help">$1 per ticket initially for illustration; edit stakes in Portfolio Lab. No bets are placed.</p>#end</details>#end</div></section>#if (interfaceMode === "simple" && portfolioMode)<section className="card simple-portfolio"><div className="card-head"><div><div className="eyebrow">Your portfolio</div><h2>{portfolioRows.length} tickets · {portfolioSummary.totalStakeText}</h2></div></div><div className="body"><p className="portfolio-hero"><span>Model chance any ticket pays</span><strong>{portfolioSummary.anyText}</strong></p><p className="help">Overlaps counted once. Conditional on an uncalibrated model; actual dividend unknown.</p>#if (portfolioError)<p className="error" role="alert">{portfolioError}</p>#end<div className="button-row"><button @click={setInterfaceMode("advanced")}>Edit portfolio in Advanced</button><button className="quiet" @click={disablePortfolio}>Use quick box</button></div></div></section>#end#if (!portfolioMode)<section className="card ticket-card"><div className="body"><details className="fold ticket-fold simple-ticket"><summary>Optional: pick your top three</summary><p className="help">Pick at least three runners for a boxed trifecta, or leave this empty to just watch the race.</p><label htmlFor="selection">Your numbers</label><input id="selection" inputMode="text" autoComplete="off" spellCheck={false} :bind={selectionText} @change={refreshSelection} placeholder="1, 2, 3, 4" /><label htmlFor="stake">Total stake (AUD)</label><input id="stake" type="number" inputMode="decimal" min="0" step="0.01" :bind={stake} /><div className="ticket-runner-grid">#each (horse in field) key={horse.id}#if (horse.active !== false)<button className={horse.selected ? "ticket-runner active" : "ticket-runner quiet"} aria-pressed={horse.selected} @click={toggleTicket(horse.number)}><span>{horse.number}</span>{horse.name}</button>#end#end</div>#if (ticketPresent && hasResult && resultKey === going+"|"+pace+"|"+barrierMode+"|"+historyMode+"|"+trials+"|"+selectionText+"|"+stake+"|"+fieldText+"|"+modelPreset+"|"+ratingScale+"|"+tripScale+"|"+recencyScale+"|"+softScale+"|"+portfolioMode+"|"+portfolioText+"|"+hypotheticalDividend+"|"+researchClamp+"|"+acceptedSnapshotId)<div className="ticket-summary"><strong>Model box coverage: {coverage}</strong><p className="small">{ticketText}</p></div>#end</details></div></section>#end#if (interfaceMode === "simple")<section className="card simple-audit"><div className="body"><h2>Audit status</h2><p className="small">{marketStatus}</p>#if (biasSummary)<p className="help">{biasSummary}</p>#end<p className="help">Calibration not established. Market comparisons never change your simulation.</p><button className="quiet" @click={setInterfaceMode("advanced")}>Explore audits in Advanced</button></div></section>#end#if (interfaceMode === "advanced")<section id="portfolio-lab" className="card portfolio-lab"><div className="body"><details className="fold"><summary>Trifecta Portfolio Lab<span className="setting-summary">{portfolioMode ? portfolioRows.length + " tickets · " + portfolioSummary.totalStakeText : "Optional · up to six tickets"}</span></summary><p className="help">Compare overlapping boxed or ordered trifectas across the same full field. Exact coverage is conditional on the selected model; overlapping chances are never added together.</p><details className="fold portfolio-json"><summary>Import or export portfolio JSON</summary><p className="help">Save the ticket definitions separately from the horse field. Preparing JSON replaces the text below with the current portfolio.</p><label htmlFor="portfolio-json">Portfolio JSON</label><textarea id="portfolio-json" :bind={portfolioJSONText} spellCheck={false} placeholder="Prepare an export or paste portfolio JSON"></textarea><div className="button-row"><button @click={preparePortfolioJSON}>Prepare portfolio JSON</button><button @click={applyPortfolioJSON}>Import portfolio JSON</button><CopyButton value={portfolioJSONText} label="Copy JSON" /></div></details>#if (portfolioError)<p className="error" role="alert">{portfolioError}</p>#end#if (!portfolioMode)<button @click={enablePortfolio}>Use portfolio mode</button><p className="help">Your quick-box selection is retained while the portfolio is active.</p>#else<div className="portfolio-toolbar"><button @click={addPortfolioTicket} disabled={portfolioRows.length >= 6}>Add ticket</button><button className="quiet" @click={disablePortfolio}>Use quick box instead</button></div><details className="fold nested-wizard"><summary>Create nested boxes or load the saved example</summary><p className="help">List runners in priority order. Each tier takes that many runners from the start of your list; larger boxes include every smaller tier. Creating tiers replaces the portfolio rows.</p><label htmlFor="nested-numbers">Priority saddlecloth numbers</label><input id="nested-numbers" :bind={nestedNumbers} autoComplete="off" spellCheck={false} placeholder="20, 2, 11, 12, 4, 16, 1, 10, 22, 24" /><div className="portfolio-fields"><div><label htmlFor="nested-tiers">Tier sizes</label><input id="nested-tiers" :bind={nestedTiers} inputMode="text" autoComplete="off" spellCheck={false} placeholder="4, 6, 8, 9, 10" /></div><div><label htmlFor="nested-stakes">Total stake per tier (AUD)</label><input id="nested-stakes" :bind={nestedStakes} inputMode="text" autoComplete="off" spellCheck={false} placeholder="24, 30, 40, 50, 96" /></div></div><p className="help">Choose increasing sizes from 4, 6, 8, 9 and 10. Enter one comma-separated stake per tier, in the same order. All runners must be active.</p><button @click={createNestedPortfolio}>Create nested portfolio</button><p className="help">The supplied 4 / 6 / 10 example uses total stakes of $24, $30 and $96. It also replaces the portfolio rows and is not a recommendation.</p><button className="quiet" @click={loadNestedPortfolio}>Load 4 / 6 / 10 portfolio</button></details><div className="portfolio-ticket-list">#each (ticket in portfolioRows) key={ticket.id}<article className="portfolio-ticket"><div className="portfolio-ticket-head"><strong>{ticket.name || "Unnamed ticket"}</strong><button className="quiet" aria-label={"Remove " + (ticket.name || "ticket")} @click={removePortfolioTicket(ticket.id)}>Remove</button></div><div className="portfolio-fields"><div><label htmlFor={"ticket-name-" + ticket.id}>Ticket name</label><input id={"ticket-name-" + ticket.id} value={ticket.name} maxLength={60} @change={(value) => updatePortfolioTicket(ticket.id,"name",value)} /></div><div><label htmlFor={"ticket-type-" + ticket.id}>Type</label><select id={"ticket-type-" + ticket.id} value={ticket.type} @change={(value) => updatePortfolioTicket(ticket.id,"type",value)}><option value="box">Boxed trifecta</option><option value="ordered">Ordered trifecta</option></select></div><div className="portfolio-selection"><label htmlFor={"ticket-selection-" + ticket.id}>Saddlecloth numbers</label><input id={"ticket-selection-" + ticket.id} value={ticket.selectionText} autoComplete="off" spellCheck={false} placeholder="20, 2, 11, 12" @change={(value) => updatePortfolioTicket(ticket.id,"selectionText",value)} /><p className="help">{ticket.type === "ordered" ? "Exactly three, in first / second / third order." : "At least three distinct active runners; any finishing order."}</p></div><div><label htmlFor={"ticket-stake-" + ticket.id}>Total stake (AUD)</label><input id={"ticket-stake-" + ticket.id} type="number" inputMode="decimal" min="0" step="0.01" value={ticket.stake} @change={(value) => updatePortfolioTicket(ticket.id,"stake",value)} /></div></div><dl className="ticket-metrics"><div><dt>Combinations</dt><dd>{ticket.combinationsText}</dd></div><div><dt>Flexi share per combination</dt><dd>{ticket.shareText}</dd></div><div><dt>Exact model coverage</dt><dd>{ticket.coverageText}</dd></div></dl>#if (ticket.sampleStatus)<p className="small">{ticket.sampleStatus}</p>#end</article>#empty<p className="small">Add a ticket or load the nested example to begin.</p>#end</div><button className="quiet" @click={refreshPortfolio}>Update portfolio analysis</button>#if (!portfolioError)<div className="portfolio-exact-summary"><p><strong>Total portfolio stake</strong><span>{portfolioSummary.totalStakeText}</span></p><div className="portfolio-probabilities"><div><span>At least one pays</span><strong>{portfolioSummary.anyText}</strong></div><div><span>Exactly one</span><strong>{portfolioSummary.exactlyOneText}</strong></div><div><span>Exactly two</span><strong>{portfolioSummary.exactlyTwoText}</strong></div><div><span>Three or more</span><strong>{portfolioSummary.threePlusText}</strong></div></div>#if (portfolioSummary.notice)<p className="help">{portfolioSummary.notice}</p>#end</div>#end<details className="fold payout-fold"><summary>Hypothetical payout scenarios</summary><label htmlFor="hypothetical-dividend">Declared dividend scenario (AUD per $1)</label><input id="hypothetical-dividend" type="number" inputMode="decimal" min="0" step="0.01" placeholder="Unknown — enter a hypothetical value" :bind={hypotheticalDividend} @change={refreshPortfolio} /><p className="money-limit"><strong>{expectedMoneyText}.</strong></p><p className="help">Actual dividend unknown. This is a user-supplied scenario, not a dividend forecast. Gross payout adds the winning tickets’ flexi shares; net subtracts the entire portfolio stake, including losing tickets.</p>#if (payoutRows.length > 0)<div className="payout-case-list">#each (row in payoutRows) key={row.id}<article className="payout-case"><strong>{row.label}</strong><dl><div><dt>Exact model chance</dt><dd>{row.probabilityText}</dd></div><div><dt>Scenario gross</dt><dd>{row.grossText}</dd></div><div><dt>Net after all stakes</dt><dd>{row.netText}</dd></div></dl></article>#end</div><p className="small">Hypothetical mean gross: {portfolioSummary.expectedPayoutText}<br />Hypothetical mean net: {portfolioSummary.netText}</p><p className="help">These conditional averages assume the same entered dividend for each covered outcome. Expected monetary payout is not estimable without outcome-specific dividends; these are not expected real-world returns.</p>#else<p className="small">Enter a dividend scenario after validating your tickets to see the overlap cases.</p>#end</details>#end</details></div></section><section id="market-audit" className="card audit-panel"><div className="body"><details className="fold"><summary>Market &amp; research audit<span className="setting-summary">Offline diagnostics · calibration not established</span></summary><p className="help">Compare independent views of the whole active field. Odds, shortlist choices, review notes and these diagnostic controls never change race strengths or the sampled finish.</p><p className="small" role="status">{marketStatus}</p>#if (diagnosticsNotice)<p className="audit-feedback" role="status">{diagnosticsNotice}</p>#end<details className="fold audit-section"><summary>Import an offline market snapshot</summary><p className="help">No prices are bundled. Enter or import quotes you are permitted to use, with their original source and actual capture time. Do not substitute today's time for an earlier capture.</p><label htmlFor="market-format">Input format</label><select id="market-format" :bind={marketFormat}><option value="json">JSON snapshot</option><option value="csv">CSV quotes + metadata</option><option value="manual">Manual odds + metadata</option></select>#if (marketFormat !== "json")<div className="audit-form-grid"><div><label htmlFor="market-provider">Source / provider name</label><input id="market-provider" :bind={marketProvider} placeholder="Source of the quoted prices" /></div><div><label htmlFor="market-url">Original source URL</label><input id="market-url" type="url" :bind={marketSourceUrl} autoComplete="off" placeholder="https://…" /></div><div><label htmlFor="market-time">Observed at · exact time with timezone</label><input id="market-time" :bind={marketObservedAt} autoComplete="off" placeholder="YYYY-MM-DDTHH:mm:ss+11:00" /></div><div><label htmlFor="market-currency">Currency</label><input id="market-currency" :bind={marketCurrency} maxLength={3} /></div><div><label htmlFor="market-type">Market type</label><select id="market-type" :bind={marketType}><option value="WIN">WIN</option><option value="PLACE">PLACE · stored, not compared as WIN</option></select></div></div><label className="audit-check"><input type="checkbox" :bind={marketDeclaredComplete} /><span>This snapshot declares prices for the complete active field</span></label><label htmlFor="market-notes">Source, reuse permission and uncertainty notes</label><textarea id="market-notes" :bind={marketNotes} placeholder="Record limitations and your basis for using this snapshot"></textarea><p className="help">Quotes use decimal odds greater than 1. Partial or incompatible snapshots cannot become a complete-field WIN comparison. Ordered tote outcomes require their separate JSON schema, including the unit stake.</p>#end#if (marketFormat === "manual")<div className="manual-odds-list">#each (quote in marketManualRows) key={quote.id}<div className="manual-odds-row"><label htmlFor={"odds-"+quote.id}><strong>{quote.number} · {quote.name}</strong><small>{quote.status}</small></label><input id={"odds-"+quote.id} type="text" inputMode="decimal" value={quote.odds} @change={(value) => updateManualOdds(quote.id,value)} placeholder="No quote" /></div>#end</div>#else<label htmlFor="market-input">{marketFormat === "csv" ? "CSV quote rows" : "Market snapshot JSON"}</label><textarea id="market-input" :bind={marketText} spellCheck={false} placeholder={marketFormat === "csv" ? "horseId,number,decimalOdds,status" : "Paste a timestamped market snapshot"}></textarea>#if (marketFormat === "csv")<p className="help">Required header: <code>horseId,number,decimalOdds,status</code>. Optional column: <code>notes</code>. Use IDs from the horse JSON; status is active, scratched or withdrawn.</p>#end#end<div className="button-row"><button @click={importMarket} disabled={diagnosticsBusy}>Import market snapshot</button><button className="quiet" @click={pickMarketJSON} disabled={diagnosticsBusy}>Import JSON file</button></div><p className="help">No network fetch occurs. Importing a price validates its structure, not the provider's truth or the timestamp's authenticity. WIN comparison requires a compatible complete snapshot captured within the 60-minute freshness policy and before the race cutoff.</p></details>#if (marketError)<p className="error" role="alert">{marketError}</p>#end<details className="fold audit-section"><summary>Saved market snapshots &amp; export</summary><label htmlFor="market-history">Snapshot to compare</label><select id="market-history" :bind={selectedMarketId} @change={selectMarketSnapshot}><option value="">No market selected</option>#each (snapshot in marketHistoryRows) key={snapshot.id}<option value={snapshot.id}>{snapshot.label} · {snapshot.status}</option>#end</select><p className="help">{marketAsOfText}</p>#if (marketSourceHref)<p className="market-source-link"><a href={marketSourceHref} target="_blank" rel="noopener noreferrer">{marketSourceLabel} ↗</a></p>#end<div className="button-row"><button @click={prepareMarketJSON}>Prepare market JSON</button><button @click={saveMarketJSON}>Download market JSON</button></div><label htmlFor="market-export">Market snapshot JSON</label><textarea id="market-export" :bind={marketJSONText} spellCheck={false}></textarea><CopyButton value={marketJSONText} label="Copy market JSON" /></details><details className="fold audit-section"><summary>Whole-field comparison</summary><div className="audit-form-grid"><div><label htmlFor="comparison-research">Research comparison</label><select id="comparison-research" :bind={comparisonResearchChoice} @change={refreshDiagnostics}><option value="pilot">Illustrative pilot · 0.06 / 0.04 / 0.02</option><option value="current">Current research coefficients</option></select></div><div><label htmlFor="comparison-sort">Sort all runners by</label><select id="comparison-sort" :bind={comparisonSort} @change={refreshDiagnostics}><option value="number">Saddlecloth number</option><option value="baseline">Baseline win chance</option><option value="research">Research win chance</option><option value="market">Market-normalised WIN proxy</option><option value="gap">Largest absolute research / market gap</option></select></div></div><div className="audit-checkboxes"><label className="audit-check"><input type="checkbox" :bind={marketVisible} @change={refreshDiagnostics} /><span>Show the market comparator</span></label><label className="audit-check"><input type="checkbox" :bind={comparisonHideShortlist} @change={refreshDiagnostics} /><span>Hide shortlist markers</span></label></div><button className="quiet" @click={refreshDiagnostics} disabled={diagnosticsBusy}>{diagnosticsBusy ? "Calculating diagnostics…" : "Refresh diagnostic comparisons"}</button><p className="small">{comparisonScenarioText}</p><p className="small">{marketSummary}</p><p className="help">{marketAsOfText}</p>#if (marketSourceHref)<p className="market-source-link"><a href={marketSourceHref} target="_blank" rel="noopener noreferrer">{marketSourceLabel} ↗</a></p>#end<p className="help">{marketMethodText}</p><p className="help">Positive gaps mean research assigns more probability than this market proxy, in percentage points. They are not value-bet signals. The shortlist is a human choice; neither comparison changes it.</p><div className="comparison-table-wrap"><table className="audit-table"><caption>All active runners · model probabilities and a separate market proxy</caption><thead><tr><th scope="col">Runner</th><th scope="col">Original baseline</th><th scope="col">Research what-if</th><th scope="col">Market WIN proxy</th><th scope="col">Research − market</th></tr></thead><tbody>#each (row in comparisonRows) key={row.id}<tr><td data-label="Runner"><strong>{row.number} · {row.name}</strong>#if (!comparisonHideShortlist && row.selected)<span className="shortlist-label">In subjective shortlist</span>#end<details className="fold discrepancy-detail"><summary>Why views differ</summary><p>{row.explanation}</p><p>{row.missingText}</p>#if (row.sourceUrl)<a href={row.sourceUrl} target="_blank" rel="noopener noreferrer">{row.sourceLabel} ↗</a>#end</details></td><td data-label="Baseline"><strong>{row.baselineText} win</strong><small>{row.baselineTop3Text} top 3</small></td><td data-label="Research"><strong>{row.researchText} win</strong><small>{row.researchTop3Text} top 3</small></td><td data-label="Market">#if (marketVisible)<strong>{row.marketText} WIN proxy</strong><small>Quoted odds: {row.oddsText}</small><small>{row.marketTop3Text} derived PL top 3</small>#else<span>Hidden</span>#end</td><td data-label="Gap">{marketVisible ? row.deltaText : "Hidden"}</td></tr>#empty<tr><td colSpan={5}>Refresh diagnostics to compare the active field. Market values require a compatible complete WIN snapshot.</td></tr>#end</tbody></table></div><details className="fold probability-chart"><summary>Compare win chances as bars</summary><p className="help">Bars use a common 0–100% win-chance scale and repeat the percentages in the table. Labels and numbers identify each series. A blank market value is unknown, not zero.</p><div className="probability-bars">#each (row in comparisonRows) key={row.id}<div className="probability-bar-runner"><strong>{row.number} · {row.name}</strong><div className="probability-bar-line"><span>Baseline</span><div aria-hidden="true"><i className="baseline-bar" style={{width:row.baselineWidth}}></i></div><b>{row.baselineText}</b></div><div className="probability-bar-line"><span>Research</span><div aria-hidden="true"><i className="research-bar" style={{width:row.researchWidth}}></i></div><b>{row.researchText}</b></div>#if (marketVisible)<div className="probability-bar-line"><span>Market</span><div aria-hidden="true"><i className="market-bar" style={{width:row.marketWidth}}></i></div><b>{row.marketText}</b></div>#end</div>#end</div></details><details className="fold market-coverage"><summary>Separate market-derived ticket approximation</summary><p className="small">{marketCoverageText}</p><p className="help">Normalised WIN quotes can parameterise another Plackett–Luce ordering model. Its ticket coverage is a derived approximation, not a quoted trifecta market, actual dividend or independently validated forecast.</p><p className="money-limit"><strong>{expectedMoneyText}.</strong></p></details></details><details className="fold audit-section"><summary>Selection and annotation influence</summary><p className="help">Compare analyst adjustments for selected and unselected runners. A difference may reveal circular confirmation risk; it does not prove deliberate manipulation or a causal bias. Every probability still uses the full active field.</p><p className="small">{biasSummary}</p><div className="bias-stat-grid">#each (group in biasRows) key={group.id}<article><strong>{group.label}</strong><span>{group.count} runners</span><dl><dt>Mean log adjustment</dt><dd>{group.meanText}</dd><dt>Median log adjustment</dt><dd>{group.medianText}</dd></dl></article>#empty<p className="small">Refresh diagnostics to inspect label influence.</p>#end</div><details className="fold"><summary>Rating bands and field status</summary><div className="bias-band-list">#each (group in biasBandRows) key={group.id}<div><strong>{group.label}</strong><span>{group.count} runners · mean {group.meanText} · median {group.medianText}</span><small>{group.gapText}</small></div>#empty<p className="small">No eligible group comparison is available.</p>#end</div></details><details className="fold"><summary>Remove one research component at a time</summary><p className="help">Compare base only, trip only, recent form only, surface only and all research components. These diagnostics do not switch your active model or alter your ticket selections.</p><button @click={runResearchAblations} disabled={diagnosticsBusy}>Calculate research ablations</button><div className="ablation-grid">#each (row in ablationRows) key={row.id}<article><h3>{row.label}</h3><p>{row.leader}</p><p className="small">{row.rankChangeText}</p><p className="small">{row.coverageText}</p><p className="help">{row.ticketText}</p></article>#empty<p className="small">Calculate to compare rankings and exact ticket coverage across these hypotheses.</p>#end</div></details></details><details className="fold audit-section"><summary>Evidence display &amp; independent review</summary><p className="help">The following filters change which evidence is shown in horse profiles. They do not change forecasts or model coefficients.</p><div className="audit-checkboxes"><label className="audit-check"><input type="checkbox" :bind={evidenceShowObserved} /><span>Show observed fields</span></label><label className="audit-check"><input type="checkbox" :bind={evidenceShowAnalyst} /><span>Show analyst interpretations</span></label><label className="audit-check"><input type="checkbox" :bind={evidenceShowManual} /><span>Show manual test fields</span></label></div><p className="help">Blind review hides identities, shortlist markers and market values while you score structured facts. Distinctive records can still reveal a runner.</p><button @click={enterBlindReview}>Start blind research review</button><details className="fold"><summary>Annotation JSON &amp; reviewer disagreements</summary><p className="help">Imported annotations stay attributed, unverified hypotheses. Conflicting reviews are shown separately; qualitative labels are not silently averaged or applied to the simulation.</p><label htmlFor="annotation-json">Research annotation JSON</label><textarea id="annotation-json" :bind={annotationJSONText} spellCheck={false}></textarea><div className="button-row"><button @click={importAnnotations}>Import annotations</button><button @click={prepareAnnotationsJSON}>Prepare annotation JSON</button><CopyButton value={annotationJSONText} label="Copy annotations" /></div><p className="audit-feedback" role="status">{annotationStatus}</p>#if (annotationError)<p className="error" role="alert">{annotationError}</p>#end<div className="annotation-disputes">#each (dispute in annotationDisputeRows) key={dispute.id}<p>{dispute.text}</p>#empty<p className="help">No reviewer disputes are available to compare.</p>#end</div></details></details></details></div></section><section className="card ensemble"><div className="card-head"><div><div className="eyebrow">Thousands of possible races</div><h2>Batch forecast</h2></div></div><div className="body">
#if (analysisRunning)<p className="small">Analysis is running. Progress is shown beside the race controls.</p>#else
#if (hasResult && resultKey === going+"|"+pace+"|"+barrierMode+"|"+historyMode+"|"+trials+"|"+selectionText+"|"+stake+"|"+fieldText+"|"+modelPreset+"|"+ratingScale+"|"+tripScale+"|"+recencyScale+"|"+softScale+"|"+portfolioMode+"|"+portfolioText+"|"+hypotheticalDividend+"|"+researchClamp+"|"+acceptedSnapshotId)<p className="batch-summary">{batchSummary}</p><details className="fold comparison-fold"><summary>Rating-scale sensitivity</summary><p className="help">Compare the same accepted field and tickets across rating divisors. This is an assumption comparison, not a confidence interval or evidence that one divisor forecasts better.</p><button className="quiet" @click={refreshComparisons}>Calculate comparisons</button><div className="comparison-list">#each (row in ratingSensitivityRows) key={row.id}<article className="comparison-item"><strong>{row.label}</strong><p>Leading runner: {row.leader}</p><p>Portfolio any payout: {row.portfolioAnyText}<br />Quick-box coverage: {row.quickBoxText}</p><small>{row.notes}</small></article>#empty<p className="small">Calculate comparisons to see how the rating divisor changes the estimates.</p>#end</div></details><details className="fold comparison-fold"><summary>Good / Soft / Heavy comparison</summary><p className="help">Alternative race-condition scenarios, not an official race-day rating or a weather forecast. The field, model and tickets stay fixed while the selected going changes.</p><button className="quiet" @click={refreshComparisons}>Calculate comparisons</button><div className="comparison-list">#each (row in goingComparisonRows) key={row.id}<article className="comparison-item"><strong>{row.label}</strong><p>Leading runner: {row.leader}</p><p>Portfolio any payout: {row.portfolioAnyText}<br />Quick-box coverage: {row.quickBoxText}</p><small>{row.notes}</small></article>#empty<p className="small">Calculate comparisons to compare Good, Soft and Heavy assumptions.</p>#end</div></details><details className="fold sampling-fold"><summary>Sampling precision</summary><p className="help">{samplingText}</p></details><h3>Highest-probability ordered top three</h3><p className="help">Exact ordered-trifecta probabilities under this model. Every combination still has a low chance; there is no guaranteed best result.</p><div className="combo-list">#each (row in ensembleRows) key={row.rank}#if (row.rank === 1)<div className="combo-row"><span className="combo-rank">{row.rank}</span><span className="combo-name">{row.label}<small>{row.hits} observations · {row.frequency} of this batch</small></span><strong>{row.probability}</strong></div>#end#end</div><details className="fold ensemble-fold"><summary>Compare the next four combinations</summary><div className="combo-list">#each (row in ensembleRows) key={row.rank}#if (row.rank > 1)<div className="combo-row"><span className="combo-rank">{row.rank}</span><span className="combo-name">{row.label}<small>{row.hits} observations · {row.frequency} of this batch</small></span><strong>{row.probability}</strong></div>#end#end</div></details><details className="fold ensemble-fold"><summary>Most frequent finishes observed in this batch</summary><p className="help">Ranked by simulated counts. Ties use a stable ID order. Rare-combination rankings can change across batches and differ from exact model probabilities.</p>#each (row in observedRows) key={row.rank}<div className="combo-row"><span className="combo-rank">{row.rank}</span><span className="combo-name">{row.label}</span><strong>{row.hits} / {analysisTarget}<small>{row.frequency}</small></strong></div>#end</details><details className="fold ensemble-fold"><summary>Expected finishing positions</summary><p className="help">Exact model expectation, with the simulated average for comparison. This is a ranking summary, not the most probable complete finishing order.</p><div className="consensus-grid">#each (row in consensusRows) key={row.id}<div className="consensus-row"><span>{row.rank}. {row.name}</span><strong>{row.mean}<small className="small"> / {row.sampleMean} simulated</small></strong></div>#end</div></details><details className="fold ensemble-fold"><summary>Export this batch for AI review</summary><p className="help">Includes the complete horse inputs and evidence, trial counts, all-position counts, probabilities, leading combinations, seed recipe, sample result and replay code. Percentages are stored as fractions from 0 to 1.</p><div className="button-row"><button @click={saveResultsJSON}>Download results JSON</button><CopyButton value={exportJson} label="Copy results JSON" /></div><textarea aria-label="Results JSON" value={exportJson} readOnly={true}></textarea></details>
#else<p className="small">Choose a batch size and run the simulations. You can forecast the entire field without selecting a ticket.</p>#end
#end</div></section>

<section id="field-forecast" className="card"><div className="card-head"><div><div className="eyebrow">The whole field</div><h2>Field forecast</h2></div><span className="tag">Experimental</span></div><div className="body"><p className="help">All active runners, ranked by exact model win probability. Model win, top-three and expected finish are calculated directly; simulated rates show how the random batch compares. Expand a runner for evidence and counts.</p>
#if (hasResult && resultKey === going+"|"+pace+"|"+barrierMode+"|"+historyMode+"|"+trials+"|"+selectionText+"|"+stake+"|"+fieldText+"|"+modelPreset+"|"+ratingScale+"|"+tripScale+"|"+recencyScale+"|"+softScale+"|"+portfolioMode+"|"+portfolioText+"|"+hypotheticalDividend+"|"+researchClamp+"|"+acceptedSnapshotId)
<details className="fold full-field-fold"><summary>Show all {forecastRows.length} runner forecasts<span className="setting-summary">Exact probabilities, simulation counts and form evidence</span></summary><div className="forecast-wrap"><table className="forecast-table"><thead><tr><th scope="col">Runner</th><th scope="col">Model win / top 3</th><th scope="col">Sim win / top 3</th></tr></thead><tbody>#each (runner in forecastRows) key={runner.id}<tr><td><span className="forecast-name">{runner.number} · {runner.name}</span><details className="fold forecast-row-detail"><summary>Evidence and comparison</summary><p className="small">{runner.wins} wins in the batch · simulated average finish {runner.meanText} · exact expected finish {runner.expectedText}.</p><p className="small">{runner.historyText}</p><p className="small">Win with history off: {runner.baseWinText} · History difference: {runner.deltaText}</p><p className="small"><strong>Assumption comparison</strong><br />{runner.sensitivityText}</p><p className="help">This range compares four chosen assumptions. It is not a confidence interval or a measure of all real-race uncertainty.</p><p className="small">Top-three 95% Monte Carlo sampling interval: {runner.intervalText}</p></details></td><td className="forecast-value" data-label="Model win / top 3">{runner.winText}<br /><span className="small">{runner.exactTop3Text} top 3</span></td><td data-label="Sim win / top 3">{runner.sampleWinText}<br /><span className="small">{runner.top3Text} top 3</span></td></tr>#end</tbody></table></div></details>
#else<p className="small">Calculate a scenario to see the full field forecast.</p>#end
<p className="help">Top-three intervals describe simulation sampling error only. They do not capture model or real-world uncertainty; sparse history is uncertain.</p></div></section>
<section id="historical-checks" className="card"><div className="body"><details className="fold historical-fold"><summary>Historical checks</summary><p className="help">{historicalOverview}</p><p className="help">{historicalSensitivityText}</p><p className="help">These are descriptive checks on two past races, not an unseen holdout or a trained forecast. Comparing two settings for the same race does not create more independent races.</p><p className="help">Lower log loss and Brier scores are better for the observed outcomes. The equal-chance baseline treats all starters symmetrically. Top-three Brier scores compare each runner’s chance of placing with the actual first three; ordered trifecta log loss evaluates their exact finishing order.</p><div className="history-check-grid">#each (row in historicalRows) key={row.id}<article className="history-check"><h3>{row.label}</h3><p className="small">Winner: {row.winner} · {row.starters} starters</p><dl className="history-metrics"><div><dt>Winner model chance</dt><dd>{row.winnerChance}</dd></div><div><dt>Equal-chance baseline</dt><dd>{row.uniformChance}</dd></div><div><dt>Model log loss</dt><dd>{row.logLoss}</dd></div><div><dt>Baseline log loss</dt><dd>{row.uniformLogLoss}</dd></div><div><dt>Model Brier score</dt><dd>{row.brier}</dd></div><div><dt>Baseline Brier score</dt><dd>{row.uniformBrier}</dd></div><div className="history-wide"><dt>Actual ordered trifecta · model chance</dt><dd>{row.trifectaProbability}</dd></div></dl><p className="small history-score"><strong>Top-three Brier:</strong> {row.top3Brier} · equal {row.uniformTop3Brier}</p><p className="small history-score"><strong>Ordered trifecta log loss:</strong> {row.trifectaLogLoss} · equal {row.uniformTrifectaLogLoss}</p><p className="help">{row.notes}</p><p className="small history-sources"><a href={row.source} target="_blank" rel="noopener noreferrer">Pre-race source ↗</a><a href={row.resultSource} target="_blank" rel="noopener noreferrer">Race result ↗</a></p></article>#end</div><p className="help">Two races cannot establish calibration or a reliable edge. These checks are retained for transparency, without tuning the model to their outcomes.</p></details></div></section>
<section id="horse-profiles" className="card"><div className="card-head"><div><div className="eyebrow">The contenders</div><h2>Horses &amp; evidence</h2></div><span className="tag">{fieldLabel}</span></div><div className="body"><p className="help">Tap active runners to add or remove them from your boxed trifecta. The numerical field uses the 31 October snapshot, with separately dated race-day metadata. Imports and edits use your supplied inputs. Check later scratchings. <a href="https://www.vrc.com.au/latest-news/2026-lexus-melbourne-cup-racing-and-sports-analysis/" target="_blank" rel="noopener noreferrer">View VRC form analysis ↗</a>.</p><details className="fold evidence-coverage"><summary>How much history is available?</summary><p className="help">{historyCoverageText}</p><p className="help">Published class ratings are not calibrated Melbourne Cup probabilities. Race distance, opponents, recency and handicap weight can differ; sparse track records cannot settle those questions.</p></details><details className="fold full-field-fold runner-profiles-fold"><summary>Inspect runners and select your box<span className="setting-summary">{activeRunnerCount} active · {field.length} listed · scratches can be reversed</span></summary><div className="field-grid">#each (horse in field) key={horse.id}<article className="field-card"><button className={horse.active === false ? "horse inactive" : horse.selected ? "horse chosen" : "horse"} aria-pressed={horse.selected} disabled={horse.active === false} @click={toggleTicket(horse.number)}><span className="saddle">{horse.number}</span><span className="horse-copy"><span className="horse-name">{horse.name}</span><br /><span className="horse-sub">{horse.display}</span><br /><span className="horse-sub">{horse.ratingDisplay}</span></span><span className="tickmark">{horse.selected ? "✓" : "+"}</span></button><button className="quiet runner-toggle" aria-label={horse.active === false ? "Reinstate " + horse.name : "Scratch " + horse.name} @click={toggleRunner(horse.number)}>{horse.active === false ? "Reinstate runner" : "Scratch runner"}</button>#if (horse.contributionRows)<details className="fold runner-inspector"><summary>Model contributions</summary><dl className="contribution-list">#each (part in horse.contributionRows) key={part.id}#if (evidenceShowManual || (part.status !== "manual assumption" && part.id !== "manual"))<div><dt><strong>{part.label}</strong><span className="evidence-status">{part.status}</span></dt><dd>{part.value}#if (part.note)<small>{part.note}</small>#end</dd></div>#end#end</dl><p className="help">Exact probabilities are conditional on these inputs. Model contributions do not establish predictive calibration.</p></details>#end#if (horse.researchEvidence)<details className="fold runner-research"><summary>Research observations &amp; conflicts</summary><p className="small">{horse.researchEvidence.summary}</p>#if (evidenceShowObserved)<h4>Observed · source-attributed</h4><div className="research-facts">#each (fact in horse.researchEvidence.observedRows) key={fact.id}<div><p>{fact.text}</p><small>{fact.date}</small>#if (fact.sourceUrl)<a href={fact.sourceUrl} target="_blank" rel="noopener noreferrer">{fact.sourceLabel} ↗</a>#end</div>#empty<p className="small">No attributed observations are available for this runner.</p>#end</div>#end#if (evidenceShowAnalyst)<h4>Analyst interpretation · not fitted</h4>#each (item in horse.researchEvidence.interpretationRows) key={item.id}<p className="small"><strong>{item.label}</strong><br />{item.text}</p>#end#end<h4>How this evidence is used</h4><p className="small"><strong>Baseline:</strong> {horse.researchEvidence.baselineUseText}<br /><strong>Research what-if:</strong> {horse.researchEvidence.researchUseText}</p>#if (horse.researchEvidence.conflicts.length > 0)<h4>Conflicts and cautions</h4>#each (conflict in horse.researchEvidence.conflicts) key={conflict.id}<p className="research-conflict">{conflict.text}</p>#end#end<p className="small"><strong>Missing or unconfirmed:</strong> {horse.researchEvidence.missingText}</p></details>#end<details className="fold"><summary>Form evidence</summary><p className="small"><strong>{horse.evidenceLabel}</strong><br />{horse.recentStartText}</p><p className="small">Selected earlier evidence: {horse.form}</p>#if (horse.detailsText)<p className="small">{horse.detailsText}</p>#end<p className="small"><strong>Track and going history</strong><br />{horse.historySummary}</p>#if (horse.sourceVerified)<p className="small"><a href="https://www.neds.com.au/blog/betting-info/melbourne-cup/" target="_blank" rel="noopener noreferrer">Form record ↗</a> · <a href="https://www.tabtouch.com.au/racing/2026-11-03/mr/7" target="_blank" rel="noopener noreferrer">Cross-check ↗</a></p>#else<p className="small">Evidence is user supplied. Source references, when provided, are retained in the horse JSON.</p>#end</details></article>#end</div></details></div></section>#end</div>#if (interfaceMode === "advanced")<aside className="stack tools-stack" aria-label="Data and model tools"><section className="card"><div className="body"><details className="fold"><summary>Form and model assumptions</summary><p className="help">Racing and Sports ratings retained in the pre-race snapshot were rechecked against the currently linked VRC analysis dated 2 November. All 24 rating values match; the ratings summarise prior performances. The default strength is calculated as 100 × exp((rating − 115) / 8). The divisor is a heuristic, not a fitted or historically validated calibration. The optional cautious history adjustment uses available track and going records; samples can be small or unavailable. Turn it off to compare the scenario without the history adjustment. Manually supplied stamina, wet preference and running style are additional assumptions. The optional modest barrier effect is a small assumed disadvantage for wider effective gates, not a measured physical distance, calibrated estimate or prediction of race position. It multiplies relative strength by exp(−0.08 × (effective gate − 1) / (active count − 1)), about 7.7% lower relative weight at the outermost gate than the innermost, rather than a 7.7-point change in winning probability. Gates compact after scratchings. Switch it off to compare. The more varied finish margins and pace curves are illustrative choreography, not measured sectionals. Carried weight is displayed but is not applied separately to the rating. Check the <a href="https://www.vrc.com.au/latest-news/2026-lexus-melbourne-cup-racing-and-sports-analysis/" target="_blank" rel="noopener noreferrer">source analysis ↗</a>.</p></details></div></section>
<section className="card"><div className="body"><details className="fold"><summary>Edit the field</summary><p className="help">One runner per line: saddlecloth, name, drawn barrier, strength, active (1 or 0), weight, stamina, wet preference, style. Strength must be positive; stamina and wet preference range from -1 to 1; style is front, mid or close. Set active to 0 to scratch. Adding real names does not validate the model.</p><label htmlFor="field">Runner data</label><textarea id="field" :bind={fieldText} @change={invalidateDiagnostics}></textarea><div className="button-row"><button @click={applyField}>Apply field</button><button @click={restoreDemo}>Reset 2026 field</button></div></details></div></section><section className="card"><div className="body"><details className="fold"><summary>Reproduce a race</summary><p className="help">Paste a complete RaceLab replay code to restore its field, scenario and result.</p><label htmlFor="replay-input">Replay code</label><textarea id="replay-input" :bind={replayInput} placeholder="Paste replay code here"></textarea><div className="button-row"><button @click={reproduceRace}>Reproduce race</button></div></details></div></section><section id="horse-data" className="card"><div className="card-head"><div><div className="eyebrow">Your data</div><h2>Horse JSON</h2></div></div><div className="body"><p className="help">Import 3–40 horses as a JSON array or a racelab-horses-v1 envelope. Maximum 100 KB. Import stages a field comparison for your approval and marks evidence as user supplied.</p>#if (pendingFieldChanges)<div className="field-review" role="region" aria-label="Review imported field changes"><h3>Review proposed changes</h3><p className="small">{fieldDiffSummary}</p><p className="help">The active scenario stays unchanged until you approve. Uploaded source claims remain unverified.</p><div className="field-diff-list">#each (change in fieldDiffRows) key={change.id}<div><strong>{change.label}</strong><dl><dt>Current</dt><dd>{change.before}</dd><dt>Proposed</dt><dd>{change.after}</dd></dl></div>#end</div><div className="button-row"><button className="primary" @click={approveFieldChanges}>Approve field changes</button><button @click={cancelFieldChanges}>Cancel changes</button></div></div>#end<p id="horse-json-status" className="small import-feedback" role="status">{importMessage}</p>#if (importError)<p id="horse-json-error" className="error import-feedback" role="alert">{importError}</p>#end<button aria-describedby={importError ? "horse-json-error" : "horse-json-status"} @click={pickHorseJSON}>Review JSON file</button><details className="fold ensemble-fold"><summary>Paste JSON or inspect the format</summary><p className="help">Required per horse: number, name, barrier, and strength or rating. Optional: weight, active, stamina, wet, style, colour, form, lastStart, history, trainer, jockey, age and source. Export the current horses for a complete example. Names cannot contain commas or line breaks.</p><textarea aria-label="Horse JSON input" aria-describedby={importError ? "horse-json-error" : "horse-json-status"} :bind={importText} placeholder="Paste horse JSON here"></textarea><button @click={applyHorseJSON}>Validate &amp; review JSON</button></details><div className="button-row"><button @click={prepareHorseJSON}>Show current horse JSON</button><button @click={saveHorseJSON}>Download horse JSON</button></div>#if (horseJson)<details className="fold ensemble-fold"><summary>Prepared horse JSON snapshot</summary><CopyButton value={horseJson} label="Copy horse JSON" /><textarea aria-label="Horse JSON export" value={horseJson} readOnly={true}></textarea></details>#end<p className="help">File access may require your host's permission. Paste and copy remain available.</p></div></section>
</aside>#end</div>#if (interfaceMode === "advanced")<section className="card" style={{marginTop:"18px"}}><div className="card-head"><div><div className="eyebrow">Past runnings</div><h2>Historical reference</h2></div><span className="tag">Flemington · 3200 m</span></div><div className="body"><p className="help">These cards provide replay-duration references. See Historical checks for the separate two-Cup retrospective comparison; no parameters were fitted to these winners.</p><details className="fold evidence-coverage"><summary>How much history is available?</summary><p className="help">{historyCoverageText}</p><p className="help">Published class ratings are not calibrated Melbourne Cup probabilities. Race distance, opponents, recency and handicap weight can differ; sparse track records cannot settle those questions.</p></details><div className="field-grid">#each (race in historyNotes) key={race.year}<div className="finish-row"><div><span className="eyebrow">{race.year} · {race.time}</span><div className="finish-name">{race.winner}</div><div className="small">2nd / 3rd · {race.places}</div></div></div>#end</div><p className="help"><a href="https://www.racingaustralia.horse/arb/melbourne-cup.aspx" target="_blank" rel="noopener noreferrer">Racing Australia records ↗</a> · <a href="https://www.vrc.com.au/racing/melbourne-cup-winners-honour-roll/" target="_blank" rel="noopener noreferrer">VRC winners honour roll ↗</a></p></div></section>
#end<p className="foot">No live data or wagering. The track, motion and results are illustrative.</p></main>#end</div></App>
