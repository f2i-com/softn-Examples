/* Canonical, content-addressed field snapshots and review diffs. */
var RaceSnapshots=(function(){
  function canonical(x){
    if(x===null)return 'null';
    if(typeof x==='string'||typeof x==='boolean')return JSON.stringify(x);
    if(typeof x==='number'){if(!isFinite(x))throw new Error('Snapshot numbers must be finite.');return JSON.stringify(x);}
    if(Array.isArray(x)){var entries=[];for(var i=0;i<x.length;i++)entries.push(canonical(x[i]));return '['+entries.join(',')+']';}
