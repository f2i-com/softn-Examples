function setInterfaceMode(mode) {
  interfaceMode = mode === "advanced" ? "advanced" : "simple";
  cameraPointerEnd();
  refreshAdvancedSettings();
}
function refreshAdvancedSettings() {
  advancedSettingsActive = trials !== "5000" || pace !== "moderate" || barrierMode !== "modest" || historyMode !== "cautious" || fieldOrigin !== "official" || activeRunnerCount !== 23 || playbackSpeed !== "4" || cameraMode !== "broadcast" || graphicsDetail !== "balanced" || modelPreset !== "baseline" || ratingScale !== "8" || portfolioMode;
  advancedSettingsSummary = Number(trials).toLocaleString() + " races · " + pace + " pace · " + historyMode + " history · " + barrierMode + " barrier · " + activeRunnerCount + " runners · " + playbackSpeed + "× playback · " + cameraMode + " view · " + graphicsDetail + " detail · " + modelPreset + " / divisor " + ratingScale + (portfolioMode?" · portfolio":"");
}
function raceKey() { return going+"|"+pace+"|"+barrierMode+"|"+historyMode+"|"+fieldText+"|"+modelPreset+"|"+ratingScale+"|"+tripScale+"|"+recencyScale+"|"+softScale+"|"+researchClamp+"|"+acceptedSnapshotId; }
function dataKey() { return going+"|"+pace+"|"+barrierMode+"|"+historyMode+"|"+trials+"|"+selectionText+"|"+stake+"|"+fieldText+"|"+modelPreset+"|"+ratingScale+"|"+tripScale+"|"+recencyScale+"|"+softScale+"|"+portfolioMode+"|"+portfolioText+"|"+hypotheticalDividend+"|"+researchClamp+"|"+acceptedSnapshotId; }
function numberText(n) { return (Math.round(n * 100) / 100).toFixed(2); }
function refreshSelection() {
  invalidateDiagnostics();
  let parts = String(selectionText).split(",");
  let chosen = [];
  for (let i = 0; i < parts.length; i = i + 1) chosen.push(Number(parts[i].trim()));
  field = field.map(function(h) { h.selected = chosen.indexOf(h.number) !== -1; return h; });
  let active = 0; let unknown = 0; let sparse = 0; let noSoft = 0; let noHeavy = 0;
  for (let i = 0; i < field.length; i = i + 1) if (field[i].active !== false) {
    let hist = field[i].history; active = active + 1;
    let trackStarts = hist && hist.track ? Number(hist.track.starts) : 0;
    if (!trackStarts) unknown = unknown + 1;
    if (trackStarts <= 2) sparse = sparse + 1;
    if (!hist || !hist.going || !hist.going.soft || !hist.going.soft.starts) noSoft = noSoft + 1;
    if (!hist || !hist.going || !hist.going.heavy || !hist.going.heavy.starts) noHeavy = noHeavy + 1;
  }
  activeRunnerCount = active;
  refreshAdvancedSettings();
  historyCoverageText = active + " active runners: " + unknown + " with no recorded Flemington starts; " + sparse + " with at most two. " + noSoft + " have no recorded soft-going starts and " + noHeavy + " have no heavy-going starts. Missing experience is unknown, not poor ability.";
}
function formatClock(seconds) {
  let rounded = Math.round(seconds * 10) / 10;
  let minutes = Math.floor(rounded / 60);
  let rest = (rounded - minutes * 60).toFixed(1);
  return minutes + ":" + (Number(rest) < 10 ? "0" : "") + rest;
}
function scene() {
  let activeRunners = field.filter(function(h) { return h.active !== false; });
  sceneSupported = activeRunners.length <= 24;
  renderScene = showScene && sceneSupported;
  if (!renderScene) cameraPointerEnd();
  sceneFallbackText = activeRunners.length > 24 ? "Fields above 24 use text playback; aggregate forecasts still include every active runner." : "Live running order appears below.";
  raceState = RaceTrack.raceState(activeRunners, finishOrder, elapsed, raceDuration, replaySeed || "preview",renderScene,graphicsDetail);
  miniMap=RaceTrack.miniMap(raceState,focusHorseId); seekValue=String(elapsed); replayEndSeconds=raceState.totalSeconds;
  objects = raceState.objects;
  raceState.objects = []; // Avoid transferring the same mesh descriptors twice through UI state.
  updateCamera();
  leaderboardLabel=raceState.allFinished?"Final order":raceState.winnerFinished?"Finish order / runners approaching":"Running order";
  leaderboardNote=raceState.winnerFinished?"Finished runners pinned in result order · animation positions are illustrative":"Illustrative positions · leading runners";
  let leaders = raceState.runners.slice().sort(function(a,b) {
    if(raceState.winnerFinished){if(a.finished&&b.finished)return a.rank-b.rank;if(a.finished)return -1;if(b.finished)return 1;}
    if (elapsed > 0) return b.distance - a.distance || a.rank - b.rank;
    let gateA = 0; let gateB = 0;
    for (let k = 0; k < field.length; k = k + 1) {
      if (field[k].id === a.id) gateA = field[k].barrier;
      if (field[k].id === b.id) gateB = field[k].barrier;
    }
    return gateA - gateB;
  });
  leaderboard = [];
  for (let i = 0; i < Math.min(6, leaders.length); i = i + 1) {
    let state = leaders[i];
    for (let j = 0; j < field.length; j = j + 1) {
      let h = field[j];
      if (h.id === state.id) leaderboard.push({id:h.id,position:i+1,number:h.number,name:h.name,colour:h.colour,selected:h.selected,gap:state.finished?(state.rank===1?"Finished 1st":"Finished #"+state.rank):i===0?"Leader":Math.max(0,leaders[0].distance-state.distance).toFixed(0)+" m"});
    }
  }
  progressPercent = Math.min(100, Math.max(0, raceState.leaderDistance / 3200 * 100));
  progress = progressPercent / 100;
  clockText = formatClock(elapsed);
  let remaining = Math.max(0, 3200 - raceState.leaderDistance);
  progressText = Math.ceil(remaining / 10) * 10 + " m to finish";
  if (raceComplete) { racePhase = "Race result"; progressText = "All runners finished"; }
  else if (!hasResult || elapsed === 0) racePhase = "At the gates";
  else if (raceState.allFinished) racePhase = "Pulling up";
  else if (raceState.winnerFinished) racePhase = "Across the line";
  else if (remaining < 450) racePhase = "The final straight";
  else if (remaining < 1000) racePhase = "Building for home";
  else if (raceState.leaderDistance < 900) racePhase = "The first passage";
  else racePhase = "Settling into the circuit";
}
function updateCamera() {
  let baseCamera = RaceTrack.cameraFor(cameraMode, raceState,focusHorseId);
  let dx=baseCamera.position.x-baseCamera.lookAt.x;
  let dy=baseCamera.position.y-baseCamera.lookAt.y;
  let dz=baseCamera.position.z-baseCamera.lookAt.z;
  let baseDistance=Math.sqrt(dx*dx+dy*dy+dz*dz);
  cameraView.zoom=Math.max(0.35,Math.max(0.65/baseDistance,Math.min(4,Math.min(250/baseDistance,cameraView.zoom))));
  camera = RaceCamera.pose(baseCamera, cameraView);
  cameraZoomText = (1 / cameraView.zoom).toFixed(2) + "×";
}
function setCamera(mode) {
  if (mode !== "broadcast" && mode !== "follow" && mode !== "overview") return;
  cameraMode = mode; resetCameraView();
}
function resetCameraView() { cameraView = RaceCamera.defaults(); cameraPointerEnd(); updateCamera(); }
function cameraZoom(factor) { cameraView = RaceCamera.change(cameraView,"zoom",factor,0); updateCamera(); }
function cameraRotate(degrees) { cameraView = RaceCamera.change(cameraView,"rotate",degrees,0); updateCamera(); }
function cameraTilt(degrees) { cameraView = RaceCamera.change(cameraView,"tilt",degrees,0); updateCamera(); }
function cameraPan(x,y) { cameraView = RaceCamera.change(cameraView,"pan",x*0.08,y*0.08); updateCamera(); }
function setCameraDragMode(mode) {
  cameraDragMode = mode === "pan" ? "pan" : mode === "zoom" ? "zoom" : "orbit";
  cameraPointerEnd();
  cameraHint = cameraDragMode === "pan" ? "Drag to pan. Reset view restores the framing." : cameraDragMode === "zoom" ? "Drag up to zoom in, down to zoom out. +/− buttons also work." : "Drag to rotate · choose Pan or Zoom to move closer or reframe.";
}
function cameraPointerDown(e) {
  if (!e || e.button !== 0 || !isFinite(e.clientX) || !isFinite(e.clientY)) return;
  cameraGesture = {active:true,x:e.clientX,y:e.clientY,mode:interfaceMode === "simple" ? "orbit" : e.shiftKey ? "pan" : cameraDragMode};
}
function cameraPointerMove(e) {
  if (!e || !cameraGesture.active) return;
  if (e.buttons === 0) { cameraPointerEnd(); return; }
  cameraDrag(e.clientX,e.clientY);
}
function cameraPointerEnd() { cameraGesture = {active:false,x:0,y:0,mode:cameraDragMode}; }
function cameraDrag(x,y) {
  if (!cameraGesture.active || !isFinite(x) || !isFinite(y)) return;
  let dx = Math.max(-120,Math.min(120,x-cameraGesture.x));
  let dy = Math.max(-120,Math.min(120,y-cameraGesture.y));
  cameraGesture.x=x; cameraGesture.y=y;
  if (cameraGesture.mode === "pan") cameraView = RaceCamera.change(cameraView,"pan",-dx*0.0015,dy*0.0015);
  else if (cameraGesture.mode === "zoom") cameraView = RaceCamera.change(cameraView,"zoom",Math.exp(dy*0.008),0);
  else {
    cameraView = RaceCamera.change(cameraView,"rotate",-dx*0.35,0);
    cameraView = RaceCamera.change(cameraView,"tilt",dy*0.25,0);
  }
  updateCamera();
}
function cameraTouchStart(e) {
  if (!e || e.touches !== 1 || !isFinite(e.clientX) || !isFinite(e.clientY)) { cameraPointerEnd(); return; }
  cameraGesture = {active:true,x:e.clientX,y:e.clientY,mode:interfaceMode === "simple" ? "orbit" : cameraDragMode};
}
function cameraTouchMove(e) {
  if (!e || e.touches !== 1) { cameraPointerEnd(); return; }
  cameraDrag(e.clientX,e.clientY);
}
function cameraKey(e) {
  if (!e || e.altKey || e.ctrlKey || e.metaKey) return;
  if (e.key === "+" || e.key === "=") cameraZoom(0.8);
  else if (e.key === "-" || e.key === "_") cameraZoom(1.25);
  else if (e.key === "0" || e.key === "Home") resetCameraView();
  else if (e.key === "ArrowLeft") { if (e.shiftKey) cameraPan(-1,0); else cameraRotate(-10); }
  else if (e.key === "ArrowRight") { if (e.shiftKey) cameraPan(1,0); else cameraRotate(10); }
  else if (e.key === "ArrowUp") { if (e.shiftKey) cameraPan(0,1); else cameraTilt(5); }
  else if (e.key === "ArrowDown") { if (e.shiftKey) cameraPan(0,-1); else cameraTilt(-5); }
  else return;
  return false;
}
function setSpeed(value) { playbackSpeed = String(value); }
function freshRaceCode() {
  raceCounter = raceCounter + 1;
  // Unique per call, including calls in one millisecond. This is simulation
  // entropy, not a security token. Saved replay codes retain this internal key.
  return "race-" + Date.now().toString(36) + "-" + raceCounter + "-" + Math.floor(Math.random()*4294967296).toString(36);
}
function newRace() {
  simulate();
  if (analysisRunning) pendingAction = "play";
}
function toggleScene() { cameraPointerEnd(); showScene = !showScene; scene(); }
function refreshGraphics() {
  if (graphicsDetail !== "balanced" && graphicsDetail !== "detailed") graphicsDetail = "balanced";
  scene();
  if (hasResult && resultKey === dataKey()) buildResultsExport();
}
function clearReplay() {
  cameraPointerEnd();
  running = false; elapsed = 0; progress = 0; raceComplete = false;
  finishRows = []; finishOrder = []; resultIds = []; boxWon = false;
  finishText = "Run a simulation, then watch the race or skip to its result.";
}
function toggleTicket(number) {
  let parts = String(selectionText).split(",");
  let numbers = [];
  for (let i = 0; i < parts.length; i = i + 1) {
    let n = Number(parts[i].trim());
    if (n > 0 && numbers.indexOf(n) === -1) numbers.push(n);
  }
  let idx = numbers.indexOf(Number(number));
  if (idx === -1) numbers.push(Number(number)); else numbers.splice(idx,1);
  selectionText = numbers.join(","); refreshSelection();
  if (hasResult && resultKey !== dataKey()) { running = false; message = "Ticket changed. Play or Skip updates coverage while preserving this sampled race."; }
}
function fieldRowsText() {
  let lines = [];
  for (let i = 0; i < field.length; i = i + 1) {
    let h = field[i];
    lines.push(h.number + "," + h.name + "," + h.barrier + "," + h.strength + "," + (h.active === false ? "0" : "1") + "," + h.weight + "," + h.stamina + "," + h.wet + "," + h.style);
  }
  return lines.join("\n");
}
function serialise() { fieldText = fieldRowsText(); }
function decorate(list) {
  let gates = RaceSim.effectiveGates(list);
  for (let i = 0; i < list.length; i = i + 1) {
    let h = list[i];
    h.color = h.colour || "#e9c77e";
    h.effectiveGate = null;
    for (let j = 0; j < gates.length; j = j + 1) if (gates[j].id === h.id) h.effectiveGate = gates[j].gate;
    h.display = "Drawn " + h.barrier + (h.effectiveGate ? " / gate " + h.effectiveGate : "") + " · " + h.weight + " kg · strength " + h.strength + (h.active === false ? " · SCRATCHED" : "");
    h.ratingDisplay = h.rating ? (String(h.provenance || "").indexOf("User-imported") === 0 ? "Imported rating " : "Published R&S rating ") + h.rating : "User model inputs";
    h.recentStartText = h.lastStart ? h.lastStart.position + "/" + h.lastStart.starters + " · " + h.lastStart.race + " · " + h.lastStart.distance + " m · " + h.lastStart.date : "No verified recent-start record for this runner.";
    h.historySummary = historySummary(h);
    h.evidenceLabel = String(h.provenance || "").indexOf("User-imported") === 0 ? "Imported evidence · not independently checked" : h.lastStart ? "Most recent start · checked 1 Nov" : "Runner evidence";
    h.sourceVerified = Boolean(h.lastStart) && String(h.provenance || "").indexOf("User-imported") !== 0;
    h.detailsText = (h.trainer ? "Trainer: " + h.trainer + ". " : "") + (h.jockey ? "Jockey: " + h.jockey + ". " : "") + (h.age ? "Age: " + h.age + ". " : "") + (h.country ? "Country: " + h.country + "." : "");
  }
  return list;
}
function recordText(record) {
  if (!record) return "record unavailable";
  if (record.starts === 0) return "0 starts";
  return record.starts + " starts · " + record.wins + " wins · " + record.seconds + " seconds · " + record.thirds + " thirds";
}
function historySummary(h) {
  if (!h.history) return "No matched historical record. History adjustment is neutral.";
  let hist = h.history;
  let surface=observedSurfaceBreakdown(h); let surfaceText=surface.status==="reconciled"?"Observed turf: "+recordText(surface.turf)+"; synthetic: "+recordText(surface.synthetic)+". ":"Surface breakdown unavailable. ";
  return "Career: " + recordText(hist.career) + ". "+surfaceText+"Flemington: " + recordText(hist.track) + ". Good: " + recordText(hist.going.good) + ". Soft: " + recordText(hist.going.soft) + ". Heavy: " + recordText(hist.going.heavy) + ". Distance bucket (provider definition unverified): " + recordText(hist.distance) + ". Surface totals are observations, not separate model adjustments; imported records may include jumps. Small samples are heavily shrunk; zero starts leave suitability unknown.";
}
function updateForecast(result, scenario) {
  let baseline = RaceSim.winForecast(RaceSession.model().field,{going:going,pace:pace,barrierImpact:scenario.barrierImpact,historyMode:"off"});
  let rows = result.runnerForecasts.slice().sort(function(a,b) { return b.winProbability-a.winProbability; });
  forecastRows = [];
  for (let i = 0; i < rows.length; i = i + 1) {
    let row = rows[i]; let base = 0;
    for (let k = 0; k < baseline.length; k = k + 1) if (baseline[k].id === row.id) base = baseline[k].winProbability;
    for (let j = 0; j < field.length; j = j + 1) if (field[j].id === row.id) {
