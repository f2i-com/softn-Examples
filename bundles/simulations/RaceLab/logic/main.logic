      for(var s=0;s<SCORE_DEFS.length;s++){var def=SCORE_DEFS[s];row[def.mean]=aggregate.metrics[def.mean];row[def.delta]=aggregate.metrics[def.delta];}
      for(var r=0;r<reports.length;r++){var delta={raceId:reports[r].id};for(var d=0;d<SCORE_DEFS.length;d++)delta[SCORE_DEFS[d].delta]=reports[r].variants[v].metrics[SCORE_DEFS[d].delta];row.perRaceDeltas.push(delta);}
      rows.push(row);uniform=aggregate.uniform;counts=aggregate.metricRaceCounts;
    }
    return {schema:'racelab-historical-summary-v1',auditVersion:VERSION,model:RaceSim.model,races:reports,raceCount:reports.length,metricRaceCounts:counts,uniform:uniform,variants:rows,interpretation:'Equal weight per scored race. Top-three metrics exclude races without complete ordered first-three results; counts are reported separately. Lower mean proper scores are better on this supplied sample only; no significance, calibration or future forecasting claim is implied.'};
