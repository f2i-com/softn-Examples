      return {position:{x:target.x-q.dx*0.42-q.dz*0.80,y:0.43,z:target.z-q.dz*0.42+q.dx*0.80},lookAt:{x:target.x,y:0.08,z:target.z},fov:48};
    }
    return overview;
  }
  // A small, fixed projection of the same illustrative course. It uses one
  // scale for both axes; render in a 100 by 30 viewBox to avoid stretching it.
  // The outline is prepared once, rather than rebuilding course meshes for UI.
  var mapScale=100/(END+R-START+4);
  function mapPoint(point){return {x:(point.x-START+2)*mapScale,y:15+point.z*mapScale};}
  function mapCoordinate(value){return String(Math.round(value*1000)/1000);}
  var mapStart=mapPoint(pointAt(0)),mapFinish=mapPoint(pointAt(3200));
  var mapPath='M '+mapCoordinate(mapStart.x)+' '+mapCoordinate(mapStart.y);
