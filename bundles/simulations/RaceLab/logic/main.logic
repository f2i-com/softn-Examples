    var mapPosition=mapPoint(pointOnLoop(CIRC*mapIndex/64));
    mapPath+=' L '+mapCoordinate(mapPosition.x)+' '+mapCoordinate(mapPosition.y);
  }
  function miniMap(state,focusId){
    var field=state&&Array.isArray(state.runners)?state.runners:[],markers=[],leader=null;
    for(var i=0;i<field.length;i++)if(!leader||field[i].distance>leader.distance)leader=field[i];
    for(var j=0;j<field.length;j++){
      var runner=field[j],position=runner.position;
