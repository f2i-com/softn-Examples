    if(d<=888)return {x:START+d*unitsPerMetre,z:R,dx:1,dz:0};
    return pointOnLoop((d-888)*unitsPerMetre);
  }
  function segment(id, a, b, width, height, color, y){
    var dx=b.x-a.x,dz=b.z-a.z, len=Math.sqrt(dx*dx+dz*dz);
    return {id:id,type:'box',position:{x:(a.x+b.x)/2,y:y,z:(a.z+b.z)/2},rotation:{x:0,y:-Math.atan2(dz,dx),z:0},width:len+0.12,height:height,depth:width,color:color,roughness:0.95,receiveShadow:true};
  }
  function obj(id,type,x,y,z,w,h,d,color){return {id:id,type:type,position:{x:x,y:y,z:z},width:w,height:h,depth:d,color:color,roughness:0.9,receiveShadow:true};}
  function staticObjects(){
    var out=[obj('ground','box',-6,-0.08,0,110,0.14,70,'#234d3c')];
    // Wide strips join to produce a continuous low-poly turf circuit.
    // Scale: one scene unit is approximately 18.65 metres. This gives
    // the straight a nominal 30 m turf width, subject to stylisation.
    var N=64, w=1.62;
    var points=[];
    for(var i=0;i<=N;i++) points.push(pointOnLoop(CIRC*i/N));
    for(var j=0;j<N;j++){
      var a=points[j],b=points[j+1];
      out.push(segment('turf-'+j,a,b,w,0.02,j%2?'#438a5a':'#4a9462',0.004));
      var dx=b.x-a.x,dz=b.z-a.z,len=Math.sqrt(dx*dx+dz*dz),nx=-dz/len,nz=dx/len;
      for(var side=-1;side<=1;side+=2){
        var off=side*w/2;
        out.push(segment('rail-'+j+'-'+side,{x:a.x+nx*off,z:a.z+nz*off},{x:b.x+nx*off,z:b.z+nz*off},0.008,0.055,'#f7f4e8',0.045));
      }
    }
    var chuteA={x:START,z:R},chuteB={x:-END,z:R};
    out.push(segment('chute',chuteA,chuteB,w,0.02,'#4a9462',0.004));
    for(var t=-1;t<=1;t+=2)out.push(segment('chute-rail-'+t,{x:START,z:R+t*w/2},{x:-END,z:R+t*w/2},0.008,0.055,'#f7f4e8',0.045));
