      var random=seeded(seed+'|'+id+'|journey');
      var style=h.style==='front'?0.009:h.style==='close'?-0.009:0;
      var early=style+(random()-0.5)*0.014;
      var middle=(random()-0.5)*0.013;
      var late=(random()-0.5)*0.005;
      var metres=(travelled+early*Math.sin(Math.PI*travelled)+middle*Math.sin(2*Math.PI*travelled)+late*Math.sin(3*Math.PI*travelled))*3200;
      var finishSpeed=3200*(1-Math.exp(-1/tau))/(finishTime*normalizer)*(1-Math.PI*early+2*Math.PI*middle-3*Math.PI*late);
      var runout=clamp(elapsed-finishTime,0,runoutSeconds);
      if(elapsed>=finishTime)metres=3200+finishSpeed*(runout/2+runoutSeconds/(2*Math.PI)*Math.sin(Math.PI*runout/runoutSeconds));
      var q=pointAt(metres);
      // Distinct adjacent barrier stalls for up to 24 runners, with wider
      // fields assigned extra rows. Gradually settle toward racing lanes.
      var gateCount=Math.min(count,24),row=Math.floor(f.gateIndex/24),gate=f.gateIndex%24;
      var gateLane=-0.73+(gate+0.5)*(1.46/24);
      // Keep full-sized field runners in distinct, close lanes. A small
      // bounded drift gives life without merging horses into one another.
      var motionTime=Math.min(elapsed,finishTime+runoutSeconds);
      var raceLane=(gate/23-0.5)*1.30+0.002*Math.sin(motionTime*0.35+f.index);
      var blend=clamp(elapsed/18,0,1);blend=blend*blend*(3-2*blend);
      var lane=gateLane+(raceLane-gateLane)*blend;
      var rowOffset=(1-blend)*row*0.20;
      var moving=elapsed>0.01 && runout<runoutSeconds;
      // Advance the stride with distance, rather than wall-clock time, so
      // acceleration and deceleration are reflected in the gallop as well.
      var phase=metres*9/(3200/200)+f.index*0.68;
      var motionScale=elapsed<finishTime?1-Math.exp(-elapsed/2):(1+Math.cos(Math.PI*runout/runoutSeconds))/2;
      // Turf top is y=0.014; the standing hoof bottom is 0.0035 above
      // the group origin. Match them instead of floating above the grass.
      var pos={x:q.x-q.dz*lane-q.dx*rowOffset,y:0.0105+(moving?Math.sin(phase*2)*0.0015*motionScale:0),z:q.z+q.dx*lane-q.dz*rowOffset};
      if(buildObjects!==false) objects.push(horse('horse-'+id,pos,-Math.atan2(q.dz,q.dx),h.colour||h.color||COLOURS[f.index%COLOURS.length],phase,moving,COATS[f.index%COATS.length],motionScale,visualQuality));
      if(metres>leader)leader=metres;
      results.push({id:id,rank:f.rank+1,distance:metres,metres:metres,position:pos,finished:elapsed>=finishTime,finishTime:finishTime,gap:finishTime-duration});
    }
    var allFinished=elapsed>=finishDuration;
    return {objects:objects,runners:results,leaderDistance:leader,winnerFinished:elapsed>=duration,allFinished:allFinished,
      complete:elapsed>=total,elapsedSeconds:elapsed,raceSeconds:Math.min(elapsed,duration),finishDuration:finishDuration,totalSeconds:total};
  }
  // Backwards-compatible full-playback wrapper (0–1 includes the run-out).
  function horses(runners,order,progress,replaySeed){
    var total=raceState(runners,order,0,200,replaySeed,false).totalSeconds;
    return raceState(runners,order,clamp(Number(progress)||0,0,1)*total,200,replaySeed).objects;
  }
  var overview={position:{x:-22,y:50,z:57},lookAt:{x:-7,y:0,z:0},fov:48};
  function cameraFor(mode,state,focusId){
    if(mode==='broadcast'){
      // Frame the entire moving pack, including at the start and run-out.
      // The radius and 0.6 assumed aspect fit portrait as well as landscape;
      // the host may later supply a tighter aspect-aware camera if desired.
      var rs=state && Array.isArray(state.runners)?state.runners:[];
      var centre=pointAt(0),minX=Infinity,maxX=-Infinity,minZ=Infinity,maxZ=-Infinity;
      for(var k=0;k<rs.length;k++){
        var p=rs[k].position;if(!p || !isFinite(p.x) || !isFinite(p.z))continue;
        minX=Math.min(minX,p.x);maxX=Math.max(maxX,p.x);minZ=Math.min(minZ,p.z);maxZ=Math.max(maxZ,p.z);
      }
      var radius=0.2;
      if(isFinite(minX)){
        centre={x:(minX+maxX)/2,z:(minZ+maxZ)/2};
        radius=Math.sqrt((maxX-minX)*(maxX-minX)+(maxZ-minZ)*(maxZ-minZ))/2+0.20;
      }
      var halfHorizontal=Math.atan(Math.tan(48*Math.PI/360)*0.6);
      var dist=Math.max(2.2,radius/Math.sin(halfHorizontal)*1.12);
      return {position:{x:centre.x,y:dist*0.65+0.08,z:centre.z+dist*0.76},lookAt:{x:centre.x,y:0.08,z:centre.z},fov:48};
