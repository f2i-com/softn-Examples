  function text(value,label,max,required){if(value==null&&!required)return null;if(typeof value!=='string'||value.length>max||/[\u0000-\u0008\u000b\u000c\u000e-\u001f<>]/.test(value)||(required&&!value.trim()))fail(label+' must be plain text of at most '+max+' characters.');return value.trim();}
  function integer(value,label,lo,hi){if(typeof value!=='number'||!Number.isInteger(value)||value<lo||value>hi)fail(label+' must be an integer from '+lo+' to '+hi+'.');return value;}
  function timestamp(value,label){
