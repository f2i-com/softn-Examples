      var angle=Math.sin(stride)*(hind?0.52:0.60)*amount;
      var flex=-Math.max(0,Math.cos(stride))*(hind?0.72:0.92)*amount;
      var jointX=x+0.30*Math.sin(angle),jointY=0.75-0.30*Math.cos(angle),lowerAngle=angle+flex;
      var lowerSin=Math.sin(lowerAngle),lowerCos=Math.cos(lowerAngle);
      var hoofX=jointX+0.015*lowerCos+0.36*lowerSin,hoofY=jointY+0.015*lowerSin-0.36*lowerCos;
      var edgeX=rollX*lowerCos+rollY*lowerSin,edgeY=-rollX*lowerSin+rollY*lowerCos;
