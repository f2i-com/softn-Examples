      var event=r.raceDate+'|'+JSON.stringify(names);if(events.indexOf(event)!==-1)fail('The same dated historical field must not be counted as multiple races.');
      seen.push(r.id);events.push(event);reports.push(r);}
    var rows=[],uniform=null,counts=null;
    for(var v=0;v<2;v++) {
