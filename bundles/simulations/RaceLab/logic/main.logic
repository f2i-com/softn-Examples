var RaceReview = (function() {
  var historical = null; var sensitivity = null;
  return {setHistorical:function(v){historical=v;},getHistorical:function(){return historical;},setSensitivity:function(v){sensitivity=v;},getSensitivity:function(){return sensitivity;}};
})();
// Loop controls are mirrored through React/worker state. Only this private
// lifecycle decides whether work remains, so delayed UI snapshots cannot
// re-enter a completed job or send an audit tick back into trial sampling.
var RaceBatchLifecycle = (function() {
  var phase="idle",completed=0,target=0,auditCompleted=0;
  return {
    begin:function(n){phase="trials";completed=0;target=n;auditCompleted=0;},
    snapshot:function(){return {phase:phase,completed:completed,target:target,auditCompleted:auditCompleted};},
    trials:function(n){completed=n;},
    audit:function(){phase="sensitivity";auditCompleted=0;},
    auditStep:function(n){auditCompleted=n;},
    finish:function(){phase="finished";},
    cancel:function(){phase="idle";completed=0;target=0;auditCompleted=0;}
  };
})();
