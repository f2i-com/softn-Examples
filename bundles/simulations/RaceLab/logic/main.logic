evidence.","This audit dataset never changes model inputs automatically; the existing frozen pilot remains a separate compatibility path."]};

/* Read-only research influence and provenance diagnostics. No model fitting,
 * seed consumption, ticket-driven forecasts, or automatic opinion application. */
var RaceResearchAudit=(function(){
  'use strict';
  var sim=typeof RaceSim!=='undefined'?RaceSim:null,models=typeof RaceModels!=='undefined'?RaceModels:null;
  var portfolio=typeof RacePortfolio!=='undefined'?RacePortfolio:null,observations=typeof RaceObservations!=='undefined'?RaceObservations:null;
  var snapshots=typeof RaceSnapshots!=='undefined'?RaceSnapshots:null,data=typeof RaceAnnotationData!=='undefined'?RaceAnnotationData:null;
  if(typeof module!=='undefined'&&module.exports){
    if(!sim)sim=require('./simulation');if(!models)models=require('./model-layer');if(!portfolio)portfolio=require('./portfolio');
    if(!observations)observations=require('./observations');if(!snapshots)snapshots=require('./snapshots');if(!data)data=require('./research-annotations-v2.json');
  }
  var SCHEMA='racelab-research-annotations-v2';
  var labels={flatStaminaEvidence:['positive','mixed','unproven','negative'],recentFormDirection:['positive','mixed','negative'],surfaceEvidence:['soft_evidence','uncertain','unknown_untried']};
  var metrics=['tripFeature','recencyFeature','softFeature','tripLog','recencyLog','softLog','logAdjustment'];
  var variantKeys=['base','trip','recency','surface','all'];
  function clone(x){return JSON.parse(JSON.stringify(x));}
  function fail(message){throw new Error(message);}
  function object(x,label){if(!x||typeof x!=='object'||Array.isArray(x))fail(label+' must be an object.');return x;}
  function keys(x,allowed,label){Object.keys(x).forEach(function(k){if(allowed.indexOf(k)<0)fail(label+' has unsupported property '+k+'.');});}
  function text(x,label,max,required){if(x==null&&!required)return null;if(typeof x!=='string'||x.length>max||/[\u0000-\u001f<>]/.test(x)||(required&&!x.trim()))fail(label+' must be plain text of at most '+max+' characters.');return x;}
  function timestamp(x,label){if(x==null)return null;try{return observations.validateTimestamp(x);}catch(e){fail(label+': '+e.message);}}
  function fieldCheck(field){var error=sim.validate(field);if(error)fail(error);}
  function stats(values){
    if(!values.length)return {count:0,mean:null,median:null,min:null,max:null};
    var ordered=values.slice().sort(function(a,b){return a-b;}),sum=0;values.forEach(function(v){sum+=v;});
    var middle=Math.floor(ordered.length/2);
    return {count:values.length,mean:sum/values.length,median:ordered.length%2?ordered[middle]:(ordered[middle-1]+ordered[middle])/2,min:ordered[0],max:ordered[ordered.length-1]};
  }
  function summary(rows){
    var result={count:rows.length,eligibleCount:rows.filter(function(r){return r.applicationEligible;}).length,metrics:{},tagCounts:{}};
    metrics.forEach(function(k){result.metrics[k]=stats(rows.map(function(r){return r[k];}));});
    Object.keys(labels).forEach(function(k){var counts={};rows.forEach(function(r){var label=r.tags&&r.tags[k]||'unavailable';counts[label]=(counts[label]||0)+1;});result.tagCounts[k]=counts;});
    result.meanLogAdjustment=result.metrics.logAdjustment.mean;result.medianLogAdjustment=result.metrics.logAdjustment.median;
    return result;
  }
  function contrast(rows){
    var selected=summary(rows.filter(function(r){return r.selected;})),unselected=summary(rows.filter(function(r){return !r.selected;})),difference={};
    metrics.forEach(function(k){var a=selected.metrics[k],b=unselected.metrics[k];difference[k]={mean:a.count&&b.count?a.mean-b.mean:null,median:a.count&&b.count?a.median-b.median:null};});
    return {selected:selected,unselected:unselected,difference:difference,meanLogDifference:difference.logAdjustment.mean,reason:'Selected minus unselected, descriptively. Selection and annotation may share evidence; this gap is not proof of causal bias or improved real-race chances.'};
  }
  function ratingBand(rating){return rating==null?'unknown':rating<110?'below110':rating<115?'110to114':rating<119?'115to118':'119plus';}
  function influence(field,scenario,inputSettings,selectedIds){
    fieldCheck(field);if(selectedIds==null)selectedIds=[];
    if(!Array.isArray(selectedIds))fail('Audit selections must be an array of horse IDs.');
    var ids=field.map(function(h){return h.id;}),seen=[];
    selectedIds.forEach(function(id){if(typeof id!=='string'||ids.indexOf(id)<0||seen.indexOf(id)>=0)fail('Audit selections must be distinct known horse IDs.');seen.push(id);});
    // Model preparation receives no selection, portfolio or annotation input.
    var prepared=models.prepare(field,scenario,inputSettings==null?models.pilotSettings():inputSettings);
    var rows=prepared.contributions.map(function(c){
      var r={id:c.id,number:c.number,name:c.name,active:c.active,status:c.active?'active':'scratched',rating:c.rawRating,ratingBand:ratingBand(c.rawRating),selected:selectedIds.indexOf(c.id)>=0,applicationEligible:c.research.eligible,appliedToForecast:c.active&&c.research.enabled,tags:c.research.tags,finalWeight:c.finalWeight,winProbability:c.winProbability};
      metrics.forEach(function(k){r[k]=c.research[k];});return r;
    });
    var byRatingBand=[],byStatus=[];
    ['below110','110to114','115to118','119plus','unknown'].forEach(function(band){var group=rows.filter(function(r){return r.active&&r.ratingBand===band;});byRatingBand.push({id:band,summary:contrast(group)});});
    ['active','scratched'].forEach(function(status){byStatus.push({id:status,summary:contrast(rows.filter(function(r){return r.status===status;}))});});
    return {schema:'racelab-research-influence-v1',modelIdentity:prepared.modelIdentity,settings:prepared.settings,scenario:prepared.scenario,rows:rows,overall:contrast(rows.filter(function(r){return r.active;})),byRatingBand:byRatingBand,byStatus:byStatus,calibrated:false,selectionAffectsForecast:false,limitations:['Overall and rating-band summaries use active runners only. Scratched-runner hypotheses are shown separately and have no forecast weight.','Rating bands are descriptive bins, not fitted categories. Empty groups report null rather than zero.','Tags are inherited from the existing frozen research pilot. Imported annotation opinions are not applied.']};
  }
  function ablation(field,scenario,inputSettings,tickets,key){
    if(variantKeys.indexOf(key)<0)fail('Ablation must be base, trip, recency, surface or all.');
    var setting=models.normalizeSettings(inputSettings==null?models.pilotSettings():inputSettings);
    if(key==='base'){if(setting.preset==='research_sensitivity')setting.preset='baseline';setting.tripScale=0;setting.recencyScale=0;setting.softScale=0;}
    if(key!=='trip'&&key!=='all')setting.tripScale=0;
    if(key!=='recency'&&key!=='all')setting.recencyScale=0;
    if(key!=='surface'&&key!=='all')setting.softScale=0;
    var prepared=models.prepare(field,scenario,setting),forecasts=sim.exactForecast(prepared.field,prepared.scenario);
    var weights={};prepared.contributions.forEach(function(c){weights[c.id]=c.finalWeight;});
    forecasts.sort(function(a,b){return b.winProbability-a.winProbability||(a.id<b.id?-1:a.id>b.id?1:0);});
    forecasts.forEach(function(f,i){f.rank=i+1;f.weight=weights[f.id];});
    var report=portfolio.analyse(prepared.field,prepared.scenario,tickets==null?{tickets:[]}:tickets);
    return {key:key,modelIdentity:prepared.modelIdentity,settings:prepared.settings,scenario:prepared.scenario,forecasts:forecasts,activeRunnerCount:forecasts.length,excludedRunnerIds:field.filter(function(h){return h.active===false;}).map(function(h){return h.id;}),ticketCoverage:report.tickets.map(function(t){return {id:t.id,name:t.name,probability:t.exactProbability};}),anyTicketCoverage:report.summary.any,calibrated:false,fullFieldNormalisation:true};
  }
  function ablations(field,scenario,setting,tickets){
    var variants=variantKeys.map(function(key){return ablation(field,scenario,setting,tickets,key);}),base=variants[0],byId={},byTicket={};
    base.forecasts.forEach(function(f){byId[f.id]=f;});base.ticketCoverage.forEach(function(t){byTicket[t.id]=t;});
    variants.forEach(function(v){v.forecasts.forEach(function(f){f.rankChangeVsBase=byId[f.id].rank-f.rank;f.winProbabilityDelta=f.winProbability-byId[f.id].winProbability;f.top3ProbabilityDelta=f.top3Probability-byId[f.id].top3Probability;});v.ticketCoverage.forEach(function(t){t.deltaVsBase=t.probability-byTicket[t.id].probability;});v.anyCoverageDeltaVsBase=v.anyTicketCoverage-base.anyTicketCoverage;});
    return {schema:'racelab-research-ablation-v1',variants:variants,calibrated:false,interpretation:'Each variant recalculates over the full active field. Positive rank change means a higher model win rank. Coverage changes follow model assumptions, not established real-world improvements.'};
  }
  function sourceRef(value){
    object(value,'Annotation source');keys(value,['sourceId','url','publishedDate','publishedAt'],'Annotation source');
    var url=text(value.url,'Source URL',1000,false);if(url!=null&&!/^https?:\/\/[^\s/]+[^\s]*$/i.test(url))fail('Annotation source URL must be HTTP(S).');
    var date=value.publishedDate==null?null:text(value.publishedDate,'Published date',10,true);
    if(date!=null){if(!/^\d{4}-\d{2}-\d{2}$/.test(date))fail('Published date must be YYYY-MM-DD.');timestamp(date+'T00:00:00Z','Published date');}
    return {sourceId:text(value.sourceId,'Source ID',160,true),url:url,publishedDate:date,publishedAt:timestamp(value.publishedAt,'Source publication time')};
  }
  function identityMap(identityKey){
    if(identityKey==null)return [];
    if(!Array.isArray(identityKey)||identityKey.length>40)fail('Blind identity key must contain at most 40 runners.');
    var ids=[],horses=[];
    return identityKey.map(function(entry){object(entry,'Blind identity');keys(entry,['id','horseId'],'Blind identity');var id=text(entry.id,'Blind ID',100,true),horse=text(entry.horseId,'Horse ID',80,true);if(ids.indexOf(id)>=0||horses.indexOf(horse)>=0)fail('Blind identity keys must be distinct.');ids.push(id);horses.push(horse);return {id:id,horseId:horse};});
  }
  function validationStatus(annotation,targetTime){
