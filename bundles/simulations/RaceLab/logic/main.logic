function invalidatePendingImport() { importGeneration = importGeneration + 1; importMessage = ""; RaceSession.stage(null);pendingFieldChanges=false;fieldDiffRows=[];fieldDiffSummary=""; }
function reportImportError(value) { importError = String(value); error = importError; importMessage = ""; }
function defaultField() {
  invalidatePendingImport(); importError = ""; importMessage = "";
  fieldOrigin = "official";
  field = decorate(todayFieldOverlay(RaceSim.cup2026()));
  fieldLabel = "Race-day field · scratching update 10:35 am AEDT, 3 Nov";
  serialise();
  officialFieldText = fieldText;
  acceptSnapshot(); refreshSelection();
}
function parseField() {
  return parseFieldValue(fieldText);
}
function parseFieldValue(text, baseField) {
  if (typeof text !== "string" || text.length > 12000) throw new Error("Field text must be at most 12,000 characters.");
  let lines = text.split("\n");
  let parsed = [];
  let snapshot = RaceSim.cup2026();
  for (let i = 0; i < lines.length; i = i + 1) {
    let line = String(lines[i]).trim();
    if (!line) continue;
    let parts = line.split(",");
    if (parts.length < 4 || parts.length > 9) throw new Error("Each row needs 4–9 columns: number, name, barrier, strength, then optional active, weight, stamina, wet and style.");
    let num = Number(parts[0]);
    let active = parts.length < 5 || String(parts[4]).trim() !== "0";
    let weight = parts.length > 5 ? Number(parts[5]) : 0;
    if (parts.length > 5 && (!Number.isFinite(weight) || weight < 0 || weight > 80)) throw new Error("Weight must be a finite number between 0 and 80 kg.");
    if (parts.length > 4 && String(parts[4]).trim() !== "0" && String(parts[4]).trim() !== "1") throw new Error("Active must be 1 or 0.");
    let name = String(parts[1]).trim();
    let old = null;
    let candidates = baseField || field;
    for (let j = 0; j < candidates.length; j = j + 1) { if (Number(candidates[j].number) === num && candidates[j].name === name) { old = candidates[j]; break; } }
    if (!old && !baseField && fieldOrigin !== "imported") for (let j = 0; j < snapshot.length; j = j + 1) { if (snapshot[j].number === num && snapshot[j].name === name) { old = snapshot[j]; break; } }
    let stamina = parts.length > 6 ? Number(parts[6]) : (old ? old.stamina : 0);
    let wet = parts.length > 7 ? Number(parts[7]) : (old ? old.wet : 0);
    let style = parts.length > 8 ? String(parts[8]).trim() : (old ? old.style : "mid");
    if (!Number.isFinite(stamina) || stamina < -1 || stamina > 1 || !Number.isFinite(wet) || wet < -1 || wet > 1) throw new Error("Stamina and wet preferences must be between -1 and 1.");
    if (style !== "front" && style !== "mid" && style !== "close") throw new Error("Style must be front, mid or close.");
    let sameHorse = old && old.name === name;
    parsed.push({id: sameHorse ? old.id : "custom-" + num, number:num, name:name, barrier:Number(parts[2]), strength:Number(parts[3]), active:active, weight:weight, stamina:stamina, wet:wet, style:style, colour:old ? old.colour : "#e9c77e",rating:sameHorse ? old.rating : null,form:sameHorse ? old.form : "User-entered runner",lastStart:sameHorse ? old.lastStart : null,history:sameHorse ? old.history : null,provenance:sameHorse ? old.provenance : "User-edited runner"});
    if (sameHorse) {
