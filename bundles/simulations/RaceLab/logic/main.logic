      var point=mapPoint(position);
      markers.push({id:runner.id,x:point.x,y:point.y,focused:focusId!=null&&String(runner.id)===String(focusId),leader:runner===leader,finished:runner.finished===true,distanceToLeader:Math.max(0,leader.distance-runner.distance)});
    }
    return {width:100,height:30,path:mapPath,start:{x:mapStart.x,y:mapStart.y},finish:{x:mapFinish.x,y:mapFinish.y},markers:markers};
  }
  // Chapters are distances REMAINING for the current leader, not measured
  // sectionals. Inverting the existing monotone replay on demand changes no
  // samples or timings; 24 bisections resolve a 200-second race to ~12 us.
  function chapterTime(runners,order,winnerTime,replaySeed,remainingMetres){
    var duration=Number(winnerTime);if(!(duration>0))duration=200;
    var remaining=Number(remainingMetres);if(!isFinite(remaining))remaining=0;
    var target=3200-clamp(remaining,0,3200);
    var initial=raceState(runners,order,0,duration,replaySeed,false);
    if(initial.runners.length===0||target<=0)return 0;
    if(target>=3200)return duration;
    var low=0,high=duration;
    for(var i=0;i<24;i++){
      var middle=(low+high)/2;
      if(raceState(runners,order,middle,duration,replaySeed,false).leaderDistance>=target)high=middle;else low=middle;
    }
    return high;
  }
  return {staticObjects:staticObjects,horses:horses,raceState:raceState,pointAt:pointAt,camera:overview,cameraFor:cameraFor,miniMap:miniMap,chapterTime:chapterTime,lights:[{type:'ambient',intensity:0.85},{type:'hemisphere',color:'#cfe9ff',groundColor:'#3a6845',intensity:0.55},{type:'directional',position:{x:15,y:40,z:20},intensity:2.0,castShadow:true,follow:'view',shadowCameraSize:18,shadowMapSize:2048,shadowBias:-0.0008}],meta:{distance:3200,firstPassage:888,circuit:2312,metresPerUnit:1/unitsPerMetre,trackWidthMetres:1.62/unitsPerMetre,description:'Stylised Flemington-inspired geometry. Course dimensions and landmarks are approximate; not a surveyed track.'}};
})();
if(typeof module!=='undefined'&&module.exports)module.exports=RaceTrack;

/* Presentation-only camera orbit, zoom and pan. No race or random state. */
var RaceCamera = (function() {
  var rad = Math.PI / 180;
  function clamp(n,lo,hi){return Math.max(lo,Math.min(hi,n));}
  function number(n,fallback){return typeof n==='number' && isFinite(n)?n:fallback;}
  function defaults(){return {yaw:0,tilt:0,zoom:1,panX:0,panY:0};}
  function clean(view){
    var v=view||{};
    return {yaw:((number(v.yaw,0)%360)+360)%360,tilt:clamp(number(v.tilt,0),-80,80),zoom:clamp(number(v.zoom,1),0.35,4),panX:clamp(number(v.panX,0),-1.5,1.5),panY:clamp(number(v.panY,0),-1.5,1.5)};
  }
  function pose(base,view){
    var v=clean(view),p=base.position,t=base.lookAt;
    var dx=p.x-t.x,dy=p.y-t.y,dz=p.z-t.z;
    var distance=Math.sqrt(dx*dx+dy*dy+dz*dz);
    var horizontal=Math.sqrt(dx*dx+dz*dz);
    var yaw=Math.atan2(dx,dz)+v.yaw*rad;
    var pitch=clamp(Math.atan2(dy,horizontal)+v.tilt*rad,10*rad,80*rad);
    var radius=clamp(distance*v.zoom,0.65,250);
    // Ground-plane pan follows the view's right/forward axes. Bound the
    // offset so reset is never the only way to recover a lost scene.
    var side=v.panX*distance,forward=v.panY*distance;
    var target={x:t.x+Math.cos(yaw)*side-Math.sin(yaw)*forward,y:t.y,z:t.z-Math.sin(yaw)*side-Math.cos(yaw)*forward};
    return {position:{x:target.x+Math.sin(yaw)*Math.cos(pitch)*radius,y:Math.max(0.16,target.y+Math.sin(pitch)*radius),z:target.z+Math.cos(yaw)*Math.cos(pitch)*radius},lookAt:target,fov:base.fov};
  }
  function change(view,action,x,y){
    var v=clean(view),a=number(x,0),b=number(y,0);
    if(action==='rotate')v.yaw+=a;
    if(action==='tilt')v.tilt+=a;
    if(action==='zoom' && a>0)v.zoom*=a;
    if(action==='pan'){v.panX+=a;v.panY+=b;}
    return clean(v);
  }
  return {defaults:defaults,clean:clean,pose:pose,change:change};
})();
