    let record = {fieldJSON:JSON.stringify(raceHorseEnvelope(savedField)),fieldOrigin:fieldOrigin,fieldText:fieldText,going:going,pace:pace,barrierMode:barrierMode,historyMode:historyMode,trials:trials,selectionText:selectionText,stake:stake};
