    for (let j = 0; j < field.length; j = j + 1) {
      let h = field[j];
      if (h.id === finishOrder[i]) {
        let crossing = raceDuration;
        for (let k = 0; k < raceState.runners.length; k = k + 1) if (raceState.runners[k].id === h.id) crossing = raceState.runners[k].finishTime;
        finishRows.push({id:h.id,position:i+1,number:h.number,name:h.name,colour:h.colour,selected:resultIds.indexOf(h.id)!==-1,gap:i===0?formatClock(crossing):"+"+(crossing-raceDuration).toFixed(2)+" s"});
      }
    }
  }
