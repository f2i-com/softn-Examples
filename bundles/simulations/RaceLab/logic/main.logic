    // Finish post and line on the home straight, beside the illustrated stands.
    out.push(obj('finish-line','box',FINISH,0.015,R,0.012,0.003,w,'#f6efe1'));
    out.push({id:'winning-post',type:'model',modelUrl:'assets/models/winning-post.glb',position:{x:FINISH,y:0.014,z:R+w/2+0.025},castShadow:true,receiveShadow:true});
    out.push(obj('start-post','box',START,0.09,R+w/2+0.025,0.012,0.15,0.012,'#e7c37d'));
    // Stylised grandstand and pavilion, deliberately no copyrighted branding.
    out.push({id:'grandstand',type:'model',modelUrl:'assets/models/grandstand.glb',position:{x:3,y:0.0,z:10.1},castShadow:true,receiveShadow:true});
    // Trees outside the circuit make its footprint legible from the overhead camera.
    for(var k=0;k<12;k++){
      var tx=-44+k*8.4,tz=k%2?-20:23;
      out.push(obj('tree-trunk-'+k,'box',tx,0.5,tz,0.25,1,0.25,'#7b6247'));
      out.push({id:'tree-crown-'+k,type:'dodecahedron',position:{x:tx,y:1.65,z:tz},radius:1.4,color:k%2?'#285c43':'#32704c',flatShading:true,castShadow:true,receiveShadow:true});
    }
