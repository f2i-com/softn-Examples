      // retain the existing leader camera, including its exact coordinates.
      if(focusId!=null && String(focusId)!==''){
        for(var f=0;f<field.length;f++)if(String(field[f].id)===String(focusId)){
          leader=field[f];q=pointAt(leader.distance);break;
