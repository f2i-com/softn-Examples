function tick(dt) {
  if (!running) return;
  if (!hasResult || resultKey !== dataKey()) { running = false; raceComplete = false; message = "Inputs changed. Simulate again."; return; }
  let seconds = Number(dt);
  if (!Number.isFinite(seconds) || seconds <= 0) seconds = 0.033;
  seconds = Math.min(0.2, seconds);
