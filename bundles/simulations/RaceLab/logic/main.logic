}
function selectedIds() { return selectedIdsFor(selectionText,field); }
function selectedIdsFor(text,list) {
  if (typeof text !== "string" || text.length > 500) throw new Error("Selection must be at most 500 characters.");
  if (!text.trim()) return [];
  let parts = text.split(","); let ids = [];
  for (let i = 0; i < parts.length; i = i + 1) {
    let n = Number(parts[i].trim()); let match = null;
    for (let j = 0; j < list.length; j = j + 1) if (Number(list[j].number) === n && list[j].active !== false) match = list[j];
    if (!match || ids.indexOf(match.id) !== -1) throw new Error("Choose distinct saddlecloth numbers for active runners.");
    ids.push(match.id);
  }
  return ids;
}
function validateScenarioValues(r,list) {
  if (!r || (r.going !== "good" && r.going !== "soft" && r.going !== "heavy")) throw new Error("Choose a valid going.");
  if (r.pace !== "slow" && r.pace !== "moderate" && r.pace !== "fast") throw new Error("Choose a valid pace.");
  if (r.barrierMode !== "off" && r.barrierMode !== "modest") throw new Error("Choose a valid barrier setting.");
  if (r.historyMode !== "off" && r.historyMode !== "cautious") throw new Error("Choose a valid history setting.");
  let n = Number(r.trials);
  if (n !== 1000 && n !== 5000 && n !== 20000 && n !== 100000) throw new Error("Choose a valid simulation count.");
