ients":{"tripScale":0.06,"recencyScale":0.04,"softScale":0.02,"maxAbsLogAdjustment":0.12},"categoryMap":{"flatStaminaEvidence":{"positive":1,"mixed":0.25,"unproven":0,"negative":-0.5},"recentFormDirection":{"positive":1,"mixed":0,"negative":-1},"surfaceEvidence":{"soft_evidence":1,"all_other":0}},"evaluationGoing":"soft","recommendations":["Keep the raw published rating/strength unchanged and derive a separate scenario strength.","Prefer historyMode=off for pilot versus baseline because condition evidence can overlap.","Only apply softScale when going=soft; do not assume it generalises to heavy.","Use the same evidence rule for all 24, regardless of betting shortlist."],"exactConditionalExample":{"historyOff":{"baseline4Pct":0.4195,"pilot4Pct":0.4764,"baseline6Pct":1.8074,"pilot6Pct":2.0112,"baseline10Pct":8.7219,"pilot10Pct":9.7645},"historyCautious":{"baseline10Pct":8.7949,"pilot10Pct":9.8411}},"disclaimer":"Exact values from a toy transformation using the submitted v0.10.0 source. Not real-world probabilities and not validated out-of-time."}};

/* Race-by-race evidence boundary. Validation is not source verification.
 * Imported claims never become verified model evidence. No network access. */
var RaceObservations = (function () {
  'use strict';
  var SCHEMA = 'racelab-observations-v1';
  function fail(message) { throw new Error(message); }
  function object(value,label) {
    if (!value || typeof value!=='object' || Array.isArray(value)) fail(label+' must be an object.');
    return value;
  }
  function text(value,label,max,required) {
    if(value==null && !required) return null;
    if(typeof value!=='string' || value.length>max || /[\u0000-\u0008\u000b\u000c\u000e-\u001f<>]/.test(value) || (required && !value.trim())) fail(label+' must be plain text of at most '+max+' characters.');
    return value;
  }
  function number(value,label,lo,hi,integer) {
    if(value==null) return null;
    if(typeof value!=='number' || !Number.isFinite(value) || value<lo || value>hi || (integer && !Number.isInteger(value))) fail(label+' must be '+(integer?'an integer':'a number')+' from '+lo+' to '+hi+', or null.');
    return value;
  }
  function keys(value,allowed,label) {
    Object.keys(value).forEach(function(k){if(allowed.indexOf(k)===-1) fail(label+' has an unsupported property: '+k+'.');});
  }
  function date(value,label) {
    var s=text(value,label,10,true);
    if(!/^\d{4}-\d{2}-\d{2}$/.test(s)) fail(label+' must use YYYY-MM-DD.');
    var y=Number(s.slice(0,4)),m=Number(s.slice(5,7)),d=Number(s.slice(8,10));
    var leap=(y%4===0&&y%100!==0)||y%400===0;
    var days=[31,leap?29:28,31,30,31,30,31,31,30,31,30,31];
    if(y<1800 || m<1 || m>12 || d<1 || d>days[m-1]) fail(label+' is not a valid calendar date.');
    return s;
  }
