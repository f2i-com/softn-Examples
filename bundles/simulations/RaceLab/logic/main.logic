    var renderPosition={x:position.x,y:position.y+Math.max(0,0.014-minHoofY),z:position.z};
    return {
      id:id,
      type:'model',
      modelUrl:'assets/models/racehorse.glb',
      position:renderPosition,
      rotation:{x:0,y:yaw,z:roll},
      scale:{x:0.10,y:0.07,z:0.085},
      appearance:{colors:{Coat:coat,Highlight:palette.highlight,Shadow:palette.shadow,Muzzle:palette.muzzle,Silk:color}},
      parts:{
        HindLeft:{rotation:{x:0,y:0,z:hl.angle}},
        HindLeftJoint:{rotation:{x:0,y:0,z:hl.flex}},
        HindRight:{rotation:{x:0,y:0,z:hr.angle}},
        HindRightJoint:{rotation:{x:0,y:0,z:hr.flex}},
        ForeLeft:{rotation:{x:0,y:0,z:fl.angle}},
        ForeLeftJoint:{rotation:{x:0,y:0,z:fl.flex}},
