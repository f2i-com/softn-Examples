    validateScenarioValues(settings,candidate);
    if(r.modelJSON!=null&&r.modelJSON!==""&&typeof r.modelJSON!=="string")throw new Error("Saved model settings must be JSON text.");
    let savedModelValue=r.modelJSON==null||r.modelJSON===""?RaceModels.defaults():JSON.parse(r.modelJSON);
    if(!savedModelValue||typeof savedModelValue!=="object"||Array.isArray(savedModelValue))throw new Error("Saved model settings must contain an object.");
    let savedModel=RaceModels.normalizeSettings(savedModelValue);
    if(r.portfolioMode!=null&&r.portfolioMode!=="true"&&r.portfolioMode!=="false")throw new Error("Saved portfolio mode is invalid.");
    let usePortfolio=r.portfolioMode==="true";
    let savedPortfolio=usePortfolio?portfolioFromSaved(candidate,JSON.parse(r.portfolioJSON)):[];
    let savedDividend=r.hypotheticalDividend==null?"":String(r.hypotheticalDividend);
    if(savedDividend.trim()&&(!Number.isFinite(Number(savedDividend))||Number(savedDividend)<0||Number(savedDividend)>10000000||Math.abs(Number(savedDividend)*100-Math.round(Number(savedDividend)*100))>0.000001))throw new Error("Saved dividend is invalid.");
    // Commit only after every field and setting has passed validation.
    invalidatePendingImport();
    cancelBatch(); field = candidate; fieldOrigin = r.fieldJSON ? "imported" : "edited";
    fieldText = r.fieldText; going = settings.going; recordGoingRestored(); pace = settings.pace; barrierMode = settings.barrierMode; historyMode = settings.historyMode;
    trials = settings.trials; selectionText = settings.selectionText; stake = settings.stake;
    commitModelSettings(savedModel);portfolioMode=usePortfolio;portfolioText=JSON.stringify(savedPortfolio);hypotheticalDividend=savedDividend;acceptSnapshot();if(portfolioMode)refreshPortfolio();
    if (fieldOrigin !== "imported") fieldOrigin = fieldText === officialFieldText ? "official" : "edited";
    fieldLabel = fieldOrigin === "imported" ? "Imported JSON · unverified" : "Saved field";
    hasResult = false; exportJson = ""; replayCode = ""; clearReplay(); refreshSelection(); scene();
    error = ""; message = "Saved scenario loaded. Run a new simulation.";
  } catch (e) { error = "Could not load scenario: " + String(e.message || e); }
}
function applyHorseJSON() {
  invalidatePendingImport();
  try {
    let imported = raceParseHorseJSON(importText);
    stageHorseChanges(imported);
  } catch (e) { reportImportError("Import failed: " + String(e.message || e)); }
}
function toggleRunner(number) {
  try {
    let candidate = parseField(); let target = null;
    for (let i = 0; i < candidate.length; i = i + 1) if (candidate[i].number === Number(number)) target = candidate[i];
    if (!target) throw new Error("Runner is not in the current field.");
    target.active = target.active === false;
    let validation = RaceSim.validate(candidate); if (validation) throw new Error(validation);
    raceHorseEnvelope(candidate);
    let wasScratched = target.active === false;
    let selections = String(selectionText).split(","); let kept = [];
    for (let j = 0; j < selections.length; j = j + 1) if (selections[j].trim() && (!wasScratched || Number(selections[j].trim()) !== Number(number))) kept.push(selections[j].trim());
    invalidatePendingImport(); cancelBatch(); field = decorate(candidate); serialise(); acceptSnapshot();
    selectionText = kept.join(",");
    if (fieldOrigin !== "imported") fieldOrigin = fieldText === officialFieldText ? "official" : "edited";
    fieldLabel = fieldOrigin === "imported" ? "Imported JSON · unverified" : fieldOrigin === "official" ? "Race-day field · scratching update 10:35 am AEDT, 3 Nov" : "User-edited field";
    hasResult = false; exportJson = ""; replayCode = ""; horseJson = ""; batchResult = null; RaceReview.setSensitivity(null);
    clearReplay(); refreshSelection(); scene(); error = "";
    message = target.name + (wasScratched ? " scratched" : " reinstated") + ". " + activeRunnerCount + " active runners; gates updated. Run a new batch.";
  } catch (e) { error = "Could not change runner: " + String(e.message || e); }
}
function prepareHorseJSON() {
  try { horseJson = JSON.stringify(raceHorseEnvelope(parseField()),null,2); error = ""; }
  catch (e) { error = "Could not export horses: " + String(e.message || e); }
}
function pickHorseJSON() {
  invalidatePendingImport(); let generation = importGeneration;
  let startingFieldText = fieldText; let startingImportText = importText;
  error = ""; importError = ""; importMessage = "";
  try {
    softn.files.pickFile({accept:".json,application/json"},function(files) {
      if (generation !== importGeneration) return;
      if (files && files.error) { reportImportError(files.error); return; }
      if (!files || !files.length) return;
      if (files[0].size > 100000) { reportImportError("Horse JSON is limited to 100,000 bytes."); return; }
      importMessage = "Reading horse JSON…";
      softn.files.readText(files[0].ref,function(content) {
        if (generation !== importGeneration) return;
        if (fieldText !== startingFieldText || importText !== startingImportText) { invalidatePendingImport(); importMessage = "File import cancelled because the editor changed. Import again to use that file."; return; }
        if (typeof content !== "string") { reportImportError(content && content.error ? content.error : "Could not read JSON text."); return; }
        importText = content; applyHorseJSON();
      });
    });
  } catch (e) { reportImportError("File import is unavailable in this host. Paste JSON below instead."); }
}
function saveResultsJSON() {
  if (!hasResult || resultKey !== dataKey() || !exportJson) { error = "Run the current scenario before exporting results."; return; }
  try { refreshMarketStatus();buildResultsExport(); } catch(e){error="Could not prepare current export: "+String(e.message||e);return;}
  error = "";
  try { softn.files.saveFile("racelab-results.json",exportJson,{mime:"application/json"},function(r) { if (r && r.error) error = String(r.error); else message = "Results JSON exported."; }); }
  catch (e) { error = "File export is unavailable in this host. Copy the JSON below instead."; }
}
function saveHorseJSON() {
  prepareHorseJSON(); if (error) return;
  try { softn.files.saveFile("racelab-horses.json",horseJson,{mime:"application/json"},function(r) { if (r && r.error) error = String(r.error); else message = "Horse JSON exported."; }); }
  catch (e) { error = "File export is unavailable in this host. Copy the JSON below instead."; }
}
function prepareHistoricalChecks() {
  let data = HistoricalData.get();
  let report = RaceAudit.benchmarkMany(data.races);
  report.dataProvenance = {retrievedAt:data.retrievedAt,archiveCaveat:data.archiveCaveat,historyCaveat:data.historyCaveat,excludedYears:data.excludedYears,benchmarkProvider:data.benchmarkProvider};
  RaceReview.setHistorical(report); historicalRows = [];
  let base = report.variants[0]; let uniform = report.uniform;
  let underperformed = base.meanLogLoss > uniform.meanLogLoss && base.meanBrierScore > uniform.meanBrierScore;
  historicalSignalText = underperformed ? "In two historical Cups, the frozen ratings baseline did not beat equal win chances on average. See Historical checks." : "Historical checks are retrospective and too small to establish predictive accuracy.";
  historicalOverview = report.raceCount + " reconstructed Cups. Ratings-only mean log loss " + base.meanLogLoss.toFixed(4) + " vs equal chances " + uniform.meanLogLoss.toFixed(4) + "; mean Brier " + base.meanBrierScore.toFixed(4) + " vs " + uniform.meanBrierScore.toFixed(4) + ". Lower is better. These results were not used to tune the model. Comparable historical going/track evidence was unavailable, so history adjustments are off in these checks.";
  historicalOverview = historicalOverview + " Top-three Brier: " + base.meanTop3BrierScore.toFixed(4) + " vs equal " + uniform.meanTop3BrierScore.toFixed(4) + "; ordered-trifecta log loss: " + base.meanOrderedFirst3LogLoss.toFixed(4) + " vs " + uniform.meanOrderedFirst3LogLoss.toFixed(4) + ". Lower is better for both.";
  let omission = base.leaveOneOut.improvementRanges.logLossImprovementOverUniform;
  historicalSensitivityText = omission.available ? "Omitting either race gives a winner log-loss improvement over equal chances from " + omission.minimum.toFixed(4) + " to " + omission.maximum.toFixed(4) + ". Positive means better, negative worse. Each remainder has one race, so this is descriptive sample sensitivity with no refitting; it is not a confidence interval or cross-validation." : "Too few eligible races for an omission comparison.";
  for (let i = 0; i < report.races.length; i = i + 1) {
    let race = report.races[i]; let winner = "Unknown";
    for (let h = 0; h < race.field.length; h = h + 1) if (race.field[h].id === race.outcome.winnerId) winner = race.field[h].name;
    for (let j = 0; j < race.variants.length; j = j + 1) {
      let variant = race.variants[j]; let m = variant.metrics;
      historicalRows.push({id:race.id+"-"+variant.id,label:race.raceDate.slice(0,4)+" · "+variant.label,winner:winner,starters:race.starterCount,winnerChance:numberText(m.winnerProbability*100)+"%",uniformChance:numberText(race.uniform.winnerProbability*100)+"%",logLoss:m.logLoss.toFixed(4),uniformLogLoss:race.uniform.logLoss.toFixed(4),brier:m.brierScore.toFixed(4),uniformBrier:race.uniform.brierScore.toFixed(4),top3Brier:m.top3BrierScore.toFixed(4),uniformTop3Brier:race.uniform.top3BrierScore.toFixed(4),trifectaLogLoss:m.orderedFirst3LogLoss.toFixed(4),uniformTrifectaLogLoss:race.uniform.orderedFirst3LogLoss.toFixed(4),trifectaProbability:(m.orderedFirst3Probability*100).toFixed(4)+"%",source:race.source,resultSource:race.outcomeSource,notes:"Inputs published "+race.publishedDate+"; outcome "+race.raceDate+". Retrieved in 2026; no immutable pre-race archive. No current horse histories reused."});
    }
  }
}
function _init() {
  courseObjects = RaceTrack.staticObjects(); camera = RaceTrack.camera; lights = RaceTrack.lights;
  defaultField(); prepareHistoricalChecks(); scene(); refreshEvidence(); initDiagnostics();
}

// v0.11 application features. Sampling remains in the private batch lifecycle.
// Observational only: these supplied aggregates do not change model inputs.
// A category is unknown unless its source data is present and reconciles to
// the career record; in particular, missing synthetic data is never zero.
function observedSurfaceBreakdown(h){
  let history=h&&h.history, going=history&&history.going;
  let result={horseId:h?h.id:null,number:h?h.number:null,name:h?h.name:null,status:"unavailable",turf:null,synthetic:null,source:history&&history.source?history.source:null,snapshot:history&&history.snapshot?history.snapshot:null,note:"Surface totals are observational. Source records may include jumps; no model adjustment is made."};
  function valid(r){if(!r)return false;let k=["starts","wins","seconds","thirds"];for(let i=0;i<k.length;i=i+1)if(!Number.isInteger(r[k[i]])||r[k[i]]<0)return false;return r.wins+r.seconds+r.thirds<=r.starts;}
  if(!history||!going||!valid(history.career)||!valid(going.good)||!valid(going.soft)||!valid(going.heavy)||!valid(going.synthetic)||(going.firm!=null&&!valid(going.firm))){result.reason="Complete surface-category counts are unavailable.";return result;}
  let turf={starts:0,wins:0,seconds:0,thirds:0},keys=["starts","wins","seconds","thirds"],surfaces=[going.good,going.soft,going.heavy];
  if(going.firm!=null)surfaces.push(going.firm);
  for(let i=0;i<surfaces.length;i=i+1)for(let j=0;j<keys.length;j=j+1)turf[keys[j]]+=surfaces[i][keys[j]];
  for(let j=0;j<keys.length;j=j+1)if(turf[keys[j]]+going.synthetic[keys[j]]!==history.career[keys[j]]){result.reason="Surface-category totals do not reconcile with the career record.";return result;}
  result.status="reconciled";result.turf=turf;result.synthetic={starts:going.synthetic.starts,wins:going.synthetic.wins,seconds:going.synthetic.seconds,thirds:going.synthetic.thirds};return result;
}
var RaceSession=(function(){var model=null,portfolio=null,report=null,pending=null,reportRace="";return {setModel:function(v){model=v;},model:function(){return model;},setPortfolio:function(v){portfolio=v;},portfolio:function(){return portfolio;},setReport:function(v,key){report=v;reportRace=key||"";},report:function(){return report;},reportRace:function(){return reportRace;},stage:function(v){pending=v;},pending:function(){return pending;}};})();
let portfolioMode=false;
let portfolioText="[]";
let portfolioRows=[];
let portfolioSummary={totalStakeText:"$0.00",anyText:"—",exactlyOneText:"—",exactlyTwoText:"—",threePlusText:"—",expectedPayoutText:"Dividend unknown",netText:"Dividend unknown",notice:""};
let payoutRows=[];
let portfolioError="";
let sampledPortfolioText="Run a batch and reveal the result to settle your portfolio.";
let portfolioJSONText="";
let hypotheticalDividend="";
let modelPreset="baseline";
let ratingScale="8";
let tripScale="0";
let recencyScale="0";
let softScale="0";
let researchClamp="0.12";
let comparisonKey="";
let acceptedSnapshotId="";
let freshnessSummary="";
let freshnessRows=[];
let sourceWarningText="";
let pendingFieldChanges=false;
let fieldDiffRows=[];
let fieldDiffSummary="";
let ratingSensitivityRows=[];
let goingComparisonRows=[];
let miniMap={width:100,height:30,path:"",start:{x:0,y:0},finish:{x:0,y:0},markers:[]};
let focusHorseId="";
let seekValue="0";
let replayEndSeconds=210;
let frameInterval="66";
function currentModelSettings(){return RaceModels.normalizeSettings({preset:modelPreset,ratingDivisor:Number(ratingScale),tripScale:Number(tripScale),recencyScale:Number(recencyScale),softScale:Number(softScale),maxAbsLogAdjustment:Number(researchClamp)});}
function commitModelSettings(s){modelPreset=s.preset;ratingScale=String(s.ratingDivisor);tripScale=String(s.tripScale);recencyScale=String(s.recencyScale);softScale=String(s.softScale);researchClamp=String(s.maxAbsLogAdjustment);}
function currentScenario(){return {going:going,pace:pace,barrierImpact:barrierMode==="off"?0:0.08,historyMode:historyMode};}
function fieldIdentity(list){return RaceSnapshots.identify(raceHorseEnvelope(list).horses);}
function acceptSnapshot(){acceptedSnapshotId=fieldIdentity(field);refreshEvidence();invalidateDiagnostics();if(portfolioMode)refreshPortfolio();}
function refreshModelSettings(){invalidateDiagnostics();try{let s=currentModelSettings();running=false;ratingSensitivityRows=[];goingComparisonRows=[];comparisonKey="";refreshEvidence();if(portfolioMode)refreshPortfolio();refreshAdvancedSettings();error="";message="Model assumptions changed. Run a new batch.";}catch(e){error=String(e.message||e);}}
function setModelPreset(mode){if(mode!=="baseline"&&mode!=="ratings_only"&&mode!=="research_sensitivity"){error="Validated features are unavailable pending independent historical validation.";return;}modelPreset=mode;refreshModelSettings();}
function resetModelBaseline(){commitModelSettings(RaceModels.defaults());refreshModelSettings();}
function applyResearchPilot(){commitModelSettings(RaceModels.pilotSettings());historyMode="off";refreshModelSettings();message="Experimental research what-if applied, with history off to reduce double counting. Coefficients are uncalibrated.";}
function refreshFrameBudget(){if(frameInterval!=="33"&&frameInterval!=="66"&&frameInterval!=="100")frameInterval="66";}
function refreshFocus(){if(focusHorseId&&!field.some(function(h){return h.id===focusHorseId&&h.active!==false;}))focusHorseId="";miniMap=RaceTrack.miniMap(raceState,focusHorseId);updateCamera();}
function seekRace(value){if(!hasResult||resultKey!==dataKey())return;let n=Number(value);if(!Number.isFinite(n))return;running=false;elapsed=Math.max(0,Math.min(replayEndSeconds,n));raceComplete=false;finishRows=[];scene();if(elapsed>=replayEndSeconds){revealResult();scene();}}
function seekChapter(remaining){if(!hasResult||resultKey!==dataKey())return;seekRace(RaceTrack.chapterTime(field.filter(function(h){return h.active!==false;}),finishOrder,raceDuration,replaySeed,Number(remaining)));}
function dividendValue(){if(String(hypotheticalDividend).trim()==="")return null;let n=Number(hypotheticalDividend);if(!Number.isFinite(n)||n<0||n>10000000||Math.abs(n*100-Math.round(n*100))>0.000001)throw new Error("Enter a hypothetical dividend with at most two decimal places, or leave it blank.");return n;}
function portfolioDraft(){let rows=JSON.parse(portfolioText);if(!Array.isArray(rows)||rows.length>6)throw new Error("Use at most six portfolio tickets.");return rows;}
function preparedPortfolio(list){let rows=portfolioDraft();return RacePortfolio.prepare(list,{schema:"racelab-portfolio-v1",tickets:rows.map(function(t){let amount=Number(t.stake);if(!Number.isFinite(amount)||amount<=0||Math.abs(amount*100-Math.round(amount*100))>0.000001)throw new Error("Ticket stakes must be positive AUD amounts with at most two decimals.");return {id:t.id,name:t.name,type:t.type,selection:selectedIdsFor(t.selectionText,list),stakeCents:Math.round(amount*100)};})});}
function portfolioFromSaved(list,rows){let prepared=RacePortfolio.prepare(list,rows);return prepared.tickets.map(function(t){return {id:t.id,name:t.name,type:t.type,selectionText:t.selection.map(function(id){let n=0;list.forEach(function(h){if(h.id===id)n=h.number;});return n;}).join(","),stake:String(t.stakeAUD)};});}
function presentPortfolio(report){
  let drafts=portfolioDraft();portfolioRows=drafts.map(function(t){let row={id:t.id,name:t.name,type:t.type,selectionText:t.selectionText,stake:t.stake,combinationsText:"—",shareText:"—",coverageText:"—",sampleStatus:""};if(report)for(let i=0;i<report.tickets.length;i=i+1)if(report.tickets[i].id===t.id){let r=report.tickets[i];row.combinationsText=String(r.combinations);row.shareText=r.flexiPercent.toFixed(4)+"%";row.coverageText=(r.exactProbability*100).toFixed(4)+"%";row.sampleStatus=r.observedHits==null?"Exact model probability; run a batch for sampled counts.":r.observedHits+" hits / "+report.observedTrials+" trials · "+numberText(r.observedFrequency*100)+"% sampled";}return row;});
  if(!report)return;
  let gross=0;let known=report.hypotheticalDeclaredDividendAUD!=null;
  payoutRows=report.payoutCases.map(function(c){if(known)gross=gross+c.probability*c.grossPayoutAUD;let names=[];for(let i=0;i<report.tickets.length;i=i+1)if(c.winningTicketIds.indexOf(report.tickets[i].id)!==-1)names.push(report.tickets[i].name);return {id:String(c.mask),label:names.length?names.join(" + "):"No winning ticket",probabilityText:(c.probability*100).toFixed(4)+"%",grossText:c.grossPayoutAUD==null?"Dividend unknown":"$"+numberText(c.grossPayoutAUD),netText:c.netPayoutAUD==null?"Dividend unknown":"$"+numberText(c.netPayoutAUD)};});
  portfolioSummary={totalStakeText:"$"+numberText(report.totalStakeAUD),anyText:(report.summary.any*100).toFixed(4)+"%",exactlyOneText:(report.summary.exactlyOne*100).toFixed(4)+"%",exactlyTwoText:(report.summary.exactlyTwo*100).toFixed(4)+"%",threePlusText:(report.summary.threeOrMore*100).toFixed(4)+"%",expectedPayoutText:known?"$"+numberText(gross):"Dividend unknown",netText:known?"$"+numberText(gross-report.totalStakeAUD):"Dividend unknown",notice:"Overlapping outcomes counted once. Net subtracts all ticket stakes. Actual expected winnings: dividend unknown."};
}
function refreshPortfolio(){
  invalidateDiagnostics();
  try{if(comparisonKey!==dataKey()){ratingSensitivityRows=[];goingComparisonRows=[];}presentPortfolio(null);let list=parseField();let prepared=preparedPortfolio(list);let m=RaceModels.prepare(list,currentScenario(),currentModelSettings());let result=null;
    if(RaceBatchLifecycle.snapshot().phase==="finished"&&hasResult&&batchResult&&batchResult.trials===Number(trials)&&analysisContext.ids.join(",")===selectedIdsFor(selectionText,list).join(",")&&analysisContext.amount===Number(stake)&&sampleRaceKey===raceKey()&&RaceSession.portfolio()&&JSON.stringify(RaceSession.portfolio().simulationTickets)===JSON.stringify(prepared.simulationTickets))result=batchResult;
    let report=RacePortfolio.analyse(m.field,m.scenario,prepared,{dividendAUD:dividendValue(),simulationResult:result});RaceSession.setReport(report,raceKey());portfolioError="";presentPortfolio(report);
    if(hasResult&&sampleRaceKey===raceKey()&&result){RaceSession.setPortfolio(prepared);analysisContext.portfolio=prepared;resultKey=dataKey();makeReplayCode();buildResultsExport();if(raceComplete)refreshSampledPortfolio();}
  }catch(e){portfolioError=String(e.message||e);payoutRows=[];portfolioSummary={totalStakeText:"—",anyText:"—",exactlyOneText:"—",exactlyTwoText:"—",threePlusText:"—",expectedPayoutText:"Dividend unknown",netText:"Dividend unknown",notice:"Correct the ticket fields to calculate probabilities."};}
}
function enablePortfolio(){portfolioMode=true;if(!portfolioDraft().length)addPortfolioTicket();else refreshPortfolio();}
function disablePortfolio(){portfolioMode=false;running=false;message="Quick box selected. Play or Skip refreshes coverage using the same sampled race.";}
function addPortfolioTicket(){let rows=portfolioDraft();if(rows.length>=6)return;let id="ticket-"+Date.now().toString(36)+"-"+rows.length;rows.push({id:id,name:"Ticket "+(rows.length+1),type:"box",selectionText:selectionText,stake:"24.00"});portfolioText=JSON.stringify(rows);refreshPortfolio();}
function removePortfolioTicket(id){portfolioText=JSON.stringify(portfolioDraft().filter(function(t){return t.id!==id;}));refreshPortfolio();}
function updatePortfolioTicket(id,key,value){if(["name","type","selectionText","stake"].indexOf(key)===-1)return;let rows=portfolioDraft();rows.forEach(function(t){if(t.id===id)t[key]=String(value);});portfolioText=JSON.stringify(rows);running=false;refreshPortfolio();}
function loadNestedPortfolio(){try{let ids=selectedIdsFor("20,2,11,12,4,16,1,10,22,24",field);let p=RacePortfolio.nested(field,ids,[4,6,10],[2400,3000,9600]);portfolioText=JSON.stringify(portfolioFromSaved(field,p));portfolioMode=true;running=false;refreshPortfolio();}catch(e){portfolioError=String(e.message||e);}}
function refreshEvidence(){
  let model=null;try{model=RaceModels.prepare(field,currentScenario(),currentModelSettings());}catch(e){return;}
  for(let i=0;i<field.length;i=i+1){let h=field[i];let c=model.contributions[i];let e=c.evidence;let rows=[{id:"raw",label:"Raw strength",value:String(c.rawStrength),status:c.strengthBasis,note:"Rating divisor "+c.ratingDivisor+"; raw field remains unchanged."},{id:"transformed",label:"Transformed strength",value:c.transformedStrength.toFixed(4),status:"used",note:"Explicit imported strengths are retained."},{id:"gate",label:"Barrier multiplier",value:c.barrierMultiplier==null?"Scratched":c.barrierMultiplier.toFixed(6),status:"assumption",note:"Drawn "+c.drawnBarrier+"; effective gate "+c.effectiveGate},{id:"history",label:"History multiplier",value:c.historyMultiplier==null?"Scratched":c.historyMultiplier.toFixed(6),status:"assumption",note:"Sparse observations are shrunk; missing history is neutral."},{id:"manual",label:"Manual attributes multiplier",value:c.manualMultiplier.toFixed(6),status:"assumption",note:"Wet, stamina and running style; not fitted coefficients."},{id:"research",label:"Research multiplier",value:c.research.multiplier.toFixed(6),status:c.research.enabled?"experimental what-if":"off",note:"Log adjustment "+c.research.logAdjustment.toFixed(4)+"; never a calibrated effect."},{id:"final",label:"Final model weight",value:c.finalWeight.toFixed(6),status:c.active?"used":"scratched",note:"Win chance "+numberText(c.winProbability*100)+"%; change "+numberText(c.winProbabilityDelta*100)+" percentage points."}];
    c.fields.forEach(function(f,j){rows.push({id:"field-"+j,label:f.label,value:f.value==null?"Unknown":typeof f.value==="object"?"See form evidence":String(f.value),status:f.status,note:f.reason});});h.contributionRows=rows;
    let facts=[];if(e.available){facts.push({id:"core",text:"Research snapshot: rating "+e.record.publishedRating.value+", drawn barrier "+e.record.barrier+", "+e.record.weightKg+" kg.",date:e.asOf,sourceUrl:e.sources.length?e.sources[0].url:"",sourceLabel:"Research source"});}
    if(h.lastStart)facts.push({id:"last",text:h.recentStartText,date:h.lastStart.date,sourceUrl:h.lastStart.source||"",sourceLabel:"Last-start source"});
    let interpretations=[];if(e.available)Object.keys(e.record.research).forEach(function(k){interpretations.push({id:k,label:k,text:e.record.research[k]});});
    if(e.available && fieldOrigin!=="official" && RaceDayData.goingHistoryComparison.conflictingRunnerNumbers.indexOf(h.number)!==-1 && String(h.provenance||"").indexOf("User-imported")!==0)e.conflicts.push({message:"Going-history counts differ between the 3 Nov Racing Australia card and the older TABtouch snapshot. The model uses the older counts when cautious history is enabled; neither source difference establishes a reliable advantage."});
    h.researchEvidence={summary:e.available?e.status:"No matched research record; unknown evidence is neutral.",observedRows:facts,interpretationRows:interpretations,conflicts:e.conflicts.map(function(x,j){return {id:String(j),text:x.message};}),missingText:"No independently cross-checked complete flat-start history. "+(e.available&&e.record.number===24?"The 3 November race card names Harry Coffey; check for later rider changes.":"Later scratchings, rider changes and Cup-day going require checking."),baselineUseText:"Published strength plus selected history/barrier/manual assumptions. Research prose does not change the baseline.",researchUseText:"Opt-in uniform tag mapping; zero by default. Coefficients are analyst assumptions, not fitted evidence."};
  }
  let meta=RaceResearch.metadata();freshnessSummary="Race-day field 3 Nov · research as of "+meta.asOf+" · snapshots, not live updates";
  freshnessRows=[{id:"field",label:"Accepted field",value:fieldOrigin==="official"?"3 November 2026, 10:35 am AEDT scratching update; flat-history research":"User-imported or edited · unverified",status:fieldOrigin,sourceUrl:raceDayScratchUrl,sourceLabel:"Racing Australia scratchings"},{id:"research",label:"Research evidence",value:meta.asOf,status:"Attributed attachment · not a live feed",sourceUrl:"",sourceLabel:""},{id:"going",label:"Cup-day going",value:"Soft 5 at 6:00 am; selected "+going+" is a scenario",status:"Check for later track updates",sourceUrl:"",sourceLabel:""},{id:"rider",label:"Shockletz rider",value:fieldOrigin==="official"?"Harry Coffey on the 7:59 am card":"Check current field input",status:"No rider model effect",sourceUrl:raceDayFieldUrl,sourceLabel:"Racing Australia"},{id:"snapshot",label:"Accepted snapshot",value:acceptedSnapshotId,status:"Content-addressed input",sourceUrl:"",sourceLabel:""}];
  sourceWarningText=fieldOrigin==="official"?"The default field includes the 10:35 am scratching report and corrected flat career and going aggregates. Career aggregates may include synthetic flat races; small samples and differences between going classifications remain uncertain. Distance buckets are not scored. Weight, jockey and trainer are displayed, not separately scored. This is an offline snapshot; check for later changes.":"User-supplied and older replay fields may include jumps starts or conflicting going records. Confirm sources and compare with history OFF; weight, jockey and trainer are displayed, not separately scored.";
}
function stageHorseChanges(imported){RaceSession.stage({field:imported.field,base:fieldIdentity(field),draft:fieldText,text:importText});fieldDiffRows=RaceSnapshots.diff(raceHorseEnvelope(field).horses,raceHorseEnvelope(imported.field).horses);fieldDiffSummary=imported.field.length+" runners · "+fieldDiffRows.length+" changed fields. Review sources and values before applying. Import provenance remains unverified.";pendingFieldChanges=true;importError="";error="";importMessage="Import validated. Review the changes, then approve or cancel.";}
function cancelFieldChanges(){RaceSession.stage(null);pendingFieldChanges=false;fieldDiffRows=[];fieldDiffSummary="";importMessage="Import review cancelled.";}
function approveFieldChanges(){try{let p=RaceSession.pending();if(!p)throw new Error("No staged field changes.");if(p.base!==fieldIdentity(field)||p.draft!==fieldText||p.text!==importText)throw new Error("The field or import draft changed. Validate the import again.");invalidatePendingImport();cancelBatch();field=decorate(p.field);fieldOrigin="imported";fieldLabel="Imported JSON · unverified";serialise();selectionText="";acceptSnapshot();refreshSelection();hasResult=false;exportJson="";replayCode="";horseJson="";clearReplay();scene();cancelFieldChanges();importMessage=field.length+" horses imported after review. Source claims remain user supplied.";message=importMessage;error="";}catch(e){reportImportError(String(e.message||e));}}
function makeReplayCode(){let m=RaceSession.model();replayCode="RL11|"+JSON.stringify({version:1,model:RaceSim.model,modelIdentity:m?m.modelIdentity:RaceModels.modelIdentity(currentModelSettings()),modelSettings:currentModelSettings(),track:"racelab-track-0.7",dataVersion:"tabtouch-2026-11-01-v1",seed:replaySeed,horseData:raceHorseEnvelope(field),fieldSnapshotId:acceptedSnapshotId,researchSnapshotId:RaceResearch.snapshotId,fieldOrigin:fieldOrigin,going:going,pace:pace,barrierMode:barrierMode,historyMode:historyMode,trials:String(trials),selectionText:String(selectionText),stake:String(stake),portfolioMode:portfolioMode,portfolio:portfolioMode?preparedPortfolio(field):null,hypotheticalDividend:dividendValue()});}
function refreshComparisons(){try{comparisonKey=dataKey();let list=parseField();let settings=currentModelSettings();let sc=currentScenario();let ids=selectedIdsFor(selectionText,list);let p=portfolioMode?preparedPortfolio(list):null;let scales=[4,6,8,12,16];ratingSensitivityRows=[];goingComparisonRows=[];
  for(let i=0;i<8;i=i+1){let s=JSON.parse(JSON.stringify(settings));let scenario=JSON.parse(JSON.stringify(sc));if(i<5)s.ratingDivisor=scales[i];else scenario.going=["good","soft","heavy"][i-5];let m=RaceModels.prepare(list,scenario,s);let forecast=RaceSim.winForecast(m.field,m.scenario).sort(function(a,b){return b.winProbability-a.winProbability;});let quick=ids.length>=3?RacePortfolio.analyse(m.field,m.scenario,{tickets:[{id:"quick",name:"Quick box",type:"box",selection:ids,stakeCents:1}]}).summary.any:null;let any=p?RacePortfolio.analyse(m.field,m.scenario,p).summary.any:null;let row={id:String(i),label:i<5?"Rating divisor "+scales[i]:scenario.going,leader:horseName(forecast[0].id)+" · "+numberText(forecast[0].winProbability*100)+"%",portfolioAnyText:any==null?"Portfolio off":(any*100).toFixed(4)+"%",quickBoxText:quick==null?"No complete box":(quick*100).toFixed(4)+"%",notes:"Assumption sensitivity only. "+m.modelIdentity};if(i<5)ratingSensitivityRows.push(row);else goingComparisonRows.push(row);}
  error="";
}catch(e){error="Comparison unavailable: "+String(e.message||e);}}

function refreshSampledPortfolio(){try{let settlement=RacePortfolio.settle(field,preparedPortfolio(field),finishOrder,dividendValue());sampledPortfolioText=settlement.winningTicketCount+" winning ticket"+(settlement.winningTicketCount===1?"":"s")+" in this sampled race. "+(settlement.grossPayoutAUD==null?"Dividend unknown; no actual payout estimate.":"Hypothetical gross $"+numberText(settlement.grossPayoutAUD)+"; net $"+numberText(settlement.netPayoutAUD)+" after all stakes.");}catch(e){sampledPortfolioText=String(e.message||e);}}
function preparePortfolioJSON(){try{portfolioJSONText=JSON.stringify({schema:"racelab-portfolio-settings-v1",portfolio:preparedPortfolio(field),hypotheticalDividendAUD:dividendValue()},null,2);portfolioError="";}catch(e){portfolioError=String(e.message||e);}}
function applyPortfolioJSON(){try{if(typeof portfolioJSONText!=="string"||portfolioJSONText.length>20000)throw new Error("Portfolio JSON is limited to 20,000 characters.");let data=JSON.parse(portfolioJSONText);if(!data||data.schema!=="racelab-portfolio-settings-v1")throw new Error("Expected racelab-portfolio-settings-v1 JSON.");let rows=portfolioFromSaved(field,data.portfolio);let dividend=data.hypotheticalDividendAUD;if(dividend!=null&&(typeof dividend!=="number"||!Number.isFinite(dividend)||dividend<0||dividend>10000000||Math.abs(dividend*100-Math.round(dividend*100))>0.000001))throw new Error("Invalid dividend scenario.");portfolioText=JSON.stringify(rows);hypotheticalDividend=dividend==null?"":String(dividend);portfolioMode=true;running=false;refreshPortfolio();}catch(e){portfolioError=String(e.message||e);}}

function refreshScenarioAssumptions(){invalidateDiagnostics();running=false;ratingSensitivityRows=[];goingComparisonRows=[];comparisonKey="";refreshEvidence();if(portfolioMode)refreshPortfolio();refreshAdvancedSettings();}

function raceHorseEnvelope(list){return RaceIO.horseEnvelope(list,{targetTime:RaceResearch.metadata().race.scheduledLocal});}
function raceParseHorseJSON(text){return RaceIO.parseHorseJSON(text,{targetTime:RaceResearch.metadata().race.scheduledLocal});}
let nestedNumbers="20,2,11,12,4,16,1,10,22,24";
let nestedTiers="4,6,10";
let nestedStakes="24,30,96";
function createNestedPortfolio(){try{let ids=selectedIdsFor(nestedNumbers,field);let tiers=String(nestedTiers).split(",").map(function(x){return Number(x.trim());});let amounts=String(nestedStakes).split(",").map(function(x){let n=Number(x.trim());if(!x.trim()||!Number.isFinite(n)||n<=0||Math.abs(n*100-Math.round(n*100))>0.000001)throw new Error("Each nested stake needs a positive AUD amount with at most two decimals.");return Math.round(n*100);});if(tiers.some(function(n){return [4,6,8,9,10].indexOf(n)===-1;}))throw new Error("Nested box sizes must be 4, 6, 8, 9 or 10, in increasing order.");let p=RacePortfolio.nested(field,ids,tiers,amounts);portfolioText=JSON.stringify(portfolioFromSaved(field,p));portfolioMode=true;running=false;refreshPortfolio();}catch(e){portfolioError=String(e.message||e);}}

// Offline diagnostics have no path into the simulation accumulator or RNG.
var RaceDiagnostics=(function(){let market=null,marketReports=[],influence=null,annotations=null,blind=null,generation=0,pendingKey="";return {market:function(){return market;},setMarket:function(v){market=v;},reports:function(){return marketReports;},setReports:function(v){marketReports=v;},influence:function(){return influence;},setInfluence:function(v){influence=v;},annotations:function(){return annotations;},setAnnotations:function(v){annotations=v;},blind:function(){return blind;},setBlind:function(v){blind=v;},generation:function(){return generation;},queue:function(key){pendingKey=key;},pending:function(){return pendingKey!=="";},consume:function(){let key=pendingKey;pendingKey="";return key;},invalidate:function(){generation=generation+1;pendingKey="";return generation;}};})();
let leaderboardLabel="Running order";
let leaderboardNote="Illustrative positions · leading runners";
let marketFormat="json";
let marketText="";
let marketProvider="";
let marketSourceUrl="";
let marketObservedAt="";
let marketCurrency="AUD";
let marketType="WIN";
let marketNotes="";
let marketDeclaredComplete=true;
let marketSourceLabel="";
let marketSourceHref="";
let marketManualRows=[];
let marketJSONText="";
let marketError="";
let marketStatus="No market snapshot imported";
let marketSummary="No odds are bundled. Import a complete, timestamped WIN snapshot to compare.";
let marketAsOfText="Capture time unknown";
let marketMethodText="Proportional de-vig: (1 / decimal odds) divided by the sum of raw implied probabilities. A market proxy, not a known true chance.";
let marketCoverageText="No compatible complete WIN snapshot. WIN prices cannot establish actual trifecta dividends.";
let marketHistoryRows=[];
let selectedMarketId="";
let currentMarketSnapshotId="";
let marketVisible=true;
let comparisonSort="number";
let comparisonResearchChoice="pilot";
let comparisonHideShortlist=false;
let comparisonRows=[];
let comparisonScenarioText="";
let diagnosticsNotice="Diagnostics never blend prices into the model or change your shortlist, seed or sampled finish.";
let diagnosticsBusy=false;
let diagnosticsPending=false;
let expectedMoneyText="Expected monetary payout not estimable";
let biasRows=[];
let biasBandRows=[];
let biasSummary="Calculate the label audit to compare subjective adjustments across the full field.";
let ablationRows=[];
let annotationJSONText="";
let annotationStatus="Bundled annotations retain unknown annotator/cutoff times. They are subjective, not verified facts.";
let annotationDisputeRows=[];
let annotationError="";
let evidenceShowObserved=true;
let evidenceShowAnalyst=true;
let evidenceShowManual=true;
let blindReviewActive=false;
let blindRows=[];
let blindReviewerId="";
let blindAuthoredAt="";
let blindEvidenceCutoff="";
let blindPostOutcome=false;
let blindReviewMessage="Only cross-checked structured observations are shown. Unknown evidence is not a zero-start record.";
let diagnosticCalculatedAt="";
let diagnosticKey="";
let ablationKey="";
function diagnosticsKey(){return raceKey()+"|"+selectionText+"|"+portfolioMode+"|"+portfolioText+"|"+comparisonResearchChoice+"|"+currentMarketSnapshotId+"|"+marketVisible+"|"+comparisonHideShortlist;}
function marketOptions(){return {fieldSnapshotId:acceptedSnapshotId,eventId:"aus-flemington-2026-11-03-r7",asOf:new Date().toISOString(),cutoffTime:RaceResearch.metadata().race.scheduledLocal,maxAgeMinutes:60};}
function diagnosticSourceTimes(){let m=RaceDiagnostics.market();return {field:fieldOrigin==="official"?"2026-11-03T10:35:00+11:00":null,research:RaceResearch.metadata().asOf,market:m&&m.snapshot?m.snapshot.observedAt:null,analysis:diagnosticCalculatedAt||null};}
function marketDiagnosticsExport(){let m=refreshMarketStatus();return {method:"proportional_devig",autoModelBlend:false,marketSnapshotId:currentMarketSnapshotId||null,snapshot:m?m.snapshot:null,status:m?m.status:"not_imported",canCompare:m?m.canCompare:false,reviewedAt:m?m.asOf:null,freshnessPolicy:{maxAgeMinutes:60,cutoffTime:RaceResearch.metadata().race.scheduledLocal},flags:m?m.flags:[],rawImpliedTotal:m?m.rawImpliedTotal:null,overround:m?m.overround:null,probabilities:m?m.probabilities:[],derivedPL:"WIN-to-order approximation only; not observed trifecta odds or dividends",coverageText:marketCoverageText,expectedMonetaryPayout:null,expectedMonetaryPayoutStatus:"not_estimable",sourceAsOf:diagnosticSourceTimes(),comparisonRowsCurrent:diagnosticKey===diagnosticsKey()&&(!m||m.canCompare),comparisonRows:diagnosticKey===diagnosticsKey()&&(!m||m.canCompare)?comparisonRows:[],methodNotes:m?m.methodNotes:[]};}
function researchDiagnosticsExport(){return {annotationSnapshot:RaceDiagnostics.annotations(),influence:diagnosticKey===diagnosticsKey()?RaceDiagnostics.influence():null,ablationsCurrent:ablationKey===diagnosticsKey(),ablations:ablationKey===diagnosticsKey()?ablationRows:[],selectionAudit:"A selected/unselected label gap is a warning to investigate, not proof of causal or intentional bias",calibration:"not_established",annotationsAutomaticallyApplied:false};}
function refreshManualMarketRows(){let previous=marketManualRows;marketManualRows=field.map(function(h){let odds="";for(let i=0;i<previous.length;i=i+1)if(previous[i].id===h.id)odds=previous[i].odds;return {id:h.id,number:h.number,name:h.name,odds:odds,status:h.active===false?"withdrawn":"active"};});}
function updateManualOdds(id,value){marketManualRows=marketManualRows.map(function(r){if(r.id===id)r.odds=String(value);return r;});}
function marketMetadata(){return {schema:"racelab-market-snapshot-v1",eventId:"aus-flemington-2026-11-03-r7",marketType:marketType,oddsFormat:"decimal",currency:marketCurrency,provider:marketProvider,sourceUrl:marketSourceUrl,observedAt:marketObservedAt,fieldSnapshotId:acceptedSnapshotId,isCompleteField:marketDeclaredComplete,notes:marketNotes};}
function storeMarketReport(report){let reports=RaceDiagnostics.reports();let exists=false;for(let i=0;i<reports.length;i=i+1)if(reports[i].snapshotId===report.snapshotId)exists=true;if(!exists){db.create("market_snapshots",{snapshotId:report.snapshotId,snapshotJSON:JSON.stringify(report.snapshot)});reports.push(report);RaceDiagnostics.setReports(reports);}RaceDiagnostics.setMarket(report);selectedMarketId=report.snapshotId;currentMarketSnapshotId=report.snapshotId;invalidateDiagnostics();refreshMarketHistory();}
function refreshMarketHistory(){marketHistoryRows=RaceDiagnostics.reports().map(function(r){return {id:r.snapshotId,label:r.snapshot.provider+" · "+r.snapshot.observedAt,status:r.status};});}
function queueMarketDiagnostics(){RaceDiagnostics.queue(diagnosticsKey());diagnosticsPending=true;}
function runQueuedMarketDiagnostics(){let key=RaceDiagnostics.consume();diagnosticsPending=false;if(!key||key!==diagnosticsKey())return;refreshDiagnostics();}
function importMarket(){RaceDiagnostics.invalidate();try{let opts=marketOptions();let report=null;if(fieldIdentity(parseField())!==acceptedSnapshotId)throw new Error("Apply or cancel field edits before importing odds.");if(marketFormat==="json")report=RaceMarket.parseJSON(marketText,marketFieldInputs(),opts);else if(marketFormat==="csv")report=RaceMarket.parseCSV(marketText,marketMetadata(),marketFieldInputs(),opts);else if(marketFormat==="manual"){if(marketType==="TOTE_TRIFECTA")throw new Error("Ordered trifecta quotes require the JSON or CSV outcome schema.");let snapshot=marketMetadata();snapshot.quotes=marketManualRows.filter(function(r){return String(r.odds).trim()!=="";}).map(function(r){return {horseId:r.id,number:r.number,decimalOdds:Number(r.odds),status:r.status};});snapshot.isCompleteField=field.filter(function(h){return h.active!==false;}).every(function(h){return snapshot.quotes.some(function(q){return q.horseId===h.id&&q.status==="active";});});report=RaceMarket.prepare(snapshot,marketFieldInputs(),opts);}else throw new Error("Choose manual, CSV or JSON input.");storeMarketReport(report);marketError="";queueMarketDiagnostics();}catch(e){marketError=String(e.message||e);}}
function selectMarketSnapshot(){RaceDiagnostics.invalidate();try{let found=null;let reports=RaceDiagnostics.reports();for(let i=0;i<reports.length;i=i+1)if(reports[i].snapshotId===selectedMarketId)found=reports[i];if(!found)throw new Error("Select an existing market snapshot.");RaceDiagnostics.setMarket(found);currentMarketSnapshotId=found.snapshotId;invalidateDiagnostics();marketError="";queueMarketDiagnostics();}catch(e){marketError=String(e.message||e);}}
function prepareMarketJSON(){let m=RaceDiagnostics.market();if(!m){marketError="Import a market snapshot first.";return;}marketJSONText=JSON.stringify(m.snapshot,null,2);marketError="";}
function saveMarketJSON(){prepareMarketJSON();if(!marketJSONText||marketError)return;try{softn.files.saveFile("racelab-market-snapshot.json",marketJSONText,{mime:"application/json"},function(r){if(r&&r.error)marketError=String(r.error);});}catch(e){marketError="File export is unavailable here; copy the JSON instead.";}}
function pickMarketJSON(){let generation=RaceDiagnostics.invalidate();let startingText=marketText;let startingField=acceptedSnapshotId;let startingDraft=marketDraftToken();try{softn.files.pickFile({accept:".json,application/json"},function(files){if(generation!==RaceDiagnostics.generation())return;if(files&&files.error){marketError=String(files.error);return;}if(!files||!files.length)return;if(files[0].size>200000){marketError="Market JSON is limited to 200,000 bytes.";return;}softn.files.readText(files[0].ref,function(content){if(generation!==RaceDiagnostics.generation())return;if(marketText!==startingText||acceptedSnapshotId!==startingField||marketDraftToken()!==startingDraft){marketError="Market import cancelled because the draft or field changed.";return;}if(typeof content!=="string"){marketError="Could not read market JSON.";return;}marketText=content;marketFormat="json";importMarket();});});}catch(e){marketError="File picking is unavailable here; paste JSON instead.";}}
function diagnosticPortfolio(){if(portfolioMode)return preparedPortfolio(field);let ids=selectedIdsFor(selectionText,field);return RacePortfolio.prepare(field,{tickets:ids.length>=3?[{id:"quick",name:"Quick box",type:"box",selection:ids,stakeCents:Math.max(1,Math.round(Number(stake)*100))}]:[]});}
function diagnosticSelectedIds(){let ids=[];if(portfolioMode){let p=preparedPortfolio(field);p.tickets.forEach(function(t){t.selection.forEach(function(id){if(ids.indexOf(id)===-1)ids.push(id);});});}else ids=selectedIdsFor(selectionText,field);return ids;}
function diagnosticResearchSettings(){return comparisonResearchChoice==="current"?RaceModels.normalizeSettings({preset:"research_sensitivity",ratingDivisor:Number(ratingScale),tripScale:Number(tripScale),recencyScale:Number(recencyScale),softScale:Number(softScale),maxAbsLogAdjustment:Number(researchClamp)}):RaceModels.pilotSettings();}
function findForecast(rows,id){for(let i=0;i<rows.length;i=i+1)if(rows[i].id===id)return rows[i];return null;}
function percentText(p){return p==null?"Unknown":(p*100).toFixed(3)+"%";}
function refreshMarketStatus(){let old=RaceDiagnostics.market();if(!old){marketStatus="No market snapshot imported";return null;}let report=null;try{report=RaceMarket.prepare(old.snapshot,marketFieldInputs(),marketOptions());}catch(e){report={snapshot:old.snapshot,snapshotId:old.snapshotId,status:"unavailable",canCompare:false,flags:[{code:"unavailable",message:String(e.message||e)}],probabilities:[],rawImpliedTotal:null,overround:null,asOf:new Date().toISOString(),maxAgeMinutes:60,methodNotes:old.methodNotes||[]};comparisonRows=[];diagnosticKey="";marketCoverageText="Market comparison unavailable; raw snapshot retained in local history.";}RaceDiagnostics.setMarket(report);marketStatus=String(report.status);marketSourceLabel=report.snapshot.provider;marketSourceHref=report.snapshot.sourceUrl;marketAsOfText="Captured "+report.snapshot.observedAt+" · reviewed "+report.asOf;marketSummary=report.canCompare?"Raw implied total "+percentText(report.rawImpliedTotal)+" · overround "+percentText(report.overround)+" · normalized WIN total 100%.":"Comparison unavailable: "+report.flags.map(function(f){return f.message;}).join(" · ");return report;}

function refreshDiagnostics(){try{if(ablationKey!==diagnosticsKey())ablationRows=[];comparisonRows=[];biasRows=[];biasBandRows=[];diagnosticKey="";diagnosticsBusy=true;let sc=currentScenario();let original=RaceModels.prepare(field,sc,RaceModels.defaults());let researchSettings=diagnosticResearchSettings();let researchScenario={going:sc.going,pace:sc.pace,barrierImpact:sc.barrierImpact,historyMode:"off"};let research=RaceModels.prepare(field,researchScenario,researchSettings);let baseForecast=RaceSim.exactForecast(original.field,original.scenario);let researchForecast=RaceSim.exactForecast(research.field,research.scenario);let selected=diagnosticSelectedIds();let report=refreshMarketStatus();let marketForecast=[];let p=diagnosticPortfolio();marketCoverageText="No compatible complete WIN snapshot. WIN prices cannot establish actual trifecta dividends.";if(report&&report.canCompare){let market=RaceMarket.marketField(report,marketFieldInputs());marketForecast=RaceSim.exactForecast(market.field,market.scenario);if(p.tickets.length){let coverageReport=RacePortfolio.analyse(market.field,market.scenario,p);marketCoverageText="Market-implied PL approximation: any ticket covers "+percentText(coverageReport.summary.any)+"; two or more "+percentText(coverageReport.summary.twoOrMore)+". Not an observed trifecta market or dividend.";}else marketCoverageText="Market-implied PL ordering is an approximation. Add a complete ticket to compare coverage; no dividend is inferred.";}
  comparisonRows=field.filter(function(h){return h.active!==false;}).map(function(h){let b=findForecast(baseForecast,h.id);let r=findForecast(researchForecast,h.id);let m=findForecast(marketForecast,h.id);let q=null;if(report)for(let j=0;j<report.probabilities.length;j=j+1)if(report.probabilities[j].horseId===h.id)q=report.probabilities[j];let c=null;for(let k=0;k<research.contributions.length;k=k+1)if(research.contributions[k].id===h.id)c=research.contributions[k];let gap=m?r.winProbability-m.winProbability:null;return {id:h.id,number:h.number,name:h.name,selected:!comparisonHideShortlist&&selected.indexOf(h.id)!==-1,baselineText:percentText(b.winProbability),researchText:percentText(r.winProbability),marketText:marketVisible&&m?percentText(m.winProbability):"Unavailable",baselineTop3Text:percentText(b.top3Probability),researchTop3Text:percentText(r.top3Probability),marketTop3Text:marketVisible&&m?percentText(m.top3Probability)+" · PL approximation":"Unavailable",oddsText:marketVisible&&q?String(q.decimalOdds):"Unknown",deltaText:marketVisible&&gap!=null?(gap>=0?"+":"")+(gap*100).toFixed(3)+" pp":"Unknown",baselineWidth:(b.winProbability*100)+"%",researchWidth:(r.winProbability*100)+"%",marketWidth:((marketVisible&&m?m.winProbability*100:0)+"%"),baselineProbability:b.winProbability,researchProbability:r.winProbability,marketProbability:m?m.winProbability:null,gap:gap,explanation:"Baseline strength "+h.strength+"; research multiplier "+c.research.multiplier.toFixed(5)+"; drawn barrier "+h.barrier+" / effective gate "+c.effectiveGate+". "+(comparisonHideShortlist?"Shortlist membership does not change strengths. ":selected.indexOf(h.id)===-1?"Outside the current subjective shortlist; no selection-based penalty is applied. ":"Shortlist membership does not change strengths. ")+"Market disagreement does not establish which estimate is right.",missingText:"No fitted weight, jockey, trainer or joint race-traffic effect. "+(c.research.eligible?"Research labels remain subjective.":"Research scoring ineligible for changed or unmatched core fields."),sourceUrl:q&&report?report.snapshot.sourceUrl:"",sourceLabel:q&&report?report.snapshot.provider:""};});
  comparisonRows.sort(function(a,b){if(comparisonSort==="baseline")return b.baselineProbability-a.baselineProbability||a.number-b.number;if(comparisonSort==="research")return b.researchProbability-a.researchProbability||a.number-b.number;if(comparisonSort==="market")return (b.marketProbability||0)-(a.marketProbability||0)||a.number-b.number;if(comparisonSort==="gap")return Math.abs(b.gap||0)-Math.abs(a.gap||0)||a.number-b.number;return a.number-b.number;});
  comparisonScenarioText="Original baseline: divisor 8, "+going+", "+historyMode+" history / "+barrierMode+" barrier. Research comparator: "+(comparisonResearchChoice==="pilot"?"illustrative pilot 0.06 / 0.04 / 0.02":"current research coefficients")+", history OFF; "+research.modelIdentity+". These controls change diagnostics only.";
  let influence=RaceResearchAudit.influence(field,researchScenario,researchSettings,selected);RaceDiagnostics.setInfluence(influence);presentBias(influence);diagnosticCalculatedAt=new Date().toISOString();diagnosticKey=diagnosticsKey();if(hasResult&&resultKey===dataKey())buildResultsExport();marketError="";diagnosticsBusy=false;
}catch(e){marketError=String(e.message||e);diagnosticsBusy=false;}}
function initDiagnostics(){refreshManualMarketRows();try{let records=db.query("market_snapshots");let reports=[];for(let i=0;i<records.length;i=i+1){try{reports.push(RaceMarket.parseJSON(records[i].data.snapshotJSON,marketFieldInputs(),marketOptions()));}catch(e){}}RaceDiagnostics.setReports(reports);refreshMarketHistory();}catch(e){marketError="Local market history is unavailable; imports and JSON export still work.";}try{refreshAnnotationReviews(null);}catch(e){annotationError=String(e.message||e);} }

function marketFieldInputs(){return raceHorseEnvelope(field).horses;}
function auditNumber(value){return value==null?"Unknown":(value>=0?"+":"")+value.toFixed(4);}
function presentBias(report){let groups=[{id:"selected",label:"Selected",data:report.overall.selected},{id:"unselected",label:"Unselected",data:report.overall.unselected}];biasRows=[];groups.forEach(function(g){["tripFeature","recencyFeature","softFeature","logAdjustment"].forEach(function(metric){let s=g.data.metrics[metric];biasRows.push({id:g.id+metric,label:g.label+" · "+metric,count:g.data.count,meanText:auditNumber(s.mean),medianText:auditNumber(s.median)});});});biasSummary="Selected mean log adjustment "+auditNumber(report.overall.selected.meanLogAdjustment)+" versus "+auditNumber(report.overall.unselected.meanLogAdjustment)+"; selected minus unselected "+auditNumber(report.overall.meanLogDifference)+". This descriptive difference can reflect shared selection/annotation opinions; it does not prove causal bias or better predictions.";biasBandRows=[];report.byRatingBand.concat(report.byStatus).forEach(function(g){let s=g.summary;biasBandRows.push({id:g.id,label:g.id,count:s.selected.count+s.unselected.count,meanText:"Selected "+auditNumber(s.selected.meanLogAdjustment),medianText:"Other "+auditNumber(s.unselected.meanLogAdjustment),gapText:auditNumber(s.meanLogDifference)});});}
function runResearchAblations(){try{diagnosticsBusy=true;let sc=currentScenario();sc.historyMode="off";let report=RaceResearchAudit.ablations(field,sc,diagnosticResearchSettings(),diagnosticPortfolio());ablationRows=report.variants.map(function(v){let changes=v.forecasts.filter(function(f){return f.rankChangeVsBase!==0;}).sort(function(a,b){return Math.abs(b.rankChangeVsBase)-Math.abs(a.rankChangeVsBase)||a.rank-b.rank;}).slice(0,5).map(function(f){return horseName(f.id)+" "+(f.rankChangeVsBase>0?"+":"")+f.rankChangeVsBase;});return {id:v.key,label:v.key,leader:horseName(v.forecasts[0].id)+" · "+percentText(v.forecasts[0].winProbability),rankChangeText:changes.length?changes.join(" · "):"No rank changes versus base",coverageText:percentText(v.anyTicketCoverage),ticketText:v.ticketCoverage.map(function(t){return t.name+": "+percentText(t.probability);}).join(" · ")||"No complete tickets",fullFieldForecasts:v.forecasts,modelIdentity:v.modelIdentity};});ablationKey=diagnosticsKey();diagnosticCalculatedAt=new Date().toISOString();diagnosticsBusy=false;if(hasResult&&resultKey===dataKey())buildResultsExport();}catch(e){marketError=String(e.message||e);diagnosticsBusy=false;}}
function presentAnnotations(report){let d=report.dataset;let eligible=report.statuses.filter(function(s){return s.eligibleForPreRaceValidation;}).length;annotationStatus=d.annotations.length+" source-attributed opinions; "+eligible+" independently eligible pre-race labels. No imported label is automatically applied or independently verified."+(report.historyNotice?" "+report.historyNotice:"");annotationDisputeRows=report.disagreements.map(function(g,j){return {id:String(j),text:(g.horseId||g.blindId)+" · "+g.feature+": "+g.labels.join(" / ")+" · "+g.declaredAnnotatorCount+" declared reviewers (independence unverified). "+g.aggregationRule};});}
function annotationContentKey(a){let copy=JSON.parse(JSON.stringify(a));delete copy.id;return RaceSnapshots.canonical(copy);}
function mergedAnnotationReport(extra){let datasets=[RaceAnnotationData];let ignored=0;let target=RaceResearch.metadata().race.scheduledLocal;let records=db.query("research_reviews");for(let i=0;i<records.length;i=i+1){try{let d=RaceResearchAudit.validateAnnotations(JSON.parse(records[i].data.snapshotJSON)).dataset;if(d.targetTime!=null&&Date.parse(d.targetTime)!==Date.parse(target)){ignored=ignored+1;}else datasets.push(d);}catch(e){ignored=ignored+1;}}if(extra){if(extra.targetTime!=null&&Date.parse(extra.targetTime)!==Date.parse(target))throw new Error("The annotation target event differs from the current Cup.");datasets.push(extra);}let rows=[];let unique={};datasets.forEach(function(d){d.annotations.forEach(function(a){let key="$"+annotationContentKey(a);if(!Object.prototype.hasOwnProperty.call(unique,key))unique[key]=a;});});let contentKeys=Object.keys(unique);if(contentKeys.length>600)throw new Error("This import would exceed the combined 600-opinion limit. Nothing was saved; original reviews remain unchanged.");contentKeys.sort();contentKeys.forEach(function(key,i){let copy=JSON.parse(JSON.stringify(unique[key]));copy.id="merged-opinion-"+(i+1);rows.push(copy);});if(rows.length>600)throw new Error("This import would exceed the combined 600-opinion limit. Nothing was saved; original reviews remain unchanged.");let combined=RaceResearchAudit.validateAnnotations({schema:"racelab-research-annotations-v2",datasetId:"local-independent-reviews",targetTime:target,annotations:rows,provenance:{kind:"legacy-and-independent-reviews",sourceSnapshotId:null,sourceSha256:null,asOfClaim:null},limitations:["Original review files are retained separately. Opinions are deduplicated by full content excluding generated IDs, with no averaging or automatic model application."]});combined.historyNotice=ignored?ignored+" incompatible or invalid stored review datasets were excluded from this view and retained locally.":"";return combined;}
function storeAnnotations(report){let combined=mergedAnnotationReport(report.dataset);let text=JSON.stringify(report.dataset);let records=db.query("research_reviews");let found=false;for(let i=0;i<records.length;i=i+1)if(records[i].data.snapshotJSON===text)found=true;if(!found)db.create("research_reviews",{snapshotId:"local-review-"+Date.now()+"-"+records.length,snapshotJSON:text});RaceDiagnostics.setAnnotations(combined);presentAnnotations(combined);if(hasResult&&resultKey===dataKey())buildResultsExport();}

function refreshAnnotationReviews(extra){let combined=mergedAnnotationReport(extra);RaceDiagnostics.setAnnotations(combined);presentAnnotations(combined);}

function importAnnotations(){try{if(typeof annotationJSONText!=="string"||annotationJSONText.length>300000)throw new Error("Annotation JSON is limited to 300,000 characters.");let raw=JSON.parse(annotationJSONText);let report=RaceResearchAudit.validateAnnotations(raw,{field:marketFieldInputs()});if(report.dataset.targetTime!=null&&Date.parse(report.dataset.targetTime)!==Date.parse(RaceResearch.metadata().race.scheduledLocal))throw new Error("Annotation target event does not match the current Cup.");storeAnnotations(report);annotationError="";}catch(e){annotationError=String(e.message||e);}}
function prepareAnnotationsJSON(){let a=RaceDiagnostics.annotations();if(!a){annotationError="No annotation dataset is available.";return;}annotationJSONText=JSON.stringify(a.dataset,null,2);annotationError="";}
function enterBlindReview(){try{running=false;pendingAction="";RaceDiagnostics.invalidate();let pack=RaceResearchAudit.blindPack(field,RaceResearch.metadata().race.scheduledLocal,"review-"+Date.now()+"-"+Math.random());pack.fieldSnapshotId=acceptedSnapshotId;RaceDiagnostics.setBlind(pack);blindRows=pack.rows.map(function(row){return {id:row.id,factsText:row.observations.length?row.observations.map(function(o){return o.raceDate+" · flat "+(o.distanceM==null?"unknown distance":o.distanceM+"m")+" · "+(o.finishPosition==null?"unknown placing":o.finishPosition)+"/"+(o.starterCount==null?"unknown field size":o.starterCount)+" · ground "+o.goingCategory;}).join("; "):"No cross-checked structured observations available",missingText:"Unverified prose, names, odds and shortlist are excluded. Missing records do not establish zero attempts.",trip:"",recency:"",surface:"",rationale:"",uncertainty:""};});blindReviewActive=true;blindReviewMessage="Opaque IDs hide the surrounding identities. Structured form can still permit re-identification. Keep scores unassigned when evidence is absent.";}catch(e){annotationError=String(e.message||e);}}
function exitBlindReview(){blindReviewActive=false;RaceDiagnostics.setBlind(null);blindRows=[];}
function updateBlindScore(id,key,value){if(["trip","recency","surface","rationale","uncertainty"].indexOf(key)===-1)return;blindRows=blindRows.map(function(row){if(row.id===id)row[key]=String(value);return row;});}
function saveBlindReview(){try{let pack=RaceDiagnostics.blind();if(!pack||pack.fieldSnapshotId!==acceptedSnapshotId)throw new Error("The field changed; start a new blind review.");if(!String(blindReviewerId).trim())throw new Error("Enter a reviewer ID so independent opinions remain separate.");let rows=blindRows.map(function(r){return {id:r.id,flatStaminaEvidence:r.trip,recentFormDirection:r.recency,surfaceEvidence:r.surface,rationale:r.rationale,uncertainty:r.uncertainty};});let report=RaceResearchAudit.makeAnnotations(rows,pack.identityKey,{datasetId:"blind-review-"+Date.now(),targetTime:pack.targetTime,annotatorId:blindReviewerId,authoredAt:blindAuthoredAt.trim()||null,evidenceCutoff:blindEvidenceCutoff.trim()||null,sourceRefs:[],post_outcome_review:blindPostOutcome});storeAnnotations(report);blindReviewMessage=report.dataset.annotations.length+" unverified opinions saved locally. Names can be resolved in the second pass after leaving blind review. Nothing was applied to the model.";}catch(e){blindReviewMessage=String(e.message||e);}}
function invalidateDiagnostics(){checkBoxFreshness();comparisonRows=[];biasRows=[];biasBandRows=[];ablationRows=[];diagnosticKey="";ablationKey="";RaceDiagnostics.setInfluence(null);marketCoverageText="Recalculate diagnostics for the current field and tickets. WIN prices never establish a trifecta dividend.";refreshManualMarketRows();try{refreshMarketStatus();}catch(e){marketStatus="Snapshot incompatible or unavailable";marketSummary=String(e.message||e);} }
function checkDiagnosticsFreshness(){if(diagnosticKey&&diagnosticKey!==diagnosticsKey()){invalidateDiagnostics();return;}let report=RaceDiagnostics.market();if(report&&Date.now()-Date.parse(report.asOf)>60000){let fresh=refreshMarketStatus();if(!fresh.canCompare){comparisonRows=[];diagnosticKey="";marketCoverageText="Snapshot no longer comparable: "+fresh.status;}if(hasResult&&resultKey===dataKey())buildResultsExport();}}

function marketDraftToken(){return JSON.stringify({format:marketFormat,text:marketText,provider:marketProvider,url:marketSourceUrl,observed:marketObservedAt,currency:marketCurrency,type:marketType,notes:marketNotes,complete:marketDeclaredComplete,manual:marketManualRows,fieldText:fieldText,selectedSnapshot:selectedMarketId});}

// Race-day updates are immutable metadata overlays; the original field and
// research fixtures continue to identify older replay inputs.
let raceDayTrack="Soft 5";
let raceDayTrackAsOf="6:00 am track inspection · 3 Nov 2026 AEDT";
let raceDayTrackUrl="https://www.racingaustralia.horse/FreeFields/Form.aspx?Key=2026Nov03%2CVIC%2CFlemington";
let raceDayFieldAsOf="23 active runners · #9 Asterix scratched at 10:33 am; report published 10:35 am · 3 Nov AEDT";
let raceDayFieldUrl="https://www.racingaustralia.horse/FreeFields/Form.aspx?Key=2026Nov03%2CVIC%2CFlemington";
let raceDayScratchUrl="https://www.racingaustralia.horse/FreeFields/Scratchings.aspx?Key=2026Nov03%2CVIC%2CFlemington";
let raceDayForecast="Maximum 17°C · 40% chance of rain · 0–1 mm · BOM forecast issued 11:32 am AEDT, 3 Nov";
let raceDayWeatherUrl="https://www.bom.gov.au/places/vic/flemington/forecast/";
let raceDayConflict="At 12:41 pm AEDT on 3 Nov, indexed third-party listings showed Good 4, while Racing Australia still displayed Soft 5 from its 6:00 am inspection. The apparent upgrade and its time could not be verified. Neither figure is a live feed here.";
let raceDayThirdPartyUrl="https://bet365.racingandsports.com.au/meeting/7/475328?rs=469224";
let raceDayTabtouchUrl="https://www.tabtouch.com.au/racing/2026-11-03/mr/7";
let raceDayWarning="Default history uses the supplied Racing Australia reconciliation, with verified jumps removed from career and going counts for #2, #5, #10, #13 and #19. Career totals include synthetic flat starts; distance buckets and last-10 strings may have broader scope and are not used by the model. Older replays retain their own histories. Soft 5 maps to the initial broad Soft scenario; your selected Going setting takes precedence. Weather is not a fitted model input. Check later scratchings and track updates.";
// Manual going evidence is user-supplied metadata, never a verified live rating
// and never a model coefficient. The session log is included in results export.
var GoingEvidence=(function(){
  let events=[{scenario:"soft",selectedAt:null,kind:"bundled-default",sourceNote:"Racing Australia Soft 5, 6:00 am inspection; offline snapshot",sourceUrl:raceDayTrackUrl,sourceRecordedAt:null}],dropped=0;
  return {latest:function(){return events.length?events[events.length-1]:null;},add:function(scenario,kind){let item={scenario:scenario,selectedAt:new Date().toISOString(),kind:kind,sourceNote:"",sourceUrl:"",sourceRecordedAt:null};events.push(item);if(events.length>100){events.shift();dropped=dropped+1;}return item;},edit:function(scenario,note,url){let item=events.length?events[events.length-1]:null;if(!item||item.scenario!==scenario)item=this.add(scenario,"manual-source");item.sourceNote=String(note||"").slice(0,500);item.sourceUrl=String(url||"").slice(0,1000);item.sourceRecordedAt=new Date().toISOString();},snapshot:function(scenario){let last=events.length?events[events.length-1]:null;return {currentScenario:scenario,currentAttribution:last&&last.scenario===scenario?JSON.parse(JSON.stringify(last)):null,events:JSON.parse(JSON.stringify(events)),earlierEventsDropped:dropped,scope:"This session only; source notes are user supplied and not independently verified. Export results to retain them."};}};
})();
let goingSourceNote="";
let goingSourceUrl="";
function recordGoingSelection(){let previous=GoingEvidence.latest();if(!previous||previous.scenario!==going){GoingEvidence.add(going,"manual-selection");goingSourceNote="";goingSourceUrl="";}refreshScenarioAssumptions();}
function recordGoingRestored(){GoingEvidence.add(going,"restored-unverified");goingSourceNote="";goingSourceUrl="";}
function recordGoingSource(){GoingEvidence.edit(going,goingSourceNote,goingSourceUrl);if(hasResult&&resultKey===dataKey()&&exportJson)buildResultsExport();}
function goingEvidenceExport(){return GoingEvidence.snapshot(going);}
function todayFieldOverlay(base){
  let out=JSON.parse(JSON.stringify(base));
  if(out.length!==RaceDayFieldData.runners.length||out.length!==RaceDayHistoryData.horses.length)throw new Error("Race-day field and baseline runner counts disagree.");
  for(let i=0;i<out.length;i=i+1){
    let h=out[i];let match=null;let current=null;
    for(let j=0;j<RaceDayFieldData.runners.length;j=j+1)if(RaceDayFieldData.runners[j].number===h.number)match=RaceDayFieldData.runners[j];
    for(let k=0;k<RaceDayHistoryData.horses.length;k=k+1)if(RaceDayHistoryData.horses[k].number===h.number)current=RaceDayHistoryData.horses[k];
    if(!match||match.id!==h.id||match.name!==h.name||match.barrier!==h.barrier||match.weightKg!==h.weight||!current||current.id!==h.id||current.name!==h.name||current.barrier!==h.barrier||current.weight!==h.weight)throw new Error("Race-day card differs from baseline for #"+h.number+". Review the field before running.");
    h.trainer=match.trainer;h.jockey=match.jockey;h.history=JSON.parse(JSON.stringify(current.history));h.active=current.active;
    h.source=current.history.source;h.snapshot="2026-11-03";
    h.provenance="Racing & Sports analyst rating retained from earlier fixture. Historical counts: supplied Racing Australia All Form reconciliation, with verified jumps removed from career and going for five horses; small samples, not calibrated predictions.";
    h.notes="Career and going data are pre-race research aggregates; career includes synthetic flat starts. Distance buckets and last-10 strings may include jumping or have provider-defined scope; they are not used by the model.";
  }
  return out;
}

// Search handles and lifecycle remain private so stale UI snapshots cannot
// restart a finished job or replace the sampled race with a different draw.
var RaceBoxWork=(function(){let study="",job="",phase="idle",sourceKey="",seed="",trials=0,key="",pending=false,result=null;return {
  state:function(){return {study:study,job:job,phase:phase,sourceKey:sourceKey,seed:seed,trials:trials,key:key,pending:pending,result:result};},
  clearSearch:function(){if(job)RaceSim.cancelBoxSearch(job);job="";phase="idle";key="";result=null;pending=false;},
  clearStudy:function(){if(job)RaceSim.cancelBoxSearch(job);if(study)RaceSim.deleteBoxStudy(study);study="";job="";phase="idle";key="";sourceKey="";seed="";trials=0;result=null;pending=false;},
  capture:function(id,race,code,n){study=id||"";sourceKey=race;seed=code;trials=n;},
  start:function(id,k){job=id;phase="running";key=k;result=null;pending=false;},
  finish:function(v){job="";phase="finished";result=v;pending=false;},
  queue:function(){pending=true;},consume:function(){let v=pending;pending=false;return v;}
};})();
let boxSize="4";
let boxCount="6";
let boxSuggestionsText="";
let boxNumbersText="";
let boxCandidateText="";
let boxTopRows=[];
let boxDiversifiedRows=[];
let boxStatus="Run a batch, then calculate boxes from its sampled top-three finishes.";
let boxPoolText="";
let boxDiverseStatus="";
let boxBusy=false;
let boxError="";
function currentBoxKey(){return raceKey()+"|"+String(trials)+"|"+String(boxSize)+"|"+String(boxCount)+"|"+String(boxCandidateText);}
function resetBoxWork(dropStudy){clearBoxCollection();if(dropStudy)RaceBoxWork.clearStudy();else RaceBoxWork.clearSearch();boxBusy=false;boxTopRows=[];boxDiversifiedRows=[];boxPoolText="";boxDiverseStatus="";boxSuggestionsText="";boxNumbersText="";boxError="";boxStatus=dropStudy?"Run a batch, then calculate boxes from its sampled top-three finishes.":"Box search cancelled. Your simulated race is unchanged.";if(exportJson&&hasResult&&resultKey===dataKey())buildResultsExport();}
function captureBoxStudy(result,sourceKey,seed,n){let id=result.boxStudyId||"";let failure=result.boxStudyError||(!id?"The simulation did not return a box study.":"");delete result.boxStudyId;delete result.boxStudyError;RaceBoxWork.capture(id,sourceKey,seed,n);if(failure){boxError="The batch completed, but its optional box study is unavailable: "+failure;boxStatus="The race and other results are still available.";}else boxStatus="Batch ready. Calculate boxes from "+n.toLocaleString()+" sampled races.";}
function cancelBoxSuggestions(){resetBoxWork(false);}
function checkBoxFreshness(){let state=RaceBoxWork.state();
// A completed trial batch owns its study while the optional sensitivity phase
// is still running. A watchdog tick must not mistake this for an orphaned
// study merely because finishCalculation has not published hasResult yet.
let lifecycle=RaceBatchLifecycle.snapshot();
let completing=lifecycle.phase==="sensitivity" && analysisContext && analysisKey===dataKey() && state.sourceKey===analysisContext.raceKey && state.seed===analysisContext.seed && state.trials===lifecycle.target;
if(state.study && (state.sourceKey!==raceKey()||state.trials!==Number(trials)||(!hasResult&&!completing))){resetBoxWork(true);return;}
if((state.phase==="running"||state.phase==="finished")&&state.key!==currentBoxKey())resetBoxWork(false);}
function boxChoose(n,k){let v=1;for(let i=1;i<=k;i=i+1)v=v*(n-i+1)/i;return Math.round(v);}
function startBoxSearch(){try{let state=RaceBoxWork.state();if(!state.study)throw new Error(boxError||"The optional box study is unavailable. Run the batch again.");if(!hasResult||state.sourceKey!==raceKey()||state.trials!==Number(trials)||state.seed!==replaySeed)throw new Error("The race inputs changed. Run the current scenario before calculating boxes.");let size=Number(boxSize);if(!Number.isInteger(size)||size<3||size>10)throw new Error("Choose a box size from 3 to 10.");let candidates=String(boxCandidateText).trim()?selectedIdsFor(boxCandidateText,field):null;let poolSize=candidates?candidates.length:(size===3?activeRunnerCount:Math.min(12,activeRunnerCount));if((candidates&&poolSize>12)||poolSize<size)throw new Error("Choose at most 12 active candidates and at least as many as the box size.");let count=Number(boxCount);if(!Number.isInteger(count)||count<1||count>25)throw new Error("Choose a whole number of boxes from 1 to 25.");let possible=boxChoose(poolSize,size);if(count>possible)throw new Error("Only "+possible+" distinct boxes fit this candidate pool and box size. Choose fewer or expand the pool.");resetBoxWork(false);let id=RaceSim.createBoxSearch(state.study,candidates,[size],10,{portfolioSize:size,portfolioCount:count});RaceBoxWork.start(id,currentBoxKey());boxBusy=true;boxError="";boxTopRows=[];boxDiversifiedRows=[];boxPoolText="";boxDiverseStatus="";boxSuggestionsText="";boxNumbersText="";boxStatus="Calculating within the candidate pool…";}catch(e){boxBusy=false;boxError=String(e.message||e);}}
function calculateBoxSuggestions(){try{checkBoxFreshness();syncAnalysisState();let state=RaceBoxWork.state();if(analysisRunning||!hasResult||!state.study||state.sourceKey!==raceKey()||state.trials!==Number(trials)){if(!analysisRunning&&hasResult&&!state.study&&sampleRaceKey===raceKey()&&batchResult&&batchResult.trials===Number(trials))calculateRace(replaySeed,true);else ensureCurrentSample();syncAnalysisState();if(analysisRunning){RaceBoxWork.queue();boxBusy=false;boxStatus="Running the selected simulation batch first; box search will follow.";boxError="";return;}if(!hasResult||!RaceBoxWork.state().study){boxError=error?"Could not prepare the box study: "+error:(boxError||"The box study is unavailable. Run a new simulation and try again.");return;}}startBoxSearch();}catch(e){boxError=String(e.message||e);boxBusy=false;}}
function runQueuedBoxSearch(){if(RaceBoxWork.consume())startBoxSearch();}
function boxNumberText(ids){let nums=[];ids.forEach(function(id){for(let i=0;i<field.length;i=i+1)if(field[i].id===id)nums.push(field[i].number);});return nums.sort(function(a,b){return a-b;}).join(", ");}
function boxNames(ids){let rows=ids.map(function(id){let number=0;for(let i=0;i<field.length;i=i+1)if(field[i].id===id)number=field[i].number;return {number:number,label:horseName(id)};});rows.sort(function(a,b){return a.number-b.number;});return rows.map(function(r){return r.label;}).join(" · ");}
function boxPct(x){return (x*100).toFixed(4)+"%";}
function stepBoxSearch(){let s=RaceBoxWork.state();if(s.phase!=="running"){boxBusy=false;return;}boxBusy=true;if(s.key!==currentBoxKey()||s.sourceKey!==raceKey()||s.trials!==Number(trials)||!hasResult){resetBoxWork(false);boxStatus="Box inputs changed. Calculate again for the current scenario.";return;}try{let progress=RaceSim.advanceBoxSearch(s.job,50);boxStatus="Checked "+progress.evaluated.toLocaleString()+" of "+progress.total.toLocaleString()+" candidate steps · "+(progress.phase==="portfolio"?"diversifying boxes":"ranking boxes")+".";if(!progress.done)return;let report=RaceSim.finalizeBoxSearch(s.job);RaceBoxWork.finish(report);boxBusy=false;initializeBoxCollection();boxPoolText=report.candidateIds.length+" of "+report.fieldSize+" active runners: "+boxNames(report.candidateIds)+". "+(report.candidateSelection==="user-selected"?"User-selected pool.":report.candidateSelection==="all active runners"?"All active runners included.":"Pool chosen by simulated top-three frequency.");boxTopRows=report.groups[0].boxes.map(function(b,i){return {id:"best-"+i,rank:i+1,selectionText:boxNumberText(b.selection),runnersText:boxNames(b.selection),exactText:boxPct(b.exactProbability),sampledText:boxPct(b.frequency),hitText:b.hits.toLocaleString()+" / "+report.trials.toLocaleString(),combinationText:RaceSim.combinations(b.selection.length).toLocaleString()+" ordered outcomes"};});boxDiversifiedRows=report.portfolio.map(function(b,i){return {id:"div-"+i,rank:i+1,selectionText:boxNumberText(b.selection),runnersText:boxNames(b.selection),exactText:boxPct(b.exactProbability),sampledText:boxPct(b.frequency),marginalText:boxPct(b.marginalFrequency)+" simulated · "+boxPct(b.marginalExactProbability)+" exact model",unionText:boxPct(b.unionFrequency)+" simulated · "+boxPct(b.unionExactProbability)+" exact model"};});boxNumbersText=boxDiversifiedRows.map(function(b){return b.selectionText;}).join("\n");boxDiverseStatus=report.portfolio.length+" distinct boxes · "+(report.selectionStrategy==="exact-three"?"highest exact-model probability, disjoint three-horse sets: ":"greedy sampled-coverage set: ")+boxPct(report.portfolioUnion.frequency)+" simulated / "+boxPct(report.portfolioUnion.exactProbability)+" exact-model union coverage. "+(report.selectionStrategy==="exact-three"?"Exact optimum within the stated candidate pool; model assumptions are uncalibrated.":"Overlap is counted once; the set is not guaranteed globally optimal.");boxSuggestionsText="RaceLab boxed trifectas · "+report.portfolio.length+" boxes of "+boxSize+" horses · each line is an unordered box, not one ordered outcome.\n"+boxDiversifiedRows.map(function(b){return b.rank+". "+b.selectionText+" — "+b.runnersText+" — additional coverage "+b.marginalText+" — cumulative "+b.unionText;}).join("\n")+"\n"+boxDiverseStatus;boxStatus="Ranked "+report.rankEvaluated.toLocaleString()+" boxes "+(report.selectionStrategy==="exact-three"?"by exact model probability; sampled frequencies are diagnostic":"using "+report.trials.toLocaleString()+" simulated races")+". Results are conditional on the model and candidate pool.";if(hasResult&&resultKey===dataKey())buildResultsExport();}catch(e){RaceBoxWork.clearSearch();boxBusy=false;boxError="Box search unavailable: "+String(e.message||e);boxStatus="The completed simulation and race result remain available.";}}
function lookupSuggested(id){let result=RaceBoxWork.state().result;if(!result||RaceBoxWork.state().key!==currentBoxKey())throw new Error("Calculate current suggestions first.");let parts=String(id).split("-");let index=Number(parts[1]);let entries=parts[0]==="best"?result.groups[0].boxes:parts[0]==="div"?result.portfolio:[];if(!Number.isInteger(index)||index<0||index>=entries.length)throw new Error("Suggestion unavailable.");return entries[index];}
function applySuggestedBox(id){try{let row=lookupSuggested(id);selectionText=boxNumberText(row.selection);portfolioMode=false;refreshSelection();message="Selected box copied to your quick ticket. Check the stake; no bet has been placed.";error="";}catch(e){boxError=String(e.message||e);}}
function useDiversifiedPortfolio(){try{let s=RaceBoxWork.state();let result=s.result;if(!result||s.key!==currentBoxKey()||!result.portfolio.length)throw new Error("Calculate a diversified set first.");if(result.portfolio.length>6)throw new Error("Portfolio Lab supports at most six tickets. Copy or export this set, or calculate six or fewer to transfer.");let rows=result.portfolio.map(function(b,i){return {id:"suggested-"+(i+1),name:"Suggested box "+(i+1),type:"box",selectionText:boxNumberText(b.selection),stake:"1.00"};});portfolioText=JSON.stringify(rows);portfolioMode=true;refreshPortfolio();setInterfaceMode("advanced");message="Suggested boxes copied to Portfolio Lab with $1 per ticket for illustration. Edit stakes; no bets have been placed.";error="";}catch(e){boxError=String(e.message||e);}}
function boxResultsExport(){let s=RaceBoxWork.state();return s.phase==="finished"&&s.key===currentBoxKey()&&s.sourceKey===raceKey()?s.result:null;}
function refreshTrialSettings(){checkBoxFreshness();refreshAdvancedSettings();}

function syncBoxLifecycle(){let before=RaceBoxWork.state();checkBoxFreshness();let after=RaceBoxWork.state();if((before.phase==="running"||before.phase==="finished")&&after.phase==="idle")boxStatus="Box inputs changed. Calculate again for the current scenario.";if(after.phase==="running")boxBusy=true;else if(boxBusy)boxBusy=false;}
function watchAppState(){syncAnalysisState();checkDiagnosticsFreshness();syncBoxLifecycle();if(RaceDiagnostics.pending())diagnosticsPending=true;}

// A generated-box collection is a separate, bounded calculator. Unlike
// Portfolio Lab it does not enumerate 2^N ticket masks.
let boxCollectionRows=[];
let boxCollectionKey="";
let boxCollectionSeed="";
let boxCollectionFingerprint="";
let boxCollectionAllStake="1.00";
let boxCollectionFinish="";
let boxCollectionDividend="";
let boxCollectionError="";
let boxCollectionSettleError="";
let boxCollectionSummary="";
let boxCollectionOutcome="";
let boxCollectionCopy="";
let boxCollectionReport=null;
let boxCollectionProfile="generic";
let boxCollectionValidation="Generic research mode: no bookmaker-specific checks.";
let boxCollectionDefaultInfo="";
let boxCollectionFullUnitPreview="";
let boxCollectionReceiptText="";
function clearBoxCollection(){boxCollectionRows=[];boxCollectionKey="";boxCollectionSeed="";boxCollectionFingerprint="";boxCollectionError="";boxCollectionSettleError="";boxCollectionSummary="";boxCollectionOutcome="";boxCollectionCopy="";boxCollectionReceiptText="";boxCollectionDefaultInfo="";boxCollectionFullUnitPreview="";boxCollectionValidation="Generic research mode: no bookmaker-specific checks.";boxCollectionProfile="generic";boxCollectionReport=null;boxCollectionFinish="";boxCollectionDividend="";}
function boxCollectionSignature(result){return JSON.stringify(result.portfolio.map(function(b){return b.selection;}));}
function boxCollectionCurrent(){let s=RaceBoxWork.state();return !!(s.phase==="finished"&&s.result&&s.key===currentBoxKey()&&s.sourceKey===raceKey()&&s.seed===boxCollectionSeed&&boxCollectionKey===s.key&&boxCollectionFingerprint===boxCollectionSignature(s.result));}
function collectionMoney(value,label){let s=String(value).trim();if(!/^\d+(\.\d{1,2})?$/.test(s))throw new Error(label+" must be a dollar amount with up to two decimals.");let parts=s.split(".");let dollars=Number(parts[0]);let cents=parts.length>1?Number((parts[1]+"0").slice(0,2)):0;let result=dollars*100+cents;if(!Number.isSafeInteger(result)||result>100000000)throw new Error(label+" is too large.");return result;}
function initializeBoxCollection(){let s=RaceBoxWork.state();if(s.phase!=="finished"||!s.result||s.key!==currentBoxKey())return;let report=s.result;boxCollectionKey=s.key;boxCollectionSeed=s.seed;boxCollectionFingerprint=boxCollectionSignature(report);boxCollectionAllStake="1.00";boxCollectionFinish="";boxCollectionDividend="";boxCollectionRows=report.portfolio.map(function(b,i){return {id:"collection-"+i,rank:i+1,selection:b.selection.slice(),selectionText:boxNumberText(b.selection),combinations:RaceSim.combinations(b.selection.length),stake:"1.00",flexiText:""};});let first=boxCollectionRows[0];boxCollectionDefaultInfo=first?"Default: $1.00 total per box = "+(100/first.combinations).toFixed(2)+"% of a $1 dividend for a "+first.selection.length+"-horse box. Each ticket stake is a total, not a per-combination amount.":"";let full=0;boxCollectionRows.forEach(function(row){full+=row.combinations;});boxCollectionFullUnitPreview="Full $1 unit for every box would cost $"+full.toFixed(2)+" total. Check this amount before applying.";refreshBoxCollection(false);}
function setBoxCollectionStake(id,value){boxCollectionRows=boxCollectionRows.map(function(row){if(row.id===id)row.stake=String(value);return row;});calculateBoxCollection();}
function applyBoxCollectionStake(){let value=String(boxCollectionAllStake);try{let cents=collectionMoney(value,"Stake per box");if(cents<1)throw new Error("Stake per box must be at least $0.01.");boxCollectionRows=boxCollectionRows.map(function(row){row.stake=value;return row;});calculateBoxCollection();}catch(e){boxCollectionError=String(e.message||e);boxCollectionReport=null;boxCollectionCopy="";boxCollectionReceiptText="";boxCollectionSummary="";if(hasResult&&resultKey===dataKey()&&exportJson)buildResultsExport();}}
function setBoxCollectionFullUnit(){if(!boxCollectionCurrent()){calculateBoxCollection();return;}boxCollectionRows=boxCollectionRows.map(function(row){row.stake=Number(row.combinations).toFixed(2);return row;});if(boxCollectionRows.length){let first=boxCollectionRows[0].combinations;boxCollectionAllStake=boxCollectionRows.every(function(row){return row.combinations===first;})?Number(first).toFixed(2):"";}calculateBoxCollection();}
function calculateBoxCollection(){refreshBoxCollection(true);}
function refreshBoxCollection(updateExport){boxCollectionError="";boxCollectionSettleError="";boxCollectionOutcome="";boxCollectionReport=null;boxCollectionCopy="";boxCollectionReceiptText="";if(!boxCollectionCurrent()){boxCollectionSummary="";if(boxCollectionRows.length)boxCollectionError="The generated boxes changed. Calculate them again.";if(updateExport&&hasResult&&resultKey===dataKey()&&exportJson)buildResultsExport();return;}try{if(boxCollectionProfile!=="generic"&&boxCollectionProfile!=="tab")throw new Error("Choose a valid stake-check profile.");let total=0;let paidCombinations=0;let tickets=[];let copy=[];let receipt=[];boxCollectionRows=boxCollectionRows.map(function(row){let cents=collectionMoney(row.stake,"Box "+row.rank+" stake");if(cents<1)throw new Error("Box "+row.rank+" stake must be at least $0.01.");if(boxCollectionProfile==="tab"){if(cents<50)throw new Error("Box "+row.rank+": TAB Flexi minimum is $0.50 per ticket.");if(cents%50!==0)throw new Error("Box "+row.rank+": TAB Flexi stake must be in $0.50 increments.");if(cents<row.combinations)throw new Error("Box "+row.rank+": TAB Flexi bet percentage must be at least 1.00% of a $1 unit.");}total+=cents;paidCombinations+=row.combinations;if(total>100000000)throw new Error("Total stake exceeds $1,000,000.");let fraction=cents/(100*row.combinations);row.flexiText=(fraction*100).toFixed(2)+"% of a $1 unit";tickets.push({rank:row.rank,selection:row.selection.slice(),numbers:row.selectionText,stakeCents:cents,combinations:row.combinations,flexiFraction:fraction,flexiPercent:fraction*100});copy.push(row.selectionText+" | $"+(cents/100).toFixed(2)+" total");receipt.push("Box "+row.rank+": "+row.selectionText+" | "+row.combinations+" ordered combinations | $"+(cents/100).toFixed(2)+" total | "+(fraction*100).toFixed(2)+"% of a $1 unit");return row;});boxCollectionValidation=boxCollectionProfile==="tab"?"TAB published Flexi minimum, $0.50 increment and 1% checks passed for every ticket. Operator acceptance depends on the current product and channel.":"Generic research mode: no bookmaker-specific checks.";boxCollectionReceiptText="Generated box receipt\n"+tickets.length+" boxes | "+paidCombinations+" paid ordered combinations (overlaps counted again) | $"+(total/100).toFixed(2)+" total outlay\nUnit: $1 per ordered combination\n"+boxCollectionValidation+"\n"+receipt.join("\n");let report=RaceBoxWork.state().result;let result={schema:"racelab-box-collection-v1",currency:"AUD",unitStakeAUD:1,fieldSnapshotId:acceptedSnapshotId,seed:boxCollectionSeed,modelIdentity:analysisContext.modelIdentity,model:RaceSim.model,going:going,trials:report.trials,tickets:tickets,totalStakeCents:total,receipt:{boxCount:tickets.length,orderedCombinationsPurchased:paidCombinations,overlapCountedSeparately:true,unitStakeAUD:1,totalOutlayCents:total,tickets:tickets},operatorValidation:{profile:boxCollectionProfile,status:boxCollectionProfile==="tab"?"passes_published_flexi_checks":"not_checked",source:boxCollectionProfile==="tab"?"https://help.tab.com.au/betting-on-racing/what-is-flexi-betting":null,note:"Mathematical checks only; operator rules, channel and acceptance may vary."},coverage:{exactModelProbability:report.portfolioUnion.exactProbability,simulatedFrequency:report.portfolioUnion.frequency,note:"Union coverage counts overlapping winning outcomes once. Positive stake does not change event coverage; probabilities are conditional on the uncalibrated model."},settlement:null};boxCollectionSummary=tickets.length+" boxes · $"+(total/100).toFixed(2)+" total stake · "+boxPct(report.portfolioUnion.exactProbability)+" exact-model union coverage (overlap counted once).";boxCollectionCopy=copy.join("\n");boxCollectionReport=result;
if(String(boxCollectionFinish).trim()||String(boxCollectionDividend).trim()){try{if(!String(boxCollectionFinish).trim())throw new Error("Enter the three finishing horse numbers to calculate a scenario.");let ids=selectedIdsFor(String(boxCollectionFinish),field);if(ids.length!==3)throw new Error("Enter exactly three distinct active horse numbers.");let div=String(boxCollectionDividend).trim();let dividendCents=div?collectionMoney(div,"$1 declared dividend"):null;let winning=0,share=0;for(let i=0;i<tickets.length;i=i+1){let t=tickets[i];if(ids.every(function(id){return t.selection.indexOf(id)!==-1;})){winning++;share+=t.flexiFraction;}}let gross=dividendCents==null?null:dividendCents/100*share;let net=gross==null?null:gross-total/100;result.settlement={finishOrder:ids,winningTicketCount:winning,combinedFlexiFraction:share,dividendAUD:dividendCents==null?null:dividendCents/100,grossPayoutAUD:gross,netPayoutAUD:net,note:"Illustrative settlement based on entered numbers and $1 dividend; actual operator rules, minimums and rounding may differ."};boxCollectionOutcome=winning+" matching box"+(winning===1?"":"es")+" · combined "+(share*100).toFixed(2)+"% of a $1 dividend"+(gross==null?" · enter a dividend to estimate payout.":" · estimated gross $"+gross.toFixed(2)+" · net $"+net.toFixed(2)+" after all stakes.");}catch(e){boxCollectionSettleError=String(e.message||e);}}
if(updateExport&&hasResult&&resultKey===dataKey()&&exportJson)buildResultsExport();
}catch(e){boxCollectionError=String(e.message||e);boxCollectionSummary="";boxCollectionValidation=boxCollectionProfile==="tab"?"TAB Flexi check failed. Review the highlighted error and operator rules.":"Generic research mode: no bookmaker-specific checks.";boxCollectionReceiptText="";if(updateExport&&hasResult&&resultKey===dataKey()&&exportJson)buildResultsExport();}}
function boxCollectionResultsExport(){return boxCollectionCurrent()&&!boxCollectionError?boxCollectionReport:null;}
