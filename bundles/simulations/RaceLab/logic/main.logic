      }
      forecastRows.push({id:h.id,number:h.number,name:h.name,colour:h.colour,winText:numberText(row.winProbability*100)+"%",sampleWinText:numberText(row.winFrequency*100)+"%",wins:row.winCount,meanText:numberText(row.meanFinish),expectedText:numberText(row.expectedFinish),exactTop3Text:numberText(row.top3Probability*100)+"%",top3Text:numberText(row.top3*100)+"%",intervalText:numberText(row.top3Interval95[0]*100)+"%–"+numberText(row.top3Interval95[1]*100)+"%",baseWinText:numberText(base*100)+"%",deltaText:(delta>=0?"+":"")+numberText(delta)+" pp",historyText:historySummary(h),sensitivityText:rangeText});
    }
