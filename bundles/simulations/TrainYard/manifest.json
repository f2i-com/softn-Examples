{
  "name": "TrainYard",
  "version": "1.1.0",
  "description": "Animated HO-scale model train yard diorama with Blender PBR steam locomotive, freight hoppers, harbor tug, signal gantries, HDRI day-night cycle, GTAO/bloom lighting, chuff audio, and interactive fascia controls.",
  "main": "ui/main.ui",
  "icon": "assets/icon.svg",
  "files": {
    "ui": [
      "ui/main.ui"
    ],
    "logic": [
      "logic/main.logic"
    ],
    "assets": [
      "assets/icon.svg",
      "assets/env/sunny-meadow.hdr",
      "assets/models/freight-hopper.glb",
      "assets/models/harbor-tug.glb",
      "assets/models/signal-gantry.glb",
      "assets/models/steam-loco-detail.glb",
      "assets/sfx/bell.wav",
      "assets/sfx/chuff.wav",
      "assets/sfx/switch.wav",
      "assets/sfx/whistle.wav"
    ]
  },
  "config": {
    "window": {
      "title": "HO-Scale Model Train Yard",
      "width": 1024,
      "height": 768
    },
    "theme": {
      "primary": "#3b82f6",
      "mode": "dark"
    }
  }
}
