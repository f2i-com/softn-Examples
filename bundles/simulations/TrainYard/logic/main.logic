  }

  // Streetlamp globes along Main Street & Station Platform
  let lampPosts = [-5.6, -2.1, 1.4, 4.6];
  for (let lp = 0; lp < lampPosts.length; lp = lp + 1) {
    let lx = lampPosts[lp];
    list.push({
