    },
    rotation: {
      x: Math.sin(cranePhase * 0.9) * 0.025,
      y: 0.32 + Math.sin(cranePhase * 0.35) * 0.035,
      z: Math.cos(cranePhase * 1.1) * 0.028
    },
    scale: { x: 0.56, y: 0.56, z: 0.56 },
    castShadow: true,
    receiveShadow: true
  });

  // Rotating Yard Floodlight Beacons & Warm Village Window Glow (Respond to lightsEnabled & pop dramatically at night)
  let towerLocs = [
    { x: -7.5, z: 2.4 },
    { x: -1.2, z: 2.4 }
  ];
  for (let tb = 0; tb < towerLocs.length; tb = tb + 1) {
    let tl = towerLocs[tb];
    let pulse = lightsEnabled ? ((isNight ? 3.8 : 2.2) + Math.sin(beaconPhase + tb * Math.PI) * 1.1) : 0.0;
    list.push({
      id: "yard-tower-beacon-" + tb,
      type: "sphere",
      radius: 0.14,
      position: {
        x: tl.x + Math.sin(beaconPhase + tb * 1.5) * 0.14,
