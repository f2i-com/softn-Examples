      },
      {
        id: "truck-light-r",
        type: "sphere",
        radius: 0.05,
        position: { x: 0.14, y: 0.2, z: 0.54 },
        color: "#fef08a",
        emissive: lightsEnabled && isNight ? "#fef08a" : "#000000"
      }
    ]
  });

  // 9. Town Classic Coupe Sedan (Positioned exactly half a lap apart from truck, moving in opposite lane)
  let carPt2 = getRoadPoint(carProgress2);
  list.push({
    id: "town-sedan",
    type: "group",
    position: { x: carPt2.x, y: carPt2.y, z: carPt2.z },
    rotation: { x: 0, y: carPt2.rot, z: 0 },
    children: [
      {
        id: "sedan-body",
        type: "box",
