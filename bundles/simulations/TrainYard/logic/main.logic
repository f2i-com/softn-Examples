let turntableStall = 0;

// Harbor crane state
let cranePhase = 0.0;
let craneAngle = 0.35;
let craneHoistY = 2.1;

// Town vehicles state (spaced exactly half a lap apart on a two-lane street loop to prevent head-on collisions)
