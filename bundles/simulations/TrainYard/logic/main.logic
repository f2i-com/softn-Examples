      color: "#b91c1c",
      castShadow: true
    });
  }

  // Staged Rolling Stock on Yard Tracks (Blender PBR Freight Hopper + Tanker + Timber Flatcar)
  list.push({
    id: "staged-boxcar",
    type: "model",
    modelUrl: "assets/models/freight-hopper.glb",
    position: { x: -4.5, y: 0.64, z: 0.6 },
