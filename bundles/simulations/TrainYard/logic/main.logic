  // 7. Working Harbor Gantry Crane
  list.push({
    id: "harbor-crane",
    type: "group",
    position: { x: 4.5, y: 0.615, z: 0.6 },
    rotation: { x: 0, y: craneAngle, z: 0 },
    children: [
      {
