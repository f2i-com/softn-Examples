      emissive: lightsEnabled ? "#fbbf24" : "#000000",
      emissiveIntensity: lightsEnabled ? (isNight ? 3.8 : 1.6) : 0.0
    });
  }

  // 6. Turntable Rotating Bridge (Group, Safely centered at x = -4.5, z = -1.2)
  list.push({
    id: "turntable-bridge",
    type: "group",
    position: { x: -4.5, y: 0.65, z: -1.2 },
    rotation: { x: 0, y: turntableAngle, z: 0 },
