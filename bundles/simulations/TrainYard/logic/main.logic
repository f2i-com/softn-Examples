        color: "#15803d"
      },
      {
        id: "truck-bed",
        type: "box",
        width: 0.40,
        height: 0.38,
        depth: 0.62,
        position: { x: 0, y: 0.25, z: -0.28 },
        color: "#d97706"
      },
      // 4 Rubber Tires with Hubcaps
      {
        id: "truck-wheel-fl",
        type: "cylinder",
        radius: 0.09,
        height: 0.08,
        position: { x: -0.22, y: 0.09, z: 0.28 },
        rotation: { x: 0, y: 0, z: Math.PI / 2 },
        color: "#09090b"
      },
      {
        id: "truck-wheel-fr",
        type: "cylinder",
        radius: 0.09,
        height: 0.08,
        position: { x: 0.22, y: 0.09, z: 0.28 },
        rotation: { x: 0, y: 0, z: Math.PI / 2 },
        color: "#09090b"
      },
      {
        id: "truck-wheel-rl",
        type: "cylinder",
        radius: 0.09,
        height: 0.08,
        position: { x: -0.22, y: 0.09, z: -0.28 },
        rotation: { x: 0, y: 0, z: Math.PI / 2 },
        color: "#09090b"
      },
      {
        id: "truck-wheel-rr",
        type: "cylinder",
        radius: 0.09,
        height: 0.08,
        position: { x: 0.22, y: 0.09, z: -0.28 },
        rotation: { x: 0, y: 0, z: Math.PI / 2 },
