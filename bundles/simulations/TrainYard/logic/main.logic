    interactive: true,
    children: [
      {
        id: "bridge-deck",
        type: "box",
        width: 0.76,
        height: 0.08,
        depth: 3.4,
        position: { x: 0, y: 0, z: 0 },
        color: "#334155",
        castShadow: true
      },
      {
        id: "bridge-girder-l",
        type: "box",
        width: 0.06,
        height: 0.35,
        depth: 3.4,
        position: { x: -0.4, y: 0.14, z: 0 },
        color: "#1e293b"
      },
      {
        id: "bridge-girder-r",
        type: "box",
        width: 0.06,
        height: 0.35,
        depth: 3.4,
        position: { x: 0.4, y: 0.14, z: 0 },
        color: "#1e293b"
      },
      {
        id: "bridge-rail-l",
        type: "box",
        width: 0.04,
        height: 0.04,
