      },
      {
        id: "crane-boom",
        type: "box",
        width: 0.15,
        height: 0.15,
        depth: 3.2,
        position: { x: 0, y: 3.0, z: 1.3 },
        rotation: { x: -0.22, y: 0, z: 0 },
