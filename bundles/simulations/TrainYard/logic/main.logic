      },
      color: lightsEnabled ? "#fef08a" : "#334155",
      emissive: lightsEnabled ? "#facc15" : "#000000",
      emissiveIntensity: pulse
    });
  }

  let winGlow = lightsEnabled ? (isNight ? 3.4 : 1.5) : 0.0;
  let winCol = lightsEnabled ? "#fde68a" : "#1e293b";
  let winEmissive = lightsEnabled ? "#fbbf24" : "#000000";
  let villageWindows = [
    { id: "win-depot-1", x: -0.95, y: 1.32, z: 6.76, w: 0.42, h: 0.44 },
    { id: "win-depot-2", x: 0.55, y: 1.32, z: 6.76, w: 0.42, h: 0.44 },
    { id: "win-hotel-1", x: 3.05, y: 1.85, z: 6.76, w: 0.36, h: 0.42 },
    { id: "win-hotel-2", x: 3.95, y: 1.85, z: 6.76, w: 0.36, h: 0.42 },
    { id: "win-hotel-3", x: 3.50, y: 1.15, z: 6.76, w: 0.55, h: 0.44 },
    { id: "win-store-1", x: -3.50, y: 1.25, z: 6.76, w: 0.68, h: 0.46 },
    { id: "win-bakery-1", x: -5.60, y: 1.20, z: 6.76, w: 0.62, h: 0.44 }
  ];
  for (let vw = 0; vw < villageWindows.length; vw = vw + 1) {
    let w = villageWindows[vw];
    list.push({
      id: w.id,
