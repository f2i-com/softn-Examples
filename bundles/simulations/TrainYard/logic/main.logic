  for (let tp = 0; tp < trestlePosts.length; tp = tp + 1) {
    list.push({
      id: "water-tank-post-" + tp,
      type: "box",
      width: 0.14,
      height: 1.0,
      depth: 0.14,
      position: { x: -7.2 + trestlePosts[tp].x, y: 1.05, z: -1.2 + trestlePosts[tp].z },
      color: "#3f2a14",
      castShadow: true
    });
  }
  let braceRing = [
    { x: 0, z: -0.42, w: 0.98, d: 0.06 },
    { x: 0, z: 0.42, w: 0.98, d: 0.06 },
    { x: -0.42, z: 0, w: 0.06, d: 0.98 },
    { x: 0.42, z: 0, w: 0.06, d: 0.98 }
  ];
  for (let br = 0; br < braceRing.length; br = br + 1) {
    list.push({
      id: "water-tank-brace-" + br,
      type: "box",
      width: braceRing[br].w,
      height: 0.06,
      depth: braceRing[br].d,
      position: { x: -7.2 + braceRing[br].x, y: 0.95, z: -1.2 + braceRing[br].z },
      color: "#3f2a14"
    });
  }
  list.push({
    id: "water-tank-platform",
    type: "box",
    width: 1.5,
    height: 0.1,
    depth: 1.5,
    position: { x: -7.2, y: 1.5, z: -1.2 },
    color: "#5c3a21",
    texture: "wood",
    castShadow: true
  });
  list.push({
    id: "water-tank-body",
    type: "cylinder",
    radius: 0.75,
    height: 1.4,
    position: { x: -7.2, y: 2.2, z: -1.2 },
    color: "#78350f",
    castShadow: true
  });
  list.push({
    id: "water-tank-roof",
    type: "cone",
    radius: 0.9,
    height: 0.6,
    position: { x: -7.2, y: 3.1, z: -1.2 },
    color: "#451a03"
  });

  // Harbor Basin & Quay (Blender PBR harbor-tug.glb bobs dynamically in buildDynamicObjects)
  list.push({
    id: "harbor-water",
    type: "box",
    width: 4.8,
    height: 0.03,
    depth: 3.8,
    position: { x: 6.2, y: 0.57, z: 1.8 },
    color: "#0284c7",
    opacity: 0.88,
    roughness: 0.06,
    metalness: 0.42
  });
  list.push({
    id: "harbor-quay-pad",
    type: "box",
    width: 1.6,
    height: 0.06,
    depth: 1.2,
    position: { x: 4.5, y: 0.585, z: 0.6 },
    color: "#a8a29e",
    receiveShadow: true
  });

  // Mainline Signal Gantries (Blender PBR signal-gantry.glb straddling station & viaduct lines)
  list.push({
    id: "signal-gantry-station",
    type: "model",
    modelUrl: "assets/models/signal-gantry.glb",
    position: { x: -2.4, y: 0.56, z: 6.32 },
    rotation: { x: 0, y: Math.PI / 2, z: 0 },
    scale: { x: 0.48, y: 0.48, z: 0.48 },
    castShadow: true
  });
  list.push({
    id: "signal-gantry-viaduct",
    type: "model",
    modelUrl: "assets/models/signal-gantry.glb",
    position: { x: 0.0, y: 0.56, z: -6.32 },
    rotation: { x: 0, y: -Math.PI / 2, z: 0 },
    scale: { x: 0.48, y: 0.48, z: 0.48 },
    castShadow: true
  });

  // Instanced Alpine Pines around northern hills and harbor bluff
  let treePositions = [
    { x: -11.5, z: -6.4, s: 1.0 },
    { x: -8.2, z: -6.8, s: 0.85 },
    { x: -5.4, z: -7.1, s: 1.15 },
    { x: 4.2, z: -7.2, s: 1.05 },
    { x: 8.6, z: -6.6, s: 0.92 },
    { x: 12.2, z: -5.8, s: 1.1 },
    { x: 11.4, z: 4.8, s: 0.9 },
    { x: -12.6, z: 4.4, s: 1.0 }
  ];
  let treeTrunkPos = [];
  let treeCrownPos = [];
  let treeScaleVals = [];
  for (let t = 0; t < treePositions.length; t = t + 1) {
    let tp = treePositions[t];
    treeTrunkPos.push(tp.x, 0.56 + 0.25 * tp.s, tp.z);
    treeCrownPos.push(tp.x, 0.56 + 0.95 * tp.s, tp.z);
    treeScaleVals.push(tp.s);
  }
  list.push({
    id: "alpine-pine-trunks",
    type: "instanced",
    shape: "cylinder",
    radius: 0.08,
    height: 0.5,
    color: "#5c3a21",
    roughness: 0.9,
    instances: treeTrunkPos,
    instanceScales: treeScaleVals,
    castShadow: true
  });
  list.push({
    id: "alpine-pine-crowns",
    type: "instanced",
    shape: "cone",
    radius: 0.42,
    height: 1.35,
    color: "#166534",
    roughness: 0.85,
    flatShading: true,
    instances: treeCrownPos,
    instanceScales: treeScaleVals,
    castShadow: true
  });

  // Triple Stainless Steel Grain Silos
  for (let s = 0; s < 3; s = s + 1) {
    list.push({
      id: "grain-silo-" + s,
      type: "capsule",
      radius: 0.5,
      height: 2.2,
      position: { x: 5.2 + s * 1.2, y: 1.66, z: -1.2 },
      color: "#e2e8f0",
      metalness: 0.75,
      roughness: 0.25,
      castShadow: true
    });
  }

  // Victorian Passenger Station Platform
  list.push({
    id: "station-platform",
    type: "box",
    width: 6.8,
    height: 0.18,
    depth: 0.45,
    position: { x: 0.0, y: 0.65, z: 6.45 },
    color: "#a8a29e",
    receiveShadow: true
  });

  // Station Depot Building
  list.push({
    id: "station-depot",
    type: "box",
    width: 3.4,
    height: 1.5,
    depth: 0.75,
    position: { x: -0.2, y: 1.31, z: 7.15 },
    color: "#991b1b",
    castShadow: true
  });
  list.push({
    id: "station-roof",
    type: "prism",
    width: 3.8,
    height: 0.85,
    depth: 0.95,
    position: { x: -0.2, y: 2.5, z: 7.15 },
    color: "#1e293b",
    flatShading: true,
    castShadow: true
  });

  // Town Commercial Shops (Hotel, General Store, Bakery at z = 7.15)
  let shops = [
    { x: 3.5, name: "hotel", color: "#fef3c7", roofColor: "#15803d", width: 2.2, height: 2.0, depth: 0.75 },
    { x: -3.5, name: "store", color: "#dc2626", roofColor: "#475569", width: 1.9, height: 1.6, depth: 0.75 },
    { x: -5.6, name: "bakery", color: "#f59e0b", roofColor: "#78350f", width: 1.8, height: 1.5, depth: 0.75 }
  ];
  for (let s = 0; s < shops.length; s = s + 1) {
    let sh = shops[s];
    list.push({
      id: "shop-" + sh.name,
      type: "box",
      width: sh.width,
      height: sh.height,
      depth: sh.depth,
      position: { x: sh.x, y: 0.55 + sh.height / 2, z: 7.15 },
      color: sh.color,
      castShadow: true
    });
    list.push({
      id: "roof-" + sh.name,
      type: "prism",
      width: sh.width + 0.25,
      height: 0.75,
      depth: sh.depth + 0.25,
      position: { x: sh.x, y: 0.55 + sh.height + 0.37, z: 7.15 },
      color: sh.roofColor,
      flatShading: true,
      castShadow: true
    });
  }

  // Paved Town Street (Straight two-lane roadway with turnarounds strictly on the table deck at z = 8.05)
  list.push({
    id: "street-asphalt",
    type: "box",
    width: 10.2,
    height: 0.03,
    depth: 0.96,
    position: { x: 0, y: 0.575, z: 8.05 },
    color: "#334155",
    receiveShadow: true
  });
  // East turnaround loop pavement
  list.push({
    id: "street-turn-e",
    type: "cylinder",
    radius: 0.48,
    height: 0.03,
    position: { x: 4.5, y: 0.575, z: 8.05 },
    color: "#334155"
  });
  // West turnaround loop pavement
  list.push({
    id: "street-turn-w",
    type: "cylinder",
    radius: 0.48,
    height: 0.03,
    position: { x: -4.5, y: 0.575, z: 8.05 },
    color: "#334155"
  });
  // Yellow Center Lane Divider Stripe
  list.push({
    id: "street-line",
    type: "box",
    width: 9.0,
    height: 0.01,
    depth: 0.035,
    position: { x: 0, y: 0.592, z: 8.05 },
    color: "#fbbf24"
  });
  // Rear Sidewalk in front of shops
  list.push({
    id: "sidewalk-rear",
    type: "box",
    width: 13.8,
    height: 0.05,
    depth: 0.25,
    position: { x: 0, y: 0.585, z: 7.55 },
    color: "#94a3b8"
  });
  // Front Sidewalk curb along front table edge
  list.push({
    id: "sidewalk-front",
    type: "box",
    width: 13.8,
    height: 0.05,
    depth: 0.30,
    position: { x: 0, y: 0.585, z: 8.58 },
    color: "#94a3b8"
  });

  // Front Fascia Control Board Backing & Brass Bezel Mounts
  list.push({
    id: "ctrl-plate",
    type: "box",
    width: 14.6,
    height: 0.95,
    depth: 0.06,
    position: { x: 0, y: 0.35, z: 9.32 },
    color: "#0f172a"
  });

  // 1. Throttle Bezel & Slot
  list.push({
    id: "ctrl-bezel-throttle",
    type: "box",
    width: 3.4,
    height: 0.46,
    depth: 0.04,
    position: { x: -4.5, y: 0.35, z: 9.34 },
    color: "#b45309",
    metalness: 0.8
  });
  list.push({
    id: "ctrl-slot",
    type: "box",
    width: 2.8,
    height: 0.14,
    depth: 0.06,
    position: { x: -4.5, y: 0.35, z: 9.36 },
    color: "#020617"
  });
  let ticks = [
    { x: -5.8, label: "0" },
    { x: -4.89, label: "35" },
    { x: -3.98, label: "70" },
    { x: -3.2, label: "100" }
  ];
  for (let k = 0; k < ticks.length; k = k + 1) {
    list.push({
      id: "ctrl-tick-" + k,
      type: "box",
      width: 0.14,
      height: 0.14,
      depth: 0.06,
      position: { x: ticks[k].x, y: 0.50, z: 9.37 },
      color: "#fbbf24",
      cursor: "pointer",
      interactive: true
    });
  }

  // 2. Direction Bezel
  list.push({
    id: "ctrl-bezel-dir",
    type: "box",
    width: 1.4,
    height: 0.65,
    depth: 0.04,
    position: { x: -1.8, y: 0.35, z: 9.34 },
    color: "#b45309",
    metalness: 0.8
  });

  // 3. Whistle Bezel
  list.push({
    id: "ctrl-bezel-whistle",
    type: "cylinder",
    radius: 0.32,
    height: 0.04,
    position: { x: 0.0, y: 0.35, z: 9.34 },
    rotation: { x: Math.PI / 2, y: 0, z: 0 },
    color: "#b45309",
    metalness: 0.8
  });

  // 4. Turntable Dial Bezel
  list.push({
    id: "ctrl-bezel-turntable",
    type: "cylinder",
    radius: 0.34,
    height: 0.04,
    position: { x: 1.8, y: 0.35, z: 9.34 },
    rotation: { x: Math.PI / 2, y: 0, z: 0 },
    color: "#b45309",
    metalness: 0.8
  });

  // 5. Lights Switch Bezel
  list.push({
    id: "ctrl-bezel-lights",
    type: "box",
    width: 1.4,
    height: 0.65,
    depth: 0.04,
    position: { x: 3.8, y: 0.35, z: 9.34 },
    color: "#b45309",
    metalness: 0.8
  });

  return list;
}

const staticObjects = buildStaticScenery();

// Build Dynamic Objects on each tick with Fully Connected Consist & Non-Colliding Traffic
function buildDynamicObjects(delta) {
  let list = [];

  // Wheel & bell motion calculation
  let wheelRot = trainProgress * 208.6;
  let rodOffsetY = Math.sin(wheelRot) * 0.10;
  let rodOffsetZ = Math.cos(wheelRot) * 0.10;
  let bellSwing = (whistleActive || Math.abs(trainSpeed) > 0.05) ? Math.sin(bellPhase) * 0.28 : 0.0;

  // 1. BLENDER PBR 4-6-0 STEAM LOCOMOTIVE (Hero centerpiece with articulated Bell + Smoke + Rear Coupler)
  let locoPt = getTrackPoint(trainProgress);
  let locoHead = getTrackHeading(trainProgress);
  let locoRot = getTrackRotation(trainProgress);

  list.push({
    id: "loco-hero",
    type: "model",
    modelUrl: "assets/models/steam-loco-detail.glb",
    position: { x: locoPt.x, y: locoPt.y + 0.02, z: locoPt.z },
    rotation: locoRot,
    scale: { x: 0.56, y: 0.56, z: 0.56 },
    parts: {
      Bell: { rotation: { x: bellSwing, y: 0, z: 0 } }
    },
    castShadow: true,
    receiveShadow: true,
    cursor: "pointer",
    interactive: true
  });

  list.push({
    id: "train-loco",
    type: "group",
    position: { x: locoPt.x, y: locoPt.y, z: locoPt.z },
    rotation: locoRot,
    children: [
      {
        id: "loco-headlamp-bulb",
        type: "sphere",
        radius: 0.075,
        position: { x: 0, y: 0.92, z: 1.06 },
        color: lightsEnabled ? "#fef9c3" : "#475569",
        emissive: lightsEnabled ? "#fde047" : "#000000",
        emissiveIntensity: lightsEnabled ? (isNight ? 4.5 : 2.2) : 0.0
      },
      {
        id: "loco-rod-l",
        type: "box",
        width: 0.04,
        height: 0.055,
        depth: 1.32,
        position: { x: -0.44, y: 0.24 + rodOffsetY, z: 0.0 + rodOffsetZ },
        color: "#e2e8f0",
        metalness: 0.9,
        roughness: 0.15
      },
      {
        id: "loco-rod-r",
        type: "box",
        width: 0.04,
        height: 0.055,
        depth: 1.32,
        position: { x: 0.44, y: 0.24 + rodOffsetY, z: 0.0 + rodOffsetZ },
        color: "#e2e8f0",
        metalness: 0.9,
        roughness: 0.15
      },
      {
        id: "loco-drawbar-rear",
        type: "box",
        width: 0.12,
        height: 0.10,
        depth: 0.45,
        position: { x: 0, y: 0.32, z: -1.25 },
        color: "#0f172a",
        metalness: 0.85
      },
      {
        id: "loco-knuckle-rear",
        type: "box",
        width: 0.18,
        height: 0.14,
        depth: 0.18,
        position: { x: 0, y: 0.32, z: -1.45 },
        color: "#1e293b",
        metalness: 0.9
      }
    ]
  });

  // Update Chimney Smoke Particles
  let chimneyX = locoPt.x + Math.sin(locoHead) * 0.80;
  let chimneyZ = locoPt.z + Math.cos(locoHead) * 0.80;
  let chimneyY = locoPt.y + 1.28;
  updateSmoke(chimneyX, chimneyY, chimneyZ, trainSpeed, delta);

  // 2. COAL TENDER (Articulated group firmly coupled to locomotive)
  let tenderProg = trainProgress - 0.038;
  let tenderPt = getTrackPoint(tenderProg);
  let tenderRot = getTrackRotation(tenderProg);

  list.push({
    id: "train-tender",
    type: "group",
    position: { x: tenderPt.x, y: tenderPt.y, z: tenderPt.z },
    rotation: tenderRot,
    children: [
      {
        id: "tender-body",
        type: "box",
        width: 0.82,
        height: 0.65,
        depth: 1.4,
        position: { x: 0, y: 0.52, z: 0 },
        color: "#1e293b",
        castShadow: true
      },
      {
        id: "tender-coal",
        type: "box",
        width: 0.72,
        height: 0.28,
        depth: 1.0,
        position: { x: 0, y: 0.75, z: 0.05 },
        color: "#09090b",
        roughness: 0.95
      },
      // Cab-to-Tender Gangway Footplate
      {
        id: "tender-footplate",
        type: "box",
        width: 0.62,
        height: 0.04,
        depth: 0.45,
        position: { x: 0, y: 0.46, z: 0.82 },
        color: "#09090b"
      },
      // Front Drawbar (Interlocks with locomotive rear knuckle)
      {
        id: "tender-drawbar-front",
        type: "box",
        width: 0.12,
        height: 0.10,
        depth: 0.45,
        position: { x: 0, y: 0.32, z: 0.85 },
        color: "#0f172a",
        metalness: 0.85
      },
      {
        id: "tender-knuckle-front",
        type: "box",
        width: 0.18,
        height: 0.14,
        depth: 0.18,
        position: { x: 0, y: 0.32, z: 1.05 },
        color: "#1e293b",
        metalness: 0.9
      },
      // Rear Coupler (Connects with boxcar)
      {
        id: "tender-coupler-rear",
        type: "box",
        width: 0.10,
        height: 0.09,
        depth: 0.38,
        position: { x: 0, y: 0.32, z: -0.85 },
        color: "#0f172a"
      },
      {
        id: "tender-knuckle-rear",
        type: "box",
        width: 0.16,
        height: 0.13,
        depth: 0.15,
        position: { x: 0, y: 0.32, z: -1.02 },
        color: "#1e293b",
        metalness: 0.85
      },
      {
        id: "tender-wheel-1",
        type: "cylinder",
        radius: 0.18,
        height: 0.82,
        position: { x: 0, y: 0.18, z: 0.4 },
        rotation: { x: wheelRot * 1.5, y: 0, z: Math.PI / 2 },
        color: "#0f172a"
      },
      {
        id: "tender-wheel-2",
        type: "cylinder",
        radius: 0.18,
        height: 0.82,
        position: { x: 0, y: 0.18, z: -0.4 },
        rotation: { x: wheelRot * 1.5, y: 0, z: Math.PI / 2 },
        color: "#0f172a"
      }
    ]
  });

  // 3. BLENDER PBR COAL FREIGHT HOPPER (Articulated group with front and rear interlocking couplers)
  let boxcarProg = trainProgress - 0.076;
  let boxcarPt = getTrackPoint(boxcarProg);
  let boxcarRot = getTrackRotation(boxcarProg);

  list.push({
    id: "train-boxcar",
    type: "group",
    position: { x: boxcarPt.x, y: boxcarPt.y, z: boxcarPt.z },
    rotation: boxcarRot,
    children: [
      {
        id: "hopper-model",
        type: "model",
        modelUrl: "assets/models/freight-hopper.glb",
        position: { x: 0, y: 0.02, z: 0 },
        scale: { x: 0.56, y: 0.56, z: 0.56 },
        castShadow: true,
        receiveShadow: true
      },
      // Front Coupler (Interlocks with tender rear coupler)
      {
        id: "boxcar-coupler-front",
        type: "box",
        width: 0.10,
        height: 0.09,
        depth: 0.38,
        position: { x: 0, y: 0.32, z: 0.98 },
        color: "#0f172a"
      },
      {
        id: "boxcar-knuckle-front",
        type: "box",
        width: 0.16,
        height: 0.13,
        depth: 0.15,
        position: { x: 0, y: 0.32, z: 1.15 },
        color: "#1e293b",
        metalness: 0.85
      },
      // Rear Coupler (Extends back to connect with tanker)
      {
        id: "boxcar-coupler-rear",
        type: "box",
        width: 0.10,
        height: 0.09,
        depth: 0.38,
        position: { x: 0, y: 0.32, z: -0.98 },
        color: "#0f172a"
      },
      {
        id: "boxcar-knuckle-rear",
        type: "box",
        width: 0.16,
        height: 0.13,
        depth: 0.15,
        position: { x: 0, y: 0.32, z: -1.15 },
        color: "#1e293b",
        metalness: 0.85
      }
    ]
  });

  // 4. CHEMICAL TANK CAR (Articulated group with front and rear interlocking couplers)
  let tankerProg = trainProgress - 0.114;
  let tankerPt = getTrackPoint(tankerProg);
  let tankerRot = getTrackRotation(tankerProg);

  list.push({
    id: "train-tanker",
    type: "group",
    position: { x: tankerPt.x, y: tankerPt.y, z: tankerPt.z },
    rotation: tankerRot,
    children: [
      {
        id: "tanker-cylinder",
        type: "capsule",
        radius: 0.36,
        height: 1.3,
        position: { x: 0, y: 0.64, z: 0 },
        rotation: { x: Math.PI / 2, y: 0, z: 0 },
        color: "#cbd5e1",
        metalness: 0.85,
        roughness: 0.18,
        castShadow: true
      },
      {
        id: "tanker-dome",
        type: "cylinder",
        radius: 0.15,
        height: 0.16,
        position: { x: 0, y: 1.05, z: 0 },
        color: "#94a3b8",
        metalness: 0.8
      },
      {
        id: "tanker-frame",
        type: "box",
        width: 0.78,
        height: 0.12,
        depth: 1.7,
        position: { x: 0, y: 0.28, z: 0 },
        color: "#1e293b"
      },
      // Front Coupler (Interlocks with boxcar rear coupler)
      {
        id: "tanker-coupler-front",
        type: "box",
        width: 0.10,
        height: 0.09,
        depth: 0.38,
        position: { x: 0, y: 0.32, z: 0.98 },
        color: "#0f172a"
      },
      {
        id: "tanker-knuckle-front",
        type: "box",
        width: 0.16,
        height: 0.13,
        depth: 0.15,
        position: { x: 0, y: 0.32, z: 1.15 },
        color: "#1e293b",
        metalness: 0.85
      },
      // Rear Coupler (Extends back to connect with caboose)
      {
        id: "tanker-coupler-rear",
        type: "box",
        width: 0.10,
        height: 0.09,
        depth: 0.38,
        position: { x: 0, y: 0.32, z: -0.98 },
        color: "#0f172a"
      },
      {
        id: "tanker-knuckle-rear",
        type: "box",
        width: 0.16,
        height: 0.13,
        depth: 0.15,
        position: { x: 0, y: 0.32, z: -1.15 },
        color: "#1e293b",
        metalness: 0.85
      },
      {
        id: "tanker-wheel-1",
        type: "cylinder",
        radius: 0.18,
        height: 0.82,
        position: { x: 0, y: 0.18, z: 0.55 },
        rotation: { x: wheelRot * 1.5, y: 0, z: Math.PI / 2 },
        color: "#0f172a"
      },
      {
        id: "tanker-wheel-2",
        type: "cylinder",
        radius: 0.18,
        height: 0.82,
        position: { x: 0, y: 0.18, z: -0.55 },
        rotation: { x: wheelRot * 1.5, y: 0, z: Math.PI / 2 },
        color: "#0f172a"
      }
    ]
  });

  // 5. BRIGHT RED CABOOSE WITH CUPOLA (Articulated group with front coupler and rear marker lamps)
  let cabooseProg = trainProgress - 0.152;
  let caboosePt = getTrackPoint(cabooseProg);
  let cabooseRot = getTrackRotation(cabooseProg);

  list.push({
    id: "train-caboose",
    type: "group",
    position: { x: caboosePt.x, y: caboosePt.y, z: caboosePt.z },
    rotation: cabooseRot,
    children: [
      {
        id: "caboose-body",
        type: "box",
        width: 0.82,
        height: 0.72,
        depth: 1.5,
        position: { x: 0, y: 0.6, z: 0 },
        color: "#dc2626",
        castShadow: true
      },
      {
        id: "caboose-cupola",
        type: "box",
        width: 0.68,
        height: 0.38,
        depth: 0.55,
        position: { x: 0, y: 1.1, z: 0.05 },
        color: "#f59e0b"
      },
      {
        id: "caboose-pipe",
        type: "cylinder",
        radius: 0.04,
        height: 0.35,
        position: { x: 0.22, y: 1.25, z: -0.4 },
        color: "#0f172a"
      },
      // Front Coupler (Interlocks with tanker rear coupler)
      {
        id: "caboose-coupler-front",
        type: "box",
        width: 0.10,
        height: 0.09,
        depth: 0.38,
        position: { x: 0, y: 0.32, z: 0.90 },
        color: "#0f172a"
      },
      {
        id: "caboose-knuckle-front",
        type: "box",
        width: 0.16,
        height: 0.13,
        depth: 0.15,
        position: { x: 0, y: 0.32, z: 1.08 },
        color: "#1e293b",
        metalness: 0.85
      },
      // Rear Marker Lamps (Glow red at night)
      {
        id: "caboose-marker-l",
        type: "sphere",
        radius: 0.06,
        position: { x: -0.38, y: 0.75, z: -0.78 },
        color: "#ef4444",
        emissive: "#ef4444",
