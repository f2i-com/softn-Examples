        castShadow: true
      }
    ]
  });

  // 8. Town Delivery Truck (Moves East on South lane, smooth turn at cul-de-sac)
  let carPt1 = getRoadPoint(carProgress1);
  list.push({
    id: "town-truck",
    type: "group",
    position: { x: carPt1.x, y: carPt1.y, z: carPt1.z },
