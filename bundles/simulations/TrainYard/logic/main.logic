        color: "#0284c7"
      },
      {
        id: "sedan-roof",
        type: "box",
        width: 0.32,
        height: 0.22,
        depth: 0.44,
        position: { x: 0, y: 0.36, z: -0.05 },
        color: "#f8fafc"
      },
      {
        id: "sedan-wheel-fl",
        type: "cylinder",
        radius: 0.08,
        height: 0.07,
        position: { x: -0.20, y: 0.08, z: 0.26 },
        rotation: { x: 0, y: 0, z: Math.PI / 2 },
        color: "#09090b"
      },
      {
        id: "sedan-wheel-fr",
        type: "cylinder",
        radius: 0.08,
        height: 0.07,
        position: { x: 0.20, y: 0.08, z: 0.26 },
        rotation: { x: 0, y: 0, z: Math.PI / 2 },
        color: "#09090b"
      },
      {
        id: "sedan-wheel-rl",
        type: "cylinder",
        radius: 0.08,
        height: 0.07,
        position: { x: -0.20, y: 0.08, z: -0.26 },
        rotation: { x: 0, y: 0, z: Math.PI / 2 },
        color: "#09090b"
      },
      {
        id: "sedan-wheel-rr",
        type: "cylinder",
        radius: 0.08,
        height: 0.07,
        position: { x: 0.20, y: 0.08, z: -0.26 },
        rotation: { x: 0, y: 0, z: Math.PI / 2 },
        color: "#09090b"
      },
      {
        id: "sedan-light-l",
        type: "sphere",
        radius: 0.045,
        position: { x: -0.13, y: 0.18, z: 0.43 },
        color: "#fef08a",
        emissive: lightsEnabled && isNight ? "#fef08a" : "#000000"
      },
      {
        id: "sedan-light-r",
        type: "sphere",
        radius: 0.045,
        position: { x: 0.13, y: 0.18, z: 0.43 },
        color: "#fef08a",
        emissive: lightsEnabled && isNight ? "#fef08a" : "#000000"
      }
    ]
  });

  // 10. Physical Front-of-Table Controls
  // Control 1: Throttle Lever
  let throttleX = -5.8 + trainSpeed * 2.6;
  list.push({
    id: "ctrl-throttle-lever",
    type: "group",
    position: { x: throttleX, y: 0.35, z: 9.42 },
    cursor: "grab",
    interactive: true,
    children: [
      {
        id: "ctrl-throttle-shaft",
        type: "cylinder",
        radius: 0.04,
        height: 0.44,
        position: { x: 0, y: 0, z: 0.06 },
        color: "#cbd5e1",
        metalness: 0.9
      },
      {
        id: "ctrl-throttle-knob",
        type: "sphere",
        radius: 0.15,
        position: { x: 0, y: 0.25, z: 0.08 },
        color: "#fbbf24",
        metalness: 0.85,
        roughness: 0.2
      }
    ]
  });

  // Control 2: Direction Switch
  list.push({
    id: "ctrl-switch-dir",
    type: "box",
    width: 0.12,
    height: 0.36,
    depth: 0.14,
    position: { x: -1.8, y: 0.35, z: 9.44 },
    rotation: { x: trainDirection > 0 ? 0.38 : -0.38, y: 0, z: 0 },
    color: trainDirection > 0 ? "#38bdf8" : "#f59e0b",
    cursor: "pointer",
    interactive: true
  });

  // Control 3: Steam Whistle Plunger Button
  list.push({
    id: "ctrl-btn-whistle",
    type: "cylinder",
    radius: 0.20,
    height: 0.14,
    position: { x: 0.0, y: 0.35, z: whistleActive ? 9.38 : 9.46 },
    rotation: { x: Math.PI / 2, y: 0, z: 0 },
    color: "#ef4444",
    emissive: whistleActive ? "#ef4444" : "#000000",
    emissiveIntensity: whistleActive ? 2.0 : 0.0,
    cursor: "pointer",
    interactive: true
  });

  // Control 4: Turntable Rotary Dial
  list.push({
    id: "ctrl-turntable",
    type: "cylinder",
    radius: 0.24,
    height: 0.14,
    position: { x: 1.8, y: 0.35, z: 9.44 },
    rotation: { x: Math.PI / 2, y: 0, z: turntableAngle * 2.0 },
    color: "#d97706",
    metalness: 0.75,
    cursor: "pointer",
    interactive: true
  });
  list.push({
    id: "ctrl-turntable-pointer",
    type: "box",
    width: 0.04,
    height: 0.22,
    depth: 0.16,
    position: {
      x: 1.8 + Math.sin(-turntableAngle * 2.0) * 0.12,
      y: 0.35 + Math.cos(-turntableAngle * 2.0) * 0.12,
      z: 9.48
    },
    rotation: { x: 0, y: 0, z: turntableAngle * 2.0 },
    color: "#ffffff"
  });

  // Control 5: Night Lights Toggle Switch & Green Neon Indicator Lamp
  list.push({
    id: "ctrl-switch-lights",
    type: "box",
    width: 0.12,
    height: 0.36,
    depth: 0.14,
    position: { x: 3.8, y: 0.35, z: 9.44 },
    rotation: { x: lightsEnabled ? 0.38 : -0.38, y: 0, z: 0 },
    color: lightsEnabled ? "#22c55e" : "#64748b",
    cursor: "pointer",
    interactive: true
  });
  list.push({
    id: "ctrl-lamp-lights",
    type: "sphere",
    radius: 0.08,
    position: { x: 3.8, y: 0.58, z: 9.42 },
    color: lightsEnabled ? "#4ade80" : "#1e293b",
    emissive: lightsEnabled ? "#22c55e" : "#000000",
    emissiveIntensity: lightsEnabled ? 3.0 : 0.0,
    cursor: "pointer",
    interactive: true
  });

  return list;
}

// Build Lighting based on Day-Night cycle
function buildLights() {
  let list = [];

  let locoPt = getTrackPoint(trainProgress);
  let locoHead = getTrackHeading(trainProgress);

  if (timeProgress >= 0.1 && timeProgress <= 0.42) {
    // Bright Sunny Midday (Cinematic Warm Sunlight + Rich Ambient Fill)
    timeLabel = "12:00 PM (Midday)";
    skyColor = "#60a5fa";

    // Primary High Sun
    list.push({
      id: "sun-main",
      type: "directional",
      color: "#fffbeb",
      intensity: 1.65,
      position: { x: 8, y: 18, z: 12 },
      castShadow: true,
      follow: "view",
      shadowMapSize: 2048,
      shadowCameraSize: 20,
      shadowBias: -0.0003
    });

    // Opposite Sky Fill Light
    list.push({
      id: "sky-fill",
      type: "directional",
      color: "#bae6fd",
      intensity: 0.7,
      position: { x: -10, y: 14, z: -10 }
    });

    // Rich Ambient Daylight
    list.push({
      id: "ambient",
      type: "ambient",
      color: "#cbd5e1",
      intensity: 0.65
    });

  } else if (timeProgress > 0.42 && timeProgress <= 0.58) {
    // Golden Hour Sunset
    timeLabel = "06:45 PM (Golden Hour)";
    skyColor = "#fb923c";

    list.push({
      id: "sun-sunset",
      type: "directional",
      color: "#f97316",
      intensity: 1.55,
      position: { x: 16, y: 7, z: 8 },
      castShadow: true,
      follow: "view",
      shadowMapSize: 2048,
      shadowCameraSize: 20,
      shadowBias: -0.0003
    });

    list.push({
      id: "sunset-fill",
      type: "directional",
      color: "#a855f7",
      intensity: 0.5,
      position: { x: -12, y: 8, z: -8 }
    });

    list.push({
      id: "ambient",
      type: "ambient",
      color: "#fed7aa",
      intensity: 0.55
    });

  } else {
    // Starry Night — deep moonlight contrast so Night Lights glow dramatically
    timeLabel = "11:00 PM (Night)";
    skyColor = "#060a14";

    // Crisp cool moonlight
    list.push({
      id: "moon",
      type: "directional",
      color: "#93c5fd",
      intensity: lightsEnabled ? 0.36 : 0.24,
      position: { x: -8, y: 16, z: -6 },
      castShadow: true,
      follow: "view",
      shadowMapSize: 2048,
      shadowCameraSize: 20,
      shadowBias: -0.0003
    });

    list.push({
      id: "ambient",
      type: "ambient",
      color: "#1e1b4b",
      intensity: lightsEnabled ? 0.26 : 0.16
    });
  }

  if (lightsEnabled) {
    let lampMult = isNight ? 1.0 : (timeProgress > 0.42 && timeProgress <= 0.58 ? 0.62 : 0.28);

    // Forward Locomotive Headlight Beam
    list.push({
      id: "light-loco-beam",
      type: "point",
      color: "#fef08a",
      intensity: 5.8 * lampMult,
      distance: 10.5,
      decay: 1.55,
      position: {
        x: locoPt.x + Math.sin(locoHead) * 1.55,
        y: locoPt.y + 0.95,
        z: locoPt.z + Math.cos(locoHead) * 1.55
      }
    });

    // Warm station platform glow
    list.push({
      id: "light-station",
      type: "point",
      color: "#fde68a",
      intensity: 4.8 * lampMult,
      distance: 10.5,
      decay: 1.6,
      position: { x: 0.0, y: 2.0, z: 6.7 }
    });

    // Town street lamp glow
    list.push({
      id: "light-town",
      type: "point",
      color: "#fed7aa",
      intensity: 4.4 * lampMult,
      distance: 9.5,
      decay: 1.6,
      position: { x: 3.5, y: 2.3, z: 7.3 }
    });

    // Roundhouse Terminal interior glow
    list.push({
      id: "light-roundhouse",
      type: "point",
      color: "#fbbf24",
      intensity: 4.6 * lampMult,
      distance: 10.5,
      decay: 1.6,
      position: { x: -4.5, y: 2.2, z: -2.9 }
    });

    // Yard Floodlight Tower Pool
    list.push({
      id: "light-yard-pool",
      type: "point",
      color: "#fef9c3",
      intensity: 5.6 * lampMult,
      distance: 12.5,
      decay: 1.5,
      position: { x: -4.5, y: 4.9, z: 1.8 }
    });

    // Harbor Quay Lantern
    list.push({
      id: "light-harbor",
      type: "point",
      color: "#bae6fd",
      intensity: 3.6 * lampMult,
      distance: 8.5,
      decay: 1.6,
      position: { x: 5.4, y: 2.1, z: 1.2 }
    });
  }

  return list;
}

let hasInteracted = false;

function playSfx(path, volume) {
  if (!soundEnabled || !hasInteracted) return;
  if (typeof softn !== "undefined" && softn.audio && softn.audio.play) {
    softn.audio.play(path, { volume: volume || 0.5 });
  }
}

function toggleSound() {
  hasInteracted = true;
  soundEnabled = !soundEnabled;
  if (soundEnabled) {
    playSfx("assets/sfx/switch.wav", 0.45);
  } else {
    try {
      if (typeof softn !== "undefined" && softn.audio && softn.audio.stopAll) {
        softn.audio.stopAll();
      }
    } catch (err) {}
  }
}

// Game Step Loop
function gameStep(dt) {
  let delta = (typeof dt === "number" && dt > 0) ? Math.min(dt, 0.1) : 0.016;

  // 1. Train speed physics & rhythmic steam chuffing
  let speedDelta = targetSpeed - trainSpeed;
  trainSpeed = trainSpeed + speedDelta * Math.min(1.0, delta * 3.0);
  let speedFactor = 0.030;
  let prevProgress = trainProgress;
  trainProgress = (trainProgress + trainSpeed * trainDirection * delta * speedFactor) % 1.0;
  if (trainProgress < 0) trainProgress = trainProgress + 1.0;

  if (trainSpeed > 0.06) {
    chuffTimer = chuffTimer + delta * (0.65 + trainSpeed * 2.2);
    if (chuffTimer >= 0.46) {
      chuffTimer = 0.0;
      playSfx("assets/sfx/chuff.wav", 0.22);
    }
  }
  if (stationBellCooldown > 0) {
    stationBellCooldown = Math.max(0, stationBellCooldown - delta);
  }
  if ((prevProgress < 0.25 && trainProgress >= 0.25) || (prevProgress > 0.25 && trainProgress <= 0.25)) {
    if (stationBellCooldown <= 0 && trainSpeed > 0.15) {
      stationBellCooldown = 6.0;
      playSfx("assets/sfx/bell.wav", 0.35);
    }
  }

  // 2. Day-Night cycle & animated beacons/bell
  timeProgress = (timeProgress + delta * timeSpeed) % 1.0;
  isNight = timeProgress > 0.58 || timeProgress < 0.1;
  bellPhase = bellPhase + delta * (whistleActive ? 18.0 : 6.5);
  beaconPhase = beaconPhase + delta * 2.4;

  // 3. Turntable rotation
  let turnDelta = targetTurntableAngle - turntableAngle;
  if (Math.abs(turnDelta) > 0.01) {
    turntableAngle = turntableAngle + Math.sign(turnDelta) * Math.min(Math.abs(turnDelta), delta * 0.8);
  }

  // 4. Harbor Crane animation
  cranePhase = cranePhase + delta * 0.4;
  craneAngle = 0.35 + Math.sin(cranePhase) * 0.55;
  craneHoistY = 1.6 + Math.abs(Math.sin(cranePhase * 1.5)) * 0.9;

  // 5. Town road vehicles animation (Cruising in opposite lanes separated by half a lap, zero head-on collisions)
  carProgress1 = (carProgress1 + delta * 0.036) % 1.0;
  carProgress2 = (carProgress1 + 0.50) % 1.0;

  // 6. Whistle timer
  if (whistleActive) {
    whistleTimer = whistleTimer + delta;
    if (whistleTimer > 1.8) {
      whistleActive = false;
      whistleTimer = 0;
    }
  }

  // 7. Dynamic Camera tracking for "cab" ride mode (Faces travel direction in both FWD and REV)
  if (cameraMode === "cab") {
    if (trainDirection > 0) {
      let cabPt = getTrackPoint(trainProgress - 0.018);
      let aheadPt = getTrackPoint(trainProgress + 0.055);
      cameraPos = {
        x: cabPt.x,
        y: cabPt.y + 1.44,
        z: cabPt.z
      };
      cameraLookAt = {
        x: aheadPt.x,
        y: aheadPt.y + 0.72,
        z: aheadPt.z
      };
    } else {
      let revCabPt = getTrackPoint(trainProgress - 0.148);
      let revAheadPt = getTrackPoint(trainProgress - 0.215);
      cameraPos = {
        x: revCabPt.x,
        y: revCabPt.y + 1.42,
        z: revCabPt.z
      };
      cameraLookAt = {
        x: revAheadPt.x,
        y: revAheadPt.y + 0.70,
        z: revAheadPt.z
      };
    }
  }

  // 8. Rebuild dynamic objects and lights
  objects = buildDynamicObjects(delta);
  lights = buildLights();
}

// User Actions
function setSpeed(sp) {
  hasInteracted = true;
  targetSpeed = Math.max(0.0, Math.min(1.0, sp));
  playSfx("assets/sfx/switch.wav", 0.4);
}

function stepThrottle(stepDir) {
  let stops = [0.0, 0.35, 0.7, 1.0];
  let nearest = 0;
  let bestDiff = 999;
  for (let i = 0; i < stops.length; i = i + 1) {
    let d = Math.abs(targetSpeed - stops[i]);
    if (d < bestDiff) {
      bestDiff = d;
      nearest = i;
    }
  }
  let nextIdx = Math.max(0, Math.min(stops.length - 1, nearest + stepDir));
  setSpeed(stops[nextIdx]);
}

function toggleDirection() {
  hasInteracted = true;
  trainDirection = trainDirection * -1;
  playSfx("assets/sfx/switch.wav", 0.5);
}

function blowWhistle() {
  hasInteracted = true;
  whistleActive = true;
  whistleTimer = 0.0;
  playSfx("assets/sfx/whistle.wav", 0.72);
  playSfx("assets/sfx/bell.wav", 0.42);
}

function rotateTurntableNext() {
  hasInteracted = true;
  turntableStall = (turntableStall + 1) % 4;
  let sideStallAngle = Math.atan2(1.25, 2.68);
  let angles = [0.0, sideStallAngle, -sideStallAngle, Math.PI / 2];
  targetTurntableAngle = angles[turntableStall];
  playSfx("assets/sfx/bell.wav", 0.4);
}

function cycleTimeOfDay() {
  hasInteracted = true;
  if (timeProgress < 0.35) {
    timeProgress = 0.48; // Sunset
  } else if (timeProgress < 0.65) {
    timeProgress = 0.72; // Night
  } else {
    timeProgress = 0.2; // Midday
  }
  playSfx("assets/sfx/switch.wav", 0.4);
}

function toggleLights() {
  hasInteracted = true;
  lightsEnabled = !lightsEnabled;
  playSfx("assets/sfx/switch.wav", 0.5);
}

function setCameraView(mode) {
  hasInteracted = true;
  cameraMode = mode;
  if (mode === "front") {
    cameraPos = { x: 0, y: 7.2, z: 15.5 };
    cameraLookAt = { x: 0, y: 0.8, z: 1.0 };
    cameraFov = 46;
  } else if (mode === "cab") {
    cameraFov = 54;
  } else if (mode === "tower") {
    cameraPos = { x: -9.5, y: 8.5, z: 6.5 };
    cameraLookAt = { x: -3.5, y: 1.0, z: -1.0 };
    cameraFov = 50;
  } else if (mode === "harbor") {
    cameraPos = { x: 12.0, y: 4.8, z: 8.5 };
    cameraLookAt = { x: 6.0, y: 1.2, z: 1.8 };
    cameraFov = 45;
  } else if (mode === "overhead") {
    cameraPos = { x: 0, y: 22.0, z: 0.1 };
    cameraLookAt = { x: 0, y: 0, z: 0 };
    cameraFov = 52;
  }
  playSfx("assets/sfx/switch.wav", 0.35);
}

// In-World 3D Object Click Handler
function handleSceneClick(hit) {
  if (!hit) return;
  let rootId = hit.rootObjectId || hit.objectId || "";
  let leafId = hit.objectId || rootId;
  if (!rootId && !leafId) return;
  hasInteracted = true;

  if (leafId === "ctrl-tick-0" || rootId === "ctrl-tick-0") {
    setSpeed(0.0);
  } else if (leafId === "ctrl-tick-1" || rootId === "ctrl-tick-1") {
    setSpeed(0.35);
  } else if (leafId === "ctrl-tick-2" || rootId === "ctrl-tick-2") {
    setSpeed(0.7);
  } else if (leafId === "ctrl-tick-3" || rootId === "ctrl-tick-3") {
    setSpeed(1.0);
  } else if (rootId === "loco-hero" || rootId === "train-loco" || rootId.indexOf("loco-") === 0 || leafId.indexOf("loco-") === 0) {
    blowWhistle();
  } else if (
    rootId.indexOf("ctrl-throttle") !== -1 ||
    leafId.indexOf("ctrl-throttle") !== -1 ||
    rootId === "ctrl-slot" ||
    rootId === "ctrl-bezel-throttle"
  ) {
    if (hit.point && (rootId === "ctrl-slot" || rootId === "ctrl-bezel-throttle")) {
      let norm = Math.max(0.0, Math.min(1.0, (hit.point.x - (-5.8)) / 2.6));
      if (norm < 0.18) setSpeed(0.0);
      else if (norm < 0.52) setSpeed(0.35);
      else if (norm < 0.85) setSpeed(0.7);
      else setSpeed(1.0);
    } else if (targetSpeed < 0.18) {
      setSpeed(0.35);
    } else if (targetSpeed < 0.52) {
      setSpeed(0.7);
    } else if (targetSpeed < 0.85) {
      setSpeed(1.0);
    } else {
      setSpeed(0.0);
    }
  } else if (rootId === "ctrl-switch-dir" || rootId === "ctrl-bezel-dir" || leafId === "ctrl-switch-dir") {
    toggleDirection();
  } else if (rootId === "ctrl-btn-whistle" || rootId === "ctrl-bezel-whistle" || leafId === "ctrl-btn-whistle") {
    blowWhistle();
  } else if (
    rootId.indexOf("ctrl-turntable") !== -1 ||
    leafId.indexOf("ctrl-turntable") !== -1 ||
    rootId === "ctrl-bezel-turntable" ||
    rootId === "turntable-bridge" ||
    rootId === "turntable-pit" ||
    rootId === "turntable-pivot"
  ) {
    rotateTurntableNext();
  } else if (
    rootId === "ctrl-switch-lights" ||
    rootId === "ctrl-lamp-lights" ||
    rootId === "ctrl-bezel-lights" ||
    rootId.indexOf("signal-gantry") === 0 ||
    rootId.indexOf("yard-tower") === 0
  ) {
    toggleLights();
  }
}

function _init() {
  if (typeof window !== "undefined") {
    if (window.__tyKeyCleanup) {
      window.__tyKeyCleanup();
    }
    let onKeyDown = function (e) {
      if (!e || e.ctrlKey || e.metaKey || e.altKey) return;
      let rawTag = e.targetTag || (e.target && e.target.tagName) || "";
      let tag = rawTag ? String(rawTag).toUpperCase() : "";
      if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT") return;
      let key = e.key || "";
      let low = key.toLowerCase();
      if (key === " " || e.code === "Space") {
        if (e.preventDefault) e.preventDefault();
        if (!e.repeat) blowWhistle();
      } else if (key === "ArrowUp") {
        if (e.preventDefault) e.preventDefault();
        stepThrottle(1);
      } else if (key === "ArrowDown") {
        if (e.preventDefault) e.preventDefault();
        stepThrottle(-1);
      } else if (low === "r" && !e.repeat) {
        toggleDirection();
      } else if (key === "1") {
        setCameraView("front");
      } else if (key === "2") {
        setCameraView("cab");
      } else if (key === "3") {
        setCameraView("tower");
      } else if (key === "4") {
        setCameraView("harbor");
      } else if (key === "5") {
        setCameraView("overhead");
      } else if (low === "t" && !e.repeat) {
        rotateTurntableNext();
      } else if (low === "l" && !e.repeat) {
        toggleLights();
      } else if (low === "m" && !e.repeat) {
        toggleSound();
      }
    };
    window.addEventListener("keydown", onKeyDown);
    window.__tyKeyCleanup = function () {
      window.removeEventListener("keydown", onKeyDown);
    };
  }
  gameStep(0.016);
}

function _onHide() {
  whistleActive = false;
  whistleTimer = 0.0;
  if (typeof window !== "undefined" && window.__tyKeyCleanup) {
    window.__tyKeyCleanup();
    window.__tyKeyCleanup = null;
  }
  try {
    if (typeof softn !== "undefined" && softn.audio && softn.audio.stopAll) {
      softn.audio.stopAll();
    }
  } catch (err) {}
}

// Initialize on load
gameStep(0.016);
