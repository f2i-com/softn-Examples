let stationBellCooldown = 0.0;
let bellPhase = 0.0;
let beaconPhase = 0.0;

// Day-Night cycle
let timeProgress = 0.2; // 0.2 = bright sunny day, 0.48 = golden hour sunset, 0.72 = starry night
let isNight = false;
let lightsEnabled = true;
let timeSpeed = 0.003;
let skyColor = "#60a5fa";
let timeLabel = "12:00 PM (Midday)";

// Turntable state
let turntableAngle = 0.0;
