    textureRepeat: { x: 6, y: 4 },
    receiveShadow: true
  });

  // Dark Mahogany Table Edge Fascia Panels
  list.push({
    id: "table-fascia-front",
    type: "box",
    width: 30.4,
    height: 1.2,
    depth: 0.4,
    position: { x: 0, y: 0.3, z: 9.1 },
    color: "#381c0d",
    texture: "wood",
    textureRepeat: { x: 8, y: 1 },
    roughness: 0.35
  });
  list.push({
    id: "table-fascia-back",
    type: "box",
    width: 30.4,
    height: 1.2,
    depth: 0.4,
    position: { x: 0, y: 0.3, z: -9.1 },
    color: "#381c0d",
    roughness: 0.35
  });
  list.push({
    id: "table-fascia-left",
    type: "box",
    width: 0.4,
    height: 1.2,
    depth: 18.6,
    position: { x: -15.1, y: 0.3, z: 0 },
    color: "#381c0d",
    roughness: 0.35
  });
  list.push({
    id: "table-fascia-right",
    type: "box",
    width: 0.4,
    height: 1.2,
    depth: 18.6,
    position: { x: 15.1, y: 0.3, z: 0 },
    color: "#381c0d",
    roughness: 0.35
  });

  // 4 Turned Heavy Mahogany Table Legs
  let legs = [
    { x: -14.2, z: -8.2 },
    { x: 14.2, z: -8.2 },
    { x: -14.2, z: 8.2 },
    { x: 14.2, z: 8.2 }
  ];
  for (let i = 0; i < legs.length; i = i + 1) {
    list.push({
      id: "table-leg-" + i,
      type: "cylinder",
      radius: 0.38,
      height: 4.1,
      position: { x: legs[i].x, y: -1.85, z: legs[i].z },
      color: "#2b1509",
      roughness: 0.45
    });
  }

  // Layout Green Turf Mat
  list.push({
    id: "layout-turf",
    type: "box",
    width: 29.8,
    height: 0.08,
    depth: 17.8,
    position: { x: 0, y: 0.52, z: 0 },
    color: "#3f6212",
    texture: "grass",
    textureRepeat: { x: 12, y: 8 },
    receiveShadow: true,
    roughness: 0.95
  });

  // Continuous Mainline Track: 90 Uniform Segments with Ballast, Wood Ties & Twin Steel Rails
  let NUM_TIES = 90;
  for (let i = 0; i < NUM_TIES; i = i + 1) {
    let u = i / NUM_TIES;
    let pt = getTrackPoint(u);
    let head = getTrackHeading(u);
    let trackRot = getTrackRotation(u);
    let cosH = Math.cos(head);
    let sinH = Math.sin(head);

    // Ballast roadbed box
    list.push({
      id: "ballast-" + i,
      type: "box",
      width: 0.92,
      height: 0.06,
      depth: 0.72,
      position: { x: pt.x, y: pt.y - 0.035, z: pt.z },
      rotation: trackRot,
      color: "#6b7280",
      texture: "stone",
      receiveShadow: true,
      flatShading: true
    });

    // Dark creosote wood cross-tie (sleeper)
    list.push({
      id: "tie-" + i,
      type: "box",
      width: 0.74,
      height: 0.035,
      depth: 0.16,
      position: { x: pt.x, y: pt.y - 0.005, z: pt.z },
      rotation: trackRot,
      color: "#3e2723",
      texture: "wood",
      receiveShadow: true
    });

    // Left Steel Rail
    list.push({
      id: "rail-l-" + i,
      type: "box",
      width: 0.04,
      height: 0.05,
      depth: 0.72,
      position: {
        x: pt.x - cosH * 0.22,
        y: pt.y + 0.02,
        z: pt.z + sinH * 0.22
      },
      rotation: trackRot,
      color: "#cbd5e1",
      texture: "metal",
      metalness: 0.8,
      roughness: 0.25
    });

    // Right Steel Rail
    list.push({
      id: "rail-r-" + i,
      type: "box",
      width: 0.04,
      height: 0.05,
      depth: 0.72,
      position: {
        x: pt.x + cosH * 0.22,
        y: pt.y + 0.02,
        z: pt.z - sinH * 0.22
      },
      rotation: trackRot,
      color: "#cbd5e1",
      texture: "metal",
      metalness: 0.8,
      roughness: 0.25
    });
  }

  // Masonry Viaduct: a stone pier under every other tie of the elevated
  // section, each one rising from the turf (y = 0.56) to just beneath the
  // ballast so the climb is visibly carried rather than floating.
  let DECK_TOP = 0.56;
  for (let i = 0; i < NUM_TIES; i = i + 1) {
    let pt = getTrackPoint(i / NUM_TIES);
    let ballastBottom = pt.y - 0.065;
    if (ballastBottom - DECK_TOP < 0.12 || i % 2 === 0) continue;
    let head = getTrackHeading(i / NUM_TIES);
    let pierH = ballastBottom - DECK_TOP + 0.02;
    list.push({
      id: "viaduct-pier-" + i,
      type: "box",
      width: 0.5,
      height: pierH,
      depth: 0.62,
      position: { x: pt.x, y: DECK_TOP - 0.02 + pierH / 2, z: pt.z },
      rotation: { x: 0, y: head, z: 0 },
      color: "#78716c",
      flatShading: true,
      castShadow: true,
      receiveShadow: true
    });
  }

  // Alpine Mountain Backdrop along Rear Table Edge (bases stay inside the back
  // fascia at z = -8.9 and clear the mainline, which runs no further back than
  // z = -5.8 at x = 0 and curves forward towards the corners)
  list.push({
    id: "mountain-ridge-right",
    type: "cone",
    radius: 2.0,
    height: 4.8,
    position: { x: 10.5, y: 2.9, z: -7.2 },
    color: "#57534e",
    flatShading: true,
    castShadow: true
  });
  list.push({
    id: "mountain-ridge-center",
    type: "box",
    width: 12.0,
    height: 3.5,
    depth: 1.8,
    position: { x: 0.0, y: 2.2, z: -8.0 },
    color: "#44403c",
    flatShading: true,
    castShadow: true
  });
  list.push({
    id: "mountain-ridge-left",
    type: "cone",
    radius: 2.0,
    height: 4.5,
    position: { x: -9.5, y: 2.75, z: -7.2 },
    color: "#57534e",
    flatShading: true,
    castShadow: true
  });

  // Classification Yard Tracks (3 Staging tracks in the yard area, clear of mainline)
  let yardTracks = [
    { z: 0.6, x1: -7.5, x2: 0.5 },
    { z: 1.8, x1: -7.0, x2: -0.5 },
    { z: 3.0, x1: -6.5, x2: -1.5 }
  ];
  for (let y = 0; y < yardTracks.length; y = y + 1) {
    let yt = yardTracks[y];
    let len = yt.x2 - yt.x1;
    let midX = (yt.x1 + yt.x2) / 2;
    list.push({
      id: "yard-bed-" + y,
      type: "box",
      width: len,
      height: 0.05,
      depth: 0.8,
      position: { x: midX, y: 0.585, z: yt.z },
      color: "#57534e",
      receiveShadow: true
    });
    list.push({
      id: "yard-rail-l-" + y,
      type: "box",
      width: len,
      height: 0.04,
      depth: 0.035,
      position: { x: midX, y: 0.63, z: yt.z - 0.22 },
      color: "#cbd5e1",
      metalness: 0.85
    });
    list.push({
      id: "yard-rail-r-" + y,
      type: "box",
      width: len,
      height: 0.04,
      depth: 0.035,
      position: { x: midX, y: 0.63, z: yt.z + 0.22 },
