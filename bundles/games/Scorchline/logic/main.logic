function scPrivate() { return scPrivate.data; }
function clamp(v,a,b) { return Math.max(a,Math.min(b,v)); }
function dist2(a,b) { let x=a.x-b.x;let y=a.y-b.y;return x*x+y*y; }
function own(o,k) { return Object.prototype.hasOwnProperty.call(o,k); }
function scRandom(s) { s.rng=(s.rng*1664525+1013904223)>>>0;return s.rng/4294967296; }
function scDef(e) { return e.building ? SC_BUILDINGS[e.type] : SC_UNITS[e.type]; }
function scCost(s,team,type,building) { let d=building?SC_BUILDINGS[type]:SC_UNITS[type];return Math.round(d.cost*(building&&s.players[team].faction===1?.9:1)); }
function scHas(s,team,type) { for(let i=0;i<s.buildings.length;i++){let b=s.buildings[i];if(b.team===team&&b.type===type&&b.hp>0&&b.complete)return true;}return false; }
function scCount(s,team,type,buildings) { let a=buildings?s.buildings:s.units;let n=0;for(let i=0;i<a.length;i++)if(a[i].hp>0&&a[i].team===team&&(!type||a[i].type===type))n++;return n; }
function scGet(s,id) { for(let i=0;i<s.units.length;i++)if(s.units[i].id===id&&s.units[i].hp>0)return s.units[i];for(let i=0;i<s.buildings.length;i++)if(s.buildings[i].id===id&&s.buildings[i].hp>0)return s.buildings[i];return null; }
function scNotice(s,text,team) { if(team===0||team===undefined){s.message=text;s.messageUntil=s.tick+80;s.log.unshift({tick:s.tick,text:text});if(s.log.length>8)s.log.pop();} }
