// ========== NAVIGATION ==========
// Shared reverse breadth-first fields: one goal is reused by an entire army.
// Four-connected global paths with checked local steering; no diagonal corner cutting.
function scCache() { return {version:-1,blocked:[],terrain:[],flows:[],budget:3,spatial:{}}; }
function scRebuildNav(s,c) {
 if(c.version===s.navVersion)return;
 c.terrain=new Array(SC_W*SC_H).fill(0);let list=MAP_BLOCKS[s.map];
 for(let i=0;i<list.length;i++)c.terrain[list[i]]=1;
 c.blocked=c.terrain.slice();
 for(let i=0;i<s.buildings.length;i++){
  let b=s.buildings[i];if(b.hp<=0)continue;let d=SC_BUILDINGS[b.type];
  let x0=Math.round(b.x-d.w/2),y0=Math.round(b.y-d.h/2);
  for(let y=y0;y<y0+d.h;y++)for(let x=x0;x<x0+d.w;x++)if(x>=0&&y>=0&&x<64&&y<48)c.blocked[y*64+x]=1;
 }
 c.version=s.navVersion;c.flows=[];
}
function scCell(c,x,y) { x=Math.floor(x);y=Math.floor(y);return x>=1&&y>=1&&x<63&&y<47&&!c.blocked[y*64+x]; }
function scWalk(c,x,y,r) { return scCell(c,x-r,y)&&scCell(c,x+r,y)&&scCell(c,x,y-r)&&scCell(c,x,y+r); }
function scNearestFree(c,x,y,r) {
 let xx=clamp(Math.floor(x),1,62),yy=clamp(Math.floor(y),1,46);
 if(scWalk(c,xx+.5,yy+.5,r||.2))return {x:xx+.5,y:yy+.5};
 for(let n=1;n<12;n++)for(let j=-n;j<=n;j++)for(let i=-n;i<=n;i++){
  if(Math.abs(i)!==n&&Math.abs(j)!==n)continue;
  if(scWalk(c,xx+i+.5,yy+j+.5,r||.2))return {x:xx+i+.5,y:yy+j+.5};
 }
 return null;
}
function scFlow(s,c,x,y) {
 let g=scNearestFree(c,x,y,.2);if(!g)return null;
 let goal=Math.floor(g.y)*64+Math.floor(g.x);
 for(let i=0;i<c.flows.length;i++)if(c.flows[i].goal===goal)return c.flows[i];
 if(c.budget<=0)return null;c.budget--;
 let ds=new Array(3072).fill(99999),queue=[goal],head=0;ds[goal]=0;
 while(head<queue.length){let a=queue[head++],nd=ds[a]+1;let ns=[a-64,a-1,a+1,a+64];
  for(let j=0;j<4;j++){let b=ns[j];if(b<0||b>=3072||c.blocked[b]||ds[b]<=nd)continue;if(j===1&&a%64===0)continue;if(j===2&&a%64===63)continue;ds[b]=nd;queue.push(b);}
 }
 let f={goal:goal,x:g.x,y:g.y,ds:ds};c.flows.push(f);if(c.flows.length>24)c.flows.shift();return f;
}
function scLine(c,x,y,xx,yy,terrainOnly,r) {
 let n=Math.ceil(Math.max(Math.abs(xx-x),Math.abs(yy-y))*3);n=Math.max(1,n);
 for(let i=1;i<=n;i++){
  let u=x+(xx-x)*i/n,v=y+(yy-y)*i/n;
  if(terrainOnly){if(u<0||v<0||u>=64||v>=48||c.terrain[Math.floor(v)*64+Math.floor(u)])return false;}
  else if(!scWalk(c,u,v,r||.2))return false;
 }
 return true;
}
function scSpatial(s,c) {
 c.spatial={};
 for(let i=0;i<s.units.length;i++){let u=s.units[i];if(u.hp<=0)continue;let k=Math.floor(u.x)+','+Math.floor(u.y);if(!c.spatial[k])c.spatial[k]=[];c.spatial[k].push(u);}
}
function scNearUnits(c,x,y,r) {
 let out=[];
 for(let yy=Math.floor(y-r);yy<=Math.floor(y+r);yy++)for(let xx=Math.floor(x-r);xx<=Math.floor(x+r);xx++){
  let a=c.spatial[xx+','+yy];if(a)for(let j=0;j<a.length;j++)out.push(a[j]);
 }
 return out;
}
function scMove(s,c,u,gx,gy,fx,fy) {
 let d=SC_UNITS[u.type],r=d.radius;let dd=(u.x-fx)*(u.x-fx)+(u.y-fy)*(u.y-fy);
 if(dd<.06){u.moving=false;return true;}
 let tx=fx,ty=fy;
 if(dd>5||!scLine(c,u.x,u.y,fx,fy,false,r)){
  let f=scFlow(s,c,gx,gy);if(!f){u.moving=false;return false;}
  let cx=clamp(Math.floor(u.x),1,62),cy=clamp(Math.floor(u.y),1,46),at=cy*64+cx;
  if(f.ds[at]>=99999){u.stuck++;u.moving=false;return false;}
  if(u.way&&u.way.version===s.navVersion&&((u.x-u.way.x)*(u.x-u.way.x)+(u.y-u.way.y)*(u.y-u.way.y)>.025)){
   tx=u.way.x;ty=u.way.y;
  }else{
   let best=at,score=f.ds[at],ns=[at-64,at-1,at+1,at+64];
   for(let i=0;i<4;i++){let a=ns[i];if(a>=0&&a<3072&&f.ds[a]<score){score=f.ds[a];best=a;}}
   tx=best%64+.5;ty=Math.floor(best/64)+.5;
   u.way={x:tx,y:ty,version:s.navVersion};
   if(best===at){tx=f.x;ty=f.y;}
  }
 }
 let dx=tx-u.x,dy=ty-u.y,len=Math.sqrt(dx*dx+dy*dy);if(len<.01){u.way=null;return false;}
 let speed=d.speed*(s.players[u.team].faction===1?1.18:1)*SC_DT;
 let step=Math.min(speed,len);let mx=dx/len*step,my=dy/len*step;
 let neighbors=scNearUnits(c,u.x,u.y,1),ax=0,ay=0;
 for(let j=0;j<neighbors.length;j++){
  let v=neighbors[j];if(v.id===u.id||v.hp<=0)continue;let vx=u.x-v.x,vy=u.y-v.y,rr=r+SC_UNITS[v.type].radius+.05,ds=vx*vx+vy*vy;
  if(ds<rr*rr){if(ds<.0001){vx=(u.id%2?1:-1)*.02;vy=.01;ds=.0005;}
   let le=Math.sqrt(ds),force=(rr-le)*.24;ax+=vx/le*force;ay+=vy/le*force;
  }
 }
 mx+=clamp(ax,-speed*.65,speed*.65);my+=clamp(ay,-speed*.65,speed*.65);
 let ox=u.x,oy=u.y;
 if(scWalk(c,u.x+mx,u.y+my,r)){u.x+=mx;u.y+=my;}
 else if(scWalk(c,u.x+mx,u.y,r))u.x+=mx;
 else if(scWalk(c,u.x,u.y+my,r))u.y+=my;
 else {u.way=null;u.stuck++;}
 if(Math.abs(u.x-ox)+Math.abs(u.y-oy)>.003){u.angle=Math.atan2(u.y-oy,u.x-ox)+Math.PI/2;u.moving=true;u.stuck=0;}else u.moving=false;
 return dd<.06;
}
function scSpawnPoint(s,c,b,type) {
 let d=SC_BUILDINGS[b.type],r=SC_UNITS[type].radius;
 let candidates=[];
 for(let ring=0;ring<5;ring++){
  let w=d.w/2+.8+ring*.6,h=d.h/2+.8+ring*.6;
  for(let i=-2;i<=2;i++){candidates.push({x:b.x+i*.7,y:b.y+h});candidates.push({x:b.x+w,y:b.y+i*.7});candidates.push({x:b.x-w,y:b.y+i*.7});candidates.push({x:b.x+i*.7,y:b.y-h});}
 }
 for(let i=0;i<candidates.length;i++){
  let p=candidates[i];if(!scWalk(c,p.x,p.y,r))continue;
  let ok=true;for(let j=0;j<s.units.length;j++){let u=s.units[j];if(u.hp>0&&dist2(u,p)<Math.pow(r+SC_UNITS[u.type].radius+.10,2)){ok=false;break;}}
  if(ok)return p;
 }
 return null;
}


// ========== SIMULATION ==========
function scNewSimulation(map,faction,difficulty,seed) {
 let s={version:SC_VERSION,map:map,tick:0,rng:seed>>>0,seed:seed>>>0,difficulty:difficulty,nextId:1,navVersion:1,units:[],buildings:[],fields:[],shots:[],fx:[],log:[],sounds:[],message:"",messageUntil:0,result:"",nextSurge:2100,players:[],visible:[new Array(3072).fill(0),new Array(3072).fill(0)],explored:[new Array(3072).fill(0),new Array(3072).fill(0)],ai:{nextThink:0,nextAttack:0,known:[],scouted:false},orders:[]};
 for(let t=0;t<2;t++)s.players.push({faction:t===0?faction:1-faction,cash:2400,power:0,use:0,kills:0,lost:0,harvested:0,upgrades:{armor:false,weapons:false},research:null});
 for(let t=0;t<2;t++){
  let flip=function(x,y){return t===0?{x:x,y:y}:{x:64-x,y:48-y};};
  let p=flip(10.5,12.5);scAddBuilding(s,t,"core",p.x,p.y,true);
  p=flip(6,10);scAddBuilding(s,t,"power",p.x,p.y,true);
  p=flip(6.5,14.5);scAddBuilding(s,t,"refinery",p.x,p.y,true);
  p=flip(9.5,17.5);scAddUnit(s,t,"harvester",p.x,p.y);
  p=flip(15.5,14.5);scAddUnit(s,t,"scout",p.x,p.y);
  p=flip(13.5,16.5);scAddUnit(s,t,"rifle",p.x,p.y);
  p=flip(14.5,16.5);scAddUnit(s,t,"rifle",p.x,p.y);
 }
 let deposits=[[6.5,20.5],[57.5,27.5],[21.5,8.5],[42.5,39.5],[24.5,27.5],[39.5,20.5]];
 for(let i=0;i<deposits.length;i++)s.fields.push({id:s.nextId++,x:deposits[i][0],y:deposits[i][1],amount:i<2?14000:10500,max:i<2?14000:10500});
 s.ai.nextAttack=[1600,1150,850][difficulty];
 scEconomy(s);scVision(s);scNotice(s,"Command uplink established. Build a Barracks, then a Vehicle Plant.");return s;
}
function scAddBuilding(s,team,type,x,y,complete) {
 let d=SC_BUILDINGS[type],max=Math.round(d.hp*(s.players[team].faction===0?1.18:1));
 let b={id:s.nextId++,team:team,type:type,building:true,x:x,y:y,hp:complete?max:max*.12,maxHp:max,complete:complete,work:complete?d.time:0,queue:[],rally:null,cooldown:0,target:0,repairing:false};
 s.buildings.push(b);s.navVersion++;return b;
}
function scAddUnit(s,team,type,x,y) {
 let d=SC_UNITS[type],max=Math.round(d.hp*(s.players[team].faction===0?1.18:1));
 let u={id:s.nextId++,team:team,type:type,building:false,x:x,y:y,hp:max,maxHp:max,angle:0,order:{kind:type==="harvester"?"harvest":"guard",x:x,y:y,fx:x,fy:y,target:0,field:0},orders:[],target:0,cooldown:0,cargo:0,phase:"seek",field:0,refinery:0,way:null,stuck:0,moving:false,kills:0};
 s.units.push(u);return u;
}
function scEconomy(s) {
 for(let t=0;t<2;t++){s.players[t].power=0;s.players[t].use=0;}
 for(let i=0;i<s.buildings.length;i++){let b=s.buildings[i];if(b.hp<=0||!b.complete)continue;let d=SC_BUILDINGS[b.type];s.players[b.team].power+=d.power;s.players[b.team].use+=d.use;}
}
function scVision(s) {
 for(let t=0;t<2;t++){
  let v=new Array(3072).fill(0),all=s.buildings.concat(s.units);
  for(let i=0;i<all.length;i++){
   let e=all[i];if(e.team!==t||e.hp<=0)continue;let r=scDef(e).sight;if(e.building&&!e.complete)r=3;
   if(e.type==="radar"&&s.players[t].use>s.players[t].power)r=6;
   let x0=Math.max(0,Math.floor(e.x-r)),x1=Math.min(63,Math.ceil(e.x+r)),y0=Math.max(0,Math.floor(e.y-r)),y1=Math.min(47,Math.ceil(e.y+r));
   for(let y=y0;y<=y1;y++)for(let x=x0;x<=x1;x++)if((x+.5-e.x)*(x+.5-e.x)+(y+.5-e.y)*(y+.5-e.y)<=r*r){v[y*64+x]=1;s.explored[t][y*64+x]=1;}
  }
  s.visible[t]=v;
 }
}
function scVisible(s,team,e) { return s.visible[team][clamp(Math.floor(e.y),0,47)*64+clamp(Math.floor(e.x),0,63)]===1; }
function scPlacement(s,c,team,type,x,y,skipVision) {
 if(!own(SC_BUILDINGS,type)||type==="core")return "Invalid structure";
 let d=SC_BUILDINGS[type];if(!scHas(s,team,d.requires))return "Requires "+SC_BUILDINGS[d.requires].name;
 let x0=Math.round(x-d.w/2),y0=Math.round(y-d.h/2);
 if(Math.abs(x0+d.w/2-x)>.01||Math.abs(y0+d.h/2-y)>.01)return "Snap the footprint to the grid";
 let near=false;
 for(let i=0;i<s.buildings.length;i++){let b=s.buildings[i];if(b.hp>0&&b.complete&&b.team===team&&dist2(b,{x:x,y:y})<100)near=true;}
 if(!near)return "Build within 10 tiles of a completed friendly structure";
 for(let yy=y0;yy<y0+d.h;yy++)for(let xx=x0;xx<x0+d.w;xx++){
  if(xx<1||yy<1||xx>=63||yy>=47||c.blocked[yy*64+xx])return "Terrain or structure blocks this footprint";
  if(!skipVision&&!s.visible[team][yy*64+xx])return "Scout the entire footprint first";
 }
 for(let i=0;i<s.units.length;i++){let u=s.units[i];if(u.hp>0&&Math.abs(u.x-x)<d.w/2+.5&&Math.abs(u.y-y)<d.h/2+.5)return "A unit is in the construction area";}
 for(let i=0;i<s.fields.length;i++){let f=s.fields[i];if(f.amount>0&&Math.abs(f.x-x)<d.w/2+1.25&&Math.abs(f.y-y)<d.h/2+1.25)return "Leave the Vitracite field accessible";}
 return "";
}
function scBuild(s,c,team,type,x,y,silent) {
 scRebuildNav(s,c);let error=scPlacement(s,c,team,type,x,y,false);
 let price=own(SC_BUILDINGS,type)?scCost(s,team,type,true):0;
 if(!error&&s.players[team].cash<price)error="Insufficient credits";
 if(!error){let n=0;for(let i=0;i<s.buildings.length;i++)if(s.buildings[i].team===team&&!s.buildings[i].complete&&s.buildings[i].hp>0)n++;if(n>=2)error="Two construction crews are already working";}
 if(error){if(!silent)scNotice(s,error,team);return null;}
 s.players[team].cash-=price;let b=scAddBuilding(s,team,type,x,y,false);b.paid=price;scRebuildNav(s,c);
 if(!silent){scNotice(s,"Constructing "+SC_BUILDINGS[type].name,team);scSound(s,"build",x,y);}return b;
}
function scReserved(s,team) {
 let n=scCount(s,team,"",false);for(let i=0;i<s.buildings.length;i++){let b=s.buildings[i];if(b.team===team&&b.hp>0)n+=b.queue.length;}return n;
}
function scQueue(s,b,type,silent) {
 if(!own(SC_UNITS,type)||!b||b.hp<=0||!b.complete)return false;
 let d=SC_UNITS[type],price=scCost(s,b.team,type,false),error="";
 if(b.type!==d.from)error="Select the correct production structure";
 else if(!scHas(s,b.team,d.requires))error="Requires "+SC_BUILDINGS[d.requires].name;
 else if(b.queue.length>=6)error="Production queue is full";
 else if(scReserved(s,b.team)>=SC_CAP)error="Command limit reached (80 units)";
 else if(s.players[b.team].cash<price)error="Insufficient credits";
 if(error){if(!silent)scNotice(s,error,b.team);return false;}
 s.players[b.team].cash-=price;b.queue.push({id:s.nextId++,type:type,left:d.time,total:d.time,paid:price});
 if(!silent){scNotice(s,d.name+" queued",b.team);scSound(s,"order");}return true;
}
function scCancelQueue(s,b,id) {
 if(!b||b.team!==0)return false;
 for(let i=0;i<b.queue.length;i++)if(b.queue[i].id===id){let q=b.queue[i];s.players[0].cash+=Math.floor(q.paid*clamp(q.left/q.total,.25,1));b.queue.splice(i,1);scNotice(s,"Production cancelled. Unspent work refunded.");return true;}
 return false;
}
function scStartResearch(s,team,key) {
 if(!own(SC_TECH,key)||!scHas(s,team,"research"))return false;
 let p=s.players[team],d=SC_TECH[key];if(p.research||p.upgrades[key]||p.cash<d.cost)return false;
 p.cash-=d.cost;p.research={key:key,left:d.time,total:d.time};scNotice(s,d.name+" research started",team);return true;
}
function scIssue(s,c,team,ids,kind,x,y,target,append) {
 x=clamp(x,.5,63.5);y=clamp(y,.5,47.5);let j=0;
 for(let i=0;i<ids.length;i++){
  let u=scGet(s,ids[i]);if(!u||u.team!==team)continue;
  if(u.building){if(u.complete)u.rally={x:x,y:y};continue;}
  let field=0;
  if(kind==="harvest"){
   let best=999999;for(let k=0;k<s.fields.length;k++){let f=s.fields[k];if(f.amount<=0||!s.explored[team][Math.floor(f.y)*64+Math.floor(f.x)])continue;let ds=dist2(f,{x:x,y:y});if(ds<best){best=ds;field=f.id;}}
  }
  let dest={x:x,y:y};if(kind==="move"||kind==="attackmove"){
   let n=Math.ceil(Math.sqrt(ids.length)),offx=((j%n)-(n-1)/2)*.85,offy=(Math.floor(j/n)-(n-1)/2)*.85;
   let p=scNearestFree(c,x+offx,y+offy,SC_UNITS[u.type].radius);if(p)dest=p;
  }
  let o={kind:kind,x:x,y:y,fx:dest.x,fy:dest.y,target:target||0,field:field};j++;
  if(append&&u.order.kind!=="guard"&&u.order.kind!=="hold"){if(u.orders.length<8)u.orders.push(o);}
  else{u.order=o;u.orders=[];u.target=0;u.way=null;u.stuck=0;if(kind==="harvest"){u.phase=u.cargo>0?"return":"seek";u.field=field;}}
 }
 if(s.orders.length<5000)s.orders.push({tick:s.tick,team:team,ids:ids.slice(),kind:kind,x:x,y:y,target:target||0,append:!!append});
}
function scNextOrder(u) {u.target=0;u.way=null;if(u.orders.length)u.order=u.orders.shift();else u.order={kind:"guard",x:u.x,y:u.y,fx:u.x,fy:u.y,target:0};}
function scMine(s,c,u) {
 let d=SC_UNITS.harvester;u.moving=false;
 if(u.order.kind!=="harvest")return;
 if(u.cargo>=d.capacity-.01)u.phase="return";
 if(u.phase==="return"){
  let refinery=null,bd=999999;
  for(let i=0;i<s.buildings.length;i++){let b=s.buildings[i];if(b.team!==u.team||b.type!=="refinery"||!b.complete||b.hp<=0)continue;let dd=dist2(u,b);if(dd<bd){bd=dd;refinery=b;}}
  if(!refinery){u.refinery=0;return;}
  u.refinery=refinery.id;
  if(Math.abs(u.x-refinery.x)<=2.45&&Math.abs(u.y-refinery.y)<=2.45){
   let amount=Math.min(u.cargo,120*SC_DT);u.cargo-=amount;s.players[u.team].cash+=amount;s.players[u.team].harvested+=amount;
   if(u.cargo<=.01){u.cargo=0;u.phase="seek";u.way=null;}return;
  }
  scMove(s,c,u,refinery.x,refinery.y,refinery.x,refinery.y);return;
 }
 let field=null;
 for(let i=0;i<s.fields.length;i++)if(s.fields[i].id===u.field&&s.fields[i].amount>0)field=s.fields[i];
 if(!field){
  let bd=999999;for(let i=0;i<s.fields.length;i++){let f=s.fields[i];if(f.amount<=0||!s.explored[u.team][Math.floor(f.y)*64+Math.floor(f.x)])continue;let dd=dist2(u,f);if(dd<bd){bd=dd;field=f;}}
  if(!field){if(u.cargo>0)u.phase="return";return;}u.field=field.id;u.way=null;
 }
 if(dist2(u,field)<1.5){let a=Math.min(field.amount,d.capacity-u.cargo,d.rate*SC_DT);field.amount-=a;u.cargo+=a;u.phase="mine";if(field.amount<=0||u.cargo>=d.capacity-.01){u.phase="return";u.way=null;}return;}
 scMove(s,c,u,field.x,field.y,field.x+((u.id%3)-1)*.6,field.y+((u.id%2)-.5)*.8);
}
function scAttackCandidate(s,c,e,r) {
 let best=null,score=999999;let nearby=scNearUnits(c,e.x,e.y,r);
 for(let k=0;k<2;k++){
  let a=k===0?nearby:s.buildings;
  for(let i=0;i<a.length;i++){let q=a[i];if(q.team===e.team||q.hp<=0||!scVisible(s,e.team,q))continue;let d=dist2(e,q);if(d>r*r)continue;
   if(scDef(e).weapon!=="artillery"&&!scLine(c,e.x,e.y,q.x,q.y,true))continue;
   let priority=d*(q.building?1.35:1);if(q.type==="harvester")priority*=1.15;if(priority<score){score=priority;best=q;}
  }
 }
 return best;
}
function scFire(s,e,t) {
 let d=scDef(e),p=s.players[e.team];
 e.cooldown=d.reload*(e.building&&p.use>p.power?2.8:1);e.angle=Math.atan2(t.y-e.y,t.x-e.x)+Math.PI/2;
 s.shots.push({id:s.nextId++,team:e.team,source:e.id,target:t.id,x:e.x,y:e.y,sx:e.x,sy:e.y,tx:t.x,ty:t.y,weapon:d.weapon,damage:d.damage*(p.upgrades.weapons?1.2:1),vs:d.vs,splash:d.splash||0,age:0,ttl:8});
 scSound(s,"fire",e.x,e.y);
}
function scDamage(s,t,amount,source,team) {
 if(t.hp<=0)return;
 if(!t.building&&s.players[t.team].upgrades.armor)amount*=.82;
 t.hp-=amount;t.lastHit=s.tick;
 if(t.building&&t.team===0&&s.tick-(s.lastBaseAlert||-1000)>100){s.lastBaseAlert=s.tick;scNotice(s,"Base under attack: "+SC_BUILDINGS[t.type].name);scSound(s,"alert");}
 if(t.hp<=0){
  t.hp=0;s.players[team].kills++;s.players[t.team].lost++;let a=scGet(s,source);if(a&&!a.building)a.kills++;
  s.fx.push({id:s.nextId++,x:t.x,y:t.y,age:0,big:t.building});scSound(s,"blast",t.x,t.y);
  if(t.building)s.navVersion++;
 }
}
function scImpact(s,p) {
 let targets=[];let t=scGet(s,p.target);
 if(p.splash>0){let all=s.units.concat(s.buildings);for(let i=0;i<all.length;i++){let e=all[i];if(e.team!==p.team&&e.hp>0&&dist2(e,{x:p.tx,y:p.ty})<=Math.pow(p.splash+(e.building?1:.2),2))targets.push(e);}}
 else if(t)targets.push(t);
 for(let i=0;i<targets.length;i++){
  let e=targets[i],armor=e.building?3:({infantry:0,light:1,heavy:2}[SC_UNITS[e.type].armor]);
  let falloff=p.splash>0?clamp(1-Math.sqrt(dist2(e,{x:p.tx,y:p.ty}))/(p.splash+1)*.5,.4,1):1;
  scDamage(s,e,p.damage*p.vs[armor]*falloff,p.source,p.team);
 }
 if(p.weapon!=="bullet"){s.fx.push({id:s.nextId++,x:p.tx,y:p.ty,age:0,big:false});if(s.fx.length>70)s.fx.shift();}
}
function scCombat(s,c,e) {
 let d=scDef(e);if(!d.damage||e.hp<=0||(e.building&&!e.complete))return false;
 e.cooldown=Math.max(0,e.cooldown-SC_DT);
 let mode=e.building?"hold":e.order.kind;
 if(!e.building&&(mode==="move"||mode==="harvest"))return false;
 let t=scGet(s,e.target);
 if(t&&(t.team===e.team||!scVisible(s,e.team,t)))t=null;
 if(!e.building&&mode==="attack"){
  let explicit=scGet(s,e.order.target);if(explicit&&scVisible(s,e.team,explicit))t=explicit;
  else if(!t){e.order={kind:"attackmove",x:e.order.x,y:e.order.y,fx:e.order.x,fy:e.order.y,target:0};e.way=null;}
 }
 if(!t&&s.tick%5===e.id%5)t=scAttackCandidate(s,c,e,e.building||mode==="hold"?d.range:d.sight);
 if(!t){e.target=0;return false;}
 e.target=t.id;let dd=dist2(e,t),range=d.range+(t.building?.8:0);
 let clear=d.weapon==="artillery"||scLine(c,e.x,e.y,t.x,t.y,true);
 if(dd<=range*range&&dd>=Math.pow(d.minRange||0,2)&&clear){if(e.cooldown<=0)scFire(s,e,t);if(!e.building)e.moving=false;return true;}
 if(e.building||mode==="hold"){e.target=0;return false;}
 if(d.minRange&&dd<d.minRange*d.minRange){let vx=e.x-t.x,vy=e.y-t.y,len=Math.max(.1,Math.sqrt(dd));let p=scNearestFree(c,e.x+vx/len*3,e.y+vy/len*3,d.radius);if(p)scMove(s,c,e,p.x,p.y,p.x,p.y);return true;}
 if(dd>d.sight*d.sight*2.5&&mode!=="attack"){e.target=0;return false;}
 scMove(s,c,e,t.x,t.y,t.x,t.y);return true;
}
function scProduction(s,c) {
 for(let i=0;i<s.buildings.length;i++){
  let b=s.buildings[i];if(b.hp<=0)continue;let d=SC_BUILDINGS[b.type],p=s.players[b.team],rate=p.use>p.power?.35:1;
  if(!b.complete){let before=b.work;b.work=Math.min(d.time,b.work+SC_DT*rate);b.hp=Math.min(b.maxHp,b.hp+b.maxHp*.88*(b.work-before)/d.time);if(b.work>=d.time){b.work=d.time;b.complete=true;scNotice(s,d.name+" complete",b.team);scSound(s,"ready",b.x,b.y);scEconomy(s);}continue;}
  if(b.repairing&&b.hp<b.maxHp&&p.cash>=3){let h=Math.min(b.maxHp-b.hp,18*SC_DT);let cost=h*.4;if(p.cash>=cost){b.hp+=h;p.cash-=cost;}}else if(b.hp>=b.maxHp)b.repairing=false;
  if(b.queue.length){let q=b.queue[0];q.left=Math.max(0,q.left-SC_DT*rate);if(q.left<=0){let at=scSpawnPoint(s,c,b,q.type);if(at&&scCount(s,b.team,"",false)<SC_CAP){let u=scAddUnit(s,b.team,q.type,at.x,at.y);b.queue.shift();if(b.rally&&u.type!=="harvester")scIssue(s,c,b.team,[u.id],"attackmove",b.rally.x,b.rally.y,0,false);scNotice(s,SC_UNITS[u.type].name+" ready",b.team);scSound(s,"ready",b.x,b.y);}}}
  if(b.type==="repair"&&s.tick%3===0){let a=scNearUnits(c,b.x,b.y,4);for(let j=0;j<a.length;j++){let u=a[j];if(u.team!==b.team||u.hp<=0||u.hp>=u.maxHp||SC_UNITS[u.type].armor==="infantry"||dist2(b,u)>16)continue;let h=Math.min(u.maxHp-u.hp,9*rate),cost=h*.25;if(p.cash>=cost){u.hp+=h;p.cash-=cost;}}}
 }
 for(let t=0;t<2;t++){let p=s.players[t];if(p.research&&scHas(s,t,"research")){p.research.left-=SC_DT*(p.use>p.power?.35:1);if(p.research.left<=0){p.upgrades[p.research.key]=true;scNotice(s,SC_TECH[p.research.key].name+" complete",t);p.research=null;}}}
}
function scSurge(s,c) {
 if(s.tick<s.nextSurge)return;s.nextSurge+=2100;
 let options=[[25.5,23.5],[38.5,24.5],[24.5,36.5],[39.5,11.5]],start=Math.floor(scRandom(s)*options.length);
 for(let n=0;n<options.length;n++){
  let p=options[(start+n)%options.length],at=scNearestFree(c,p[0],p[1],.3);if(!at)continue;
  let occupied=false;for(let j=0;j<s.buildings.length;j++)if(s.buildings[j].hp>0&&dist2(s.buildings[j],at)<16)occupied=true;
  if(occupied)continue;
  let merged=false;for(let j=0;j<s.fields.length;j++)if(dist2(s.fields[j],at)<4){s.fields[j].amount+=8000;s.fields[j].max=Math.max(s.fields[j].max,s.fields[j].amount);merged=true;}
  if(!merged)s.fields.push({id:s.nextId++,x:at.x,y:at.y,amount:8000,max:8000});
  s.surge={x:at.x,y:at.y,until:s.tick+150};scNotice(s,"Vitracite surge detected in sector "+Math.floor(at.x)+":"+Math.floor(at.y)+". Scout the new deposit.");scSound(s,"alert");break;
 }
}
function scStep(s,c) {
 if(s.result)return;s.tick++;s.sounds=[];c.budget=3;scRebuildNav(s,c);scEconomy(s);scSpatial(s,c);
 if(s.tick%3===0)scVision(s);
 scAI(s,c);scProduction(s,c);
 for(let i=0;i<s.buildings.length;i++)scCombat(s,c,s.buildings[i]);
 for(let i=0;i<s.units.length;i++){
  let u=s.units[i];if(u.hp<=0)continue;u.moving=false;
  if(u.type==="harvester"&&u.order.kind==="harvest"){scMine(s,c,u);continue;}
  if(scCombat(s,c,u))continue;
  let o=u.order;
  if(o.kind==="move"||o.kind==="attackmove"||o.kind==="attack"){
   if(scMove(s,c,u,o.x,o.y,o.fx,o.fy))scNextOrder(u);
   else if(u.stuck>140){scNextOrder(u);if(u.team===0)scNotice(s,"Route obstructed. Try another approach.");}
  }
 }
 let keep=[];
 for(let i=0;i<s.shots.length;i++){
  let p=s.shots[i];p.age+=SC_DT;p.ttl-=SC_DT;
  if(p.weapon!=="artillery"){let t=scGet(s,p.target);if(t){p.tx=t.x;p.ty=t.y;}}
  let dx=p.tx-p.x,dy=p.ty-p.y,len=Math.sqrt(dx*dx+dy*dy),speed=p.weapon==="bullet"?25:(p.weapon==="rocket"?9:(p.weapon==="artillery"?7:15));
  if(len<=speed*SC_DT||p.ttl<=0)scImpact(s,p);
  else{p.x+=dx/len*speed*SC_DT;p.y+=dy/len*speed*SC_DT;keep.push(p);}
 }s.shots=keep;
 let fx=[];for(let i=0;i<s.fx.length;i++){s.fx[i].age+=SC_DT;if(s.fx[i].age<.8)fx.push(s.fx[i]);}s.fx=fx.slice(-100);
 s.units=s.units.filter(function(e){return e.hp>0;});s.buildings=s.buildings.filter(function(e){return e.hp>0;});
 scSurge(s,c);
 let core0=scCount(s,0,"core",true),core1=scCount(s,1,"core",true);
 if(!core0||!core1){s.result=!core0&&!core1?"DRAW":(core0?"VICTORY":"DEFEAT");scNotice(s,s.result==="VICTORY"?"Enemy command uplink destroyed. The sector is yours.":"Command uplink lost.");scSound(s,s.result==="VICTORY"?"victory":"defeat");}
}


// ========== AI ==========
// Budgeted, non-cheating skirmish opponent. Planning cadence and attack patience
// vary by difficulty; starting credits, build costs and weapon rules do not.
function scAIPlace(s,c,type,anchor) {
 let d=SC_BUILDINGS[type];if(!scHas(s,1,d.requires))return false;
 let candidates=[];
 for(let dy=-9;dy<=9;dy++)for(let dx=-9;dx<=9;dx++){
  let x=Math.floor(anchor.x+dx-d.w/2)+d.w/2,y=Math.floor(anchor.y+dy-d.h/2)+d.h/2;
  let score=dx*dx+dy*dy;
  if(type==="turret"||type==="missile")score+=Math.max(0,dx+dy)*4;
  candidates.push({x:x,y:y,score:score});
 }
 candidates.sort(function(a,b){return a.score-b.score;});
 for(let i=0;i<candidates.length;i++){let q=candidates[i];if(scPlacement(s,c,1,type,q.x,q.y,false)==="")return !!scBuild(s,c,1,type,q.x,q.y,true);}
 return false;
}
function scAI(s,c) {
 let ai=s.ai;if(s.tick<ai.nextThink)return;ai.nextThink=s.tick+[45,26,16][s.difficulty];
 let p=s.players[1],hq=null;
 for(let i=0;i<s.buildings.length;i++)if(s.buildings[i].team===1&&s.buildings[i].type==="core"&&s.buildings[i].hp>0)hq=s.buildings[i];
 if(!hq)return;
 // Knowledge is built only from the AI faction's current sight.
 for(let i=0;i<s.buildings.length;i++){
  let e=s.buildings[i];if(e.team!==0||!scVisible(s,1,e))continue;
  let found=false;for(let j=0;j<ai.known.length;j++)if(ai.known[j].id===e.id){ai.known[j]={id:e.id,type:e.type,x:e.x,y:e.y};found=true;}
  if(!found)ai.known.push({id:e.id,type:e.type,x:e.x,y:e.y});
 }
 ai.known=ai.known.filter(function(k){let visible=s.visible[1][Math.floor(k.y)*64+Math.floor(k.x)];return !visible||!!scGet(s,k.id);});
 let army=[],scouts=[],heavy=0;
 for(let i=0;i<s.units.length;i++){
  let u=s.units[i];if(u.team===1&&u.hp>0){if(u.type==="scout")scouts.push(u);else if(u.type!=="harvester")army.push(u);}
  if(u.team===0&&scVisible(s,1,u)&&SC_UNITS[u.type].armor==="heavy")heavy++;
 }
 if(!ai.scouted&&s.tick>150&&scouts.length){
  // Starting locations are part of the public map layout, not secret unit state.
  scIssue(s,c,1,[scouts[0].id],"move",15.5,17.5,0,false);ai.scouted=true;
 }
 let threatened=scAttackCandidate(s,c,hq,12);
 if(threatened&&army.length){let ids=[];for(let i=0;i<army.length;i++)if(dist2(army[i],hq)<225)ids.push(army[i].id);if(ids.length)scIssue(s,c,1,ids,"attackmove",threatened.x,threatened.y,0,false);}
 let constructing=0;for(let i=0;i<s.buildings.length;i++)if(s.buildings[i].team===1&&!s.buildings[i].complete)constructing++;
 let pendingHarvesters=scCount(s,1,"harvester",false);
 for(let i=0;i<s.buildings.length;i++){let b=s.buildings[i];if(b.team===1)for(let j=0;j<b.queue.length;j++)if(b.queue[j].type==="harvester")pendingHarvesters++;}
 // Economic recovery is more important than another attack vehicle.
 for(let i=0;i<s.buildings.length;i++){
  let b=s.buildings[i];if(b.team===1&&b.complete&&b.type==="refinery"&&pendingHarvesters<2&&b.queue.length===0&&p.cash>=650){if(scQueue(s,b,"harvester",true))pendingHarvesters++;}
 }
 if(constructing<1){
  let type="";
  if(p.use+45>p.power)type="power";
  else if(!scCount(s,1,"refinery",true))type="refinery";
  else if(!scCount(s,1,"barracks",true))type="barracks";
  else if(!scCount(s,1,"factory",true))type="factory";
  else if(!scCount(s,1,"radar",true)&&s.tick>650)type="radar";
  else if(scCount(s,1,"turret",true)<2&&s.tick>950)type="turret";
  else if(!scCount(s,1,"repair",true)&&s.tick>1500)type="repair";
  else if(!scCount(s,1,"research",true)&&s.tick>2000&&p.cash>1800)type="research";
  else if(!scCount(s,1,"missile",true)&&scHas(s,1,"radar")&&s.tick>2100)type="missile";
  else if(scCount(s,1,"factory",true)<2&&s.tick>2400&&p.cash>2200)type="factory";
  if(type&&p.cash>=scCost(s,1,type,true)+(pendingHarvesters<1?650:0))scAIPlace(s,c,type,hq);
  // Extend toward a known deposit if the starting field is nearly exhausted.
  if(!type&&scCount(s,1,"refinery",true)<3&&p.cash>1800){
   let low=true;for(let j=0;j<s.fields.length;j++)if(dist2(s.fields[j],hq)<160&&s.fields[j].amount>1800)low=false;
   if(low){let best=null,bd=999999;for(let j=0;j<s.fields.length;j++){let f=s.fields[j];if(f.amount>3000&&s.explored[1][Math.floor(f.y)*64+Math.floor(f.x)]){let dd=dist2(hq,f);if(dd<bd){best=f;bd=dd;}}}
    if(best){let anchor=hq;for(let j=0;j<s.buildings.length;j++){let b=s.buildings[j];if(b.team===1&&b.complete&&dist2(b,best)<dist2(anchor,best))anchor=b;}
     let dx=best.x-anchor.x,dy=best.y-anchor.y,len=Math.max(1,Math.sqrt(dx*dx+dy*dy));scAIPlace(s,c,"refinery",{x:anchor.x+dx/len*5,y:anchor.y+dy/len*5});
    }
   }
  }
 }
 // Keep a reserve for the next tech building instead of spending every credit on infantry.
 let reserve=!scHas(s,1,"factory")?1200:(!scHas(s,1,"radar")&&s.tick>600?750:150);
 if(pendingHarvesters<1)reserve+=650;
 for(let i=0;i<s.buildings.length;i++){
  let b=s.buildings[i];if(b.team!==1||!b.complete||b.queue.length)continue;
  let type="";
  if(b.type==="barracks"&&army.length<22)type=heavy>1||scRandom(s)>.62?"rocket":"rifle";
  if(b.type==="factory"){
   let roll=scRandom(s);type=roll<.65?"tank":"apc";
   if(scHas(s,1,"radar")&&roll>.78)type="artillery";
   if(scHas(s,1,"research")&&roll>.84)type="siege";
  }
  if(type&&p.cash>=SC_UNITS[type].cost+reserve)scQueue(s,b,type,true);
  if(b.hp<b.maxHp*.65&&p.cash>300)b.repairing=true;
 }
 if(scHas(s,1,"research")&&!p.research&&p.cash>1700){if(!p.upgrades.weapons)scStartResearch(s,1,"weapons");else if(!p.upgrades.armor)scStartResearch(s,1,"armor");}
 if(!threatened&&s.tick>=ai.nextAttack){
  if(army.length<[9,7,5][s.difficulty]){ai.nextAttack=s.tick+150;return;}
  let target=null;for(let i=0;i<ai.known.length;i++)if(!target||ai.known[i].type==="core")target=ai.known[i];
  let ids=[];for(let i=0;i<army.length;i++)ids.push(army[i].id);
  if(target)scIssue(s,c,1,ids,"attackmove",target.x,target.y,0,false);
  else scIssue(s,c,1,ids,"attackmove",10.5,12.5,0,false);
  ai.nextAttack=s.tick+[650,480,360][s.difficulty];
 }
}


// ========== VIEW ==========
// Public, shallow render snapshots. Engine and path caches live on scPrivate.data,
// not on window.__*, which SoftN deliberately discovers and synchronizes.
let screen = "menu";
let paused = false;
let helpOpen = false;
let saveOpen = false;
let saveText = "";
let saveStatus = "";
let chosenMap = 0;
let chosenFaction = 0;
let chosenDifficulty = 1;
let chosenSeed = "8246";
let muted = false;
let gameSpeed = 1;
let creditsText = "2,400";
let powerText = "240 / 35";
let powerLow = false;
let supplyText = "4 / 80";
let clockText = "00:00";
let sectorText = "Broken Basin";
let factionText = "HELION DIRECTORATE";
let factionDescription = "";
let resultText = "";
let reportText = "";
let messageText = "Command uplink ready.";
let objectiveText = "Destroy the enemy Command Core. Preserve your own.";
let tipText = "";
let modeText = "SELECT";
let pendingName = "";
let pendingHint = "";
let activeTab = "structures";
let mobileDrawer = "";
let touchAction = "select";
let zoomText = "100%";
let worldStyle = {};
let terrainSrc = "assets/maps/map0.jpg";
let minimapSrc = "assets/maps/mini0.png";
let drawEntities = [];
let drawOre = [];
let drawFog = [];
let drawShots = [];
let drawFX = [];
let drawGhost = [];
let miniDots = [];
let miniFog = [];
let miniViewport = {};
let minimapOnline = false;
let dragStyle = {};
let dragging = false;
let markerStyle = {};
let markerVisible = false;
let buildCards = [];
let queueCards = [];
let selectedCards = [];
let selectionTitle = "NO UNIT SELECTED";
let selectionSub = "Drag a box around your army.";
let selectionImage = "assets/units/tank0-icon.png";
let selectionHealth = 0;
let selectionHealthText = "";
let selectionDetail = "";
let selectionBuilding = false;
let selectionRepairing = false;
let selectionCount = 0;
let researchCards = [];
let logCards = [];
let hasSave = false;
let fpsHint = "10 Hz fixed simulation";
let menuMaps = SC_MAPS;
let menuFactions = SC_FACTIONS;
let menuDifficulties = [{id:0,name:"Relaxed",desc:"More breathing room; slower planning."},{id:1,name:"Standard",desc:"Balanced build-up and regular attacks."},{id:2,name:"Veteran",desc:"Faster decisions and earlier pressure."}];
function scFmt(n) { let x=String(Math.floor(n));return x.replace(/\B(?=(\d{3})+(?!\d))/g,","); }
function scTime(t) { let sec=Math.floor(t/10),m=Math.floor(sec/60),s=sec%60;return (m<10?"0":"")+m+":"+(s<10?"0":"")+s; }
function scRenderFog(s) {
 let out=[],mini=[];
 // Horizontal run-length merging: usually dozens of rectangles, not 3,072 divs.
 for(let y=0;y<48;y++){
  let x=0;
  while(x<64){let val=s.visible[0][y*64+x]?0:(s.explored[0][y*64+x]?1:2);let start=x;x++;
   while(x<64){let next=s.visible[0][y*64+x]?0:(s.explored[0][y*64+x]?1:2);if(next!==val)break;x++;}
   if(val){out.push({id:y*64+start,style:{left:start*32,top:y*32,width:(x-start)*32+.5,height:32.5,background:val===2?"#0c171b":"rgba(7,17,22,.66)"}});mini.push({id:y*64+start,style:{left:start*4,top:y*4,width:(x-start)*4+.3,height:4.3,background:val===2?"#091115":"rgba(6,15,19,.64)"}});}
  }
 }
 drawFog=out;miniFog=mini;
}
function scRender() {
 let p=scPrivate();if(!p||!p.sim)return;let s=p.sim;
 terrainSrc="assets/maps/map"+s.map+".jpg";minimapSrc="assets/maps/mini"+s.map+".png";
 p.camera.x=clamp(p.camera.x,0,Math.max(0,2048-p.viewport.w/p.camera.zoom));p.camera.y=clamp(p.camera.y,0,Math.max(0,1536-p.viewport.h/p.camera.zoom));
 worldStyle={width:2048,height:1536,transform:"translate("+(-p.camera.x*p.camera.zoom)+"px,"+(-p.camera.y*p.camera.zoom)+"px) scale("+p.camera.zoom+")"};
 zoomText=Math.round(p.camera.zoom*100)+"%";creditsText=scFmt(s.players[0].cash);powerLow=s.players[0].use>s.players[0].power;
 powerText=s.players[0].use+" / "+s.players[0].power;supplyText=scCount(s,0,"",false)+" / "+SC_CAP;clockText=scTime(s.tick);sectorText=SC_MAPS[s.map].name;
 factionText=SC_FACTIONS[s.players[0].faction].name.toUpperCase();factionDescription=SC_FACTIONS[s.players[0].faction].desc;
 resultText=s.result;reportText="Time "+scTime(s.tick)+"  ·  Enemy losses "+s.players[0].kills+"  ·  Own losses "+s.players[0].lost+"  ·  Harvested "+scFmt(s.players[0].harvested);
 messageText=s.message;minimapOnline=scHas(s,0,"radar")&&!powerLow;
 let entities=[],dots=[],all=s.buildings.concat(s.units),cards=[];p.selection=p.selection.filter(function(id){let e=scGet(s,id);return !!e&&e.team===0;});
 let vx=p.camera.x,vy=p.camera.y,vw=p.viewport.w/p.camera.zoom,vh=p.viewport.h/p.camera.zoom;
 for(let i=0;i<all.length;i++){
  let e=all[i],d=scDef(e);if(e.hp<=0)continue;let visible=e.team===0||scVisible(s,0,e);if(!visible)continue;
  let selected=p.selection.indexOf(e.id)>=0,size=e.building?160:64,face=((Math.round(e.angle/(Math.PI*2)*16)%16)+16)%16;
  if(e.building)face=0;
  let path=e.building?"assets/buildings/"+e.type+s.players[e.team].faction+".png":"assets/units/"+e.type+s.players[e.team].faction+".png";
  if(e.x*32+100>vx&&e.x*32-100<vx+vw&&e.y*32+100>vy&&e.y*32-100<vy+vh){
   let health=e.hp/e.maxHp*100;let w=e.building?d.w*32:35;
   entities.push({id:e.id,src:path,size:size,face:face,selected:selected,building:e.building,complete:e.building?e.complete:true,health:health,
    style:{left:0,top:0,transform:"translate("+(Math.round(e.x*32)-size/2)+"px,"+(Math.round(e.y*32)-size/2)+"px)",width:size,height:size,zIndex:10+Math.floor(e.y*32),opacity:e.building&&!e.complete?.48:1,transition:e.building||paused||screen!=="play"?"none":"transform "+(gameSpeed===1?100:100)+"ms linear"},
    ringStyle:{left:size/2-w/2,top:size/2-(e.building?d.h*16:14),width:w,height:e.building?d.h*32:28,borderColor:selected?"#9ae594":(e.team===0?"#64cbed":"#f37361"),borderRadius:e.building?2:"50%",opacity:selected?1:0},
    healthStyle:{left:size/2-w/2,top:size/2-(e.building?d.h*16+9:27),width:w,opacity:selected||e.hp<e.maxHp?1:0},
    barStyle:{width:health+"%",background:e.team===0?"#85cc99":"#ed7a67"},
    workStyle:{left:14,bottom:13,width:132*(e.building?clamp(e.work/d.time,0,1):1),height:4},
    cargoStyle:{left:15,top:53,width:34*(e.cargo||0)/350,height:3},hasCargo:e.type==="harvester"&&e.cargo>0,
    label:e.building&&!e.complete?Math.floor(e.work/d.time*100)+"%":"",repairing:!!e.repairing});
  }
  if(e.team===0||minimapOnline)dots.push({id:e.id,style:{left:e.x*4-(e.building?3:1.5),top:e.y*4-(e.building?3:1.5),width:e.building?6:3,height:e.building?6:3,background:e.team===0?"#72cde9":"#f17a66",border:selected?"1px solid white":"none"}});
  if(selected)cards.push({id:e.id,name:d.name,image:e.building?path:"assets/units/"+e.type+s.players[e.team].faction+"-icon.png",hp:Math.round(e.hp/e.maxHp*100),kind:e.type});
 }
 drawEntities=entities;miniDots=dots;selectedCards=cards;selectionCount=cards.length;
 let ore=[];
 for(let i=0;i<s.fields.length;i++){
  let f=s.fields[i];if(f.amount<=0)continue;let idx=Math.floor(f.y)*64+Math.floor(f.x);if(!s.explored[0][idx])continue;
  let stage=f.amount/f.max>.6?0:(f.amount/f.max>.25?1:2);
  ore.push({id:f.id,src:"assets/fx/ore"+stage+".png",style:{position:"absolute",left:f.x*32-48,top:f.y*32-48,width:96,height:96,zIndex:1}});
 }
 drawOre=ore;
 let shots=[];for(let i=0;i<s.shots.length;i++){let b=s.shots[i];if(!scVisible(s,0,b))continue;let angle=Math.atan2(b.ty-b.y,b.tx-b.x)*180/Math.PI;let h=0;if(b.weapon==="artillery"){let total=Math.sqrt((b.tx-b.sx)*(b.tx-b.sx)+(b.ty-b.sy)*(b.ty-b.sy));let fraction=total?Math.sqrt((b.x-b.sx)*(b.x-b.sx)+(b.y-b.sy)*(b.y-b.sy))/total:1;h=Math.sin(clamp(fraction,0,1)*Math.PI)*34;}
  shots.push({id:b.id,style:{left:b.x*32,top:b.y*32-h-8,width:b.weapon==="bullet"?7:10,height:b.weapon==="bullet"?2:4,background:b.weapon==="rocket"?"#ed9564":"#ffddb0",transform:"rotate("+angle+"deg)",boxShadow:"0 0 5px #ffb05a"}});
 }drawShots=shots;
 let fx=[];for(let i=0;i<s.fx.length;i++){let f=s.fx[i];if(!scVisible(s,0,f))continue;fx.push({id:f.id,col:clamp(Math.floor(f.age*10),0,7),scale:f.big?1.8:1,style:{left:f.x*32-(f.big?57:32),top:f.y*32-(f.big?57:32)}});}drawFX=fx;
 if(s.tick%3===0||p.fogDirty){scRenderFog(s);p.fogDirty=false;}
 miniViewport={left:p.camera.x/8,top:p.camera.y/8,width:Math.min(256,p.viewport.w/p.camera.zoom/8),height:Math.min(192,p.viewport.h/p.camera.zoom/8)};
 pendingName=p.build?SC_BUILDINGS[p.build].name:"";drawGhost=[];
 if(p.build&&p.pointer.inside){
  let d=SC_BUILDINGS[p.build],x=Math.floor(p.pointer.wx-d.w/2)+d.w/2,y=Math.floor(p.pointer.wy-d.h/2)+d.h/2;
  let err=scPlacement(s,p.cache,0,p.build,x,y,false);pendingHint=err||"Left click to construct. Right click or Esc to cancel.";
  drawGhost=[{id:1,src:"assets/buildings/"+p.build+s.players[0].faction+".png",style:{left:x*32-80,top:y*32-80},footStyle:{left:80-d.w*16,top:80-d.h*16,width:d.w*32,height:d.h*32,borderColor:err?"#f08072":"#8be2b1",background:err?"rgba(220,66,53,.22)":"rgba(71,198,128,.19)"}}];
 }else pendingHint="";
 modeText=p.build?"PLACE STRUCTURE":p.mode.toUpperCase();dragging=!!p.drag&&p.drag.moved&&p.drag.button===0;
 if(dragging)dragStyle={left:Math.min(p.drag.sx,p.pointer.sx),top:Math.min(p.drag.sy,p.pointer.sy),width:Math.abs(p.drag.sx-p.pointer.sx),height:Math.abs(p.drag.sy-p.pointer.sy)};
 markerVisible=!!p.marker&&s.tick<p.marker.until;if(markerVisible)markerStyle={left:(p.marker.x*32-p.camera.x)*p.camera.zoom-14,top:(p.marker.y*32-p.camera.y)*p.camera.zoom-14};
 selectionTitle=cards.length>1?cards.length+" UNITS SELECTED":(cards.length?cards[0].name.toUpperCase():"NO UNIT SELECTED");
 selectionImage=cards.length?cards[0].image:"assets/units/tank"+s.players[0].faction+"-icon.png";
 selectionHealth=0;selectionHealthText="";selectionSub="Left click selects. Right click gives contextual orders.";selectionDetail="";selectionBuilding=false;selectionRepairing=false;
 queueCards=[];
 if(cards.length===1){
  let e=scGet(s,cards[0].id),d=scDef(e);selectionSub=d.role;selectionHealth=e.hp/e.maxHp*100;selectionHealthText=Math.ceil(e.hp)+" / "+e.maxHp;selectionBuilding=e.building;selectionRepairing=!!e.repairing;
  if(e.building){selectionDetail=e.complete?"Power "+(d.power?"+"+d.power:"−"+d.use)+" · Right click terrain to set rally point":"Under construction: "+Math.floor(e.work/d.time*100)+"%";
   for(let i=0;i<e.queue.length;i++){let q=e.queue[i];queueCards.push({id:q.id,building:e.id,name:SC_UNITS[q.type].name,progress:(1-q.left/q.total)*100,remaining:Math.ceil(q.left)+"s",image:"assets/units/"+q.type+s.players[0].faction+"-icon.png"});}
  }else selectionDetail=e.type==="harvester"?"Cargo "+Math.floor(e.cargo)+" / 350 · "+e.phase:("Range "+d.range+" · Kills "+e.kills+" · "+e.order.kind);
 }
 let catalog=[];
 if(activeTab==="structures"){
  let names=["power","refinery","barracks","factory","radar","turret","repair","missile","research"];
  for(let i=0;i<names.length;i++){let k=names[i],d=SC_BUILDINGS[k],req=scHas(s,0,d.requires),cost=scCost(s,0,k,true);catalog.push({id:k,name:d.name,cost:cost,time:d.time+"s",available:req&&s.players[0].cash>=cost,image:"assets/buildings/"+k+s.players[0].faction+".png",desc:req?d.role:"Requires "+SC_BUILDINGS[d.requires].name,active:p.build===k});}
 }else{
  let names=["rifle","rocket","scout","tank","apc","artillery","harvester","siege"];
  for(let i=0;i<names.length;i++){let k=names[i],d=SC_UNITS[k],req=scHas(s,0,d.requires),cost=scCost(s,0,k,false);catalog.push({id:k,name:d.name,cost:cost,time:d.time+"s",available:req&&s.players[0].cash>=cost,image:"assets/units/"+k+s.players[0].faction+"-icon.png",desc:req?d.role:"Requires "+SC_BUILDINGS[d.requires].name,active:false});}
 }buildCards=catalog;
 let tech=[];for(let k in SC_TECH){let d=SC_TECH[k],r=s.players[0].research,done=s.players[0].upgrades[k];tech.push({id:k,name:d.name,desc:d.desc,enabled:scHas(s,0,"research")&&!done&&!r&&s.players[0].cash>=d.cost,label:done?"COMPLETE":(r&&r.key===k?Math.ceil(r.left)+"s":scFmt(d.cost)+" credits")});}researchCards=tech;
 logCards=s.log.slice(0,4).map(function(v){return {time:scTime(v.tick),text:v.text};});
 if(!scHas(s,0,"barracks"))tipText="01 / Construct a Barracks on clear ground near your base.";
 else if(!scHas(s,0,"factory"))tipText="02 / Build a Vehicle Plant to start manufacturing tanks.";
 else if(!scHas(s,0,"radar"))tipText="03 / A Radar Array enables enemy minimap contacts and artillery.";
 else if(scCount(s,0,"tank",false)<3)tipText="04 / Assemble a mixed army. Pike Troopers counter heavy armour.";
 else tipText="05 / Scout the far side, then attack-move toward the enemy Command Core.";
 if(powerLow)tipText="BROWNOUT / Build another Reactor. Production is running at 35%.";
}


// ========== CONTROLLER ==========
function scCalcViewport() {
 if(typeof window==="undefined")return {w:950,h:620};
 let iw=window.innerWidth||1232,ih=window.innerHeight||800;
 let side=iw<=720?0:(iw<=780?224:282),chrome=iw<=720?102:188;
 return {w:Math.max(260,iw-side),h:Math.max(220,ih-chrome)};
}
function _init() {
 if(scPrivate.data)return;
 scPrivate.data={sim:null,cache:scCache(),selection:[],mode:"select",build:"",keys:{},groups:{},camera:{x:0,y:130,zoom:1},viewport:scCalcViewport(),pointer:{inside:false,sx:0,sy:0,wx:0,wy:0},drag:null,marker:null,fogDirty:true,lastPointerRender:0,edge:!(typeof window!=="undefined"&&(navigator.maxTouchPoints>0||"ontouchstart"in window))};
 let p=scPrivate();p.sim=scNewSimulation(chosenMap,chosenFaction,chosenDifficulty,8246);scRebuildNav(p.sim,p.cache);scSpatial(p.sim,p.cache);
 try{muted=localStorage.getItem("scorchline.muted")==="1";hasSave=!!localStorage.getItem("scorchline.save.v1");}catch(e){hasSave=false;}
 if(typeof window!=="undefined"&&window.addEventListener){
  window.addEventListener("keydown",scKeyDown);window.addEventListener("keyup",scKeyUp);
  window.addEventListener("blur",function(){let q=scPrivate();if(q){q.keys={};q.drag=null;q.pointer.inside=false;if(screen==="play"&&!q.sim.result)paused=true;scRender();}});
  window.addEventListener("resize",function(){let q=scPrivate();if(q){q.viewport=scCalcViewport();scRender();}});
 }
 if(typeof softn!=="undefined"&&softn.input)softn.input.captureKeys(["ArrowUp","ArrowDown","ArrowLeft","ArrowRight"," ","Home","+","-","=","Digit1","Digit2","Digit3","Digit4","Digit5"]);
 scRender();
}
function chooseMap(n){chosenMap=n;let p=scPrivate();if(screen==="menu"){p.sim=scNewSimulation(chosenMap,chosenFaction,chosenDifficulty,8246);p.cache=scCache();scRebuildNav(p.sim,p.cache);p.camera={x:0,y:130,zoom:1};p.fogDirty=true;scRender();}}
function chooseFaction(n){chosenFaction=n;chooseMap(chosenMap);}
function chooseDifficulty(n){chosenDifficulty=n;}
function setSeed(value){chosenSeed=String(value);}
function startSkirmish(){
 let p=scPrivate(),seed=parseInt(chosenSeed,10);if(!Number.isFinite(seed))seed=8246;
 p.sim=scNewSimulation(chosenMap,chosenFaction,chosenDifficulty,seed>>>0);p.cache=scCache();scRebuildNav(p.sim,p.cache);scSpatial(p.sim,p.cache);
 p.viewport=scCalcViewport();
 p.selection=[];p.keys={};p.groups={};p.mode="select";p.build="";p.drag=null;p.fogDirty=true;p.camera={x:0,y:160,zoom:1};
 paused=false;helpOpen=false;saveOpen=false;mobileDrawer="";touchAction="select";screen="play";gameSpeed=1;activeTab="structures";scPlay("order");scRender();
}
function scPlay(name){if(muted)return;try{if(typeof softn!=="undefined"&&softn.audio)softn.audio.play("assets/sfx/"+name+".wav",{volume:name==="fire"?.1:(name==="blast"?.18:.32)});}catch(e){}}
function toggleMute(){muted=!muted;try{localStorage.setItem("scorchline.muted",muted?"1":"0");}catch(e){}if(muted&&typeof softn!=="undefined")softn.audio.stopAll();else scPlay("select");}
function togglePause(){if(screen!=="play"||scPrivate().sim.result)return;paused=!paused;scPrivate().keys={};scPrivate().drag=null;scRender();}
function openHelp(){helpOpen=true;if(screen==="play")paused=true;}
function closeHelp(){helpOpen=false;}
function showMenu(){screen="menu";paused=true;helpOpen=false;saveOpen=false;scPrivate().keys={};scPrivate().drag=null;}
function resumeGame(){if(!scPrivate().sim.result){screen="play";paused=false;scRender();}}
function setTab(t){activeTab=t;scRender();}
function cycleSpeed(){gameSpeed=gameSpeed===1?2:1;}
function zoomBy(delta){
 let p=scPrivate(),old=p.camera.zoom,next=clamp(old+delta,.65,1.75),cx=p.camera.x+p.viewport.w/(2*old),cy=p.camera.y+p.viewport.h/(2*old);
 p.camera.zoom=next;p.camera.x=cx-p.viewport.w/(2*next);p.camera.y=cy-p.viewport.h/(2*next);scRender();
}
function centreBase(){let p=scPrivate();for(let i=0;i<p.sim.buildings.length;i++){let b=p.sim.buildings[i];if(b.team===0&&b.type==="core"){p.camera.x=b.x*32-p.viewport.w/(2*p.camera.zoom);p.camera.y=b.y*32-p.viewport.h/(2*p.camera.zoom);break;}}scRender();}
function scFrame(){
 let p=scPrivate();if(!p)return;
 if(screen!=="play"||paused||p.sim.result)return;
 let step=25/p.camera.zoom,panx=0,pany=0;
 if(p.keys.ArrowLeft)panx-=step;if(p.keys.ArrowRight)panx+=step;if(p.keys.ArrowUp)pany-=step;if(p.keys.ArrowDown)pany+=step;
 if(p.edge&&p.pointer.inside&&!p.drag&&!p.build){if(p.pointer.sx<10)panx-=step;if(p.pointer.sx>p.viewport.w-10)panx+=step;if(p.pointer.sy<10)pany-=step;if(p.pointer.sy>p.viewport.h-10)pany+=step;}
 p.camera.x+=panx;p.camera.y+=pany;
 let sounds=[];
 for(let n=0;n<gameSpeed;n++){scStep(p.sim,p.cache);for(let j=0;j<p.sim.sounds.length;j++)if(sounds.indexOf(p.sim.sounds[j])<0)sounds.push(p.sim.sounds[j]);}
 for(let n=0;n<sounds.length;n++)scPlay(sounds[n]);
 scRender();
}
function scPointer(e){
 let p=scPrivate(),sx=typeof e.clientX==="number"&&typeof e.targetLeft==="number"?e.clientX-e.targetLeft:(e.offsetX||0),sy=typeof e.clientY==="number"&&typeof e.targetTop==="number"?e.clientY-e.targetTop:(e.offsetY||0);
 if(e.targetWidth>0)p.viewport.w=e.targetWidth;if(e.targetHeight>0)p.viewport.h=e.targetHeight;
 p.pointer={inside:true,sx:sx,sy:sy,wx:(p.camera.x+sx/p.camera.zoom)/32,wy:(p.camera.y+sy/p.camera.zoom)/32};return p.pointer;
}
function battlefieldDown(e){
 let p=scPrivate();if(screen!=="play"||paused||p.sim.result)return;let v=scPointer(e);
 if(e.button===2){if(p.build){p.build="";p.mode="select";}else scContext(v.wx,v.wy,!!e.shiftKey);p.drag=null;scRender();return;}
 if(e.button===1){p.drag={button:1,sx:v.sx,sy:v.sy,cx:p.camera.x,cy:p.camera.y,moved:false};return;}
 if(e.button!==0)return;
 if(p.build){let d=SC_BUILDINGS[p.build],x=Math.floor(v.wx-d.w/2)+d.w/2,y=Math.floor(v.wy-d.h/2)+d.h/2;let b=scBuild(p.sim,p.cache,0,p.build,x,y,false);if(b){p.selection=[b.id];if(!e.shiftKey)p.build="";scPlay("build");}scRender();return;}
 if(touchAction==="pan"&&p.mode==="select"){p.drag={button:1,panMode:true,sx:v.sx,sy:v.sy,cx:p.camera.x,cy:p.camera.y,moved:false,wx:v.wx,wy:v.wy};return;}
 p.drag={button:0,sx:v.sx,sy:v.sy,wx:v.wx,wy:v.wy,moved:false,shift:!!e.shiftKey};
}
function battlefieldMove(e){
 let p=scPrivate();if(screen!=="play")return;let v=scPointer(e);
 if(p.drag){
  if(Math.abs(v.sx-p.drag.sx)+Math.abs(v.sy-p.drag.sy)>6)p.drag.moved=true;
  if(p.drag.button===1){p.camera.x=p.drag.cx-(v.sx-p.drag.sx)/p.camera.zoom;p.camera.y=p.drag.cy-(v.sy-p.drag.sy)/p.camera.zoom;}
 }
 let now=Date.now();if(now-p.lastPointerRender>45&&(p.drag||p.build)){p.lastPointerRender=now;scRender();}
}
function battlefieldUp(e){
 let p=scPrivate();if(screen!=="play"||paused||p.sim.result||!p.drag)return;let v=scPointer(e),drag=p.drag;p.drag=null;
 if(drag.button!==0){
  if(drag.panMode&&!drag.moved){
   let ent=scPick(p.sim,v.wx,v.wy,false);
   if(ent&&ent.team===0){p.selection=[ent.id];if(ent.building&&ent.queue.length)activeTab="units";scPlay("select");}
  }
  scRender();return;
 }
 if(drag.moved){
  let x0=Math.min(drag.wx,v.wx),y0=Math.min(drag.wy,v.wy),x1=Math.max(drag.wx,v.wx),y1=Math.max(drag.wy,v.wy);let ids=drag.shift?p.selection.slice():[];
  for(let i=0;i<p.sim.units.length;i++){let u=p.sim.units[i];if(u.team===0&&u.hp>0&&u.x>=x0&&u.x<=x1&&u.y>=y0&&u.y<=y1&&ids.indexOf(u.id)<0)ids.push(u.id);}
  p.selection=ids;scPlay("select");
 }else if(p.mode!=="select"||touchAction==="order"){scContext(v.wx,v.wy,!!e.shiftKey);}
 else{
  let e=scPick(p.sim,v.wx,v.wy,false);
  if(e&&e.team===0){
   if(drag.shift){let i=p.selection.indexOf(e.id);if(i>=0)p.selection.splice(i,1);else p.selection.push(e.id);}else p.selection=[e.id];
   if(e.building&&e.queue.length)activeTab="units";scPlay("select");
  }else if(!drag.shift)p.selection=[];
 }
 scRender();
}
function battlefieldLeave(){let p=scPrivate();p.pointer.inside=false;p.drag=null;dragging=false;drawGhost=[];}
function ignoreContext(e){if(e&&typeof e.preventDefault==="function")e.preventDefault();}
function scPick(s,x,y,enemyFirst){
 let best=null,score=99999;
 for(let k=0;k<2;k++){let a=k===0?s.units:s.buildings;for(let i=0;i<a.length;i++){let e=a[i];if(e.hp<=0||(e.team!==0&&!scVisible(s,0,e)))continue;
  let d=scDef(e),r=e.building?Math.max(d.w,d.h)/2:.75,dd=dist2(e,{x:x,y:y});
  let hit=e.building?(Math.abs(e.x-x)<=d.w/2&&Math.abs(e.y-y)<=d.h/2):dd<r*r;
  if(hit){let q=dd+(e.building?2:0)+(enemyFirst&&e.team===0?20:0);if(q<score){score=q;best=e;}}
 }}return best;
}
function scContext(x,y,append){
 let p=scPrivate(),s=p.sim;if(!p.selection.length){scNotice(s,"Select units first.");return;}
 let e=scPick(s,x,y,true),kind=p.mode==="attackmove"?"attackmove":"move",target=0;
 if(e&&e.team!==0){kind="attack";target=e.id;}
 let ore=null;for(let i=0;i<s.fields.length;i++)if(s.fields[i].amount>0&&dist2(s.fields[i],{x:x,y:y})<3&&s.explored[0][Math.floor(s.fields[i].y)*64+Math.floor(s.fields[i].x)])ore=s.fields[i];
 let miners=[],others=[];
 for(let i=0;i<p.selection.length;i++){let u=scGet(s,p.selection[i]);if(!u)continue;if(u.type==="harvester"&&ore)miners.push(u.id);else others.push(u.id);}
 if(miners.length)scIssue(s,p.cache,0,miners,"harvest",ore.x,ore.y,0,append);
 if(others.length)scIssue(s,p.cache,0,others,kind,x,y,target,append);
 if(e&&e.team===0&&e.type==="refinery")for(let i=0;i<others.length;i++){let u=scGet(s,others[i]);if(u&&!u.building&&u.type==="harvester"){u.order.kind="harvest";u.phase=u.cargo>0?"return":"seek";}}
 p.marker={x:x,y:y,until:s.tick+12};p.mode="select";scPlay("order");
}
function setMobileDrawer(d){mobileDrawer=mobileDrawer===d?"":d;scRender();}
function setTouchAction(a){let p=scPrivate();touchAction=a;p.mode="select";p.build="";scRender();}
function commandMode(mode){let p=scPrivate();p.mode=mode;p.build="";touchAction="select";mobileDrawer="";scRender();}
function stopSelected(){let p=scPrivate();scIssue(p.sim,p.cache,0,p.selection,"hold",0,0,0,false);p.mode="select";scRender();}
function selectArmy(){let p=scPrivate();p.selection=[];for(let i=0;i<p.sim.units.length;i++){let u=p.sim.units[i];if(u.team===0&&u.type!=="harvester")p.selection.push(u.id);}scPlay("select");scRender();}
function selectHarvesters(){let p=scPrivate();p.selection=[];for(let i=0;i<p.sim.units.length;i++){let u=p.sim.units[i];if(u.team===0&&u.type==="harvester")p.selection.push(u.id);}scPlay("select");scRender();}
function selectOne(id){scPrivate().selection=[id];scRender();}
function selectCard(id){
 let p=scPrivate(),s=p.sim;if(paused||screen!=="play"||s.result)return;
 if(activeTab==="structures"){
  let d=SC_BUILDINGS[id];if(!d)return;
  if(!scHas(s,0,d.requires)){scNotice(s,"Requires "+SC_BUILDINGS[d.requires].name);scRender();return;}
  if(s.players[0].cash<scCost(s,0,id,true)){scNotice(s,"Insufficient credits");scRender();return;}
  p.build=id;p.mode="select";touchAction="select";mobileDrawer="";scPlay("select");
 }else{
  let d=SC_UNITS[id];if(!d)return;let b=null;
  if(p.selection.length===1){let e=scGet(s,p.selection[0]);if(e&&e.building&&e.team===0&&e.complete&&e.type===d.from)b=e;}
  if(!b)for(let i=0;i<s.buildings.length;i++){let e=s.buildings[i];if(e.team===0&&e.complete&&e.type===d.from&&(!b||e.queue.length<b.queue.length))b=e;}
  if(!b){scNotice(s,"Build a "+SC_BUILDINGS[d.from].name+" first.");scRender();return;}
  if(scQueue(s,b,id,false)){p.selection=[b.id];scPlay("order");}
 }
 scRender();
}
function cancelProduction(building,id){let p=scPrivate();if(paused)return;scCancelQueue(p.sim,scGet(p.sim,building),id);scRender();}
function repairSelected(){let p=scPrivate();if(paused)return;for(let i=0;i<p.selection.length;i++){let b=scGet(p.sim,p.selection[i]);if(b&&b.building&&b.complete&&b.team===0)b.repairing=!b.repairing;}scRender();}
function sellSelected(){
 let p=scPrivate(),s=p.sim;if(paused)return;
 for(let i=0;i<p.selection.length;i++){let b=scGet(s,p.selection[i]);if(!b||!b.building||b.team!==0)continue;if(b.type==="core"){scNotice(s,"The Command Core cannot be sold.");continue;}
  let value=b.complete?Math.floor(scCost(s,0,b.type,true)*.5*b.hp/b.maxHp):Math.floor((b.paid||scCost(s,0,b.type,true))*.8);
  for(let j=0;j<b.queue.length;j++)value+=Math.floor(b.queue[j].paid*clamp(b.queue[j].left/b.queue[j].total,.25,1));
  s.players[0].cash+=value;b.hp=0;s.navVersion++;scNotice(s,(b.complete?"Structure sold":"Construction cancelled")+". Refunded "+value+" credits.");
 }
 scRebuildNav(s,p.cache);scEconomy(s);scVision(s);p.fogDirty=true;scRender();
}
function researchUpgrade(id){let p=scPrivate();if(paused)return;if(!scStartResearch(p.sim,0,id))scNotice(p.sim,"Research requires a completed Research Complex, enough credits, and an idle lab.");scRender();}
function minimapDown(e){
 let p=scPrivate();if(screen!=="play")return;
 let width=e.targetWidth||256,height=e.targetHeight||192,x=(e.clientX-e.targetLeft)/width*2048,y=(e.clientY-e.targetTop)/height*1536;
 if(!Number.isFinite(x)){x=(e.offsetX||0)/width*2048;y=(e.offsetY||0)/height*1536;}
 if(e.button===2){scContext(x/32,y/32,!!e.shiftKey);}else{p.camera.x=x-p.viewport.w/(2*p.camera.zoom);p.camera.y=y-p.viewport.h/(2*p.camera.zoom);}
 scRender();
}
function scKeyDown(e){
 let p=scPrivate(),tag=String(e.targetTag||"").toLowerCase();if(!p||tag==="input"||tag==="textarea"||tag==="select"||e.targetEditable)return;let k=e.key||"",code=e.code||"";
 if(k==="Escape"){
  if(helpOpen){helpOpen=false;scRender();return;}if(saveOpen){saveOpen=false;scRender();return;}
  if(p.build||p.mode!=="select"){p.build="";p.mode="select";scRender();return;}
  if(screen==="play")togglePause();return;
 }
 if(screen!=="play")return;p.keys[k]=true;if(e.repeat)return;
 if(k===" "||k==="p"||k==="P"){togglePause();return;}
 if(k==="m"||k==="M"){toggleMute();return;}
 if(k==="F1"||k==="?"){if(helpOpen)closeHelp();else openHelp();scRender();return;}
 if(paused||helpOpen||saveOpen)return;
 if(k==="a"||k==="A")commandMode("attackmove");
 else if(k==="s"||k==="S"||k==="h"||k==="H")stopSelected();
 else if(k==="Home")centreBase();
 else if(k==="+"||k==="=")zoomBy(.1);
 else if(k==="-")zoomBy(-.1);
 else if(k==="q"||k==="Q")selectArmy();
 else if(k==="r"||k==="R")repairSelected();
 else if(k==="b"||k==="B"){activeTab="structures";scRender();}
 else if(k==="u"||k==="U"){activeTab="units";scRender();}
 else if(k==="Backspace"||k==="Delete")sellSelected();
 let digit=code.indexOf("Digit")===0?code.slice(5):k;
 if(digit>="1"&&digit<="5"){
  if(e.shiftKey||e.ctrlKey){p.groups[digit]=p.selection.slice();scNotice(p.sim,"Control group "+digit+" assigned");}
  else if(p.groups[digit]){p.selection=p.groups[digit].slice();scPlay("select");}
  scRender();
 }
}
function scKeyUp(e){let p=scPrivate();if(p)p.keys[e.key||""]=false;}


// ========== PERSISTENCE ==========
// Versioned, bounded snapshots; no executable code, no network and no silent success.
function scSnapshot(){let p=scPrivate();return JSON.stringify({format:"scorchline-save",version:SC_VERSION,simulation:p.sim,camera:p.camera,selection:p.selection,groups:p.groups});}
function scFinite(n,min,max){return typeof n==="number"&&Number.isFinite(n)&&n>=min&&n<=max;}
function scValidateSave(text){
 if(typeof text!=="string"||text.length>4000000)throw new Error("Save is missing or larger than 4 MB.");
 let r=JSON.parse(text);if(!r||r.format!=="scorchline-save"||r.version!==SC_VERSION)throw new Error("Not a supported Scorchline v1 save.");
 let s=r.simulation;if(!s||s.version!==SC_VERSION||!Number.isInteger(s.map)||s.map<0||s.map>2)throw new Error("Invalid map or simulation version.");
 if(!scFinite(s.tick,0,100000000)||!scFinite(s.rng,0,4294967295)||!scFinite(s.seed,0,4294967295)||!scFinite(s.nextId,1,1000000000)||!scFinite(s.nextSurge,0,100000100)||!Number.isInteger(s.difficulty)||s.difficulty<0||s.difficulty>2)throw new Error("Invalid simulation counters.");
 if(!Array.isArray(s.players)||s.players.length!==2)throw new Error("The save must contain two players.");
 for(let t=0;t<2;t++){
  let p=s.players[t];if(!p||(p.faction!==0&&p.faction!==1)||!scFinite(p.cash,0,1000000000)||!p.upgrades)throw new Error("Invalid player economy.");
  for(let k of ["kills","lost","harvested"])if(!scFinite(p[k],0,1000000000))throw new Error("Invalid player statistics.");
  if(p.research&&(!own(SC_TECH,p.research.key)||!scFinite(p.research.left,0,1000)||!scFinite(p.research.total,1,1000)))throw new Error("Invalid research queue.");
 }
 let ids={};let maxId=0;
 function register(id){if(!Number.isInteger(id)||id<1||id>=s.nextId||ids[id])throw new Error("Duplicate or invalid entity ID.");ids[id]=true;maxId=Math.max(maxId,id);}
 function order(o){if(!o||["guard","hold","move","attackmove","attack","harvest"].indexOf(o.kind)<0)throw new Error("Invalid unit order.");for(let k of ["x","y","fx","fy"])if(!scFinite(o[k],0,k==="x"||k==="fx"?64:48))throw new Error("Order leaves the map.");if(o.target!==undefined&&!scFinite(o.target,0,1000000000))throw new Error("Invalid target.");}
 for(let isB=0;isB<2;isB++){
  let a=isB?s.buildings:s.units;if(!Array.isArray(a)||a.length>(isB?160:160))throw new Error("Entity limit exceeded.");
  for(let i=0;i<a.length;i++){
   let e=a[i];if(!e||e.building!==!!isB||(e.team!==0&&e.team!==1)||!own(isB?SC_BUILDINGS:SC_UNITS,e.type))throw new Error("Unknown unit or building type.");register(e.id);
   if(!scFinite(e.x,.1,63.9)||!scFinite(e.y,.1,47.9)||!scFinite(e.hp,0,20000)||!scFinite(e.maxHp,1,20000)||e.hp>e.maxHp||!scFinite(e.cooldown,0,10000))throw new Error("Invalid entity position or health.");
   if(isB){let d=SC_BUILDINGS[e.type];if(typeof e.complete!=="boolean"||!scFinite(e.work,0,d.time+.2)||!Array.isArray(e.queue)||e.queue.length>6)throw new Error("Invalid construction state.");
    if(Math.abs(e.x-d.w/2-Math.round(e.x-d.w/2))>.01||Math.abs(e.y-d.h/2-Math.round(e.y-d.h/2))>.01)throw new Error("Building is not grid-aligned.");
    for(let j=0;j<e.queue.length;j++){let q=e.queue[j];if(!q||!own(SC_UNITS,q.type)||SC_UNITS[q.type].from!==e.type||!scFinite(q.left,0,1000)||!scFinite(q.total,.1,1000)||!scFinite(q.paid,0,10000))throw new Error("Invalid production queue.");register(q.id);}
    if(e.rally&&(!scFinite(e.rally.x,0,64)||!scFinite(e.rally.y,0,48)))throw new Error("Invalid rally point.");
   }else{order(e.order);if(!Array.isArray(e.orders)||e.orders.length>8||!scFinite(e.angle,-1000,1000)||!scFinite(e.cargo,0,350)||!scFinite(e.stuck,0,100000000))throw new Error("Invalid unit state.");for(let j=0;j<e.orders.length;j++)order(e.orders[j]);e.way=null;}
  }
 }
 if(!Array.isArray(s.fields)||s.fields.length>64)throw new Error("Invalid resource fields.");
 for(let i=0;i<s.fields.length;i++){let f=s.fields[i];register(f.id);if(!scFinite(f.x,0,64)||!scFinite(f.y,0,48)||!scFinite(f.amount,0,100000000)||!scFinite(f.max,1,100000000))throw new Error("Invalid resource amount.");}
 if(!Array.isArray(s.explored)||s.explored.length!==2)throw new Error("Missing exploration state.");
 for(let t=0;t<2;t++){if(!Array.isArray(s.explored[t])||s.explored[t].length!==3072)throw new Error("Invalid fog grid dimensions.");for(let i=0;i<3072;i++)if(s.explored[t][i]!==0&&s.explored[t][i]!==1)throw new Error("Invalid fog grid.");}
 if(!Array.isArray(s.shots)||s.shots.length>1000||!Array.isArray(s.fx)||s.fx.length>100)throw new Error("Invalid effects state.");
 for(let i=0;i<s.shots.length;i++){let q=s.shots[i];register(q.id);if(["bullet","rocket","shell","artillery"].indexOf(q.weapon)<0||(q.team!==0&&q.team!==1)||!Array.isArray(q.vs)||q.vs.length!==4)throw new Error("Invalid projectile.");for(let k of ["x","y","sx","sy","tx","ty"])if(!scFinite(q[k],0,64))throw new Error("Projectile outside map.");for(let k of ["damage","splash","age","ttl"])if(!scFinite(q[k],0,10000))throw new Error("Invalid projectile lifetime.");for(let j=0;j<4;j++)if(!scFinite(q.vs[j],0,10))throw new Error("Invalid damage modifier.");}
 for(let i=0;i<s.fx.length;i++){let f=s.fx[i];register(f.id);if(!scFinite(f.x,0,64)||!scFinite(f.y,0,48)||!scFinite(f.age,0,10))throw new Error("Invalid explosion.");}
 if(!s.ai||!Array.isArray(s.ai.known)||s.ai.known.length>160||!scFinite(s.ai.nextThink,0,100001000)||!scFinite(s.ai.nextAttack,0,100001000))throw new Error("Invalid AI state.");
 for(let i=0;i<s.ai.known.length;i++){let k=s.ai.known[i];if(!own(SC_BUILDINGS,k.type)||!scFinite(k.x,0,64)||!scFinite(k.y,0,48))throw new Error("Invalid AI knowledge.");}
 if(["","VICTORY","DEFEAT","DRAW"].indexOf(s.result)<0)throw new Error("Invalid result.");
 s.log=Array.isArray(s.log)?s.log.slice(0,8).map(function(l){return {tick:scFinite(l.tick,0,100000000)?l.tick:0,text:String(l.text).slice(0,240)};}):[];
 s.message=String(s.message||"").slice(0,240);s.orders=[];s.sounds=[];s.visible=[new Array(3072).fill(0),new Array(3072).fill(0)];s.navVersion=1;
 let c=scCache();scRebuildNav(s,c);
 // Reject overlapping structures/terrain, which would otherwise permanently trap units.
 let occupied={};for(let i=0;i<s.buildings.length;i++){let b=s.buildings[i];if(b.hp<=0)continue;let d=SC_BUILDINGS[b.type];for(let y=Math.round(b.y-d.h/2);y<b.y+d.h/2;y++)for(let x=Math.round(b.x-d.w/2);x<b.x+d.w/2;x++){let n=y*64+x;if(x<1||x>62||y<1||y>46||c.terrain[n]||occupied[n])throw new Error("Structures overlap blocked terrain.");occupied[n]=true;}}
 if(!r.camera||!scFinite(r.camera.x,0,2048)||!scFinite(r.camera.y,0,1536)||!scFinite(r.camera.zoom,.65,1.75))r.camera={x:0,y:160,zoom:1};
 r.selection=Array.isArray(r.selection)?r.selection.slice(0,80).filter(function(id){let e=scGet(s,id);return e&&e.team===0;}):[];
 let groups={};for(let k=1;k<=5;k++)if(r.groups&&Array.isArray(r.groups[k]))groups[k]=r.groups[k].slice(0,80).filter(function(id){let e=scGet(s,id);return e&&e.team===0;});r.groups=groups;
 return r;
}
function scRestore(text){
 let r=scValidateSave(text),p=scPrivate();p.sim=r.simulation;p.camera=r.camera;p.selection=r.selection;p.groups=r.groups;p.cache=scCache();p.keys={};p.drag=null;p.mode="select";p.build="";p.fogDirty=true;
 scRebuildNav(p.sim,p.cache);scSpatial(p.sim,p.cache);scEconomy(p.sim);scVision(p.sim);screen="play";paused=true;chosenMap=p.sim.map;chosenFaction=p.sim.players[0].faction;chosenDifficulty=p.sim.difficulty;saveOpen=false;scRender();
}
function saveLocal(){
 try{let text=scSnapshot();localStorage.setItem("scorchline.save.v1",text);if(localStorage.getItem("scorchline.save.v1")!==text)throw new Error("Storage did not retain the save.");hasSave=true;saveStatus="Local checkpoint saved.";scNotice(scPrivate().sim,saveStatus);}
 catch(e){saveStatus="Local save failed: "+String(e.message||e)+". Export a portable save instead.";scNotice(scPrivate().sim,saveStatus);}scRender();
}
function loadLocal(){try{let text=localStorage.getItem("scorchline.save.v1");if(!text)throw new Error("No local checkpoint exists.");scRestore(text);saveStatus="Checkpoint loaded. Press Resume.";}catch(e){saveStatus="Load failed: "+String(e.message||e);scNotice(scPrivate().sim,saveStatus);scRender();}}
function openSave(){paused=true;saveOpen=true;saveText=scSnapshot();saveStatus="Copy this portable snapshot, or paste one to import. Local saves stay in this app's browser storage.";}
function closeSave(){saveOpen=false;}
function changeSaveText(v){saveText=String(v);}
function importSaveText(){try{scRestore(saveText);saveStatus="Save imported. Press Resume.";}catch(e){saveStatus="Import rejected: "+String(e.message||e);}}
function exportSaveFile(){
 let text=scSnapshot();saveText=text;
 try{softn.files.saveFile("Scorchline-"+scPrivate().sim.tick+".json",text,{mime:"application/json"},function(result){if(result&&result.error)saveStatus="File export failed: "+result.error+". Copy the snapshot below instead.";else saveStatus="Save file handed to the browser. The snapshot remains available below.";});}
 catch(e){saveStatus="File export unavailable. Copy the snapshot below instead.";}
}

