// Blockscape — the game: first-person movement with gravity and swimming, a
// pointer-locked camera, break and place with the crosshair, a nine-slot
// hotbar, a day that turns into night, and a world that saves itself.
//
// The loop is `gameStep`, not `tick`: the runtime marks functions named
// tick/update/animate/render droppable and skips them when its queue is
// busy, which would freeze the player mid-air.

let DT = 0.033
let GRAVITY = 24
let JUMP_V = 8.4
let WALK = 4.4
let SPRINT = 6.8
let FLY = 10
let SWIM = 2.6
let REACH = 7
let DAY_SECONDS = 300

// Synced to the UI.
let objects = []
let lights = []
let cameraPos = { x: 32, y: 40, z: 32 }
let cameraLookAt = { x: 32, y: 40, z: 40 }
let sceneFog = { color: "#9fd0ff", near: 42, far: 125 }
let skyColor = "#87ceeb"
let started = false
let hasSave = false
let touchMode = false
let touchSprint = false
let nearChest = false
let isLocked = false
let paused = false
let showHelp = false
let hotbar = []
let slotIdx = 0
let hudPos = ""
let hudTime = ""
let hudTarget = ""
let hudBlocks = 0
let toast = ""
let toastTimer = 0.0
let flying = false
let underwater = false
let dayPhase = 0.28
let muted = false

// Player state lives in the VM.
let px = 32
let py = 30
let pz = 32
let vx = 0
let vy = 0
let vz = 0
let yaw = 0
let pitch = 0
let onGround = false
let bobPhase = 0
let placedCount = 0
let autosaveTimer = 0.0
let dirty = false
let particles = []
let pad = { presses: {} }
let touchJumpHeld = false
let touchSinkHeld = false
let pauseStamp = 0
let pickSwingTimer = 0.0
let chestPos = { x: 32.5, y: 20.0, z: 32.5 }
let chestCollected = false
let glowTorches = []
let wasWet = false
let stepAccum = 0.0
let sceneEffects = {
  ambientOcclusion: { radius: 0.72, intensity: 0.85 },
  bloom: { strength: 0.25, radius: 0.22, threshold: 1.25 },
  vignette: 0.22
}
let rngSeed = 1
let lastLocked = false
let breakCooldown = 0
let placeCooldown = 0

function playSfx(path, vol) {
  if (muted) { return }
  try {
    if (typeof softn !== "undefined" && softn.audio && softn.audio.play) {
      softn.audio.play(path, { volume: vol || 0.45 })
    }
  } catch (err) {}
}

function toggleMute() {
  muted = !muted
  try {
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("blockscape:muted", muted ? "1" : "0")
    }
  } catch (err) {}
}

function hexRgb(hex) {
  if (!hex || hex.length < 7) { return [0.9, 0.85, 0.7] }
  let r = parseInt(hex.slice(1, 3), 16) / 255.0
  let g = parseInt(hex.slice(3, 5), 16) / 255.0
  let b = parseInt(hex.slice(5, 7), 16) / 255.0
  if (isNaN(r) || isNaN(g) || isNaN(b)) { return [0.9, 0.85, 0.7] }
  return [r, g, b]
}

let HOTBAR_TYPES = [1, 2, 3, 4, 6, 8, 9, 10, 11]

function myRand() {
  rngSeed = (rngSeed * 48271) % 2147483647
  return rngSeed / 2147483647
}

// ---- Init and input -----------------------------------------------------

function isUiControl(e) {
  let tag = e.targetTag || (e.target && e.target.tagName ? e.target.tagName.toLowerCase() : "")
  return tag === "input" || tag === "textarea" || tag === "select" || tag === "button" || !!e.targetEditable
}

function isLikelyTouch() {
  if (typeof window === "undefined") { return false }
  let coarse = false
  try { coarse = !!(window.matchMedia && window.matchMedia("(pointer: coarse)").matches) } catch (err) {}
  return coarse || window.innerWidth <= 760
}

function _init() {
  if (typeof window !== "undefined" && window.__vxCleanup) { window.__vxCleanup() }
  initBlockTables()
  rngSeed = (Date.now() % 100000) + 17
  pad = { presses: {} }
  touchJumpHeld = false
  touchSinkHeld = false
  touchSprint = false
  touchMode = isLikelyTouch()
  if (typeof window !== "undefined") {
    window.__vxAction = 0
    window.__vxWheel = 0
    window.__vxTouch = touchMode
    window.__scene3dLocked = false
    window.__scene3dWantLock = false
    window.__scene3dReleaseLock = false
  }

  let i = 0
  let bar = []
  while (i < HOTBAR_TYPES.length) {
    let t = HOTBAR_TYPES[i]
    bar.push({ type: t, name: BLOCK_NAMES[t], color: swatchFor(t), key: String(i + 1) })
    i = i + 1
  }
  hotbar = bar

  if (typeof window !== "undefined") {
    function onWheel(e) {
      if (e.deltaY > 0) { window.__vxWheel = 1 }
      else if (e.deltaY < 0) { window.__vxWheel = -1 }
    }
    window.addEventListener("wheel", onWheel)
    window.__vxCleanup = function () {
      window.removeEventListener("wheel", onWheel)
    }
  }

  try {
    hasSave = !!localStorage.getItem("blockscape:world")
    muted = localStorage.getItem("blockscape:muted") === "1"
  } catch (err) {
    hasSave = false
    muted = false
  }
  generateWorld(Math.floor(Date.now() % 100000))
  titleOrbit()
  buildLights()
  composeObjects()
}

function _onHide() {
  pad = { presses: {} }
  touchJumpHeld = false
  touchSinkHeld = false
  if (started && !paused) { paused = true }
  if (typeof window !== "undefined" && window.__vxCleanup) {
    window.__vxCleanup()
    window.__vxCleanup = null
  }
}

function onControlPress(action) {
  if (!started) { return }
  if (action === "mute") {
    toggleMute()
    return
  }
  if (action === "pause") {
    if (showHelp) {
      showHelp = false
      if (!paused && !touchMode && typeof window !== "undefined") { window.__scene3dWantLock = true }
      return
    }
    if (paused) {
      if (Date.now() - pauseStamp < 220) { return }
      resumeGame()
    } else {
      paused = true
      pauseStamp = Date.now()
      if (typeof window !== "undefined") { window.__scene3dReleaseLock = true }
    }
    return
  }
  if (action === "help") {
    showHelp = !showHelp
    let locked = typeof window !== "undefined" && !!window.__scene3dLocked
    if (showHelp && locked && typeof window !== "undefined") { window.__scene3dReleaseLock = true }
    else if (!showHelp && !paused && !touchMode && typeof window !== "undefined") { window.__scene3dWantLock = true }
    return
  }
  if (paused || showHelp) { return }
  if (action === "fly") {
    flying = !flying
    vy = 0
    touchSinkHeld = false
    showToast(flying ? "Flying. Space to rise, C to sink." : "Walking.")
    return
  }
  if (action === "chest") { tryOpenChest(); return }
  if (action === "break") { doBreak(); return }
  if (action === "place") { doPlace(); return }
  if (action.length === 2 && action.charAt(0) === "s") {
    let idx = parseInt(action.charAt(1), 10) - 1
    if (idx >= 0 && idx < hotbar.length) { slotIdx = idx }
  }
}

// Before the game starts the camera circles the island slowly.
let titleAngle = 0
function titleOrbit() {
  titleAngle = titleAngle + 0.0022
  let cx = WX / 2
  let cz = WZ / 2
  px = cx + Math.cos(titleAngle) * 34
  pz = cz + Math.sin(titleAngle) * 34
  py = 30 - P_EYE
  yaw = Math.atan2(cx - px, cz - pz)
  pitch = -0.32
  window.__scene3dYaw = yaw
  window.__scene3dPitch = pitch
  hitOk = false
  updateCamera()
}

function swatchFor(t) {
  if (t === B_GRASS) { return "linear-gradient(180deg, #5cae4a 0 36%, #7b5433 36%)" }
  if (t === B_GLASS) { return "linear-gradient(135deg, #d6efff, #9cc9ee)" }
  if (t === B_GLOW) { return "radial-gradient(circle, #fff1b8, #f5b800)" }
  return PALETTE[t * 3]
}

// ---- Starting a world ---------------------------------------------------

// The island behind the title screen becomes the first world; after that,
// or when a caller asks for one outright, a new island is grown.
function newWorld(fresh) {
  if (fresh === true || started || placedCount > 0) { generateWorld(Math.floor(Date.now() % 100000) + 1) }
  particles = []
  flying = false
  underwater = false
  hitOk = false
  spawnPlayer()
  placedCount = 0
  autosaveTimer = 0.0
  dirty = true
  started = true
  paused = false
  showHelp = false
  if (!touchMode && typeof window !== "undefined") { window.__scene3dWantLock = true }
  showToast("Welcome to a new island.")
}

function startFirstWorld() {
  newWorld(false)
}

function startFreshWorld() {
  newWorld(true)
}

function isNum(v) {
  return typeof v === "number" && v === v && v - v === 0
}

function scanGlowTorchesFromWorld() {
  let found = []
  let x = 0
  while (x < WX && found.length < 10) {
    let z = 0
    while (z < WZ && found.length < 10) {
      let y = 1
      while (y < WY && found.length < 10) {
        if (blockAt(x, y, z) === B_GLOW) {
          found.push({ x: x, y: y, z: z })
        }
        y = y + 1
      }
      z = z + 1
    }
    x = x + 1
  }
  return found
}

function continueWorld() {
  let raw = ""
  let meta = null
  try {
    raw = localStorage.getItem("blockscape:world") || ""
    meta = JSON.parse(localStorage.getItem("blockscape:player") || "null")
  } catch (err) { raw = "" }
  if (raw === "" || !decodeWorld(raw)) {
    try { localStorage.removeItem("blockscape:world"); localStorage.removeItem("blockscape:player") } catch (err) {}
    hasSave = false
    newWorld(true)
    showToast("The saved island could not be read, so here is a new one.")
    return
  }
  particles = []
  hitOk = false
  if (meta && isNum(meta.seed)) { worldSeed = meta.seed }
  // A player record is only trusted whole: finite numbers, on or above the
  // island, and not inside a block (a NaN here would sink the camera for good).
  let placeOk = meta && isNum(meta.x) && isNum(meta.y) && isNum(meta.z) &&
    meta.y > -1 && meta.y < 200 && Math.abs(meta.x - WX / 2) < WX && Math.abs(meta.z - WZ / 2) < WZ &&
    !boxBlocked(meta.x, meta.y, meta.z)
  if (placeOk) {
    px = meta.x; py = meta.y; pz = meta.z
    vx = 0; vy = 0; vz = 0
    yaw = isNum(meta.yaw) ? meta.yaw : 0
    pitch = isNum(meta.pitch) ? Math.max(-1.5, Math.min(1.5, meta.pitch)) : 0
    flying = !!meta.flying
  } else {
    spawnPlayer()
  }
  if (meta) {
    if (isNum(meta.day)) { dayPhase = meta.day >= 0 && meta.day < 1 ? meta.day : ((meta.day % 1) + 1) % 1 }
    placedCount = isNum(meta.placed) ? Math.max(0, Math.floor(meta.placed)) : 0
    slotIdx = isNum(meta.slot) ? Math.max(0, Math.min(hotbar.length - 1, Math.floor(meta.slot))) : 0
    if (meta.chestPos && isNum(meta.chestPos.x) && isNum(meta.chestPos.y) && isNum(meta.chestPos.z)) {
      chestPos = { x: meta.chestPos.x, y: meta.chestPos.y, z: meta.chestPos.z }
    } else {
      let cx = Math.min(WX - 3, Math.max(2, Math.floor(px) + 2))
      let cz = Math.min(WZ - 3, Math.max(2, Math.floor(pz) + 2))
      let ch = Math.max(SEA + 1, groundHeight(cx, cz))
      chestPos = { x: cx + 0.5, y: ch + 1.0, z: cz + 0.5 }
    }
    chestCollected = !!meta.chestCollected
    if (Array.isArray(meta.glowTorches)) {
      let restored = []
      let ti = 0
      while (ti < meta.glowTorches.length && restored.length < 10) {
        let gt = meta.glowTorches[ti]
        if (gt && isNum(gt.x) && isNum(gt.y) && isNum(gt.z) && blockAt(gt.x, gt.y, gt.z) === B_GLOW) {
          restored.push({ x: gt.x, y: gt.y, z: gt.z })
        }
        ti = ti + 1
      }
      glowTorches = restored
    } else {
      glowTorches = scanGlowTorchesFromWorld()
    }
  } else {
    glowTorches = scanGlowTorchesFromWorld()
  }
  showHelp = false
  autosaveTimer = 0.0
  dirty = false
  window.__scene3dYaw = yaw
  window.__scene3dPitch = pitch
  updateCamera()
  started = true
  paused = false
  if (!touchMode && typeof window !== "undefined") { window.__scene3dWantLock = true }
  showToast("World restored.")
}

function spawnPlayer() {
  let sx = WX / 2
  let sz = WZ / 2
  let best = -1
  let bx = sx
  let bz = sz
  // The highest ground near the middle, so the first view is the island.
  let dx = -6
  while (dx <= 6) {
    let dz = -6
    while (dz <= 6) {
      let h = groundHeight(sx + dx, sz + dz)
      if (h > best && h > SEA + 1 && blockAt(sx + dx, h + 1, sz + dz) === B_AIR && blockAt(sx + dx, h + 2, sz + dz) === B_AIR) { best = h; bx = sx + dx; bz = sz + dz }
      dz = dz + 2
    }
    dx = dx + 2
  }
  if (best < 0) {
    // A low middle: the highest dry ground anywhere on the island instead,
    // rather than feet in the bedrock.
    let x = 2
    while (x < WX - 2) {
      let z = 2
      while (z < WZ - 2) {
        let h = groundHeight(x, z)
        if (h > best && blockAt(x, h + 1, z) === B_AIR && blockAt(x, h + 2, z) === B_AIR) { best = h; bx = x; bz = z }
        z = z + 3
      }
      x = x + 3
    }
  }
  if (best < 0) { best = surfaceHeight(sx, sz); bx = sx; bz = sz }
  px = bx + 0.5
  pz = bz + 0.5
  py = best + 1.02
  vx = 0; vy = 0; vz = 0
  yaw = Math.PI * 0.75
  pitch = -0.12
  let cx = Math.min(WX - 3, Math.max(2, bx + 2))
  let cz = Math.min(WZ - 3, Math.max(2, bz + 2))
  let ch = Math.max(SEA + 1, groundHeight(cx, cz))
  chestPos = { x: cx + 0.5, y: ch + 1.0, z: cz + 0.5 }
  chestCollected = false
  glowTorches = []
  wasWet = false
  window.__scene3dYaw = yaw
  window.__scene3dPitch = pitch
  updateCamera()
}

function tryOpenChest() {
  if (chestCollected) { return }
  let dx = px - chestPos.x
  let dy = py - chestPos.y
  let dz = pz - chestPos.z
  if (dx * dx + dz * dz <= 9.0 && Math.abs(dy) <= 3.2) {
    chestCollected = true
    placedCount = placedCount + 50
    dirty = true
    playSfx("assets/sfx/chest.wav", 0.55)
    spawnDebris(chestPos.x, chestPos.y + 0.4, chestPos.z, "#ffd24d")
    showToast("Island Treasure Opened! +50 Score")
  }
}

function saveWorld() {
  try {
    localStorage.setItem("blockscape:world", encodeWorld())
    localStorage.setItem("blockscape:player", JSON.stringify({
      x: px,
      y: py,
      z: pz,
      yaw: yaw,
      pitch: pitch,
      day: dayPhase,
      placed: placedCount,
      slot: slotIdx,
      flying: flying,
      seed: worldSeed,
      chestPos: chestPos,
      chestCollected: chestCollected,
      glowTorches: glowTorches
    }))
    hasSave = true
    dirty = false
    return true
  } catch (err) {
    showToast("Could not save: storage is full or blocked.")
    return false
  }
}

function saveNow() {
  if (saveWorld()) { showToast("World saved.") }
}

function resetWorld() {
  newWorld(true)
  saveWorld()
}

function showToast(text) {
  toast = text
  toastTimer = 2.6
}

function toggleHelp() {
  showHelp = !showHelp
}

function resumeGame() {
  paused = false
  showHelp = false
  if (!touchMode && typeof window !== "undefined") { window.__scene3dWantLock = true }
}

// ---- Camera and lighting ------------------------------------------------

function updateCamera() {
  let bob = 0
  if (onGround && !flying && (vx * vx + vz * vz) > 1) { bob = Math.sin(bobPhase) * 0.045 }
  cameraPos = { x: px, y: py + P_EYE + bob, z: pz }
  let cp = Math.cos(pitch)
  cameraLookAt = { x: px + Math.sin(yaw) * cp * 5, y: py + P_EYE + Math.sin(pitch) * 5, z: pz + Math.cos(yaw) * cp * 5 }
}

function lerp(a, b, t) { return a + (b - a) * t }

function hexLerp(h1, h2, t) {
  let r1 = parseInt(h1.slice(1, 3), 16)
  let g1 = parseInt(h1.slice(3, 5), 16)
  let b1 = parseInt(h1.slice(5, 7), 16)
  let r2 = parseInt(h2.slice(1, 3), 16)
  let g2 = parseInt(h2.slice(3, 5), 16)
  let b2 = parseInt(h2.slice(5, 7), 16)
  return rgbHex(lerp(r1, r2, t), lerp(g1, g2, t), lerp(b1, b2, t))
}

function rgbHex(r, g, b) {
  let s = "0123456789abcdef"
  let out = "#"
  let v = [r, g, b]
  let i = 0
  while (i < 3) {
    let n = Math.max(0, Math.min(255, Math.round(v[i])))
    out = out + s.charAt(n >> 4) + s.charAt(n & 15)
    i = i + 1
  }
  return out
}

// The sky is four colours a day sweeps through; the sun is a directional
// light that rides the same angle, and a hemisphere carries the bounce.
function buildLights() {
  let ang = dayPhase * Math.PI * 2
  let el = Math.sin(ang)
  let day = Math.max(0, Math.min(1, (el + 0.15) / 0.5))
  let dusk = Math.max(0, 1 - Math.abs(el) / 0.22)
  let sky = hexLerp("#0a1030", "#8fd0ff", day)
  sky = hexLerp(sky, "#f2a065", dusk * 0.55)
  let horizon = hexLerp("#141a33", "#dff1ff", day)
  horizon = hexLerp(horizon, "#ffb072", dusk * 0.7)
  skyColor = sky
  sceneFog = { color: horizon, near: underwater ? 2 : 42, far: underwater ? 14 : 125 }
  if (underwater) { skyColor = "#1a4c8f" }
  let sunI = 0.28 + 1.75 * day
  let list = [
    { id: "hemi", type: "hemisphere", color: hexLerp("#3a4a7a", "#ffffff", day), groundColor: hexLerp("#1a1a26", "#6b7d5a", day), intensity: 0.45 + 0.95 * day },
    {
      id: "sun",
      type: "directional",
      color: hexLerp("#9fb4ff", hexLerp("#ffd9a8", "#fff6e6", day), Math.max(day, 0.2)),
      intensity: sunI,
      position: { x: Math.cos(ang) * 45, y: Math.max(0.25, el) * 55, z: -26 },
      castShadow: day > 0.15,
      follow: "view",
      shadowMapSize: 2048,
      shadowCameraSize: 24,
      shadowBias: -0.0005,
      shadowNormalBias: 0.025
    },
    { id: "moonlight", type: "directional", color: "#7d95d6", intensity: 0.48 * (1 - day), position: { x: -Math.cos(ang) * 45, y: Math.max(0.2, -el) * 50, z: 26 } }
  ]
  let gi = 0
  while (gi < glowTorches.length && gi < 4) {
    let gt = glowTorches[gi]
    list.push({ id: "torch-pt-" + gi, type: "point", color: "#ffae45", intensity: 4.4, distance: 12, decay: 1.7, position: { x: gt.x + 0.5, y: gt.y + 0.9, z: gt.z + 0.5 } })
    gi = gi + 1
  }
  lights = list
}

// ---- The master step -----------------------------------------------------

function frameStep(rawDt) {
  let dt = rawDt || 0.016
  if (dt > 0.08) { dt = 0.08 }

  if (!started) {
    titleOrbit()
    dayPhase = dayPhase + dt / DAY_SECONDS
    if (dayPhase >= 1) { dayPhase = dayPhase - 1 }
    buildLights()
    composeObjects()
    return
  }
  let locked = typeof window !== "undefined" ? !!window.__scene3dLocked : false
  isLocked = locked
  if (lastLocked && !locked && !touchMode) { paused = true; pauseStamp = Date.now() }
  lastLocked = locked

  if (toastTimer > 0.0) {
    toastTimer = Math.max(0.0, toastTimer - dt)
    if (toastTimer <= 0.0) { toast = "" }
  }
  if (pickSwingTimer > 0.0) { pickSwingTimer = Math.max(0.0, pickSwingTimer - dt * 4.5) }

  if (typeof window !== "undefined" && window.__vxWheel !== 0) {
    slotIdx = (slotIdx + window.__vxWheel + hotbar.length) % hotbar.length
    window.__vxWheel = 0
  }

  let running = !paused && !showHelp
  if (running) {
    dayPhase = dayPhase + dt / DAY_SECONDS
    if (dayPhase >= 1) { dayPhase = dayPhase - 1 }
    if (typeof window !== "undefined") {
      if (window.__scene3dYaw !== undefined) { yaw = window.__scene3dYaw }
      if (window.__scene3dPitch !== undefined) { pitch = window.__scene3dPitch }
      if (window.__vxAction === 1) { window.__vxAction = 0; doBreak() }
      else if (window.__vxAction === 2) { window.__vxAction = 0; doPlace() }
    }
    movePlayer(dt)
    aim()
  } else if (typeof window !== "undefined") {
    window.__vxAction = 0
  }
  if (breakCooldown > 0.0) { breakCooldown = Math.max(0.0, breakCooldown - dt) }
  if (placeCooldown > 0.0) { placeCooldown = Math.max(0.0, placeCooldown - dt) }

  rebuildDirtyChunks()
  stepParticles(dt)
  updateCamera()
  buildLights()
  composeObjects()

  hudPos = Math.floor(px) + ", " + Math.floor(py) + ", " + Math.floor(pz)
  hudTime = clockText()
  hudBlocks = placedCount
  if (!chestCollected) {
    let cdx = px - chestPos.x
    let cdy = py - chestPos.y
    let cdz = pz - chestPos.z
    nearChest = (cdx * cdx + cdz * cdz) <= 9.0 && Math.abs(cdy) <= 3.2
  } else {
    nearChest = false
  }

  autosaveTimer = autosaveTimer + dt
  if (dirty && autosaveTimer > 30.0) { autosaveTimer = 0.0; saveWorld() }
}

function clockText() {
  let h = Math.floor(((dayPhase + 0.25) % 1) * 24)
  let m = Math.floor((((dayPhase + 0.25) % 1) * 24 - h) * 60)
  let mm = m < 10 ? "0" + m : "" + m
  let label = h < 5 || h >= 21 ? "night" : (h < 8 ? "dawn" : (h < 18 ? "day" : "dusk"))
  return h + ":" + mm + " · " + label
}

function movePlayer(dt) {
  let fwd = (pad.up ? 1 : 0) - (pad.down ? 1 : 0)
  let str = (pad.right ? 1 : 0) - (pad.left ? 1 : 0)
  let len = Math.sqrt(fwd * fwd + str * str)
  if (len > 0) { fwd = fwd / len; str = str / len }
  let wet = inWater(px, py, pz)
  if (wet && !wasWet && vy < -2.0) {
    playSfx("assets/sfx/splash.wav", 0.45)
  }
  wasWet = wet
  underwater = eyesInWater(px, py, pz)
  let jumpHeld = !!(pad.jump || touchJumpHeld)
  let sinkHeld = !!(pad.sink || touchSinkHeld)
  let speed = flying ? FLY : (wet ? SWIM : ((pad.sprint || touchSprint) ? SPRINT : WALK))
  let wx = Math.sin(yaw) * fwd - Math.cos(yaw) * str
  let wz = Math.cos(yaw) * fwd + Math.sin(yaw) * str
  let accel = onGround || flying || wet ? Math.min(1.0, 12.0 * dt) : Math.min(1.0, 3.0 * dt)
  vx = vx + (wx * speed - vx) * accel
  vz = vz + (wz * speed - vz) * accel

  if (flying) {
    let up = (jumpHeld ? 1 : 0) - (sinkHeld ? 1 : 0)
    vy = vy + (up * FLY * 0.8 - vy) * Math.min(1.0, 10.0 * dt)
  } else if (wet) {
    vy = vy - GRAVITY * 0.18 * dt
    if (jumpHeld) { vy = vy + 14 * dt }
    if (vy < -2.2) { vy = -2.2 }
    if (vy > 2.6) { vy = 2.6 }
    if (jumpHeld && onGround) { vy = JUMP_V * 0.85; onGround = false }
  } else {
    vy = vy - GRAVITY * dt
    if (jumpHeld && onGround) { vy = JUMP_V; onGround = false }
    if (vy < -40) { vy = -40 }
  }

  let wall = false
  let nx = px + vx * dt
  if (boxBlocked(nx, py, pz)) { if (!wet) { vx = 0 }; wall = true } else { px = nx }
  let nz = pz + vz * dt
  if (boxBlocked(px, py, nz)) { if (!wet) { vz = 0 }; wall = true } else { pz = nz }
  if (wet && wall && len > 0 && vy < 4 && blockAt(Math.floor(px), Math.floor(py) + 1, Math.floor(pz)) !== B_WATER) {
    let tx = px + wx * 0.5
    let tz = pz + wz * 0.5
    let fy = Math.floor(py)
    if (!boxBlocked(tx, fy + 1.001, tz) || !boxBlocked(tx, fy + 2.001, tz)) { vy = JUMP_V }
  }
  let ny = py + vy * dt
  onGround = false
  if (boxBlocked(px, ny, pz)) {
    if (vy < 0) {
      let landY = Math.floor(ny) + 1.001
      while (landY < py && boxBlocked(px, landY, pz)) { landY = landY + 1 }
      if (landY > py) { landY = py }
      onGround = true
      py = landY
    }
    vy = 0
  } else {
    py = ny
  }
  if (py < -5 || px < -20 || px > WX + 20 || pz < -20 || pz > WZ + 20) { spawnPlayer() }

  if (onGround && (vx * vx + vz * vz) > 1.2) {
    bobPhase = bobPhase + dt * 9.5
    stepAccum = stepAccum + dt * (pad.sprint ? 1.45 : 1.0)
    if (stepAccum >= 0.42) {
      stepAccum = 0.0
      playSfx("assets/sfx/step.wav", 0.16)
    }
  } else {
    bobPhase = 0
    stepAccum = 0.2
  }
}

function aim() {
  let cp = Math.cos(pitch)
  rayCast(px, py + P_EYE, pz, Math.sin(yaw) * cp, Math.sin(pitch), Math.cos(yaw) * cp, REACH)
  if (hitOk) {
    hudTarget = BLOCK_NAMES[blockAt(hitX, hitY, hitZ)]
  } else {
    hudTarget = ""
  }
}

function doBreak() {
  if (!hitOk || breakCooldown > 0) { return }
  let t = blockAt(hitX, hitY, hitZ)
  if (hitY <= 0) { showToast("Bedrock does not break."); return }
  pickSwingTimer = 1.0
  spawnDebris(hitX + 0.5, hitY + 0.5, hitZ + 0.5, PALETTE[t * 3])
  setBlock(hitX, hitY, hitZ, B_AIR)
  let gi = glowTorches.length - 1
  while (gi >= 0) {
    let gt = glowTorches[gi]
    if (gt.x === hitX && gt.y === hitY && gt.z === hitZ) { glowTorches.splice(gi, 1) }
    gi = gi - 1
  }
  if (hitY <= SEA && (blockAt(hitX + 1, hitY, hitZ) === B_WATER || blockAt(hitX - 1, hitY, hitZ) === B_WATER || blockAt(hitX, hitY, hitZ + 1) === B_WATER || blockAt(hitX, hitY, hitZ - 1) === B_WATER || blockAt(hitX, hitY + 1, hitZ) === B_WATER)) {
    setBlock(hitX, hitY, hitZ, B_WATER)
  }
  dirty = true
  breakCooldown = 0.13
  playSfx("assets/sfx/break.wav", 0.5)
}

function doPlace() {
  if (!hitOk || placeCooldown > 0) { return }
  let bx = hitX + hitNX
  let by = hitY + hitNY
  let bz = hitZ + hitNZ
  if (!inWorld(bx, by, bz)) { return }
  let existing = blockAt(bx, by, bz)
  if (existing !== B_AIR && existing !== B_WATER) { return }
  if (blockTouchesPlayer(bx, by, bz, px, py, pz)) { return }
  let btype = hotbar[slotIdx].type
  setBlock(bx, by, bz, btype)
  if (btype === B_GLOW) {
    glowTorches.unshift({ x: bx, y: by, z: bz })
    if (glowTorches.length > 10) { glowTorches.pop() }
  }
  pickSwingTimer = 0.65
  placedCount = placedCount + 1
  dirty = true
  placeCooldown = 0.13
  playSfx("assets/sfx/place.wav", 0.45)
}

function touchJumpDown() { touchJumpHeld = true }
function touchJumpUp() { touchJumpHeld = false }
function touchSinkDown() { touchSinkHeld = true }
function touchSinkUp() { touchSinkHeld = false }
function touchBreak() { window.__vxAction = 1 }
function touchPlace() { window.__vxAction = 2 }
function touchFly() { onControlPress("fly") }
function touchOpenChest() { tryOpenChest() }
function toggleTouchSprint() { touchSprint = !touchSprint }
function toggleTouchMode() {
  touchMode = !touchMode
  if (typeof window !== "undefined") {
    window.__vxTouch = touchMode
    if (touchMode) { window.__scene3dReleaseLock = true }
  }
}
function touchPause() {
  if (!started) { return }
  paused = !paused
  pauseStamp = Date.now()
  if (paused && typeof window !== "undefined") { window.__scene3dReleaseLock = true }
  else if (!paused && !touchMode && typeof window !== "undefined") { window.__scene3dWantLock = true }
}
function pickSlot(i) { slotIdx = i }

// A locked pointer reports every button through the scene's click.
// Touch mode uses explicit Mine / Build buttons so camera drags never place blocks accidentally.
function onSceneClick(hit) {
  if (!started || paused || showHelp) { return }
  if (hit && hit.locked) {
    if (hit.button === 2) { window.__vxAction = 2 }
    else if (hit.button === 0) { window.__vxAction = 1 }
    else if (hit.button === 1) { pickTargetBlock() }
  }
}

function pickTargetBlock() {
  if (!hitOk) { return }
  let t = blockAt(hitX, hitY, hitZ)
  let i = 0
  while (i < hotbar.length) {
    if (hotbar[i].type === t) { slotIdx = i; return }
    i = i + 1
  }
}

// ---- Debris and the per-frame objects -----------------------------------

function spawnDebris(x, y, z, color) {
  let c = hexRgb(color)
  let i = 0
  while (i < 10) {
    if (particles.length >= 120) { particles.shift() }
    particles.push({
      x: x + (myRand() - 0.5) * 0.6,
      y: y + (myRand() - 0.5) * 0.6,
      z: z + (myRand() - 0.5) * 0.6,
      vx: (myRand() - 0.5) * 4.2,
      vy: 2.2 + myRand() * 3.8,
      vz: (myRand() - 0.5) * 4.2,
      life: 0.65 + myRand() * 0.35,
      r: c[0],
      g: c[1],
      b: c[2]
    })
    i = i + 1
  }
}

function stepParticles(dt) {
  if (particles.length === 0) { return }
  let keep = []
  let i = 0
  while (i < particles.length) {
    let p = particles[i]
    p.vy = p.vy - GRAVITY * dt
    p.x = p.x + p.vx * dt
    p.y = p.y + p.vy * dt
    p.z = p.z + p.vz * dt
    if (isSolidAt(Math.floor(p.x), Math.floor(p.y), Math.floor(p.z))) {
      p.vy = 0
      p.vx = p.vx * 0.5
      p.vz = p.vz * 0.5
      p.y = Math.floor(p.y) + 1.01
    }
    p.life = p.life - dt
    if (p.life > 0) { keep.push(p) }
    i = i + 1
  }
  particles = keep
}

function pickBox(out, id, lx, ly, lz, w, h, d, color, metal, rough, emis, emisI, piv, rot) {
  // Rotate local offset in intrinsic XYZ order (= extrinsic Z, Y, X) so every
  // primitive attaches directly to camera with its own renderOrder = 1000.
  let cx = Math.cos(rot.x), sx = Math.sin(rot.x)
  let cy = Math.cos(rot.y), sy = Math.sin(rot.y)
  let cz = Math.cos(rot.z), sz = Math.sin(rot.z)
  let x1 = lx * cz - ly * sz
  let y1 = lx * sz + ly * cz
  let z1 = lz
  let x2 = x1 * cy + z1 * sy
  let y2 = y1
  let z2 = -x1 * sy + z1 * cy
  let rx = x2
  let ry = y2 * cx - z2 * sx
  let rz = y2 * sx + z2 * cx
  let spec = {
    id: id,
    type: "box",
    attach: "camera",
    position: { x: piv.x + rx, y: piv.y + ry, z: piv.z + rz },
    rotation: { x: rot.x, y: rot.y, z: rot.z },
    width: w,
    height: h,
    depth: d,
    color: color,
    opacity: 0.999,
    metalness: metal,
    roughness: rough,
    castShadow: false,
    receiveShadow: false
  }
  if (emis) {
    spec.emissive = emis
    spec.emissiveIntensity = emisI
  }
  out.push(spec)
}

function composeObjects() {
  let out = []
  if (hitOk) {
    out.push({ id: "aim", type: "box", position: { x: hitX + 0.5, y: hitY + 0.5, z: hitZ + 0.5 }, width: 1.02, height: 1.02, depth: 1.02, color: "#ffffff", opacity: 0.18, roughness: 1 })
  }

  // Island spawn Treasure Chest landmark
  if (!chestCollected) {
    out.push({
      id: "bs-chest",
      type: "model",
      modelUrl: "assets/models/treasure-chest.glb",
      fit: 0.92,
      position: { x: chestPos.x, y: chestPos.y, z: chestPos.z },
      rotation: { x: 0, y: 0.45, z: 0 },
      castShadow: true,
      receiveShadow: true
    })
  }

  // Placed Glowstone torches with Blender voxel-torch mesh
  let ti = 0
  while (ti < glowTorches.length) {
    let gt = glowTorches[ti]
    out.push({
      id: "bs-torch-" + ti,
      type: "model",
      modelUrl: "assets/models/voxel-torch.glb",
      fit: 0.72,
      position: { x: gt.x + 0.5, y: gt.y + 1.0, z: gt.z + 0.5 },
      castShadow: false
    })
    ti = ti + 1
  }

  let bobY = (onGround && (vx * vx + vz * vz) > 1 ? Math.sin(bobPhase) * 0.012 : 0)
  let swing = pickSwingTimer > 0.0 ? Math.sin(pickSwingTimer * Math.PI) : 0.0
  // Camera-attached voxel diamond pickaxe primitives + held offhand block.
  // Opacity 0.999 keeps each attach:"camera" box in the transparent pass at
  // renderOrder 1000 so water, ocean, glass, aim and solid chunks never draw over them.
  if (started) {
    let pickPiv = { x: 0.33 - swing * 0.07, y: -0.27 + bobY - swing * 0.06, z: -0.46 - swing * 0.10 }
    let pickRot = { x: -0.34 - swing * 0.62, y: 0.36 - swing * 0.14, z: 0.24 - swing * 0.10 }
    // Ordered far-to-near in camera depth (-z) and composed cleanly without overlapping faces
    pickBox(out, "pk-tip-f", 0.00, 0.208, -0.102, 0.022, 0.028, 0.044, "#67f3ff", 0.35, 0.14, "#169bb0", 0.42, pickPiv, pickRot)
    pickBox(out, "pk-tip-b", 0.00, 0.208, 0.102, 0.022, 0.028, 0.044, "#67f3ff", 0.35, 0.14, "#169bb0", 0.42, pickPiv, pickRot)
    pickBox(out, "pk-wing-f", 0.00, 0.232, -0.058, 0.026, 0.032, 0.056, "#32d4e8", 0.32, 0.18, "#0f8296", 0.32, pickPiv, pickRot)
    pickBox(out, "pk-wing-b", 0.00, 0.232, 0.058, 0.026, 0.032, 0.056, "#32d4e8", 0.32, 0.18, "#0f8296", 0.32, pickPiv, pickRot)
    pickBox(out, "pk-crown", 0.00, 0.244, 0.00, 0.030, 0.034, 0.064, "#29c7db", 0.32, 0.18, "#0f8296", 0.30, pickPiv, pickRot)
    pickBox(out, "pk-collar", 0.00, 0.205, 0.00, 0.034, 0.044, 0.044, "#b2bbc6", 0.80, 0.26, null, 0, pickPiv, pickRot)
    pickBox(out, "pk-shaft", 0.00, 0.085, 0.00, 0.026, 0.200, 0.026, "#8c5c32", 0.04, 0.78, null, 0, pickPiv, pickRot)
    pickBox(out, "pk-grip", 0.00, -0.055, 0.00, 0.030, 0.090, 0.030, "#4b2e16", 0.04, 0.88, null, 0, pickPiv, pickRot)

    let t = hotbar[slotIdx].type
    let handCol = t === B_GLOW ? "#ffe08a" : (t === B_GLASS ? "#d6efff" : (t === B_GRASS ? "#5cae4a" : PALETTE[t * 3]))
    out.push({
      id: "hand",
      type: "box",
      attach: "camera",
      position: { x: -0.30, y: -0.25 + bobY, z: -0.50 },
      rotation: { x: 0.25, y: 0.55, z: -0.08 },
      width: 0.115,
      height: 0.115,
      depth: 0.115,
      color: handCol,
      opacity: t === B_GLASS ? 0.55 : 0.999,
      emissive: t === B_GLOW ? "#ffcc4d" : "#000000",
      emissiveIntensity: t === B_GLOW ? 1.2 : 0,
      roughness: 0.85
    })
  }

  // Soft particle debris cloud
  if (particles.length > 0) {
    let pPos = []
    let pCols = []
    let pi = 0
    while (pi < particles.length) {
      let p = particles[pi]
      pPos.push(p.x, p.y, p.z)
      pCols.push(p.r, p.g, p.b)
      pi = pi + 1
    }
    out.push({
      id: "bs-debris",
      type: "particles",
      particlePositions: pPos,
      particleColors: pCols,
      particleSize: 0.24,
      particleShape: "soft",
      opacity: 0.92,
      fog: true
    })
  }

  let ang = dayPhase * Math.PI * 2
  out.push({ id: "sun", type: "sphere", radius: 5, position: { x: px + Math.cos(ang) * 85, y: py + Math.sin(ang) * 85, z: pz - 40 }, color: "#fff2b0", emissive: "#ffd36a", emissiveIntensity: 2.2 })
  out.push({ id: "moon", type: "sphere", radius: 3.4, position: { x: px - Math.cos(ang) * 85, y: py - Math.sin(ang) * 85, z: pz + 40 }, color: "#e6ecff", emissive: "#b9c6ff", emissiveIntensity: 1.1 })
  objects = out
}
