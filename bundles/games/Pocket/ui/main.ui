// main.ui — Pocket
// A grey plastic brick with a green screen in it.

<logic src="../logic/main.logic" />

<style>
/* The DMG palette: warm grey plastic, a bezel that is almost black, and the
   four greens of an unlit reflective LCD. */
.pk-shell,
.pk-shell * {
  box-sizing: border-box;
}

.pk-shell {
  --plastic: #c8c4bc;
  --plastic-dark: #a8a49c;
  --plastic-light: #dcd8d0;
  --bezel: #58585a;
  --bezel-dark: #3d3d3f;
  --screen: #8ba82a;
  --ink: #2c2c2e;
  --magenta: #a03a6a;
  --blue: #2f5f9e;
  width: 100%;
  max-width: 100vw;
  overflow-x: clip;
}

.pk-console {
  max-width: min(92vw, 56vh, 29rem);
}

.pk-lcd-dmg { background: #8ba82a !important; }
.pk-lcd-pocket { background: #b8bcb2 !important; }
.pk-lcd-kiwi { background: #7ec4b4 !important; }
.pk-lcd-amber { background: #c47e24 !important; }

/* Nearest-neighbour all the way up. The canvas is 160x144 being drawn at ~4x,
   and a browser that smooths it turns a sprite edge into a grey smear. */
.pk-console canvas {
  image-rendering: pixelated;
  image-rendering: crisp-edges;
}

/* Every raised surface on the real thing is a highlight on top and a shadow
   underneath, never a blur. */
.pk-raised {
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55),
              inset 0 -2px 3px rgba(0, 0, 0, 0.18),
              0 2px 4px rgba(0, 0, 0, 0.28);
}
.pk-inset {
  box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.45),
              inset 0 -1px 0 rgba(255, 255, 255, 0.28);
}

.pk-face {
  border: none;
  cursor: pointer;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
  transition: transform 60ms linear, box-shadow 60ms linear;
}
.pk-face:active {
  transform: translateY(2px);
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.4);
}

/* Start and Select sit at the DMG's angle. */
.pk-pill {
  transform: rotate(-25deg);
}
@media (max-width: 760px), (pointer: coarse) {
  .pk-pill {
    min-height: 34px !important;
    height: 34px !important;
    background: linear-gradient(transparent 9px, #7a767e 9px, #7a767e 25px, transparent 25px) !important;
    box-shadow: none !important;
  }
}

.pk-grille {
  background: repeating-linear-gradient(
    115deg,
    #a8a49c 0 3px,
    transparent 3px 9px
  );
}

/* The screen itself never smooths — the canvas is nearest-neighbour and the
   element must not undo that when the browser scales it. */
.pk-lcd canvas {
  image-rendering: pixelated;
  display: block;
}

.pk-led {
  animation: pk-pulse 2.4s ease-in-out infinite;
}
@keyframes pk-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.72; }
}
@media (prefers-reduced-motion: reduce) {
  .pk-led { animation: none; }
}

/* ---------------------------------------------------------------------------
   Narrow screens

   The console and its panel sit side by side, which needs about 54rem + 260px
   + gaps. Below that the panel drops underneath rather than squeezing the
   console — the picture is the thing worth the width. */
@media (max-width: 62rem) {
  .pk-shell {
    flex-direction: column;
    align-items: center;
    padding: 0.65rem 0.65rem 1rem !important;
  }
  .pk-console {
    max-width: min(94vw, 56vh, 28rem);
  }
  .pk-side {
    margin-left: 0 !important;
    margin-top: 0.85rem;
    max-width: min(94vw, 28rem) !important;
  }
}

@media (max-width: 52rem) {
  .pk-shell {
    padding: 0.55rem 0.5rem 0.85rem !important;
  }
  .pk-console {
    max-width: min(95vw, 390px) !important;
    padding: 0.7rem 0.75rem 0.9rem !important;
    gap: 0.45rem !important;
  }
  .pk-bezel {
    padding: 1rem 1.25rem 1.35rem !important;
  }
  .pk-controls {
    padding: 0.25rem 0.45rem 0 !important;
  }
  .pk-startsel {
    padding-top: 0.3rem !important;
  }
  .pk-grille {
    height: 20px !important;
    margin-top: 0.15rem !important;
  }
}

/* ---------------------------------------------------------------------------
   Landscape on a phone

   Short and wide: vh is scarce and vw is plentiful, which is the opposite of
   every other case. Trimming the shell padding and letting the console take
   most of the height is what keeps the screen a usable size — 62vh of a 360px
   viewport is a 223px console, which is smaller than the real hardware. */
@media (max-height: 30rem) and (orientation: landscape) {
  .pk-shell {
    padding: 0.4rem 0.5rem 0.5rem;
    align-items: center;
  }

  /* Stop being a handheld and become a controller.
     Stacked vertically the screen has to share 390px of height with a D-pad, a
     wordmark and a battery grille, which leaves a picture smaller than the real
     hardware — while two thirds of the width sits empty. Laid out as
     [D-pad | screen | buttons] the screen gets the whole height and the thumbs
     get the space they were going to occupy anyway. */
  /* !important throughout: the console carries display/gap/padding as inline
     style props, and an inline declaration beats a stylesheet rule no matter
     how specific the selector. Without it `display: grid` silently loses to
     `display: flex` and the layout below never happens. */
  .pk-console {
    max-width: none;
    width: 100% !important;
    display: grid !important;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: minmax(0, 1fr) auto;
    grid-template-areas:
      "dpad screen face"
      "dpad startsel face";
    align-items: center;
    justify-items: center;
    gap: 0.25rem 0.75rem !important;
    padding: 0.5rem 0.75rem !important;
    border-radius: 14px !important;
    /* A definite height, or the screen row is sized by its own content and
       `height: 100%` further down has nothing to resolve against — which lands
       the canvas at 1:1. dvh rather than vh so the address bar sliding away
       does not leave the console overflowing behind it.
       The 4.5rem is the runtime's tab strip. dvh measures the whole window but
       the bundle renders below that strip, so subtracting only the shell's own
       padding overflows by exactly the strip's height and pushes Start and
       Select off the bottom. Resolving it properly would need the app's own box
       — but `height: 100%` has no definite parent to resolve against here and
       collapses the shell entirely, which is worse than a constant. */
    height: calc(100dvh - 4.5rem);
  }
  @supports not (height: 100dvh) {
    .pk-console { height: calc(100vh - 4.5rem); }
  }

  /* display:contents so the D-pad and the face cluster become grid items in
     their own right rather than staying trapped in the row that held them.
     !important again — this one is an inline `display: flex` too, and without
     it both controls land in the same cell and shove the screen off-screen. */
  .pk-controls { display: contents !important; }
  .pk-dpad { grid-area: dpad; }
  .pk-face-cluster { grid-area: face; }
  .pk-startsel { grid-area: startsel; padding-top: 0 !important; }

  /* The bezel drives off height now, not width, and the LCD keeps its ratio. */
  .pk-bezel {
    grid-area: screen;
    padding: 0.4rem 0.5rem !important;
    height: 100% !important;
    width: 100%;
    display: flex !important;
    align-items: center;
    justify-content: center;
    border-radius: 8px !important;
    position: relative;
  }
  .pk-lcd {
    width: auto !important;
    height: 100% !important;
    max-width: 100%;
    flex: 0 1 auto;
  }

  /* No room for decoration when the whole console is 390px tall. */
  .pk-wordmark,
  .pk-grille { display: none !important; }
  .pk-bezel > p,
  .pk-bezel > span { display: none; }

  /* The panel is for between-sessions; scrolling to it is fine. */
  .pk-side { margin-top: 0.75rem; }
}

/* ---------------------------------------------------------------------------
   Touch

   Keyed on the pointer, not the width: a small window on a desktop still has a
   mouse, and a large tablet still has thumbs. */
@media (pointer: coarse) {
  /* Kill the double-tap-to-zoom delay, and stop a press on the pad from
     selecting the label or dragging the page with it. A held direction has to
     stay held while the thumb moves a little. */
  .pk-console button,
  .pk-dpad button {
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  /* 38px is comfortable under a cursor and marginal under a thumb; 46px is
     about the smallest that stays reliable while looking at the screen rather
     than the button. */
  .pk-dpad button {
    width: 42px !important;
    height: 42px !important;
  }
  .pk-face {
    width: 50px !important;
    height: 50px !important;
  }
  .pk-pill {
    width: 60px !important;
    height: 24px !important;
  }

  /* The face buttons keep their own :active feedback; the D-pad has none of its
     own, and without it a touch gives no sign it landed. */
  .pk-dpad button:active {
    filter: brightness(1.6);
  }
}

/* ---------------------------------------------------------------------------
   The drawer

   Off everywhere by default: on a desktop the panel sits beside the console and
   a button that opens something already visible is worse than no button. */
/* !important because <Button> and <Box> both carry a display of their own, and
   without it the toggle shows up in portrait next to the panel it would open —
   a button whose only effect is to hide something already on screen. */
.pk-menubtn { display: none !important; }
.pk-scrim { display: none !important; }

/* Short-and-wide is where it is actually needed, because the console takes the
   whole viewport height there. Portrait keeps the panel inline underneath —
   there is room, and a drawer would hide it for no reason. */
@media (max-width: 52rem), (max-height: 30rem) and (orientation: landscape) {
  .pk-menubtn {
    display: flex !important;
    position: fixed;
    top: 0.45rem;
    right: 0.45rem;
    z-index: 50;
    width: 40px;
    height: 40px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid #4a4a54;
    border-radius: 10px;
    background: rgba(28, 28, 34, 0.92);
    color: #d8d8dc;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }

  .pk-scrim {
    display: none !important;
    position: fixed;
    inset: 0;
    z-index: 39;
    background: rgba(0, 0, 0, 0.55);
  }
  .pk-menu-open .pk-scrim {
    display: block !important;
  }

  .pk-side {
    display: none !important;
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    /* !important, or the panel's own inline width:100% makes this a full-screen
       overlay rather than a drawer — and covering the game to change a setting
       is the thing a drawer exists to avoid. */
    width: min(22rem, 86vw) !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 3rem 0.75rem 1.5rem;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    background: #17171c;
    border-left: 1px solid #3a3a42;
  }
  .pk-menu-open .pk-side {
    display: flex !important;
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  .pk-side,
  .pk-scrim { transition: none; }
}

/* Notches and home indicators. */
@supports (padding: env(safe-area-inset-left)) {
  .pk-shell {
    padding-left: max(0.75rem, env(safe-area-inset-left));
    padding-right: max(0.75rem, env(safe-area-inset-right));
    padding-bottom: max(2rem, env(safe-area-inset-bottom));
  }
}
</style>

<App theme="dark">
  <Box className={menuOpen ? "pk-shell pk-menu-open" : "pk-shell"} style={{
    display: "flex",
    justifyContent: "center",
    alignItems: "flex-start",
    minHeight: "100%",
    padding: "0.85rem 1rem 1rem",
    background: "radial-gradient(circle at 50% 0%, #3a3a42 0%, #1c1c22 70%)"
  }}>

    // The way into the panel when it is a drawer. Hidden by the stylesheet at
    // any size where the panel is already on screen, so there is never a button
    // that opens something you can see.
    <Button className="pk-menubtn" @click={toggleMenu}>
      {menuOpen ? "✕" : "☰"}
    </Button>

    // Tapping away from an open drawer closes it, which is what every drawer
    // does and what a thumb reaches for first.
    <Box className="pk-scrim" @click={closeMenu} />

    // ---- The console -----------------------------------------------------
    <Box className="pk-raised pk-console" style={{
      width: "100%",
      background: "#c8c4bc",
      borderRadius: "12px 12px 44px 12px",
      padding: "0.85rem 0.9rem 1.1rem",
      display: "flex",
      flexDirection: "column",
      gap: "0.55rem"
    }}>

      // Bezel and screen
      <Box className="pk-inset pk-bezel" style={{
        background: "#58585a",
        borderRadius: "10px 10px 28px 10px",
        padding: "1.3rem 1.85rem 1.7rem",
        position: "relative"
      }}>
        // Power LED
        <Box style={{
          position: "absolute",
          left: "0.65rem",
          top: "50%",
          transform: "translateY(-50%)",
          display: "flex",
          flexDirection: "column",
          alignItems: "center",
          gap: "0.3rem"
        }}>
          <Box className={gbRunning ? "pk-led" : ""} style={{
            width: "9px",
            height: "9px",
            borderRadius: "50%",
            background: gbRomLoaded ? "#e04a4a" : "#5a3a3a",
            boxShadow: gbRomLoaded ? "0 0 7px rgba(224,74,74,0.9)" : "none"
          }} />
          <Text style={{ fontSize: "0.32rem", color: "#9a9a9c", letterSpacing: "0.1em", writingMode: "vertical-rl" }}>POWER</Text>
        </Box>

        // The screen
        <Box className={"pk-lcd pk-lcd-" + dmgPalette} style={{
          background: "#8ba82a",
          borderRadius: "2px",
          overflow: "hidden",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          aspectRatio: "160 / 144",
          width: "100%",
          position: "relative"
        }}>
          <PixelCanvas
            width={160}
            height={144}
            fit="contain"
            getFrame={frameSource}
            running={gbRunning}
            smooth={false}
            @fps={fpsReport}
            style={{ width: "100%", height: "100%" }}
          />
          <Box if={!gbRomLoaded} style={{
            position: "absolute",
            inset: 0,
            display: "flex",
            flexDirection: "column",
            alignItems: "center",
            justifyContent: "center",
            gap: "0.55rem",
            padding: "0.85rem",
            background: "rgba(12, 24, 16, 0.22)",
            textAlign: "center"
          }}>
            <Text style={{
              fontFamily: "monospace",
              fontSize: "0.78rem",
              fontWeight: 700,
              letterSpacing: "0.12em",
              color: "#0f2818"
            }}>POCKET · SM83</Text>
            <Button @click={playBuiltinCart} variant=ghost style={{
              background: "#0f380f",
              color: "#e0f8d0",
              border: "2px solid #306230",
              borderRadius: "8px",
              padding: "0.5rem 0.9rem",
              fontWeight: 700,
              fontSize: "0.78rem",
              letterSpacing: "0.03em",
              cursor: "pointer",
              boxShadow: "0 3px 0 rgba(8, 24, 16, 0.45)"
            }}>▶ Play Built-in Cartridge</Button>
            <Text style={{
              fontSize: "0.62rem",
              color: "#1a3622",
              fontWeight: 600,
              lineHeight: 1.35
            }}>POCKET BREAK (60fps DMG) · or insert .gb/.gbc</Text>
          </Box>
        </Box>

        // The screen legend, as printed on the bezel
        <Text style={{
          position: "absolute",
          bottom: "0.45rem",
          left: 0,
          right: 0,
          textAlign: "center",
          fontSize: "0.48rem",
          color: "#9a9a9c",
          letterSpacing: "0.14em"
        }}>160 × 144 · STEREO SOUND</Text>
      </Box>

      // Wordmark
      <Stack className="pk-wordmark" direction=horizontal gap=xs align=center style={{ justifyContent: "center", paddingTop: "0.05rem" }}>
        <Text style={{
          fontFamily: "Georgia, 'Times New Roman', serif",
          fontStyle: "italic",
          fontWeight: 700,
          fontSize: "1.2rem",
          color: "#2f3a8c",
          letterSpacing: "-0.02em"
        }}>Pocket</Text>
        <Text style={{ fontSize: "0.52rem", color: "#6a6a6c", letterSpacing: "0.1em", paddingTop: "0.35rem" }}>SOFTN</Text>
      </Stack>

      // ---- Controls ------------------------------------------------------
      <Box className="pk-controls" style={{
        display: "flex",
        justifyContent: "space-between",
        alignItems: "center",
        padding: "0.35rem 0.5rem 0"
      }}>
        <Box className="pk-dpad">
          <DPad
            @press={dpadPress}
            @release={dpadRelease}
            buttonSize={36}
            color="#3d3d3f"
          />
        </Box>

        <Box className="pk-face-cluster" style={{ display: "flex", gap: "0.55rem", alignItems: "center", transform: "rotate(-20deg)", paddingRight: "0.2rem" }}>
          <Stack direction=vertical gap=xs align=center>
            <Button className="pk-face" data-held={btnB} ariaLabel="B" @click={tapB} @pointerdown={holdB} @pointerup={releaseB} @pointercancel={releaseB} @pointerleave={releaseB} style={{
              width: "42px", height: "42px", borderRadius: "50%",
              background: btnB ? "#7d2450" : "#a03a6a",
              transform: btnB ? "translateY(2px)" : "none",
              color: "#f0e8ec", fontWeight: 700, fontSize: "0.85rem"
            }}>B</Button>
            <Text style={{ fontSize: "0.48rem", color: "#2f3a8c", fontWeight: 700 }}>B</Text>
          </Stack>
          <Stack direction=vertical gap=xs align=center style={{ marginTop: "-1rem" }}>
            <Button className="pk-face" data-held={btnA} ariaLabel="A" @click={tapA} @pointerdown={holdA} @pointerup={releaseA} @pointercancel={releaseA} @pointerleave={releaseA} style={{
              width: "42px", height: "42px", borderRadius: "50%",
              background: btnA ? "#7d2450" : "#a03a6a",
              transform: btnA ? "translateY(2px)" : "none",
              color: "#f0e8ec", fontWeight: 700, fontSize: "0.85rem"
            }}>A</Button>
            <Text style={{ fontSize: "0.48rem", color: "#2f3a8c", fontWeight: 700 }}>A</Text>
          </Stack>
        </Box>
      </Box>

      // Start and Select
      <Stack className="pk-startsel" direction=horizontal gap=md align=center style={{ justifyContent: "center", paddingTop: "0.35rem" }}>
        <Stack direction=vertical gap=xs align=center>
          <Button className="pk-face pk-pill" ariaLabel="Select" title="Select" @click={tapSelect} @pointerdown={holdSelect} @pointerup={releaseSelect} @pointercancel={releaseSelect} @pointerleave={releaseSelect} style={{
            width: "50px", height: "14px", borderRadius: "999px",
            background: "#7a767e", padding: 0
          }} />
          <Text style={{ fontSize: "0.48rem", color: "#2f3a8c", fontWeight: 700, letterSpacing: "0.08em" }}>SELECT</Text>
        </Stack>
        <Stack direction=vertical gap=xs align=center>
          <Button className="pk-face pk-pill" ariaLabel="Start" title="Start" @click={tapStart} @pointerdown={holdStart} @pointerup={releaseStart} @pointercancel={releaseStart} @pointerleave={releaseStart} style={{
            width: "50px", height: "14px", borderRadius: "999px",
            background: "#7a767e", padding: 0
          }} />
          <Text style={{ fontSize: "0.48rem", color: "#2f3a8c", fontWeight: 700, letterSpacing: "0.08em" }}>START</Text>
        </Stack>
      </Stack>

      // Speaker grille
      <Box className="pk-grille" style={{
        height: "24px",
        marginTop: "0.2rem",
        marginLeft: "auto",
        width: "40%",
        borderRadius: "4px",
        opacity: 0.65
      }} />
    </Box>

    // ---- Side panel ------------------------------------------------------
    <Box className="pk-side" style={{
      width: "100%",
      maxWidth: "280px",
      marginLeft: "1.1rem",
      display: "flex",
      flexDirection: "column",
      gap: "0.55rem",
      color: "#d8d8dc"
    }}>

      // Cartridge slot
      <Box style={{
        background: "#26262c",
        border: "1px solid #3a3a42",
        borderRadius: "8px",
        padding: "0.7rem 0.8rem"
      }}>
        <Text style={{ fontSize: "0.58rem", letterSpacing: "0.14em", color: "#8a8a94" }}>CARTRIDGE</Text>
        <Stack direction=vertical gap=xs style={{ paddingTop: "0.45rem" }}>
          <Button @click={playBuiltinCart} variant=ghost style={{
            width: "100%",
            background: "#9bbc0f",
            color: "#0f380f",
            fontWeight: 700,
            fontSize: "0.75rem",
            borderRadius: "7px",
            padding: "0.45rem 0.65rem",
            textAlign: "center"
          }}>▶ Play Built-in Cartridge</Button>
          <FileChooser
            accept=".gb,.gbc"
            label={gbRomLoaded ? "Swap .gb / .gbc file" : "Insert .gb / .gbc file"}
            @select={chooseRom}
          />
        </Stack>

        <Box if={loading} style={{ paddingTop: "0.4rem" }}>
          <Text style={{ fontSize: "0.68rem", color: "#9bbc0f" }}>Reading…</Text>
        </Box>

        <Stack if={gbRomLoaded} direction=vertical gap=xs style={{ paddingTop: "0.45rem" }}>
          <Text style={{ fontSize: "0.8rem", fontWeight: 600, color: "#f0f0f4" }}>{gbTitle}</Text>
          <Text style={{ fontSize: "0.62rem", color: "#8a8a94" }}>{gbMapperName + " · " + romSize}</Text>
          <Text if={gbGbcMode} style={{ fontSize: "0.58rem", color: "#c58fd8", letterSpacing: "0.08em" }}>COLOR</Text>
        </Stack>

        <Text if={hintText} style={{ fontSize: "0.65rem", color: "#7a7a84", paddingTop: "0.4rem", lineHeight: 1.38 }}>{hintText}</Text>
        <Text if={gbError} style={{ fontSize: "0.66rem", color: "#e06a6a", paddingTop: "0.4rem" }}>{gbError}</Text>
      </Box>

      // Transport + Audio stream
      <Stack direction=horizontal gap=xs>
        <Button @click={togglePause} disabled={!gbRomLoaded} variant=ghost style={{ flex: 1, background: gbRomLoaded ? "#9bbc0f" : "#3a3a42", color: gbRomLoaded ? "#0f380f" : "#7a7a84", fontWeight: 700, fontSize: "0.74rem", borderRadius: "8px", padding: "0.42rem 0.5rem" }}>
          {gbRunning || !gbRomLoaded ? "Pause" : "Resume"}
        </Button>
        <Button @click={resetMachine} disabled={!gbRomLoaded} variant=ghost style={{ flex: 1, background: "#2e2e36", color: gbRomLoaded ? "#e8e8ec" : "#7a7a84", border: "1px solid #3a3a42", fontSize: "0.74rem", borderRadius: "8px", padding: "0.42rem 0.5rem" }}>Reset</Button>
        <Button @click={toggleMute} variant=ghost style={{ background: muted ? "#4a2c32" : "#2e2e36", color: muted ? "#f2a8b0" : "#d8d8dc", border: "1px solid #3a3a42", fontSize: "0.72rem", borderRadius: "8px", padding: "0.42rem 0.6rem" }}>
          {muted ? "Unmute" : "Mute"}
        </Button>
      </Stack>

      <AudioStream
        getSamples={sampleSource}
        sampleRate={48000}
        channels={2}
        format="i16"
        bufferMs={90}
        running={gbRunning}
        muted={muted}
        @ready={audioStarted}
        @error={audioFailed}
      />

      // DMG Palette Switcher
      <Box style={{
        background: "#26262c",
        border: "1px solid #3a3a42",
        borderRadius: "8px",
        padding: "0.6rem 0.8rem"
      }}>
        <Stack direction=horizontal gap=xs align=center style={{ justifyContent: "space-between", paddingBottom: "0.4rem" }}>
          <Text style={{ fontSize: "0.58rem", letterSpacing: "0.14em", color: "#8a8a94" }}>DMG PALETTE</Text>
          <Text if={gbGbcMode} style={{ fontSize: "0.56rem", color: "#a888b8" }}>CGB native</Text>
        </Stack>
        <Stack direction=horizontal gap=xs>
          <Button @click={selectPalDmg} variant=ghost style={{
            flex: 1, padding: "0.3rem 0.2rem", borderRadius: "6px", fontSize: "0.64rem", fontWeight: 600,
            background: dmgPalette === "dmg" ? "#344824" : "#1e1e24",
            color: dmgPalette === "dmg" ? "#e0f8d0" : "#a0a89c",
            border: dmgPalette === "dmg" ? "1px solid #9bbc0f" : "1px solid #34343c"
          }}>DMG</Button>
          <Button @click={selectPalPocket} variant=ghost style={{
            flex: 1, padding: "0.3rem 0.2rem", borderRadius: "6px", fontSize: "0.64rem", fontWeight: 600,
            background: dmgPalette === "pocket" ? "#3c3e3c" : "#1e1e24",
            color: dmgPalette === "pocket" ? "#f2f4ee" : "#a4a6a2",
            border: dmgPalette === "pocket" ? "1px solid #d4d8ce" : "1px solid #34343c"
          }}>Pocket</Button>
          <Button @click={selectPalKiwi} variant=ghost style={{
            flex: 1, padding: "0.3rem 0.2rem", borderRadius: "6px", fontSize: "0.64rem", fontWeight: 600,
            background: dmgPalette === "kiwi" ? "#1d423e" : "#1e1e24",
            color: dmgPalette === "kiwi" ? "#dcfaee" : "#98b4ae",
            border: dmgPalette === "kiwi" ? "1px solid #70d0b8" : "1px solid #34343c"
          }}>Kiwi</Button>
          <Button @click={selectPalAmber} variant=ghost style={{
            flex: 1, padding: "0.3rem 0.2rem", borderRadius: "6px", fontSize: "0.64rem", fontWeight: 600,
            background: dmgPalette === "amber" ? "#482c12" : "#1e1e24",
            color: dmgPalette === "amber" ? "#ffeec4" : "#b8a088",
            border: dmgPalette === "amber" ? "1px solid #ecac48" : "1px solid #34343c"
          }}>Amber</Button>
        </Stack>
      </Box>

      // ---- Saves ---------------------------------------------------------
      <Box if={gbRomLoaded} style={{
        background: "#26262c",
        border: "1px solid #3a3a42",
        borderRadius: "8px",
        padding: "0.65rem 0.8rem"
      }}>
        <Text style={{ fontSize: "0.58rem", letterSpacing: "0.14em", color: "#8a8a94" }}>SAVES</Text>

        <Stack direction=vertical gap=xs style={{ paddingTop: "0.45rem" }}>
          <Stack direction=horizontal gap=xs align=center style={{ justifyContent: "space-between" }}>
            <Text style={{ fontSize: "0.68rem", color: "#c8c8d0" }}>Slot 1</Text>
            <Stack direction=horizontal gap=xs align=center>
              <Text style={{ fontSize: "0.58rem", color: "#7a7a84", minWidth: "4.2rem", textAlign: "right" }}>{slot1}</Text>
              <Button @click={saveSlot1} variant=ghost style={{ fontSize: "0.62rem", padding: "0.15rem 0.38rem" }}>Save</Button>
              <Button @click={loadSlot1} disabled={slot1 === "Empty"} variant=ghost style={{ fontSize: "0.62rem", padding: "0.15rem 0.38rem" }}>Load</Button>
              <Button if={slot1 !== "Empty"} @click={clearSlot1} title="Delete slot 1" variant=ghost style={{ fontSize: "0.6rem", padding: "0.15rem 0.34rem", color: "#e08a8a" }}>✕</Button>
            </Stack>
          </Stack>

          <Stack direction=horizontal gap=xs align=center style={{ justifyContent: "space-between" }}>
            <Text style={{ fontSize: "0.68rem", color: "#c8c8d0" }}>Slot 2</Text>
            <Stack direction=horizontal gap=xs align=center>
              <Text style={{ fontSize: "0.58rem", color: "#7a7a84", minWidth: "4.2rem", textAlign: "right" }}>{slot2}</Text>
              <Button @click={saveSlot2} variant=ghost style={{ fontSize: "0.62rem", padding: "0.15rem 0.38rem" }}>Save</Button>
              <Button @click={loadSlot2} disabled={slot2 === "Empty"} variant=ghost style={{ fontSize: "0.62rem", padding: "0.15rem 0.38rem" }}>Load</Button>
              <Button if={slot2 !== "Empty"} @click={clearSlot2} title="Delete slot 2" variant=ghost style={{ fontSize: "0.6rem", padding: "0.15rem 0.34rem", color: "#e08a8a" }}>✕</Button>
            </Stack>
          </Stack>

          <Stack direction=horizontal gap=xs align=center style={{ justifyContent: "space-between" }}>
            <Text style={{ fontSize: "0.68rem", color: "#c8c8d0" }}>Slot 3</Text>
            <Stack direction=horizontal gap=xs align=center>
              <Text style={{ fontSize: "0.58rem", color: "#7a7a84", minWidth: "4.2rem", textAlign: "right" }}>{slot3}</Text>
              <Button @click={saveSlot3} variant=ghost style={{ fontSize: "0.62rem", padding: "0.15rem 0.38rem" }}>Save</Button>
              <Button @click={loadSlot3} disabled={slot3 === "Empty"} variant=ghost style={{ fontSize: "0.62rem", padding: "0.15rem 0.38rem" }}>Load</Button>
              <Button if={slot3 !== "Empty"} @click={clearSlot3} title="Delete slot 3" variant=ghost style={{ fontSize: "0.6rem", padding: "0.15rem 0.34rem", color: "#e08a8a" }}>✕</Button>
            </Stack>
          </Stack>
        </Stack>

        <Stack direction=horizontal gap=sm align=center style={{ justifyContent: "space-between", paddingTop: "0.45rem" }}>
          <Text style={{ fontSize: "0.58rem", color: eraseArmed ? "#e0a0a0" : "#7a7a84" }}>{eraseArmed ? "Erase cartridge SRAM?" : "Battery SRAM is automatic"}</Text>
          <Stack direction=horizontal gap=xs align=center>
            <Button if={eraseArmed} @click={cancelErase} variant=ghost style={{ fontSize: "0.58rem", padding: "0.12rem 0.4rem", color: "#c8c8d0" }}>Keep</Button>
            <Button @click={eraseBattery} variant=ghost style={{ fontSize: "0.58rem", padding: "0.12rem 0.4rem", color: eraseArmed ? "#ffffff" : "#d08a8a", background: eraseArmed ? "#a03a3a" : "transparent", borderRadius: "6px" }}>{eraseArmed ? "Erase" : "Erase…"}</Button>
          </Stack>
        </Stack>

        <Text if={saveStatus} style={{ fontSize: "0.62rem", color: "#9bbc0f", paddingTop: "0.35rem" }}>{saveStatus}</Text>
        <Text if={batteryStatus} style={{ fontSize: "0.62rem", color: "#e0a0a0", paddingTop: "0.35rem" }}>{batteryStatus}</Text>
      </Box>

      // Telemetry & Controls
      <Box style={{
        background: "#26262c",
        border: "1px solid #3a3a42",
        borderRadius: "8px",
        padding: "0.65rem 0.8rem",
        display: "flex",
        flexDirection: "column",
        gap: "0.28rem"
      }}>
        <Stack direction=horizontal gap=sm style={{ justifyContent: "space-between" }}>
          <Text style={{ fontSize: "0.65rem", color: "#8a8a94" }}>Painted / Emulated</Text>
          <Text style={{ fontSize: "0.72rem", fontWeight: 600, color: "#9bbc0f" }}>{fpsText + " / " + gbFps + " fps"}</Text>
        </Stack>
        <Stack direction=horizontal gap=sm style={{ justifyContent: "space-between" }}>
          <Text style={{ fontSize: "0.65rem", color: "#8a8a94" }}>Frames · Audio</Text>
          <Text style={{ fontSize: "0.7rem", color: "#d8d8dc" }}>{audioRate ? (gbFrameCounter + " · " + audioRate) : ("" + gbFrameCounter)}</Text>
        </Stack>
        <Text style={{ fontSize: "0.6rem", color: "#9a9aa6", lineHeight: 1.45, paddingTop: "0.25rem", borderTop: "1px solid #33333c" }}>
          Move: Arrows/WASD · A: Z/J · B: X/K · Start: Enter · Select: Shift
        </Text>
      </Box>
    </Box>
  </Box>
</App>
