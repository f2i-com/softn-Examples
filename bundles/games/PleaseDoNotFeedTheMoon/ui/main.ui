<logic src="../logic/main.logic" />
<import Store from="./store.ui" />
<import Counter from="./counter.ui" />
<import Pages from="./pages.ui" />
<style>
.moon-root{--ink:#e6e8d8;--muted:#98adaf;--night:#101e31;--mint:#b8d5bd;--rose:#dda99b;--paper:#eee9d8;position:relative;height:100%;min-height:0;width:100%;background:#09131f;color:var(--ink)!important;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;isolation:isolate;box-sizing:border-box;padding:0 24px 30px;overflow-x:hidden;overflow-y:auto;overscroll-behavior:contain;color-scheme:dark}
.moon-root *,.moon-root *:before,.moon-root *:after{box-sizing:border-box}
.moon-root button{font:inherit;color:inherit;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent;transition:background-color .18s,outline-color .18s}
.moon-root button:focus-visible{outline:3px solid #c2e1c8!important;outline-offset:4px!important;z-index:60}
.moon-root button:disabled{cursor:default}
.moon-root img{user-select:none;-webkit-user-drag:none;pointer-events:none}
.moon-app{max-width:1440px;margin:0 auto!important;position:relative}
.top-bar{height:82px!important;display:flex!important;align-items:center;justify-content:space-between;gap:20px;border-bottom:1px solid #dce9d615;margin-bottom:18px!important}
.brand{display:flex!important;align-items:center;gap:13px;min-width:0}
.brand-orbit{width:29px;height:29px!important;border-radius:50%!important;background:#ccd2b8;box-shadow:inset -8px -3px 0 #7c9897!important;flex:0 0 auto;position:relative}
.brand-orbit:after{content:"";position:absolute;left:7px;top:11px;width:3px;height:3px!important;background:#304c53;border-radius:50%!important;box-shadow:10px 0 #304c53!important}
.brand-title{display:block!important;font-size:13px!important;letter-spacing:1.5px!important;font-weight:700!important;line-height:1.4!important}
.brand-sub{display:block!important;font:9px/1.5 monospace!important;letter-spacing:2px!important;color:#869c9f!important;margin-top:5px!important}
.top-tools{display:flex!important;align-items:center;gap:9px;flex:0 0 auto}
.top-button{background:transparent!important;border:1px solid #91aba338!important;border-radius:4px!important;padding:9px 12px!important;min-height:40px;height:auto!important;color:#b4c4be!important;font-size:11px!important;font-weight:400!important;white-space:nowrap!important}
.top-button:hover{background:#d5e8d613!important}.log-button{color:#d9dfc8!important}.log-button.new{border-color:#d3bf8a90!important;background:#dac68b13!important}
.shop{border:1px solid #bad6cc25;border-radius:6px!important;overflow:hidden;background:#121e30;position:relative}
.room{position:relative;width:100%;aspect-ratio:1280/720;overflow:hidden;isolation:isolate;transform-origin:50% 50%;background:#19283b}
.back-wall{position:absolute;inset:0;background:linear-gradient(180deg,#1c2d3f 0%,#213749 43%,#172c3c 70%,#182331 100%)}
.back-wall:after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(0deg,transparent 0,transparent 54px,#d7e0cd05 55px,#06162438 57px),repeating-linear-gradient(90deg,transparent 0,transparent 128px,#a9bbbc05 129px)}
.night-window{position:absolute;left:24%;top:5.7%;width:58.8%;height:61%!important;overflow:hidden;background:radial-gradient(ellipse at 47% 45%,#3d5b6b 0%,#243a56 35%,#142841 73%);border:12px solid #0d1b2d;box-shadow:0 0 0 2px #a1b5a24a,0 10px 25px #0005!important;z-index:1}
.sky-haze{position:absolute;inset:0;background:linear-gradient(20deg,#afc6a905,transparent 40%,#c8cbb41c 60%,transparent 83%)}
.skyline{position:absolute;bottom:0;width:100%;height:24%!important;display:flex!important;align-items:flex-end;gap:4px;opacity:.5}
.skyline>div{background:#0b2037;width:19%;height:55%!important;box-shadow:inset 8px 0 #112b40!important;position:relative}
.skyline>div:after{content:"";position:absolute;left:15%;top:25%;width:5px;height:4px!important;background:#c6af7444;box-shadow:15px 0 #c6af7425,0 13px #c6af7433!important}
.skyline>div:nth-child(2n){height:75%!important}.skyline>div:nth-child(3n){height:40%!important}.skyline>div:nth-child(4n){height:100%!important}
.star{position:absolute;background:#d3d7bd;border-radius:50%!important;z-index:2;pointer-events:none;box-shadow:0 0 6px #dae4cd4a!important}
.caffeinated .star{animation:star-jitter .28s ease-in-out infinite alternate}.midnight-fm .star{animation:star-dance 1.5s ease-in-out infinite alternate;background:#efb9cf}
@keyframes star-jitter{0%{transform:translate(-1px,0)}100%{transform:translate(2px,-2px)}}
@keyframes star-dance{0%{transform:translate(-5px,4px) scale(1)}100%{transform:translate(6px,-6px) scale(1.8)}}
.moon-aura{position:absolute;left:20%;top:-20%;width:72%;aspect-ratio:1;z-index:2;pointer-events:none;transition:background 1s,opacity 1s}
.moon-position{position:absolute;aspect-ratio:1;z-index:5;transform-origin:center;pointer-events:none;transition:width 1.2s cubic-bezier(.2,.7,.3,1)}
.moon-disc{display:block!important;position:relative!important;width:100%!important;height:100%!important;min-height:0!important;padding:0!important;background:transparent!important;border:none!important;border-radius:50%!important;box-shadow:0 0 40px #e1e1b522,0 0 110px #cdd5ad16!important;overflow:visible!important;opacity:1!important;pointer-events:auto;transform-origin:center;isolation:isolate;outline-offset:8px!important}
.moon-disc:hover:not(:disabled){box-shadow:0 0 0 1px #f5f0d444,0 0 65px #dce4b833!important}
.moon-texture{position:absolute!important;inset:0;width:100%!important;height:100%!important;border-radius:50%!important;filter:contrast(1.05);pointer-events:none}
.moon-tint{position:absolute;inset:0;border-radius:50%!important;mix-blend-mode:color;pointer-events:none;transition:opacity 1s,background 1s}
.lunar-face{position:absolute;left:24%;top:42%;width:52%;height:35%!important;z-index:2;transition:transform .5s;pointer-events:none}
.eye{position:absolute;top:11%;width:12%;height:7%!important;background:#253c42;border-radius:50%!important;box-shadow:0 -2px 2px #263e4144,0 2px 1px #e0dfbc99!important;transition:height .5s,transform .5s,top .5s;overflow:hidden}
.eye-left{left:17%;transform:rotate(5deg)}.eye-right{right:17%;transform:rotate(-7deg)}
.eye-glint{position:absolute;left:34%;top:35%;width:16%;height:20%!important;border-radius:50%!important;background:#d3d7b6;opacity:0;transition:opacity .5s}
.moon-mouth{position:absolute;top:45%;left:44%;width:12%;height:5%!important;border-bottom:2px solid #41585077;border-radius:50%!important;transition:all .45s;opacity:.65}
.mood-anticipating .eye{height:17%!important;top:7%;width:14%}.mood-anticipating .moon-mouth{height:28%!important;width:16%;left:42%;background:#293e45;border-bottom:0;box-shadow:inset 0 0 8px #142936!important}
.mood-awake .eye{height:27%!important;top:0%;width:16%;border-radius:45%!important}.mood-awake .eye-glint{opacity:.9}.mood-awake .moon-mouth{width:7%;left:46%;height:12%!important;background:#33494d}
.mood-delighted .eye,.mood-tender .eye{height:11%!important;background:transparent;border-top:4px solid #365048;border-radius:50% 50% 0 0!important;box-shadow:none!important}
.mood-delighted .moon-mouth{width:24%;left:38%;height:16%!important;border-bottom:4px solid #36504899}
.mood-tender .moon-mouth{width:20%;left:40%;height:7%!important;transform:rotate(-4deg)}
.mood-sleepy .eye{height:3%!important;top:14%;transform:rotate(-3deg);box-shadow:0 -3px 5px #384e4355!important}.mood-sleepy .moon-mouth{height:11%!important;width:8%;left:46%;background:#485a50}
.mood-angry .eye-left{transform:rotate(23deg);height:7%!important}.mood-angry .eye-right{transform:rotate(-23deg);height:7%!important}.mood-angry .moon-mouth{transform:rotate(180deg);height:18%!important;width:20%;left:40%;border-bottom:4px solid #34494a}
.mood-confused .eye-left{height:7%!important;transform:rotate(-14deg)}.mood-confused .eye-right{height:20%!important;top:0%;width:15%}.mood-confused .moon-mouth{transform:rotate(-20deg)}
.mood-surprised .eye{height:21%!important;top:0%}.mood-surprised .moon-mouth{height:24%!important;background:#3b5051}
.mood-suspicious .eye-left{height:3%!important;transform:rotate(10deg)}.mood-suspicious .eye-right{height:8%!important;transform:rotate(-13deg)}
.mood-sulking .lunar-face{transform:translate(-19%,-3%) rotate(-9deg)!important}.mood-sulking .eye{height:3%!important}.mood-sulking .moon-mouth{transform:rotate(180deg);width:20%;height:12%!important}
.mood-listening .eye-left{height:13%!important}.mood-listening .eye-right{height:6%!important}
.lunar-blush{position:absolute;left:25%;top:58%;width:10%;height:5%!important;background:#dfae7855;border-radius:50%!important;filter:blur(5px);box-shadow:120px 0 8px #dfae7844!important;pointer-events:none}
.lunar-ring{position:absolute;left:50%;top:56%;width:148%;height:37%!important;border:9px double #d2e0ca;border-radius:50%!important;z-index:3;pointer-events:none;box-shadow:0 0 12px #c1e4cd4a!important;transition:opacity 1s}
.lunar-growth{position:absolute!important;height:auto!important;aspect-ratio:128/140;z-index:9;filter:drop-shadow(0 0 7px #b2e4a333);pointer-events:none}
.lunar-polar-cap{position:absolute!important;top:5%;right:20%;width:25%!important;height:30%!important;transform:rotate(17deg);opacity:.85;mix-blend-mode:luminosity;pointer-events:none}
.lunar-badge{position:absolute!important;top:73%;left:38%;width:21%!important;height:26%!important;transform:rotate(7deg);pointer-events:none}
.broadcast-mark{position:absolute;right:18%;top:75%;width:28%;height:13%!important;display:flex!important;align-items:center;justify-content:center;gap:7%;transform:rotate(-6deg);opacity:.7;pointer-events:none}
.broadcast-mark>div{height:35%!important;width:6%;border-radius:3px!important;background:#304d51;animation:equalise 1.3s ease-in-out infinite alternate}
.broadcast-mark>div:nth-child(2n){height:95%!important;animation-delay:-.4s}.broadcast-mark>div:nth-child(3n){height:65%!important;animation-delay:-.7s}
@keyframes equalise{0%{transform:scaleY(.35)}100%{transform:scaleY(1.1)}}
.lunar-circuit{position:absolute;inset:18%;border:2px solid #95e5e7aa;clip-path:polygon(0 0,60% 0,60% 38%,100% 38%,100% 100%,48% 100%,48% 63%,0 63%);box-shadow:0 0 13px #aee9ef!important;pointer-events:none}
.doughnut-hole{position:absolute;left:36%;top:35%;width:28%;height:28%!important;border-radius:50%!important;background:radial-gradient(circle at 37% 23%,#d9dac2 0 1px,transparent 2px),radial-gradient(circle at 70% 50%,#d9dac2 0 1px,transparent 2px),#112840;box-shadow:inset 5px 7px 10px #081622,0 -4px 2px #798e8a,0 3px 3px #e6e1bb!important;z-index:6;pointer-events:none}
.lunar-tv{position:absolute;left:17%;top:22%;width:66%;height:57%!important;background:#6e8c88;border:8px solid #495e6266;border-radius:16%!important;overflow:hidden;z-index:4;box-shadow:0 0 20px #bddecd44!important}
.tv-shop{position:absolute;inset:0;background:repeating-linear-gradient(0deg,transparent 0 3px,#0c1d2933 3px 4px),linear-gradient(#293f56 75%,#536c6e 75%);opacity:.85}.tv-moon{position:absolute;width:35%;aspect-ratio:1;background:#b8c5ac;border-radius:50%!important;left:39%;top:16%;box-shadow:inset -9px -4px #8ea79c!important}.tv-counter{position:absolute;left:0;right:0;bottom:12%;height:10%!important;background:#9aac9b}.tv-live{position:absolute;bottom:2%;left:8%;font:8px monospace!important;color:#d8e0c4!important}
.picket-sign{position:absolute;left:57%;top:70%;width:68%;padding:7% 2%;background:#ece1b6;border:2px solid #565a51;transform:rotate(-12deg);font:bold clamp(8px,1.2vw,20px) monospace!important;line-height:1.2!important;color:#35434a!important;z-index:7;box-shadow:3px 3px 0 #142a3433!important;pointer-events:none}.picket-sign:after{content:"";position:absolute;width:8%;height:40%!important;top:100%;left:45%;background:#ba9e78}.picket-sign>span,.picket-sign>p{display:block!important}.picket-small{display:block!important;font-size:65%!important}
.reflection-moon{position:absolute;left:64%;top:17%;width:22%;aspect-ratio:1;z-index:3;pointer-events:none;mix-blend-mode:screen;transition:opacity 2s;filter:blur(.4px)}
.satellite{position:absolute!important;height:auto!important;aspect-ratio:128/140;pointer-events:none;filter:drop-shadow(0 6px 4px #07121b88)}
.window-shine{position:absolute;left:24.7%;top:6.5%;width:57%;height:58.5%!important;z-index:12;pointer-events:none;background:linear-gradient(113deg,transparent 0% 11%,#d0e1d405 11.2% 14%,transparent 14.4% 77%,#d0e1d408 77.2% 80%,transparent 80.4%);border:1px solid #a2c2b01a}
.window-fog{position:absolute;left:24.8%;top:7%;width:56.8%;height:58%!important;z-index:13;pointer-events:none;background:radial-gradient(ellipse at 50% 90%,#e5c39799,transparent 70%),linear-gradient(0deg,#d2c9b075,transparent 80%);filter:blur(3px);transition:opacity 1s}
.window-frost{position:absolute;left:24.8%;top:7%;width:56.8%;height:58%!important;z-index:14;pointer-events:none;box-shadow:inset 0 0 35px 17px #b4dbdbb0,inset 0 0 2px 3px #d4f1e7!important;transition:opacity 1s;overflow:hidden}
.window-frost>div{position:absolute;bottom:0;left:0;width:30%;height:48%!important;background:repeating-linear-gradient(36deg,transparent 0 8px,#cff4eb99 9px 11px,transparent 12px 23px),repeating-linear-gradient(143deg,transparent 0 14px,#cff4eb99 15px 17px,transparent 18px 26px);clip-path:polygon(0 0,17% 41%,38% 24%,31% 58%,75% 34%,54% 75%,100% 100%,0 100%)}
.window-frost>div:nth-child(2){left:auto;right:0;transform:scaleX(-1)}.window-frost>div:nth-child(3){top:0;bottom:auto;transform:scaleY(-1)}.window-frost>div:nth-child(4){top:0;left:auto;right:0;transform:scale(-1)}
.window-frame{position:absolute;left:24%;top:5.7%;width:58.8%;height:61%!important;z-index:16;border:9px solid #122536;box-shadow:inset 1px 1px #a4bba357,0 2px #69888255!important;pointer-events:none}
.mullion{position:absolute;top:0;bottom:0;width:1.35%;background:linear-gradient(90deg,#183244,#385061,#11263a);box-shadow:3px 0 7px #07151c55!important}.mullion.first{left:21%}.mullion.second{left:77%}.window-sill{position:absolute;bottom:-17px;left:-4%;width:108%;height:20px!important;background:linear-gradient(#658787,#36556a 23%,#213b50 70%);box-shadow:0 5px 10px #07152399!important}
.ceiling{position:absolute;left:0;top:0;width:100%;height:5%!important;background:linear-gradient(#11202f,#152737);z-index:21;box-shadow:0 10px 14px #07162688!important}
.fluorescent{position:absolute;top:36%;height:13%!important;border-radius:3px!important;background:#dbecce;box-shadow:0 0 8px #dfedd2ba,0 0 32px #cfeab644,0 18px 55px 22px #dae4be0a!important;opacity:var(--flicker);animation:fluoresce 7s ease-in-out infinite}.tube-left{left:6%;width:25%}.tube-right{left:69%;width:24%;animation-delay:-3s}
@keyframes fluoresce{0%,85%,100%{opacity:var(--flicker)}90%{opacity:.7}94%{opacity:.86}}
.midnight-fm .fluorescent{background:#dca4cf;box-shadow:0 0 25px #d5a0d366!important;animation:equalise 2s ease-in-out infinite alternate}
.floor{position:absolute;left:0;right:0;top:66%;bottom:0;background:linear-gradient(#273f4b,#1c3444 50%,#233c47);z-index:0}
.floor-lines{position:absolute;inset:-55% -35% 0;background:repeating-linear-gradient(0deg,transparent 0 43px,#a9c5b31d 44px 46px),repeating-linear-gradient(90deg,transparent 0 119px,#07192870 121px 124px);transform:perspective(320px) rotateX(46deg);transform-origin:50% 100%}
.floor-reflection{position:absolute;left:23%;top:0;width:58%;height:100%!important;background:radial-gradient(ellipse at 50% 0%,#c0d9b322,transparent 56%);filter:blur(6px);transform:scaleY(-1);opacity:.7}
.indoor-tide{position:absolute;left:24%;right:15%;bottom:12%;height:calc(2% + var(--tide))!important;border-radius:45% 55% 35% 45%!important;background:repeating-linear-gradient(174deg,#9abbbc10 0 7px,#a6dddb22 8px 9px,transparent 10px 14px);z-index:5;animation:tide 5s ease-in-out infinite alternate;border-top:1px solid #d5e6d22b}
@keyframes tide{from{transform:rotate(-1deg) scaleX(.96)}to{transform:rotate(1deg) scaleX(1.03)}}
.policy-wrap{position:absolute;left:3.8%;top:9%;width:17.8%;z-index:22;transform:rotate(-2deg)}
.notice-header{display:block!important;font:7px monospace!important;letter-spacing:1.3px!important;color:#a5bdb7!important;margin:0 0 8px 4px!important}
.policy-sign{position:relative;display:flex!important;flex-direction:column!important;gap:2px;align-items:center!important;justify-content:center!important;width:100%;min-height:0!important;padding:12% 8%!important;background:#e8dfbd!important;border:2px solid #cebf9a!important;border-radius:1px!important;color:#6d3f46!important;box-shadow:4px 5px 0 #07182644!important;font:bold clamp(7px,1vw,14px)/1.3 monospace!important;text-align:center!important;transform-origin:50% 8%}
.policy-sign:before{content:"";position:absolute;left:37%;top:-6%;width:27%;height:12%!important;background:#adbcab9c;transform:rotate(6deg)}
.policy-big{font-size:150%!important;display:block!important;font-weight:900!important;letter-spacing:-.5px!important}.notice-foot{font:6px/1.5 monospace!important;display:block!important;color:#7b7470!important;margin-top:8px!important}
.sticky-note{display:block!important;width:82%;padding:7% 9%;margin:5% 0 0 18%!important;background:#c5c794;color:#394b50!important;box-shadow:3px 4px #08192844!important;transform:rotate(5deg);font:italic clamp(7px,1vw,12px)/1.45 Georgia,serif!important;white-space:pre-line!important}
.shelf-unit{position:absolute;left:3.8%;top:42%;width:17.7%;height:28%!important;z-index:18;transform-origin:50% 10%;background:linear-gradient(90deg,#243a4b,#304957 5%,#1c3345 6% 94%,#3e5862 95%);border:3px solid #3e5b68;box-shadow:6px 8px 14px #06162655!important}
.shelf-sign{position:absolute;top:-14%;left:0;width:100%;font:clamp(6px,.65vw,9px) monospace!important;letter-spacing:1.4px!important;color:#afc3bb!important;text-align:center}
.display-row{position:absolute;top:1%;left:4%;width:92%;height:45%!important;display:flex!important;align-items:flex-end;justify-content:center}.display-row>div,.display-row>img{width:29%!important;height:94%!important;filter:brightness(.73)}.display-row.lower{top:46%;height:48%!important;gap:16%}
.shelf-plank{position:absolute;left:-4%;width:108%;top:44%;height:5%!important;background:#658b8c;border-bottom:3px solid #223b4d;box-shadow:0 4px 6px #04182677!important}.shelf-plank:after{content:"$6.00                 $7.00";display:block!important;font:5px monospace;color:#213a4c;background:#bac4a8;width:72%;margin:0 auto!important;text-align:center}.lower-plank{top:94%}
.refrigerator{position:absolute;left:85%;top:24%;width:12%;height:45%!important;background:linear-gradient(90deg,#5a757e,#456171 10%,#2b4659 87%,#4b6a77);z-index:20;border-radius:5px 5px 0 0!important;border:3px solid #6b8d95;box-shadow:5px 7px 20px #061c2d66!important;transform-origin:50% 90%}
.fridge-brand{position:absolute;top:2.5%;left:0;width:100%;text-align:center;font:bold clamp(5px,.65vw,10px) monospace!important;letter-spacing:1px!important;color:#d5e7d6!important}
.fridge-case{position:absolute;left:8%;top:12%;width:84%;height:72%!important;background:linear-gradient(90deg,#2d647080,#1e4a5e 30%,#36737b 92%,#91c4bd);border:4px solid #172c40;box-shadow:inset 0 0 26px #bbf3d94a,0 0 22px #8ecfc62b!important;overflow:hidden}
.fridge-light{position:absolute;top:0;bottom:0;left:5%;width:3%;background:#cbead0;box-shadow:0 0 15px 3px #bcffcb55!important}
.fridge-lines{position:absolute;inset:0;background:repeating-linear-gradient(0deg,transparent 0 29%,#a5d4c657 29.5% 30%,transparent 31% 33%)}
.fridge-handle{position:absolute;right:4%;top:35%;width:5%;height:37%!important;border-radius:3px!important;background:#b9cebd;box-shadow:3px 0 #091c29!important}
.fridge-temp{position:absolute;bottom:2%;left:8%;color:#bde2b4!important;background:#132d36;border:1px solid #849f9655;font:clamp(7px,1.1vw,15px) monospace!important;padding:2px 4px}
.fridge-grille{position:absolute;bottom:3%;right:8%;width:45%;height:8%!important;background:repeating-linear-gradient(0deg,#152a3c 0 2px,#3f5c6a 3px 5px)}
.neon-sign{position:absolute;left:85%;top:15%;width:12%;font:clamp(6px,.85vw,12px)/1.5 monospace!important;letter-spacing:1.5px!important;text-align:center;color:#daa6a0!important;text-shadow:0 0 10px #df8c9a88;z-index:21;transform:rotate(1deg)}
.time-clock{position:absolute!important;left:69%;top:7.8%;width:12.2%;min-height:0!important;height:auto!important;z-index:24;display:flex!important;flex-direction:column!important;align-items:center!important;gap:2px!important;padding:7px 6px!important;background:#132838!important;border:3px solid #4e6a74!important;border-radius:3px!important;box-shadow:3px 4px 0 #081a2c77!important;color:#a7c4b0!important}
.clock-night{font:clamp(6px,.65vw,9px) monospace!important;letter-spacing:1.3px!important;display:block!important}.clock-digits{font:clamp(12px,2.1vw,28px)/1.25 monospace!important;letter-spacing:1px!important;text-shadow:0 0 12px #c2edb833}.clock-out{font:clamp(5px,.65vw,9px) monospace!important;letter-spacing:.6px!important;display:block!important;color:#92aaa2!important}.time-clock.ready{border-color:#a8bc8b!important;box-shadow:0 0 17px #c5dc9950!important}.time-clock.ready .clock-out{color:#dfedb1!important}
.breaker{position:absolute!important;left:24%;top:69%;width:5.5%;height:12%!important;min-height:44px!important;min-width:42px!important;z-index:28;display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:flex-end!important;padding:5px 3px!important;border:2px solid #657778!important;border-radius:4px!important;background:#364d5a!important;box-shadow:3px 3px #10273988!important;font:7px monospace!important;color:#cedac6!important}
.breaker-switch{position:absolute;top:20%;left:38%;width:26%;height:40%!important;border:2px solid #092b34;border-radius:2px!important;background:linear-gradient(#d6a18a 45%,#775e61 46% 70%,#263d48 71%);box-shadow:0 2px 2px #091c2b!important}.breaker-led{position:absolute;top:11%;right:11%;width:5px;height:5px!important;border-radius:50%!important;background:#c1dc9c;box-shadow:0 0 6px #d2e0a766!important}.resetting .breaker-led{background:#d59981}.resetting .breaker-switch{transform:rotate(180deg)}
.loose-product{position:absolute!important;height:auto!important;aspect-ratio:128/140;display:block!important;min-height:0!important;min-width:0!important;padding:0!important;background:transparent!important;border:0!important;border-radius:5px!important;z-index:26;opacity:1!important;filter:drop-shadow(0 7px 3px #05192866)}
.loose-product.catchable{min-width:38px!important;min-height:38px!important}
.loose-product:disabled{pointer-events:none}.catchable:hover{outline:1px dashed #d7e8c799!important;filter:drop-shadow(0 0 5px #d1e7bc55)}
.particle{position:absolute;z-index:27;pointer-events:none}.snow{width:4px;height:4px!important;background:#e0f4ef;border-radius:50%!important;box-shadow:0 0 3px #d4f4ef88!important}.steam{width:44px;height:21px!important;border-radius:50%!important;background:#e1dec854;filter:blur(8px)}.rain{width:1px;height:18px!important;background:linear-gradient(transparent,#b6dddd)}.spark{width:4px;height:10px!important;background:#beeded;box-shadow:0 0 10px #9ce4e8!important;clip-path:polygon(50% 0,30% 50%,100% 35%,35% 100%,55% 45%,0 65%)}.bubble{border:1px solid #d5e6df88;border-radius:50%!important;background:radial-gradient(circle at 30% 25%,#e2f4e866,transparent 33%);box-shadow:inset -2px -1px 4px #c3a8d82b!important}.paper{width:13px;height:25px!important;background:repeating-linear-gradient(0deg,#dddac7 0 3px,#6d849455 4px 5px);box-shadow:2px 2px 3px #08283866!important}.salt{width:4px;height:4px!important;background:#e5e2c7;transform:rotate(45deg)}
.electric-arc{position:absolute;left:30%;top:17%;width:15%;height:18%!important;background:#b3eeea;clip-path:polygon(0 0,37% 23%,14% 27%,87% 90%,52% 52%,74% 52%,100% 100%,43% 31%,60% 30%);z-index:23;filter:drop-shadow(0 0 7px #c5eeee);opacity:.65;pointer-events:none;animation:arc-breathe 2.5s ease-in-out infinite alternate}.arc-b{left:74%;top:33%;transform:rotate(140deg);width:12%;animation-delay:-1.4s}
@keyframes arc-breathe{from{opacity:.25}to{opacity:.8}}
.other-shop{position:absolute;left:31%;top:34%;width:38%;height:26%!important;background:linear-gradient(#162b45b0 60%,#698881b0 61% 64%,#2c4659b0 65%);border:2px solid #a8dbcd88;box-shadow:0 0 45px #b1d8cc44!important;z-index:15;pointer-events:none;transform:perspective(300px) rotateY(-8deg);animation:otherworld 7s ease-in-out infinite alternate}.other-shop>span,.other-shop>p{display:block!important;text-align:center;font:8px monospace!important;letter-spacing:3px!important;color:#c9ddd3!important;margin-top:6%!important}.other-counter{position:absolute;left:0;bottom:18%;width:100%;height:13%!important;background:#7ba79c}.other-employee{position:absolute;left:52%;bottom:24%;width:10%;height:33%!important;background:#394c65;border-radius:30% 30% 0 0!important}.other-employee:before{content:"";position:absolute;top:-43%;left:15%;width:70%;aspect-ratio:1;border-radius:50%!important;background:#b5ba9e}
@keyframes otherworld{from{opacity:.55}to{opacity:.95}}
.customer-zone{position:absolute;left:38%;top:60%;width:35%;height:23%!important;z-index:29;display:flex!important;gap:6%;align-items:flex-end;justify-content:center;pointer-events:none}
.customer{position:relative!important;width:45%;height:100%!important;min-width:0!important;min-height:0!important;padding:0!important;background:transparent!important;border:0!important;border-radius:0!important;display:block!important;opacity:1!important;pointer-events:auto}
.person{position:absolute;bottom:0;left:27%;width:46%;height:76%!important;filter:drop-shadow(0 8px 5px #071b2555)}
.person-coat{position:absolute;bottom:0;width:100%;height:59%!important;background:linear-gradient(90deg,#496170,#314c61 40%,#4c6575 85%);border-radius:38% 38% 5% 5%!important;border:2px solid #162e41}.person-coat:after{content:"";position:absolute;left:48%;top:9%;width:2px;height:84%!important;background:#97a39b55}
.person-head{position:absolute;left:20%;top:0;width:58%;height:52%!important;border-radius:42% 44% 35% 40%!important;background:linear-gradient(100deg,#c0ae91,#988f84);border:2px solid #20364a}.person-hair{position:absolute;left:-3%;top:-4%;width:105%;height:35%!important;border-radius:45% 50% 20% 0!important;background:#27333f}.person-eyes{position:absolute;left:20%;top:46%;width:7%;height:6%!important;background:#334553;box-shadow:15px 0 #334553!important}.person-hand{position:absolute;left:8%;bottom:5%;width:27%;height:20%!important;background:#b9ac92;border:2px solid #263e4e;border-radius:45%!important;transform:rotate(14deg)}
.customer-1 .person-coat{background:linear-gradient(90deg,#826c77,#69556d 60%,#806474)}.customer-1 .person-hair{background:#898b7b;height:30%!important}.customer-1 .person-head{background:#b9b6a0}
.order-bubble{position:absolute;bottom:80%;left:2%;width:96%;min-height:34px;background:#d3dcc7;color:#354e56!important;border:2px solid #9cbaac;box-shadow:3px 4px #071b283f!important;border-radius:8px 8px 8px 1px!important;display:grid!important;grid-template-columns:30% 1fr;grid-template-rows:1fr 1fr;align-items:center;padding:5px;gap:1px 4px}
.order-bubble>img,.order-bubble>div:first-child{grid-row:1/3;width:100%!important;height:100%!important;max-height:50px}.order-name{font:bold clamp(7px,.85vw,12px)/1.2 Arial!important;text-align:left;display:block!important}.serve-invite{font:clamp(5px,.65vw,9px) monospace!important;letter-spacing:.5px!important;text-align:left;color:#526c6d!important;display:block!important}.order-bubble.urgent{background:#e3c6ab;border-color:#d1a384}.customer:hover .order-bubble{background:#e2ecd5;box-shadow:0 0 12px #dce8cf44!important}
.customer-name{position:absolute;left:0;bottom:-9%;width:100%;text-align:center;font:clamp(5px,.6vw,9px) monospace!important;letter-spacing:.2px!important;color:#c7d6c4!important;white-space:nowrap!important}
.counter-back{position:absolute;left:-2%;right:-2%;bottom:-1%;height:19.5%!important;z-index:31;background:linear-gradient(177deg,#7f9590 0%,#466571 5%,#304a5e 10%,#1c3347 12%,#152d42 57%,#20374b 58%);border-top:2px solid #afc2a85c;box-shadow:0 -2px 12px #0a1d2a88!important}
.counter-back:after{content:"";position:absolute;left:15%;width:63%;bottom:0;top:14%;background:repeating-linear-gradient(90deg,transparent 0 14%,#43616a22 14.2% 14.5%,transparent 15% 28%)}
.till{position:absolute;left:6%;bottom:7%;width:17%;height:16%!important;background:linear-gradient(145deg,#3c5665 5%,#557477 6%,#3a5264 45%);border:2px solid #6b878778;border-radius:7px 7px 2px 2px!important;box-shadow:4px 7px 8px #071d2a77!important;z-index:34;transform:skewX(-4deg)}
.till-brand{position:absolute;top:6%;left:8%;font:clamp(5px,.6vw,8px) monospace!important;color:#c6d4bc!important;letter-spacing:1px!important}.till-screen{position:absolute;left:7%;top:27%;width:46%;height:36%!important;background:#1b3437;border:2px solid #6d8f8777;border-radius:3px!important;font:clamp(12px,1.8vw,25px) monospace!important;line-height:1.2!important;display:flex!important;align-items:center;justify-content:center;color:#bbdfad!important;text-shadow:0 0 7px #bce79733}.till-keys{position:absolute;right:8%;top:28%;width:29%;height:43%!important;transform:skewX(-5deg);background:repeating-linear-gradient(0deg,transparent 0 20%,#25424f 20% 29%),repeating-linear-gradient(90deg,#93a894 0 23%,#38596a 24% 34%);border-radius:2px!important}.till-little{position:absolute;bottom:5%;left:8%;font:clamp(5px,.5vw,8px) monospace!important;color:#94b1ac!important}
.counter-cup{position:absolute;left:31%;bottom:13%;width:3.8%;height:10%!important;border:2px solid #a2c6c870;border-radius:0 0 23% 22%!important;background:#b7cdb22a;overflow:hidden;z-index:35;transform:rotate(5deg)}.drink-liquid{position:absolute;bottom:-14%;left:-40%;width:180%;height:66%!important;background:#ba98758c;border-top:2px solid #ecd5a79c;transform-origin:50% 80%;transition:transform .1s}.cup-straw{position:absolute;left:68%;top:-20%;width:7%;height:100%!important;background:#ddb7a5;transform:rotate(-8deg);opacity:.8}
.receipt-roll{position:absolute!important;left:76%;bottom:3%;width:8%;height:20%!important;padding:0!important;min-height:0!important;border:0!important;border-radius:0!important;background:transparent!important;z-index:36;display:block!important;transform:rotate(4deg)}
.receipt-machine{position:absolute;top:0;left:-15%;width:125%;height:39%!important;background:linear-gradient(#536d70,#294653 70%);border:2px solid #75928c;border-radius:6px!important}.receipt-machine:after{content:"";position:absolute;left:10%;right:10%;height:10%!important;bottom:10%;background:#122d3b}
.receipt-paper{position:absolute;left:5%;top:25%;width:83%;height:70%!important;background:#dedfc6;color:#4d625d!important;display:flex!important;flex-direction:column;align-items:center;justify-content:center;box-shadow:3px 3px #10293955!important;clip-path:polygon(0 0,100% 0,100% 100%,90% 96%,80% 100%,70% 96%,60% 100%,50% 96%,40% 100%,30% 96%,20% 100%,10% 96%,0 100%);font:clamp(5px,.53vw,8px) monospace!important;letter-spacing:.5px!important}.receipt-count{display:block!important;font:clamp(14px,2vw,28px) Georgia,serif!important;line-height:1.4!important}.receipt-roll.unread .receipt-paper{background:#f0e0b6;box-shadow:0 0 18px #e3d3a333!important;animation:receipt-nudge 3s ease-in-out infinite}
@keyframes receipt-nudge{0%,85%,100%{transform:translateY(0)}90%{transform:translateY(3px)}}
.delivery-crate{position:absolute!important;right:4%;bottom:7%;width:9%;height:12%!important;min-height:0!important;padding:8px 2px!important;background:linear-gradient(120deg,#897c68,#6f6e62)!important;border:2px solid #474f53!important;border-radius:2px!important;z-index:35;transform:rotate(-3deg);display:flex!important;flex-direction:column!important;justify-content:space-between!important;font:clamp(5px,.6vw,8px) monospace!important;letter-spacing:.3px!important;color:#ced1af!important;box-shadow:5px 4px 2px #142c3e77!important}.crate-tape{position:absolute;left:44%;top:0;height:100%!important;width:18%;background:#a7a27b55}.crate-label{position:relative;background:#d1d1ae;padding:1px 5px;color:#40585c!important}
.held-item{position:absolute!important;left:52%;bottom:8%;width:9%!important;height:17%!important;z-index:38;transform:rotate(-13deg);filter:drop-shadow(0 0 14px #dce9c966);animation:offering 3.8s ease-in-out infinite alternate;pointer-events:none}
@keyframes offering{from{transform:translateY(0) rotate(-13deg)}to{transform:translateY(-5px) rotate(-10deg)}}
.thrown-item{position:absolute!important;height:auto!important;aspect-ratio:128/140;z-index:44;pointer-events:none;filter:drop-shadow(0 0 10px #d9e3d744)}
.shop-vignette{position:absolute;inset:0;box-shadow:inset 0 0 90px 15px #020e2144!important;z-index:39;pointer-events:none;opacity:.7}
.room-status{position:absolute;left:5%;bottom:2%;z-index:40;font:clamp(5px,.62vw,9px) monospace!important;letter-spacing:2px!important;color:#9eb5ae!important;pointer-events:none}
.shop-subtitles{min-height:48px;background:#101f30;border-top:1px solid #adc2b422;display:flex!important;align-items:center;gap:12px;padding:12px 24px;color:#b9c7bf!important;font:12px/1.5 Georgia,serif!important;font-style:italic!important}.subtitle-dot{width:5px;height:5px!important;background:#c1c9a8;border-radius:50%!important;flex:0 0 auto;box-shadow:0 0 8px #bdde9555!important}
.worktop{display:flex!important;align-items:center;justify-content:space-between;gap:24px;padding:22px 26px;background:linear-gradient(160deg,#1b3040,#172738);border:1px solid #a8beb128;border-top:0;border-radius:0 0 6px 6px!important;box-shadow:0 8px 30px #00000018!important}
.offering-info{display:flex!important;align-items:center;gap:18px;min-width:0}.offering-preview{width:56px!important;height:65px!important;flex:0 0 auto;filter:drop-shadow(0 7px 7px #051b24bb)}.offering-copy{min-width:0}.eyebrow{display:block!important;font:9px/1.5 monospace!important;letter-spacing:2px!important;color:#a4b9ad!important}.offering-name{display:block!important;font:25px/1.2 Georgia,serif!important;letter-spacing:-.3px!important;color:#e2e3cf!important;margin-top:3px!important}.offering-hint{display:block!important;font:11px/1.6 Arial!important;color:#a6b9b4!important;margin-top:5px!important}.offering-actions{display:flex!important;align-items:center;gap:19px;flex:0 0 auto}.feed-button{display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;gap:4px!important;background:#d9dfbe!important;color:#213b42!important;border:1px solid #eff3d1!important;border-radius:4px!important;padding:13px 28px!important;height:auto!important;min-height:65px;min-width:210px;font:17px/1.2 Georgia,serif!important;box-shadow:0 3px 0 #8caa9b!important}.feed-button:hover:not(:disabled){background:#e8eccb!important}.feed-button:active:not(:disabled){transform:translateY(2px);box-shadow:0 1px 0 #8caa9b!important}.feed-button:disabled{opacity:.5!important}.key-hint{display:block!important;font:8px/1.4 monospace!important;letter-spacing:1.4px!important;color:#4c6a61!important}.put-back{font:11px Arial!important;padding:10px 0!important;background:transparent!important;border:0!important;border-radius:0!important;color:#96aba5!important;min-height:44px;box-shadow:none!important}.put-back:disabled{opacity:.4!important}
.shelf-drawer{padding:28px 0 0}.drawer-heading{display:flex!important;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px!important}.aisle-tabs{display:flex!important;gap:6px}.aisle-tab{background:transparent!important;border:0!important;border-bottom:1px solid #748e803f!important;border-radius:0!important;color:#8ba39e!important;padding:10px 16px!important;min-height:42px;font:12px Arial!important;white-space:nowrap!important}.aisle-tab.active{color:#e5e3cd!important;border-bottom:2px solid #c1cbae!important}.aisle-tab:hover{background:#acbfa509!important}.drawer-instruction{font:8px monospace!important;letter-spacing:1.7px!important;color:#6e898a!important}
.product-shelf{display:flex!important;align-items:stretch;gap:8px;overflow-x:auto;scroll-snap-type:x proximity;padding:6px 5px 15px;scrollbar-width:thin;scrollbar-color:#516b6d #132537;background:linear-gradient(transparent 0 62%,#223748 63%,#385462 65%,#263c4d 69%,#1a2e40 75%);border-bottom:1px solid #8fa39122;overscroll-behavior-x:contain}
.product{position:relative!important;display:flex!important;flex:1 0 90px;max-width:145px;flex-direction:column!important;align-items:center!important;justify-content:flex-end!important;min-width:90px!important;height:154px!important;min-height:154px!important;gap:0!important;padding:6px 8px 8px!important;background:transparent!important;border:1px solid transparent!important;border-radius:4px!important;scroll-snap-align:start;overflow:visible!important;opacity:1!important;transition:background .18s,border-color .18s,transform .18s!important}
.product:hover:not(:disabled){background:#adbd9b0b!important;transform:translateY(-3px)}.product.selected{background:linear-gradient(#c4d1a509,#a9c2ac16)!important;border:1px solid #aebf974f!important}.product.selected .product-image{transform:translateY(-5px) rotate(-4deg);filter:drop-shadow(0 0 10px #d9e2af33)}.product.empty .product-image{opacity:.28}.product:disabled{opacity:.35!important}
.product-image{width:72px!important;height:89px!important;flex:0 0 89px;transition:transform .25s;filter:drop-shadow(0 5px 3px #071b2488)}
.price-ticket{position:relative;min-height:43px;width:100%;padding:6px 4px 3px;background:#c7cdaf;color:#3c5356!important;border-radius:1px!important;box-shadow:1px 2px 0 #071c2866!important;text-align:center;transform:rotate(-1deg)}.product:nth-child(2n) .price-ticket{transform:rotate(1deg);background:#b9c4af}.product-name{display:block!important;font:11px/1.3 Arial!important;white-space:nowrap!important}.stock-count{display:block!important;font:8px/1.4 monospace!important;letter-spacing:1px!important;color:#718078!important;margin-top:3px!important}.selection-dot{position:absolute;top:0;right:4px;width:5px;height:5px!important;background:#dce6bc;border-radius:50%!important;opacity:0;box-shadow:0 0 7px #d6eac366!important}.selected .selection-dot{opacity:1}
.shelf-footer{display:flex!important;justify-content:space-between;gap:12px;align-items:center;padding:12px 5px;color:#879e9b!important;font:11px/1.5 Georgia,serif!important;font-style:italic!important}.restock-link{background:transparent!important;border:0!important;padding:5px 0!important;min-height:36px;font:10px monospace!important;color:#b7c9b4!important;border-radius:0!important;white-space:nowrap!important}
.reaction-caption{display:flex!important;gap:25px;padding:20px 24px;margin-top:8px!important;background:#132332;border:1px solid #b6c7ae20;border-left:2px solid #a4b39261;border-radius:3px!important;min-height:100px;opacity:.5;transition:opacity .6s}.reaction-caption.visible{opacity:1}.reaction-number{font:8px/1.7 monospace!important;letter-spacing:1.5px!important;color:#859e92!important;flex:0 0 115px;padding-top:3px}.reaction-title{display:block!important;font:19px/1.35 Georgia,serif!important;color:#d2d9c1!important;margin-bottom:5px!important}.reaction-body{display:block!important;font:12px/1.7 Arial!important;color:#91a9a4!important;max-width:970px}
.bottom-line{display:flex!important;align-items:center;justify-content:space-between;gap:14px;margin-top:22px!important;padding:0 3px;color:#546f75!important;font:9px/1.5 monospace!important;letter-spacing:1px!important}.bottom-line>span:last-child{color:#738c88!important}
.welcome-overlay{position:absolute;left:0;right:0;top:100px;bottom:0;z-index:50;background:linear-gradient(90deg,#091826ef 0%,#102234e8 25%,#11233698 40%,transparent 64%);pointer-events:none}
.welcome-card{position:relative;width:47%;padding:6% 0 6% 5%;pointer-events:auto}.welcome-card .eyebrow{font-size:9px!important;letter-spacing:2.8px!important;color:#a3bba7!important}.welcome-title{display:block!important;margin-top:18px!important;font:clamp(36px,4.6vw,69px)/1.04 Georgia,serif!important;letter-spacing:-2.7px!important;color:#e7e8cc!important;white-space:pre-line!important}.title-moon{color:#c4d4b4!important;font-style:italic!important}.welcome-tag{display:block!important;margin-top:24px!important;font:clamp(17px,1.7vw,25px)/1.45 Georgia,serif!important;letter-spacing:-.5px!important;color:#c3cebd!important;white-space:pre-line!important}.welcome-copy{display:block!important;margin:20px 0 25px!important;font:12px/1.8 Arial!important;color:#94aeaa!important;white-space:pre-line!important}.start-button{display:inline-flex!important;align-items:center!important;justify-content:center!important;background:#dbe0bc!important;color:#243e42!important;border:1px solid #e9edce!important;border-radius:3px!important;padding:16px 20px!important;min-height:54px;font:15px Georgia,serif!important;box-shadow:0 4px 0 #8ea79d!important;white-space:normal!important}.start-button:hover{background:#e8edcf!important}.welcome-small{display:block!important;margin-top:22px!important;font:10px/1.7 Arial!important;color:#8ba6a3!important;white-space:pre-line!important}.welcome-options{display:flex!important;gap:20px;margin-top:18px!important}.text-button{font:10px monospace!important;background:transparent!important;border:0!important;border-bottom:1px solid #a0b79d44!important;border-radius:0!important;color:#b0c2b0!important;padding:7px 0!important;min-height:30px}.save-status{display:block!important;margin-top:15px!important;font:8px/1.5 monospace!important;color:#68888b!important;max-width:350px}
.overlay{position:absolute;inset:0;z-index:90;display:flex!important;align-items:flex-start;justify-content:center;overflow-y:auto;overscroll-behavior:contain;padding:28px 20px;background:#04111cdf;backdrop-filter:blur(6px);color:#35474d!important;color-scheme:light}
.paper-sheet{width:100%;max-width:500px;background:#e6e2ce;color:#35474d!important;padding:38px 42px 34px;box-shadow:0 20px 85px #0008!important;position:relative;clip-path:polygon(0 0,100% 0,100% 100%,97% 99.5%,94% 100%,91% 99.5%,88% 100%,85% 99.5%,82% 100%,79% 99.5%,76% 100%,73% 99.5%,70% 100%,67% 99.5%,64% 100%,61% 99.5%,58% 100%,55% 99.5%,52% 100%,49% 99.5%,46% 100%,43% 99.5%,40% 100%,37% 99.5%,34% 100%,31% 99.5%,28% 100%,25% 99.5%,22% 100%,19% 99.5%,16% 100%,13% 99.5%,10% 100%,7% 99.5%,4% 100%,0 99.5%)}
.paper-eyebrow{display:block!important;font:9px/1.6 monospace!important;letter-spacing:1.8px!important;color:#6a7d74!important}.paper-title{display:block!important;font:38px/1.14 Georgia,serif!important;letter-spacing:-1.3px!important;color:#33494c!important;margin:20px 0 18px!important;white-space:pre-line!important}.paper-copy{display:block!important;font:12px/1.8 Arial!important;color:#6b7a70!important;margin:10px 0 16px!important}.paper-button{display:flex!important;align-items:center!important;justify-content:center!important;min-height:44px;height:auto!important;width:100%;padding:13px 16px!important;margin-top:9px!important;background:transparent!important;border:1px solid #6b887752!important;border-radius:3px!important;color:#496054!important;font:12px/1.4 Arial!important;white-space:normal!important}.paper-button:hover{background:#8d9e8222!important}.paper-button.primary{background:#314f51!important;color:#e8e8cf!important;border-color:#314f51!important}.paper-button.primary:hover{background:#436261!important}.paper-foot{display:block!important;font:9px/1.6 monospace!important;color:#839084!important;letter-spacing:.5px!important;margin-top:22px!important}.small-sheet{margin-top:6vh!important}.receipt-totals{display:flex!important;flex-direction:column;gap:7px;border-top:1px dashed #8d9d8866;border-bottom:1px dashed #8d9d8866;padding:18px 0;margin:22px 0!important;font:12px/1.5 monospace!important;color:#4d665e!important}.ending-sheet{max-width:575px;padding:45px 48px}.ending-stamp{display:inline-block!important;font:bold 10px/1.5 monospace!important;letter-spacing:1.5px!important;border:2px solid #8f6361b0;color:#946766!important;padding:8px 13px;transform:rotate(-4deg);margin:24px 0 6px!important}.ending-copy{font:17px/1.85 Georgia,serif!important;color:#5a7066!important;display:block!important}.paper-rule{border-top:1px dashed #7f958561;margin-top:25px!important}
