@media(max-width:430px){.moon-root{padding:0 7px 16px}.top-bar{gap:6px}.brand{gap:7px}.brand-title{max-width:150px;font-size:8px!important;letter-spacing:.7px!important}.brand-sub{font-size:6px!important}.top-tools{gap:5px}.top-button{font-size:8px!important;min-height:34px;padding:6px 7px!important}.top-pause{max-width:36px;padding:5px!important}.room{aspect-ratio:1.13}.worktop{align-items:flex-start;flex-direction:column;padding:15px}.offering-info{width:100%;gap:12px}.offering-actions{width:100%;display:flex!important;gap:18px;justify-content:space-between}.feed-button{flex:1;min-height:53px}.put-back{display:block!important;flex:0 0 auto;font-size:10px!important;min-height:44px}.offering-name{font-size:23px!important}.offering-hint{font-size:10px!important}.offering-preview{width:45px!important;height:56px!important}.offering-copy{flex:1}.aisle-tabs{gap:0;width:100%}.aisle-tab{flex:1;padding:9px 5px!important;font-size:10px!important}.drawer-heading{margin-bottom:5px!important}.product-shelf{gap:5px}.product{min-width:86px!important;flex-basis:86px;max-width:105px}.shelf-footer{flex-direction:column;gap:2px}.restock-link{align-self:flex-end}.policy-big{font-size:9px!important}.policy-sign{font-size:5px!important}.sticky-note{font-size:6px!important}.clock-digits{font-size:14px!important}.order-name{font-size:7px!important}.serve-invite{font-size:5px!important}.order-bubble{min-height:41px}.customer-name{font-size:5px!important}.neon-sign{font-size:5px!important}.welcome-title{font-size:40px!important}.shop-subtitles{font-size:10px!important;padding:10px;min-height:54px}.person-eyes{box-shadow:7px 0 #334553!important}.entry-art{display:none!important}.entry-number{flex-basis:15px}.journal-title{font-size:26px!important}.journal-close{font-size:10px!important}.ending-stamp{font-size:8px!important;letter-spacing:1px!important}}
/* Desktop stock lives on a side shelf: the moon and every item stay in view. */
@media(min-width:1100px){
 .play-layout.playing{display:grid!important;grid-template-columns:minmax(0,1fr) 304px;column-gap:22px;align-items:start}
 .playing>.shop{grid-column:1;grid-row:1}.playing>.counter-layout{display:contents!important}
 .playing .worktop{grid-column:1;grid-row:2;padding:18px;gap:16px}
 .playing .offering-info{gap:12px}.playing .offering-hint{max-width:345px}
 .playing .feed-button{min-width:172px;padding:11px 16px!important;min-height:58px;font-size:16px!important}
 .playing .put-back{display:none!important}
 .playing .shelf-drawer{grid-column:2;grid-row:1/span 3;padding:0;margin:0!important;min-width:0}
 .playing .drawer-heading{display:block!important;margin:0 0 7px!important}.playing .drawer-instruction{display:block!important;font-size:7px!important;letter-spacing:1.3px!important;margin:16px 5px 8px!important}
 .playing .aisle-tabs{gap:3px}.playing .aisle-tab{flex:1;min-width:0;padding:10px 4px!important;font-size:10px!important;white-space:normal!important;height:46px!important;line-height:1.35!important}
 .playing .product-shelf{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px 4px;overflow:visible;padding:9px 3px;background:repeating-linear-gradient(0deg,#1c3041 0 38px,#47616b 39px,#263e4e 45px,transparent 47px 146px)}
 .playing .product{width:100%;min-width:0!important;max-width:none;height:137px!important;min-height:137px!important;padding:5px 4px 8px!important}
 .playing .product-image{width:64px!important;height:80px!important;flex-basis:80px}
 .playing .product-name{font-size:10px!important;white-space:normal!important}.playing .price-ticket{min-height:41px;padding:5px 2px}
 .playing .shelf-footer{align-items:flex-start;flex-direction:column;gap:3px;padding:17px 6px}
 .playing .restock-link{align-self:flex-end;min-height:44px}
 .playing .reaction-caption{grid-column:1;grid-row:3;min-height:85px;padding:16px 19px;gap:15px;margin-top:12px!important}
 .playing .reaction-number{flex-basis:100px;font-size:7px!important}.playing .reaction-body{font-size:11px!important}
 .playing .notice-header{font-size:6px!important;letter-spacing:1px!important}.playing .notice-foot{font-size:5px!important;margin-top:4px!important}
 .playing .policy-sign{font-size:9px!important}.playing .sticky-note{font-size:9px!important}.playing .shelf-sign{font-size:7px!important}
 .playing .till-screen{font-size:24px!important}.playing .till-little{font-size:5px!important}.playing .till-brand{font-size:6px!important}
 .playing .clock-digits{font-size:23px!important}.playing .clock-night{font-size:7px!important}.playing .clock-out{font-size:7px!important}
 .playing .person-eyes{box-shadow:12px 0 #334553!important}.playing .order-name{font-size:10px!important}
 .playing .serve-invite{font-size:6px!important}.playing .receipt-count{font-size:25px!important}.playing .receipt-paper{font-size:5px!important}
 .playing .neon-sign{font-size:8px!important}.playing .fridge-brand{font-size:7px!important}.playing .customer-name{font-size:7px!important}
}
@media(min-width:1100px) and (max-height:950px){.top-bar{height:65px!important;margin-bottom:14px!important}.moon-root{padding-bottom:18px}.bottom-line{margin-top:17px!important}.playing .worktop{padding:13px 18px}.playing .offering-preview{height:53px!important;width:47px!important}.playing .offering-name{font-size:22px!important}}
@media(max-width:760px) and (min-height:650px){.play-layout.playing>.shop{position:sticky;top:0;z-index:45}.play-layout.playing .room{aspect-ratio:1.32}}

/* The host Button's default 40px height and hover animation are not scene physics. */
:where(.moon-root) button{height:auto!important}
.moon-disc,.loose-product,.customer{transition:none!important}
.receipt-roll{transform:rotate(4deg)!important}.delivery-crate{transform:rotate(-3deg)!important}
.moon-root .loose-product.catchable {min-width:44px!important;min-height:44px!important;}

.policy-sign{white-space:normal!important}




/* MOBILE EDITION START */
/* Mobile edition: products before the offering, and accessible shop actions. */
.moon-root {padding-left:max(10px,env(safe-area-inset-left));padding-right:max(10px,env(safe-area-inset-right));padding-bottom:max(16px,env(safe-area-inset-bottom));}
.moon-root .top-button,.moon-root .quiet-button,.moon-root .aisle-tab,.moon-root .restock-link,.moon-root .journal-close {min-height:44px!important;min-width:44px;}
.moon-root .overlay {overscroll-behavior:contain;padding-top:max(16px,env(safe-area-inset-top));padding-bottom:max(16px,env(safe-area-inset-bottom));}
.moon-service {display:none;}
.moon-root .customer,.moon-root .breaker,.moon-root .receipt-roll,.moon-root .delivery-crate {min-width:44px!important;min-height:44px!important;}
@media(max-width:760px) {
 .moon-root .top-bar {height:auto!important;min-height:52px;flex-wrap:nowrap;padding:6px 0;margin-bottom:8px!important;gap:8px;}
 .moon-root .brand-title {font-size:11px!important;max-width:none;letter-spacing:.4px!important;}
 .moon-root .brand-sub {display:none!important;}
 .moon-root .top-tools {margin-left:auto;gap:6px;}
 .moon-root .top-button {font-size:11px!important;min-height:38px!important;padding:6px 10px!important;}
 .moon-root .play-layout.playing>.shop {position:relative;top:auto;z-index:auto;}
 .moon-root .play-layout.playing .room {aspect-ratio:1.58;}
 .moon-root .shop-subtitles {min-height:38px;padding:7px 11px;font-size:12px!important;}
 .moon-root .counter-layout {display:flex;flex-direction:column;}
 .moon-root .shelf-drawer {order:1;padding-top:8px;}
 .moon-root .worktop {order:2;position:relative;top:auto;bottom:auto;z-index:2;background:#152a37;border:1px solid #9eb7aa55;border-radius:8px;padding:10px 12px;margin-top:8px;gap:8px;}
 .moon-root .feed-button {min-height:46px!important;padding:8px 14px!important;font-size:15px!important;}
 .moon-root .reaction-caption {order:3;}
 .moon-root .moon-service {display:flex;order:4;flex-wrap:wrap;gap:8px;margin-top:10px;}
 .moon-root .moon-service .top-button {flex:1 1 140px;white-space:normal!important;}
 .moon-root .aisle-tab {font-size:11px!important;min-height:38px!important;padding:6px 5px!important;white-space:normal!important;}
 .moon-root .product-shelf {display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr));gap:5px;overflow:visible;padding:4px 4px 8px;}
 .moon-root .product {min-width:0!important;max-width:none;width:100%;height:88px!important;min-height:88px!important;padding:3px!important;}
 .moon-root .product-image {width:42px!important;height:48px!important;flex-basis:48px;}
 .moon-root .price-ticket {min-height:32px;padding:3px 2px 2px;}
 .moon-root .product-name {font-size:11px!important;}
 .moon-root .stock-count {font-size:8px!important;margin-top:1px!important;}
 .moon-root .offering-hint,.moon-root .shop-subtitles,.moon-root .reaction-body {font-size:12px!important;}
 .moon-root .offering-name {font-size:19px!important;}
 .moon-root .welcome-title {font-size:clamp(32px,9vw,43px)!important;}
 .moon-root .welcome-copy,.moon-root .welcome-small {font-size:14px!important;}
 .moon-root .welcome-options button {min-height:44px!important;font-size:13px!important;}
 .moon-root .welcome-card {padding:22px 18px;}
 .moon-root .policy-sign,.moon-root .time-clock,.moon-root .breaker,.moon-root .receipt-roll,.moon-root .loose-product {min-width:36px!important;min-height:36px!important;}
 .moon-root .loose-product.catchable {min-width:44px!important;min-height:44px!important;}
 .moon-root .shelf-footer {font-size:11px!important;padding:6px 4px;}
}
@media(max-width:350px) {
 .moon-root .product-shelf {grid-template-columns:repeat(3,minmax(0,1fr));}
 .moon-root .brand-orbit {display:none;}
}
@media(max-height:520px) and (orientation:landscape) {
 .moon-root .play-layout.playing {display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,1fr);gap:12px;align-items:start;}
 .moon-root .playing .shop {position:sticky;top:8px;}
 .moon-root .playing .room {aspect-ratio:1.5;}
 .moon-root .worktop {flex-wrap:wrap;padding:12px;}
 .moon-root .offering-actions {width:100%;}
 .moon-root .product-shelf {flex-wrap:wrap;}
}

/* MOBILE EDITION END */
</style>
<Box className={V.rootClass}><Box className="moon-app">
 <Loop interval={33} running={screen === "play"} @tick={tick} />
 <Box className="top-bar"><Box className="brand"><Box className="brand-orbit" /><Box><Text style={TEXT_STYLE} className="brand-title">PLEASE DO NOT FEED THE MOON</Text><Text style={TEXT_STYLE} className="brand-sub">STARLING / THE NIGHT SHIFT</Text></Box></Box><Box className="top-tools"><Button variant="ghost" className="top-button top-sound" @click={toggleSound}>{settings.muted ? "Sound off" : "Sound on"}</Button><Button variant="ghost" className={V.newReceipt ? "top-button log-button new" : "top-button log-button"} @click={openJournal}>{V.noteLabel}</Button><Button if={screen === "play"} variant="ghost" className="top-button top-pause" @click={pauseGame} ariaLabel="Pause game">Ⅱ</Button></Box></Box>
 <Box className={screen !== "welcome" ? "play-layout playing" : "play-layout"}><Store />
 <Box if={screen !== "welcome"} className="counter-layout"><Counter /></Box></Box>
 <Pages />
 <Box className="bottom-line"><Text style={TEXT_STYLE}>NIGHTSHIFT EDITION / 0.2.2</Text><Text style={TEXT_STYLE} className="bottom-hide">ONE RULE. TWENTY-FOUR BAD IDEAS.</Text><Text style={TEXT_STYLE}>BUILT WITH SOFTN</Text></Box>
</Box></Box>
