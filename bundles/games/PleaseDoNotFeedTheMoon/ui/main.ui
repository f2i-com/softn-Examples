.entry-content{min-width:0}.entry-ingredients{display:block!important;font:9px/1.6 monospace!important;letter-spacing:1px!important;color:#7f8c75!important}.entry-title{display:block!important;font:23px/1.35 Georgia,serif!important;margin:6px 0!important;color:#435e58!important}.entry-body{display:block!important;font:12px/1.8 Arial!important;color:#718173!important}.special .entry-ingredients{color:#9a6b67!important}.special .entry-title{color:#746560!important}.journal-settings{border-top:2px solid #9fad8e55;margin-top:25px!important;padding-top:24px}.settings-row{display:flex!important;gap:8px;flex-wrap:wrap}.paper-button.compact{width:auto;font-size:10px!important;padding:10px 12px!important;min-height:40px}.controls-copy{display:block!important;font:10px/1.9 monospace!important;color:#8a9586!important;margin-top:22px!important}.confirm-new{background:#b8bda033;margin-top:15px!important;padding:15px;font:12px Arial!important;color:#50614f!important}.save-desk{margin-top:20px!important}.backup-text{display:block!important;width:100%!important;min-height:145px;background:#f0eddd!important;border:1px solid #95a58e!important;padding:12px!important;color:#435e50!important;font:10px/1.5 monospace!important;border-radius:3px!important;resize:vertical}
.still .room *,.still .room *:before,.still .room *:after{animation-play-state:paused!important}
.motion-reduced *,.motion-reduced *:before,.motion-reduced *:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}
@media(prefers-reduced-motion:reduce){.moon-root *,.moon-root *:before,.moon-root *:after{animation-duration:0s!important;transition-duration:0s!important}}
