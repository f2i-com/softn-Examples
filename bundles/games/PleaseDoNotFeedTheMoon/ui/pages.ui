<Box if={screen === "welcome"} className="welcome-overlay">
 <Box className="welcome-card"><Text style={TEXT_STYLE} className="eyebrow">A STRANGE LITTLE NIGHT SHIFT</Text><Text style={TEXT_STYLE} className="welcome-title">{"Please do not\nfeed the moon."}</Text><Text style={TEXT_STYLE} className="welcome-tag">{"Minimum wage.\nMaximum lunar consequences."}</Text><Text style={TEXT_STYLE} className="welcome-copy">{"The shop is open. The moon is much too close.\nThere is one rule on the wall."}</Text><Button variant="ghost" className="start-button" @click={beginShift}>{V.hasProgress ? "Continue the night shift ↗" : "Clock in. Behave yourself. ↗"}</Button><Text style={TEXT_STYLE} className="welcome-small">{"Choose a product. Offer it. Watch the window.\nTap customers to serve them. Experiment at your own pace."}</Text><Box className="welcome-options"><Button variant="ghost" className="text-button" @click={toggleSound}>{settings.muted ? "Sound off" : "Sound on"}</Button><Button variant="ghost" className="text-button" @click={toggleMotion}>{settings.reducedMotion ? "Reduced motion" : "Full motion"}</Button></Box><Text style={TEXT_STYLE} className="save-status">{saveStatus}</Text></Box>
</Box>
<Box if={screen === "paused"} className="overlay"><Box className="paper-sheet small-sheet" role="dialog" aria-label="Game paused"><Text style={TEXT_STYLE} className="paper-eyebrow">TEMPORARILY UNATTENDED</Text><Text style={TEXT_STYLE} className="paper-title">Back in a moment.</Text><Text style={TEXT_STYLE} className="paper-copy">The moon can wait. The fridge cannot complain.</Text><Button variant="ghost" className="paper-button primary" @click={resumeGame}>Return to the counter</Button><Button variant="ghost" className="paper-button" @click={openJournal}>Read the employee log</Button><Text style={TEXT_STYLE} className="paper-foot">Simulation and sound are paused.</Text></Box></Box>
<Box if={screen === "report"} className="overlay"><Box className="paper-sheet report-sheet" role="dialog" aria-label="Shift complete"><Text style={TEXT_STYLE} className="paper-eyebrow">STARLING CONVENIENCE / SHIFT RECEIPT</Text><Text style={TEXT_STYLE} className="paper-title">{"Still employed.\nSomehow."}</Text><Text style={TEXT_STYLE} className="paper-copy">{V.night + " — " + V.nightName}</Text><Box className="receipt-totals"><Text style={TEXT_STYLE}>{S.served + " customers served"}</Text><Text style={TEXT_STYLE}>{S.nightFeeds + " unauthorised lunar offerings"}</Text><Text style={TEXT_STYLE}>{S.combos.length + " unusual combinations this run"}</Text></Box><Text style={TEXT_STYLE} className="paper-copy">Fresh stock and an $18 shift float arrive with the next delivery. Your lunar consequences, unfortunately, stay.</Text><Button variant="ghost" className="paper-button primary" @click={takeNextShift}>Take the next shift ↗</Button><Button variant="ghost" className="paper-button" @click={openJournal}>Read the new receipts</Button><Text style={TEXT_STYLE} className="paper-foot">No rush. There is always another night.</Text></Box></Box>
<Box if={screen === "ending"} className="overlay ending-overlay"><Box className="paper-sheet ending-sheet" role="dialog" aria-label="Ending"><Text style={TEXT_STYLE} className="paper-eyebrow">FINAL SHIFT / INCIDENT REPORT</Text><Text style={TEXT_STYLE} className="ending-stamp">{V.ending.stamp}</Text><Text style={TEXT_STYLE} className="paper-title">{V.ending.title}</Text><Text style={TEXT_STYLE} className="ending-copy">{V.ending.text}</Text><Box className="paper-rule" /><Text style={TEXT_STYLE} className="paper-copy">{V.endings + " of 7 endings recorded. The notebook stays with you."}</Text><Button variant="ghost" className="paper-button primary" @click={keepPlaying}>One more experiment. Stay after hours.</Button><Button variant="ghost" className="paper-button" @click={newShift}>A new employee. A different night.</Button><Button variant="ghost" className="paper-button" @click={openJournal}>Read the complete log</Button><Text style={TEXT_STYLE} className="paper-foot">PLEASE DO NOT FEED THE MOON / NIGHTSHIFT EDITION</Text></Box></Box>
<Box if={screen === "journal"} className="overlay journal-overlay"><Box className="journal-sheet" role="dialog" aria-label="Employee discovery notebook">
 <Box className="journal-top"><Box><Text style={TEXT_STYLE} className="paper-eyebrow">STARLING / EMPLOYEE COPY</Text><Text style={TEXT_STYLE} className="journal-title">{"Things we have\nlearned about the moon."}</Text></Box><Button variant="ghost" className="journal-close" @click={closeJournal} ariaLabel="Close notebook">Close ×</Button></Box>
 <Text style={TEXT_STYLE} className="journal-intro">Only what you have actually discovered. The rest is still out there.</Text>
 <Box className="clue-note"><Text style={TEXT_STYLE} className="paper-eyebrow">A NOTE FROM THE PREVIOUS SHIFT</Text><Text style={TEXT_STYLE} className="clue-copy">{V.clue}</Text><Text style={TEXT_STYLE} className="clue-rule">Some reactions remember the last three accepted offerings. Try them close together; order does not matter. The log pauses the clock.</Text><Button variant="ghost" className="clue-button" @click={nextClue}>Turn the note over ↻</Button></Box>
 <Box if={V.notebook.length === 0} className="empty-notebook"><Text style={TEXT_STYLE}>No observations yet.</Text><Text style={TEXT_STYLE} className="paper-copy">Management considers this ideal. Science disagrees.</Text></Box>
 <Box className="journal-entries">
  #each (note in V.notebook)
   <Box className={note.special ? "journal-entry special" : "journal-entry"}><Text style={TEXT_STYLE} className="entry-number">{note.number}</Text><Image loading="eager" if={note.art} className="entry-art" src={asset(note.art)} alt="" width="100%" height="100%" objectFit="contain" /><Box className="entry-content"><Text style={TEXT_STYLE} className="entry-ingredients">{note.special ? "UNEXPECTED COMBINATION / " + note.ingredients : note.ingredients}</Text><Text style={TEXT_STYLE} className="entry-title">{note.title}</Text><Text style={TEXT_STYLE} className="entry-body">{note.text}</Text></Box></Box>
  #end
 </Box>
 <Box className="journal-settings"><Text style={TEXT_STYLE} className="paper-eyebrow">STAFF FACILITIES</Text><Box className="settings-row"><Button variant="ghost" className="paper-button compact" @click={toggleSound}>{settings.muted ? "Sound: off" : "Sound: on"}</Button><Button variant="ghost" className="paper-button compact" @click={toggleMotion}>{settings.reducedMotion ? "Motion: reduced" : "Motion: full"}</Button><Button variant="ghost" className="paper-button compact" @click={backupDesk}>Save desk</Button><Button variant="ghost" className="paper-button compact" @click={requestNew}>New night shift</Button></Box>
 <Box if={confirmNew} className="confirm-new"><Text style={TEXT_STYLE}>Start over? Your discoveries and ending collection will stay.</Text><Button variant="ghost" className="paper-button primary" @click={newShift}>Yes, clock in as someone new</Button><Button variant="ghost" className="paper-button" @click={requestNew}>Keep this shift</Button></Box>
 <Box if={showBackup} className="save-desk"><Text style={TEXT_STYLE} className="paper-copy">Copy this backup before changing app versions or devices. Paste a saved backup here to restore it. Import replaces the current run and its notebook.</Text><TextArea className="backup-text" :bind={saveText} rows={7} placeholder="Paste a lunar save backup here" /><Box className="settings-row"><Button variant="ghost" className="paper-button compact" @click={exportBackup}>Refresh backup text</Button><Button variant="ghost" className="paper-button compact" @click={importBackup}>Import this backup</Button></Box></Box>
 <Text style={TEXT_STYLE} className="paper-foot">{saveStatus}</Text><Text style={TEXT_STYLE} className="controls-copy">Keyboard: ← / → select · 1–3 aisles · Space feed · E serve · Q restock · G ground · J log · P / Esc pause · M sound. Every action also has a touch control.</Text></Box>
 </Box></Box>
