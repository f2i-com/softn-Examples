// Stable numeric IDs 0..11 are retained from the original game for save migration.
// heat, gravity, mass and bond are the original lunar simulation, not new gauges.
let ITEMS = [
 {id:0,name:"Cheese",art:"cheese",aisle:0,price:6,stock:8,heat:-16,gravity:-6,mass:2,bond:9,kind:"cheese",mood:"sleepy",title:"The dairy hypothesis",text:"It purrs through the glass. Craters turn to cheese holes. Somewhere, an astronomer quietly resigns.",hint:"Mature cheddar. Older than your contract."},
 {id:1,name:"Coffee",art:"coffee",aisle:0,price:7,stock:8,heat:8,gravity:3,mass:2,bond:4,kind:"caffeine",mood:"awake",title:"An extremely awake moon",text:"Both eyes open much too far. The constellations vibrate. Nobody within six postcodes is sleeping tonight.",hint:"Double espresso. Night shift strength."},
 {id:2,name:"Sandwich",art:"sandwich",aisle:0,price:8,stock:8,heat:0,gravity:1,mass:3,bond:6,kind:"orbit",mood:"delighted",title:"Low sandwich orbit",text:"It separates the bread from the filling. Your lunch becomes a small, surprisingly stable planetary system.",hint:"Best before the end of the world."},
 {id:3,name:"Hot sauce",art:"sauce",aisle:0,price:9,stock:6,heat:34,gravity:4,mass:2,bond:1,kind:"fire",mood:"angry",title:"Insurance-flavoured",text:"A silent gasp. Solar breath rolls across the windows. The cold drinks have stopped being cold.",hint:"The label says ONE DROP. In capitals."},
 {id:4,name:"Rubber duck",art:"duck",aisle:1,price:5,stock:5,heat:-3,gravity:-12,mass:2,bond:8,kind:"duck",mood:"confused",title:"The sky squeaks back",text:"A duck-shaped crater appears. Every drink in the shop develops its own very small tide.",hint:"Squeaks even when nobody is touching it."},
 {id:5,name:"Milk",art:"milk",aisle:0,price:6,stock:8,heat:-18,gravity:-3,mass:2,bond:6,kind:"milk",mood:"delighted",title:"Literally the Milky Way",text:"A white ring spills around the moon. The refrigerator light flows out across the tiles.",hint:"Full cream. Cosmologically irresponsible."},
 {id:6,name:"Radio",art:"radio",aisle:1,price:15,stock:3,heat:2,gravity:10,mass:5,bond:4,kind:"radio",mood:"listening",title:"98.6 MOON FM",text:"It broadcasts weather reports about your face. The radio has no batteries. It never did.",hint:"Picks up stations that closed in 1978."},
 {id:7,name:"Television",art:"tv",aisle:2,price:22,stock:2,heat:8,gravity:14,mass:8,bond:1,kind:"television",mood:"confused",title:"You are the programme",text:"A rectangular patch of night becomes a live broadcast of this shop. There is one more moon in the broadcast.",hint:"No signal. Probably for the best."},
 {id:8,name:"Vacuum",art:"vacuum",aisle:2,price:26,stock:2,heat:-2,gravity:19,mass:7,bond:1,kind:"vortex",mood:"confused",title:"Cleaning the orbital plane",text:"Dust, receipts and several laws of physics spiral into its mouth. Hold on to the counter.",hint:"For spills, dust and minor singularities."},
 {id:9,name:"Bicycle",art:"bicycle",aisle:2,price:28,stock:2,heat:3,gravity:12,mass:8,bond:5,kind:"bicycle",mood:"delighted",title:"Pedal-powered astronomy",text:"Two rings begin to turn around the moon. The whole shop tips as it tries to learn balance.",hint:"Staff bike. Please return to this dimension."},
 {id:10,name:"Fridge",art:"fridge",aisle:2,price:35,stock:2,heat:-48,gravity:25,mass:24,bond:2,kind:"fridge",mood:"surprised",title:"The coldest big idea",text:"The fridge lifts off its feet. A rectangular polar cap forms on the moon. Everything else starts sliding toward it.",hint:"The entire fridge. Not just its contents."},
 {id:11,name:"Tiny moon",art:"tiny-moon",aisle:2,price:40,stock:2,heat:0,gravity:23,mass:19,bond:-2,kind:"moonlet",mood:"confused",title:"Recursive snacking",text:"A smaller moon opens its own eyes. It is looking at a smaller version of you. Do not think about the next one.",hint:"Found behind the freezer. No barcode."},
 {id:12,name:"Bag of ice",art:"ice",aisle:0,price:4,stock:8,heat:-35,gravity:-4,mass:1,bond:5,kind:"frost",mood:"surprised",title:"Lunar cold snap",text:"Frost grows inward from the window corners. Breath crystallises. A small snowstorm gets trapped above the till.",hint:"Party ice. The party is very far away."},
 {id:13,name:"Hot noodles",art:"noodles",aisle:0,price:8,stock:6,heat:25,gravity:2,mass:3,bond:7,kind:"steam",mood:"delighted",title:"The soup horizon",text:"Steam curls out of the craters. A noodle drapes itself across a constellation. The windows fog from the outside.",hint:"Caution: contents hotter than their pay grade."},
 {id:14,name:"Balloon",art:"balloon",aisle:1,price:3,stock:6,heat:0,gravity:28,mass:-3,bond:6,kind:"float",mood:"surprised",title:"Up has been reassigned",text:"It inhales the balloon. The price tags rise. Your drink climbs out of its cup. The ceiling is now a suggestion.",hint:"Helium. A very convincing argument against down."},
 {id:15,name:"Battery",art:"battery",aisle:1,price:5,stock:6,heat:10,gravity:9,mass:2,bond:2,kind:"electric",mood:"awake",title:"A charge account",text:"Blue current bridges the window frames. Its craters connect like a circuit. The fluorescent light hums in harmony.",hint:"Do not swallow. Definitely not to scale."},
 {id:16,name:"Houseplant",art:"plant",aisle:1,price:9,stock:5,heat:-4,gravity:-2,mass:2,bond:9,kind:"garden",mood:"tender",title:"Something takes root",text:"A tiny forest grows along the moon's edge. One leaf turns toward you instead of the sun.",hint:"Water weekly. Do not expose to lunar conditions."},
 {id:17,name:"Umbrella",art:"umbrella",aisle:1,price:10,stock:4,heat:-8,gravity:6,mass:3,bond:4,kind:"rain",mood:"confused",title:"Indoor weather advisory",text:"It opens the umbrella upside down. Rain falls up the window. A cloud settles politely over the checkout.",hint:"Forecast: localised impossibility."},
 {id:18,name:"Receipt roll",art:"receipt",aisle:2,price:2,stock:5,heat:0,gravity:2,mass:1,bond:4,kind:"paper",mood:"listening",title:"Proof of purchase",text:"An impossible receipt unspools from the sky. The item description reads: ONE VERY LONG NIGHT.",hint:"For returns. Even astronomical ones."},
 {id:19,name:"Staff badge",art:"badge",aisle:2,price:2,stock:4,heat:1,gravity:3,mass:1,bond:8,kind:"employee",mood:"tender",title:"First day on the job",text:"The moon puts on your name badge. It looks at the time clock. It looks at you. Something has occurred to it.",hint:"HELLO, my name is TEMPORARY."},
 {id:20,name:"Salt",art:"salt",aisle:0,price:3,stock:6,heat:0,gravity:-17,mass:-5,bond:2,kind:"salt",mood:"suspicious",title:"Seasoned orbital mechanics",text:"A ring of salt settles around the moon. The floating stock remembers the floor, reluctantly.",hint:"Grounds flavour. Other grounding not guaranteed."},
 {id:21,name:"Pocket mirror",art:"mirror",aisle:1,price:6,stock:4,heat:0,gravity:7,mass:1,bond:5,kind:"mirror",mood:"confused",title:"Who is feeding whom?",text:"The moon sees itself. Its reflection sees you. Your reflection is a fraction of a second late.",hint:"Objects in mirror may be interviewing you."},
 {id:22,name:"Bubble soap",art:"soap",aisle:1,price:4,stock:5,heat:-5,gravity:8,mass:1,bond:7,kind:"bubbles",mood:"delighted",title:"A clean break from reality",text:"Bubbles rise from the craters. Each contains a different night sky. One contains the car park.",hint:"Now with 30% more surface tension."},
 {id:23,name:"Doughnut",art:"donut",aisle:0,price:5,stock:6,heat:2,gravity:3,mass:3,bond:7,kind:"donut",mood:"delighted",title:"The hole truth",text:"A luminous hole opens in the moon. You can see the stars through it. This cannot be nutritionally sound.",hint:"Contains a small, edible absence."}
];
let AISLES = ["Midnight snacks", "Odds & ends", "Not for sale"];
let NIGHT_NAMES = ["One rule", "Local attraction", "The floor is optional", "Strange weather", "After-hours service", "Terms of employment", "Before the sun comes up"];
let NIGHT_NOTES = ["The manual has one rule. It is printed in a very large font.","The milk delivery has started wearing a crash helmet.","Head office would like to know why the shelves are on the ceiling.","Please do not mop any puddle that contains a constellation.","Someone has left a very small moon in the staff cupboard.","The timesheets have acquired a new column: CELESTIAL BODY.","One last night. Decide what kind of neighbour the moon becomes."];
function itemById(id) { return Number.isInteger(id) && id >= 0 && id < ITEMS.length ? ITEMS[id] : null; }
function unlocked(s,id) { let it = itemById(id); return !!it && (it.aisle < 2 || s.totalFeeds >= 3 || s.servedTotal >= 3 || s.stage >= 2 || s.freeplay); }
