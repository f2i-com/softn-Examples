// A feed is a transaction: stock is reserved at launch and resolved on impact.
// Keeping the shot in the save prevents double-consumption or lost discoveries on reload.
function startFeed(s) {
 let it=itemById(s.selected);
 if(!it||!unlocked(s,it.id)||s.shot||s.phase!=="play")return false;
 if(s.stock[it.id]<=0){message(s,"That shelf is empty. The delivery crate has emergency stock.");return false;}
 s.stock[it.id]--;s.offering=false;s.shot={item:it.id,t:0,returning:false,resolved:false};s.actions++;
 return true;
}
function applyItem(s,id) {
 let it=itemById(id);if(!it)return {accepted:false,combo:null};
 s.totalFeeds++;s.nightFeeds++;s.lastItem===id ? s.repeat++ : s.repeat=1;s.lastItem=id;
 s.serial++;
 let reject=(id===15 && s.heat>82)||(s.repeat>=4);
 if(reject){
  s.rejections++;s.stock[id]=Math.min(40,s.stock[id]+1);s.bond=clamp(s.bond-3,0,100);s.gravity=clamp(s.gravity+4,0,100);
  s.mood="angry";s.moodTime=5;s.history=[];
  s.reaction={id:s.serial,kind:"reject",title:"A firm astronomical no.",text:id===15&&s.heat>82 ? "It refuses the battery while it is this hot. The battery comes back smoking. Try cooling things down first." : "Four of the same thing. It spits the item back onto the shelf. Even a moon has limits.",time:8,item:id};
  ensureNote(s,"rejection");return {accepted:false,combo:null};
 }
 s.heat=clamp(s.heat+it.heat,0,100);s.gravity=clamp(s.gravity+it.gravity,0,100);s.mass=clamp(s.mass+it.mass,0,100);s.bond=clamp(s.bond+it.bond,0,100);
 s.mood=it.mood;s.moodTime=7;
 s.reaction={id:s.serial,kind:it.kind,title:it.title,text:it.text,time:9,item:id};
 if(id===0){s.cheese++;s.fx.heart=8;}
 if(id===1)s.energy=36;
 if(id===3){s.fx.steam=20;s.fx.electric=Math.max(s.fx.electric,3);}
 if(id===12||id===10)s.fx.frost=24;
 if(id===13)s.fx.steam=22;
 if(id===14)s.fx.bubbles=Math.max(s.fx.bubbles,8);
 if(id===15)s.fx.electric=22;
 if(id===16)s.flags.garden=true;
 if(id===19)s.flags.employee=true;
 if(id===6)s.broadcast=true;
 let names={2:"orbit",4:"duck",5:"milk",6:"radio",7:"television",8:"vortex",9:"bicycle",10:"fridge",11:"moonlet",17:"rain",18:"paper",21:"mirror",22:"bubbles",23:"donut"};
 if(names[id])s.fx[names[id]]=id===6 ? 40 : 24;
 if(id===20)s.fx.ground=10;
 return {accepted:true,combo:discoverFeed(s,id)};
}
function settleShot(s,dt) {
 if(!s.shot)return null;
 s.shot.t+=dt;
 if(!s.shot.resolved && s.shot.t>=0.85){
  let result=applyItem(s,s.shot.item);s.shot.resolved=true;s.shot.returning=!result.accepted;
  if(result.accepted)s.shot=null;else s.shot.t=0;
  return result;
 }
 if(s.shot && s.shot.resolved && s.shot.t>=0.7)s.shot=null;
 return null;
}
