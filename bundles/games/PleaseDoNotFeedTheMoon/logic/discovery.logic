// Hidden recipes use the last three ACCEPTED feeds, in any order, within 45 active seconds.
// Each ingredient occurrence is counted; a rejected offering breaks the sequence.
let RECIPES = [
 {id:"midnight-fm",ingredients:[1,12,6],title:"Midnight FM",kind:"rave",text:"Iced coffee meets late-night radio. The moon becomes a pirate station. The stars dance; every bottle is a bass speaker.",hint:"The radio's night host always orders something caffeinated. Cold."},
 {id:"moon-garden",ingredients:[16,5,0],title:"The garden on the night side",kind:"garden",text:"Milk, cheese and a living thing. A phosphorescent forest unfolds across the lunar rim. A flower leans toward your window.",hint:"The plant's care label mentions calcium twice."},
 {id:"indoor-weather",ingredients:[14,17,22],title:"Weather, aisle three",kind:"weather",text:"The balloon catches a soap cloud in an umbrella. It rains upward inside the shop. Bubbles carry the products to the ceiling.",hint:"The umbrella smells faintly of soap. Its label says: add lift."},
 {id:"lunar-union",ingredients:[15,6,19],title:"Celestial workers united",kind:"union",text:"A battery, a voice, an employee identity. The moon organises the fluorescent lights. All celestial overtime is now double time.",hint:"A union needs energy, a way to broadcast, and someone on the payroll."},
 {id:"thermal-truce",ingredients:[10,3,12],title:"The impossible thermostat",kind:"truce",text:"A whole fridge, hot sauce and ice reach an agreement. A convection halo spins both ways. The shop exhales and settles.",hint:"The freezer manual recommends balancing something very hot with something very cold."},
 {id:"through-looking-moon",ingredients:[21,11,14],title:"The shop on the other side",kind:"cosmic",text:"A reflection, a moon inside a moon, and permission to rise. Beyond the glass is another shop. You are its moon.",hint:"The mirror reflects something small and round. It appears to need lifting."},
 {id:"tide-service",ingredients:[8,20,17],title:"Emergency tide service",kind:"tides",text:"Salt grounds a vacuum-powered rain cycle. The puddles fold themselves into neat squares. The floor has accepted your apology.",hint:"The mop cupboard lists three essentials: suction, seasoning and weather protection."},
 {id:"lunar-bath",ingredients:[4,22,12],title:"One very large bath",kind:"bath",text:"A duck, bubbles and ice. The moon sinks into a cold bath. Little ducks orbit it like remarkably underqualified satellites.",hint:"A bath is better with a squeaky friend, bubbles, and relief from the heat."},
 {id:"night-shift",ingredients:[2,1,18],title:"A break, at last",kind:"break",text:"Lunch, coffee and a receipt. The moon recognises the ritual. It takes your next customer while you have a moment to breathe.",hint:"The staff room notice lists lunch, caffeine and proof of purchase."}
];
function recipeMatch(history) {
 if(history.length<3)return null;
 let h=history.slice(history.length-3);
 if(h[2].time-h[0].time>45)return null;
 let ids=[h[0].item,h[1].item,h[2].item].sort(function(a,b){return a-b;});
 for(let i=0;i<RECIPES.length;i++){
  let r=RECIPES[i],wanted=r.ingredients.slice().sort(function(a,b){return a-b;});
  if(ids[0]===wanted[0]&&ids[1]===wanted[1]&&ids[2]===wanted[2])return r;
 }
 return null;
}
function applyCombo(s,r) {
 let first=s.combos.indexOf(r.id)<0;
 if(first)s.combos.push(r.id);
 ensureNote(s,"combo:"+r.id);
 s.bond=clamp(s.bond+8,0,100);s.mood="delighted";s.moodTime=11;
 if(r.kind==="rave"){s.fx.rave=30;s.fx.radio=40;s.energy=42;s.gravity=clamp(s.gravity+16,0,100);}
 if(r.kind==="garden"){s.flags.garden=true;s.heat=18;s.bond=clamp(s.bond+14,0,100);s.fx.heart=12;}
 if(r.kind==="weather"){s.fx.weather=40;s.fx.rain=40;s.fx.bubbles=40;s.gravity=clamp(s.gravity+23,0,100);}
 if(r.kind==="union"){s.flags.union=true;s.fx.paper=35;s.fx.electric=20;s.mood="suspicious";}
 if(r.kind==="truce"){s.flags.truce=true;s.heat=18;s.gravity=8;s.mass=Math.max(15,s.mass-12);s.fx.ground=18;}
 if(r.kind==="cosmic"){s.flags.cosmic=true;s.fx.mirror=50;s.fx.moonlet=50;s.gravity=Math.max(65,s.gravity);s.mood="tender";}
 if(r.kind==="tides"){s.flags.tides=true;s.gravity=5;s.heat=18;s.mass=Math.max(15,s.mass-8);s.fx.ground=18;}
 if(r.kind==="bath"){s.fx.bath=38;s.fx.bubbles=38;s.fx.duck=38;s.heat=4;s.gravity=Math.max(0,s.gravity-22);s.mood="sleepy";}
 if(r.kind==="break"){s.flags.employee=true;s.coins+=15;s.health=100;s.fx.paper=18;s.mood="tender";}
 s.serial++;s.reaction={id:s.serial,kind:r.kind,title:r.title,text:r.text,time:13,item:s.lastItem};
 message(s,first ? "The receipt printer is recording something it has never seen before." : "The moon remembers this particular bad idea.");
 return first;
}
function discoverFeed(s,id) {
 ensureNote(s,"item:"+id);
 s.history.push({item:id,time:s.time});if(s.history.length>3)s.history.shift();
 let r=recipeMatch(s.history);if(r)applyCombo(s,r);return r;
}
function syncNotebook() {
 for(let i=0;i<S.discoveries.length;i++)if(profile.notes.indexOf(S.discoveries[i])<0){profile.notes.push(S.discoveries[i]);newDiscovery=true;}
}
function clueFor(s) {
 for(let k=0;k<RECIPES.length;k++){
  let r=RECIPES[(k+s.stage)%RECIPES.length];
  if(s.combos.indexOf(r.id)<0)return r.hint;
 }
 return "The shop has stopped pretending any of this is normal. Try balancing a very large appetite.";
}
