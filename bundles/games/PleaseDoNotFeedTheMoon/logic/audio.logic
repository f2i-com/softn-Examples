// Locally generated WAVs; no network, WebAudio eval, microphone or external music.
function playSound(name,volume) {
 if(settings.muted||!audioReady)return;
 try{softn.audio.play("assets/sfx/"+name+".wav",{volume:volume===undefined?0.32:volume});}catch(err){/* Sound is optional; the visual cue remains. */}
}
function stopAudio() {try{softn.audio.stopAll();}catch(err){}ambientKind="";}
function startAmbience() {
 if(settings.muted||!audioReady||screen!=="play")return;
 let kind=stageOfWorld(S)>=2 ? "strange" : "store";
 if(ambientKind===kind)return;
 stopAudio();ambientKind=kind;
 try{
  softn.audio.play("assets/sfx/hum.wav",{loop:true,volume:0.18});
  softn.audio.play("assets/sfx/road.wav",{loop:true,volume:0.10});
  if(kind==="strange")softn.audio.play("assets/sfx/resonance.wav",{loop:true,volume:0.16});
 }catch(err){ambientKind="";}
}
function soundForImpact(e) {
 if(!e)return;
 if(!e.accepted){playSound("reject");return;}
 if(e.combo){playSound("discovery",0.35);return;}
 let k=S.reaction.kind;
 if(k==="electric")playSound("electric");
 else if(k==="frost"||k==="fridge")playSound("frost");
 else if(k==="float"||k==="vortex"||k==="moonlet")playSound("gravity");
 else if(k==="radio")playSound("radio");
 else if(k==="fire"||k==="steam")playSound("heat");
 else if(k==="duck")playSound("squeak");
 else playSound("delight");
}
