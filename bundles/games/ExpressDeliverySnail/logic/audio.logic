// Short original synthesised WAV assets. Optional audio never blocks gameplay.
function sound(name, volume, minGap) {
    if (settings.muted)
        return;
    let now = Date.now() / 1000;
    let gap = minGap === undefined ? 0.12 : minGap;
    if (soundTimes[name] !== undefined && now - soundTimes[name] < gap)
        return;
    soundTimes[name] = now;
    try {
        let result = softn.audio.play("assets/sfx/" + name + ".wav", { volume: volume === undefined ? 0.35 : volume });
        if (result && typeof result.catch === "function")
            result.catch(function () { });
    }
    catch (err) { }
}
function audioStep(dt) {
    if (!S.started || settings.muted)
        return;
    ambienceClock -= dt;
    if (ambienceClock <= 0) {
        ambienceClock = 3.8;
        sound("ambient-" + LEVELS[S.level].ambience, 0.12, 0);
    }
}
function stopAmbience() { ambienceClock = 0; try {
    softn.audio.stopAll();
}
catch (err) { } }
