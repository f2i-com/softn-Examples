// Bounded, deterministic effects. Decorative randomness never changes collisions or parcels.
function fxRandom(n) { let v = Math.sin((n + 1) * 78.233) * 43758.5453; return v - Math.floor(v); }
function burst(x, y, n, type) {
    if (settings.reducedMotion)
        return;
    for (let i = 0; i < n; i++) {
        fxId++;
        let r = fxRandom(fxId);
        S.fx.push({ id: fxId, x: x, y: y, vx: (r - 0.5) * 160, vy: -35 - fxRandom(fxId + 20) * 145, life: 0.7 + fxRandom(fxId + 43) * 0.6, max: 1.3, size: type === "confetti" ? 7 : 3 + r * 5, type: type });
    }
    if (S.fx.length > 70)
        S.fx = S.fx.slice(S.fx.length - 70);
}
function effectsStep(dt) {
    S.landAnim = Math.max(0, S.landAnim - dt);
    S.jumpAnim = Math.max(0, S.jumpAnim - dt);
    S.hitAnim = Math.max(0, S.hitAnim - dt);
    S.nearAnim = Math.max(0, S.nearAnim - dt);
    S.toastTime = Math.max(0, S.toastTime - dt);
    S.trailClock += dt;
    S.dustClock += dt;
    if (S.p.grounded && Math.abs(S.p.vx) > 12 && S.trailClock > 0.11) {
        S.trailClock = 0;
        fxId++;
        S.slime.push({ id: fxId, x: S.p.x - 22 * S.p.facing, y: S.p.y + 22, life: 5.5, w: 18 + Math.abs(S.p.vx) * 0.035 });
        if (S.slime.length > 65)
            S.slime.shift();
        sound("slime", 0.06, 0.32);
    }
    if (S.dustClock > 0.085) {
        S.dustClock = 0;
        if (S.boosting > 0)
            burst(S.p.x - 36 * S.p.facing, S.p.y + 7, 2, "spark");
        else if (S.p.grounded && Math.abs(S.p.vx) > 90 && (isBracing() || S.p.vx * S.p.facing < 0))
            burst(S.p.x - 22 * S.p.facing, S.p.y + 20, 2, "dust");
    }
    let alive = [];
    for (let i = 0; i < S.fx.length; i++) {
        let p = S.fx[i];
        p.life -= dt;
        if (p.life > 0) {
            p.x += p.vx * dt;
            p.y += p.vy * dt;
            p.vy += dt * 240;
            alive.push(p);
        }
    }
    S.fx = alive;
    let wet = [];
    for (let j = 0; j < S.slime.length; j++) {
        let t = S.slime[j];
        t.life -= dt;
        if (t.life > 0)
            wet.push(t);
    }
    S.slime = wet;
}
