// Retains the original swept downward floor crossing, adding nearest-surface selection
// and walkable obstacle tops. At 120 Hz even the 440 px/s boost moves <4 px per step.
function snailGroundAt(x) {
    for (let i = 0; i < S.pits.length; i++) {
        let pit = S.pits[i];
        if (x > pit.x && x < pit.x + pit.w)
            return false;
    }
    return true;
}
function sweepFloor(p, oldBottom) {
    let floor = 100000;
    let soft = false;
    if (p.vy < 0)
        return { landed: false, speed: 0, soft: false };
    let bottom = p.y + p.h / 2;
    if (snailGroundAt(p.x) && oldBottom <= 475 + 4 && bottom >= 475)
        floor = 475;
    for (let i = 0; i < S.platforms.length; i++) {
        let s = S.platforms[i];
        if (p.x + p.w * 0.35 > s.x - s.w / 2 && p.x - p.w * 0.35 < s.x + s.w / 2 && oldBottom <= s.y + 3 && bottom >= s.y && s.y < floor) {
            floor = s.y;
            soft = s.art === "leaf";
        }
    }
    for (let j = 0; j < S.rocks.length; j++) {
        let r = S.rocks[j];
        let top = r.y - r.h / 2;
        if (p.x + p.w * 0.35 > r.x - r.w / 2 && p.x - p.w * 0.35 < r.x + r.w / 2 && oldBottom <= top + 2 && bottom >= top && top < floor) {
            floor = top;
            soft = false;
        }
    }
    if (floor === 100000)
        return { landed: false, speed: 0, soft: false };
    let speed = p.vy;
    p.y = floor - p.h / 2;
    p.vy = 0;
    p.grounded = true;
    return { landed: true, speed: speed, soft: soft };
}
function collideSides(p, oldX) {
    for (let i = 0; i < S.rocks.length; i++) {
        let r = S.rocks[i];
        let top = r.y - r.h / 2;
        if (p.y + p.h / 2 <= top + 3)
            continue;
        if (overlap(p, r, 4)) {
            let impact = Math.abs(p.vx);
            p.x = oldX < r.x ? r.x - r.w / 2 - p.w / 2 + 3 : r.x + r.w / 2 + p.w / 2 - 3;
            p.vx = -p.vx * 0.2;
            if (S.hitCooldown <= 0 && impact > 90) {
                parcelImpact(0, impact, "bump");
                S.hitCooldown = 0.7;
                S.hitAnim = 0.32;
                burst(p.x, p.y + 15, 8, "dust");
            }
        }
    }
}
function checkNearMiss() {
    if (S.p.grounded || S.p.vy < 0)
        return;
    for (let i = 0; i < S.rocks.length; i++) {
        let r = S.rocks[i];
        let clearance = r.y - r.h / 2 - (S.p.y + S.p.h / 2);
        if (Math.abs(S.p.x - r.x) < r.w / 2 + 16 && clearance > 0 && clearance < 13) {
            S.nearAnim = 0.3;
            return;
        }
    }
}
