// Parcel state is independent from player locomotion. Unit tests exercise each rule directly.
function newParcel(id) {
    return { id: id, integrity: 100, temperature: 100, toppings: 100, frozen: 100, vitality: 65,
        countdown: 20, alarmed: false, alarm: 0, strap: 100, loose: false, lostX: 0, lostY: 0, lostAge: 0, catches: 0 };
}
function parcelModifiers() {
    let q = S.parcel;
    return { accel: q.id === "letter" ? 1.16 : (q.id === "glass" ? 0.96 : 1),
        gravity: q.id === "balloon" ? (isBracing() ? 0.95 : 0.57) : 1,
        jump: q.id === "balloon" ? 0.94 : 1, wind: q.id === "balloon" ? 2.2 : (q.id === "letter" ? 1.6 : 1) };
}
function parcelCondition(q) {
    if (q.id === "pizza")
        return clamp(q.integrity * 0.15 + q.temperature * 0.45 + q.toppings * 0.4, 0, 100);
    if (q.id === "icecream")
        return clamp(q.frozen * 0.8 + q.integrity * 0.2, 0, 100);
    if (q.id === "plant")
        return clamp(q.vitality * 0.75 + q.integrity * 0.25, 0, 100);
    return q.integrity;
}
function parcelStep(dt, env) {
    let q = S.parcel;
    let easier = settings.gentle ? 0.65 : 1;
    if (q.id === "pizza")
        q.temperature = clamp(q.temperature - dt * (env.wet ? 3.6 : 2.3) * easier, 0, 100);
    if (q.id === "icecream")
        q.frozen = clamp(q.frozen - dt * (env.heat ? 8.5 : 0.85) * easier, 0, 100);
    if (q.id === "plant")
        q.vitality = clamp(q.vitality + dt * (env.sun ? 12 : -1.1 * easier), 0, 100);
    if (q.id === "ticking") {
        q.countdown = Math.max(0, q.countdown - dt * easier);
        q.alarm = Math.max(0, q.alarm - dt);
        if (q.countdown < 12 && !q.alarmed)
            sound("tick", 0.26, q.countdown < 5 ? 0.22 : 0.55);
        if (q.countdown <= 0 && !q.alarmed) {
            q.alarmed = true;
            q.alarm = 2.4;
            q.integrity = Math.max(20, q.integrity - 25);
            burst(S.p.x, S.p.y - 55, 30, "confetti");
            notify("SURPRISE! It was the party alarm. You are now the entertainment.", 4);
            sound("party", 0.45);
        }
    }
    if (q.id === "letter") {
        if (!q.loose) {
            let stress = (Math.abs(env.wind) > 30 ? 34 : 0) + (!S.p.grounded && Math.abs(S.p.vx) > 325 ? 18 : 0);
            if (isBracing())
                q.strap = clamp(q.strap + dt * 45, 0, 100);
            else
                q.strap = clamp(q.strap + dt * (stress > 0 ? -stress * easier : 10), 0, 100);
            if (q.strap <= 0) {
                q.loose = true;
                q.lostX = S.p.x + S.p.facing * 68;
                q.lostY = S.p.y - 85;
                q.lostAge = 0;
                q.integrity = Math.max(20, q.integrity - 8);
                notify("Your letter has resigned! Catch it, or press R for courier rescue.", 4);
                sound("paper", 0.5);
            }
        }
        else {
            q.lostAge += dt;
            let wind = env.wind === 0 ? -12 : env.wind;
            q.lostX = clamp(q.lostX + wind * dt * 0.6, 30, S.world - 140);
            q.lostY = Math.min(442, q.lostY + dt * 52);
            if (q.lostAge > 0.45 && Math.abs(S.p.x - q.lostX) < 62 && Math.abs(S.p.y - 35 - q.lostY) < 90) {
                q.loose = false;
                q.strap = 85;
                q.catches++;
                notify("Correspondence recaptured. Extremely professional.", 2.5);
                sound("checkpoint", 0.32);
                burst(S.p.x, S.p.y - 40, 8, "spark");
            }
        }
    }
}
function parcelImpact(vertical, horizontal, kind) {
    if (S.hitCooldown > 0 && kind !== "land")
        return;
    let q = S.parcel;
    let brace = isBracing();
    let safe = q.id === "glass" ? 315 : 410;
    if (brace)
        safe += 165;
    let force = kind === "land" ? Math.max(0, vertical - safe) : Math.max(0, horizontal - 85);
    if (force <= 0)
        return;
    let damage = force / (q.id === "glass" ? 10 : 24);
    if (brace)
        damage *= 0.35;
    if (settings.gentle)
        damage *= 0.5;
    damage = Math.min(28, damage);
    q.integrity = clamp(q.integrity - damage, 0, 100);
    if (q.id === "pizza")
        q.toppings = clamp(q.toppings - damage * 2.2, 0, 100);
    if (q.id === "plant")
        q.vitality = clamp(q.vitality - damage * 1.1, 0, 100);
    S.hitAnim = Math.max(S.hitAnim, 0.22);
    sound(q.id === "glass" ? "rattle" : "shell", 0.3, 0.16);
    if (damage > 3) {
        burst(S.p.x, S.p.y - 38, 5, q.id === "pizza" ? "topping" : "dust");
        notify(q.id === "glass" ? "Little cracks. Hold CARE before the next landing." : (q.id === "pizza" ? "The toppings have changed postcode." : "Special handling. Slightly more special next time."), 2.3);
    }
}
function parcelReadoutText() {
    let q = S.parcel;
    if (q.id === "pizza")
        return Math.ceil(q.temperature) + "° warm · " + Math.ceil(q.toppings) + "% toppings";
    if (q.id === "glass")
        return Math.ceil(q.integrity) + "% intact · " + (isBracing() ? "CUSHIONING" : "handle with care");
    if (q.id === "icecream")
        return Math.ceil(q.frozen) + "% frozen · " + (S.env.heat ? "TOASTER HEAT!" : "nice and cool");
    if (q.id === "balloon")
        return isBracing() ? "Coming down gently" : "Floaty air mail · CARE to descend";
    if (q.id === "plant")
        return Math.ceil(q.vitality) + "% happy · " + (S.env.sun ? "sunbathing ♥" : "find a sunbeam");
    if (q.id === "ticking")
        return q.alarmed ? "Party alarm delivered. Surprise slightly used." : "Tick. Tock. " + Math.ceil(q.countdown) + " seconds.";
    return q.loose ? "LETTER LOOSE! Catch it or press R." : Math.ceil(q.strap) + "% grip · CARE in the breeze";
}
function parcelArtPath() {
    let q = S.parcel;
    let worn = q.id === "pizza" ? (q.temperature < 45 || q.toppings < 85) : (q.id === "glass" ? q.integrity < 88 : (q.id === "icecream" ? q.frozen < 60 : (q.id === "plant" ? q.vitality < 45 : (q.id === "ticking" ? q.alarmed : (q.id === "letter" ? q.integrity < 92 : q.integrity < 65)))));
    return "assets/parcels/" + q.id + (worn ? "-worn" : "") + ".svg";
}
