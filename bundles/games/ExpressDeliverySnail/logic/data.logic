function clamp(n, lo, hi) { return Math.max(lo, Math.min(hi, n)); }
function copy(v) { return JSON.parse(JSON.stringify(v)); }
function finite(n) { return typeof n === "number" && Number.isFinite(n); }
function distance(a, b) { let dx = a.x - b.x; let dy = a.y - b.y; return Math.sqrt(dx * dx + dy * dy); }
function overlap(a, b, padding) { let p = padding || 0; return a.x - a.w / 2 < b.x + b.w / 2 - p && a.x + a.w / 2 > b.x - b.w / 2 + p && a.y - a.h / 2 < b.y + b.h / 2 - p && a.y + a.h / 2 > b.y - b.h / 2 + p; }
function held(a, b) { return !!keys[a] || (!!b && !!keys[b]); }
function isBracing() { return held("q", "ArrowDown") || held("s"); }
function clock(t) { let n = Math.max(0, t); let s = Math.floor(n) % 60; return Math.floor(n / 60) + ":" + (s < 10 ? "0" : "") + s + "." + Math.floor(n * 10) % 10; }
function notify(text, time) { S.toast = text; S.toastTime = time || 3.2; }
