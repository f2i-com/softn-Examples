// One input path for keyboard and multitouch. Releases are processed even while paused.
function normalKey(k) { return k && k.length === 1 ? k.toLowerCase() : String(k || ""); }
function clearInput() { keys = {}; commands = []; snailJumpBuffer = 0; }
function pushInput(k) {
    if (S.phase !== "play" || S.rescueTimer > 0)
        return;
    if (!S.started) {
        S.started = true;
        lastClock = Date.now();
        accumulator = 0;
    }
    if (!keys[k])
        commands.push(k);
    keys[k] = true;
    if (commands.length > 16)
        commands.shift();
}
function padDown(k) { pushInput(k); publish(); }
function padUp(k) { keys[k] = false; if (k === " " || k === "ArrowUp" || k === "w")
    commands.push("releaseJump"); }
function touchCancel() { clearInput(); }
function keyDown(e) {
    let tag = String(e.targetTag || (e.target && e.target.tagName) || "").toLowerCase();
    if (tag === "input" || tag === "textarea" || tag === "select")
        return;
    let k = normalKey(e.key);
    if ((k === " " || k === "Enter") && tag === "button" && S.phase !== "play")
        return;
    if (k === "Tab")
        return;
    if (k === "Escape" || k === "p") {
        if (!e.repeat)
            pauseGame();
        return;
    }
    if (k === "m") {
        if (!e.repeat)
            toggleSound();
        return;
    }
    if (S.phase === "dispatch" && k === "Enter") {
        startDelivery();
        return;
    }
    if (S.phase === "report" && k === "Enter") {
        nextDelivery();
        return;
    }
    if (S.phase !== "play")
        return;
    if (["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", "a", "d", "s", "w", " ", "e", "q", "r"].indexOf(k) < 0)
        return;
    if (e.preventDefault)
        e.preventDefault();
    if (!e.repeat)
        pushInput(k);
}
function keyUp(e) { padUp(normalKey(e.key)); }
function loseFocus() { clearInput(); if (S && S.phase === "play") {
    S.phase = "paused";
    stopAmbience();
    persist();
    publish();
} }
function installInput() {
    if (inputInstalled)
        return;
    window.addEventListener("keydown", keyDown);
    window.addEventListener("keyup", keyUp);
    window.addEventListener("blur", loseFocus);
    try {
        softn.input.captureKeys(["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", " ", "a", "d", "w", "s", "q", "e", "r"]);
    }
    catch (err) { }
    inputInstalled = true;
}
function removeInput() {
    if (!inputInstalled)
        return;
    try {
        softn.input.captureKeys([]);
    }
    catch (err) { }
    window.removeEventListener("keydown", keyDown);
    window.removeEventListener("keyup", keyUp);
    window.removeEventListener("blur", loseFocus);
    inputInstalled = false;
}
function processCommands() {
    let pending = commands;
    commands = [];
    for (let i = 0; i < pending.length; i++) {
        let k = pending[i];
        if (k === " " || k === "w" || k === "ArrowUp")
            snailJump();
        if (k === "releaseJump")
            jumpRelease();
        if (k === "e")
            snailBoost();
        if (k === "r")
            requestRescue(true);
    }
}
