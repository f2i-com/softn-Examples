// Delivery progression, collectibles and quick checkpoint recovery. No lives or forced retries.
function gameFresh(index) { hasResume = false; S = { phase: "dispatch" }; loadLevel(index || 0); S.phase = "dispatch"; }
function collectAndCheckpoint() {
    let kept = [];
    for (let i = 0; i < S.stamps.length; i++) {
        let st = S.stamps[i];
        if (distance(S.p, st) < 44) {
            S.collected.push(st.id);
            S.stampCount++;
            S.boost = Math.min(100, S.boost + 9);
            burst(st.x, st.y, 7, "spark");
            sound("stamp", 0.32, 0.07);
        }
        else
            kept.push(st);
    }
    S.stamps = kept;
    for (let j = S.checkpointIndex + 1; j < S.checkpoints.length; j++) {
        if (S.p.x >= S.checkpoints[j] && S.p.grounded && S.p.y >= 440) {
            S.checkpointIndex = j;
            S.checkpoint = { x: S.checkpoints[j], y: 453, parcel: copy(S.parcel) };
            S.boost = Math.min(100, S.boost + 16);
            notify("Rest stop saved. Your tiny union insisted.", 2.5);
            sound("checkpoint", 0.43);
            burst(S.p.x, S.p.y - 30, 12, "spark");
            persist();
        }
    }
    if (S.p.x >= S.world - 125 && S.p.grounded && S.p.y > 395) {
        if (S.parcel.loose) {
            if (S.toastTime <= 0)
                notify("The address is correct. The letter is elsewhere. R calls rescue.", 3);
        }
        else {
            S.phase = "delivery";
            S.deliveryAnim = 1.3;
            keys = {};
            commands = [];
            stopAmbience();
            sound("bell", 0.65);
            burst(S.p.x, S.p.y - 40, 25, "confetti");
        }
    }
}
function requestRescue(manual) {
    if (S.phase !== "play" || S.rescueTimer > 0)
        return;
    S.rescueTimer = 0.55;
    S.rescues++;
    S.hitAnim = 0.4;
    keys = {};
    commands = [];
    notify(manual ? "Courier rescue! Both snail and parcel are covered." : "A scenic detour. Back to the last rest stop!", 2.8);
    sound("rescue", 0.4);
    burst(S.p.x, Math.min(S.p.y, 520), 12, "water");
}
function completeRescue() {
    S.p.x = S.checkpoint.x;
    S.p.y = S.checkpoint.y;
    S.p.vx = 0;
    S.p.vy = 0;
    S.p.grounded = true;
    S.parcel.loose = false;
    S.parcel.strap = Math.max(70, S.parcel.strap);
    // A recovery never creates a zero-condition softlock. Spoilage/time are not rewound.
    S.parcel.integrity = Math.max(25, S.parcel.integrity - 3);
    S.boost = Math.max(35, S.boost);
    S.boosting = 0;
    S.hitCooldown = 1.2;
    S.time += 2;
    S.landAnim = 0.3;
    S.camera = clamp(S.p.x - viewWidth * 0.3, 0, S.world - viewWidth);
    snailCoyote = 0;
    snailJumpBuffer = 0;
    accumulator = 0;
    burst(S.p.x, S.p.y, 10, "spark");
}
function deliveryGrade(time, par, condition) {
    let name = "Parcel now considered archaeology";
    if (time <= par * 0.78)
        name = "Blazing fast, somehow";
    else if (time <= par)
        name = "Technically on time";
    else if (time <= par * 1.75)
        name = "Recipient no longer remembers ordering";
    let stars = 1 + (time <= par ? 1 : 0) + (condition >= 80 ? 1 : 0);
    return { name: name, stars: stars, time: time, condition: condition };
}
function finishDelivery() {
    S.won = true;
    S.phase = "report";
    let q = parcelCondition(S.parcel);
    let grade = deliveryGrade(S.time, S.par, q);
    gradeTitle = grade.name;
    gradeStars = grade.stars === 3 ? "★ ★ ★" : (grade.stars === 2 ? "★ ★ ☆" : "★ ☆ ☆");
    gradeBody = "Signed for by " + LEVELS[S.level].recipient + ".\n" + clock(S.time) + " · " + Math.round(q) + "% condition · " + S.stampCount + " stamps · " + S.rescues + " rescues.";
    let old = profile.best[S.level];
    if (!old || grade.stars > old.stars || (grade.stars === old.stars && S.time < old.time))
        profile.best[S.level] = { time: S.time, condition: q, stars: grade.stars };
    profile.stamps += S.stampCount;
    profile.completed = 0;
    for (let i = 0; i < 7; i++)
        if (profile.best[i])
            profile.completed++;
    persist();
    publish();
}
function startDelivery() { S.phase = "play"; S.started = false; clearInput(); lastClock = Date.now(); accumulator = 0; confirmRestart = false; publish(); sound("shell", 0.3); }
function nextDelivery() {
    if (S.level === 6) {
        S.phase = "ending";
        persist();
        publish();
        return;
    }
    gameFresh(S.level + 1);
    persist();
    publish();
}
function selectRoute(index) { if (!Number.isInteger(index) || index < 0 || index >= LEVELS.length)
    return; stopAmbience(); gameFresh(index); persist(); publish(); }
function openRoutes() { if (S.phase !== "routes")
    pauseFrom = S.phase; S.phase = "routes"; clearInput(); stopAmbience(); publish(); }
function closeRoutes() { S.phase = pauseFrom; lastClock = Date.now(); accumulator = 0; publish(); }
function pauseGame() {
    if (S.phase === "play") {
        S.phase = "paused";
        clearInput();
        stopAmbience();
        persist();
    }
    else if (S.phase === "paused") {
        S.phase = "play";
        lastClock = Date.now();
        accumulator = 0;
    }
    publish();
}
function restartRoute() { gameFresh(S.level); startDelivery(); persist(); }
function askRestart() { confirmRestart = !confirmRestart; publish(); }
function toggleSound() { settings.muted = !settings.muted; if (settings.muted)
    stopAmbience();
else
    sound("stamp", 0.35); persist(); publish(); }
function toggleGentle() { settings.gentle = !settings.gentle; persist(); publish(); }
function toggleMotion() { settings.reducedMotion = !settings.reducedMotion; if (settings.reducedMotion) {
    S.fx = [];
    S.cameraY = 0;
} persist(); publish(); }
function rescueFromMenu() { if (S.phase !== "paused")
    return; S.phase = "play"; S.started = true; lastClock = Date.now(); accumulator = 0; requestRescue(true); publish(); }
function startMobileDelivery() { viewWidth = 400; S.camera = clamp(S.p.x - viewWidth * .3, 0, S.world - viewWidth); startDelivery(); }
