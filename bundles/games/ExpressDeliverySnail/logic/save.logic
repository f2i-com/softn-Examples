// Store only a small explicit checkpoint record, never rendered actors or executable state.
let SAVE_KEY = "oddjobs:snail:v2";
function validatedParcel(v, id) {
    let p = newParcel(id);
    if (!v || typeof v !== "object")
        return p;
    let fields = ["integrity", "temperature", "toppings", "frozen", "vitality", "strap"];
    for (let i = 0; i < fields.length; i++) {
        let k = fields[i];
        if (finite(v[k]))
            p[k] = clamp(v[k], 0, 100);
    }
    if (finite(v.countdown))
        p.countdown = clamp(v.countdown, 0, 60);
    p.alarmed = v.alarmed === true;
    p.loose = false;
    return p;
}
function validateSave(d) {
    if (!d || d.schema !== 2 || !Number.isInteger(d.level) || d.level < 0 || d.level > 6)
        return false;
    if (!Number.isInteger(d.checkpoint) || d.checkpoint < -1 || d.checkpoint > 3)
        return false;
    if (!finite(d.time) || d.time < 0 || d.time > 86400)
        return false;
    if (!Array.isArray(d.collected) || d.collected.length > 80 || !Array.isArray(d.best) || d.best.length > 7)
        return false;
    for (let i = 0; i < d.best.length; i++) {
        let b = d.best[i];
        if (b !== null && (!b || !finite(b.time) || b.time < 0 || b.time > 86400 || !finite(b.condition) || b.condition < 0 || b.condition > 100 || !Number.isInteger(b.stars) || b.stars < 1 || b.stars > 3))
            return false;
    }
    return true;
}
function persist() {
    if (!S)
        return;
    let record = { schema: 2, level: S.level, checkpoint: S.checkpointIndex, time: Math.min(86400, S.time), parcel: S.parcel,
        collected: S.collected, best: profile.best, stamps: profile.stamps, boosts: profile.boosts, rescues: S.rescues, settings: settings, finished: S.won };
    try {
        localStorage.setItem(SAVE_KEY, JSON.stringify(record));
        saveStatus = "Saved at the last rest stop";
    }
    catch (err) {
        saveStatus = "Storage unavailable · this run still works";
    }
}
function restore() {
    try {
        let raw = localStorage.getItem(SAVE_KEY);
        if (!raw) {
            // Keep the old save untouched. The route rules changed, so old positions cannot safely migrate.
            if (localStorage.getItem("oddjobs:snail:v1"))
                saveStatus = "Your original campaign is preserved; these are new routes.";
            return false;
        }
        if (raw.length > 40000)
            throw new Error("Oversize save");
        let d = JSON.parse(raw);
        if (!validateSave(d))
            throw new Error("Invalid save");
        settings = { muted: !!(d.settings && d.settings.muted === true), gentle: !!(d.settings && d.settings.gentle === true), reducedMotion: !!(d.settings && d.settings.reducedMotion === true) };
        profile.best = d.best;
        profile.stamps = finite(d.stamps) ? clamp(d.stamps, 0, 1000000) : 0;
        profile.boosts = finite(d.boosts) ? clamp(d.boosts, 0, 1000000) : 0;
        profile.completed = 0;
        for (let i = 0; i < 7; i++)
            if (profile.best[i])
                profile.completed++;
        gameFresh(d.finished ? Math.min(6, d.level + 1) : d.level);
        if (!d.finished) {
            if (d.checkpoint >= S.checkpoints.length)
                throw new Error("Missing checkpoint");
            S.checkpointIndex = d.checkpoint;
            S.checkpoint.x = d.checkpoint < 0 ? 100 : S.checkpoints[d.checkpoint];
            S.p.x = S.checkpoint.x;
            S.parcel = validatedParcel(d.parcel, S.parcel.id);
            S.checkpoint.parcel = copy(S.parcel);
            S.time = d.time;
            S.rescues = finite(d.rescues) ? Math.floor(clamp(d.rescues, 0, 10000)) : 0;
            let keep = [];
            for (let j = 0; j < S.stamps.length; j++) {
                if (d.collected.indexOf(S.stamps[j].id) >= 0)
                    S.collected.push(S.stamps[j].id);
                else
                    keep.push(S.stamps[j]);
            }
            S.stamps = keep;
            S.stampCount = S.collected.length;
            S.camera = clamp(S.p.x - viewWidth * 0.3, 0, S.world - viewWidth);
            for (let k = 0; k < S.events.length; k++)
                if (S.events[k].trigger < S.p.x - 250) {
                    S.events[k].done = true;
                    S.events[k].t = S.events[k].duration;
                }
        }
        hasResume = !d.finished;
        saveStatus = "Rest stop restored · clock waits for your first move";
        return true;
    }
    catch (err) {
        saveStatus = "Damaged save ignored safely";
        return false;
    }
}
