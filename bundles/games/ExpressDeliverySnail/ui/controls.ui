<Box className="sn-dock">
 <Box className="sn-dispatch-note"><Image loading="eager" className="sn-parcel-thumb" src={asset(postcardArt)} objectFit="contain" alt="Current parcel" /><Box><Text className="sn-note-title">{parcelTitle}</Text><Text className="sn-note-sub">{supportText}</Text></Box></Box>
 <Box className="sn-pad">
  <Box className="sn-arrows">
   <Button variant="ghost" className="sn-btn sn-control" disabled={phase !== "play"} ariaLabel="Slide left. A or left arrow." @pointerdown={padDown("ArrowLeft")} @pointerup={padUp("ArrowLeft")} @pointerleave={padUp("ArrowLeft")} @pointercancel={touchCancel}><Text className="sn-control-arrow">←</Text><Text className="sn-control-key">A</Text></Button>
   <Button variant="ghost" className="sn-btn sn-control" disabled={phase !== "play"} ariaLabel="Slide right. D or right arrow." @pointerdown={padDown("ArrowRight")} @pointerup={padUp("ArrowRight")} @pointerleave={padUp("ArrowRight")} @pointercancel={touchCancel}><Text className="sn-control-arrow">→</Text><Text className="sn-control-key">D</Text></Button>
  </Box>
  <Button variant="ghost" className="sn-btn sn-control" disabled={phase !== "play"} ariaLabel="Brake and care for parcel. Hold Q." @pointerdown={padDown("q")} @pointerup={padUp("q")} @pointerleave={padUp("q")} @pointercancel={touchCancel}><Text className="sn-control-glyph">♡</Text><Text className="sn-control-label">CARE</Text><Text className="sn-control-key">Q</Text></Button>
  <Button variant="ghost" className="sn-btn sn-control sn-boost-button" disabled={phase !== "play"} ariaLabel="Shell boost. E." @pointerdown={padDown("e")} @pointerup={padUp("e")} @pointerleave={padUp("e")} @pointercancel={touchCancel}><Text className="sn-control-glyph">»</Text><Text className="sn-control-label">BOOST</Text><Text className="sn-control-key">E</Text></Button>
  <Button variant="ghost" className="sn-btn sn-control sn-jump-button" disabled={phase !== "play"} ariaLabel="Hop. Tap for a low hop; hold for a full jump. Space." @pointerdown={padDown(" ")} @pointerup={padUp(" ")} @pointerleave={padUp(" ")} @pointercancel={touchCancel}><Text className="sn-control-glyph">↗</Text><Text className="sn-control-label">HOP</Text><Text className="sn-control-key">SPACE</Text></Button>
 </Box>
</Box>
