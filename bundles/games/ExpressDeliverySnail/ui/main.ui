<logic src="../logic/main.logic" />
<import World from="./world.ui" />
<import Controls from="./controls.ui" />
<import Screens from="./screens.ui" />
<style>
.sn-root { --ink:#364c45; --muted:#7e826b; --paper:#f8f2dc; --accent:#b76a42; --sky:#e6edce; --ratio:1.785714; position:relative; width:100%; height:100%; max-height:100%; min-height:0; overflow:hidden; display:flex; flex-direction:column; background:#eee9d8; color:var(--ink)!important; font-family:"Trebuchet MS",Arial,sans-serif; padding:0 20px 12px; box-sizing:border-box; font-size:14px!important; line-height:1.4!important; }
.sn-root *, .sn-root *::before, .sn-root *::after {box-sizing:border-box;}
.sn-root p,.sn-root span {margin:0;}
.sn-header {display:flex; align-items:center; justify-content:space-between; gap:16px; height:70px; flex:0 0 70px;}
.sn-brand {display:flex;align-items:center;gap:10px;}
.sn-icon {width:40px!important;height:40px!important;}
.sn-brand-name {display:block;font-family:Georgia,serif;font-size:22px!important;font-weight:700!important;color:var(--ink)!important;letter-spacing:-.7px;line-height:1.1!important;}
.sn-kicker {display:block;color:var(--muted)!important;font-size:10px!important;letter-spacing:2px;line-height:1.4!important;font-weight:bold!important;text-transform:uppercase;}
.sn-tools {display:flex;align-items:center;gap:6px;}
.sn-btn {display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:7px;min-height:40px;height:auto!important;padding:8px 14px!important;border:1px solid #c7c4ac!important;background:#f7f2df!important;color:var(--ink)!important;border-radius:11px!important;font-family:inherit!important;font-size:12px!important;line-height:1.3!important;font-weight:bold!important;box-shadow:0 2px 0 #d5d0b9!important;cursor:pointer;white-space:normal!important;touch-action:none;user-select:none;-webkit-user-select:none;}
.sn-btn:hover {background:#fffae6!important;}
.sn-btn:active {transform:translateY(2px);box-shadow:none!important;}
.sn-btn:disabled {opacity:.5;cursor:default;}
.sn-btn:focus-visible {outline:3px solid #af7548;outline-offset:3px;}
.sn-tool {min-height:34px!important;padding:6px 11px!important;background:transparent!important;box-shadow:none!important;}
.sn-primary {background:#526f5b!important;color:#fff4d7!important;border-color:#49634f!important;box-shadow:0 3px 0 #3b5142!important;}
.sn-primary:hover {background:#63816a!important;}
.sn-viewport {position:relative;flex:1;min-height:0;overflow:hidden;container-type:size;display:flex;justify-content:center;align-items:center;border-radius:22px;background:var(--sky);box-shadow:0 1px 0 #fff8e6 inset;isolation:isolate;}
.sn-world {width:min(100cqw,calc(100cqh * var(--ratio)));height:min(calc(100cqw / var(--ratio)),100cqh);position:relative;overflow:hidden;isolation:isolate;flex:none;background:var(--sky);touch-action:none;}
.sn-scene {position:absolute;inset:0;pointer-events:none;}
.sn-sprite {position:absolute;pointer-events:none;will-change:transform;}
.sn-sprite-img {width:100%!important;height:100%!important;pointer-events:none;user-select:none;}
.sn-far {pointer-events:none;}
.sn-trail {position:absolute;transform:translate(-50%,-50%);border-radius:80%;background:#d3edc4;box-shadow:0 1px 0 #fffbea70;z-index:50;pointer-events:none;}
.sn-particle {position:absolute;z-index:95;pointer-events:none;}
.sn-physical {background:#f4e7c7e8;border:1px solid #998f6c60;border-radius:4px;padding:1px 5px;font-size:clamp(7px,.82vw,11px)!important;color:#646650!important;line-height:1.3!important;font-weight:bold!important;white-space:nowrap;pointer-events:none;}
.sn-rain {position:absolute;inset:0;z-index:34;pointer-events:none;opacity:.32;background:repeating-linear-gradient(113deg,transparent 0,transparent 58px,#e6f4e3 59px,transparent 61px,transparent 119px);background-size:139px 147px;animation:sn-rainfall .55s linear infinite;}
@keyframes sn-rainfall {from{background-position:0 0}to{background-position:-39px 147px}}
.sn-reduced .sn-rain {animation:none;opacity:.14;}
@media (prefers-reduced-motion: reduce) {.sn-rain {animation:none;opacity:.14;}}
.sn-hud {position:absolute;inset:0;pointer-events:none;z-index:110;}
.sn-route-label {position:absolute;left:25px;top:23px;max-width:68%;}
.sn-route-name {display:block;font-family:Georgia,serif;font-size:clamp(15px,1.65vw,24px)!important;font-weight:bold!important;color:#3e5549!important;line-height:1.3!important;}
.sn-route-count {display:block;font-size:9px!important;letter-spacing:2px;font-weight:bold!important;color:#6c805f!important;margin-bottom:5px;}
.sn-night .sn-route-name,.sn-night .sn-route-count {color:#ece5c8!important;}
.sn-watch {position:absolute;right:24px;top:25px;width:80px;height:80px;border:4px solid #8c9780;border-radius:50%;background:#f9f2d9e8;box-shadow:0 3px 0 #4f665224;display:flex;flex-direction:column;align-items:center;justify-content:center;}
.sn-watch::before {content:"";position:absolute;width:21px;height:9px;top:-11px;left:26px;border-radius:3px;background:#8c9780;}
.sn-watch-hand {position:absolute;left:35px;top:6px;width:2px;height:17px;background:#ae7754;transform-origin:1px 30px;}
.sn-watch-time {font-variant-numeric:tabular-nums;font-size:16px!important;color:#405848!important;font-weight:bold!important;z-index:1;}
.sn-watch-label {font-size:8px!important;letter-spacing:1px;color:#7a8269!important;font-weight:bold!important;}
.sn-boost-meter {position:absolute;top:116px;right:25px;width:77px;height:6px;background:#d2d6b6;border-radius:10px;overflow:hidden;}
.sn-boost-fill {height:100%;background:#bd8b56;border-radius:10px;}
.sn-boost-label {position:absolute;right:25px;top:126px;font-size:8px!important;letter-spacing:1.2px;color:#6e765b!important;font-weight:bold!important;}
.sn-night .sn-boost-label {color:#d2ddc0!important;}
.sn-toast {position:absolute;left:50%;top:20%;transform:translateX(-50%);max-width:65%;width:max-content;background:#fff7dde8;border:1px solid #e4d7b6;border-radius:30px;padding:9px 18px;color:#54654e!important;font-size:clamp(10px,1vw,14px)!important;font-weight:bold!important;text-align:center;line-height:1.4!important;box-shadow:0 3px 12px #514d3910;z-index:115;pointer-events:none;}
.sn-map {height:4px;position:relative;flex:0 0 4px;background:#d1d7b9;margin:11px 6px 0;border-radius:10px;}
.sn-map-fill {height:4px;background:#849777;border-radius:10px;}
.sn-map-stop {position:absolute;width:9px;height:9px;top:-3px;background:#d5d8bb;border:2px solid #b0ba98;border-radius:50%;}
.sn-map-stop.sn-map-active {background:#708966;border-color:#708966;}
.sn-dock {display:flex;gap:20px;align-items:center;min-height:83px;flex:0 0 auto;padding-top:12px;}
.sn-dispatch-note {flex:1;min-width:0;display:flex;gap:12px;align-items:center;}
.sn-parcel-thumb {width:43px!important;height:44px!important;object-fit:contain;}
.sn-note-title {display:block;font-size:13px!important;font-weight:bold!important;line-height:1.4!important;color:var(--ink)!important;}
.sn-note-sub {display:block;font-size:11px!important;color:#7f806b!important;line-height:1.4!important;max-width:560px;}
.sn-pad {display:flex;gap:7px;align-items:center;}
.sn-arrows {display:flex;gap:6px;margin-right:7px;}
.sn-control {width:65px;min-height:57px!important;flex-direction:column;gap:2px;padding:5px 6px!important;border-radius:14px!important;}
.sn-control-arrow {font-size:28px!important;line-height:1!important;font-weight:normal!important;}
.sn-control-glyph {font-size:18px!important;line-height:1.1!important;}
.sn-control-label {font-size:9px!important;letter-spacing:1px;line-height:1.2!important;}
.sn-control-key {font-size:8px!important;line-height:1.1!important;opacity:.6;}
.sn-boost-button {background:#edd6a4!important;border-color:#d1b786!important;}
.sn-jump-button {min-width:85px;background:#526f5b!important;color:#fff4d7!important;border-color:#49634f!important;box-shadow:0 3px 0 #3b5142!important;}
.sn-jump-button:hover {background:#63816a!important;}
.sn-sheet {position:absolute;z-index:140;top:50%;left:5%;transform:translateY(-50%) rotate(-1deg);width:410px;max-width:90%;max-height:95%;overflow:auto;background:#fbf4dfeF;border:1px solid #d7caa8;border-radius:8px;padding:29px 30px 27px;box-shadow:7px 9px 0 #8b94771d,0 16px 40px #53614315;}
.sn-sheet::before {content:"";position:absolute;top:0;left:0;right:0;height:7px;background:repeating-linear-gradient(125deg,#bb8067 0,#bb8067 13px,#fbf4df 13px,#fbf4df 25px,#7e9a8b 25px,#7e9a8b 38px,#fbf4df 38px,#fbf4df 51px);opacity:.8;}
.sn-sheet-title {white-space:pre-line;font-family:Georgia,serif;font-size:39px!important;line-height:1.03!important;font-weight:bold!important;letter-spacing:-1.1px;color:#3f5749!important;display:block;margin:14px 0 14px!important;}
.sn-sheet-lead {display:block;font-size:14px!important;font-weight:bold!important;color:#65735a!important;line-height:1.5!important;}
.sn-sheet-copy {display:block;font-size:12px!important;color:#828269!important;line-height:1.65!important;margin:9px 0!important;white-space:pre-line;}
.sn-consignment {display:flex;align-items:center;gap:13px;border-top:1px dashed #c9c6a7;border-bottom:1px dashed #c9c6a7;padding:12px 0;margin:16px 0;}
.sn-consignment-art {width:53px!important;height:65px!important;flex:0 0 53px;}
.sn-full {width:100%;margin-top:9px;min-height:47px!important;}
.sn-secondary-row {display:flex;gap:8px;flex-wrap:wrap;margin-top:11px;}
.sn-dispatch-rack {position:absolute;inset:3%;z-index:150;background:#f6f0dbf5;border:1px solid #d6ceac;border-radius:16px;padding:24px;overflow:auto;box-shadow:0 12px 40px #42544024;}
.sn-rack-header {display:flex;justify-content:space-between;align-items:center;gap:18px;}
.sn-rack-title {font-family:Georgia,serif;font-size:31px!important;color:#405a49!important;font-weight:bold!important;line-height:1.2!important;}
.sn-routes {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:21px;}
.sn-route-card {position:relative;display:flex!important;align-items:center!important;justify-content:flex-start!important;text-align:left;min-height:123px!important;padding:17px 14px!important;gap:12px!important;box-shadow:2px 3px 0 #9ca28720!important;border-style:dashed!important;border-radius:8px!important;}
.sn-route-art {width:44px!important;height:64px!important;object-fit:contain;}
.sn-route-card-title {display:block;font-family:Georgia,serif;font-size:17px!important;font-weight:bold!important;line-height:1.2!important;color:#4e634e!important;}
.sn-route-card-sub {display:block;font-size:9px!important;color:#7a8067!important;letter-spacing:1px;margin:4px 0!important;}
.sn-route-record {display:block;font-size:11px!important;color:#a18751!important;line-height:1.5!important;}
.sn-stars {display:block;font-size:32px!important;letter-spacing:6px;color:#b49654!important;line-height:1.4!important;}
.sn-stamp-seal {white-space:pre-line;position:absolute;right:21px;top:22px;color:#87956e!important;font-size:10px!important;border:2px solid #91a07b;border-radius:50%;width:61px;height:61px;display:flex;align-items:center;justify-content:center;text-align:center;transform:rotate(12deg);font-weight:bold!important;line-height:1.3!important;}
.sn-check-row {display:flex;gap:8px;flex-wrap:wrap;margin-top:13px;}
.sn-save {font-size:10px!important;display:block;color:#929077!important;margin-top:13px!important;}
@media(max-width:800px){.sn-root{padding:0 9px 10px}.sn-header{height:60px;flex-basis:60px;gap:7px}.sn-brand-name{font-size:18px!important}.sn-kicker{font-size:8px!important;letter-spacing:1.4px}.sn-icon{width:32px!important;height:32px!important}.sn-tool{padding:6px 8px!important;font-size:11px!important}.sn-routes{grid-template-columns:repeat(2,minmax(0,1fr))}.sn-dock{gap:9px;flex-wrap:wrap;padding-top:9px}.sn-dispatch-note{flex-basis:100%;gap:8px}.sn-parcel-thumb{width:26px!important;height:28px!important}.sn-note-title{font-size:11px!important}.sn-note-sub{font-size:10px!important}.sn-pad{width:100%;justify-content:center}.sn-sheet{left:50%;transform:translate(-50%,-50%) rotate(-.4deg);width:410px}.sn-viewport{border-radius:15px}.sn-zoom-word{display:none!important}.sn-control-key{display:none!important}.sn-control{min-height:55px!important}.sn-physical{font-size:7px!important}.sn-route-label{left:13px;top:12px}.sn-watch{right:16px;top:20px;transform:scale(.78);transform-origin:top right}.sn-boost-meter{right:17px;top:87px;width:60px}.sn-boost-label{right:17px;top:97px;font-size:7px!important}.sn-route-count{font-size:7px!important;letter-spacing:1px}.sn-toast{top:23%;padding:6px 10px;max-width:68%;font-size:10px!important}}
@media(max-width:450px){.sn-header{height:53px;flex-basis:53px}.sn-brand-name{font-size:15px!important}.sn-brand .sn-kicker{display:none}.sn-brand{gap:5px}.sn-icon{width:25px!important;height:25px!important}.sn-tools{gap:3px}.sn-tool{padding:6px!important;font-size:10px!important;min-height:32px!important}.sn-control{width:54px;min-height:53px!important}.sn-jump-button{min-width:74px}.sn-arrows{margin-right:3px;gap:5px}.sn-pad{gap:5px}.sn-routes{grid-template-columns:1fr}.sn-rack-title{font-size:25px!important}.sn-dispatch-rack{padding:18px}.sn-sheet{padding:23px 24px 21px}.sn-sheet-title{font-size:34px!important}.sn-sheet-copy{font-size:11px!important}.sn-consignment{padding:9px 0;margin:12px 0}.sn-sheet-lead{font-size:12px!important}.sn-note-sub{max-width:350px}.sn-map{margin-top:8px}.sn-dock{gap:7px}}
@media(max-height:550px) and (min-width:550px){.sn-root{padding:0 10px 6px}.sn-header{height:43px;flex-basis:43px}.sn-brand-name{font-size:17px!important}.sn-icon{height:29px!important;width:29px!important}.sn-brand .sn-kicker{display:none}.sn-dock{min-height:57px;padding-top:6px;flex-wrap:nowrap;gap:8px}.sn-dispatch-note{flex-basis:auto}.sn-control{min-height:43px!important;width:56px}.sn-control-key{display:none}.sn-map{margin-top:5px}.sn-sheet{left:3%;transform:translateY(-50%);width:410px;padding:18px 25px;max-height:96%}.sn-sheet-title{font-size:26px!important;margin:9px 0!important}.sn-sheet-copy{font-size:10px!important;line-height:1.45!important}.sn-consignment{margin:7px 0;padding:5px 0}.sn-consignment-art{height:42px!important}.sn-full{min-height:37px!important;margin-top:5px}.sn-secondary-row{margin-top:5px}.sn-save{display:none}.sn-route-label{top:12px;left:16px}.sn-toast{top:19%;font-size:10px!important}.sn-route-name{font-size:15px!important}.sn-note-title{font-size:11px!important}.sn-note-sub{font-size:9px!important}.sn-parcel-thumb{height:28px!important;width:29px!important}}
.sn-mobile-start {display:none!important;}
@media(max-width:550px) and (orientation:portrait){.sn-desktop-start{display:none!important}.sn-mobile-start{display:inline-flex!important}}




/* MOBILE EDITION START */
/* Mobile edition: reachable tools, scrolling sheets and a two-thumb dock. */
.sn-root {padding-left:max(12px,env(safe-area-inset-left));padding-right:max(12px,env(safe-area-inset-right));padding-bottom:max(10px,env(safe-area-inset-bottom));}
.sn-root .sn-btn {min-height:44px!important;touch-action:manipulation;}
.sn-root .sn-tool {min-width:44px;flex-shrink:0;}
.sn-root .sn-control {touch-action:none;}
.sn-sheet,.sn-dispatch-rack {overscroll-behavior:contain;touch-action:pan-y;}
.sn-sheet-copy {color:#626b53!important;}
@media(max-width:600px) {
 .sn-root {padding-top:max(6px,env(safe-area-inset-top));}
 .sn-header {height:auto;flex:0 0 auto;min-height:92px;flex-wrap:wrap;gap:5px;padding-bottom:8px;}
 .sn-brand {width:100%;justify-content:center;}
 .sn-brand-name {font-size:18px!important;}
 .sn-tools {width:100%;justify-content:center;gap:8px;}
 .sn-root .sn-tool {padding:6px 12px!important;font-size:12px!important;}
 .sn-root .sn-zoom-word {display:inline!important;}
 .sn-dock {gap:6px;flex-wrap:wrap;padding-top:8px;}
 .sn-dispatch-note {flex-basis:100%;}
 .sn-note-sub {font-size:11px!important;line-height:1.4!important;}
 .sn-pad {width:100%;display:grid;grid-template-columns:2fr 1fr 1fr 1.25fr;gap:6px;}
 .sn-arrows {display:grid;grid-template-columns:1fr 1fr;gap:5px;}
 .sn-root .sn-control {width:100%;min-width:0;min-height:58px!important;}
 .sn-control-label {font-size:10px!important;letter-spacing:.3px;}
 .sn-sheet {max-width:calc(100% - 16px);width:410px;left:50%;transform:translate(-50%,-50%);padding:20px;}
 .sn-sheet-copy {font-size:12px!important;}
 .sn-rack-header {gap:8px;align-items:flex-start;}
 .sn-rack-title {font-size:24px!important;}
 .sn-routes {grid-template-columns:1fr;}
}
@media(max-height:520px) and (orientation:landscape) {
 .sn-header {height:48px;flex-basis:48px;}
 .sn-dock {min-height:60px;}
 .sn-root .sn-control {min-height:48px!important;}
 .sn-sheet,.sn-dispatch-rack {position:absolute;inset:8px max(12px,env(safe-area-inset-right)) 8px max(12px,env(safe-area-inset-left));width:auto;max-width:none;max-height:none;transform:none;padding:18px 24px;}
 .sn-sheet-title {font-size:28px!important;}
 .sn-sheet-copy {font-size:12px!important;}
}

/* MOBILE EDITION END */
</style>
<Box className={settings.reducedMotion ? "sn-root sn-reduced" : "sn-root"} style={stageStyle}>
 <Loop frame running={phase === "play" || phase === "delivery"} @tick={tick} />
 <Box className="sn-header">
  <Box className="sn-brand"><Image loading="eager" className="sn-icon" src={asset("assets/icon.svg")} alt="" /><Box><Text className="sn-brand-name">Express Delivery Snail</Text><Text className="sn-kicker">Small courier. Ridiculous responsibility.</Text></Box></Box>
  <Box className="sn-tools">
   <Button variant="ghost" className="sn-btn sn-tool" ariaLabel="Choose a delivery route" @click={openRoutes}>Routes</Button>
   <Button variant="ghost" className="sn-btn sn-tool" ariaLabel="Toggle close-up view" @click={toggleZoom}><Text>⌕</Text><Text className="sn-zoom-word">{zoomLabel}</Text></Button>
   <Button variant="ghost" className="sn-btn sn-tool" ariaLabel="Toggle sound" @click={toggleSound}>{settings.muted ? "♪ off" : "♪"}</Button>
   <Button variant="ghost" className="sn-btn sn-tool" ariaLabel="Pause or resume" disabled={phase !== "play" && phase !== "paused"} @click={pauseGame}>{phase === "paused" ? "▶" : "Ⅱ"}</Button>
  </Box>
 </Box>
 <Box className="sn-viewport"><World /><Screens /></Box>
 <Box className="sn-map"><Box className="sn-map-fill" style={progressStyle} />#each (stop in mapStops)
  <Box className={stop.active ? "sn-map-stop sn-map-active" : "sn-map-stop"} style={stop.style} />
 #end</Box>
 <Controls />
</Box>
