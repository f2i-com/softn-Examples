<Box if={phase === "dispatch"} className="sn-sheet">
 <Text className="sn-kicker">Shell express · Special delivery</Text>
 <Text className="sn-sheet-title">{"Urgent parcel.\nUnhurried species."}</Text>
 <Text className="sn-sheet-lead">{LEVELS[S.level].where}</Text>
 <Box className="sn-consignment"><Image loading="eager" className="sn-consignment-art" src={asset(postcardArt)} objectFit="contain" alt="Your next parcel" /><Box><Text className="sn-kicker">{"Consignment " + routeNumber}</Text><Text className="sn-note-title">{parcelTitle}</Text><Text className="sn-sheet-copy">{parcelTip}</Text></Box></Box>
 <Text className="sn-sheet-copy">Build a little momentum. Hop before the big stuff. Boost on the clear stretches. Your shell is not a brake.</Text>
 <Button variant="ghost" className="sn-btn sn-primary sn-full sn-desktop-start" @click={startDelivery}>{hasResume ? "Continue from rest stop →" : "Take the delivery →"}</Button>
 <Button variant="ghost" className="sn-btn sn-primary sn-full sn-mobile-start" @click={startMobileDelivery}>{hasResume ? "Continue from rest stop →" : "Take the delivery →"}</Button>
 <Box className="sn-secondary-row"><Button variant="ghost" className="sn-btn" @click={openRoutes}>The dispatch rack · 7 routes</Button><Button variant="ghost" className="sn-btn" @click={toggleGentle}>{settings.gentle ? "Gentle: on" : "Gentle mode"}</Button></Box>
 <Text className="sn-save">{saveStatus}</Text>
</Box>
<Box if={phase === "paused"} className="sn-sheet">
 <Text className="sn-kicker">Union-mandated leaf break</Text><Text className="sn-sheet-title">{"Slow down.\nOfficially."}</Text>
 <Text className="sn-sheet-lead">The stopwatch, weather and parcel all wait for you.</Text>
 <Text className="sn-sheet-copy">A/D or arrows: move · Space/W: hop · E: boost · Q: care/brake · R: checkpoint rescue · P/Esc: pause · M: sound. A short jump tap makes a low hop.</Text>
 <Button variant="ghost" className="sn-btn sn-primary sn-full" @click={pauseGame}>Back to being express →</Button>
 <Button variant="ghost" className="sn-btn sn-full" @click={rescueFromMenu}>Call checkpoint rescue · +2 seconds</Button>
 <Box className="sn-check-row"><Button variant="ghost" className="sn-btn" @click={toggleGentle}>{settings.gentle ? "Gentle: on" : "Gentle: off"}</Button><Button variant="ghost" className="sn-btn" @click={toggleMotion}>{settings.reducedMotion ? "Reduced motion: on" : "Reduced motion: off"}</Button><Button variant="ghost" className="sn-btn" @click={toggleSound}>{settings.muted ? "Sound: off" : "Sound: on"}</Button></Box>
 <Box className="sn-secondary-row"><Button variant="ghost" className="sn-btn" @click={openRoutes}>Choose a route</Button><Button variant="ghost" className="sn-btn" @click={askRestart}>Restart this route</Button></Box>
 <Box if={confirmRestart}><Text className="sn-sheet-copy">Restart the current delivery? Completed routes and best grades stay saved.</Text><Button variant="ghost" className="sn-btn" @click={restartRoute}>Yes, a fresh parcel please</Button></Box>
 <Text className="sn-save">{saveStatus}</Text>
</Box>
<Box if={phase === "report"} className="sn-sheet">
 <Box className="sn-stamp-seal"><Text>{"SIGNED\n& SEALED"}</Text></Box>
 <Text className="sn-kicker">Proof of delivery</Text><Text className="sn-stars">{gradeStars}</Text><Text className="sn-sheet-title">{gradeTitle}</Text>
 <Text className="sn-sheet-copy">{gradeBody}</Text>
 <Text className="sn-sheet-copy">One star for delivery. One for beating the stopwatch target. One for arriving at 80% condition or better. Every parcel still gets delivered.</Text>
 <Button variant="ghost" className="sn-btn sn-primary sn-full" @click={nextDelivery}>{S.level === 6 ? "Clock off. Heroically. →" : "The next ridiculous delivery →"}</Button>
 <Box className="sn-secondary-row"><Button variant="ghost" className="sn-btn" @click={restartRoute}>Try a cleaner run</Button><Button variant="ghost" className="sn-btn" @click={openRoutes}>Dispatch rack</Button></Box>
</Box>
<Box if={phase === "routes"} className="sn-dispatch-rack">
 <Box className="sn-rack-header"><Box><Text className="sn-kicker">Seven very important errands</Text><Text className="sn-rack-title">The dispatch rack</Text></Box><Button variant="ghost" className="sn-btn" @click={closeRoutes}>Back</Button></Box>
 <Text className="sn-sheet-copy">Choose any route. No grinding, no locked parcels. Your best deliveries get their own little stamp.</Text>
 <Box className="sn-routes">#each (route in routeButtons)
  <Button variant="ghost" className="sn-btn sn-route-card" @click={selectRoute(route.id)}><Image loading="eager" className="sn-route-art" src={asset(route.art)} objectFit="contain" alt="" /><Box><Text className="sn-route-card-sub">{route.number + " / " + route.parcel}</Text><Text className="sn-route-card-title">{route.name}</Text><Text className="sn-route-record">{route.record}</Text></Box></Button>
 #end</Box>
</Box>
<Box if={phase === "ending"} className="sn-sheet"><Text className="sn-kicker">The end of a very small working day</Text><Text className="sn-sheet-title">{"Express, in\nyour own way."}</Text><Text className="sn-sheet-lead">The letter was a thank-you note. It was for you.</Text><Text className="sn-sheet-copy">You put down the rocket, fold your little cap, and take a gloriously unnecessary slow walk home.</Text><Text className="sn-stars">♥</Text><Text className="sn-sheet-copy">{profile.completed + " / 7 routes signed for. Revisit any delivery for a better time, an intact vase, or just a very satisfying slide."}</Text><Button variant="ghost" className="sn-btn sn-primary sn-full" @click={openRoutes}>One more little errand →</Button></Box>
