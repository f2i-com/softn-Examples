// Solar Simulator — Audio & Mobile Haptics Engine

let muted = false
let ambientMusicOn = true
let _ambientHandle = null
let _flybySoundCooldown = 0.0

function playSfx(name, volume) {
  if (muted) { return }
  let vol = volume !== undefined ? volume : 0.65
  if (typeof softn !== "undefined" && softn && softn.audio && typeof softn.audio.play === "function") {
    softn.audio.play("assets/sfx/" + name + ".wav", { volume: vol })
  }
}

function triggerHaptic(ms) {
  if (typeof navigator !== "undefined" && navigator && typeof navigator.vibrate === "function") {
    try {
      navigator.vibrate(ms)
    } catch (_e) {}
  }
}

function startAmbientMusic() {
  if (muted || !ambientMusicOn || _ambientHandle !== null) { return }
  if (typeof softn !== "undefined" && softn && softn.audio && typeof softn.audio.play === "function") {
    softn.audio.play("assets/sfx/ambient_cosmos.wav", { volume: 0.24, loop: true }, function (r) {
      if (r && r.handle) {
        if (muted || !ambientMusicOn) {
          softn.audio.stop(r.handle)
        } else {
          _ambientHandle = r.handle
        }
      }
    })
  }
}

function stopAmbientMusic() {
  if (_ambientHandle !== null) {
    if (typeof softn !== "undefined" && softn && softn.audio && typeof softn.audio.stop === "function") {
      softn.audio.stop(_ambientHandle)
    }
    _ambientHandle = null
  }
}

function syncAmbientState() {
  if (muted || !ambientMusicOn) {
    stopAmbientMusic()
  } else {
    startAmbientMusic()
  }
}
