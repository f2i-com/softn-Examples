// Solar Simulator — Astronomical Constants, NASA JPL J2000 Ephemeris,
// Stellar Evolution Tracks, Asteroid Impactor Classes & Multi-Star Scenarios.

// Fundamental Astrophysical Units:
//   Distance: 1 AU = 149,597,870.7 km
//   Time:     1 Julian Year = 365.25 days = 31,557,600 s
//   Mass:     1 Solar Mass (M_sun) = 1.98847e30 kg
//   Gravity:  G = 4 * pi^2 AU^3 / (yr^2 * M_sun)
let AU_KM = 149597870.7
let YEAR_DAYS = 365.25
let YEAR_SECONDS = 31557600.0
let G_AU = 4.0 * Math.PI * Math.PI
let C_AU_YR = 63241.077
let AU_YR_TO_KMS = AU_KM / YEAR_SECONDS
let M_SUN_KG = 1.98847e30
let M_EARTH_KG = 5.97219e24
let M_EARTH_MSUN = M_EARTH_KG / M_SUN_KG
let R_SUN_KM = 696340.0
let R_SUN_AU = R_SUN_KM / AU_KM
let R_EARTH_KM = 6371.0
let R_EARTH_AU = R_EARTH_KM / AU_KM
let DEG_TO_RAD = Math.PI / 180.0
let RAD_TO_DEG = 180.0 / Math.PI

// 3D Scene Unit Mapping: 1.000 AU = 12.000 Scene Units
let AU_TO_SCENE = 12.0

