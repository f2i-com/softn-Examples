// Solar Simulator — 3D Scene Composition, Multi-Scale Astronomical Rendering,
// Reference-Frame Camera Centering, Dynamic Multi-Star Lighting & Orbit Ellipses.

let sceneStatic = []
let sceneObjects = []
let sceneLights = []
let sceneEffects = {
  bloom: { strength: 0.46, radius: 0.34, threshold: 0.80 },
  vignette: 0.28
}

let qualityPreset = "high"
let scaleMode = "proportional"
let showOrbits = true
let showTrails = true
let showBelt = true
let showHabZone = true
let showLabels = true

let focusedBodyId = ""
let cameraPreset = "inner"
let viewportWidth = 1280
let viewportHeight = 800
let isTouchDevice = false
let isMobileLayout = false
let isPortrait = false
let simVisualClock = 0.0

// Reference-frame origin in AU (subtracted from all objects so focused worlds sit at WebGL (0,0,0) with zero Float32 jitter!)
let refOriginAU = { x: 0.0, y: 0.0, z: 0.0 }

let cameraConfig = {
  position: { x: 0.0, y: 17.5, z: 28.0 },
  lookAt: { x: 0.0, y: 0.0, z: 0.0 },
  fov: 46,
  near: 0.002,
  far: 6500
}

let orbitLimits = {
  minDistance: 0.0025,
  maxDistance: 1600.0,
  minPolar: 0.04,
  maxPolar: 3.10,
  pan: true,
  zoom: true
}

let anchorItems = []

// Precomputed RGB tuples for wake trails & debris clouds
function hexToRgbUnit(hex) {
  let s = String(hex || "#ffffff")
  if (s.charAt(0) === "#") { s = s.slice(1) }
  if (s.length !== 6) { return [0.9, 0.92, 0.98] }
  let r = parseInt(s.slice(0, 2), 16)
  let g = parseInt(s.slice(2, 4), 16)
  let b = parseInt(s.slice(4, 6), 16)
  if (isNaN(r) || isNaN(g) || isNaN(b)) { return [0.9, 0.92, 0.98] }
  return [r / 255.0, g / 255.0, b / 255.0]
}

// Build Static 3D Pinpoint Starfield Shell (complements `deep-space.hdr` Milky Way panorama)
function buildStaticStarfield() {
  let pos = []
  let col = []
  let spectralRgb = [
    [0.72, 0.84, 1.00],
    [0.94, 0.96, 1.00],
    [1.00, 0.95, 0.82],
    [1.00, 0.82, 0.62],
    [1.00, 0.68, 0.56]
  ]
  let seed = 918273
  let i = 0
  while (i < 900) {
    seed = (seed * 1664525 + 1013904223) % 4294967296
    let u = (seed / 4294967296) * 2.0 - 1.0
    seed = (seed * 1664525 + 1013904223) % 4294967296
    let phi = (seed / 4294967296) * 6.2831853
    seed = (seed * 1664525 + 1013904223) % 4294967296
    let rad = 1850.0 + (seed / 4294967296) * 950.0
    let s = Math.sqrt(Math.max(0.0, 1.0 - u * u))
    pos.push(rad * s * Math.cos(phi), rad * u, rad * s * Math.sin(phi))
    let c = spectralRgb[i % 5]
    let dim = 0.55 + (i % 7) * 0.075
    col.push(c[0] * dim, c[1] * dim, c[2] * dim)
    i = i + 1
  }

  sceneStatic = [
    {
      id: "deep-starfield-shell",
      type: "particles",
      particlePositions: pos,
      particleColors: col,
      particleSize: 6.5,
      particleShape: "round",
      opacity: 0.92,
      fog: false,
      pickable: false
    }
  ]
}

function applyQualityPreset(mode) {
  qualityPreset = mode
  if (mode === "low") {
    sceneEffects = { vignette: 0.24 }
  } else if (mode === "balanced") {
    sceneEffects = {
      bloom: { strength: 0.36, radius: 0.28, threshold: 0.84 },
      vignette: 0.26
    }
  } else {
    sceneEffects = {
      bloom: { strength: 0.48, radius: 0.36, threshold: 0.78 },
      vignette: 0.28
    }
  }
}

function getSceneMaxPixelRatio() {
  if (qualityPreset === "low") { return 1.0 }
  if (isTouchDevice || isMobileLayout) { return 1.35 }
  return 1.65
}

// Compute Visual Radius in Scene Units for Current Scale Mode:
//   - "true_1to1":    Literal 1:1 physical km/AU scale (1 AU = 12.0 units, Earth R = 0.000511)
//   - "proportional": Exact 1:1 AU orbits + clear monotonic planet hierarchy; Red Giant smoothly uses exact physical radius!
//   - "lineup":       Exact true relative diameters (R / 180,000 km) side-by-side
function getBodyVisualRadius(body) {
  if (scaleMode === "true_1to1") {
    if (body.kind === "impactor") {
      return Math.max(0.00025, body.radiusAU * AU_TO_SCENE * 8.0)
    }
    return Math.max(0.00018, body.radiusAU * AU_TO_SCENE)
  }

  if (scaleMode === "lineup") {
    return Math.max(0.006, body.radiusKm / 180000.0)
  }

  // "proportional": 100% exact AU positions + monotonic astronomical hierarchy
  if (body.kind === "star") {
    let physSceneR = body.radiusAU * AU_TO_SCENE
    if (body.spectral === "PSR") {
      return 0.14
    }
    if (body.spectral === "DA2") {
      return 0.17
    }
    let subSolarVis = clampVal(0.92 * Math.pow(Math.max(0.01, body.radiusKm / R_SUN_KM), 0.38), 0.16, 1.35)
    // When a star swells into a Red Giant (physSceneR > subSolarVis), render its EXACT 1:1 physical AU radius!
    return Math.max(physSceneR, subSolarVis)
  }

  if (body.kind === "impactor") {
    return clampVal(0.065 + Math.log10(Math.max(10.0, body.radiusKm * 2.0)) * 0.042, 0.08, 0.24)
  }

  return clampVal(0.22 * Math.pow(Math.max(100.0, body.radiusKm) / R_EARTH_KM, 0.44), 0.065, 0.72)
}

// Compute Lineup X coordinate when `scaleMode === "lineup"`
function getLineupPosition(indexInLineup, body) {
  // Primary Sun sits on the left with its right limb near x = -1.6, followed by all planets in order
  if (indexInLineup === 0 && body.kind === "star") {
    let rSun = getBodyVisualRadius(body)
    return { x: -1.85 - rSun, y: 0.0, z: 0.0 }
  }
  // Spacing slots for Mercury..Pluto + companion stars
  let slots = [-1.15, -0.78, -0.38, 0.02, 0.42, 1.35, 2.85, 4.05, 4.75, 5.30, 6.25, 7.40]
  let sx = indexInLineup - 1 < slots.length ? slots[Math.max(0, indexInLineup - 1)] : (5.5 + indexInLineup * 0.85)
  return { x: sx, y: 0.0, z: 0.0 }
}

// Compute Responsive Camera Configuration for Preset & Viewport Aspect
function computePresetCamera(preset) {
  let w = viewportWidth > 0 ? viewportWidth : 1280
  let h = viewportHeight > 0 ? viewportHeight : 800
  let aspect = w / h
  let pullBack = aspect < 1.0 ? clampVal(1.0 + (1.0 - aspect) * 0.92, 1.0, 1.68) : (h < 500 ? 1.15 : 1.0)
  let fov = aspect < 0.85 ? 54 : 46

  if (scaleMode === "lineup" || preset === "lineup") {
    return {
      position: { x: 1.45, y: 1.65 * pullBack, z: 8.6 * pullBack },
      lookAt: { x: 1.25, y: 0.0, z: 0.0 },
      fov: fov,
      near: 0.001,
      far: 6500
    }
  }

  if (preset === "focus" && focusedBodyId !== "") {
    let fb = getBodyById(focusedBodyId)
    if (fb && fb.alive) {
      let vr = getBodyVisualRadius(fb)
      let dist = scaleMode === "true_1to1" ? Math.max(0.0026, vr * 5.6) : Math.max(1.05, vr * 5.2)
      if (fb.hasRings) { dist = dist * 1.45 }
      return {
        position: { x: dist * 0.52 * pullBack, y: dist * 0.42 * pullBack, z: dist * 0.92 * pullBack },
        lookAt: { x: 0.0, y: 0.0, z: 0.0 },
        fov: 44,
        near: scaleMode === "true_1to1" ? 0.00008 : 0.002,
        far: 6500
      }
    }
  }

  if (preset === "top") {
    return {
      position: { x: 0.0, y: 46.0 * pullBack, z: 0.6 },
      lookAt: { x: 0.0, y: 0.0, z: 0.0 },
      fov: fov,
      near: 0.002,
      far: 6500
    }
  }

  if (preset === "edge") {
    return {
      position: { x: 0.0, y: 2.4, z: 42.0 * pullBack },
      lookAt: { x: 0.0, y: 0.0, z: 0.0 },
      fov: fov,
      near: 0.002,
      far: 6500
    }
  }

  if (preset === "giants") {
    return {
      position: { x: -24.0 * pullBack, y: 76.0 * pullBack, z: 138.0 * pullBack },
      lookAt: { x: 0.0, y: 0.0, z: 0.0 },
      fov: fov,
      near: 0.005,
      far: 6500
    }
  }

  if (preset === "full") {
    return {
      position: { x: -45.0 * pullBack, y: 235.0 * pullBack, z: 410.0 * pullBack },
      lookAt: { x: 0.0, y: 0.0, z: 0.0 },
      fov: fov,
      near: 0.01,
      far: 6500
    }
  }

  // Default "inner": Inner Solar System + Mars + Asteroid Belt (0..3.5 AU = 0..42 scene units)
  return {
    position: { x: -4.2 * pullBack, y: 19.5 * pullBack, z: 31.5 * pullBack },
    lookAt: { x: 0.0, y: 0.0, z: 0.0 },
    fov: fov,
    near: scaleMode === "true_1to1" ? 0.0001 : 0.002,
    far: 6500
  }
}

function setCameraPreset(preset) {
  cameraPreset = preset
  if (preset !== "focus") {
    focusedBodyId = ""
  }
  if (scaleMode === "lineup" && preset !== "lineup") {
    scaleMode = "proportional"
  }
  orbitLimits = {
    minDistance: scaleMode === "true_1to1" ? 0.0006 : 0.35,
    maxDistance: 1650.0,
    minPolar: 0.03,
    maxPolar: 3.11,
    pan: true,
    zoom: true
  }
  cameraConfig = computePresetCamera(preset)
}

function focusOnBody(bodyId) {
  let b = getBodyById(bodyId)
  if (!b || !b.alive) {
    focusedBodyId = ""
    setCameraPreset("inner")
    return
  }
  focusedBodyId = b.id
  cameraPreset = "focus"
  orbitLimits = {
    minDistance: scaleMode === "true_1to1" ? 0.0005 : 0.25,
    maxDistance: 1650.0,
    minPolar: 0.03,
    maxPolar: 3.11,
    pan: true,
    zoom: true
  }
  cameraConfig = computePresetCamera("focus")
}

function setScaleModeView(modeId) {
  scaleMode = modeId
  if (modeId === "lineup") {
    focusedBodyId = ""
    cameraPreset = "lineup"
    cameraConfig = computePresetCamera("lineup")
  } else if (focusedBodyId !== "") {
    focusOnBody(focusedBodyId)
  } else {
    setCameraPreset(cameraPreset === "lineup" ? "inner" : cameraPreset)
  }
}

function applyViewportSize(w, h) {
  let nw = Math.round(Number(w) || 0)
  let nh = Math.round(Number(h) || 0)
  if (nw < 160 || nh < 160) { return }
  let changed = Math.abs(nw - viewportWidth) >= 6 || Math.abs(nh - viewportHeight) >= 6
  viewportWidth = nw
  viewportHeight = nh
  isPortrait = nh > nw * 1.02
  isMobileLayout = isTouchDevice || nw <= 860 || nh <= 540
  if (changed) {
    cameraConfig = computePresetCamera(cameraPreset)
  }
}

// Convert orthonormal basis [P_hat, Q_hat, H_hat] into Three.js XYZ Euler angles (radians)
function basisToEulerXYZ(Px, Py, Pz, Qx, Qy, Qz, Hx, Hy, Hz) {
  let sinY = clampVal(Hx, -1.0, 1.0)
  let ry = Math.asin(sinY)
  let rx = 0.0
  let rz = 0.0
  if (Math.abs(Hx) < 0.99999) {
    rx = Math.atan2(-Hy, Hz)
    rz = Math.atan2(-Qx, Px)
  } else {
    rx = Math.atan2(Qz, Qy)
    rz = 0.0
  }
  return { x: rx, y: ry, z: rz }
}

// Build Dynamic Lights at Each Live Star's Exact Scene Position
function buildSolarLights(ox, oy, oz) {
  let lights = [
    {
      id: "cosmos-ambient",
      type: "ambient",
      color: "#94a3b8",
      intensity: scaleMode === "lineup" ? 0.55 : 0.26
    },
    {
      id: "galactic-hemi",
      type: "hemisphere",
      color: "#dbeafe",
      groundColor: "#1e1b4b",
      intensity: 0.24
    }
  ]

  if (scaleMode === "lineup") {
    lights.push({
      id: "lineup-sunlight",
      type: "directional",
      color: "#fffbeb",
      intensity: 2.35,
      position: { x: -12.0, y: 6.5, z: 10.0 },
      castShadow: false
    })
    sceneLights = lights
    return
  }

  let sIdx = 0
  let i = 0
  while (i < bodies.length) {
    let b = bodies[i]
    if (b.alive && b.kind === "star") {
      let lum = Math.max(0.02, b.luminosityLsun || 1.0)
      let inten = clampVal(2.15 + Math.log10(lum) * 0.48, 1.05, 3.85)
      lights.push({
        id: "star-light-" + sIdx,
        type: "point",
        color: b.photoHex || b.color || "#fff7ed",
        intensity: inten,
        distance: 0,
        decay: 0.06,
        position: {
          x: (b.x - ox) * AU_TO_SCENE,
          y: (b.y - oy) * AU_TO_SCENE,
          z: (b.z - oz) * AU_TO_SCENE
        },
        castShadow: false
      })
      sIdx = sIdx + 1
    }
    i = i + 1
  }

  sceneLights = lights
}

// Compose Full 3D Solar System Scene Frame
function composeSceneFrame(dtRealSec, selectedId) {
  simVisualClock = simVisualClock + clampVal(dtRealSec || 0.016, 0.0, 0.05)

  // Determine Reference Origin (focused body in AU, or system barycenter (0,0,0))
  let ox = 0.0
  let oy = 0.0
  let oz = 0.0
  if (scaleMode !== "lineup" && focusedBodyId !== "") {
    let fb = getBodyById(focusedBodyId)
    if (fb && fb.alive) {
      ox = fb.x
      oy = fb.y
      oz = fb.z
    } else {
      focusedBodyId = ""
    }
  }
  refOriginAU = { x: ox, y: oy, z: oz }

  buildSolarLights(ox, oy, oz)

  let objs = []
  let nextAnchors = []
  let isLineup = scaleMode === "lineup"

  // 1. Render All Live Celestial Bodies (Stars, Planets, Dwarf Planets & Flying Impactor Asteroids)
  let lineupIdx = 0
  let i = 0
  while (i < bodies.length) {
    let b = bodies[i]
    if (b.alive && (!isLineup || b.kind !== "impactor")) {
      let sx = (b.x - ox) * AU_TO_SCENE
      let sy = (b.y - oy) * AU_TO_SCENE
      let sz = (b.z - oz) * AU_TO_SCENE
      if (isLineup) {
        let lp = getLineupPosition(lineupIdx, b)
        sx = lp.x
        sy = lp.y
        sz = lp.z
        lineupIdx = lineupIdx + 1
      }

      let visR = getBodyVisualRadius(b)
      let objId = "body-" + b.id
      let tiltRad = (b.obliquityDeg || 0.0) * DEG_TO_RAD

      if (b.kind === "star") {
        let hideFlares = b.spectral === "DA2" || b.spectral === "PSR"
        let pulse0 = 1.0 + 0.08 * Math.sin(simVisualClock * 2.3)
        let pulse1 = 1.0 + 0.08 * Math.cos(simVisualClock * 1.9 + 1.2)
        objs.push({
          id: objId,
          type: "model",
          modelUrl: b.modelUrl,
          position: { x: sx, y: sy, z: sz },
          rotation: { x: 0.0, y: b.spinAngle, z: tiltRad },
          rotationOrder: "ZXY",
          scale: visR,
          appearance: {
            colors: {
              Mat_Photosphere: b.photoHex || b.color || "#fbbf24",
              Mat_Chromosphere: b.chromoHex || "#f97316",
              Mat_Prominence: b.flareHex || "#fb923c"
            }
          },
          parts: {
            Flare_Arch_0: { visible: !hideFlares, scale: pulse0 },
            Flare_Arch_1: { visible: !hideFlares, scale: pulse1 },
            Flare_Arch_2: { visible: !hideFlares, scale: pulse0 },
            Flare_Arch_3: { visible: !hideFlares, scale: pulse1 }
          },
          castShadow: false,
          receiveShadow: false,
          interactive: true,
          cursor: "pointer"
        })

        // Luminous Stellar Corona Halo Sphere
        let coronaMult = (b.radiusAU > 0.25) ? 1.18 : 1.38
        objs.push({
          id: objId + "-corona",
          type: "sphere",
          radius: visR * coronaMult,
          position: { x: sx, y: sy, z: sz },
          color: b.chromoHex || "#f97316",
          emissive: b.photoHex || "#fbbf24",
          emissiveIntensity: 1.85,
          opacity: b.radiusAU > 0.25 ? 0.22 : 0.16,
          roughness: 1.0,
          pickable: false
        })
      } else if (b.kind === "impactor") {
        objs.push({
          id: objId,
          type: "model",
          modelUrl: b.modelUrl,
          position: { x: sx, y: sy, z: sz },
          rotation: { x: b.spinAngle * 0.7, y: b.spinAngle, z: b.spinAngle * 0.4 },
          scale: visR,
          castShadow: false,
          receiveShadow: false,
          pickable: false
        })
        // Incandescent plasma bow-shock sheath around incoming asteroid
        objs.push({
          id: objId + "-plasma",
          type: "sphere",
          radius: visR * 1.45,
          position: { x: sx, y: sy, z: sz },
          color: b.color || "#fb923c",
          emissive: b.color || "#fb923c",
          emissiveIntensity: 2.8,
          opacity: 0.34,
          pickable: false
        })
      } else {
        // Rocky, Gas Giant, Ice Giant, or Dwarf Planet
        let isMolten = (b.tempK || 0) >= 820 || (b.magmaTempK || 0) >= 650
        let parts = {}
        if (b.kind === "rocky" || b.kind === "dwarf") {
          parts.Magma_Crust = { visible: isMolten }
        }
        if (b.hasClouds) {
          parts.Cloud_Layer = {
            visible: (b.tempK || 288) < 430 && !isMolten,
            rotation: { x: 0.0, y: simVisualClock * 0.22, z: 0.0 }
          }
        }

        objs.push({
          id: objId,
          type: "model",
          modelUrl: b.modelUrl,
          position: { x: sx, y: sy, z: sz },
          rotation: { x: 0.0, y: b.spinAngle, z: tiltRad },
          rotationOrder: "ZXY",
          scale: visR,
          parts: parts,
          castShadow: false,
          receiveShadow: false,
          interactive: true,
          cursor: "pointer"
        })

        // Earth's 3D Moon (`planet-dwarf.glb`) orbiting cleanly in inclined lunar plane!
        if (b.hasMoon && !isLineup) {
          let moonOrbitR = scaleMode === "true_1to1" ? (0.0025695 * AU_TO_SCENE) : (visR * 2.55)
          let moonVisR = visR * 0.2727
          let moonPhase = simTimeYears * 12.368 * 6.283185 + simVisualClock * 0.35
          let mx = sx + Math.cos(moonPhase) * moonOrbitR
          let my = sy + Math.sin(moonPhase) * moonOrbitR * 0.09
          let mz = sz - Math.sin(moonPhase) * moonOrbitR
          objs.push({
            id: objId + "-moon",
            type: "model",
            modelUrl: "assets/models/planet-dwarf.glb",
            position: { x: mx, y: my, z: mz },
            rotation: { x: 0.0, y: moonPhase, z: 0.11 },
            scale: Math.max(0.00005, moonVisR),
            parts: { Magma_Crust: { visible: isMolten } },
            pickable: false
          })
        }

        // Post-Theia Giant Impact Accretion Debris Ring!
        if (b.hasDebrisRing) {
          objs.push({
            id: objId + "-debris-ring",
            type: "torus",
            radius: visR * 1.95,
            tube: visR * 0.14,
            position: { x: sx, y: sy, z: sz },
            rotation: { x: 1.42, y: 0.25, z: 0.0 },
            color: "#fb923c",
            emissive: "#ea580c",
            emissiveIntensity: 1.4,
            opacity: 0.72,
            pickable: false
          })
        }

        // Subtle selection halo torus around currently selected planet
        if (b.id === selectedId) {
          let selR = b.hasRings ? visR * 2.45 : visR * 1.55
          objs.push({
            id: "selected-body-halo",
            type: "torus",
            radius: Math.max(0.0004, selR),
            tube: Math.max(0.00003, selR * 0.035),
            position: { x: sx, y: sy, z: sz },
            rotation: { x: Math.PI * 0.5, y: 0.0, z: 0.0 },
            color: "#38bdf8",
            emissive: "#38bdf8",
            emissiveIntensity: 2.2,
            opacity: 0.85,
            pickable: false
          })
        }
      }

      // Build Floating `<SceneAnchor>` Metadata for Stars & Planets
      if (showLabels && b.kind !== "impactor") {
        let cDeg = Math.round((b.tempK || 273) - 273.15)
        let badge = b.kind === "star"
          ? (b.spectral + " · " + (Math.round(b.massMsun * 100) / 100) + " M☉")
          : ((cDeg >= 0 ? "+" : "") + cDeg + "°C")
        nextAnchors.push({
          id: "anc-" + b.id,
          bodyId: b.id,
          sceneObjId: objId,
          name: b.name,
          badge: badge,
          color: b.color || "#e2e8f0",
          offsetY: visR * (b.hasRings ? 1.55 : 1.32) + (scaleMode === "true_1to1" ? 0.0005 : 0.12),
          isSelected: b.id === selectedId
        })
      }
    }
    i = i + 1
  }

  // 2. Exact 3D Osculating Keplerian Orbit Ellipses (`showOrbits` in non-lineup modes)
  if (showOrbits && !isLineup) {
    let oi = 0
    while (oi < bodies.length) {
      let pb = bodies[oi]
      if (pb.alive && pb.kind !== "impactor") {
        let el = computeOsculatingElements(pb)
        if (el.bound && el.a > 0.03 && el.a < 85.0 && el.e < 0.96) {
          let aScene = el.a * AU_TO_SCENE
          let bScene = aScene * Math.sqrt(Math.max(0.02, 1.0 - el.e * el.e))
          // Ellipse geometric center C = ref - a * e * P_hat
          let cx = ((el.refX - el.a * el.e * el.Px) - ox) * AU_TO_SCENE
          let cy = ((el.refY - el.a * el.e * el.Py) - oy) * AU_TO_SCENE
          let cz = ((el.refZ - el.a * el.e * el.Pz) - oz) * AU_TO_SCENE
          let rot = basisToEulerXYZ(el.Px, el.Py, el.Pz, el.Qx, el.Qy, el.Qz, el.Hx, el.Hy, el.Hz)
          let isSel = pb.id === selectedId
          let tubeWorld = clampVal(0.016 * Math.pow(el.a, 0.56), 0.012, 0.24) * (isSel ? 1.65 : 1.0)

          objs.push({
            id: "orbit-ellipse-" + pb.id,
            type: "torus",
            radius: 1.0,
            tube: tubeWorld / Math.max(0.05, aScene),
            position: { x: cx, y: cy, z: cz },
            rotation: rot,
            scale: { x: aScene, y: bScene, z: aScene },
            color: pb.color || "#94a3b8",
            emissive: pb.color || "#94a3b8",
            emissiveIntensity: isSel ? 1.85 : 0.95,
            opacity: isSel ? 0.82 : (pb.kind === "star" ? 0.52 : 0.34),
            pickable: false
          })
        }
      }
      oi = oi + 1
    }
  }

  // 3. Circumstellar Habitable Zone Inner & Outer Boundaries (`0.95 * sqrt(L)` to `1.67 * sqrt(L)` AU)
  if (showHabZone && !isLineup) {
    let bary = getStellarBarycenter()
    if (bary.lumLsun > 0.005) {
      let sqrtL = Math.sqrt(bary.lumLsun)
      let hzInnerScene = 0.95 * sqrtL * AU_TO_SCENE
      let hzOuterScene = 1.67 * sqrtL * AU_TO_SCENE
      if (hzInnerScene < 1200.0) {
        let hx = (bary.x - ox) * AU_TO_SCENE
        let hy = (bary.y - oy) * AU_TO_SCENE
        let hz = (bary.z - oz) * AU_TO_SCENE
        let hzTube = clampVal(hzInnerScene * 0.006, 0.025, 0.45)
        objs.push({
          id: "hab-zone-inner",
          type: "torus",
          radius: hzInnerScene,
          tube: hzTube,
          position: { x: hx, y: hy - 0.02, z: hz },
          rotation: { x: Math.PI * 0.5, y: 0.0, z: 0.0 },
          color: "#34d399",
          emissive: "#10b981",
          emissiveIntensity: 1.25,
          opacity: 0.32,
          pickable: false
        })
        objs.push({
          id: "hab-zone-outer",
          type: "torus",
          radius: hzOuterScene,
          tube: hzTube,
          position: { x: hx, y: hy - 0.02, z: hz },
          rotation: { x: Math.PI * 0.5, y: 0.0, z: 0.0 },
          color: "#22d3ee",
          emissive: "#06b6d4",
          emissiveIntensity: 1.15,
          opacity: 0.28,
          pickable: false
        })
      }
    }
  }

  // 4. Instanced 3D Main-Belt & Kuiper-Belt Gravitating Asteroids (1 Single GPU Draw Call!)
  if (showBelt && !isLineup && beltAsteroids.length > 0) {
    let inst = []
    let rots = []
    let scs = []
    let astScaleMult = scaleMode === "true_1to1" ? 0.04 : 1.0
    let ai = 0
    while (ai < beltAsteroids.length) {
      let ast = beltAsteroids[ai]
      if (ast.alive) {
        inst.push(
          (ast.x - ox) * AU_TO_SCENE,
          (ast.y - oy) * AU_TO_SCENE,
          (ast.z - oz) * AU_TO_SCENE,
          ast.pal
        )
        rots.push(ast.rot + simVisualClock * 0.45)
        scs.push(ast.scale * astScaleMult)
      } else {
        // Keep buffer count steady to avoid GPU InstancedMesh reallocation
        inst.push(0.0, -5000.0, 0.0, 0)
        rots.push(0.0)
        scs.push(0.0)
      }
      ai = ai + 1
    }
    objs.push({
      id: "asteroid-belt-instanced",
      type: "instanced",
      shape: "dodecahedron",
      radius: 0.068,
      instances: inst,
      palette: ["#a8a29e", "#78716c", "#d6d3d1", "#7dd3fc"],
      instanceRotations: rots,
      instanceScales: scs,
      roughness: 0.88,
      metalness: 0.12,
      flatShading: true,
      pickable: false
    })
  }

  // 5. Dynamic N-Body Wake Trails + Incoming Asteroid Plasma Streaks (1 Single GPU Points Cloud!)
  if (showTrails && !isLineup) {
    let tPos = []
    let tCol = []
    let ti = 0
    while (ti < bodies.length) {
      let tb = bodies[ti]
      if (tb.alive && tb.trail && tb.trail.length >= 3) {
        let rgb = hexToRgbUnit(tb.color)
        let tr = tb.trail
        let nPts = Math.floor(tr.length / 3)
        let pIdx = 0
        while (pIdx < nPts) {
          let fade = 0.22 + 0.78 * (pIdx / Math.max(1, nPts - 1))
          let base = pIdx * 3
          tPos.push(
            (tr[base] - ox) * AU_TO_SCENE,
            (tr[base + 1] - oy) * AU_TO_SCENE,
            (tr[base + 2] - oz) * AU_TO_SCENE
          )
          tCol.push(rgb[0] * fade, rgb[1] * fade, rgb[2] * fade)
          pIdx = pIdx + 1
        }
      }
      ti = ti + 1
    }
    if (tPos.length >= 3) {
      objs.push({
        id: "nbody-wake-trails",
        type: "particles",
        particlePositions: tPos,
        particleColors: tCol,
        particleSize: scaleMode === "true_1to1" ? 0.035 : 0.16,
        particleShape: "round",
        opacity: 0.85,
        fog: false,
        pickable: false
      })
    }
  }

  // 6. 3D Expanding Impact Shockwave Rings (`impact-ring.glb`)
  if (!isLineup && shockwaves.length > 0) {
    let wi = 0
    while (wi < shockwaves.length) {
      let sw = shockwaves[wi]
      objs.push({
        id: sw.id,
        type: "model",
        modelUrl: "assets/models/impact-ring.glb",
        position: {
          x: (sw.x - ox) * AU_TO_SCENE,
          y: (sw.y - oy) * AU_TO_SCENE,
          z: (sw.z - oz) * AU_TO_SCENE
        },
        rotation: { x: 0.0, y: simVisualClock * 1.8, z: 0.0 },
        scale: Math.max(0.05, sw.radiusAU * AU_TO_SCENE),
        opacity: clampVal(sw.life, 0.05, 0.95),
        pickable: false
      })
      wi = wi + 1
    }
  }

  // 7. Incandescent Ejecta Debris Cloud (`particles`)
  if (!isLineup && ejectaDebris.length > 0) {
    let ePos = []
    let eCol = []
    let di = 0
    while (di < ejectaDebris.length) {
      let d = ejectaDebris[di]
      let rgb = hexToRgbUnit(d.color)
      ePos.push(
        (d.x - ox) * AU_TO_SCENE,
        (d.y - oy) * AU_TO_SCENE,
        (d.z - oz) * AU_TO_SCENE
      )
      eCol.push(rgb[0] * d.life, rgb[1] * d.life, rgb[2] * d.life)
      di = di + 1
    }
    objs.push({
      id: "impact-ejecta-cloud",
      type: "particles",
      particlePositions: ePos,
      particleColors: eCol,
      particleSize: 0.24,
      particleShape: "soft",
      opacity: 0.92,
      fog: false,
      pickable: false
    })
  }

  // 8. Expanding Planetary Nebula Shell (when Sun sheds its envelope to become a White Dwarf or Supernova!)
  if (!isLineup && nebulaShellAlpha > 0.01) {
    let sol = getBodyById("sol")
    let nx = ((sol ? sol.x : 0.0) - ox) * AU_TO_SCENE
    let ny = ((sol ? sol.y : 0.0) - oy) * AU_TO_SCENE
    let nz = ((sol ? sol.z : 0.0) - oz) * AU_TO_SCENE
    let nebR = Math.max(0.5, nebulaShellRadiusAU * AU_TO_SCENE)
    objs.push({
      id: "planetary-nebula-outer",
      type: "sphere",
      radius: nebR,
      position: { x: nx, y: ny, z: nz },
      color: "#38bdf8",
      emissive: "#22d3ee",
      emissiveIntensity: 2.1,
      opacity: nebulaShellAlpha * 0.24,
      doubleSided: true,
      pickable: false
    })
    objs.push({
      id: "planetary-nebula-inner",
      type: "sphere",
      radius: nebR * 0.72,
      position: { x: nx, y: ny, z: nz },
      color: "#f472b6",
      emissive: "#e879f9",
      emissiveIntensity: 1.8,
      opacity: nebulaShellAlpha * 0.18,
      doubleSided: true,
      pickable: false
    })
  }

  sceneObjects = objs
  anchorItems = nextAnchors
}
