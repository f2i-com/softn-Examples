// Solar Simulator — 4th-Order Yoshida Symplectic N-Body Integrator,
// Keplerian <-> Cartesian Ephemeris, Stellar Evolution, Asteroid Impacts & Chaos Metrics.

// Yoshida (1990) 4th-Order Symplectic Integrator Constants
let _CBRT2 = Math.pow(2.0, 1.0 / 3.0)
let _YOSH_W1 = 1.0 / (2.0 - _CBRT2)
let _YOSH_W0 = -_CBRT2 * _YOSH_W1
let _YOSH_C1 = _YOSH_W1 * 0.5
let _YOSH_C2 = (_YOSH_W0 + _YOSH_W1) * 0.5
let _YOSH_D1 = _YOSH_W1
let _YOSH_D2 = _YOSH_W0

// Live Simulation State
let bodies = []
let beltAsteroids = []
let shockwaves = []
let ejectaDebris = []
let eventLog = []
let simTimeYears = 0.0
let timeWarpYrPerSec = 1.0
let paused = false
let activeScenarioId = "j2000_accurate"
let chaosIndex = 0.0
let initialSystemEnergy = 0.0
let currentSystemEnergy = 0.0
let energyDriftPct = 0.0
let closeEncounterCount = 0
let engulfedCount = 0
let ejectedCount = 0

// Stellar Evolution State (for Primary Sun `sol`)
let stellarStageId = "main_sequence"
let stellarEvoActive = false
let stellarEvoProgress = 0.0
let nebulaShellRadiusAU = 0.0
let nebulaShellAlpha = 0.0

// Last Kinetic Impact Telemetry Report
let lastImpactReport = null
let _nextImpactorSeq = 1
let _nextStarSeq = 2
let _trailSampleAccumYr = 0.0

// Deterministic PRNG for belt & debris placement
let _rngState = 133742
function simRand() {
  _rngState = (_rngState * 1664525 + 1013904223) % 4294967296
  return _rngState / 4294967296
}

function pushSimEvent(kind, text) {
  let yrStr = simTimeYears < 10.0 ? (Math.round(simTimeYears * 100) / 100) + " yr" : Math.round(simTimeYears * 10) / 10 + " yr"
  let entry = {
    id: "ev-" + eventLog.length + "-" + Math.round(simTimeYears * 1000),
    kind: kind,
    timeLabel: "T+" + yrStr,
    text: text
  }
  eventLog = [entry].concat(eventLog.slice(0, 17))
}

function clampVal(v, lo, hi) {
  if (v < lo) { return lo }
  if (v > hi) { return hi }
  return v
}

// Solve Kepler's Equation M = E - e*sin(E) via Newton-Raphson
function solveKeplerE(meanAnomRad, ecc) {
  let e = clampVal(ecc, 0.0, 0.992)
  let M = meanAnomRad % (2.0 * Math.PI)
  if (M < -Math.PI) { M = M + 2.0 * Math.PI }
  if (M > Math.PI) { M = M - 2.0 * Math.PI }
  let E = e < 0.8 ? M : (M >= 0.0 ? Math.PI : -Math.PI)
  let iter = 0
  while (iter < 7) {
    let f = E - e * Math.sin(E) - M
    let fp = 1.0 - e * Math.cos(E)
    E = E - f / Math.max(1e-8, fp)
    iter = iter + 1
  }
  return E
}

// Convert 3D Keplerian Elements (AU, radians) around central parameter mu = G*(M+m)
// into right-handed scene-aligned AU state vectors (x = X_ecl, y = Z_ecl, z = -Y_ecl)
function keplerToCartesian(a, ecc, iDeg, omegaNodeDeg, argPeriDeg, meanAnomDeg, mu) {
  let aSafe = Math.max(0.002, a)
  let eSafe = clampVal(ecc, 0.0, 0.985)
  let inc = iDeg * DEG_TO_RAD
  let node = omegaNodeDeg * DEG_TO_RAD
  let peri = argPeriDeg * DEG_TO_RAD
  let M = meanAnomDeg * DEG_TO_RAD

  let E = solveKeplerE(M, eSafe)
  let cosE = Math.cos(E)
  let sinE = Math.sin(E)
  let sqrtOneMinusE2 = Math.sqrt(Math.max(1e-8, 1.0 - eSafe * eSafe))

  let p = aSafe * (cosE - eSafe)
  let q = aSafe * sqrtOneMinusE2 * sinE
  let r = aSafe * (1.0 - eSafe * cosE)
  let n = Math.sqrt(Math.max(1e-12, mu) / (aSafe * aSafe * aSafe))
  let dp = -(n * aSafe * aSafe / Math.max(1e-8, r)) * sinE
  let dq = (n * aSafe * aSafe * sqrtOneMinusE2 / Math.max(1e-8, r)) * cosE

  let cO = Math.cos(node)
  let sO = Math.sin(node)
  let cw = Math.cos(peri)
  let sw = Math.sin(peri)
  let ci = Math.cos(inc)
  let si = Math.sin(inc)

  // Ecliptic basis vectors P_hat (periapsis) & Q_hat
  let Px_ecl = cO * cw - sO * sw * ci
  let Py_ecl = sO * cw + cO * sw * ci
  let Pz_ecl = sw * si

  let Qx_ecl = -cO * sw - sO * cw * ci
  let Qy_ecl = -sO * sw + cO * cw * ci
  let Qz_ecl = cw * si

  // Right-handed mapping: (x, y, z) = (X_ecl, Z_ecl, -Y_ecl)
  let Px = Px_ecl
  let Py = Pz_ecl
  let Pz = -Py_ecl

  let Qx = Qx_ecl
  let Qy = Qz_ecl
  let Qz = -Qy_ecl

  return {
    x: p * Px + q * Qx,
    y: p * Py + q * Qy,
    z: p * Pz + q * Qz,
    vx: dp * Px + dq * Qx,
    vy: dp * Py + dq * Qy,
    vz: dp * Pz + dq * Qz
  }
}

// Compute Stellar Barycenter (position, velocity, total mass & total luminosity)
function getStellarBarycenter() {
  let mx = 0.0
  let my = 0.0
  let mz = 0.0
  let mvx = 0.0
  let mvy = 0.0
  let mvz = 0.0
  let mTot = 0.0
  let lumTot = 0.0
  let starCount = 0
  let i = 0
  while (i < bodies.length) {
    let b = bodies[i]
    if (b.alive && b.kind === "star") {
      mx = mx + b.massMsun * b.x
      my = my + b.massMsun * b.y
      mz = mz + b.massMsun * b.z
      mvx = mvx + b.massMsun * b.vx
      mvy = mvy + b.massMsun * b.vy
      mvz = mvz + b.massMsun * b.vz
      mTot = mTot + b.massMsun
      lumTot = lumTot + (b.luminosityLsun || 0.0)
      starCount = starCount + 1
    }
    i = i + 1
  }
  if (mTot <= 1e-12) {
    return { x: 0, y: 0, z: 0, vx: 0, vy: 0, vz: 0, massMsun: 0.0, lumLsun: 0.0, count: 0 }
  }
  return {
    x: mx / mTot,
    y: my / mTot,
    z: mz / mTot,
    vx: mvx / mTot,
    vy: mvy / mTot,
    vz: mvz / mTot,
    massMsun: mTot,
    lumLsun: lumTot,
    count: starCount
  }
}

// Choose best gravitational reference for osculating orbital elements of `body`:
// tests each individual star AND (for multi-star systems) the combined stellar barycenter,
// returning whichever yields the deepest negative specific orbital energy.
function getReferenceFrameForBody(body) {
  let stars = []
  let i = 0
  while (i < bodies.length) {
    let s = bodies[i]
    if (s.alive && s.kind === "star" && s.id !== body.id) {
      stars.push(s)
    }
    i = i + 1
  }
  if (stars.length === 0) {
    return null
  }
  if (stars.length === 1) {
    let s0 = stars[0]
    return {
      name: s0.name,
      x: s0.x,
      y: s0.y,
      z: s0.z,
      vx: s0.vx,
      vy: s0.vy,
      vz: s0.vz,
      massMsun: s0.massMsun
    }
  }

  let bary = getStellarBarycenter()
  // Subtract `body` itself if `body` is one of the stars!
  let candidates = []
  if (body.kind !== "star" && bary.massMsun > 0.0) {
    candidates.push({
      name: "Stellar Barycenter",
      x: bary.x,
      y: bary.y,
      z: bary.z,
      vx: bary.vx,
      vy: bary.vy,
      vz: bary.vz,
      massMsun: bary.massMsun
    })
  }
  let k = 0
  while (k < stars.length) {
    let st = stars[k]
    candidates.push({
      name: st.name,
      x: st.x,
      y: st.y,
      z: st.z,
      vx: st.vx,
      vy: st.vy,
      vz: st.vz,
      massMsun: st.massMsun
    })
    k = k + 1
  }

  let best = candidates[0]
  let bestEps = 1e30
  let ci = 0
  while (ci < candidates.length) {
    let c = candidates[ci]
    let dx = body.x - c.x
    let dy = body.y - c.y
    let dz = body.z - c.z
    let dvx = body.vx - c.vx
    let dvy = body.vy - c.vy
    let dvz = body.vz - c.vz
    let r = Math.max(1e-6, Math.sqrt(dx * dx + dy * dy + dz * dz))
    let v2 = dvx * dvx + dvy * dvy + dvz * dvz
    let mu = G_AU * (c.massMsun + body.massMsun)
    let eps = 0.5 * v2 - mu / r
    if (eps < bestEps) {
      bestEps = eps
      best = c
    }
    ci = ci + 1
  }
  return best
}

// Compute live osculating Keplerian elements from 3D state vectors (r, v)
function computeOsculatingElements(body) {
  let ref = getReferenceFrameForBody(body)
  if (!ref || ref.massMsun <= 1e-12) {
    let spd0 = Math.sqrt(body.vx * body.vx + body.vy * body.vy + body.vz * body.vz) * AU_YR_TO_KMS
    return {
      bound: false,
      refName: "Inertial",
      rAU: Math.sqrt(body.x * body.x + body.y * body.y + body.z * body.z),
      speedKms: spd0,
      a: 0.0,
      e: 0.0,
      iDeg: 0.0,
      omegaNodeDeg: 0.0,
      argPeriDeg: 0.0,
      meanAnomDeg: 0.0,
      periodYr: 0.0,
      periAU: 0.0,
      apheAU: 0.0,
      Px: 1, Py: 0, Pz: 0,
      Qx: 0, Qy: 0, Qz: -1,
      refX: 0, refY: 0, refZ: 0
    }
  }

  let rx = body.x - ref.x
  let ry = body.y - ref.y
  let rz = body.z - ref.z
  let vx = body.vx - ref.vx
  let vy = body.vy - ref.vy
  let vz = body.vz - ref.vz

  // Map back from scene (x, y, z) = (X_ecl, Z_ecl, -Y_ecl) -> Ecliptic (X=rx, Y=-rz, Z=ry)
  let X = rx
  let Y = -rz
  let Z = ry
  let VX = vx
  let VY = -vz
  let VZ = vy

  let r = Math.max(1e-8, Math.sqrt(X * X + Y * Y + Z * Z))
  let v2 = VX * VX + VY * VY + VZ * VZ
  let mu = G_AU * (ref.massMsun + body.massMsun)
  let eps = 0.5 * v2 - mu / r

  // Angular momentum H = R x V in ecliptic
  let Hx = Y * VZ - Z * VY
  let Hy = Z * VX - X * VZ
  let Hz = X * VY - Y * VX
  let H = Math.max(1e-12, Math.sqrt(Hx * Hx + Hy * Hy + Hz * Hz))

  let incRad = Math.acos(clampVal(Hz / H, -1.0, 1.0))

  // Node vector N = (-Hy, Hx, 0)
  let Nx = -Hy
  let Ny = Hx
  let N = Math.sqrt(Nx * Nx + Ny * Ny)

  // Eccentricity vector e_vec = (V x H)/mu - R/r
  let vxhX = VY * Hz - VZ * Hy
  let vxhY = VZ * Hx - VX * Hz
  let vxhZ = VX * Hy - VY * Hx
  let ex = vxhX / mu - X / r
  let ey = vxhY / mu - Y / r
  let ez = vxhZ / mu - Z / r
  let e = Math.sqrt(ex * ex + ey * ey + ez * ez)

  let omegaNode = 0.0
  if (N > 1e-10) {
    omegaNode = Math.atan2(Ny, Nx)
    if (omegaNode < 0.0) { omegaNode = omegaNode + 2.0 * Math.PI }
  }

  let argPeri = 0.0
  if (e > 1e-7) {
    if (N > 1e-10) {
      let cosW = clampVal((Nx * ex + Ny * ey) / (N * e), -1.0, 1.0)
      argPeri = Math.acos(cosW)
      if (ez < 0.0) { argPeri = 2.0 * Math.PI - argPeri }
    } else {
      argPeri = Math.atan2(ey, ex)
      if (Hz < 0.0) { argPeri = -argPeri }
    }
  }

  let trueAnom = 0.0
  if (e > 1e-7) {
    let cosNu = clampVal((ex * X + ey * Y + ez * Z) / (e * r), -1.0, 1.0)
    trueAnom = Math.acos(cosNu)
    if (X * VX + Y * VY + Z * VZ < 0.0) {
      trueAnom = 2.0 * Math.PI - trueAnom
    }
  } else {
    trueAnom = Math.atan2(Y, X) - omegaNode
  }

  let bound = eps < -1e-7 && e < 0.998
  let a = bound ? (-mu / (2.0 * eps)) : (Math.abs(eps) > 1e-8 ? (-mu / (2.0 * eps)) : r)
  let periodYr = bound ? (2.0 * Math.PI * Math.sqrt((a * a * a) / mu)) : 0.0

  // Eccentric & Mean Anomaly for smooth in-phase orbit editing
  let meanAnom = trueAnom
  if (bound && e < 0.998) {
    let cosE = clampVal((e + Math.cos(trueAnom)) / (1.0 + e * Math.cos(trueAnom)), -1.0, 1.0)
    let sinE = (Math.sqrt(Math.max(0.0, 1.0 - e * e)) * Math.sin(trueAnom)) / (1.0 + e * Math.cos(trueAnom))
    let E = Math.atan2(sinE, cosE)
    meanAnom = E - e * Math.sin(E)
    if (meanAnom < 0.0) { meanAnom = meanAnom + 2.0 * Math.PI }
  }

  // Unit basis vectors P_hat (toward periapsis) and Q_hat in scene (x, y, z) coordinates
  let Px = 1.0
  let Py = 0.0
  let Pz = 0.0
  if (e > 1e-6) {
    Px = ex / e
    Py = ez / e
    Pz = -ey / e
  } else {
    Px = rx / r
    Py = ry / r
    Pz = rz / r
  }
  // H_hat in scene coords = (Hx, Hz, -Hy) / H
  let hxS = Hx / H
  let hyS = Hz / H
  let hzS = -Hy / H
  // Q_hat = H_hat x P_hat (right-handed in scene coords)
  let Qx = hyS * Pz - hzS * Py
  let Qy = hzS * Px - hxS * Pz
  let Qz = hxS * Py - hyS * Px

  return {
    bound: bound,
    refName: ref.name,
    rAU: r,
    speedKms: Math.sqrt(v2) * AU_YR_TO_KMS,
    a: bound ? a : 0.0,
    e: e,
    iDeg: incRad * RAD_TO_DEG,
    omegaNodeDeg: omegaNode * RAD_TO_DEG,
    argPeriDeg: argPeri * RAD_TO_DEG,
    meanAnomDeg: meanAnom * RAD_TO_DEG,
    periodYr: periodYr,
    periAU: bound ? a * (1.0 - e) : r,
    apheAU: bound ? a * (1.0 + e) : 0.0,
    Px: Px, Py: Py, Pz: Pz,
    Qx: Qx, Qy: Qy, Qz: Qz,
    Hx: hxS, Hy: hyS, Hz: hzS,
    refX: ref.x, refY: ref.y, refZ: ref.z
  }
}

// Compute planet equilibrium & surface temperature from all active stars + residual impact magma heat
function updateBodyTemperatures(dtYears) {
  let stars = []
  let i = 0
  while (i < bodies.length) {
    let b = bodies[i]
    if (b.alive && b.kind === "star") {
      stars.push(b)
    }
    i = i + 1
  }

  let k = 0
  while (k < bodies.length) {
    let p = bodies[k]
    if (p.alive && p.kind !== "star") {
      let fluxS0 = 0.0
      let si = 0
      while (si < stars.length) {
        let st = stars[si]
        let dx = p.x - st.x
        let dy = p.y - st.y
        let dz = p.z - st.z
        let r2 = Math.max(1e-5, dx * dx + dy * dy + dz * dz)
        fluxS0 = fluxS0 + (st.luminosityLsun || 0.0) / r2
        si = si + 1
      }
      let alb = clampVal(p.albedo || 0.25, 0.0, 0.95)
      let tEq = fluxS0 > 0.0 ? (278.5 * Math.pow((1.0 - alb) * fluxS0, 0.25)) : 32.0

      // Cool residual impact magma heat radiatively over decades
      if (p.magmaTempK > 10.0 && dtYears > 0.0) {
        p.magmaTempK = p.magmaTempK * Math.exp(-dtYears * 0.35)
        if (p.magmaTempK < 15.0) { p.magmaTempK = 0.0 }
      }

      // Evaporate atmosphere if scorched > 900 K
      let gh = p.greenhouseK || 0.0
      if (tEq > 950.0 && p.kind === "rocky") {
        gh = gh * 0.25
      }
      let tCombined = Math.pow(Math.pow(tEq, 4) + Math.pow(p.magmaTempK || 0.0, 4), 0.25) + gh
      p.tempK = Math.round(tCombined)
      p.fluxS0 = fluxS0
    }
    k = k + 1
  }
}

// Shift entire system so Center of Mass is at (0,0,0) with zero net drift velocity
function zeroSystemBarycenter() {
  let mx = 0.0
  let my = 0.0
  let mz = 0.0
  let mvx = 0.0
  let mvy = 0.0
  let mvz = 0.0
  let mTot = 0.0
  let i = 0
  while (i < bodies.length) {
    let b = bodies[i]
    if (b.alive && b.kind !== "impactor") {
      mx = mx + b.massMsun * b.x
      my = my + b.massMsun * b.y
      mz = mz + b.massMsun * b.z
      mvx = mvx + b.massMsun * b.vx
      mvy = mvy + b.massMsun * b.vy
      mvz = mvz + b.massMsun * b.vz
      mTot = mTot + b.massMsun
    }
    i = i + 1
  }
  if (mTot <= 1e-14) { return }
  let cx = mx / mTot
  let cy = my / mTot
  let cz = mz / mTot
  let cvx = mvx / mTot
  let cvy = mvy / mTot
  let cvz = mvz / mTot

  let j = 0
  while (j < bodies.length) {
    let b = bodies[j]
    if (b.alive) {
      b.x = b.x - cx
      b.y = b.y - cy
      b.z = b.z - cz
      b.vx = b.vx - cvx
      b.vy = b.vy - cvy
      b.vz = b.vz - cvz
    }
    j = j + 1
  }
}

// Compute Total Mechanical Energy E = K + U (in M_sun * AU^2 / yr^2)
function computeSystemMechanicalEnergy() {
  let K = 0.0
  let U = 0.0
  let n = bodies.length
  let i = 0
  while (i < n) {
    let bi = bodies[i]
    if (bi.alive && bi.kind !== "impactor") {
      let v2 = bi.vx * bi.vx + bi.vy * bi.vy + bi.vz * bi.vz
      K = K + 0.5 * bi.massMsun * v2
      let j = i + 1
      while (j < n) {
        let bj = bodies[j]
        if (bj.alive && bj.kind !== "impactor") {
          let dx = bj.x - bi.x
          let dy = bj.y - bi.y
          let dz = bj.z - bi.z
          let r = Math.max(1e-5, Math.sqrt(dx * dx + dy * dy + dz * dz))
          U = U - (G_AU * bi.massMsun * bj.massMsun) / r
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  return K + U
}

// Populate 220 Dynamically Gravitating Main-Belt & Kuiper-Belt Asteroids
function initAsteroidBelt(innerMinAU, innerMaxAU, countMain, countKuiper) {
  beltAsteroids = []
  let bary = getStellarBarycenter()
  let mCenter = Math.max(0.25, bary.massMsun)
  let mu = G_AU * mCenter

  let k = 0
  while (k < countMain) {
    // Avoid 3:1 (2.50 AU) & 2:1 (3.28 AU) Kirkwood gaps slightly for realism!
    let a = innerMinAU + simRand() * (innerMaxAU - innerMinAU)
    if (Math.abs(a - 2.50) < 0.04) { a = a + 0.07 }
    let e = 0.02 + simRand() * 0.14
    let inc = (simRand() - 0.5) * 16.0
    let node = simRand() * 360.0
    let peri = simRand() * 360.0
    let M = simRand() * 360.0
    let st = keplerToCartesian(a, e, inc, node, peri, M, mu)
    beltAsteroids.push({
      x: bary.x + st.x,
      y: bary.y + st.y,
      z: bary.z + st.z,
      vx: bary.vx + st.vx,
      vy: bary.vy + st.vy,
      vz: bary.vz + st.vz,
      ax: 0, ay: 0, az: 0,
      rot: simRand() * 6.28,
      scale: 0.65 + simRand() * 0.85,
      pal: k % 3,
      alive: true
    })
    k = k + 1
  }

  let kp = 0
  while (kp < countKuiper) {
    let a = 33.0 + simRand() * 14.0
    let e = 0.03 + simRand() * 0.18
    let inc = (simRand() - 0.5) * 22.0
    let st = keplerToCartesian(a, e, inc, simRand() * 360.0, simRand() * 360.0, simRand() * 360.0, mu)
    beltAsteroids.push({
      x: bary.x + st.x,
      y: bary.y + st.y,
      z: bary.z + st.z,
      vx: bary.vx + st.vx,
      vy: bary.vy + st.vy,
      vz: bary.vz + st.vz,
      ax: 0, ay: 0, az: 0,
      rot: simRand() * 6.28,
      scale: 0.85 + simRand() * 0.95,
      pal: 3,
      alive: true
    })
    kp = kp + 1
  }
}

function makeBodyFromTemplate(tpl) {
  return {
    id: tpl.id,
    name: tpl.name,
    kind: tpl.kind,
    spectral: tpl.spectral || "",
    modelUrl: tpl.modelUrl,
    color: tpl.color,
    photoHex: tpl.photoHex || tpl.color,
    chromoHex: tpl.chromoHex || tpl.coronaColor || "#f97316",
    flareHex: tpl.flareHex || "#fb923c",
    massMsun: tpl.massMsun,
    baseMassMsun: tpl.massMsun,
    radiusKm: tpl.radiusKm,
    radiusAU: tpl.radiusKm / AU_KM,
    luminosityLsun: tpl.luminosityLsun || 0.0,
    tempK: tpl.tempK || 255,
    magmaTempK: 0.0,
    fluxS0: 1.0,
    obliquityDeg: tpl.obliquityDeg || 0.0,
    rotPeriodDays: tpl.rotPeriodDays || 1.0,
    albedo: tpl.albedo !== undefined ? tpl.albedo : 0.25,
    greenhouseK: tpl.greenhouseK || 0.0,
    densityGcm3: tpl.densityGcm3 || 3.5,
    hasMoon: Boolean(tpl.hasMoon),
    hasDebrisRing: false,
    hasClouds: Boolean(tpl.hasClouds),
    hasRings: Boolean(tpl.hasRings),
    initA: tpl.a || 0.0,
    initE: tpl.e || 0.0,
    x: 0.0, y: 0.0, z: 0.0,
    vx: 0.0, vy: 0.0, vz: 0.0,
    ax: 0.0, ay: 0.0, az: 0.0,
    spinAngle: 0.0,
    alive: true,
    status: "stable",
    trail: []
  }
}

// Initialize Any of the 6 Curated Scenarios!
function loadScenarioPreset(scenarioId) {
  activeScenarioId = scenarioId
  simTimeYears = 0.0
  chaosIndex = 0.0
  closeEncounterCount = 0
  engulfedCount = 0
  ejectedCount = 0
  stellarStageId = "main_sequence"
  stellarEvoActive = false
  stellarEvoProgress = 0.0
  nebulaShellRadiusAU = 0.0
  nebulaShellAlpha = 0.0
  shockwaves = []
  ejectaDebris = []
  eventLog = []
  _rngState = 133742
  _nextStarSeq = 2

  bodies = []

  if (scenarioId === "triple_trisolaris") {
    // Non-hierarchical Chaotic 3-Body System ("Trisolaris") + Habitable Rocky World
    let sA = makeBodyFromTemplate(J2000_SOLAR_BODIES[0])
    sA.id = "sol"
    sA.name = "Alpha Solaris"
    sA.massMsun = 0.86
    sA.baseMassMsun = 0.86
    sA.radiusKm = 640000.0
    sA.radiusAU = 640000.0 / AU_KM
    sA.luminosityLsun = 0.68
    sA.photoHex = "#fde047"
    sA.x = -1.18; sA.y = 0.08; sA.z = 0.42
    sA.vx = 0.95; sA.vy = 0.14; sA.vz = -2.35

    let sB = makeBodyFromTemplate(J2000_SOLAR_BODIES[0])
    sB.id = "star_b"
    sB.name = "Beta Ignis"
    sB.spectral = "K1V"
    sB.color = "#fb923c"
    sB.photoHex = "#fb923c"
    sB.chromoHex = "#ea580c"
    sB.massMsun = 0.76
    sB.baseMassMsun = 0.76
    sB.radiusKm = 580000.0
    sB.radiusAU = 580000.0 / AU_KM
    sB.luminosityLsun = 0.44
    sB.tempK = 5150
    sB.x = 1.26; sB.y = -0.10; sB.z = 0.36
    sB.vx = 0.82; sB.vy = -0.18; sB.vz = 2.48

    let sC = makeBodyFromTemplate(J2000_SOLAR_BODIES[0])
    sC.id = "star_c"
    sC.name = "Gamma Rubra"
    sC.spectral = "M1V"
    sC.color = "#f87171"
    sC.photoHex = "#f87171"
    sC.chromoHex = "#dc2626"
    sC.massMsun = 0.64
    sC.baseMassMsun = 0.64
    sC.radiusKm = 430000.0
    sC.radiusAU = 430000.0 / AU_KM
    sC.luminosityLsun = 0.12
    sC.tempK = 3720
    sC.x = 0.05; sC.y = 0.22; sC.z = -1.65
    sC.vx = -2.15; sC.vy = 0.06; sC.vz = 0.15

    // Planet "Trisolaris" initially orbiting Alpha Solaris, soon shared chaotically!
    let tri = makeBodyFromTemplate(J2000_SOLAR_BODIES[3])
    tri.id = "earth"
    tri.name = "Trisolaris (Earth)"
    tri.x = sA.x + 0.56
    tri.y = sA.y + 0.02
    tri.z = sA.z
    tri.vx = sA.vx
    tri.vy = sA.vy + 0.35
    tri.vz = sA.vz - Math.sqrt((G_AU * sA.massMsun) / 0.56)

    // Distant outer ice giant witness
    let outGiant = makeBodyFromTemplate(J2000_SOLAR_BODIES[8])
    let stG = keplerToCartesian(9.5, 0.08, 6.0, 40.0, 20.0, 110.0, G_AU * 2.26)
    outGiant.x = stG.x; outGiant.y = stG.y; outGiant.z = stG.z
    outGiant.vx = stG.vx; outGiant.vy = stG.vy; outGiant.vz = stG.vz

    bodies = [sA, sB, sC, tri, outGiant]
    _nextStarSeq = 4
    zeroSystemBarycenter()
    initAsteroidBelt(5.8, 7.2, 120, 40)
    updateBodyTemperatures(0.0)
    initialSystemEnergy = computeSystemMechanicalEnergy()
    currentSystemEnergy = initialSystemEnergy
    pushSimEvent("star", "Chaotic 3-Body System initialized! Watch Trisolaris alternate between Stable & Chaotic Eras.")
    return
  }

  // Build Sun(s) first for Solar-derived scenarios
  if (scenarioId === "binary_tatooine" || scenarioId === "triple_hierarchical") {
    // Close inner G+K binary (separation = 0.20 AU)
    let m1 = 0.68
    let m2 = 0.46
    let mBin = m1 + m2
    let aBin = 0.20
    let vRel = Math.sqrt((G_AU * mBin) / aBin)

    let s1 = makeBodyFromTemplate(J2000_SOLAR_BODIES[0])
    s1.id = "sol"
    s1.name = "Sol Alpha"
    s1.massMsun = m1
    s1.baseMassMsun = m1
    s1.radiusKm = 615000.0
    s1.radiusAU = 615000.0 / AU_KM
    s1.luminosityLsun = 0.62
    s1.x = -(m2 / mBin) * aBin
    s1.vz = (m2 / mBin) * vRel

    let s2 = makeBodyFromTemplate(J2000_SOLAR_BODIES[0])
    s2.id = "star_b"
    s2.name = "Sol Beta"
    s2.spectral = "K3V"
    s2.color = "#fb923c"
    s2.photoHex = "#fb923c"
    s2.chromoHex = "#ea580c"
    s2.massMsun = m2
    s2.baseMassMsun = m2
    s2.radiusKm = 495000.0
    s2.radiusAU = 495000.0 / AU_KM
    s2.luminosityLsun = 0.19
    s2.tempK = 4780
    s2.x = (m1 / mBin) * aBin
    s2.vz = -(m1 / mBin) * vRel

    bodies.push(s1, s2)
    _nextStarSeq = 3

    // Circumbinary planets orbiting the 1.14 M_sun pair!
    let idx = 1
    while (idx < J2000_SOLAR_BODIES.length) {
      let tpl = J2000_SOLAR_BODIES[idx]
      let pb = makeBodyFromTemplate(tpl)
      let st = keplerToCartesian(tpl.a, tpl.e, tpl.iDeg, tpl.omegaNodeDeg, tpl.argPeriDeg, tpl.meanAnomDeg, G_AU * (mBin + pb.massMsun))
      pb.x = st.x; pb.y = st.y; pb.z = st.z
      pb.vx = st.vx; pb.vy = st.vy; pb.vz = st.vz
      bodies.push(pb)
      idx = idx + 1
    }

    if (scenarioId === "triple_hierarchical") {
      // Add inclined outer 3rd Red Dwarf companion at a = 15.5 AU, e = 0.22, i = 28 deg!
      let s3 = makeBodyFromTemplate(J2000_SOLAR_BODIES[0])
      s3.id = "star_c"
      s3.name = "Proxima Tertia"
      s3.spectral = "M2V"
      s3.color = "#f87171"
      s3.photoHex = "#f87171"
      s3.chromoHex = "#dc2626"
      s3.massMsun = 0.35
      s3.baseMassMsun = 0.35
      s3.radiusKm = 265000.0
      s3.radiusAU = 265000.0 / AU_KM
      s3.luminosityLsun = 0.025
      s3.tempK = 3480
      let st3 = keplerToCartesian(15.5, 0.22, 28.0, 65.0, 40.0, 25.0, G_AU * (mBin + 0.35))
      s3.x = st3.x; s3.y = st3.y; s3.z = st3.z
      s3.vx = st3.vx; s3.vy = st3.vy; s3.vz = st3.vz
      bodies.push(s3)
      _nextStarSeq = 4
    }
  } else {
    // Standard 1-Sun J2000 Solar System (used by j2000_accurate, binary_nemesis, chaos_heavy_jupiter)
    let sol = makeBodyFromTemplate(J2000_SOLAR_BODIES[0])
    bodies.push(sol)

    let idx = 1
    while (idx < J2000_SOLAR_BODIES.length) {
      let tpl = J2000_SOLAR_BODIES[idx]
      let pb = makeBodyFromTemplate(tpl)
      if (scenarioId === "chaos_heavy_jupiter" && pb.id === "jupiter") {
        pb.massMsun = pb.massMsun * 40.0
      }
      let mu = G_AU * (sol.massMsun + pb.massMsun)
      let st = keplerToCartesian(tpl.a, tpl.e, tpl.iDeg, tpl.omegaNodeDeg, tpl.argPeriDeg, tpl.meanAnomDeg, mu)
      pb.x = st.x; pb.y = st.y; pb.z = st.z
      pb.vx = st.vx; pb.vy = st.vy; pb.vz = st.vz
      bodies.push(pb)
      idx = idx + 1
    }

    if (scenarioId === "binary_nemesis") {
      // Eccentric Red Dwarf Nemesis companion plunging from 18 AU to perihelion ~7.6 AU!
      let nem = makeBodyFromTemplate(J2000_SOLAR_BODIES[0])
      nem.id = "star_b"
      nem.name = "Nemesis (M3V)"
      nem.spectral = "M3V"
      nem.color = "#f87171"
      nem.photoHex = "#f87171"
      nem.chromoHex = "#dc2626"
      nem.massMsun = 0.38
      nem.baseMassMsun = 0.38
      nem.radiusKm = 275000.0
      nem.radiusAU = 275000.0 / AU_KM
      nem.luminosityLsun = 0.028
      nem.tempK = 3420
      let stN = keplerToCartesian(15.2, 0.50, 14.0, 210.0, 95.0, 315.0, G_AU * 1.38)
      nem.x = stN.x; nem.y = stN.y; nem.z = stN.z
      nem.vx = stN.vx; nem.vy = stN.vy; nem.vz = stN.vz
      bodies.push(nem)
      _nextStarSeq = 3
    }
  }

  zeroSystemBarycenter()
  initAsteroidBelt(2.15, 3.25, 165, 55)
  updateBodyTemperatures(0.0)
  initialSystemEnergy = computeSystemMechanicalEnergy()
  currentSystemEnergy = initialSystemEnergy
  energyDriftPct = 0.0

  if (scenarioId === "j2000_accurate") {
    pushSimEvent("info", "NASA J2000 Solar System loaded to exact 1:1 AU & M☉ scale.")
  } else if (scenarioId === "binary_tatooine") {
    pushSimEvent("star", "Circumbinary 'Tatooine' pair active! Watch Mercury test the binary stability limit.")
  } else if (scenarioId === "binary_nemesis") {
    pushSimEvent("warn", "Red Dwarf 'Nemesis' inbound on eccentric 7.6 AU perihelion — gas giant scattering imminent!")
  } else if (scenarioId === "triple_hierarchical") {
    pushSimEvent("star", "3-Sun Hierarchical Triple active: inner binary + inclined Proxima Tertia.")
  } else if (scenarioId === "chaos_heavy_jupiter") {
    pushSimEvent("warn", "Jupiter mass boosted 40x (0.038 M☉)! Inner planet secular chaos underway.")
  }
}

function getBodyById(id) {
  let i = 0
  while (i < bodies.length) {
    if (bodies[i].id === id) { return bodies[i] }
    i = i + 1
  }
  return null
}

function countAliveStars() {
  let c = 0
  let i = 0
  while (i < bodies.length) {
    if (bodies[i].alive && bodies[i].kind === "star") { c = c + 1 }
    i = i + 1
  }
  return c
}

// Live Add 2nd or 3rd Companion Sun into Current Running Simulation!
function spawnCompanionStar(templateId, semiMajorAU, eccentricity, inclinationDeg) {
  let tpl = STAR_TEMPLATES[0]
  let i = 0
  while (i < STAR_TEMPLATES.length) {
    if (STAR_TEMPLATES[i].id === templateId) { tpl = STAR_TEMPLATES[i] }
    i = i + 1
  }

  let bary = getStellarBarycenter()
  let a = clampVal(semiMajorAU, 0.22, 36.0)
  let ecc = clampVal(eccentricity, 0.0, 0.78)
  let inc = clampVal(inclinationDeg, -85.0, 85.0)
  let mu = G_AU * Math.max(0.2, bary.massMsun + tpl.massMsun)
  let phaseDeg = (simRand() * 360.0)

  let st = keplerToCartesian(a, ecc, inc, 35.0 * _nextStarSeq, 20.0, phaseDeg, mu)
  let star = makeBodyFromTemplate(J2000_SOLAR_BODIES[0])
  let tag = _nextStarSeq === 2 ? "Beta" : (_nextStarSeq === 3 ? "Gamma" : ("Star " + _nextStarSeq))
  star.id = "star_" + _nextStarSeq + "_" + Math.round(simTimeYears * 100)
  star.name = "Sol " + tag + " (" + tpl.spectral + ")"
  star.spectral = tpl.spectral
  star.color = tpl.photoHex
  star.photoHex = tpl.photoHex
  star.chromoHex = tpl.chromoHex
  star.flareHex = tpl.flareHex
  star.massMsun = tpl.massMsun
  star.baseMassMsun = tpl.massMsun
  star.radiusKm = tpl.radiusRsun * R_SUN_KM
  star.radiusAU = star.radiusKm / AU_KM
  star.luminosityLsun = tpl.luminosityLsun
  star.tempK = tpl.tempK
  star.x = bary.x + st.x
  star.y = bary.y + st.y
  star.z = bary.z + st.z
  star.vx = bary.vx + st.vx
  star.vy = bary.vy + st.vy
  star.vz = bary.vz + st.vz

  _nextStarSeq = _nextStarSeq + 1
  bodies.push(star)
  zeroSystemBarycenter()
  updateBodyTemperatures(0.0)
  initialSystemEnergy = computeSystemMechanicalEnergy()

  shockwaves.push({
    id: "sw-star-" + _nextStarSeq,
    x: star.x, y: star.y, z: star.z,
    radiusAU: 0.04,
    maxRadiusAU: 1.4,
    life: 1.0,
    color: tpl.photoHex
  })
  playSfx("spawn_star", 0.72)
  pushSimEvent("star", "Spawned " + star.name + " (" + tpl.massMsun + " M☉) at a = " + (Math.round(a * 100) / 100) + " AU!")
  return star.id
}

// Perturb / Edit Any Planet's Orbital Elements (a, e, i) Live in Place!
function modifyBodyOrbitElements(bodyId, newA, newE, newIDeg) {
  let b = getBodyById(bodyId)
  if (!b || !b.alive || b.kind === "star") { return false }
  let ref = getReferenceFrameForBody(b)
  if (!ref || ref.massMsun <= 1e-12) { return false }

  let cur = computeOsculatingElements(b)
  let aUse = newA !== null && newA !== undefined ? clampVal(newA, 0.06, 65.0) : Math.max(0.1, cur.a || cur.rAU)
  let eUse = newE !== null && newE !== undefined ? clampVal(newE, 0.0, 0.94) : clampVal(cur.e, 0.0, 0.94)
  let iUse = newIDeg !== null && newIDeg !== undefined ? clampVal(newIDeg, 0.0, 180.0) : cur.iDeg

  let mu = G_AU * (ref.massMsun + b.massMsun)
  let st = keplerToCartesian(aUse, eUse, iUse, cur.omegaNodeDeg, cur.argPeriDeg, cur.meanAnomDeg, mu)
  b.x = ref.x + st.x
  b.y = ref.y + st.y
  b.z = ref.z + st.z
  b.vx = ref.vx + st.vx
  b.vy = ref.vy + st.vy
  b.vz = ref.vz + st.vz
  b.trail = []
  initialSystemEnergy = computeSystemMechanicalEnergy()
  return true
}

// Apply Prograde / Retrograde / Radial Velocity Impulse (Multiplier or Delta-v km/s)
function nudgeBodyVelocity(bodyId, progradePct, radialKms) {
  let b = getBodyById(bodyId)
  if (!b || !b.alive) { return false }
  let ref = getReferenceFrameForBody(b)
  let refVx = ref ? ref.vx : 0.0
  let refVy = ref ? ref.vy : 0.0
  let refVz = ref ? ref.vz : 0.0
  let rvx = b.vx - refVx
  let rvy = b.vy - refVy
  let rvz = b.vz - refVz

  let mult = 1.0 + progradePct
  rvx = rvx * mult
  rvy = rvy * mult
  rvz = rvz * mult

  if (Math.abs(radialKms) > 0.001 && ref) {
    let dx = b.x - ref.x
    let dy = b.y - ref.y
    let dz = b.z - ref.z
    let r = Math.max(1e-6, Math.sqrt(dx * dx + dy * dy + dz * dz))
    let dvAUYr = radialKms / AU_YR_TO_KMS
    rvx = rvx + (dx / r) * dvAUYr
    rvy = rvy + (dy / r) * dvAUYr
    rvz = rvz + (dz / r) * dvAUYr
  }

  b.vx = refVx + rvx
  b.vy = refVy + rvy
  b.vz = refVz + rvz
  initialSystemEnergy = computeSystemMechanicalEnergy()
  playSfx("click", 0.5)
  pushSimEvent("orbit", b.name + " velocity nudged (" + (progradePct >= 0 ? "+" : "") + Math.round(progradePct * 100) + "% prograde).")
  return true
}

function flipBodyRetrograde(bodyId) {
  let b = getBodyById(bodyId)
  if (!b || !b.alive || b.kind === "star") { return false }
  let ref = getReferenceFrameForBody(b)
  if (!ref) { return false }
  b.vx = ref.vx - (b.vx - ref.vx)
  b.vy = ref.vy - (b.vy - ref.vy)
  b.vz = ref.vz - (b.vz - ref.vz)
  b.trail = []
  initialSystemEnergy = computeSystemMechanicalEnergy()
  playSfx("flyby_alert", 0.58)
  pushSimEvent("warn", b.name + " flipped into a RETROGRADE orbit — watch close-encounter chaos!")
  return true
}

// Stellar Evolution Stage Application & Smooth Animated Red Giant Track
function applyStellarStageObject(sol, stg) {
  sol.spectral = stg.spectral
  sol.massMsun = stg.massMsun
  sol.radiusKm = stg.radiusRsun * R_SUN_KM
  sol.radiusAU = sol.radiusKm / AU_KM
  sol.luminosityLsun = stg.luminosityLsun
  sol.tempK = stg.tempK
  sol.color = stg.photoHex
  sol.photoHex = stg.photoHex
  sol.chromoHex = stg.chromoHex
  sol.flareHex = stg.flareHex
}

function setSolarEvolutionStage(stageId) {
  let sol = getBodyById("sol")
  if (!sol || !sol.alive) { return false }
  let idx = 0
  let stg = STELLAR_STAGES[0]
  while (idx < STELLAR_STAGES.length) {
    if (STELLAR_STAGES[idx].id === stageId) {
      stg = STELLAR_STAGES[idx]
      stellarEvoProgress = idx / (STELLAR_STAGES.length - 1)
      break
    }
    idx = idx + 1
  }
  stellarStageId = stg.id
  stellarEvoActive = false
  applyStellarStageObject(sol, stg)

  if (stageId === "white_dwarf") {
    nebulaShellRadiusAU = 0.45
    nebulaShellAlpha = 0.92
    playSfx("supernova", 0.72)
    pushSimEvent("star", "Sun shed its envelope into a glowing Planetary Nebula, leaving a 0.54 M☉ White Dwarf!")
  } else if (stageId === "red_giant_rgb" || stageId === "red_giant_agb") {
    playSfx("red_giant", 0.74)
    pushSimEvent("star", "Sun entered " + stg.shortLabel + " (" + stg.radiusRsun + " R☉ = " + (Math.round(sol.radiusAU * 100) / 100) + " AU, " + stg.massMsun + " M☉)!")
  } else {
    playSfx("click", 0.5)
    pushSimEvent("star", "Sun set to " + stg.label + ".")
  }

  updateBodyTemperatures(0.0)
  initialSystemEnergy = computeSystemMechanicalEnergy()
  return true
}

function startAnimatedRedGiantEvolution() {
  let sol = getBodyById("sol")
  if (!sol || !sol.alive) { return false }
  // Start from Main Sequence if already at White Dwarf
  if (stellarEvoProgress >= 0.96) {
    stellarEvoProgress = 0.0
    applyStellarStageObject(sol, STELLAR_STAGES[0])
    stellarStageId = "main_sequence"
  }
  stellarEvoActive = true
  paused = false
  if (timeWarpYrPerSec < 1.0) {
    timeWarpYrPerSec = 2.0
  }
  playSfx("red_giant", 0.75)
  pushSimEvent("star", "Animated Stellar Evolution started: watch solar wind mass loss expand outer orbits while inner worlds face engulfment!")
  return true
}

// What-If Core-Collapse Supernova Sandbox Event!
function triggerSupernovaExplosion() {
  let sol = getBodyById("sol")
  if (!sol || !sol.alive) { return false }
  stellarEvoActive = false
  stellarStageId = "white_dwarf"
  // Rapidly drop central remnant mass to 0.14 M_sun neutron remnant so all outer planets unbind (e > 1)!
  sol.name = "Neutron Remnant"
  sol.spectral = "PSR"
  sol.massMsun = 0.14
  sol.radiusKm = 24.0
  sol.radiusAU = 24.0 / AU_KM
  sol.luminosityLsun = 0.08
  sol.tempK = 95000
  sol.color = "#38bdf8"
  sol.photoHex = "#bae6fd"
  sol.chromoHex = "#38bdf8"
  sol.flareHex = "#818cf8"

  nebulaShellRadiusAU = 0.25
  nebulaShellAlpha = 1.0

  shockwaves.push({
    id: "sw-supernova-" + Math.round(simTimeYears * 1000),
    x: sol.x, y: sol.y, z: sol.z,
    radiusAU: 0.15,
    maxRadiusAU: 18.0,
    life: 1.0,
    color: "#38bdf8"
  })

  // Thermal blast flash & radial radiation-pressure kick on inner planets
  let i = 0
  while (i < bodies.length) {
    let b = bodies[i]
    if (b.alive && b.id !== sol.id && b.kind !== "star") {
      let dx = b.x - sol.x
      let dy = b.y - sol.y
      let dz = b.z - sol.z
      let r = Math.max(0.05, Math.sqrt(dx * dx + dy * dy + dz * dz))
      b.magmaTempK = Math.max(b.magmaTempK, Math.min(4800.0, 2600.0 / r))
      let kick = 0.45 / (r * r)
      b.vx = b.vx + (dx / r) * kick
      b.vy = b.vy + (dy / r) * kick
      b.vz = b.vz + (dz / r) * kick
    }
    i = i + 1
  }

  paused = false
  if (timeWarpYrPerSec < 1.0) { timeWarpYrPerSec = 1.0 }
  playSfx("supernova", 0.90)
  triggerHaptic(75)
  pushSimEvent("impact", "💥 SUPERNOVA DETONATION! 86% stellar mass ejected — planets flung onto hyperbolic escape trajectories!")
  initialSystemEnergy = computeSystemMechanicalEnergy()
  return true
}

function stepStellarEvolution(dtRealSec) {
  if (nebulaShellAlpha > 0.005) {
    nebulaShellRadiusAU = nebulaShellRadiusAU + dtRealSec * 1.35
    nebulaShellAlpha = Math.max(0.0, nebulaShellAlpha - dtRealSec * 0.055)
  }
  if (!stellarEvoActive) { return }
  let sol = getBodyById("sol")
  if (!sol || !sol.alive) {
    stellarEvoActive = false
    return
  }

  // Complete full Main Sequence -> Subgiant -> RGB -> AGB -> White Dwarf track in ~26 real seconds
  let prevProg = stellarEvoProgress
  stellarEvoProgress = Math.min(1.0, stellarEvoProgress + dtRealSec * 0.038)

  let segCount = STELLAR_STAGES.length - 1
  let scaled = stellarEvoProgress * segCount
  let i0 = Math.min(segCount - 1, Math.floor(scaled))
  let i1 = i0 + 1
  let frac = scaled - i0
  let s0 = STELLAR_STAGES[i0]
  let s1 = STELLAR_STAGES[i1]

  // Log-interpolate radius & luminosity for realistic exponential giant swelling
  let rRsun = Math.exp(Math.log(Math.max(0.008, s0.radiusRsun)) * (1.0 - frac) + Math.log(Math.max(0.008, s1.radiusRsun)) * frac)
  let lum = Math.exp(Math.log(Math.max(0.01, s0.luminosityLsun)) * (1.0 - frac) + Math.log(Math.max(0.01, s1.luminosityLsun)) * frac)
  let mass = s0.massMsun + (s1.massMsun - s0.massMsun) * frac
  let temp = Math.round(s0.tempK + (s1.tempK - s0.tempK) * frac)

  let pickStage = frac < 0.5 ? s0 : s1
  if (pickStage.id !== stellarStageId) {
    stellarStageId = pickStage.id
    if (stellarStageId === "red_giant_rgb") {
      playSfx("red_giant", 0.72)
      pushSimEvent("star", "Sun entered Red Giant Branch! Solar wind is shedding mass — watch planetary orbits expand!")
    } else if (stellarStageId === "red_giant_agb") {
      playSfx("red_giant", 0.78)
      pushSimEvent("warn", "AGB Supergiant Pulse! Photosphere approaching 1.08 AU — Earth's orbit in extreme danger!")
    } else if (stellarStageId === "white_dwarf") {
      nebulaShellRadiusAU = 0.85
      nebulaShellAlpha = 0.95
      playSfx("supernova", 0.72)
      pushSimEvent("star", "Planetary Nebula ejected! Sun collapsed to a dense 0.54 M☉ White Dwarf; surviving outer worlds remain on widened orbits.")
    }
  }

  sol.spectral = pickStage.spectral
  sol.massMsun = mass
  sol.radiusKm = rRsun * R_SUN_KM
  sol.radiusAU = sol.radiusKm / AU_KM
  sol.luminosityLsun = lum
  sol.tempK = temp
  sol.color = pickStage.photoHex
  sol.photoHex = pickStage.photoHex
  sol.chromoHex = pickStage.chromoHex
  sol.flareHex = pickStage.flareHex

  if (prevProg < 1.0 && stellarEvoProgress >= 1.0) {
    stellarEvoActive = false
  }
}

// Spawn Ejecta Boulders on Giant Impacts or Planetary Disruption
function spawnEjectaCloud(cx, cy, cz, baseVx, baseVy, baseVz, count, spreadSpeedAUYr, colorHex) {
  let k = 0
  while (k < count && ejectaDebris.length < 180) {
    let u = simRand() * 2.0 - 1.0
    let phi = simRand() * 6.283185
    let s = Math.sqrt(Math.max(0.0, 1.0 - u * u))
    let sp = spreadSpeedAUYr * (0.35 + simRand() * 0.95)
    ejectaDebris.push({
      x: cx + s * Math.cos(phi) * 0.015,
      y: cy + u * 0.015,
      z: cz + s * Math.sin(phi) * 0.015,
      vx: baseVx + s * Math.cos(phi) * sp,
      vy: baseVy + u * sp * 0.65,
      vz: baseVz + s * Math.sin(phi) * sp,
      life: 1.0,
      color: colorHex
    })
    k = k + 1
  }
}

// Resolve Physical Asteroid-to-Planet Collision (Exact Momentum, Energy & Disruption Physics!)
function resolveAsteroidImpact(impactor, target) {
  impactor.alive = false
  let oldElem = computeOsculatingElements(target)

  let dvx = impactor.vx - target.vx
  let dvy = impactor.vy - target.vy
  let dvz = impactor.vz - target.vz
  let vRelAUYr = Math.sqrt(dvx * dvx + dvy * dvy + dvz * dvz)
  let vRelKms = Math.max(5.0, impactor.launchSpeedKms || (vRelAUYr * AU_YR_TO_KMS))

  // Use launch velocity direction with exact relative speed so close-intercept visuals never distort Ek
  let vDirLen = Math.max(1e-6, vRelAUYr)
  let ux = dvx / vDirLen
  let uy = dvy / vDirLen
  let uz = dvz / vDirLen
  let vRelPhysAUYr = vRelKms / AU_YR_TO_KMS

  let mImp = impactor.massMsun
  let mTarg = target.massMsun
  let mSum = mTarg + mImp

  // Reduced mass & SI Kinetic Energy vs Target Gravitational Binding Energy U_bind = 3 G M^2 / (5 R)
  let muKg = ((mTarg * mImp) / Math.max(1e-24, mSum)) * M_SUN_KG
  let vRelMs = vRelKms * 1000.0
  let ekJoules = 0.5 * muKg * vRelMs * vRelMs
  let ekMegatons = ekJoules / 4.184e15

  let G_SI = 6.67430e-11
  let mTargKg = mTarg * M_SUN_KG
  let rTargM = Math.max(10000.0, target.radiusKm * 1000.0)
  let uBindJoules = (3.0 * G_SI * mTargKg * mTargKg) / (5.0 * rTargM)
  let bindRatio = ekJoules / Math.max(1.0, uBindJoules)

  // Pi-group transient crater scaling estimate (km)
  let impDiamKm = impactor.radiusKm * 2.0
  let craterKm = Math.min(target.radiusKm * 2.0, Math.round(impDiamKm * 11.8 * Math.pow(vRelKms / 18.0, 0.44)))

  // Catastrophic Planetary Disruption when shock-partitioned Ek >= 1.85 * U_bind (Leinhardt & Stewart 2012 Q*_RD criterion)!
  if (bindRatio >= 1.85 && target.kind !== "star") {
    target.alive = false
    target.status = "shattered"
    shockwaves.push({
      id: "sw-shatter-" + Math.round(simTimeYears * 1000) + "-" + _nextImpactorSeq,
      x: target.x, y: target.y, z: target.z,
      radiusAU: 0.03,
      maxRadiusAU: 1.35,
      life: 1.0,
      color: "#e879f9"
    })
    spawnEjectaCloud(target.x, target.y, target.z, target.vx, target.vy, target.vz, 65, 1.45, "#f43f5e")

    // Add persistent rubble-field fragments into the gravitating Asteroid Belt!
    let f = 0
    while (f < 28) {
      let ang = (f / 28.0) * 6.283185
      let sp = 0.15 + simRand() * 0.45
      beltAsteroids.push({
        x: target.x + Math.cos(ang) * 0.02,
        y: target.y + (simRand() - 0.5) * 0.02,
        z: target.z + Math.sin(ang) * 0.02,
        vx: target.vx + Math.cos(ang) * sp,
        vy: target.vy + (simRand() - 0.5) * sp * 0.5,
        vz: target.vz + Math.sin(ang) * sp,
        ax: 0, ay: 0, az: 0,
        rot: simRand() * 6.28,
        scale: 1.15 + simRand() * 0.9,
        pal: 2,
        alive: true
      })
      f = f + 1
    }

    playSfx("supernova", 0.88)
    triggerHaptic(85)
    lastImpactReport = {
      targetName: target.name,
      impactorName: impactor.name,
      speedKms: Math.round(vRelKms * 10) / 10,
      energyMegatons: ekMegatons,
      bindRatioPct: Math.round(bindRatio * 1000) / 10,
      deltaVKms: Math.round((mImp / mSum) * vRelKms * 100) / 100,
      craterKm: Math.round(target.radiusKm * 2),
      oldA: Math.round(oldElem.a * 1000) / 1000,
      newA: 0.0,
      oldE: Math.round(oldElem.e * 1000) / 1000,
      newE: 1.0,
      outcome: "CATASTROPHIC DISRUPTION — Planet shattered into asteroid swarm!"
    }
    pushSimEvent("impact", "💥 " + impactor.name + " SHATTERED " + target.name + " (Ek = " + Math.round(bindRatio * 100) + "% U_bind)!")
    initialSystemEnergy = computeSystemMechanicalEnergy()
    return
  }

  // Momentum Transfer: Delta-v = (m_imp / (M_p + m_imp)) * v_rel_vec
  let massFrac = mImp / mSum
  let dvPlanetAUYr = massFrac * vRelPhysAUYr
  target.vx = target.vx + ux * dvPlanetAUYr
  target.vy = target.vy + uy * dvPlanetAUYr
  target.vz = target.vz + uz * dvPlanetAUYr
  target.massMsun = mTarg + mImp * 0.88

  let deltaVKms = dvPlanetAUYr * AU_YR_TO_KMS
  let newElem = computeOsculatingElements(target)

  // Thermal magma crust heating based on specific impact energy
  let heatBoostK = 0.0
  if (impDiamKm >= 3000.0) {
    heatBoostK = 3850.0
    target.hasDebrisRing = true
  } else if (impDiamKm >= 700.0) {
    heatBoostK = 2250.0
  } else if (impDiamKm >= 250.0) {
    heatBoostK = 1280.0
  } else {
    heatBoostK = 360.0
  }
  target.magmaTempK = Math.min(4800.0, Math.max(target.magmaTempK || 0.0, heatBoostK))
  target.trail = []

  shockwaves.push({
    id: "sw-imp-" + Math.round(simTimeYears * 1000) + "-" + _nextImpactorSeq,
    x: target.x, y: target.y, z: target.z,
    radiusAU: 0.02,
    maxRadiusAU: impDiamKm >= 2000.0 ? 0.85 : 0.42,
    life: 1.0,
    color: impDiamKm >= 2000.0 ? "#f43f5e" : "#fb923c"
  })
  spawnEjectaCloud(
    target.x, target.y, target.z,
    target.vx, target.vy, target.vz,
    impDiamKm >= 2000.0 ? 42 : 18,
    impDiamKm >= 2000.0 ? 0.95 : 0.45,
    "#fb923c"
  )

  if (impDiamKm >= 900.0) {
    playSfx("impact_giant", 0.85)
    triggerHaptic(55)
  } else {
    playSfx("impact_minor", 0.72)
    triggerHaptic(22)
  }

  let outcomeText = "Global extinction crater & dust shockwave (orbit unchanged)"
  if (impDiamKm >= 3000.0) {
    outcomeText = "Giant Theia-class impact! Magma ocean + moon-forming debris ring + major orbital kick!"
  } else if (impDiamKm >= 700.0) {
    outcomeText = "Global lithosphere melted into incandescent magma ocean!"
  } else if (impDiamKm >= 250.0) {
    outcomeText = "Continental mega-basin excavated & oceans vaporized!"
  }

  lastImpactReport = {
    targetName: target.name,
    impactorName: impactor.name,
    speedKms: Math.round(vRelKms * 10) / 10,
    energyMegatons: ekMegatons,
    bindRatioPct: Math.round(bindRatio * 10000) / 100,
    deltaVKms: Math.round(deltaVKms * 1000) / 1000,
    craterKm: craterKm,
    oldA: Math.round(oldElem.a * 1000) / 1000,
    newA: Math.round(newElem.a * 1000) / 1000,
    oldE: Math.round(oldElem.e * 1000) / 1000,
    newE: Math.round(newElem.e * 1000) / 1000,
    outcome: outcomeText
  }

  pushSimEvent(
    "impact",
    "☄ " + impactor.name + " struck " + target.name + " at " + Math.round(vRelKms) + " km/s (Δv " + (Math.round(deltaVKms * 100) / 100) + " km/s, e: " + (Math.round(oldElem.e * 100) / 100) + " → " + (Math.round(newElem.e * 100) / 100) + ")!"
  )
  updateBodyTemperatures(0.0)
  initialSystemEnergy = computeSystemMechanicalEnergy()
}

// Launch a 3D Sculpted Kinetic Impactor Asteroid toward Target Body!
function launchAsteroidStrike(targetId, presetId, speedKms, angleMode, instantHit) {
  let target = getBodyById(targetId)
  if (!target || !target.alive) { return false }

  let preset = IMPACTOR_PRESETS[0]
  let i = 0
  while (i < IMPACTOR_PRESETS.length) {
    if (IMPACTOR_PRESETS[i].id === presetId) { preset = IMPACTOR_PRESETS[i] }
    i = i + 1
  }

  let spdKms = clampVal(Number(speedKms) || preset.defaultSpeedKms, 8.0, 150.0)
  let vRelAUYr = spdKms / AU_YR_TO_KMS

  // Build attack direction in target's orbital frame:
  //   "head_on"    -> slams Retrograde against target's motion (slows planet, drops perihelion!)
  //   "prograde"   -> slams from behind along target's motion (boosts aphelion & eccentricity!)
  //   "radial_in"  -> slams radially inward from outer space
  //   "inclined"   -> slams from 48 deg above ecliptic (tilts orbital plane!)
  let vLen = Math.max(1e-5, Math.sqrt(target.vx * target.vx + target.vy * target.vy + target.vz * target.vz))
  let tx = target.vx / vLen
  let ty = target.vy / vLen
  let tz = target.vz / vLen

  let rLen = Math.max(1e-5, Math.sqrt(target.x * target.x + target.y * target.y + target.z * target.z))
  let rx = target.x / rLen
  let ry = target.y / rLen
  let rz = target.z / rLen

  let dirX = -tx
  let dirY = -ty
  let dirZ = -tz
  if (angleMode === "prograde") {
    dirX = tx; dirY = ty; dirZ = tz
  } else if (angleMode === "radial") {
    dirX = -rx; dirY = -ry; dirZ = -rz
  } else if (angleMode === "inclined") {
    dirX = -tx * 0.65
    dirY = -0.76
    dirZ = -tz * 0.65
  }
  let dNorm = Math.max(1e-6, Math.sqrt(dirX * dirX + dirY * dirY + dirZ * dirZ))
  dirX = dirX / dNorm
  dirY = dirY / dNorm
  dirZ = dirZ / dNorm

  let imp = {
    id: "impactor-" + _nextImpactorSeq,
    name: preset.name,
    kind: "impactor",
    targetId: target.id,
    modelUrl: "assets/models/asteroid-impactor.glb",
    color: preset.color,
    massMsun: preset.massMsun,
    radiusKm: preset.diameterKm * 0.5,
    radiusAU: (preset.diameterKm * 0.5) / AU_KM,
    launchSpeedKms: spdKms,
    x: target.x,
    y: target.y,
    z: target.z,
    vx: target.vx + dirX * vRelAUYr,
    vy: target.vy + dirY * vRelAUYr,
    vz: target.vz + dirZ * vRelAUYr,
    ax: 0, ay: 0, az: 0,
    spinAngle: 0.0,
    flightProgress: 0.0,
    flightDurationSec: 1.15,
    startOffsetAU: clampVal(rLen * 0.28, 0.14, 0.95),
    dirX: dirX,
    dirY: dirY,
    dirZ: dirZ,
    alive: true,
    trail: []
  }
  _nextImpactorSeq = _nextImpactorSeq + 1

  if (instantHit) {
    resolveAsteroidImpact(imp, target)
    return true
  }

  // Place impactor upstream along -dir so user watches the glowing 3D asteroid streak right into the planet!
  imp.x = target.x - dirX * imp.startOffsetAU
  imp.y = target.y - dirY * imp.startOffsetAU
  imp.z = target.z - dirZ * imp.startOffsetAU
  bodies.push(imp)
  playSfx("launch", 0.68)
  pushSimEvent("info", "🚀 Launched " + preset.name + " (" + preset.diameterKm + " km) at " + target.name + " (" + Math.round(spdKms) + " km/s)!")
  return true
}

// Evaluate Mutual Newtonian + 1PN General Relativistic + Red Giant Chromospheric Drag Accelerations
function computeAccelerations() {
  let n = bodies.length
  let i = 0
  while (i < n) {
    let b = bodies[i]
    b.ax = 0.0
    b.ay = 0.0
    b.az = 0.0
    i = i + 1
  }

  let c2Inv = 1.0 / (C_AU_YR * C_AU_YR)

  i = 0
  while (i < n) {
    let bi = bodies[i]
    if (bi.alive && bi.kind !== "impactor") {
      let j = i + 1
      while (j < n) {
        let bj = bodies[j]
        if (bj.alive && bj.kind !== "impactor") {
          let dx = bj.x - bi.x
          let dy = bj.y - bi.y
          let dz = bj.z - bi.z
          let r2 = dx * dx + dy * dy + dz * dz
          let rMin = Math.max(1e-6, bi.radiusAU + bj.radiusAU)
          let rSoft2 = Math.max(r2, rMin * rMin * 0.25)
          let r = Math.sqrt(rSoft2)
          let invR3 = 1.0 / (rSoft2 * r)

          let gij = G_AU * invR3
          let fxi = gij * bj.massMsun * dx
          let fyi = gij * bj.massMsun * dy
          let fzi = gij * bj.massMsun * dz

          let fxj = -gij * bi.massMsun * dx
          let fyj = -gij * bi.massMsun * dy
          let fzj = -gij * bi.massMsun * dz

          bi.ax = bi.ax + fxi
          bi.ay = bi.ay + fyi
          bi.az = bi.az + fzi

          bj.ax = bj.ax + fxj
          bj.ay = bj.ay + fyj
          bj.az = bj.az + fzj

          // 1PN General Relativistic correction + Giant Star Chromospheric Drag when one body is a Star!
          if ((bi.kind === "star" || bj.kind === "star") && r < 2.2) {
            let star = bi.kind === "star" ? bi : bj
            let body = bi.kind === "star" ? bj : bi
            let rx = body.x - star.x
            let ry = body.y - star.y
            let rz = body.z - star.z
            let vx = body.vx - star.vx
            let vy = body.vy - star.vy
            let vz = body.vz - star.vz
            let v2 = vx * vx + vy * vy + vz * vz
            let rv = rx * vx + ry * vy + rz * vz
            let gm = G_AU * star.massMsun
            let grFac = (gm * c2Inv) * invR3
            let termR = (4.0 * gm / r) - v2
            body.ax = body.ax + grFac * (termR * rx + 4.0 * rv * vx)
            body.ay = body.ay + grFac * (termR * ry + 4.0 * rv * vy)
            body.az = body.az + grFac * (termR * rz + 4.0 * rv * vz)

            // Red Giant extended chromosphere gas drag & tidal orbital decay within 1.30 * R_star!
            if (body.kind !== "star" && star.radiusAU > 0.05 && r < star.radiusAU * 1.30) {
              let depth = clampVal(1.30 - (r / star.radiusAU), 0.0, 0.8)
              let dragRate = 1.65 * depth * depth
              body.ax = body.ax - dragRate * vx
              body.ay = body.ay - dragRate * vy
              body.az = body.az - dragRate * vz
            }
          }
        }
        j = j + 1
      }
    }
    i = i + 1
  }
}

// Single 4th-Order Yoshida Symplectic Substep of duration `h` (in Years)
function yoshidaSubstep(h) {
  let n = bodies.length
  let i = 0

  // Drift 1: c1 * h
  while (i < n) {
    let b = bodies[i]
    if (b.alive && b.kind !== "impactor") {
      b.x = b.x + _YOSH_C1 * h * b.vx
      b.y = b.y + _YOSH_C1 * h * b.vy
      b.z = b.z + _YOSH_C1 * h * b.vz
    }
    i = i + 1
  }
  computeAccelerations()

  // Kick 1 (d1) + Drift 2 (c2)
  i = 0
  while (i < n) {
    let b = bodies[i]
    if (b.alive && b.kind !== "impactor") {
      b.vx = b.vx + _YOSH_D1 * h * b.ax
      b.vy = b.vy + _YOSH_D1 * h * b.ay
      b.vz = b.vz + _YOSH_D1 * h * b.az
      b.x = b.x + _YOSH_C2 * h * b.vx
      b.y = b.y + _YOSH_C2 * h * b.vy
      b.z = b.z + _YOSH_C2 * h * b.vz
    }
    i = i + 1
  }
  computeAccelerations()

  // Kick 2 (d2) + Drift 3 (c2)
  i = 0
  while (i < n) {
    let b = bodies[i]
    if (b.alive && b.kind !== "impactor") {
      b.vx = b.vx + _YOSH_D2 * h * b.ax
      b.vy = b.vy + _YOSH_D2 * h * b.ay
      b.vz = b.vz + _YOSH_D2 * h * b.az
      b.x = b.x + _YOSH_C2 * h * b.vx
      b.y = b.y + _YOSH_C2 * h * b.vy
      b.z = b.z + _YOSH_C2 * h * b.vz
    }
    i = i + 1
  }
  computeAccelerations()

  // Kick 3 (d1) + Drift 4 (c1)
  i = 0
  while (i < n) {
    let b = bodies[i]
    if (b.alive && b.kind !== "impactor") {
      b.vx = b.vx + _YOSH_D1 * h * b.ax
      b.vy = b.vy + _YOSH_D1 * h * b.ay
      b.vz = b.vz + _YOSH_D1 * h * b.az
      b.x = b.x + _YOSH_C1 * h * b.vx
      b.y = b.y + _YOSH_C1 * h * b.vy
      b.z = b.z + _YOSH_C1 * h * b.vz
    }
    i = i + 1
  }
}

// Check Physical Collisions, Red Giant Engulfments, Close Flybys & Hyperbolic Ejections
function checkCollisionsAndEncounters(dtRealSec) {
  if (_flybySoundCooldown > 0.0) {
    _flybySoundCooldown = Math.max(0.0, _flybySoundCooldown - dtRealSec)
  }

  let n = bodies.length
  let i = 0
  while (i < n) {
    let bi = bodies[i]
    if (bi.alive && bi.kind !== "impactor") {
      let j = i + 1
      while (j < n) {
        let bj = bodies[j]
        if (bj.alive && bj.kind !== "impactor") {
          let dx = bj.x - bi.x
          let dy = bj.y - bi.y
          let dz = bj.z - bi.z
          let r = Math.sqrt(dx * dx + dy * dy + dz * dz)
          let rContact = bi.radiusAU + bj.radiusAU

          if (r <= Math.max(rContact, 0.0012)) {
            // Merge lighter body into heavier body!
            let heavy = bi.massMsun >= bj.massMsun ? bi : bj
            let light = bi.massMsun >= bj.massMsun ? bj : bi
            let mTot = heavy.massMsun + light.massMsun
            heavy.vx = (heavy.massMsun * heavy.vx + light.massMsun * light.vx) / mTot
            heavy.vy = (heavy.massMsun * heavy.vy + light.massMsun * light.vy) / mTot
            heavy.vz = (heavy.massMsun * heavy.vz + light.massMsun * light.vz) / mTot
            heavy.massMsun = mTot
            light.alive = false

            shockwaves.push({
              id: "sw-merge-" + Math.round(simTimeYears * 1000) + "-" + i + "-" + j,
              x: light.x, y: light.y, z: light.z,
              radiusAU: 0.03,
              maxRadiusAU: heavy.kind === "star" ? 0.55 : 0.65,
              life: 1.0,
              color: heavy.kind === "star" ? "#fb7185" : "#fb923c"
            })
            spawnEjectaCloud(light.x, light.y, light.z, heavy.vx, heavy.vy, heavy.vz, 26, 0.75, "#fb923c")

            if (heavy.kind === "star" && light.kind !== "star") {
              engulfedCount = engulfedCount + 1
              light.status = "engulfed"
              playSfx("engulf", 0.76)
              pushSimEvent("warn", "🔥 " + light.name + " was engulfed & vaporized inside " + heavy.name + "!")
            } else if (heavy.kind === "star" && light.kind === "star") {
              heavy.luminosityLsun = (heavy.luminosityLsun || 1.0) + (light.luminosityLsun || 0.5) * 1.4
              heavy.radiusKm = Math.pow(Math.pow(heavy.radiusKm, 3) + Math.pow(light.radiusKm, 3), 1.0 / 3.0)
              heavy.radiusAU = heavy.radiusKm / AU_KM
              playSfx("supernova", 0.84)
              triggerHaptic(65)
              pushSimEvent("star", "🌟 STELLAR MERGER! " + light.name + " & " + heavy.name + " coalesced into a luminous giant!")
            } else {
              heavy.magmaTempK = 3600.0
              heavy.hasDebrisRing = true
              playSfx("impact_giant", 0.85)
              triggerHaptic(50)
              pushSimEvent("impact", "💥 PLANETARY COLLISION! " + light.name + " collided with " + heavy.name + "!")
            }
            initialSystemEnergy = computeSystemMechanicalEnergy()
          } else if (bi.kind !== "star" && bj.kind !== "star" && r < 0.085) {
            // Close Planet-Planet Gravitational Scattering Encounter!
            let pairKey = r < 0.045
            chaosIndex = Math.min(100.0, chaosIndex + (pairKey ? 6.5 : 1.5))
            if (pairKey && _flybySoundCooldown <= 0.0) {
              closeEncounterCount = closeEncounterCount + 1
              _flybySoundCooldown = 2.5
              playSfx("flyby_alert", 0.45)
              pushSimEvent("orbit", "⚠ Close encounter! " + bi.name + " & " + bj.name + " passed within " + (Math.round(r * 1000) / 1000) + " AU!")
            }
          }
        }
        j = j + 1
      }
    }
    i = i + 1
  }

  // Check for Hyperbolic Ejection past 95 AU
  let k = 0
  while (k < n) {
    let b = bodies[k]
    if (b.alive && b.kind !== "star" && b.kind !== "impactor") {
      let dist = Math.sqrt(b.x * b.x + b.y * b.y + b.z * b.z)
      if (dist > 95.0 && b.status !== "ejected") {
        let el = computeOsculatingElements(b)
        if (!el.bound) {
          b.status = "ejected"
          b.alive = false
          ejectedCount = ejectedCount + 1
          chaosIndex = Math.min(100.0, chaosIndex + 12.0)
          playSfx("flyby_alert", 0.55)
          pushSimEvent("warn", "🌌 " + b.name + " escaped solar gravity into interstellar space as a rogue planet!")
        }
      }
    }
    k = k + 1
  }
}

// Advance Dynamic Asteroid Belt via Symplectic Leapfrog against Stars & Gas Giants
function stepAsteroidBelt(dtYears) {
  if (dtYears <= 0.0 || beltAsteroids.length === 0) { return }
  let attractors = []
  let i = 0
  while (i < bodies.length) {
    let b = bodies[i]
    if (b.alive && (b.kind === "star" || b.massMsun > 1e-4)) {
      attractors.push(b)
    }
    i = i + 1
  }
  if (attractors.length === 0) { return }

  let steps = Math.min(4, Math.max(1, Math.ceil(dtYears / 0.045)))
  let h = dtYears / steps
  let halfH = 0.5 * h
  let s = 0
  while (s < steps) {
    let ai = 0
    while (ai < beltAsteroids.length) {
      let ast = beltAsteroids[ai]
      if (ast.alive) {
        ast.vx = ast.vx + halfH * ast.ax
        ast.vy = ast.vy + halfH * ast.ay
        ast.vz = ast.vz + halfH * ast.az
        ast.x = ast.x + h * ast.vx
        ast.y = ast.y + h * ast.vy
        ast.z = ast.z + h * ast.vz

        let gx = 0.0
        let gy = 0.0
        let gz = 0.0
        let m = 0
        while (m < attractors.length) {
          let att = attractors[m]
          let dx = att.x - ast.x
          let dy = att.y - ast.y
          let dz = att.z - ast.z
          let r2 = dx * dx + dy * dy + dz * dz
          if (att.kind === "star" && r2 < att.radiusAU * att.radiusAU) {
            ast.alive = false
            break
          }
          let rSoft2 = Math.max(0.015, r2)
          let fac = (G_AU * att.massMsun) / (rSoft2 * Math.sqrt(rSoft2))
          gx = gx + fac * dx
          gy = gy + fac * dy
          gz = gz + fac * dz
          m = m + 1
        }
        ast.ax = gx
        ast.ay = gy
        ast.az = gz
        ast.vx = ast.vx + halfH * gx
        ast.vy = ast.vy + halfH * gy
        ast.vz = ast.vz + halfH * gz

        if (ast.x * ast.x + ast.y * ast.y + ast.z * ast.z > 9000.0) {
          ast.alive = false
        }
      }
      ai = ai + 1
    }
    s = s + 1
  }
}

// Advance Flying Impactor Asteroids, Shockwaves & Ejecta Clouds (runs even if orbital clock is slow!)
function stepImpactorsAndEffects(dtRealSec, dtSimYears) {
  let i = 0
  while (i < bodies.length) {
    let b = bodies[i]
    if (b.alive && b.kind === "impactor") {
      let targ = getBodyById(b.targetId)
      if (!targ || !targ.alive) {
        b.alive = false
      } else {
        b.flightProgress = b.flightProgress + dtRealSec / Math.max(0.25, b.flightDurationSec)
        b.spinAngle = b.spinAngle + dtRealSec * 5.2
        if (b.flightProgress >= 1.0) {
          b.x = targ.x
          b.y = targ.y
          b.z = targ.z
          resolveAsteroidImpact(b, targ)
        } else {
          let rem = (1.0 - b.flightProgress) * b.startOffsetAU
          // Slight hyperbolic curve bend near planet
          let arcLift = Math.sin(b.flightProgress * Math.PI) * 0.025 * b.startOffsetAU
          b.x = targ.x - b.dirX * rem
          b.y = targ.y - b.dirY * rem + arcLift
          b.z = targ.z - b.dirZ * rem
          b.trail.push(b.x, b.y, b.z)
          if (b.trail.length > 54) {
            b.trail = b.trail.slice(b.trail.length - 54)
          }
        }
      }
    }
    i = i + 1
  }

  // Prune dead impactors from `bodies`
  let kept = []
  let bi = 0
  while (bi < bodies.length) {
    let bb = bodies[bi]
    if (bb.kind !== "impactor" || bb.alive) {
      kept.push(bb)
    }
    bi = bi + 1
  }
  bodies = kept

  // Update 3D Expanding Shockwave Rings
  let nextWaves = []
  let wi = 0
  while (wi < shockwaves.length) {
    let sw = shockwaves[wi]
    sw.life = sw.life - dtRealSec * 0.72
    if (sw.life > 0.02) {
      let u = 1.0 - sw.life
      sw.radiusAU = 0.03 + sw.maxRadiusAU * (1.0 - Math.pow(1.0 - u, 2.2))
      nextWaves.push(sw)
    }
    wi = wi + 1
  }
  shockwaves = nextWaves

  // Update Ejecta Debris Particles
  let nextDebris = []
  let di = 0
  let stepEjectaYr = Math.max(dtRealSec * 0.18, Math.min(0.08, dtSimYears))
  while (di < ejectaDebris.length) {
    let d = ejectaDebris[di]
    d.life = d.life - dtRealSec * 0.36
    if (d.life > 0.02) {
      d.x = d.x + d.vx * stepEjectaYr
      d.y = d.y + d.vy * stepEjectaYr
      d.z = d.z + d.vz * stepEjectaYr
      nextDebris.push(d)
    }
    di = di + 1
  }
  ejectaDebris = nextDebris
}

// Master Physics Frame Stepper
function stepPhysicsSimulation(dtRealSec) {
  let clampedDt = clampVal(dtRealSec, 0.001, 0.05)

  // Always animate Red Giant evolution, flying impactor streaks & shockwaves smoothly
  stepStellarEvolution(clampedDt)

  let dtYears = paused ? 0.0 : (clampedDt * timeWarpYrPerSec)
  stepImpactorsAndEffects(clampedDt, dtYears)

  if (dtYears <= 0.0) {
    return
  }

  // Adaptive substep selection from minimum close pair distance so binary periapses & Mercury never drift!
  let minR2 = 0.16
  let n = bodies.length
  let a = 0
  while (a < n) {
    let ba = bodies[a]
    if (ba.alive && ba.kind !== "impactor") {
      let b = a + 1
      while (b < n) {
        let bb = bodies[b]
        if (bb.alive && bb.kind !== "impactor") {
          let dx = bb.x - ba.x
          let dy = bb.y - ba.y
          let dz = bb.z - ba.z
          let r2 = dx * dx + dy * dy + dz * dz
          if (r2 < minR2) { minR2 = r2 }
        }
        b = b + 1
      }
    }
    a = a + 1
  }

  let rMin = Math.max(0.025, Math.sqrt(minR2))
  let tau = Math.sqrt((rMin * rMin * rMin) / G_AU)
  let targetStep = Math.max(0.00035, tau * 0.065)
  let substeps = clampVal(Math.ceil(dtYears / targetStep), 2, 36)
  let h = dtYears / substeps

  let s = 0
  while (s < substeps) {
    yoshidaSubstep(h)
    s = s + 1
  }

  simTimeYears = simTimeYears + dtYears

  // Advance axial spin visually smoothly (clamped so high time warp doesn't strobe)
  let bi = 0
  while (bi < bodies.length) {
    let p = bodies[bi]
    if (p.alive && p.kind !== "impactor") {
      let sign = (p.rotPeriodDays || 1.0) < 0.0 ? -1.0 : 1.0
      let spinRate = p.kind === "star" ? 0.85 : (Math.abs(p.rotPeriodDays) > 20.0 ? 0.35 : 1.85)
      p.spinAngle = (p.spinAngle + sign * clampedDt * spinRate) % (2.0 * Math.PI)
    }
    bi = bi + 1
  }

  // Sample 3D Wake Trails (flat x, y, z ring buffer per body, up to 96 points = 288 floats)
  _trailSampleAccumYr = _trailSampleAccumYr + dtYears
  let sampleEveryYr = Math.max(0.004, timeWarpYrPerSec * 0.014)
  if (_trailSampleAccumYr >= sampleEveryYr) {
    _trailSampleAccumYr = 0.0
    let ti = 0
    while (ti < bodies.length) {
      let tb = bodies[ti]
      if (tb.alive && tb.kind !== "impactor") {
        let tr = tb.trail
        let len = tr.length
        let append = true
        if (len >= 3) {
          let lx = tr[len - 3] - tb.x
          let ly = tr[len - 2] - tb.y
          let lz = tr[len - 1] - tb.z
          if (lx * lx + ly * ly + lz * lz < 0.0002) { append = false }
        }
        if (append) {
          tr.push(tb.x, tb.y, tb.z)
          if (tr.length > 270) {
            tb.trail = tr.slice(tr.length - 270)
          }
        }
      }
      ti = ti + 1
    }
  }

  stepAsteroidBelt(dtYears)
  checkCollisionsAndEncounters(clampedDt)
  updateBodyTemperatures(dtYears)

  // Track Chaos & Energy Conservation
  currentSystemEnergy = computeSystemMechanicalEnergy()
  if (Math.abs(initialSystemEnergy) > 1e-9) {
    energyDriftPct = Math.abs((currentSystemEnergy - initialSystemEnergy) / initialSystemEnergy) * 100.0
  }

  //Measure secular eccentricity pumping relative to J2000 baseline
  let eccExcess = 0.0
  let pi = 0
  while (pi < bodies.length) {
    let pb = bodies[pi]
    if (pb.alive && pb.kind !== "star" && pb.kind !== "impactor" && pb.initA > 0.0) {
      let el = computeOsculatingElements(pb)
      let de = Math.max(0.0, el.e - pb.initE)
      eccExcess = eccExcess + de * 38.0
    }
    pi = pi + 1
  }
  let targetChaos = Math.min(100.0, eccExcess + engulfedCount * 14.0 + ejectedCount * 18.0 + closeEncounterCount * 6.0)
  chaosIndex = chaosIndex * 0.96 + targetChaos * 0.04
}
