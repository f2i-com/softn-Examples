// DeadHours — Core survival loop, Armory upgrades, lighting presets, audio & leaderboard

let px = 0.0
let pz = 5.5
let lookYaw = Math.PI
let lookPitch = 0.0

let started = false
let paused = false
let armoryOpen = false
let gameOver = false
let touchMode = false
let touchSprint = false

let wave = 0
let waveState = "idle"
let waveTimer = 0.0
let toSpawn = 0
let spawnCooldown = 0.0

let hp = 100
let maxHp = 100
let overdriveTimer = 0.0

let kills = 0
let headshots = 0
let streakCount = 0
let streakTimer = 0.0
let score = 0
let bestScore = 0
let scrap = 60

let waveBanner = ""
let bannerTimer = 0.0
let toastMsg = ""
let toastTimer = 0.0

let bobPhase = 0.0
let cameraShake = 0.0
let hurtFlash = 0.0
let hitMarkerTimer = 0.0
let hitMarkerCrit = false
let lastHeartbeatAt = 0.0

let torchOn = true
let qualityPreset = "high"
let shadowsOn = true
let fpsReadout = 60
let fpsSamples = 0
let fpsAccum = 0.0

let pad = { presses: {} }
let nearBench = false
let mouseFireHeld = false
let wasLocked = false
let titleOrbitAngle = 0.0
let rngState = 48271

let playerName = ""
let scoreSubmitted = false
let boardStatusMsg = ""
let leaderboard = []

let sceneStatic = []
let sceneObjects = []
let sceneLights = []
let sceneFog = { color: "#09101a", near: 8, far: 44 }
let sceneEffects = {
  ambientOcclusion: { radius: 0.75, intensity: 1.0 },
  bloom: { strength: 0.34, radius: 0.28, threshold: 1.15 },
  vignette: 0.42,
  grain: 0.08
}
let cameraPos = { x: 0.0, y: 2.2, z: 13.5 }
let cameraLookAt = { x: 0.0, y: 1.2, z: 0.0 }
let hudTick = 0

function randFloat() {
  rngState = (rngState * 48271) % 2147483647
  return (rngState & 0x7fffffff) / 2147483647.0
}

function playSfx(relPath, vol) {
  try {
    if (typeof softn !== "undefined" && softn.audio && softn.audio.play) {
      softn.audio.play(relPath, { volume: vol || 0.5 })
    }
  } catch (err) {}
}

function showBanner(msg) {
  waveBanner = msg
  bannerTimer = 3.0
}

function showToast(msg) {
  toastMsg = msg
  toastTimer = 2.4
}

function hexRgb(hex) {
  if (!hex || hex.length < 7) { return [1.0, 0.9, 0.7] }
  let r = parseInt(hex.slice(1, 3), 16) / 255.0
  let g = parseInt(hex.slice(3, 5), 16) / 255.0
  let b = parseInt(hex.slice(5, 7), 16) / 255.0
  if (isNaN(r) || isNaN(g) || isNaN(b)) { return [1.0, 0.9, 0.7] }
  return [r, g, b]
}

function spawnBurstParticles(x, y, z, count, color, speed, size, life) {
  let c = hexRgb(color)
  let i = 0
  while (i < count) {
    if (particles.length >= 200) {
      particles.shift()
    }
    let ang = randFloat() * Math.PI * 2
    let elev = (randFloat() - 0.15) * 1.4
    let spd = speed * (0.45 + randFloat() * 0.75)
    particles.push({
      x: x + (randFloat() - 0.5) * 0.15,
      y: Math.max(0.08, y + (randFloat() - 0.5) * 0.15),
      z: z + (randFloat() - 0.5) * 0.15,
      vx: Math.cos(ang) * spd,
      vy: elev * spd + 1.2,
      vz: Math.sin(ang) * spd,
      r: c[0],
      g: c[1],
      b: c[2],
      life: life * (0.65 + randFloat() * 0.5),
      maxLife: life
    })
    i = i + 1
  }
}

function updateParticles(dt) {
  let i = particles.length - 1
  while (i >= 0) {
    let p = particles[i]
    p.vy = p.vy - 9.0 * dt
    p.x = p.x + p.vx * dt
    p.y = p.y + p.vy * dt
    p.z = p.z + p.vz * dt
    if (p.y < 0.05) {
      p.y = 0.05
      p.vy = -p.vy * 0.25
      p.vx = p.vx * 0.7
      p.vz = p.vz * 0.7
    }
    p.life = p.life - dt
    if (p.life <= 0.0) {
      particles.splice(i, 1)
    }
    i = i - 1
  }
}

function applyQualityPreset(mode) {
  qualityPreset = mode
  try {
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("deadhours:quality", mode)
    }
  } catch (err) {}
  if (mode === "low") {
    shadowsOn = false
    sceneEffects = { vignette: 0.36 }
  } else if (mode === "balanced") {
    shadowsOn = true
    sceneEffects = {
      bloom: { strength: 0.30, radius: 0.24, threshold: 1.2 },
      vignette: 0.42,
      grain: 0.06
    }
  } else {
    shadowsOn = true
    sceneEffects = {
      ambientOcclusion: { radius: 0.75, intensity: 1.0 },
      bloom: { strength: 0.34, radius: 0.28, threshold: 1.15 },
      vignette: 0.42,
      grain: 0.08
    }
  }
  buildLights()
}

function cycleQualityPreset() {
  if (qualityPreset === "high") {
    applyQualityPreset("balanced")
  } else if (qualityPreset === "balanced") {
    applyQualityPreset("low")
  } else {
    applyQualityPreset("high")
  }
  playSfx("assets/sfx/click.wav", 0.35)
}

function applyPlayerDamage(rawDmg) {
  if (!started || gameOver) { return }
  let dmg = rawDmg
  if (armorPts > 0) {
    let absorbed = Math.min(armorPts, Math.round(rawDmg * 0.62))
    armorPts = Math.max(0, armorPts - absorbed)
    dmg = Math.max(2, rawDmg - absorbed)
  }
  hp = Math.max(0, hp - dmg)
  hurtFlash = Math.min(0.9, hurtFlash + 0.58)
  cameraShake = Math.max(cameraShake, 0.26)
  playSfx("assets/sfx/hurt.wav", 0.65)
  if (hp <= 0) {
    triggerGameOver()
  }
}

function triggerGameOver() {
  if (gameOver) { return }
  gameOver = true
  armoryOpen = false
  paused = false
  mouseFireHeld = false
  if (typeof window !== "undefined") {
    window.__scene3dReleaseLock = true
  }
  if (score > bestScore) {
    bestScore = score
    try {
      if (typeof localStorage !== "undefined") {
        localStorage.setItem("deadhours:best", String(score))
      }
    } catch (err) {}
  }
  playSfx("assets/sfx/hurt.wav", 0.8)
}

function loadLeaderboard() {
  try {
    if (typeof softn !== "undefined" && softn.storage && softn.storage.query) {
      softn.storage.query("scores", { orderBy: ["score", "desc"], limit: 10 }, function (rows) {
        if (Array.isArray(rows)) {
          leaderboard = rows
        }
      })
    }
  } catch (err) {}
}

function setPlayerName(v) {
  playerName = String(v || "")
}

function submitScore() {
  if (scoreSubmitted || score <= 0) { return }
  let clean = String(playerName || "Survivor").trim().slice(0, 18)
  if (clean.length === 0) { clean = "Survivor" }
  playerName = clean
  try {
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("deadhours:name", clean)
    }
  } catch (err) {}
  scoreSubmitted = true
  boardStatusMsg = "Recording..."
  playSfx("assets/sfx/click.wav", 0.4)
  try {
    if (typeof softn !== "undefined" && softn.storage && softn.storage.insert) {
      softn.storage.insert(
        "scores",
        { name: clean, score: score, wave: wave, kills: kills },
        function () {
          boardStatusMsg = "Saved to Graveyard Ledger"
          loadLeaderboard()
          showToast("Score recorded to graveyard board")
        }
      )
    }
  } catch (err) {
    boardStatusMsg = "Saved locally (offline)"
    showToast("Saved locally (offline)")
  }
}

function blurActiveFocus() {
  try {
    if (typeof document !== "undefined" && document.activeElement && document.activeElement.blur) {
      document.activeElement.blur()
    }
  } catch (err) {}
}

function selectPistol() { blurActiveFocus(); if (started && !paused && !armoryOpen && !gameOver) { selectWeapon(0) } }
function selectShotgun() { blurActiveFocus(); if (started && !paused && !armoryOpen && !gameOver) { selectWeapon(1) } }
function selectSmg() { blurActiveFocus(); if (started && !paused && !armoryOpen && !gameOver) { selectWeapon(2) } }
function togglePauseModal() {
  if (!started || gameOver) { return }
  if (armoryOpen) { closeArmoryBench(); return }
  if (paused) { resumePlay() } else { paused = true; mouseFireHeld = false; if (typeof window !== "undefined") { window.__scene3dReleaseLock = true } }
}

function startNewRun() {
  blurActiveFocus()
  px = 0.0
  pz = 6.2
  lookYaw = Math.PI
  lookPitch = -0.02
  if (typeof window !== "undefined") {
    window.__scene3dYaw = lookYaw
    window.__scene3dPitch = lookPitch
    if (!touchMode) { window.__scene3dWantLock = true }
  }
  resetWeaponsState()
  resetExplosiveBarrels()
  resetDestructibleEnvironment()
  zombies = []
  acidShots = []
  pickups = []
  particles = []
  bossAnchorId = ""
  bossLabel = ""
  bossHpPct = 0

  wave = 0
  waveState = "between"
  waveTimer = 2.6
  toSpawn = 0
  spawnCooldown = 0.0

  hp = 100
  overdriveTimer = 0.0
  kills = 0
  headshots = 0
  streakCount = 0
  streakTimer = 0.0
  score = 0
  scrap = 75
  scoreSubmitted = false

  bobPhase = 0.0
  cameraShake = 0.0
  hurtFlash = 0.0
  hitMarkerTimer = 0.0
  hitMarkerCrit = false
  mouseFireHeld = false

  paused = false
  armoryOpen = false
  gameOver = false
  started = true

  showBanner("Hold the Courtyard · Wave 1 Incoming")
  showToast(touchMode ? "Bench ahead (-Z): Tap SHOP or Armory to upgrade" : "Bench ahead (-Z): Press E to buy upgrades")
  playSfx("assets/sfx/click.wav", 0.4)
  updateCameraFromState(0.0)
  composeSceneFrame(0.0)
}

function returnToTitle() {
  started = false
  paused = false
  armoryOpen = false
  gameOver = false
  mouseFireHeld = false
  if (typeof window !== "undefined") {
    window.__scene3dReleaseLock = true
  }
  resetWeaponsState()
  resetExplosiveBarrels()
  resetDestructibleEnvironment()
  zombies = []
  acidShots = []
  pickups = []
  particles = []
  bossAnchorId = ""
  initShowcaseZombies()
  loadLeaderboard()
}

function resumePlay() {
  if (!started || gameOver) { return }
  paused = false
  armoryOpen = false
  mouseFireHeld = false
  if (!touchMode && typeof window !== "undefined") {
    window.__scene3dWantLock = true
  }
  playSfx("assets/sfx/click.wav", 0.35)
}

function openArmoryBench() {
  if (!started || gameOver) { return }
  armoryOpen = true
  paused = false
  mouseFireHeld = false
  if (typeof window !== "undefined") {
    window.__scene3dReleaseLock = true
  }
  playSfx("assets/sfx/click.wav", 0.35)
}

function closeArmoryBench() {
  if (!started || gameOver) { return }
  armoryOpen = false
  if (!touchMode && typeof window !== "undefined") {
    window.__scene3dWantLock = true
  }
  playSfx("assets/sfx/click.wav", 0.3)
}

function toggleTorchLight() {
  blurActiveFocus()
  torchOn = !torchOn
  playSfx("assets/sfx/click.wav", 0.35)
  showToast(torchOn ? "Tactical light ON" : "Tactical light OFF")
  buildLights()
}

// ---- Armory Purchases ----

function spendScrap(cost) {
  if (scrap < cost) {
    playSfx("assets/sfx/dryfire.wav", 0.35)
    showToast("Need " + cost + " Scrap")
    return false
  }
  scrap = scrap - cost
  playSfx("assets/sfx/buy.wav", 0.55)
  return true
}

function buyAmmo() {
  if (!spendScrap(35)) { return }
  resAmmo[1] = resAmmo[1] + 18
  if (weaponUnlocked[2]) {
    resAmmo[2] = resAmmo[2] + 96
  }
  showToast("+18 Shells & SMG Mags")
}

function buyMedkit() {
  if (hp >= maxHp) {
    showToast("Health already full")
    return
  }
  if (!spendScrap(45)) { return }
  hp = Math.min(maxHp, hp + 50)
  showToast("+50 HP Restored")
}

function buyArmor() {
  if (armorPts >= maxArmor) {
    showToast("Armor already full")
    return
  }
  if (!spendScrap(50)) { return }
  armorPts = Math.min(maxArmor, armorPts + 50)
  showToast("+50 Kevlar Armor")
}

function buyGrenade() {
  if (grenadesLeft >= 4) {
    showToast("Max 4 Frag Grenades")
    return
  }
  if (!spendScrap(40)) { return }
  grenadesLeft = Math.min(4, grenadesLeft + 2)
  showToast("+2 Frag Grenades")
}

function buySmg() {
  if (weaponUnlocked[2]) {
    if (!spendScrap(45)) { return }
    resAmmo[2] = resAmmo[2] + 128
    selectWeapon(2)
    showToast("+128 9mm SMG Rounds")
    return
  }
  if (!spendScrap(140)) { return }
  weaponUnlocked[2] = true
  magAmmo[2] = WEAPONS[2].mag
  resAmmo[2] = WEAPONS[2].startReserve
  selectWeapon(2)
  showToast("MP-X Suppressed SMG Unlocked!")
}

function buyDmgPerk() {
  if (perkDmgLevel >= 3) { showToast("Hollow Points Maxed"); return }
  let cost = 90 + perkDmgLevel * 60
  if (!spendScrap(cost)) { return }
  perkDmgLevel = perkDmgLevel + 1
  showToast("Hollow Points Lv" + perkDmgLevel + " (+18% DMG)")
}

function buyReloadPerk() {
  if (perkReloadLevel >= 3) { showToast("Sleight of Hand Maxed"); return }
  let cost = 75 + perkReloadLevel * 50
  if (!spendScrap(cost)) { return }
  perkReloadLevel = perkReloadLevel + 1
  showToast("Quick Mag Lv" + perkReloadLevel + " (+22% Reload)")
}

function buySpeedPerk() {
  if (perkSpeedLevel >= 2) { showToast("Boots Maxed"); return }
  let cost = 80 + perkSpeedLevel * 60
  if (!spendScrap(cost)) { return }
  perkSpeedLevel = perkSpeedLevel + 1
  showToast("Tactical Sprint Lv" + perkSpeedLevel + " (+10% Speed)")
}

// ---- Wave & Spawning ----

function startNextWave() {
  wave = wave + 1
  waveState = "active"
  toSpawn = 4 + wave * 3 + Math.floor(wave * wave * 0.25)
  spawnCooldown = 0.4
  if (wave >= 3 && wave % 2 === 1) {
    resetExplosiveBarrels()
  }
  if (wave === 2 && !weaponUnlocked[2]) {
    showToast("Tip: MP-X SMG available at Armory Bench (E)")
  }
  showBanner("WAVE " + wave + " — SURVIVE")
  playSfx("assets/sfx/wave.wav", 0.55)
}

function finishCurrentWave() {
  waveState = "between"
  waveTimer = 9.0
  let bonus = wave * 175
  score = score + bonus
  scrap = scrap + 25 + wave * 8
  showBanner("WAVE " + wave + " CLEARED  ·  +" + bonus + " PTS  ·  PRESS E FOR ARMORY")
  playSfx("assets/sfx/wave_clear.wav", 0.65)
}

// ---- Camera & Lighting ----

function updateCameraFromState(moveRatio) {
  let sx = 0.0
  let sy = 0.0
  if (cameraShake > 0.004) {
    sx = (randFloat() - 0.5) * cameraShake * 0.35
    sy = (randFloat() - 0.5) * cameraShake * 0.35
  }
  let walkBobY = Math.sin(bobPhase * 2.0) * 0.032 * moveRatio
  let cy = P_EYE + walkBobY + sy
  let cx = px + sx
  let cz = pz
  let cp = Math.cos(lookPitch)
  cameraPos = { x: cx, y: cy, z: cz }
  cameraLookAt = {
    x: cx + Math.sin(lookYaw) * cp * 10.0,
    y: cy + Math.sin(lookPitch) * 10.0,
    z: cz + Math.cos(lookYaw) * cp * 10.0
  }
}

function buildLights() {
  let dirShadows = shadowsOn
  let shadowSz = qualityPreset === "balanced" ? 1024 : 2048
  let f = 0.85 + Math.sin(bobPhase * 3.0 + hp) * 0.12
  let list = [
    {
      id: "hemi-moon",
      type: "hemisphere",
      color: "#7aa2d8",
      groundColor: "#141820",
      intensity: 0.42
    },
    {
      id: "dir-moon",
      type: "directional",
      color: "#b7cef2",
      intensity: 1.55,
      position: { x: 14, y: 26, z: 12 },
      castShadow: dirShadows,
      follow: "view",
      shadowMapSize: shadowSz,
      shadowCameraSize: 18,
      shadowBias: -0.0004,
      shadowNormalBias: 0.025
    },
    {
      id: "pt-bench",
      type: "point",
      color: "#38bdf8",
      intensity: 2.8,
      distance: 11,
      decay: 1.8,
      position: { x: BENCH_X, y: 2.3, z: BENCH_Z + 0.3 }
    },
    {
      id: "pt-fire1",
      type: "point",
      color: "#ff7b29",
      intensity: 4.5 * f,
      distance: 13,
      decay: 1.8,
      position: { x: -4.4, y: 1.5, z: -8.6 }
    },
    {
      id: "pt-fire2",
      type: "point",
      color: "#ff7b29",
      intensity: 4.5 * f,
      distance: 13,
      decay: 1.8,
      position: { x: 4.4, y: 1.5, z: -8.6 }
    }
  ]

  if (!courtyardLamps[0].broken) {
    list.push({
      id: "pt-lamp1",
      type: "point",
      color: "#ffbe73",
      intensity: 4.4,
      distance: 16,
      decay: 1.65,
      position: { x: -9.8, y: 4.2, z: -9.8 }
    })
  }
  if (!courtyardLamps[1].broken) {
    list.push({
      id: "pt-lamp2",
      type: "point",
      color: "#ffbe73",
      intensity: 4.4,
      distance: 16,
      decay: 1.65,
      position: { x: 9.8, y: 4.2, z: 9.8 }
    })
  }

  if (carBurnTimer > 0.0 || (!carExploded && carHp <= carMaxHp * 0.25)) {
    let fireFade = carExploded ? clampVal(carBurnTimer / 6.0, 0.25, 1.0) : 0.8
    list.push({
      id: "pt-carfire",
      type: "point",
      color: "#ff6b18",
      intensity: (4.8 + Math.sin(bobPhase * 11.0) * 1.4) * fireFade,
      distance: 13,
      decay: 1.7,
      position: { x: TRUCK_X - 0.38, y: 1.55, z: TRUCK_Z - 1.30 }
    })
  }

  if (explosionFlash > 0.0) {
    list.push({
      id: "pt-blast",
      type: "point",
      color: "#ffbe55",
      intensity: clampVal(explosionFlash * 38.0, 0.0, 14.0),
      distance: 20,
      decay: 1.6,
      position: { x: explosionX, y: explosionY, z: explosionZ }
    })
  }

  if (started && !gameOver && torchOn) {
    list.push({
      id: "torch-spot",
      type: "spot",
      attach: "camera",
      position: { x: 0.14, y: -0.10, z: -0.95 },
      color: overdriveTimer > 0.0 ? "#fde047" : "#f3f7ff",
      intensity: 14.0,
      distance: 28,
      angle: 0.44,
      penumbra: 0.62,
      decay: 1.45,
      castShadow: qualityPreset === "high",
      shadowMapSize: 512
    })
  }

  if (flashTimer > 0.0 && started && !gameOver) {
    list.push({
      id: "muzzle-light",
      type: "point",
      attach: "camera",
      position: { x: 0.18, y: -0.12, z: -0.75 },
      color: "#ffbe55",
      intensity: 11.0,
      distance: 9,
      decay: 2.0
    })
  }

  sceneLights = list
}

function composeSceneFrame(moveRatio) {
  let dynamicOut = []
  buildDynamicArenaObjects(dynamicOut)
  buildWeaponViewmodelObjects(dynamicOut, moveRatio)

  // Soft particle cloud (blood bursts, explosions, sparks + courtyard atmospheric embers)
  let pPos = []
  let pCols = []
  let pi = 0
  while (pi < particles.length) {
    let p = particles[pi]
    let fade = Math.max(0.1, p.life / Math.max(0.01, p.maxLife))
    pPos.push(p.x, p.y, p.z)
    pCols.push(p.r * fade, p.g * fade, p.b * fade)
    pi = pi + 1
  }
  // Faint moonlit drifting dust/ash around courtyard
  let di = 0
  while (di < 18) {
    let drift = bobPhase * 0.15 + di * 1.7
    pPos.push(
      Math.sin(drift * 0.7 + di) * 14.0,
      0.5 + ((di * 0.37 + bobPhase * 0.08) % 3.2),
      Math.cos(drift * 0.5 + di * 1.3) * 14.0
    )
    pCols.push(0.45, 0.55, 0.72)
    di = di + 1
  }
  dynamicOut.push({
    id: "fx-particles",
    type: "particles",
    particlePositions: pPos,
    particleColors: pCols,
    particleSize: 0.25,
    particleShape: "soft",
    opacity: 0.92,
    pickable: false,
    fog: true
  })

  sceneObjects = dynamicOut
}

// ---- Frame Tick & Input ----

function arenaStep(rawDt) {
  let dt = rawDt || 0.016
  if (dt > 0.08) { dt = 0.08 }

  if (!started) {
    titleOrbitAngle = titleOrbitAngle + dt * 0.16
    px = Math.cos(titleOrbitAngle) * 13.5
    pz = Math.sin(titleOrbitAngle) * 13.5
    lookYaw = Math.atan2(-px, -pz)
    lookPitch = -0.14
    if (typeof window !== "undefined") {
      window.__scene3dYaw = lookYaw
      window.__scene3dPitch = lookPitch
    }
    let si = 0
    while (si < showcaseZombies.length) {
      let sz = showcaseZombies[si]
      sz.yaw = sz.yaw + dt * (0.28 + si * 0.08)
      sz.x = sz.x + Math.sin(sz.yaw) * 0.75 * dt
      sz.z = sz.z + Math.cos(sz.yaw) * 0.75 * dt
      let dCenter = sz.x * sz.x + sz.z * sz.z
      if (dCenter > 26.0) { sz.yaw = Math.atan2(-sz.x, -sz.z) }
      sz.phase = sz.phase + dt * 3.8
      si = si + 1
    }
    cameraPos = { x: px, y: 2.9, z: pz }
    cameraLookAt = { x: 0.0, y: 1.15, z: 0.0 }
    bobPhase = bobPhase + dt * 1.2
    updateParticles(dt)
    composeSceneFrame(0.0)
    return
  }

  let locked = typeof window !== "undefined" ? !!window.__scene3dLocked : false
  if (wasLocked && !locked && !armoryOpen && !touchMode && !gameOver) {
    paused = true
    mouseFireHeld = false
  }
  wasLocked = locked

  if (bannerTimer > 0.0) {
    bannerTimer = Math.max(0.0, bannerTimer - dt)
    if (bannerTimer <= 0.0) { waveBanner = "" }
  }
  if (toastTimer > 0.0) {
    toastTimer = Math.max(0.0, toastTimer - dt)
    if (toastTimer <= 0.0) { toastMsg = "" }
  }
  if (hurtFlash > 0.0) { hurtFlash = Math.max(0.0, hurtFlash - dt * 1.8) }
  if (hitMarkerTimer > 0.0) { hitMarkerTimer = Math.max(0.0, hitMarkerTimer - dt) }
  if (cameraShake > 0.0) { cameraShake = Math.max(0.0, cameraShake - dt * 1.4) }
  if (flashTimer > 0.0) { flashTimer = Math.max(0.0, flashTimer - dt) }
  if (explosionFlash > 0.0) { explosionFlash = Math.max(0.0, explosionFlash - dt) }
  if (carShake > 0.0) { carShake = Math.max(0.0, carShake - dt * 2.8) }
  if (carAlarmCooldown > 0.0) { carAlarmCooldown = Math.max(0.0, carAlarmCooldown - dt) }
  if (recoilKick > 0.0) { recoilKick = Math.max(0.0, recoilKick - dt * 6.5) }
  if (crosshairSpread > 0.0) { crosshairSpread = Math.max(0.0, crosshairSpread - dt * 3.2) }
  if (swapAnim > 0.0) { swapAnim = Math.max(0.0, swapAnim - dt) }
  if (pumpAnim > 0.0) { pumpAnim = Math.max(0.0, pumpAnim - dt) }
  if (meleeAnim > 0.0) { meleeAnim = Math.max(0.0, meleeAnim - dt) }
  if (meleeCooldown > 0.0) { meleeCooldown = Math.max(0.0, meleeCooldown - dt) }
  if (fireCooldown > 0.0) { fireCooldown = Math.max(0.0, fireCooldown - dt) }
  if (overdriveTimer > 0.0) { overdriveTimer = Math.max(0.0, overdriveTimer - dt) }
  if (streakTimer > 0.0) {
    streakTimer = Math.max(0.0, streakTimer - dt)
    if (streakTimer <= 0.0) { streakCount = 0 }
  }
  let fi = 0
  while (fi < fireDrumFlares.length) {
    if (fireDrumFlares[fi] > 0.0) { fireDrumFlares[fi] = Math.max(0.0, fireDrumFlares[fi] - dt * 1.6) }
    fi = fi + 1
  }
  let ti = bulletTracers.length - 1
  while (ti >= 0) {
    bulletTracers[ti].life = bulletTracers[ti].life - dt
    if (bulletTracers[ti].life <= 0.0) { bulletTracers.splice(ti, 1) }
    ti = ti - 1
  }

  let moveSpeedRatio = 0.0
  if (!paused && !armoryOpen && !gameOver) {
    if (typeof window !== "undefined") {
      if (window.__scene3dYaw !== undefined) { lookYaw = window.__scene3dYaw }
      if (window.__scene3dPitch !== undefined) { lookPitch = window.__scene3dPitch }
    }

    if (reloadTimer > 0.0) {
      reloadTimer = reloadTimer - dt
      if (reloadTimer <= 0.0) { finishReloadWeapon() }
    }

    if (mouseFireHeld && WEAPONS[weaponIdx].auto && fireCooldown <= 0.0 && reloadTimer <= 0.0) {
      fireCurrentWeapon()
    }

    let fwd = (pad.up ? 1.0 : 0.0) - (pad.down ? 1.0 : 0.0)
    let strafe = (pad.right ? 1.0 : 0.0) - (pad.left ? 1.0 : 0.0)
    if (fwd !== 0.0 || strafe !== 0.0) {
      let len = Math.sqrt(fwd * fwd + strafe * strafe)
      fwd = fwd / len
      strafe = strafe / len
      let sprintMult = (pad.sprint || touchSprint) ? 1.38 : 1.0
      let speedBoost = 1.0 + perkSpeedLevel * 0.10 + (overdriveTimer > 0.0 ? 0.22 : 0.0)
      let spd = 6.2 * sprintMult * speedBoost
      let fx = Math.sin(lookYaw)
      let fz = Math.cos(lookYaw)
      let rx = -fz
      let rz = fx
      let nx = px + (fx * fwd + rx * strafe) * spd * dt
      let nz = pz + (fz * fwd + rz * strafe) * spd * dt
      let cl = resolveCircleCollisions(nx, nz, P_RADIUS)
      px = cl.x
      pz = cl.z
      moveSpeedRatio = sprintMult
      bobPhase = bobPhase + dt * 9.2 * sprintMult
    }

    nearBench = dist2D(px, pz, BENCH_X, BENCH_Z) <= 3.6

    // Low HP heartbeat
    if (hp > 0 && hp <= 28) {
      lastHeartbeatAt = lastHeartbeatAt + dt
      if (lastHeartbeatAt >= 1.1) {
        lastHeartbeatAt = 0.0
        playSfx("assets/sfx/heartbeat.wav", 0.4)
      }
    }

    // Wave Progression
    if (waveState === "between") {
      waveTimer = waveTimer - dt
      if (waveTimer <= 0.0) { startNextWave() }
    } else if (waveState === "active") {
      if (toSpawn > 0) {
        spawnCooldown = spawnCooldown - dt
        if (spawnCooldown <= 0.0 && zombies.length < 18) {
          spawnZombieFromGate()
          toSpawn = toSpawn - 1
          spawnCooldown = Math.max(0.42, 1.45 - wave * 0.09)
        }
      } else if (zombies.length === 0) {
        finishCurrentWave()
      }
    }

    updateGrenades(dt)
    updateAcidShots(dt)
    updateZombies(dt)
    updatePickups(dt)

    // Ejected Brass Shell Casings physics
    let ci = shellCasings.length - 1
    while (ci >= 0) {
      let sc = shellCasings[ci]
      sc.age = sc.age + dt
      if (sc.y > 0.02 || sc.vy > 0.0) {
        sc.vy = sc.vy - 15.0 * dt
        sc.x = sc.x + sc.vx * dt
        sc.y = sc.y + sc.vy * dt
        sc.z = sc.z + sc.vz * dt
        sc.rx = sc.rx + dt * 14.0
        sc.rz = sc.rz + dt * 11.0
        if (sc.y < 0.02) {
          sc.y = 0.02
          sc.vy = Math.abs(sc.vy) > 0.8 ? Math.abs(sc.vy) * 0.32 : 0.0
          sc.vx = sc.vx * 0.45
          sc.vz = sc.vz * 0.45
        }
      }
      if (sc.age >= 3.8) { shellCasings.splice(ci, 1) }
      ci = ci - 1
    }

    // Leaking / Fuel-hissing Hazard Barrels
    let ebi = 0
    while (ebi < explosiveBarrels.length) {
      let eb = explosiveBarrels[ebi]
      if (eb.shake > 0.0) { eb.shake = Math.max(0.0, eb.shake - dt * 2.4) }
      if (eb.alive && eb.leaking) {
        eb.fuseTimer = eb.fuseTimer - dt
        eb.leakAccum = eb.leakAccum + dt
        eb.shake = Math.max(eb.shake, 0.24)
        if (eb.leakAccum >= 0.06) {
          eb.leakAccum = 0.0
          spawnBurstParticles(eb.leakX, eb.leakY, eb.leakZ, 3, "#fb923c", 3.6, 0.14, 0.34)
        }
        if (eb.fuseTimer <= 0.0) {
          triggerBarrelBlast(ebi)
        }
      }
      ebi = ebi + 1
    }

    // Smoking / Burning Pickup Truck Hood & Cab
    if (!carExploded && carHp <= carMaxHp * 0.45) {
      carSmokeAccum = carSmokeAccum + dt
      if (carSmokeAccum >= 0.11) {
        carSmokeAccum = 0.0
        let sxHood = TRUCK_X - Math.sin(TRUCK_YAW) * 1.35
        let szHood = TRUCK_Z - Math.cos(TRUCK_YAW) * 1.35
        spawnBurstParticles(sxHood, 1.18, szHood, 2, carHp <= carMaxHp * 0.22 ? "#ea580c" : "#374151", 1.8, 0.30, 0.85)
        if (carHp <= carMaxHp * 0.22) {
          spawnBurstParticles(sxHood, 1.24, szHood, 2, "#fde047", 2.4, 0.20, 0.42)
        }
      }
    } else if (carExploded && carBurnTimer > 0.0) {
      carBurnTimer = Math.max(0.0, carBurnTimer - dt)
      carSmokeAccum = carSmokeAccum + dt
      if (carSmokeAccum >= 0.10) {
        carSmokeAccum = 0.0
        let sxWreck = TRUCK_X + (randFloat() - 0.5) * 1.1
        let szWreck = TRUCK_Z + (randFloat() - 0.5) * 1.6
        spawnBurstParticles(sxWreck, 1.15, szWreck, 2, "#ff6b1a", 2.4, 0.28, 0.52)
        spawnBurstParticles(sxWreck, 1.35, szWreck, 2, "#1f2937", 1.6, 0.42, 1.05)
      }
    }

    // Streetlamp bulb recovery after 20s
    let lri = 0
    while (lri < courtyardLamps.length) {
      let lm = courtyardLamps[lri]
      if (lm.broken) {
        lm.repairTimer = lm.repairTimer - dt
        if (lm.repairTimer <= 0.0) { lm.broken = false }
      }
      lri = lri + 1
    }
  }

  updateParticles(dt)
  updateCameraFromState(moveSpeedRatio)
  if (flashTimer > 0.0 || explosionFlash > 0.0 || hudTick % 4 === 0) {
    buildLights()
  }
  hudTick = hudTick + 1
  composeSceneFrame(moveSpeedRatio)
}

function onActionPress(action) {
  if (!started) { return }
  if (action === "pause") {
    if (armoryOpen) { closeArmoryBench(); return }
    if (!gameOver) {
      if (paused) { resumePlay() } else { paused = true; mouseFireHeld = false }
    }
    return
  }
  if (action === "armory") {
    if (armoryOpen) { closeArmoryBench(); return }
    if (!paused && !gameOver && (nearBench || waveState === "between")) {
      openArmoryBench()
    } else if (!paused && !gameOver) {
      showToast("Move near Armory Bench (-Z) or clear wave")
    }
    return
  }
  if (paused || armoryOpen || gameOver) { return }
  if (action === "reload") { startReloadWeapon() }
  else if (action === "melee") { doMeleeBash() }
  else if (action === "grenade") { throwFragGrenade() }
  else if (action === "torch") { toggleTorchLight() }
  else if (action === "w1") { selectWeapon(0) }
  else if (action === "w2") { selectWeapon(1) }
  else if (action === "w3") { selectWeapon(2) }
  else if (action === "swap") { cycleWeapon() }
  else if (action === "fire") { fireCurrentWeapon() }
}

function onSceneClick(hit) {
  if (!started || paused || armoryOpen || gameOver) { return }
  if (hit && hit.locked) {
    if (hit.button === 0) { fireCurrentWeapon(hit) }
    else if (hit.button === 2) { startReloadWeapon() }
  } else if (touchMode) {
    fireCurrentWeapon(null)
  }
}

function onSceneStats(info) {
  if (info && info.fps) {
    fpsReadout = Math.round(info.fps)
  }
}

function isLikelyTouch() {
  if (typeof window === "undefined") { return false }
  let coarse = false
  try { coarse = !!(window.matchMedia && window.matchMedia("(pointer: coarse)").matches) } catch (err) {}
  return (typeof navigator !== "undefined" && navigator.maxTouchPoints > 0) || coarse || window.innerWidth <= 860
}

function triggerTouchFire() { fireCurrentWeapon() }
function triggerTouchReload() { startReloadWeapon() }
function triggerTouchMelee() { doMeleeBash() }
function triggerTouchGrenade() { throwFragGrenade() }
function triggerTouchSwap() { cycleWeapon() }
function toggleTouchSprint() { touchSprint = !touchSprint }
function toggleTouchMode() {
  blurActiveFocus()
  touchMode = !touchMode
  if (touchMode && typeof window !== "undefined") {
    window.__scene3dReleaseLock = true
  }
}
function triggerTouchArmory() { onActionPress("armory") }
function triggerTouchTorch() { toggleTorchLight() }

function _init() {
  touchSprint = false
  touchMode = isLikelyTouch()
  arenaStaticBuilt = false
  sceneStatic = buildArenaStatic()
  resetExplosiveBarrels()
  resetDestructibleEnvironment()
  initShowcaseZombies()
  loadLeaderboard()
  try {
    if (typeof localStorage !== "undefined") {
      bestScore = parseInt(localStorage.getItem("deadhours:best") || "0") || 0
      playerName = localStorage.getItem("deadhours:name") || ""
      let q = localStorage.getItem("deadhours:quality") || "high"
      applyQualityPreset(q)
    } else {
      applyQualityPreset("high")
    }
  } catch (err) {
    applyQualityPreset("high")
  }

  if (typeof window !== "undefined") {
    if (window.__dhMouseCleanup) { window.__dhMouseCleanup() }
    function onDown(e) {
      if (e.button === 0 && window.__scene3dLocked && started && !paused && !armoryOpen && !gameOver) {
        mouseFireHeld = true
      }
    }
    function onUp(e) {
      if (e.button === 0) { mouseFireHeld = false }
    }
    function onBlurReset() {
      mouseFireHeld = false
      pad = { presses: {} }
    }
    function onTouchSeen() { touchMode = true }
    window.addEventListener("mousedown", onDown, true)
    window.addEventListener("mouseup", onUp, true)
    window.addEventListener("blur", onBlurReset)
    window.addEventListener("touchstart", onTouchSeen, { passive: true })
    window.__dhMouseCleanup = function () {
      window.removeEventListener("mousedown", onDown, true)
      window.removeEventListener("mouseup", onUp, true)
      window.removeEventListener("blur", onBlurReset)
      window.removeEventListener("touchstart", onTouchSeen)
    }
  }
  composeSceneFrame(0.0)
}

function _onHide() {
  mouseFireHeld = false
  pad = { presses: {} }
  if (started && !gameOver && !armoryOpen) {
    paused = true
  }
  if (typeof window !== "undefined" && window.__dhMouseCleanup) {
    window.__dhMouseCleanup()
    window.__dhMouseCleanup = null
  }
}
