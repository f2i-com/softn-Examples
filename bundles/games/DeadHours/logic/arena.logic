function initDeadTreeSpots() {
  if (DEAD_TREE_SPOTS.length > 0) { return }
  let ti = 0
  while (ti < 18) {
    let ang = (ti / 18) * Math.PI * 2 + 0.18
    let rad = 24.5 + (ti % 3) * 3.8
    let tx = Math.cos(ang) * rad
    let tz = Math.sin(ang) * rad
    // Keep clear of spawn gate lanes along N/E/W axes
    if (Math.abs(tx) > 4.2 || tz > 18.0) {
      DEAD_TREE_SPOTS.push({
        x: tx,
        z: tz,
        yaw: ang + (ti % 2) * 1.1,
        fit: 5.4 + (ti % 4) * 0.55
      })
    }
    ti = ti + 1
  }
}

function clampVal(v, lo, hi) {
  if (v < lo) { return lo }
  if (v > hi) { return hi }
  return v
}

function dist2D(x1, z1, x2, z2) {
  let dx = x2 - x1
  let dz = z2 - z1
  return Math.sqrt(dx * dx + dz * dz)
}

function resetDestructibleEnvironment() {
  carHp = carMaxHp
  carExploded = false
  carBurnTimer = 0.0
  carSmokeAccum = 0.0
  carShake = 0.0
  carAlarmCooldown = 0.0
  carWindshieldBroken = false
  carHeadlightLBroken = false
  carHeadlightRBroken = false
  carLightbarBroken = false
  carWheelHit = [false, false, false, false]
  carHoodHits = 0
  carDoorLHits = 0
  carDoorRHits = 0
  carTailgateHits = 0

  let li = 0
  while (li < courtyardLamps.length) {
    courtyardLamps[li].broken = false
    courtyardLamps[li].repairTimer = 0.0
    li = li + 1
  }
  fireDrumFlares = [0.0, 0.0, 0.0]
}

function resetExplosiveBarrels() {
  explosiveBarrels = []
  let i = 0
  while (i < BARREL_SPOTS.length) {
    explosiveBarrels.push({
      id: i + 1,
      x: BARREL_SPOTS[i].x,
      z: BARREL_SPOTS[i].z,
      hp: 58,
      maxHp: 58,
      alive: true,
      respawnWave: 0,
      leaking: false,
      fuseTimer: 0.0,
      leakAccum: 0.0,
      leakX: BARREL_SPOTS[i].x + 0.42,
      leakY: 0.62,
      leakZ: BARREL_SPOTS[i].z,
      leakNx: 1.0,
      leakNz: 0.0,
      shake: 0.0
    })
    i = i + 1
  }
}

function resolveCircleCollisions(cx, cz, radius) {
  let x = clampVal(cx, -HALF_ARENA + radius, HALF_ARENA - radius)
  let z = clampVal(cz, -HALF_ARENA + radius, HALF_ARENA - radius)
  let pass = 0
  while (pass < 2) {
    let i = 0
    while (i < BLOCKERS.length) {
      let b = BLOCKERS[i]
      let nearestX = clampVal(x, b.x - b.hw, b.x + b.hw)
      let nearestZ = clampVal(z, b.z - b.hd, b.z + b.hd)
      let dx = x - nearestX
      let dz = z - nearestZ
      let d2 = dx * dx + dz * dz
      if (d2 < radius * radius) {
        let d = Math.sqrt(d2)
        if (d > 0.0001) {
          let push = radius - d
          x = x + (dx / d) * push
          z = z + (dz / d) * push
        } else {
          let ox = b.hw + radius - Math.abs(x - b.x)
          let oz = b.hd + radius - Math.abs(z - b.z)
          if (ox < oz) { x = x + (x >= b.x ? ox : -ox) }
          else { z = z + (z >= b.z ? oz : -oz) }
        }
      }
      i = i + 1
    }
    let bi = 0
    while (bi < explosiveBarrels.length) {
      let eb = explosiveBarrels[bi]
      if (eb.alive) {
        let bdx = x - eb.x
        let bdz = z - eb.z
        let minD = radius + 0.45
        let bd2 = bdx * bdx + bdz * bdz
        if (bd2 < minD * minD) {
          let bd = Math.sqrt(bd2)
          if (bd > 0.001) {
            let bp = minD - bd
            x = x + (bdx / bd) * bp
            z = z + (bdz / bd) * bp
          }
        }
      }
      bi = bi + 1
    }
    pass = pass + 1
  }
  return { x: clampVal(x, -HALF_ARENA + radius, HALF_ARENA - radius), z: clampVal(z, -HALF_ARENA + radius, HALF_ARENA - radius) }
}

// Analytical Ray vs AABB returning distance t and outward surface normal
function rayAABBWithNormal(ox, oy, oz, dx, dy, dz, minX, minY, minZ, maxX, maxY, maxZ, maxT) {
  let tmin = 0.05
  let tmax = maxT
  let nx = 0.0
  let ny = 1.0
  let nz = 0.0

  if (Math.abs(dx) < 0.00001) {
    if (ox < minX || ox > maxX) { return null }
  } else {
    let invX = 1.0 / dx
    let t1 = (minX - ox) * invX
    let t2 = (maxX - ox) * invX
    let s1 = -1.0
    if (t1 > t2) { let tmp = t1; t1 = t2; t2 = tmp; s1 = 1.0 }
    if (t1 > tmin) { tmin = t1; nx = s1; ny = 0.0; nz = 0.0 }
    if (t2 < tmax) { tmax = t2 }
    if (tmin > tmax) { return null }
  }

  if (Math.abs(dy) < 0.00001) {
    if (oy < minY || oy > maxY) { return null }
  } else {
    let invY = 1.0 / dy
    let t1y = (minY - oy) * invY
    let t2y = (maxY - oy) * invY
    let sy1 = -1.0
    if (t1y > t2y) { let tmpy = t1y; t1y = t2y; t2y = tmpy; sy1 = 1.0 }
    if (t1y > tmin) { tmin = t1y; nx = 0.0; ny = sy1; nz = 0.0 }
    if (t2y < tmax) { tmax = t2y }
    if (tmin > tmax) { return null }
  }

  if (Math.abs(dz) < 0.00001) {
    if (oz < minZ || oz > maxZ) { return null }
  } else {
    let invZ = 1.0 / dz
    let t1z = (minZ - oz) * invZ
    let t2z = (maxZ - oz) * invZ
    let sz1 = -1.0
    if (t1z > t2z) { let tmpz = t1z; t1z = t2z; t2z = tmpz; sz1 = 1.0 }
    if (t1z > tmin) { tmin = t1z; nx = 0.0; ny = 0.0; nz = sz1 }
    if (t2z < tmax) { tmax = t2z }
    if (tmin > tmax) { return null }
  }

  if (tmin <= 0.05 || tmin >= maxT) { return null }
  return { t: tmin, nx: nx, ny: ny, nz: nz }
}

// Analytical Ray vs Y-aligned Cylinder returning distance t and outward surface normal
function rayCylinderWithNormal(ox, oy, oz, dx, dy, dz, cx, cz, rad, minY, maxY, maxT) {
  let rx = ox - cx
  let rz = oz - cz
  let bestT = maxT
  let bnx = 0.0
  let bny = 1.0
  let bnz = 0.0
  let found = false

  let a = dx * dx + dz * dz
  if (a > 0.00001) {
    let b = 2.0 * (rx * dx + rz * dz)
    let c = rx * rx + rz * rz - rad * rad
    let disc = b * b - 4.0 * a * c
    if (disc >= 0.0) {
      let sq = Math.sqrt(disc)
      let tSide = (-b - sq) / (2.0 * a)
      if (tSide > 0.05 && tSide < bestT) {
        let hy = oy + dy * tSide
        if (hy >= minY && hy <= maxY) {
          let hx = rx + dx * tSide
          let hz = rz + dz * tSide
          let hl = Math.max(0.001, Math.sqrt(hx * hx + hz * hz))
          bestT = tSide
          bnx = hx / hl
          bny = 0.0
          bnz = hz / hl
          found = true
        }
      }
    }
  }

  if (Math.abs(dy) > 0.0001) {
    let tTop = (maxY - oy) / dy
    if (tTop > 0.05 && tTop < bestT) {
      let tx = rx + dx * tTop
      let tz = rz + dz * tTop
      if (tx * tx + tz * tz <= rad * rad) {
        bestT = tTop
        bnx = 0.0
        bny = dy < 0 ? 1.0 : -1.0
        bnz = 0.0
        found = true
      }
    }
  }

  if (!found) { return null }
  return { t: bestT, nx: bnx, ny: bny, nz: bnz }
}

// Analytical Ray vs Y-rotated OBB
function rayOBBWithNormal(ox, oy, oz, dx, dy, dz, cx, cz, yaw, minX, minY, minZ, maxX, maxY, maxZ, maxT) {
  let cs = Math.cos(yaw)
  let sn = Math.sin(yaw)
  let pxRel = ox - cx
  let pzRel = oz - cz
  let lox = pxRel * cs - pzRel * sn
  let loz = pxRel * sn + pzRel * cs
  let ldx = dx * cs - dz * sn
  let ldz = dx * sn + dz * cs
  let hit = rayAABBWithNormal(lox, oy, loz, ldx, dy, ldz, minX, minY, minZ, maxX, maxY, maxZ, maxT)
  if (!hit) { return null }
  return {
    t: hit.t,
    nx: hit.nx * cs + hit.nz * sn,
    ny: hit.ny,
    nz: -hit.nx * sn + hit.nz * cs,
    lx: lox + ldx * hit.t,
    ly: oy + dy * hit.t,
    lz: loz + ldz * hit.t,
    lnx: hit.nx,
    lny: hit.ny,
    lnz: hit.nz
  }
}

// Legacy scalar blocker test (kept for simple LOS helpers)
function rayHitsArenaBlocker(ox, oy, oz, dx, dy, dz, maxT) {
  let closest = maxT
  let i = 0
  while (i < BLOCKERS.length) {
    let b = BLOCKERS[i]
    let res = rayAABBWithNormal(ox, oy, oz, dx, dy, dz, b.x - b.hw, 0.0, b.z - b.hd, b.x + b.hw, b.h, b.z + b.hd, closest)
    if (res && res.t < closest) { closest = res.t }
    i = i + 1
  }
  return closest
}

// Full high-precision environmental raycast against walls, truck subparts, barrels, lamps, watchtower, headstones, trees & floor
function rayHitEnvironment(ox, oy, oz, dx, dy, dz, maxT) {
  let best = {
    hit: false,
    t: maxT,
    kind: "none",
    id: -1,
    part: "",
    material: "stone",
    hx: ox + dx * maxT,
    hy: oy + dy * maxT,
    hz: oz + dz * maxT,
    nx: 0.0,
    ny: 1.0,
    nz: 0.0
  }

  function consider(res, kind, id, part, material) {
    if (res && res.t > 0.05 && res.t < best.t) {
      best.hit = true
      best.t = res.t
      best.kind = kind
      best.id = id
      best.part = part
      best.material = material
      best.hx = ox + dx * res.t
      best.hy = oy + dy * res.t
      best.hz = oz + dz * res.t
      best.nx = res.nx
      best.ny = res.ny
      best.nz = res.nz
      if (res.lx !== undefined) {
        best.lx = res.lx; best.ly = res.ly; best.lz = res.lz
        best.lnx = res.lnx; best.lny = res.lny; best.lnz = res.lnz
      }
    }
  }

  // 1. Hazard Barrels (exact cylinder)
  let bi = 0
  while (bi < explosiveBarrels.length) {
    let eb = explosiveBarrels[bi]
    if (eb.alive) {
      let bRes = rayCylinderWithNormal(ox, oy, oz, dx, dy, dz, eb.x, eb.z, 0.44, 0.0, 1.16, best.t)
      consider(bRes, "barrel", bi, "drum", "metal")
    }
    bi = bi + 1
  }

  // 2. Pickup Truck Wreck OBB Subparts (local coords glTF: -Z front, +Z back)
  let truckParts = [
    { part: "lightbar", mat: carLightbarBroken ? "metal" : "glass", mnX: -0.44, mnY: 1.74, mnZ: -0.58, mxX: 0.44, mxY: 1.88, mxZ: -0.32 },
    { part: "headlightL", mat: carHeadlightLBroken ? "metal" : "glass", mnX: -0.88, mnY: 0.74, mnZ: -2.26, mxX: -0.60, mxY: 0.94, mxZ: -2.05 },
    { part: "headlightR", mat: carHeadlightRBroken ? "metal" : "glass", mnX: 0.60, mnY: 0.74, mnZ: -2.26, mxX: 0.88, mxY: 0.94, mxZ: -2.05 },
    { part: "wheelFL", mat: "rubber", mnX: -1.14, mnY: 0.0, mnZ: -1.80, mxX: -0.82, mxY: 0.82, mxZ: -0.96 },
    { part: "wheelFR", mat: "rubber", mnX: 0.82, mnY: 0.0, mnZ: -1.80, mxX: 1.14, mxY: 0.82, mxZ: -0.96 },
    { part: "wheelRL", mat: "rubber", mnX: -1.14, mnY: 0.0, mnZ: 0.94, mxX: -0.82, mxY: 0.82, mxZ: 1.78 },
    { part: "wheelRR", mat: "rubber", mnX: 0.82, mnY: 0.0, mnZ: 0.94, mxX: 1.14, mxY: 0.82, mxZ: 1.78 },
    { part: "hood", mat: "metal", mnX: -0.98, mnY: 0.36, mnZ: -2.22, mxX: 0.98, mxY: 1.10, mxZ: -0.86 },
    { part: "cab", mat: "metal", mnX: -1.04, mnY: 0.36, mnZ: -0.88, mxX: 1.04, mxY: 1.06, mxZ: 0.10 },
    { part: "cab", mat: "metal", mnX: -1.04, mnY: 1.06, mnZ: -0.52, mxX: 1.04, mxY: 1.76, mxZ: 0.10 },
    { part: "cab", mat: "metal", mnX: -1.02, mnY: 1.66, mnZ: -0.72, mxX: 1.02, mxY: 1.78, mxZ: -0.48 },
    { part: "tailgate", mat: "metal", mnX: -0.92, mnY: 0.52, mnZ: 2.08, mxX: 0.92, mxY: 1.12, mxZ: 2.28 },
    { part: "bed", mat: "metal", mnX: -0.99, mnY: 0.40, mnZ: 0.08, mxX: -0.78, mxY: 1.14, mxZ: 2.22 },
    { part: "bed", mat: "metal", mnX: 0.78, mnY: 0.40, mnZ: 0.08, mxX: 0.99, mxY: 1.14, mxZ: 2.22 },
    { part: "bed", mat: "metal", mnX: -0.84, mnY: 0.38, mnZ: 0.08, mxX: 0.84, mxY: 0.98, mxZ: 2.15 }
  ]
  if (!carWindshieldBroken) {
    let wsRes = rayOBBWithNormal(ox, oy, oz, dx, dy, dz, TRUCK_X, TRUCK_Z, TRUCK_YAW, -0.82, 1.06, -0.88, 0.82, 1.68, -0.52, best.t)
    consider(wsRes, "car", 0, "windshield", "glass")
  }
  let tpi = 0
  while (tpi < truckParts.length) {
    let tp = truckParts[tpi]
    let tr = rayOBBWithNormal(ox, oy, oz, dx, dy, dz, TRUCK_X, TRUCK_Z, TRUCK_YAW, tp.mnX, tp.mnY, tp.mnZ, tp.mxX, tp.mxY, tp.mxZ, best.t)
    consider(tr, "car", 0, tp.part, tp.mat)
    tpi = tpi + 1
  }

  // 3. Fire Drum Braziers
  let fdi = 0
  while (fdi < FIRE_DRUMS.length) {
    let fd = FIRE_DRUMS[fdi]
    let fRes = rayCylinderWithNormal(ox, oy, oz, dx, dy, dz, fd.x, fd.z, 0.37, 0.0, 1.06, best.t)
    consider(fRes, "firedrum", fdi, "drum", "metal")
    fdi = fdi + 1
  }

  // 4. Streetlamps (glass lantern bulb at y 4.08..4.58, iron post below)
  let li = 0
  while (li < courtyardLamps.length) {
    let lm = courtyardLamps[li]
    let bulbRes = rayCylinderWithNormal(ox, oy, oz, dx, dy, dz, lm.x, lm.z, 0.24, 4.06, 4.62, best.t)
    consider(bulbRes, "lamp", li, "bulb", lm.broken ? "metal" : "glass")
    let postRes = rayCylinderWithNormal(ox, oy, oz, dx, dy, dz, lm.x, lm.z, 0.14, 0.0, 4.06, best.t)
    consider(postRes, "lamp", li, "post", "metal")
    li = li + 1
  }

  // 5. Watchtower (NE at 11.5, -10.5, yaw -0.45): corners, deck, parapet & roof
  let twDeck = rayOBBWithNormal(ox, oy, oz, dx, dy, dz, 11.5, -10.5, -0.45, -1.50, 4.18, -1.50, 1.50, 5.34, 1.50, best.t)
  consider(twDeck, "tower", 0, "deck", "wood")
  let twRoof = rayOBBWithNormal(ox, oy, oz, dx, dy, dz, 11.5, -10.5, -0.45, -1.54, 6.45, -1.54, 1.54, 6.72, 1.54, best.t)
  consider(twRoof, "tower", 0, "roof", "metal")
  let legOffs = [[-1.24, -1.24], [1.24, -1.24], [-1.24, 1.24], [1.24, 1.24]]
  let lgi = 0
  while (lgi < 4) {
    let lo = legOffs[lgi]
    let legR = rayOBBWithNormal(ox, oy, oz, dx, dy, dz, 11.5, -10.5, -0.45, lo[0] - 0.16, 0.0, lo[1] - 0.16, lo[0] + 0.16, 4.22, lo[1] + 0.16, best.t)
    consider(legR, "tower", 0, "leg", "wood")
    lgi = lgi + 1
  }

  // 6. Central Obelisk (stone base + plinth + upper spire prism)
  consider(rayAABBWithNormal(ox, oy, oz, dx, dy, dz, -1.15, 0.0, 0.35, 1.15, 0.52, 2.65, best.t), "world", 0, "obelisk", "stone")
  consider(rayAABBWithNormal(ox, oy, oz, dx, dy, dz, -0.68, 0.50, 0.82, 0.68, 1.82, 2.18, best.t), "world", 0, "obelisk", "stone")
  consider(rayAABBWithNormal(ox, oy, oz, dx, dy, dz, -0.42, 1.80, 1.08, 0.42, 3.25, 1.92, best.t), "world", 0, "obelisk", "stone")

  // 7. Armory Bench (wood)
  consider(rayAABBWithNormal(ox, oy, oz, dx, dy, dz, BENCH_X - 1.24, 0.0, BENCH_Z - 0.50, BENCH_X + 1.24, 1.12, BENCH_Z + 0.50, best.t), "bench", 0, "bench", "wood")

  // 8. Courtyard Barricades (concrete/stone)
  let bri = 0
  while (bri < BARRICADES.length) {
    let br = BARRICADES[bri]
    consider(rayAABBWithNormal(ox, oy, oz, dx, dy, dz, br.x - br.w * 0.5, 0.0, br.z - br.d * 0.5, br.x + br.w * 0.5, br.h + 0.08, br.z + br.d * 0.5, best.t), "world", bri, br.id, "stone")
    bri = bri + 1
  }

  // 9. Perimeter Masonry Walls & Gate Piers (stone) + Iron Gates (metal)
  let wi = 0
  while (wi < WALL_SEGS.length) {
    let ws = WALL_SEGS[wi]
    consider(rayAABBWithNormal(ox, oy, oz, dx, dy, dz, ws.x - ws.w * 0.5, 0.0, ws.z - ws.d * 0.5, ws.x + ws.w * 0.5, ws.h + 0.12, ws.z + ws.d * 0.5, best.t), "world", wi, ws.id, "stone")
    wi = wi + 1
  }
  let piers = [[-2.55, -19.2], [2.55, -19.2], [-19.2, -2.55], [-19.2, 2.55], [19.2, -2.55], [19.2, 2.55]]
  let pii = 0
  while (pii < piers.length) {
    let pr = piers[pii]
    consider(rayAABBWithNormal(ox, oy, oz, dx, dy, dz, pr[0] - 0.48, 0.0, pr[1] - 0.48, pr[0] + 0.48, 3.85, pr[1] + 0.48, best.t), "world", pii, "pier", "stone")
    pii = pii + 1
  }
  // Iron Gate overhead arch & lock leaves
  consider(rayAABBWithNormal(ox, oy, oz, dx, dy, dz, -2.2, 3.45, -19.4, 2.2, 4.15, -19.0, best.t), "world", 0, "gate-n", "metal")
  consider(rayAABBWithNormal(ox, oy, oz, dx, dy, dz, -19.4, 3.45, -2.2, -19.0, 4.15, 2.2, best.t), "world", 1, "gate-w", "metal")
  consider(rayAABBWithNormal(ox, oy, oz, dx, dy, dz, 19.0, 3.45, -2.2, 19.4, 4.15, 2.2, best.t), "world", 2, "gate-e", "metal")

  // 10. Graveyard Headstones
  let gi = 0
  while (gi < GRAVESTONES.length) {
    let gs = GRAVESTONES[gi]
    consider(rayOBBWithNormal(ox, oy, oz, dx, dy, dz, gs.x, gs.z, gs.yaw, -0.38, 0.0, -0.14, 0.38, 1.18 * gs.scale, 0.14, best.t), "world", gi, "stone", "stone")
    gi = gi + 1
  }

  // 11. Perimeter Dead Oak Trees
  initDeadTreeSpots()
  let dti = 0
  while (dti < DEAD_TREE_SPOTS.length) {
    let dtSpot = DEAD_TREE_SPOTS[dti]
    consider(rayCylinderWithNormal(ox, oy, oz, dx, dy, dz, dtSpot.x, dtSpot.z, 0.44, 0.0, 4.8, best.t), "tree", dti, "trunk", "wood")
    dti = dti + 1
  }

  // 12. Courtyard & Outer Ground Plane (y = 0)
  if (dy < -0.004) {
    let gt = -oy / dy
    if (gt > 0.1 && gt < best.t) {
      let gx = ox + dx * gt
      let gz = oz + dz * gt
      consider({ t: gt, nx: 0.0, ny: 1.0, nz: 0.0 }, "ground", 0, "floor", (Math.abs(gx) <= 20.0 && Math.abs(gz) <= 20.0) ? "stone" : "wood")
    }
  }

  return best
}

function buildArenaStatic() {
  if (arenaStaticBuilt) { return arenaStaticList }
  arenaStaticBuilt = true
  initDeadTreeSpots()
  let out = []

  // Ground: textured dark moonlit quarry stone pavers + outer earth apron
  out.push({
    id: "ground-yard",
    type: "plane",
    position: { x: 0, y: 0, z: 0 },
    rotation: { x: -Math.PI / 2, y: 0, z: 0 },
    width: 40,
    height: 40,
    color: "#222936",
    roughness: 0.64,
    metalness: 0.16,
    texture: "stone",
    textureRepeat: { x: 14, y: 14 },
    bumpScale: 0.045,
    receiveShadow: true,
    castShadow: false
  })
  out.push({
    id: "ground-outer",
    type: "plane",
    position: { x: 0, y: -0.04, z: 0 },
    rotation: { x: -Math.PI / 2, y: 0, z: 0 },
    width: 118,
    height: 118,
    color: "#0e131b",
    roughness: 0.94,
    metalness: 0.04,
    texture: "noise",
    textureRepeat: { x: 18, y: 18 },
    bumpScale: 0.03,
    receiveShadow: true,
    castShadow: false
  })

  // Recessed stone walkway flagstones across main lanes
  out.push({
    id: "walk-north",
    type: "box",
    position: { x: 0, y: 0.008, z: -10.5 },
    width: 3.1,
    height: 0.02,
    depth: 16.5,
    color: "#2c3647",
    texture: "stone",
    textureRepeat: { x: 2, y: 8 },
    bumpScale: 0.035,
    roughness: 0.66,
    metalness: 0.12,
    receiveShadow: true,
    castShadow: false
  })
  out.push({
    id: "walk-cross",
    type: "box",
    position: { x: 0, y: 0.006, z: 0.0 },
    width: 34.0,
    height: 0.016,
    depth: 2.6,
    color: "#293242",
    texture: "stone",
    textureRepeat: { x: 16, y: 2 },
    bumpScale: 0.035,
    roughness: 0.68,
    metalness: 0.12,
    receiveShadow: true,
    castShadow: false
  })

  // Midnight full moon & misty halo high above north gate
  out.push({
    id: "sky-moon",
    type: "sphere",
    position: { x: -24, y: 28, z: -56 },
    radius: 3.2,
    color: "#e2ecff",
    emissive: "#bfd6ff",
    emissiveIntensity: 1.85,
    fog: false,
    castShadow: false
  })
  out.push({
    id: "sky-moon-halo",
    type: "sphere",
    position: { x: -24, y: 28, z: -56.4 },
    radius: 5.4,
    color: "#8db4ff",
    emissive: "#78a4ff",
    emissiveIntensity: 0.65,
    opacity: 0.22,
    fog: false,
    castShadow: false
  })

  // Central stone memorial fountain/obelisk
  out.push({
    id: "mem-base",
    type: "box",
    position: { x: 0, y: 0.25, z: 1.5 },
    width: 2.3,
    height: 0.5,
    depth: 2.3,
    color: "#323b49",
    texture: "stone",
    textureRepeat: { x: 2, y: 1 },
    bumpScale: 0.04,
    roughness: 0.82,
    castShadow: true,
    receiveShadow: true
  })
  out.push({
    id: "mem-plinth",
    type: "box",
    position: { x: 0, y: 1.15, z: 1.5 },
    width: 1.35,
    height: 1.3,
    depth: 1.35,
    color: "#3d4758",
    texture: "stone",
    textureRepeat: { x: 2, y: 2 },
    bumpScale: 0.04,
    roughness: 0.78,
    castShadow: true,
    receiveShadow: true
  })
  out.push({
    id: "mem-plaque",
    type: "box",
    position: { x: 0, y: 1.15, z: 2.18 },
    width: 0.82,
    height: 0.56,
    depth: 0.04,
    color: "#8b6d3f",
    metalness: 0.42,
    roughness: 0.56,
    castShadow: false
  })
  out.push({
    id: "mem-spire",
    type: "cone",
    position: { x: 0, y: 2.55, z: 1.5 },
    radius: 0.52,
    height: 1.6,
    color: "#4a566b",
    texture: "stone",
    textureRepeat: { x: 2, y: 2 },
    bumpScale: 0.035,
    roughness: 0.72,
    castShadow: true,
    receiveShadow: true
  })

  // Perimeter masonry walls with stone coping caps
  let wi = 0
  while (wi < WALL_SEGS.length) {
    let ws = WALL_SEGS[wi]
    out.push({
      id: ws.id,
      type: "box",
      position: { x: ws.x, y: ws.h * 0.5, z: ws.z },
      width: ws.w,
      height: ws.h,
      depth: ws.d,
      color: "#2b3341",
      texture: "brick",
      textureRepeat: { x: Math.max(4, Math.round(ws.w > ws.d ? ws.w * 0.7 : ws.d * 0.7)), y: 2 },
      bumpScale: 0.045,
      roughness: 0.86,
      castShadow: true,
      receiveShadow: true
    })
    out.push({
      id: ws.id + "-cap",
      type: "box",
      position: { x: ws.x, y: ws.h + 0.06, z: ws.z },
      width: ws.w + (ws.w < 2.0 ? 0.14 : 0.0),
      height: 0.12,
      depth: ws.d + (ws.d < 2.0 ? 0.14 : 0.0),
      color: "#3f4a5c",
      texture: "stone",
      textureRepeat: { x: Math.max(2, Math.round((ws.w > ws.d ? ws.w : ws.d) * 0.5)), y: 1 },
      bumpScale: 0.03,
      roughness: 0.78,
      castShadow: true,
      receiveShadow: true
    })
    wi = wi + 1
  }

  // Sandbag & concrete barricades with weathered timber top rails
  let bi = 0
  while (bi < BARRICADES.length) {
    let br = BARRICADES[bi]
    out.push({
      id: br.id,
      type: "box",
      position: { x: br.x, y: br.h * 0.5, z: br.z },
      width: br.w,
      height: br.h,
      depth: br.d,
      color: br.c,
      texture: "concrete",
      textureRepeat: { x: 3, y: 1 },
      bumpScale: 0.04,
      roughness: 0.86,
      castShadow: true,
      receiveShadow: true
    })
    out.push({
      id: br.id + "-beam",
      type: "box",
      position: { x: br.x, y: br.h + 0.05, z: br.z },
      width: br.w + 0.06,
      height: 0.10,
      depth: br.d * 0.62,
      color: "#4a3728",
      texture: "wood",
      textureRepeat: { x: 2, y: 1 },
      bumpScale: 0.03,
      roughness: 0.85,
      castShadow: true,
      receiveShadow: true
    })
    bi = bi + 1
  }

  // Fire-drum metal shells (dynamic burning coals are rendered in dynamic layer so hitting stirs embers)
  let fi = 0
  while (fi < FIRE_DRUMS.length) {
    let fd = FIRE_DRUMS[fi]
    out.push({
      id: fd.id,
      type: "cylinder",
      position: { x: fd.x, y: 0.52, z: fd.z },
      radius: 0.36,
      height: 1.04,
      color: "#2c2421",
      texture: "rust",
      textureRepeat: { x: 2, y: 1 },
      bumpScale: 0.04,
      metalness: 0.68,
      roughness: 0.54,
      castShadow: true,
      receiveShadow: true
    })
    fi = fi + 1
  }

  // Static Monumental Architecture (.glb)
  out.push({
    id: "gate-north",
    type: "model",
    modelUrl: "assets/models/iron-gate.glb",
    fit: 5.5,
    position: { x: 0, y: 0, z: -19.2 },
    rotation: { x: 0, y: 0, z: 0 },
    castShadow: true,
    receiveShadow: true
  })
  out.push({
    id: "gate-west",
    type: "model",
    modelUrl: "assets/models/iron-gate.glb",
    fit: 5.5,
    position: { x: -19.2, y: 0, z: 0 },
    rotation: { x: 0, y: Math.PI / 2, z: 0 },
    castShadow: true,
    receiveShadow: true
  })
  out.push({
    id: "gate-east",
    type: "model",
    modelUrl: "assets/models/iron-gate.glb",
    fit: 5.5,
    position: { x: 19.2, y: 0, z: 0 },
    rotation: { x: 0, y: Math.PI / 2, z: 0 },
    castShadow: true,
    receiveShadow: true
  })
  out.push({
    id: "guard-watchtower",
    type: "model",
    modelUrl: "assets/models/watchtower.glb",
    fit: 6.8,
    position: { x: 11.5, y: 0, z: -10.5 },
    rotation: { x: 0, y: -0.45, z: 0 },
    castShadow: true,
    receiveShadow: true
  })
  out.push({
    id: "armory-bench",
    type: "model",
    modelUrl: "assets/models/supply-bench.glb",
    fit: 2.5,
    position: { x: BENCH_X, y: 0, z: BENCH_Z },
    rotation: { x: 0, y: 0, z: 0 },
    castShadow: true,
    receiveShadow: true
  })

  // Instanced wrought-iron spikes atop perimeter masonry walls
  let pikePos = []
  let p = -18.5
  while (p <= 18.5) {
    if (Math.abs(p) > 3.2) {
      pikePos.push(p, 2.55, -19.6)
      pikePos.push(-19.6, 2.55, p)
      pikePos.push(19.6, 2.55, p)
    }
    pikePos.push(p, 2.75, 19.6)
    p = p + 1.35
  }
  out.push({
    id: "inst-pikes",
    type: "instanced",
    shape: "cylinder",
    radius: 0.045,
    height: 0.85,
    color: "#1a202c",
    metalness: 0.85,
    roughness: 0.42,
    instances: pikePos,
    castShadow: true
  })

  // Textured graveyard headstones with concrete curbs
  let gi = 0
  while (gi < GRAVESTONES.length) {
    let g = GRAVESTONES[gi]
    out.push({
      id: "grave-" + gi,
      type: "box",
      position: { x: g.x, y: 0.57 * g.scale, z: g.z },
      rotation: { x: g.yaw * 0.25, y: g.yaw, z: 0.03 },
      width: 0.72,
      height: 1.14 * g.scale,
      depth: 0.22,
      color: "#465061",
      texture: "stone",
      textureRepeat: { x: 1, y: 2 },
      bumpScale: 0.035,
      roughness: 0.88,
      castShadow: true,
      receiveShadow: true
    })
    out.push({
      id: "grave-base-" + gi,
      type: "box",
      position: { x: g.x, y: 0.07, z: g.z },
      rotation: { x: 0, y: g.yaw, z: 0 },
      width: 0.94,
      height: 0.14,
      depth: 0.44,
      color: "#2e3644",
      texture: "concrete",
      roughness: 0.90,
      receiveShadow: true
    })
    gi = gi + 1
  }

  // Gnarled gothic dead cemetery trees framing perimeter horizon
  let dti = 0
  while (dti < DEAD_TREE_SPOTS.length) {
    let ts = DEAD_TREE_SPOTS[dti]
    out.push({
      id: "dtree-" + dti,
      type: "model",
      modelUrl: "assets/models/dead-tree.glb",
      fit: ts.fit,
      position: { x: ts.x, y: -0.05, z: ts.z },
      rotation: { x: 0, y: ts.yaw, z: 0 },
      castShadow: false,
      receiveShadow: false
    })
    dti = dti + 1
  }

  arenaStaticList = out
  return arenaStaticList
}
