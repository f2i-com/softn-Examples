// DeadHours — Weapons, hitscan/clickHit ballistics, destructible car/barrels, decals, tracers, casings & 3D .glb viewmodel parts

let WEAPONS = [
  {
    id: "pistol",
    name: "M9 Tactical",
    shortName: "9mm Pistol",
    modelUrl: "assets/models/weapon-pistol.glb",
    mag: 14,
    startReserve: -1,
    dmg: 42,
    headMult: 2.35,
    pellets: 1,
    spread: 0.011,
    rate: 0.21,
    reloadSec: 1.15,
    auto: false,
    sfx: "assets/sfx/pistol.wav",
    pos: { x: 0.19, y: -0.19, z: -0.34 },
    recoilPos: 0.045,
    recoilPitch: 0.16
  },
  {
    id: "shotgun",
    name: "M870 Combat",
    shortName: "12G Shotgun",
    modelUrl: "assets/models/weapon-shotgun.glb",
    mag: 6,
    startReserve: 24,
    dmg: 18,
    headMult: 1.75,
    pellets: 8,
    spread: 0.068,
    rate: 0.78,
    reloadSec: 1.85,
    auto: false,
    sfx: "assets/sfx/shotgun.wav",
    pos: { x: 0.21, y: -0.22, z: -0.36 },
    recoilPos: 0.085,
    recoilPitch: 0.28
  },
  {
    id: "smg",
    name: "MP-X Suppressed",
    shortName: "9mm SMG",
    modelUrl: "assets/models/weapon-smg.glb",
    mag: 32,
    startReserve: 128,
    dmg: 22,
    headMult: 2.0,
    pellets: 1,
    spread: 0.024,
    rate: 0.095,
    reloadSec: 1.45,
    auto: true,
    sfx: "assets/sfx/smg.wav",
    pos: { x: 0.20, y: -0.20, z: -0.35 },
    recoilPos: 0.032,
    recoilPitch: 0.10
  }
]

let weaponIdx = 0
let weaponUnlocked = [true, true, false]
let magAmmo = [14, 6, 32]
let resAmmo = [-1, 24, 0]
let grenadesLeft = 2
let fireCooldown = 0.0
let reloadTimer = 0.0
let reloadDuration = 1.0
let pumpAnim = 0.0
let meleeAnim = 0.0
let meleeCooldown = 0.0
let flashTimer = 0.0
let recoilKick = 0.0
let swapAnim = 0.0
let crosshairSpread = 0.0

// Upgrade ranks bought at Armory Bench
let perkDmgLevel = 0      // +18% per level (max 3)
let perkReloadLevel = 0   // +22% speed per level (max 3)
let perkSpeedLevel = 0    // +10% move speed per level (max 2)
let armorPts = 0
let maxArmor = 100

let thrownGrenades = []
let nextGid = 1
let decals = []
let nextDecalId = 1
let bulletTracers = []
let nextTracerId = 1
let shellCasings = []
let nextCasingId = 1
let explosionFlash = 0.0
let explosionX = 0.0
let explosionY = 1.0
let explosionZ = 0.0

function resetWeaponsState() {
  weaponIdx = 0
  weaponUnlocked = [true, true, false]
  magAmmo = [WEAPONS[0].mag, WEAPONS[1].mag, WEAPONS[2].mag]
  resAmmo = [-1, WEAPONS[1].startReserve, 0]
  grenadesLeft = 2
  fireCooldown = 0.0
  reloadTimer = 0.0
  reloadDuration = 1.0
  pumpAnim = 0.0
  meleeAnim = 0.0
  meleeCooldown = 0.0
  flashTimer = 0.0
  recoilKick = 0.0
  swapAnim = 0.28
  crosshairSpread = 0.0
  perkDmgLevel = 0
  perkReloadLevel = 0
  perkSpeedLevel = 0
  armorPts = 25
  thrownGrenades = []
  decals = []
  bulletTracers = []
  shellCasings = []
  explosionFlash = 0.0
}

function effectiveDamage(base) {
  return base * (1.0 + perkDmgLevel * 0.18)
}

function effectiveReloadTime(sec) {
  return sec / (1.0 + perkReloadLevel * 0.22)
}

function addSurfaceDecal(tex, x, y, z, nx, ny, nz, size, color, extra) {
  let offset = tex === "bullethole" ? 0.015 : 0.012
  let item = {
    id: nextDecalId,
    tex: tex,
    x: x + nx * offset,
    y: Math.max(0.014, y + ny * offset),
    z: z + nz * offset,
    nx: nx,
    ny: ny,
    nz: nz,
    size: size,
    color: color || "#ffffff",
    rot: randFloat() * Math.PI * 2,
    age: 0.0,
    carLocal: !!(extra && extra.carLocal),
    carPart: (extra && extra.carPart) || "",
    lx: (extra && extra.lx !== undefined) ? (extra.lx + extra.lnx * offset) : 0.0,
    ly: (extra && extra.ly !== undefined) ? (extra.ly + extra.lny * offset) : 0.0,
    lz: (extra && extra.lz !== undefined) ? (extra.lz + extra.lnz * offset) : 0.0,
    lnx: (extra && extra.lnx !== undefined) ? extra.lnx : 0.0,
    lny: (extra && extra.lny !== undefined) ? extra.lny : 1.0,
    lnz: (extra && extra.lnz !== undefined) ? extra.lnz : 0.0,
    barrelId: (extra && extra.barrelId) || 0
  }
  nextDecalId = nextDecalId + 1
  if (decals.length >= 76) {
    let remIdx = -1
    let di = 0
    while (di < decals.length) {
      if (decals[di].tex !== "scorch") { remIdx = di; break }
      di = di + 1
    }
    decals.splice(remIdx >= 0 ? remIdx : 0, 1)
  }
  decals.push(item)
}

function removeCarPartDecals(partName) {
  let di = decals.length - 1
  while (di >= 0) {
    if (decals[di].carLocal && decals[di].carPart === partName) {
      decals.splice(di, 1)
    }
    di = di - 1
  }
}

function removeBarrelDecals(bid) {
  let di = decals.length - 1
  while (di >= 0) {
    if (decals[di].barrelId === bid) {
      decals.splice(di, 1)
    }
    di = di - 1
  }
}

function spawnShellCasing(kindIdx) {
  if (shellCasings.length >= 16) { shellCasings.shift() }
  let fx = Math.sin(lookYaw)
  let fz = Math.cos(lookYaw)
  let rx = -fz
  let rz = fx
  let rightSpd = 1.9 + randFloat() * 1.1
  let backSpd = -0.35 + (randFloat() - 0.5) * 0.4
  shellCasings.push({
    id: nextCasingId,
    x: px + fx * 0.34 + rx * 0.24,
    y: P_EYE - 0.16,
    z: pz + fz * 0.34 + rz * 0.24,
    vx: rx * rightSpd + fx * backSpd,
    vy: 1.45 + randFloat() * 0.85,
    vz: rz * rightSpd + fz * backSpd,
    rx: randFloat() * 6.28,
    rz: randFloat() * 6.28,
    age: 0.0,
    shotgun: kindIdx === 1
  })
  nextCasingId = nextCasingId + 1
}

function spawnTracerBolt(ax, ay, az, bx, by, bz, color) {
  if (bulletTracers.length >= 12) { bulletTracers.shift() }
  let dx = bx - ax
  let dy = by - ay
  let dz = bz - az
  let len = Math.sqrt(dx * dx + dy * dy + dz * dz)
  if (len < 0.8) { return }
  let showLen = Math.min(len * 0.72, 9.5)
  let tStart = 0.25 + randFloat() * Math.max(0.0, len - showLen - 0.3)
  let mx = ax + (dx / len) * (tStart + showLen * 0.5)
  let my = ay + (dy / len) * (tStart + showLen * 0.5)
  let mz = az + (dz / len) * (tStart + showLen * 0.5)
  bulletTracers.push({
    id: nextTracerId,
    mx: mx,
    my: my,
    mz: mz,
    tx: mx + dx,
    ty: my + dy,
    tz: mz + dz,
    len: showLen,
    color: color || "#fde68a",
    life: 0.075,
    maxLife: 0.075
  })
  nextTracerId = nextTracerId + 1
}

function selectWeapon(idx) {
  if (idx < 0 || idx >= WEAPONS.length) { return }
  if (!weaponUnlocked[idx]) {
    showToast("Unlock " + WEAPONS[idx].shortName + " at the Armory Bench [E]")
    return
  }
  if (idx === weaponIdx) { return }
  weaponIdx = idx
  reloadTimer = 0.0
  swapAnim = 0.26
  playSfx("assets/sfx/click.wav", 0.35)
}

function cycleWeapon() {
  let next = (weaponIdx + 1) % WEAPONS.length
  let tries = 0
  while (tries < WEAPONS.length) {
    if (weaponUnlocked[next] && next !== weaponIdx) {
      selectWeapon(next)
      return
    }
    next = (next + 1) % WEAPONS.length
    tries = tries + 1
  }
}

function startReloadWeapon() {
  if (reloadTimer > 0.0 || meleeAnim > 0.0) { return }
  let w = WEAPONS[weaponIdx]
  if (magAmmo[weaponIdx] >= w.mag) { return }
  if (resAmmo[weaponIdx] === 0) {
    showToast("No reserve ammo — buy refills at the Armory Bench [E]")
    playSfx("assets/sfx/dryfire.wav", 0.4)
    return
  }
  reloadDuration = effectiveReloadTime(w.reloadSec)
  reloadTimer = reloadDuration
  playSfx("assets/sfx/reload.wav", 0.5)
}

function finishReloadWeapon() {
  let w = WEAPONS[weaponIdx]
  let need = w.mag - magAmmo[weaponIdx]
  if (need <= 0) { return }
  if (resAmmo[weaponIdx] < 0) {
    magAmmo[weaponIdx] = w.mag
  } else {
    let take = Math.min(need, resAmmo[weaponIdx])
    magAmmo[weaponIdx] = magAmmo[weaponIdx] + take
    resAmmo[weaponIdx] = resAmmo[weaponIdx] - take
  }
}

function doMeleeBash() {
  if (meleeCooldown > 0.0) { return }
  meleeCooldown = 0.65
  meleeAnim = 0.32
  reloadTimer = 0.0
  playSfx("assets/sfx/melee.wav", 0.55)

  let cp = Math.cos(lookPitch)
  let fx = Math.sin(lookYaw) * cp
  let fz = Math.cos(lookYaw) * cp
  let hitCount = 0
  let i = zombies.length - 1
  while (i >= 0) {
    let z = zombies[i]
    let dx = z.x - px
    let dz = z.z - pz
    let d = Math.sqrt(dx * dx + dz * dz)
    if (d < 2.55) {
      let dot = (dx * fx + dz * fz) / Math.max(0.01, d)
      if (dot > 0.35) {
        let kx = d > 0.01 ? dx / d : fx
        let kz = d > 0.01 ? dz / d : fz
        z.stunTimer = 0.85
        pushZombieSafe(z, kx * 0.9, kz * 0.9)
        damageZombie(i, Math.round(effectiveDamage(48)), false, kx, kz)
        hitCount = hitCount + 1
      }
    }
    i = i - 1
  }
  // Bash nearby pickup truck or barrel too
  if (dist2D(px + fx * 1.4, pz + fz * 1.4, TRUCK_X, TRUCK_Z) < 2.5) {
    playSfx("assets/sfx/impact_metal.wav", 0.45)
    carShake = Math.min(1.0, carShake + 0.35)
    spawnBurstParticles(px + fx * 1.6, 1.15, pz + fz * 1.6, 5, "#fbbf24", 2.8, 0.1, 0.24)
  }
  if (hitCount > 0) {
    hitMarkerTimer = 0.16
    playSfx("assets/sfx/hit.wav", 0.55)
  }
}

function throwFragGrenade() {
  if (grenadesLeft <= 0 || meleeCooldown > 0.0) {
    showToast("No grenades left")
    return
  }
  grenadesLeft = grenadesLeft - 1
  meleeCooldown = 0.45
  meleeAnim = 0.22
  playSfx("assets/sfx/melee.wav", 0.4)
  let cp = Math.cos(lookPitch)
  let fx = Math.sin(lookYaw) * cp
  let fy = Math.sin(lookPitch)
  let fz = Math.cos(lookYaw) * cp
  thrownGrenades.push({
    id: nextGid,
    x: px + fx * 0.5,
    y: P_EYE - 0.15,
    z: pz + fz * 0.5,
    vx: fx * 13.5,
    vy: fy * 13.5 + 4.2,
    vz: fz * 13.5,
    fuse: 1.55,
    rot: 0.0
  })
  nextGid = nextGid + 1
}

function triggerBarrelBlast(bIdx) {
  if (bIdx < 0 || bIdx >= explosiveBarrels.length) { return }
  let eb = explosiveBarrels[bIdx]
  if (!eb.alive) { return }
  removeBarrelDecals(eb.id)
  eb.alive = false
  eb.leaking = false
  eb.fuseTimer = 0.0
  eb.respawnWave = wave + 2
  detonateExplosion(eb.x, 0.6, eb.z, 7.0, 300)
}

function detonateExplosion(ex, ey, ez, radius, maxDmg) {
  playSfx("assets/sfx/explosion.wav", 0.88)
  cameraShake = Math.max(cameraShake, 0.42)
  explosionFlash = 0.30
  explosionX = ex
  explosionY = Math.max(1.1, ey + 0.65)
  explosionZ = ez

  spawnBurstParticles(ex, ey + 0.35, ez, 28, "#ff7b29", 7.2, 0.40, 0.75)
  spawnBurstParticles(ex, ey + 0.45, ez, 16, "#fde047", 5.0, 0.28, 0.45)
  spawnBurstParticles(ex, ey + 0.65, ez, 12, "#4b5563", 2.4, 0.60, 1.15)
  addSurfaceDecal("scorch", ex, 0.015, ez, 0.0, 1.0, 0.0, Math.min(4.2, radius * 0.52), "#ffffff", null)

  let i = zombies.length - 1
  while (i >= 0) {
    let z = zombies[i]
    let d = dist2D(ex, ez, z.x, z.z)
    if (d <= radius) {
      let falloff = 1.0 - (d / radius) * 0.65
      let dmg = Math.round(maxDmg * falloff)
      let kx = d > 0.05 ? (z.x - ex) / d : 0
      let kz = d > 0.05 ? (z.z - ez) / d : 0
      z.stunTimer = Math.max(z.stunTimer, 0.75)
      pushZombieSafe(z, kx * 0.85 * falloff, kz * 0.85 * falloff)
      damageZombie(i, dmg, d < 2.2, kx, kz)
    }
    i = i - 1
  }

  // Chain-detonate nearby barrels
  let bi = 0
  while (bi < explosiveBarrels.length) {
    let eb = explosiveBarrels[bi]
    if (eb.alive) {
      let bd = dist2D(ex, ez, eb.x, eb.z)
      if (bd > 0.25 && bd <= radius * 0.85) {
        eb.hp = 0
        triggerBarrelBlast(bi)
      }
    }
    bi = bi + 1
  }

  // Blast damage to pickup truck if nearby
  let carDist = dist2D(ex, ez, TRUCK_X, TRUCK_Z)
  if (!carExploded && carDist > 0.3 && carDist <= radius + 1.8) {
    damageCarPart("cab", Math.round(maxDmg * 0.75), null)
  }

  // Shatter streetlamp glass if within blast shockwave
  let li = 0
  while (li < courtyardLamps.length) {
    let lm = courtyardLamps[li]
    if (!lm.broken && dist2D(ex, ez, lm.x, lm.z) <= radius * 0.95) {
      lm.broken = true
      lm.repairTimer = 22.0
      spawnBurstParticles(lm.x, 4.3, lm.z, 8, "#bae6fd", 3.5, 0.14, 0.55)
    }
    li = li + 1
  }

  // Self splash if standing right on explosion
  let pd = dist2D(ex, ez, px, pz)
  if (pd < radius * 0.72) {
    applyPlayerDamage(Math.round(30 * (1.0 - pd / (radius * 0.72))))
  }
}

function updateGrenades(dt) {
  let i = thrownGrenades.length - 1
  while (i >= 0) {
    let g = thrownGrenades[i]
    g.vy = g.vy - 18.0 * dt
    g.x = g.x + g.vx * dt
    g.y = g.y + g.vy * dt
    g.z = g.z + g.vz * dt
    g.rot = g.rot + dt * 9.0
    if (g.y < 0.14) {
      g.y = 0.14
      g.vy = Math.abs(g.vy) * 0.42
      g.vx = g.vx * 0.68
      g.vz = g.vz * 0.68
    }
    if (g.x < -HALF_ARENA || g.x > HALF_ARENA) { g.vx = -g.vx * 0.6; g.x = clampVal(g.x, -HALF_ARENA, HALF_ARENA) }
    if (g.z < -HALF_ARENA || g.z > HALF_ARENA) { g.vz = -g.vz * 0.6; g.z = clampVal(g.z, -HALF_ARENA, HALF_ARENA) }
    g.fuse = g.fuse - dt
    if (g.fuse <= 0.0) {
      let gx = g.x
      let gy = g.y
      let gz = g.z
      thrownGrenades.splice(i, 1)
      detonateExplosion(gx, gy, gz, 6.2, 240)
    }
    i = i - 1
  }
}

function emitEnvImpactEffects(material, hx, hy, hz, playSfxNow) {
  let cy = Math.max(0.05, hy)
  if (material === "metal") {
    spawnBurstParticles(hx, cy, hz, 6, "#fde047", 4.6, 0.09, 0.24)
    spawnBurstParticles(hx, cy, hz, 3, "#fb923c", 3.2, 0.11, 0.26)
    if (playSfxNow) { playSfx("assets/sfx/impact_metal.wav", 0.46) }
  } else if (material === "glass") {
    spawnBurstParticles(hx, cy, hz, 12, "#bae6fd", 4.4, 0.12, 0.45)
    spawnBurstParticles(hx, cy, hz, 4, "#f8fafc", 3.0, 0.09, 0.35)
    if (playSfxNow) { playSfx("assets/sfx/impact_glass.wav", 0.54) }
  } else if (material === "wood") {
    spawnBurstParticles(hx, cy, hz, 5, "#b45309", 3.2, 0.10, 0.30)
    spawnBurstParticles(hx, cy, hz, 3, "#d6d3d1", 2.2, 0.08, 0.24)
    if (playSfxNow) { playSfx("assets/sfx/impact_wood.wav", 0.44) }
  } else if (material === "rubber") {
    spawnBurstParticles(hx, cy, hz, 5, "#475569", 2.2, 0.14, 0.38)
    if (playSfxNow) { playSfx("assets/sfx/impact_wood.wav", 0.30) }
  } else {
    spawnBurstParticles(hx, cy, hz, 5, "#cbd5e1", 2.8, 0.11, 0.32)
    spawnBurstParticles(hx, cy, hz, 2, "#f59e0b", 3.4, 0.07, 0.18)
    if (playSfxNow) { playSfx("assets/sfx/impact_stone.wav", 0.42) }
  }
}

function damageCarPart(part, dmg, hitPt, playSfxNow) {
  carShake = Math.min(1.0, carShake + (weaponIdx === 1 ? 0.45 : 0.24))

  // Part-specific physical destruction
  if (part === "windshield" && !carWindshieldBroken) {
    carWindshieldBroken = true
    removeCarPartDecals("windshield")
    if (hitPt) { emitEnvImpactEffects("glass", hitPt.hx, hitPt.hy, hitPt.hz, playSfxNow) }
    showToast("Windshield shattered!")
  } else if (part === "headlightL" && !carHeadlightLBroken) {
    carHeadlightLBroken = true
    if (hitPt) { emitEnvImpactEffects("glass", hitPt.hx, hitPt.hy, hitPt.hz, playSfxNow) }
  } else if (part === "headlightR" && !carHeadlightRBroken) {
    carHeadlightRBroken = true
    if (hitPt) { emitEnvImpactEffects("glass", hitPt.hx, hitPt.hy, hitPt.hz, playSfxNow) }
  } else if (part === "lightbar" && !carLightbarBroken) {
    carLightbarBroken = true
    if (hitPt) { emitEnvImpactEffects("glass", hitPt.hx, hitPt.hy, hitPt.hz, playSfxNow) }
  } else if (part === "wheelFL") {
    carWheelHit[0] = true
  } else if (part === "wheelFR") {
    carWheelHit[1] = true
  } else if (part === "wheelRL") {
    carWheelHit[2] = true
  } else if (part === "wheelRR") {
    carWheelHit[3] = true
  } else if (part === "hood") {
    carHoodHits = Math.min(6, carHoodHits + 1)
  } else if (part === "cab") {
    if (hitPt && hitPt.lx !== undefined && hitPt.lx < 0) {
      carDoorLHits = Math.min(5, carDoorLHits + 1)
    } else {
      carDoorRHits = Math.min(5, carDoorRHits + 1)
    }
  } else if (part === "tailgate") {
    carTailgateHits = Math.min(5, carTailgateHits + 1)
  }

  if (carExploded) { return }

  let prevHp = carHp
  carHp = Math.max(0, carHp - dmg)

  if (carHp > 0 && carHp < carMaxHp * 0.78 && carAlarmCooldown <= 0.0) {
    carAlarmCooldown = 2.6
    playSfx("assets/sfx/car_alarm.wav", 0.36)
  }
  if (prevHp > carMaxHp * 0.45 && carHp <= carMaxHp * 0.45 && carHp > 0) {
    showToast("Pickup engine smoking — keep firing to detonate!")
  } else if (prevHp > carMaxHp * 0.22 && carHp <= carMaxHp * 0.22 && carHp > 0) {
    carBurnTimer = Math.max(carBurnTimer, 0.4)
    showToast("Pickup fuel line ignited!")
  }

  if (carHp <= 0) {
    carExploded = true
    carBurnTimer = 18.0
    carWindshieldBroken = true
    carHeadlightLBroken = true
    carHeadlightRBroken = true
    carLightbarBroken = true
    carWheelHit = [true, true, true, true]
    carHoodHits = 5
    carDoorLHits = 4
    carDoorRHits = 4
    carTailgateHits = 4
    removeCarPartDecals("windshield")
    showBanner("Quarantine Pickup Detonated!")
    detonateExplosion(TRUCK_X, 0.9, TRUCK_Z, 8.2, 340)
  }
}

function fireCurrentWeapon(clickHit) {
  if (reloadTimer > 0.0 || meleeAnim > 0.0 || fireCooldown > 0.0) { return }
  let w = WEAPONS[weaponIdx]
  if (magAmmo[weaponIdx] <= 0) {
    playSfx("assets/sfx/dryfire.wav", 0.42)
    fireCooldown = 0.25
    startReloadWeapon()
    return
  }

  magAmmo[weaponIdx] = magAmmo[weaponIdx] - 1
  fireCooldown = w.rate
  flashTimer = 0.065
  recoilKick = Math.min(1.0, recoilKick + w.recoilPos * 9.0)
  cameraShake = Math.max(cameraShake, w.recoilPitch * 0.45)
  crosshairSpread = Math.min(1.0, crosshairSpread + (weaponIdx === 1 ? 0.55 : 0.30))
  if (weaponIdx === 1) { pumpAnim = 0.45 }
  playSfx(w.sfx, 0.58)
  spawnShellCasing(weaponIdx)

  // Slight visual pitch climb on recoil (subtle so cursor stays accurate)
  lookPitch = clampVal(lookPitch + w.recoilPitch * 0.045, -1.35, 1.35)
  if (typeof window !== "undefined") { window.__scene3dPitch = lookPitch }

  let cp = Math.cos(lookPitch)
  let baseDx = Math.sin(lookYaw) * cp
  let baseDy = Math.sin(lookPitch)
  let baseDz = Math.cos(lookYaw) * cp
  let ox = cameraPos ? cameraPos.x : px
  let oy = cameraPos ? cameraPos.y : P_EYE
  let oz = cameraPos ? cameraPos.z : pz

  // Muzzle tip in world space for tracers (subtle tight spark forward so screen center stays sharp)
  let rVecX = -Math.cos(lookYaw)
  let rVecZ = Math.sin(lookYaw)
  let muzX = ox + baseDx * 0.72 + rVecX * 0.20
  let muzY = oy + baseDy * 0.72 - 0.14
  let muzZ = oz + baseDz * 0.72 + rVecZ * 0.20
  spawnBurstParticles(muzX + baseDx * 0.35, muzY + baseDy * 0.35, muzZ + baseDz * 0.35, 1, "#fcd34d", 2.4, 0.055, 0.10)

  let anyZombieHit = false
  let anyHead = false
  let envSfxPlayed = false
  let pi = 0
  while (pi < w.pellets) {
    let sp = w.spread * (1.0 + crosshairSpread * 0.45)
    let sx = baseDx + (randFloat() - 0.5) * sp
    let sy = baseDy + (randFloat() - 0.5) * sp
    let sz = baseDz + (randFloat() - 0.5) * sp
    let sl = Math.sqrt(sx * sx + sy * sy + sz * sz)
    sx = sx / sl; sy = sy / sl; sz = sz / sl

    let envHit = rayHitEnvironment(ox, oy, oz, sx, sy, sz, 48.0)

    // Refine exact rendered triangle hit from pointer-locked Scene3D click on lead pellet when hitting world/props
    if (pi === 0 && clickHit && clickHit.locked && clickHit.button === 0 && clickHit.point && clickHit.normal && clickHit.distance) {
      let cid = clickHit.rootObjectId || clickHit.objectId || ""
      if (cid !== "" && cid.indexOf("z-") !== 0 && cid.indexOf("pickup-") !== 0 && clickHit.distance < envHit.t + 1.4 && clickHit.distance > 0.2 && clickHit.distance < 46.0) {
        envHit.hit = true
        envHit.t = clickHit.distance
        envHit.hx = clickHit.point.x
        envHit.hy = clickHit.point.y
        envHit.hz = clickHit.point.z
        envHit.nx = clickHit.normal.x
        envHit.ny = clickHit.normal.y
        envHit.nz = clickHit.normal.z
        // Refine truck local coords when exact Three.js triangle point is on truck
        if (cid === "truck-wreck") {
          envHit.kind = "car"
          let cs = Math.cos(TRUCK_YAW)
          let sn = Math.sin(TRUCK_YAW)
          let rx = envHit.hx - TRUCK_X
          let rz = envHit.hz - TRUCK_Z
          envHit.lx = rx * cs - rz * sn
          envHit.ly = envHit.hy
          envHit.lz = rx * sn + rz * cs
          envHit.lnx = envHit.nx * cs - envHit.nz * sn
          envHit.lny = envHit.ny
          envHit.lnz = envHit.nx * sn + envHit.nz * cs
          if (envHit.part === "" || envHit.part === "floor" || envHit.part === "trunk") {
            envHit.part = envHit.ly > 1.05 && envHit.lz < -0.5 ? "windshield" : (envHit.lz < -0.85 ? "hood" : "cab")
            envHit.material = envHit.part === "windshield" && !carWindshieldBroken ? "glass" : "metal"
          }
        } else if (cid.indexOf("barrel-") === 0) {
          let bid = parseInt(cid.substring(7), 10)
          if (bid >= 1 && bid <= explosiveBarrels.length) {
            envHit.kind = "barrel"
            envHit.id = bid - 1
            envHit.material = "metal"
          }
        } else if (cid === "lamp-nw" || cid === "lamp-se" || cid === "lamp-sw") {
          envHit.kind = "lamp"
          envHit.id = cid === "lamp-nw" ? 0 : (cid === "lamp-se" ? 1 : 2)
          envHit.part = envHit.hy >= 4.02 ? "bulb" : "post"
          envHit.material = envHit.part === "bulb" && !courtyardLamps[envHit.id].broken ? "glass" : "metal"
        } else if (cid.indexOf("gate-") === 0 || cid === "inst-pikes") {
          envHit.kind = "world"
          envHit.material = "metal"
        } else if (cid === "armory-bench" || cid.indexOf("dtree-") === 0) {
          envHit.kind = cid.indexOf("dtree-") === 0 ? "tree" : "bench"
          envHit.material = "wood"
        } else if (cid !== "truck-wreck" && envHit.kind === "ground") {
          envHit.kind = "world"
          envHit.material = "stone"
        }
      }
    }

    // Find closest zombie closer than envHit.t
    let bestZi = -1
    let bestZT = envHit.t
    let bestIsHead = false

    // Also honor direct Three.js zombie mesh triangle pick on lead pellet when pointer-locked
    if (pi === 0 && clickHit && clickHit.locked && clickHit.button === 0 && clickHit.distance && clickHit.distance > 0.2) {
      let zCid = clickHit.rootObjectId || clickHit.objectId || ""
      if (zCid.indexOf("z-") === 0 && clickHit.distance < bestZT + 0.15) {
        let clickedZid = parseInt(zCid.substring(2), 10)
        let fzi = 0
        while (fzi < zombies.length) {
          if (zombies[fzi].id === clickedZid) {
            let fSpec = ENEMY_TYPES[zombies[fzi].kind]
            let fMaxH = (fSpec && fSpec.hitHeight) ? fSpec.hitHeight : 1.85
            bestZi = fzi
            bestZT = Math.min(clickHit.distance, envHit.t)
            bestIsHead = clickHit.point ? (clickHit.point.y >= fMaxH * 0.72) : false
            break
          }
          fzi = fzi + 1
        }
      }
    }

    let denomXZ = sx * sx + sz * sz
    let zi = 0
    while (zi < zombies.length) {
      let z = zombies[zi]
      let spec = ENEMY_TYPES[z.kind]
      let bodyR = (spec && spec.hitRadius) ? spec.hitRadius : (0.48 * (z.scale || 1.0))
      let maxH = (spec && spec.hitHeight) ? spec.hitHeight : (1.85 * (z.scale || 1.0))
      let zx = z.x - ox
      let zz = z.z - oz
      let cylT = denomXZ > 0.0001 ? (zx * sx + zz * sz) / denomXZ : -1.0
      if (cylT > 0.15 && cylT - bodyR < bestZT) {
        let hxC = ox + sx * cylT
        let hzC = oz + sz * cylT
        let dx = hxC - z.x
        let dz = hzC - z.z
        let r2 = dx * dx + dz * dz
        if (r2 <= bodyR * bodyR) {
          let halfChord = Math.sqrt(Math.max(0.0, bodyR * bodyR - r2)) / Math.sqrt(Math.max(0.0001, denomXZ))
          let hitT = Math.max(0.20, cylT - halfChord)
          if (hitT < bestZT) {
            let hyEnter = oy + sy * hitT
            let hyCenter = oy + sy * cylT
            let hitBody = (hyEnter >= -0.05 && hyEnter <= maxH + 0.18) || (hyCenter >= 0.0 && hyCenter <= maxH + 0.16)
            if (hitBody) {
              bestZT = hitT
              bestZi = zi
              let useHy = (hyEnter >= -0.05 && hyEnter <= maxH + 0.18) ? hyEnter : hyCenter
              bestIsHead = useHy >= maxH * 0.72
            }
          }
        }
      }
      zi = zi + 1
    }

    if (pi === 0 || (pi % 2 === 0)) {
      let trDist = bestZi >= 0 ? bestZT : envHit.t
      spawnTracerBolt(muzX, muzY, muzZ, ox + sx * trDist, oy + sy * trDist, oz + sz * trDist, w.id === "shotgun" ? "#fca5a5" : "#fde68a")
    }

    if (bestZi >= 0) {
      anyZombieHit = true
      if (bestIsHead) { anyHead = true }
      let rawDmg = effectiveDamage(w.dmg) * (bestIsHead ? w.headMult : 1.0)
      let hx = ox + sx * bestZT
      let hy = oy + sy * bestZT
      let hz = oz + sz * bestZT
      spawnBurstParticles(hx, hy, hz, bestIsHead ? 9 : 4, bestIsHead ? "#ef4444" : "#991b1b", 3.4, 0.14, 0.38)
      damageZombie(bestZi, Math.round(rawDmg), bestIsHead, sx, sz)
    } else if (envHit.hit) {
      let canPlaySfx = !envSfxPlayed
      if (envHit.kind === "barrel") {
        let bHit = explosiveBarrels[envHit.id]
        if (bHit && bHit.alive) {
          let bdmg = effectiveDamage(w.dmg)
          bHit.hp = bHit.hp - bdmg
          bHit.shake = Math.min(1.0, bHit.shake + 0.45)
          emitEnvImpactEffects("metal", envHit.hx, envHit.hy, envHit.hz, canPlaySfx)
          envSfxPlayed = true
          if (bHit.hp <= 0) {
            triggerBarrelBlast(envHit.id)
          } else {
            addSurfaceDecal("bullethole", envHit.hx, envHit.hy, envHit.hz, envHit.nx, envHit.ny, envHit.nz, 0.18, "#ffffff", { barrelId: bHit.id })
            if (!bHit.leaking) {
              bHit.leaking = true
              bHit.fuseTimer = 1.65
              bHit.leakX = envHit.hx + envHit.nx * 0.02
              bHit.leakY = clampVal(envHit.hy, 0.16, 1.08)
              bHit.leakZ = envHit.hz + envHit.nz * 0.02
              bHit.leakNx = envHit.nx
              bHit.leakNz = envHit.nz
              playSfx("assets/sfx/barrel_hiss.wav", 0.56)
            }
          }
        }
      } else if (envHit.kind === "car") {
        let cdmg = effectiveDamage(w.dmg)
        let prevIntactGlass = (envHit.part === "windshield" && !carWindshieldBroken) ||
                              (envHit.part === "headlightL" && !carHeadlightLBroken) ||
                              (envHit.part === "headlightR" && !carHeadlightRBroken) ||
                              (envHit.part === "lightbar" && !carLightbarBroken)
        if (!prevIntactGlass) {
          emitEnvImpactEffects(envHit.material, envHit.hx, envHit.hy, envHit.hz, canPlaySfx)
          envSfxPlayed = true
          if (envHit.lx !== undefined) {
            addSurfaceDecal("bullethole", envHit.hx, envHit.hy, envHit.hz, envHit.nx, envHit.ny, envHit.nz, 0.17, "#f8fafc", {
              carLocal: true, carPart: envHit.part,
              lx: envHit.lx, ly: envHit.ly, lz: envHit.lz,
              lnx: envHit.lnx, lny: envHit.lny, lnz: envHit.lnz
            })
          }
        } else {
          envSfxPlayed = true
        }
        damageCarPart(envHit.part, cdmg, envHit, canPlaySfx)
      } else if (envHit.kind === "lamp") {
        let lm = courtyardLamps[envHit.id]
        if (lm && envHit.part === "bulb" && !lm.broken) {
          lm.broken = true
          lm.repairTimer = 20.0
          emitEnvImpactEffects("glass", envHit.hx, envHit.hy, envHit.hz, canPlaySfx)
          envSfxPlayed = true
        } else {
          emitEnvImpactEffects("metal", envHit.hx, envHit.hy, envHit.hz, canPlaySfx)
          envSfxPlayed = true
          addSurfaceDecal("bullethole", envHit.hx, envHit.hy, envHit.hz, envHit.nx, envHit.ny, envHit.nz, 0.14, "#e2e8f0", null)
        }
      } else if (envHit.kind === "firedrum") {
        fireDrumFlares[envHit.id] = 1.0
        emitEnvImpactEffects("metal", envHit.hx, envHit.hy, envHit.hz, canPlaySfx)
        envSfxPlayed = true
        spawnBurstParticles(FIRE_DRUMS[envHit.id].x, 1.15, FIRE_DRUMS[envHit.id].z, 10, "#ff7b24", 4.6, 0.16, 0.55)
        addSurfaceDecal("bullethole", envHit.hx, envHit.hy, envHit.hz, envHit.nx, envHit.ny, envHit.nz, 0.16, "#ffffff", null)
      } else {
        emitEnvImpactEffects(envHit.material, envHit.hx, envHit.hy, envHit.hz, canPlaySfx)
        envSfxPlayed = true
        if (envHit.kind !== "tree") {
          let decSz = envHit.material === "ground" ? 0.22 : (envHit.material === "metal" ? 0.15 : 0.19)
          addSurfaceDecal("bullethole", envHit.hx, envHit.hy, envHit.hz, envHit.nx, envHit.ny, envHit.nz, decSz, "#ffffff", null)
        }
      }
    }

    pi = pi + 1
  }

  if (anyHead) {
    hitMarkerTimer = 0.22
    hitMarkerCrit = true
    playSfx("assets/sfx/headshot.wav", 0.56)
  } else if (anyZombieHit) {
    hitMarkerTimer = 0.14
    hitMarkerCrit = false
    playSfx("assets/sfx/hit.wav", 0.42)
  }

  if (magAmmo[weaponIdx] === 0 && resAmmo[weaponIdx] !== 0) {
    startReloadWeapon()
  }
}

function buildWeaponViewmodelObjects(out, moveSpeedRatio) {
  if (!started || gameOver) { return }
  let w = WEAPONS[weaponIdx]
  let bobX = Math.sin(bobPhase) * 0.012 * moveSpeedRatio
  let bobY = Math.abs(Math.cos(bobPhase)) * 0.014 * moveSpeedRatio

  let rProg = reloadTimer > 0.0 ? 1.0 - reloadTimer / Math.max(0.1, reloadDuration) : -1.0
  let reloadDrop = rProg >= 0.0 ? Math.sin(rProg * Math.PI) * 0.09 : 0.0
  let reloadRoll = rProg >= 0.0 ? Math.sin(rProg * Math.PI) * 0.42 : 0.0
  let swapDrop = swapAnim > 0.0 ? (swapAnim / 0.26) * 0.18 : 0.0
  let meleeFwd = meleeAnim > 0.0 ? Math.sin((meleeAnim / 0.32) * Math.PI) * 0.22 : 0.0
  let meleeRot = meleeAnim > 0.0 ? Math.sin((meleeAnim / 0.32) * Math.PI) * 0.72 : 0.0

  let kickBack = recoilKick * w.recoilPos
  let kickPitch = recoilKick * w.recoilPitch

  let parts = {}
  if (weaponIdx === 0) {
    let slideZ = recoilKick > 0.08 ? 0.032 * recoilKick : 0.0
    if (rProg > 0.72) { slideZ = Math.sin(((rProg - 0.72) / 0.28) * Math.PI) * 0.038 }
    let magDrop = rProg >= 0.0 && rProg < 0.68 ? -Math.sin((rProg / 0.68) * Math.PI) * 0.14 : 0.0
    parts = {
      Slide: { position: { x: 0, y: 0, z: slideZ } },
      Magazine: { position: { x: 0, y: magDrop, z: 0 } }
    }
  } else if (weaponIdx === 1) {
    let pumpZ = pumpAnim > 0.0 ? Math.sin((1.0 - pumpAnim / 0.45) * Math.PI) * 0.075 : 0.0
    parts = {
      Pump: { position: { x: 0, y: 0, z: pumpZ } }
    }
  } else if (weaponIdx === 2) {
    let boltZ = recoilKick > 0.05 ? 0.025 * recoilKick : 0.0
    let magDropS = rProg >= 0.0 && rProg < 0.72 ? -Math.sin((rProg / 0.72) * Math.PI) * 0.15 : 0.0
    parts = {
      Bolt: { position: { x: 0, y: 0, z: boltZ } },
      Magazine: { position: { x: 0, y: magDropS, z: 0 } }
    }
  }

  out.push({
    id: "fp-weapon",
    type: "model",
    modelUrl: w.modelUrl,
    attach: "camera",
    position: {
      x: w.pos.x + bobX - meleeFwd * 0.4,
      y: w.pos.y - bobY - reloadDrop - swapDrop,
      z: w.pos.z + kickBack - meleeFwd
    },
    rotation: {
      x: kickPitch - meleeRot * 0.5,
      y: meleeRot,
      z: -reloadRoll
    },
    scale: 1.0,
    parts: parts,
    pickable: false,
    castShadow: false,
    receiveShadow: false
  })

  if (flashTimer > 0.0) {
    let mz = weaponIdx === 1 ? -1.04 : (weaponIdx === 2 ? -0.90 : -0.72)
    let mr = weaponIdx === 1 ? 0.044 : 0.026
    out.push({
      id: "muzzle-core",
      type: "sphere",
      attach: "camera",
      position: { x: w.pos.x + bobX, y: w.pos.y + 0.03 - bobY, z: mz },
      radius: mr,
      color: "#fef08a",
      emissive: "#ffb347",
      emissiveIntensity: 5.0,
      opacity: 0.92,
      pickable: false,
      castShadow: false
    })
  }
}
