<logic src="../logic/main.logic" />

<style>
.dh-root, .dh-root * { box-sizing: border-box; }
.dh-root {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 0;
  overflow: hidden;
  background: #04060a;
  font-family: "Segoe UI", system-ui, sans-serif;
  color: #f1f5f9;
  user-select: none;
  touch-action: none;
  -webkit-touch-callout: none;
  --dh-red: #dc2626;
  --dh-ember: #f97316;
  --dh-sky: #38bdf8;
  --dh-bone: #ede4d3;
  --dh-ash: #94a3b8;
}
.dh-scene { position: absolute; inset: 0; }
.dh-ovl { position: absolute; pointer-events: none; }
.dh-display {
  font-family: "Impact", "Haettenschweiler", "Arial Narrow Bold", "Franklin Gothic Demi Cond", sans-serif;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.dh-panel {
  position: relative;
  background: linear-gradient(180deg, rgba(14,18,26,0.82), rgba(7,9,14,0.9));
  border: 1px solid rgba(255,255,255,0.1);
  border-top-color: rgba(255,255,255,0.18);
  box-shadow: 0 12px 32px rgba(0,0,0,0.58), inset 0 0 0 1px rgba(0,0,0,0.55);
  backdrop-filter: blur(8px);
}
.dh-ovl.dh-panel { position: absolute; }
.dh-panel-red::before {
  content: "";
  position: absolute;
  left: 0; top: 0; bottom: 0; width: 3px;
  background: linear-gradient(180deg, #ef4444, #7f1d1d);
}
.dh-panel-sky::before {
  content: "";
  position: absolute;
  right: 0; top: 0; bottom: 0; width: 3px;
  background: linear-gradient(180deg, #38bdf8, #0c4a6e);
}
/* Vignette hurt / low HP / overdrive */
.dh-hurt {
  inset: 0;
  background: radial-gradient(circle at 50% 50%, rgba(220,38,38,0) 42%, rgba(185,28,28,0.68) 100%);
}
.dh-low {
  inset: 0;
  background: radial-gradient(circle at 50% 50%, rgba(153,27,27,0) 55%, rgba(127,29,29,0.45) 100%);
  animation: dh-pulse 1.1s ease-in-out infinite;
}
.dh-overdrive {
  inset: 0;
  border: 2px solid rgba(250,204,21,0.35);
  box-shadow: inset 0 0 42px rgba(250,204,21,0.22);
}
@keyframes dh-pulse { 50% { opacity: 0.45; } }
/* Reticle */
.dh-cross { top: 50%; left: 50%; width: 0; height: 0; z-index: 12; }
.dh-tick {
  position: absolute;
  background: rgba(255,255,255,0.92);
  box-shadow: 0 0 4px rgba(0,0,0,0.9);
  transition: transform 55ms linear;
}
.dh-tick-l, .dh-tick-r { width: 9px; height: 2px; top: -1px; }
.dh-tick-u, .dh-tick-d { width: 2px; height: 9px; left: -1px; }
.dh-tick-l { right: 0; } .dh-tick-r { left: 0; }
.dh-tick-u { bottom: 0; } .dh-tick-d { top: 0; }
.dh-dot {
  position: absolute;
  left: -1.5px; top: -1.5px; width: 3px; height: 3px;
  border-radius: 50%; background: rgba(255,255,255,0.95);
}
.dh-hit .dh-tick { background: #f87171; }
.dh-hitcrit .dh-tick { background: #facc15; }
.dh-hitx {
  position: absolute; left: -13px; top: -13px; width: 26px; height: 26px;
  transform: rotate(45deg); animation: dh-hitx 200ms ease-out both;
}
.dh-hitx::before, .dh-hitx::after {
  content: ""; position: absolute; background: #ef4444; box-shadow: 0 0 8px rgba(239,68,68,0.9);
}
.dh-hitcrit .dh-hitx::before, .dh-hitcrit .dh-hitx::after {
  background: #facc15; box-shadow: 0 0 10px rgba(250,204,21,0.95);
}
.dh-hitx::before { left: 12px; top: 0; width: 2px; height: 26px; }
.dh-hitx::after { top: 12px; left: 0; width: 26px; height: 2px; }
@keyframes dh-hitx { from { transform: rotate(45deg) scale(1.45); opacity: 1; } to { transform: rotate(45deg) scale(0.9); opacity: 0.35; } }
/* HUD bars */
.dh-top { top: 14px; left: 16px; display: flex; gap: 8px; flex-wrap: wrap; align-items: center; z-index: 15; max-width: calc(100vw - 320px); }
.dh-chip { padding: 7px 14px; }
.dh-corner { top: 14px; right: 16px; display: flex; gap: 6px; pointer-events: auto; z-index: 16; flex-wrap: wrap; justify-content: flex-end; }
.dh-hud {
  left: 16px; bottom: 16px; padding: 12px 16px 12px 18px; min-width: 260px; z-index: 15;
  clip-path: polygon(0 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%);
}
.dh-bar { position: relative; height: 10px; background: rgba(255,255,255,0.08); margin-top: 5px; overflow: hidden; border: 1px solid rgba(0,0,0,0.6); }
.dh-fill-hp { height: 100%; background: linear-gradient(90deg, #991b1b, #ef4444 65%, #fb7185); transition: width 140ms ease; }
.dh-fill-ar { height: 100%; background: linear-gradient(90deg, #0369a1, #38bdf8 70%, #bae6fd); transition: width 140ms ease; }
.dh-ammo {
  right: 16px; bottom: 16px; padding: 12px 18px 12px 16px; text-align: right; min-width: 215px; z-index: 15;
  clip-path: polygon(12px 0, 100% 0, 100% 100%, 0 100%, 0 12px);
}
.dh-slots {
  bottom: 16px; left: 50%; transform: translateX(-50%);
  display: flex; gap: 6px; pointer-events: auto; z-index: 15;
}
.dh-slot {
  padding: 6px 11px; background: rgba(12,16,24,0.8);
  border: 1px solid rgba(255,255,255,0.12); color: #94a3b8;
  font-size: 11px; border-radius: 4px; cursor: pointer;
}
.dh-slot-on {
  border-color: #ef4444; color: #ffffff; background: rgba(127,29,29,0.55);
  box-shadow: 0 0 12px rgba(239,68,68,0.35);
}
.dh-banner {
  top: 74px; left: 50%; transform: translateX(-50%);
  padding: 10px 24px; text-align: center; z-index: 16;
  background: rgba(10,12,18,0.88); border-top: 2px solid #ef4444; border-bottom: 1px solid rgba(255,255,255,0.12);
}
.dh-toast {
  bottom: 108px; left: 50%; transform: translateX(-50%);
  padding: 7px 16px; border-radius: 999px;
  background: rgba(15,23,42,0.88); border: 1px solid rgba(56,189,248,0.45); z-index: 16;
}
.dh-bench-prompt {
  top: 64%; left: 50%; transform: translateX(-50%);
  padding: 7px 16px; border-radius: 999px;
  background: rgba(12,20,34,0.9); border: 1px solid rgba(56,189,248,0.7);
  z-index: 15;
}
/* Overlays & Modals */
.dh-modal-bg {
  inset: 0; display: flex; align-items: center; justify-content: center;
  padding: 18px; pointer-events: auto; z-index: 40;
  background: radial-gradient(120% 95% at 50% 25%, rgba(120,16,12,0.22), rgba(4,6,10,0.86) 72%);
  backdrop-filter: blur(4px);
}
.dh-card {
  position: relative; width: min(680px, 100%); max-height: calc(100% - 16px); overflow-y: auto;
  touch-action: pan-y;
  padding: 28px 30px; text-align: center;
  background: linear-gradient(180deg, rgba(16,20,28,0.95), rgba(8,10,15,0.97));
  border: 1px solid rgba(255,255,255,0.12);
  box-shadow: 0 36px 90px rgba(0,0,0,0.85);
}
.dh-card::before {
  content: ""; position: absolute; left: 0; right: 0; top: 0; height: 3px;
  background: linear-gradient(90deg, transparent, #ef4444, transparent);
}
.dh-logo {
  font-size: 68px !important; line-height: 0.94 !important;
  color: #f4ece0;
  text-shadow: 0 0 36px rgba(220,38,38,0.5), 0 10px 26px rgba(0,0,0,0.85);
}
.dh-shop-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 10px; margin-top: 14px; text-align: left;
}
.dh-shop-item {
  background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.11);
  border-radius: 6px; padding: 11px 12px;
}
.dh-kbd {
  display: inline-block; min-width: 24px; padding: 2px 6px;
  background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.25);
  border-bottom-width: 2px; border-radius: 4px;
  font-family: ui-monospace, monospace; font-size: 11px !important; color: #f8fafc !important;
}
.dh-board {
  margin-top: 16px; text-align: left; background: rgba(0,0,0,0.38);
  border: 1px solid rgba(255,255,255,0.07); padding: 10px 14px; border-radius: 6px;
}
.dh-row {
  display: flex; justify-content: space-between; gap: 10px;
  padding: 4px 0; border-bottom: 1px solid rgba(255,255,255,0.05);
}
.dh-anchor-tag {
  background: rgba(10,14,22,0.86);
  border: 1px solid rgba(56,189,248,0.55);
  border-radius: 6px;
  padding: 4px 10px;
  white-space: nowrap;
}
.dh-boss-anchor {
  background: rgba(15,10,12,0.88);
  border: 1px solid rgba(239,68,68,0.75);
  border-radius: 6px;
  padding: 4px 10px;
  min-width: 150px;
}
.dh-touch { position: absolute; left: 14px; bottom: 135px; pointer-events: auto; z-index: 20; touch-action: none; -webkit-touch-callout: none; }
.dh-touch-btns {
  position: absolute; right: 14px; bottom: 135px;
  display: grid; grid-template-columns: repeat(2, 70px); gap: 8px; pointer-events: auto; z-index: 20;
  touch-action: none; -webkit-touch-callout: none;
}
@media (max-width: 760px) {
  .dh-top { top: 8px; left: 8px; right: 184px; max-width: none; gap: 4px; }
  .dh-chip { padding: 4px 7px; font-size: 11px; }
  .dh-corner { top: 8px; right: 8px; max-width: 172px; gap: 4px; }
  .dh-corner button { padding: 4px 6px !important; min-height: 28px !important; font-size: 10px !important; }
  .dh-fps-chip { display: none; }
  .dh-hud {
    left: 8px; bottom: 50px; min-width: 0; width: 46%; max-width: 176px;
    padding: 6px 9px; clip-path: none;
  }
  .dh-ammo {
    right: 8px; bottom: 50px; min-width: 0; width: 44%; max-width: 168px;
    padding: 6px 9px; clip-path: none;
  }
  .dh-ammo-num { font-size: 26px !important; }
  .dh-ammo-hint { font-size: 9.5px !important; }
  .dh-slots {
    bottom: 8px; left: 8px; right: 8px; transform: none;
    justify-content: center; gap: 4px; flex-wrap: nowrap; max-width: calc(100vw - 16px);
  }
  .dh-slot {
    padding: 5px 6px !important; font-size: 10px !important; min-height: 34px !important; min-width: 0 !important;
    flex: 1 1 0; display: flex; align-items: center; justify-content: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .dh-touch { left: 8px; bottom: 164px; }
  .dh-touch-btns { right: 8px; bottom: 164px; grid-template-columns: repeat(2, 60px); gap: 6px; }
  .dh-banner { top: 82px; max-width: calc(100vw - 24px); padding: 6px 12px; }
  .dh-toast { top: 47%; bottom: auto; max-width: calc(100vw - 24px); text-align: center; }
  .dh-bench-prompt { top: 26%; max-width: calc(100vw - 28px); text-align: center; }
  .dh-modal-bg { padding: 10px; }
  .dh-logo { font-size: 44px !important; }
  .dh-card { padding: 16px 12px; max-width: 100% !important; }
  .dh-armory-title { font-size: 22px !important; }
  .dh-shop-grid { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; }
  .dh-shop-item { padding: 9px 10px; }
}
@media (max-height: 520px) {
  .dh-root { min-height: 0; }
  .dh-top { top: 6px; left: 8px; right: 245px; max-width: none; gap: 4px; flex-wrap: nowrap; overflow: hidden; }
  .dh-chip { padding: 3px 7px; font-size: 10px; white-space: nowrap; }
  .dh-corner { top: 6px; right: 8px; gap: 4px; flex-wrap: nowrap; }
  .dh-fps-chip { display: none; }
  .dh-hud { left: 8px; bottom: 6px; min-width: 0; width: 152px; padding: 4px 8px; clip-path: none; }
  .dh-hud-meta { display: none !important; }
  .dh-ammo { right: 8px; bottom: 6px; min-width: 0; width: 146px; padding: 4px 8px; clip-path: none; }
  .dh-ammo-hint { display: none !important; }
  .dh-slots { bottom: 6px; gap: 4px; }
  .dh-slot { padding: 5px 7px; font-size: 10px; min-height: 32px; display: flex; align-items: center; white-space: nowrap; }
  .dh-touch { left: 4px; bottom: 100px; transform: scale(0.84); transform-origin: bottom left; }
  .dh-touch-btns { right: 8px; bottom: 78px; grid-template-columns: repeat(3, 56px); gap: 4px; }
  .dh-touch-btns button { min-height: 34px !important; padding: 4px 4px !important; font-size: 10px !important; }
  .dh-touch-btns > button:first-child { grid-column: 1 / -1 !important; min-height: 36px !important; }
  .dh-banner { top: 44px; padding: 4px 10px; }
  .dh-bench-prompt { top: auto; bottom: 46px; padding: 4px 10px; font-size: 11px; max-width: calc(100vw - 340px); text-align: center; }
  .dh-logo { font-size: 40px !important; }
  .dh-card { padding: 16px 18px; }
}
</style>

<Box className="dh-root">
  <Loop frame running={true} @tick={arenaStep} />

  <Controls
    :bind={pad}
    enabled={started && !gameOver}
    keys={{
      up: "w ArrowUp",
      down: "s ArrowDown",
      left: "a ArrowLeft",
      right: "d ArrowRight",
      sprint: "ShiftLeft ShiftRight",
      reload: "r",
      melee: "v",
      grenade: "g",
      torch: "f",
      armory: "e",
      w1: "1",
      w2: "2",
      w3: "3",
      swap: "q",
      fire: "Space",
      mute: "m",
      pause: "p Escape"
    }}
    @press={onActionPress}
  />

  <Box className="dh-scene">
    <Scene3D
      fill={true}
      staticObjects={sceneStatic}
      objects={sceneObjects}
      lights={sceneLights}
      camera={{ position: cameraPos, lookAt: cameraLookAt, fov: 74 }}
      antialias={qualityPreset !== "low"}
      shadows={shadowsOn}
      pointerLock={started && !paused && !armoryOpen && !gameOver && !touchMode}
      mouseLook={started && !paused && !armoryOpen && !gameOver}
      crosshair={false}
      cameraSmoothing={0.35}
      maxPixelRatio={qualityPreset === "low" ? 1.0 : 1.5}
      pitchLimit={1.25}
      mouseLookSensitivity={touchMode ? 0.0055 : 0.0022}
      fog={sceneFog}
      environment={{ url: "assets/env/night-moon.hdr", background: true, backgroundIntensity: 0.85 }}
      environmentIntensity={0.78}
      toneMapping="agx"
      toneMappingExposure={1.08}
      effects={sceneEffects}
      @click={onSceneClick}
      @stats={onSceneStats}
    >
      <SceneAnchor if={started && !gameOver} object="armory-bench" offset={{ y: 1.85 }} place="above" clickThrough={true}>
        <Box className="dh-anchor-tag">
          <Text style={{ fontSize: "10px", fontWeight: 700, color: "#38bdf8", letterSpacing: "0.08em" }}>
            {nearBench ? "ARMORY BENCH [PRESS E]" : "ARMORY SUPPLY"}
          </Text>
        </Box>
      </SceneAnchor>

      <SceneAnchor if={started && !gameOver && bossAnchorId !== ""} object={bossAnchorId} offset={{ y: 2.75 }} place="above" clickThrough={true}>
        <Box className="dh-boss-anchor">
          <Text style={{ display: "block", fontSize: "10px", fontWeight: 700, color: "#fca5a5", textAlign: "center" }}>{bossLabel}</Text>
          <Box style={{ height: "5px", background: "rgba(255,255,255,0.14)", marginTop: "3px", borderRadius: "2px", overflow: "hidden" }}>
            <Box style={{ height: "100%", width: bossHpPct + "%", background: "#ef4444" }} />
          </Box>
        </Box>
      </SceneAnchor>
    </Scene3D>
  </Box>

  <!-- Screen Status Overlays -->
  <Box if={hurtFlash > 0} className="dh-ovl dh-hurt" style={{ opacity: hurtFlash }} />
  <Box if={started && !gameOver && hp <= 28} className="dh-ovl dh-low" />
  <Box if={started && !gameOver && overdriveTimer > 0} className="dh-ovl dh-overdrive" />

  <!-- Tactical Crosshair -->
  <Box
    if={started && !gameOver && !paused && !armoryOpen}
    className={hitMarkerTimer > 0 ? (hitMarkerCrit ? "dh-ovl dh-cross dh-hitcrit" : "dh-ovl dh-cross dh-hit") : "dh-ovl dh-cross"}
  >
    <Box className="dh-tick dh-tick-l" style={{ transform: "translateX(" + (-(5 + Math.round(crosshairSpread * 16))) + "px)" }} />
    <Box className="dh-tick dh-tick-r" style={{ transform: "translateX(" + (5 + Math.round(crosshairSpread * 16)) + "px)" }} />
    <Box className="dh-tick dh-tick-u" style={{ transform: "translateY(" + (-(5 + Math.round(crosshairSpread * 16))) + "px)" }} />
    <Box className="dh-tick dh-tick-d" style={{ transform: "translateY(" + (5 + Math.round(crosshairSpread * 16)) + "px)" }} />
    <Box className="dh-dot" />
    <Box if={hitMarkerTimer > 0} className="dh-hitx" />
  </Box>

  <!-- Top Telemetry Strip -->
  <Box if={started} className="dh-ovl dh-top">
    <Box className="dh-panel dh-panel-red dh-chip">
      <Text className="dh-display" style={{ fontSize: "20px", color: "#f8fafc" }}>{"Wave " + wave}</Text>
    </Box>
    <Box className="dh-panel dh-chip">
      <Text style={{ fontSize: "12px", color: "#cbd5e1", letterSpacing: "0.08em", textTransform: "uppercase" }}>
        {waveState === "between" ? ("Next wave in " + Math.ceil(waveTimer) + "s") : ((zombies.length + toSpawn) + " hostiles remaining")}
      </Text>
    </Box>
    <Box className="dh-panel dh-chip">
      <Text className="dh-display" style={{ fontSize: "16px", color: "#facc15" }}>{score + " pts"}</Text>
    </Box>
    <Box className="dh-panel dh-chip">
      <Text className="dh-display" style={{ fontSize: "15px", color: "#38bdf8" }}>{scrap + " scrap"}</Text>
    </Box>
    <Box if={streakCount >= 2} className="dh-panel dh-chip" style={{ borderColor: "rgba(250,204,21,0.5)" }}>
      <Text className="dh-display" style={{ fontSize: "14px", color: "#fde047" }}>{streakCount + "x Streak"}</Text>
    </Box>
  </Box>

  <!-- Top-Right Quick Actions -->
  <Box if={started && !gameOver} className="dh-ovl dh-corner">
    <Box className="dh-panel dh-fps-chip" style={{ padding: "5px 10px", fontSize: "11px", color: "#94a3b8" }}>
      <Text>{fpsReadout + " FPS · " + qualityPreset.toUpperCase()}</Text>
    </Box>
    <Button variant="ghost" @click={toggleTouchMode} style={{ padding: "6px 9px", minHeight: "34px", fontSize: "11px", background: touchMode ? "rgba(56,189,248,0.25)" : "rgba(12,16,24,0.85)", color: "#e2e8f0", border: touchMode ? "1px solid #38bdf8" : "1px solid rgba(255,255,255,0.18)" }}>
      {touchMode ? "Touch" : "Keys"}
    </Button>
    <Button variant="ghost" @click={toggleTorchLight} style={{ padding: "6px 9px", minHeight: "34px", fontSize: "11px", background: "rgba(12,16,24,0.85)", color: torchOn ? "#fde047" : "#94a3b8", border: "1px solid rgba(255,255,255,0.18)" }}>
      {torchOn ? "Torch" : "Dark"}
    </Button>
    <Button variant="ghost" @click={toggleMute} style={{ padding: "6px 9px", minHeight: "34px", fontSize: "11px", background: muted ? "rgba(127,29,29,0.55)" : "rgba(12,16,24,0.85)", color: muted ? "#fca5a5" : "#e2e8f0", border: muted ? "1px solid rgba(248,113,113,0.55)" : "1px solid rgba(255,255,255,0.18)" }}>
      {muted ? "Muted" : "SFX"}
    </Button>
    <Button variant="ghost" @click={triggerTouchArmory} style={{ padding: "6px 9px", minHeight: "34px", fontSize: "11px", background: "rgba(12,24,38,0.88)", color: "#38bdf8", border: "1px solid rgba(56,189,248,0.45)" }}>
      Armory
    </Button>
    <Button variant="ghost" @click={togglePauseModal} style={{ padding: "6px 9px", minHeight: "34px", fontSize: "11px", background: "rgba(12,16,24,0.85)", color: "#f8fafc", border: "1px solid rgba(255,255,255,0.18)" }}>
      Menu
    </Button>
  </Box>

  <!-- Banners & Toasts -->
  <Box if={started && waveBanner !== ""} className="dh-ovl dh-banner">
    <Text className="dh-display" style={{ fontSize: "18px", color: "#fef3c7", letterSpacing: "0.14em" }}>{waveBanner}</Text>
  </Box>
  <Box if={started && toastMsg !== ""} className="dh-ovl dh-toast">
    <Text style={{ fontSize: "12px", fontWeight: 600, color: "#bae6fd" }}>{toastMsg}</Text>
  </Box>
  <Box if={started && !paused && !armoryOpen && !gameOver && nearBench} className="dh-ovl dh-bench-prompt">
    <Text style={{ fontSize: "12px", fontWeight: 700, color: "#7dd3fc" }}>{touchMode ? "Bench ahead — tap SHOP or Armory to upgrade" : "Press E to open Armory Workbench"}</Text>
  </Box>

  <!-- Bottom-Left Vitals & Armor -->
  <Box if={started} className="dh-ovl dh-panel dh-panel-red dh-hud">
    <Stack direction="horizontal" gap={10} style={{ justifyContent: "space-between", alignItems: "baseline" }}>
      <Text className="dh-display" style={{ fontSize: "12px", color: "#94a3b8" }}>Health</Text>
      <Text className="dh-display" style={{ fontSize: "24px", color: hp <= 28 ? "#f87171" : "#f8fafc", lineHeight: 1 }}>{hp}</Text>
    </Stack>
    <Box className="dh-bar"><Box className="dh-fill-hp" style={{ width: hp + "%" }} /></Box>

    <Stack direction="horizontal" gap={10} style={{ justifyContent: "space-between", alignItems: "baseline", marginTop: "7px" }}>
      <Text className="dh-display" style={{ fontSize: "11px", color: "#94a3b8" }}>Kevlar</Text>
      <Text className="dh-display" style={{ fontSize: "16px", color: "#7dd3fc", lineHeight: 1 }}>{armorPts}</Text>
    </Stack>
    <Box className="dh-bar" style={{ height: "6px" }}><Box className="dh-fill-ar" style={{ width: armorPts + "%" }} /></Box>

    <Stack className="dh-hud-meta" direction="horizontal" gap={12} style={{ marginTop: "8px", justifyContent: "space-between" }}>
      <Text style={{ fontSize: "11px", color: "#94a3b8" }}>{kills + " kills (" + headshots + " HS)"}</Text>
      <Text style={{ fontSize: "11px", color: "#cbd5e1" }}>{"Best " + bestScore}</Text>
    </Stack>
  </Box>

  <!-- Bottom-Center Weapon Strip -->
  <Box if={started && !gameOver} className="dh-ovl dh-slots">
    <Button variant="ghost" @click={selectPistol} className={weaponIdx === 0 ? "dh-slot dh-slot-on" : "dh-slot"}>1 · Pistol</Button>
    <Button variant="ghost" @click={selectShotgun} className={weaponIdx === 1 ? "dh-slot dh-slot-on" : "dh-slot"}>2 · Shotgun</Button>
    <Button variant="ghost" @click={selectSmg} className={weaponIdx === 2 ? "dh-slot dh-slot-on" : "dh-slot"}>
      {weaponUnlocked[2] ? "3 · MP-X SMG" : "3 · Locked"}
    </Button>
    <Button variant="ghost" @click={triggerHudGrenade} className="dh-slot" style={{ color: grenadesLeft > 0 ? "#fca5a5" : "#64748b" }}>
      {"G · Frag x" + grenadesLeft}
    </Button>
  </Box>

  <!-- Bottom-Right Ammo & Reload -->
  <Box if={started} className="dh-ovl dh-panel dh-panel-sky dh-ammo">
    <Text className="dh-display" style={{ display: "block", fontSize: "12px", color: "#94a3b8" }}>
      {reloadTimer > 0 ? "RELOADING..." : WEAPONS[weaponIdx].name}
    </Text>
    <Text className="dh-display dh-ammo-num" style={{ display: "block", fontSize: "36px", color: magAmmo[weaponIdx] === 0 ? "#f87171" : "#f8fafc", lineHeight: 1.05 }}>
      {magAmmo[weaponIdx]}
      <Text style={{ fontSize: "15px", color: "#94a3b8", fontWeight: 600 }}>
        {" / " + (resAmmo[weaponIdx] < 0 ? "∞" : resAmmo[weaponIdx])}
      </Text>
    </Text>
    <Text className="dh-ammo-hint" style={{ display: "block", fontSize: "11px", color: "#94a3b8", marginTop: "4px" }}>
      {touchMode ? "Drag view to aim · Tap or hold FIRE" : "V · Bash  |  R / RMB · Reload"}
    </Text>
  </Box>

  <!-- Touch Controls -->
  <Box if={started && touchMode && !paused && !armoryOpen && !gameOver} className="dh-touch">
    <DPad :bind={pad} buttonSize={46} />
  </Box>
  <Box if={started && touchMode && !paused && !armoryOpen && !gameOver} className="dh-touch-btns">
    <Button className="dh-fire-btn" @pointerdown={onTouchFireDown} @pointerup={onTouchFireUp} @pointerleave={onTouchFireUp} @pointercancel={onTouchFireUp} @click={triggerTouchFire} style={{ padding: "11px 14px", fontWeight: 800, background: "#dc2626", color: "#fff", borderRadius: "999px", minHeight: "46px", gridColumn: "span 2" }}>FIRE</Button>
    <Button @click={triggerTouchReload} variant="ghost" style={{ padding: "6px 8px", minHeight: "38px", fontSize: "11px", background: "rgba(15,23,42,0.88)", color: "#e2e8f0", border: "1px solid #475569" }}>RELOAD</Button>
    <Button @click={triggerTouchMelee} variant="ghost" style={{ padding: "6px 8px", minHeight: "38px", fontSize: "11px", background: "rgba(15,23,42,0.88)", color: "#e2e8f0", border: "1px solid #475569" }}>BASH</Button>
    <Button @click={triggerTouchGrenade} variant="ghost" style={{ padding: "6px 8px", minHeight: "38px", fontSize: "11px", background: "rgba(15,23,42,0.88)", color: "#fca5a5", border: "1px solid #7f1d1d" }}>{"FRAG " + grenadesLeft}</Button>
    <Button @click={triggerTouchSwap} variant="ghost" style={{ padding: "6px 8px", minHeight: "38px", fontSize: "11px", background: "rgba(15,23,42,0.88)", color: "#e2e8f0", border: "1px solid #475569" }}>SWAP</Button>
    <Button @click={toggleTouchSprint} variant="ghost" style={{ padding: "6px 8px", minHeight: "36px", fontSize: "11px", background: touchSprint ? "rgba(250,204,21,0.34)" : "rgba(15,23,42,0.88)", color: "#fde047", border: touchSprint ? "1px solid #facc15" : "1px solid #475569" }}>{touchSprint ? "RUN ON" : "RUN"}</Button>
    <Button if={nearBench || waveState === "between"} @click={triggerTouchArmory} variant="ghost" style={{ padding: "6px 8px", minHeight: "36px", fontSize: "11px", fontWeight: 700, background: "rgba(2,132,199,0.4)", color: "#bae6fd", border: "1px solid #38bdf8" }}>SHOP</Button>
  </Box>

  <!-- Title Screen Overlay -->
  <Box if={!started} className="dh-ovl dh-modal-bg">
    <Box className="dh-card">
      <Text style={{ display: "block", fontSize: "11px", letterSpacing: "0.38em", color: "#f87171", fontWeight: 700 }}>NIGHTFALL HORDE SURVIVAL</Text>
      <Text className="dh-display dh-logo" style={{ display: "block", marginTop: "6px" }}>DEAD HOURS</Text>
      <Text style={{ display: "block", marginTop: "10px", fontSize: "14px", color: "#cbd5e1", lineHeight: 1.5 }}>
        Defend the floodlit cemetery courtyard against Walkers, Runners, Acid Spitters, and Armored Riot Brutes. Shoot courtyard walls, streetlamps, leaking hazard barrels, or the quarantine pickup to shatter glass and trigger explosions.
      </Text>

      <Stack direction="horizontal" gap={10} style={{ justifyContent: "center", marginTop: "20px", flexWrap: "wrap" }}>
        <Button @click={startNewRun} className="dh-display" style={{ padding: "13px 34px", fontSize: "18px", background: "linear-gradient(180deg, #ef4444, #991b1b)", color: "#fff", border: "1px solid #f87171" }}>ENTER THE YARD</Button>
        <Button variant="ghost" @click={cycleQualityPreset} style={{ padding: "12px 18px", background: "rgba(255,255,255,0.08)", color: "#e2e8f0", border: "1px solid rgba(255,255,255,0.18)" }}>
          {"Graphics: " + qualityPreset.toUpperCase()}
        </Button>
        <Button variant="ghost" @click={toggleMute} style={{ padding: "12px 16px", background: muted ? "rgba(127,29,29,0.55)" : "rgba(255,255,255,0.08)", color: muted ? "#fca5a5" : "#e2e8f0", border: "1px solid rgba(255,255,255,0.18)" }}>
          {muted ? "Audio: Muted" : "Audio: On"}
        </Button>
      </Stack>

      <Stack if={!touchMode} direction="horizontal" gap={14} style={{ justifyContent: "center", marginTop: "18px", flexWrap: "wrap" }}>
        <Text style={{ fontSize: "12px", color: "#cbd5e1" }}><Text className="dh-kbd">WASD</Text> Move</Text>
        <Text style={{ fontSize: "12px", color: "#cbd5e1" }}><Text className="dh-kbd">Shift</Text> Sprint</Text>
        <Text style={{ fontSize: "12px", color: "#cbd5e1" }}><Text className="dh-kbd">LMB</Text> Fire</Text>
        <Text style={{ fontSize: "12px", color: "#cbd5e1" }}><Text className="dh-kbd">R/RMB</Text> Reload</Text>
        <Text style={{ fontSize: "12px", color: "#cbd5e1" }}><Text className="dh-kbd">G</Text> Frag</Text>
        <Text style={{ fontSize: "12px", color: "#cbd5e1" }}><Text className="dh-kbd">V</Text> Bash</Text>
        <Text style={{ fontSize: "12px", color: "#cbd5e1" }}><Text className="dh-kbd">E</Text> Armory</Text>
        <Text style={{ fontSize: "12px", color: "#cbd5e1" }}><Text className="dh-kbd">M</Text> Mute</Text>
      </Stack>
      <Stack if={touchMode} direction="horizontal" gap={14} style={{ justifyContent: "center", marginTop: "18px", flexWrap: "wrap" }}>
        <Text style={{ fontSize: "12px", color: "#cbd5e1" }}><Text className="dh-kbd">D-Pad</Text> Move</Text>
        <Text style={{ fontSize: "12px", color: "#cbd5e1" }}><Text className="dh-kbd">Drag View</Text> Turn &amp; Look</Text>
        <Text style={{ fontSize: "12px", color: "#cbd5e1" }}><Text className="dh-kbd">FIRE / Tap</Text> Shoot</Text>
        <Text style={{ fontSize: "12px", color: "#cbd5e1" }}><Text className="dh-kbd">SHOP</Text> Armory</Text>
      </Stack>

      <Box className="dh-board">
        <Stack direction="horizontal" gap={8} style={{ justifyContent: "space-between", alignItems: "center", marginBottom: "6px" }}>
          <Text className="dh-display" style={{ fontSize: "14px", color: "#facc15" }}>GRAVEYARD LEDGER · TOP SURVIVORS</Text>
          <Text style={{ fontSize: "11px", color: "#94a3b8" }}>{"Local Best: " + bestScore}</Text>
        </Stack>
        #if (leaderboard.length === 0)
          <Text style={{ fontSize: "12px", color: "#64748b" }}>No scores recorded yet. Be the first to hold the gates.</Text>
        #else
          #each (row, idx in leaderboard)
            <Box className="dh-row">
              <Text style={{ fontSize: "12px", color: idx === 0 ? "#fde047" : "#e2e8f0", fontWeight: idx < 3 ? 700 : 400 }}>
                {"#" + (idx + 1) + "  " + (row.name || "Survivor")}
              </Text>
              <Text style={{ fontSize: "12px", color: "#94a3b8" }}>
                {"Wave " + (row.wave || 1) + " · " + (row.kills || 0) + " kills · "}
                <Text style={{ color: "#facc15", fontWeight: 700 }}>{(row.score || 0) + " pts"}</Text>
              </Text>
            </Box>
          #end
        #end
      </Box>
    </Box>
  </Box>

  <!-- Armory Workbench Modal -->
  <Box if={started && armoryOpen && !gameOver} className="dh-ovl dh-modal-bg">
    <Box className="dh-card" style={{ maxWidth: "740px" }}>
      <Stack direction="horizontal" gap={10} style={{ justifyContent: "space-between", alignItems: "center", flexWrap: "wrap" }}>
        <Box style={{ textAlign: "left", minWidth: 0, flex: "1 1 190px" }}>
          <Text className="dh-display dh-armory-title" style={{ display: "block", fontSize: "28px", color: "#38bdf8" }}>ARMORY WORKBENCH</Text>
          <Text style={{ display: "block", fontSize: "12px", color: "#94a3b8" }}>Spend Scrap earned from kills & headshots</Text>
        </Box>
        <Box style={{ padding: "7px 14px", background: "rgba(56,189,248,0.15)", border: "1px solid rgba(56,189,248,0.5)", borderRadius: "6px", flexShrink: 0 }}>
          <Text className="dh-display" style={{ fontSize: "18px", color: "#38bdf8" }}>{scrap + " SCRAP"}</Text>
        </Box>
      </Stack>

      <Box className="dh-shop-grid">
        <Box className="dh-shop-item">
          <Text style={{ display: "block", fontWeight: 700, color: "#f8fafc" }}>MP-X Suppressed SMG</Text>
          <Text style={{ display: "block", fontSize: "12px", color: "#94a3b8", marginTop: "3px" }}>
            {weaponUnlocked[2] ? "Refill +128 9mm rounds" : "Full-auto 32-round SMG"}
          </Text>
          <Button @click={buySmg} style={{ marginTop: "8px", width: "100%", background: "#0284c7", color: "#fff" }}>
            {weaponUnlocked[2] ? "Buy Ammo (45 Scrap)" : "Unlock MP-X (140 Scrap)"}
          </Button>
        </Box>

        <Box className="dh-shop-item">
          <Text style={{ display: "block", fontWeight: 700, color: "#f8fafc" }}>Ammo Supply Crate</Text>
          <Text style={{ display: "block", fontSize: "12px", color: "#94a3b8", marginTop: "3px" }}>
            {weaponUnlocked[2] ? "+18 Shotgun Shells & +96 SMG" : "+18 Shotgun Shells"}
          </Text>
          <Button @click={buyAmmo} style={{ marginTop: "8px", width: "100%", background: "#334155", color: "#fff" }}>Buy (35 Scrap)</Button>
        </Box>

        <Box className="dh-shop-item">
          <Text style={{ display: "block", fontWeight: 700, color: "#f8fafc" }}>Field Trauma Kit</Text>
          <Text style={{ display: "block", fontSize: "12px", color: "#94a3b8", marginTop: "3px" }}>Restore +50 HP immediately</Text>
          <Button @click={buyMedkit} style={{ marginTop: "8px", width: "100%", background: "#16a34a", color: "#fff" }}>Heal (45 Scrap)</Button>
        </Box>

        <Box className="dh-shop-item">
          <Text style={{ display: "block", fontWeight: 700, color: "#f8fafc" }}>Kevlar Tactical Vest</Text>
          <Text style={{ display: "block", fontSize: "12px", color: "#94a3b8", marginTop: "3px" }}>Add +50 Armor (62% DMG absorb)</Text>
          <Button @click={buyArmor} style={{ marginTop: "8px", width: "100%", background: "#0369a1", color: "#fff" }}>Equip (50 Scrap)</Button>
        </Box>

        <Box className="dh-shop-item">
          <Text style={{ display: "block", fontWeight: 700, color: "#f8fafc" }}>Frag Grenades</Text>
          <Text style={{ display: "block", fontSize: "12px", color: "#94a3b8", marginTop: "3px" }}>Explosive crowd clear (max 4)</Text>
          <Button @click={buyGrenade} style={{ marginTop: "8px", width: "100%", background: "#b91c1c", color: "#fff" }}>
            {grenadesLeft >= 4 ? "MAXED (4/4)" : (grenadesLeft === 3 ? "Top Off +1 (20 Scrap)" : "Stockpile +2 (40 Scrap)")}
          </Button>
        </Box>

        <Box className="dh-shop-item">
          <Text style={{ display: "block", fontWeight: 700, color: "#f8fafc" }}>{"Hollow Points · Lv" + perkDmgLevel + "/3"}</Text>
          <Text style={{ display: "block", fontSize: "12px", color: "#94a3b8", marginTop: "3px" }}>+18% all weapon & melee damage</Text>
          <Button @click={buyDmgPerk} style={{ marginTop: "8px", width: "100%", background: "#d97706", color: "#fff" }}>
            {perkDmgLevel >= 3 ? "MAXED" : ("Upgrade (" + (90 + perkDmgLevel * 60) + " Scrap)")}
          </Button>
        </Box>

        <Box className="dh-shop-item">
          <Text style={{ display: "block", fontWeight: 700, color: "#f8fafc" }}>{"Quick Mag · Lv" + perkReloadLevel + "/3"}</Text>
          <Text style={{ display: "block", fontSize: "12px", color: "#94a3b8", marginTop: "3px" }}>+22% faster reload cycle</Text>
          <Button @click={buyReloadPerk} style={{ marginTop: "8px", width: "100%", background: "#7c3aed", color: "#fff" }}>
            {perkReloadLevel >= 3 ? "MAXED" : ("Upgrade (" + (75 + perkReloadLevel * 50) + " Scrap)")}
          </Button>
        </Box>

        <Box className="dh-shop-item">
          <Text style={{ display: "block", fontWeight: 700, color: "#f8fafc" }}>{"Sprint Boots · Lv" + perkSpeedLevel + "/2"}</Text>
          <Text style={{ display: "block", fontSize: "12px", color: "#94a3b8", marginTop: "3px" }}>+10% base movement speed</Text>
          <Button @click={buySpeedPerk} style={{ marginTop: "8px", width: "100%", background: "#0d9488", color: "#fff" }}>
            {perkSpeedLevel >= 2 ? "MAXED" : ("Upgrade (" + (80 + perkSpeedLevel * 60) + " Scrap)")}
          </Button>
        </Box>
      </Box>

      <Button @click={closeArmoryBench} className="dh-display" style={{ marginTop: "18px", padding: "11px 28px", fontSize: "16px", background: "#ef4444", color: "#fff" }}>RETURN TO COMBAT</Button>
    </Box>
  </Box>

  <!-- Pause Modal -->
  <Box if={started && paused && !armoryOpen && !gameOver} className="dh-ovl dh-modal-bg">
    <Box className="dh-card" style={{ maxWidth: "480px" }}>
      <Text className="dh-display" style={{ display: "block", fontSize: "34px", color: "#f8fafc" }}>PAUSED</Text>
      <Text style={{ display: "block", marginTop: "6px", fontSize: "13px", color: "#94a3b8" }}>
        {"Wave " + wave + " · " + score + " pts · " + kills + " kills"}
      </Text>
      <Stack direction="horizontal" gap={10} style={{ justifyContent: "center", marginTop: "20px", flexWrap: "wrap" }}>
        <Button @click={resumePlay} className="dh-display" style={{ padding: "12px 26px", background: "#ef4444", color: "#fff" }}>Resume</Button>
        <Button variant="ghost" @click={cycleQualityPreset} style={{ padding: "12px 18px", background: "rgba(255,255,255,0.08)", color: "#e2e8f0", border: "1px solid rgba(255,255,255,0.2)" }}>
          {"Quality: " + qualityPreset.toUpperCase()}
        </Button>
        <Button variant="ghost" @click={returnToTitle} style={{ padding: "12px 18px", background: "rgba(255,255,255,0.08)", color: "#fca5a5", border: "1px solid rgba(255,255,255,0.2)" }}>Quit</Button>
      </Stack>
    </Box>
  </Box>

  <!-- Game Over & Leaderboard Submit -->
  <Box if={gameOver} className="dh-ovl dh-modal-bg">
    <Box className="dh-card" style={{ maxWidth: "540px" }}>
      <Text className="dh-display" style={{ display: "block", fontSize: "13px", letterSpacing: "0.35em", color: "#f87171" }}>THE COURTYARD FELL</Text>
      <Text className="dh-display" style={{ display: "block", marginTop: "6px", fontSize: "52px", color: "#f8fafc", lineHeight: 1 }}>{score + " PTS"}</Text>
      <Text style={{ display: "block", marginTop: "8px", fontSize: "14px", color: "#cbd5e1" }}>
        {"Wave " + wave + " · " + kills + " kills · " + headshots + " headshots · Best " + bestScore}
      </Text>

      <Stack direction="horizontal" gap={8} style={{ justifyContent: "center", marginTop: "18px", flexWrap: "wrap" }}>
        <Input value={playerName} @change={setPlayerName} placeholder="Survivor name for ledger" style={{ width: "min(220px, 100%)" }} />
        <Button @click={submitScore} disabled={scoreSubmitted} style={{ background: scoreSubmitted ? "#334155" : "#0284c7", color: "#fff" }}>
          {scoreSubmitted ? "Recorded" : "Post Score"}
        </Button>
      </Stack>
      <Text if={boardStatusMsg !== ""} style={{ display: "block", marginTop: "8px", fontSize: "12px", color: "#38bdf8" }}>{boardStatusMsg}</Text>

      <Stack direction="horizontal" gap={10} style={{ justifyContent: "center", marginTop: "20px", flexWrap: "wrap" }}>
        <Button @click={startNewRun} className="dh-display" style={{ padding: "12px 28px", fontSize: "16px", background: "#ef4444", color: "#fff" }}>PLAY AGAIN</Button>
        <Button variant="ghost" @click={returnToTitle} style={{ padding: "12px 22px", background: "rgba(255,255,255,0.08)", color: "#fff", border: "1px solid rgba(255,255,255,0.2)" }}>Title & Leaderboard</Button>
      </Stack>
    </Box>
  </Box>
</Box>
