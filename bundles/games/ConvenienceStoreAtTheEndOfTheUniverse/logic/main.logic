let counterPanel = "";
function toggleCounterPanel(panel){counterPanel=counterPanel===panel?"":panel;publish();}
// Host lifecycle and input only. Simulation, dialogue and storage remain separate modules.
function command(id){
 if(!activeAllowed())return;
 counterPanel="";
 if(id.indexOf("shelf:")===0)useShelf(Number(id.slice(6)));
 else if(id.indexOf("person:")===0)talkTo(Number(id.slice(7)));
 else if(id.indexOf("gift:")===0)tell(giftText(id.slice(5)));
 else if(id==="turn")turnItem();else if(id==="return")returnItem();else if(id==="scan")scanItem();
 else if(id==="bag")bagItem();else if(id==="till")settleSale();else if(id==="payment")openPayment();
 else if(id==="crate")takeCrate();else if(id==="mop")takeMop();else if(id==="spill")cleanSpill();
 else if(id==="coffee" || id==="noodles")startJob(id);else if(id==="door")useDoor();else if(id==="event")openEvent();
 else if(id==="window")lookOutside();else if(id==="radio"){S.store.radio=!S.store.radio;refreshAudio();tell(S.store.radio?"The little radio finds its song again.":"Just the fridge, and the quiet outside.");}
 persist();publish();
}
function beginShift(){running=true;paused=false;overlay="";lastClock=Date.now();startAudio();persist();publish();}
function openSettings(){if(!S)return;overlay="settings";paused=true;stopAudio();persist();publish();}
function resumeGame(){overlay="";paused=false;running=true;confirmReset=false;pendingImport=null;saveText="";lastClock=Date.now();startAudio();publish();}
function requestReset(){confirmReset=true;publish();}
function cancelReset(){confirmReset=false;publish();}
function newGame(){
 if(!confirmReset)return;
 // Explicit destructive confirmation still keeps both the old checkpoint and session.
 try{let old=localStorage.getItem(SAVE_KEY);if(old)localStorage.setItem(SAVE_KEY+":before-reset",old);localStorage.setItem(SAVE_KEY+":session-before-reset",JSON.stringify(envelope()));}
 catch(e){saveStatus="Could not keep the old checkpoint. Export it before starting anew.";publish();return;}
 stopAudio();saveBlocked=false;initializeFresh();confirmReset=false;running=true;paused=false;overlay="";lastClock=Date.now();persist();startAudio();publish();
}
function focusLost(){if(running && overlay===""){paused=true;overlay="settings";stopAudio();persist();publish();}}
function onKey(event){
 let key=String(event.key || "").toLowerCase();
 let tag=event.targetTag?String(event.targetTag).toLowerCase():(event.target && event.target.tagName?String(event.target.tagName).toLowerCase():"");
 if(tag==="input" || tag==="textarea" || tag==="select" || event.targetEditable || event.target && event.target.isContentEditable || event.ctrlKey || event.metaKey || event.altKey || event.repeat)return;
 if(key==="escape"){
  if(event.preventDefault)event.preventDefault();
  if(S.dialog)closeDialogue();else if(S.inspection)closePayment();else if(overlay && overlay!=="welcome")resumeGame();else if(running)openSettings();return;
 }
 if(key==="m"){if(event.preventDefault)event.preventDefault();toggleSound();return;}
 if(!activeAllowed())return;
 if((key===" " || key==="enter") && tag==="button")return;
 let action="";
 if(key>="1" && key<="6")action="shelf:"+(Number(key)-1);
 let shortcuts={q:"crate",r:"turn",s:"scan",b:"bag",p:"payment",e:"till",c:"coffee",n:"noodles",x:"mop",f:"event"};
 if(shortcuts[key])action=shortcuts[key];
 if(key===" " || key==="t"){let c=activeCustomer();if(c)action="person:"+c.id;}
 if(action){if(event.preventDefault)event.preventDefault();command(action);}
}
function tick(){
 if(!S)return;
 let now=Date.now(),dt=lastClock?clamp((now-lastClock)/1000,0,0.12):0;lastClock=now;
 if(activeAllowed()){
  S.time+=dt;S.shift.clock+=dt;stepCosmic(dt);stepStore(dt);stepCustomers(dt);
  if(noticeTime>0)noticeTime=Math.max(0,noticeTime-dt);
  if(captionTime>0)captionTime=Math.max(0,captionTime-dt);
  saveClock+=dt;if(saveClock>=5){saveClock=0;persist();}
 }
 publish();
}
function beforeClose(){persist();stopAudio();}
function _init(){
 if(!restore())initializeFresh();
 if(!inputInstalled){
  inputInstalled=true;
  try{window.addEventListener("keydown",onKey);window.addEventListener("blur",focusLost);window.addEventListener("beforeunload",beforeClose);}catch(e){}
 }
 lastClock=Date.now();publish();
}
function _cleanup(){persist();stopAudio();try{window.removeEventListener("keydown",onKey);window.removeEventListener("blur",focusLost);window.removeEventListener("beforeunload",beforeClose);}catch(e){}inputInstalled=false;}
