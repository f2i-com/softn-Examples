// Choices are available because of remembered promises and objects, not a displayed morality bar.
function companions(){let n=0;for(let i=0;i<6;i++)if(S.characters[i].invited || S.characters[i].bond>=8)n++;return n;}
function endingChoices(){
 let out=[{id:"stay",name:"Keep the light on",detail:"Leave a place for whoever stays. The kettle still works."},
 {id:"close",name:"Close, with love",detail:"Share the last cups. Take the welcome mat with you."}];
 if(flag("legacyMove") || (flag("travellerMap") && (flag("daveVan") || S.payments.favour>=2)))out.splice(1,0,{id:"move",name:"Next universe, same usual",detail:"A marked service entrance. A promised lift. Mind the step."});
 if((flag("melloName") || flag("melloChosen")) && flag("bookName") && (S.payments.memory>=2 || flag("memoryShared")))out.push({id:"remember",name:"Open the memory jar",detail:"Give the little mornings somewhere to happen again."});
 if(flag("daveBranch") && flag("daveReceipt") && S.payments.impossible>=2)out.push({id:"branch",name:"Open a branch office",detail:"Dave has the forms. R-7 has an unlicensed banana."});
 return out;
}
function endingEpilogue(who,id){
 let r=S.characters[who],close=r.invited || r.bond>=8;
 if(id==="close")return [flag("ikoCow")?"Iko packs the tiny fridge. There is a cow drawn on the carton inside.":"Iko tucks a carton of milk into their coat. One small, familiar thing for the road.",flag("r7Kevin")?"R-7 takes the banana stand. It is not useful. They take it anyway.":"R-7 checks the door mechanism one last time, then takes an entirely unnecessary banana.",flag("melloName")?"Mara leaves a ring of warmth on the counter. You know whose it is.":"Mello leaves the cup where the morning light would have reached it.","The Traveller leaves you a note: LOVELY TO MEET YOU. The ink is from tomorrow.",flag("nimbusName")?"Aster walks with you as a small patch of extremely local weather.":"Nimbus keeps the rain off the others, one small cloud at a time.","Dave switches the last light off, checks it twice, and offers everyone chips."][who];
 if(!close)return ["Iko leaves their forwarding address inside the fridge magnet.","R-7 sends a maintenance note. At the bottom is a very bad joke.","Sometimes the coffee warmer holds two circles of warmth instead of one.","A postcard arrives before its sender. It says: I THINK I WILL LIKE YOU.","A small raincloud visits the plant whenever there is room in the sky.","There is a receipt in the till: THANK YOU. Dave kept the other copy."][who];
 return ["Iko labels a shelf with their name. Home has a fridge, and someone who remembers.",flag("r7Kevin")?"R-7 and Kevin share the window seat. The banana is listed as a dependent.":"R-7 fixes the squeaky chair, then learns how to leave it squeaky enough to recognise.",flag("melloName")?"Mara takes her usual place. Nobody has to ask who the spare cup is for.":"Mello finds she can hold the mug now. It is the company, not the physics.",id==="move"?"The Traveller guides the shop through a service door. The noodles arrive yesterday.":"The Traveller introduces themselves again. You already know what to recommend.",flag("nimbusName")?"Aster tends a tiny indoor weather system. The plant has never been happier.":"Nimbus puts down roots, metaphorically. The plant puts down roots literally.",id==="branch"?"Dave expenses the end of the universe. The claim is approved by a banana.":"Dave loosens his tie and opens the chips. No receipt is needed this time."][who];
}
function chooseEnding(id){
 if(!S || S.phase!=="finale")return;
 let allowed=endingChoices().some(function(e){return e.id===id;});if(!allowed)return;
 let title="",body="";
 if(id==="stay"){
  title=companions()>=4?"One light left on":"Open, somehow";
  body=companions()>=4?"The regulars bring their chairs. The last stars have faded, but the shop window stays bright. Nobody calls this saving the universe. It is a smaller, more practical kind of miracle. Someone asks whether there is more coffee.":"You leave the light on. The shop is quiet, but not empty of what happened here. A cup. A label. A promise on a scrap of paper. Beyond the door, something notices the word OPEN.";
 }else if(id==="move"){
  title="Next universe, same usual";body="Dave backs the van up to a service entrance in reality. The Traveller says, 'Mind the step.' The shop folds gently into a new night. The sky is unfamiliar. The fridge is humming. R-7 still orders a banana.";
 }else if(id==="close"){
  title="Closed, with love";body="You make one final pot, leave the till open, and turn the key. No one walks away alone. The universe does not last forever. Neither did this shift. For an ordinary little shop, you made an extraordinary difference. Dave has brought the chips.";
 }else if(id==="remember"){
  title="Something before morning";body="You open the jar. Rain finds a roof. Toast burns. Someone laughs in a kitchen that has not existed for a very long time. The little memories unfold around the shop, making room for a morning. You cannot tell whether it is old or new. The kettle does not care.";
 }else{
  title="Open twenty-five hours";body="Dave files the paperwork. The impossible coin pays the registration fee on its third side. Your shop becomes the first convenience store incorporated outside existence. Opening hours: YES. R-7 is employee of the month. Kevin is head of accounts. The biscuits are deductible.";
 }
 if(flag("storeAnchor"))body+=" The supplier's bolt holds one corner of the welcome mat in place: a small promise that this place was real.";
 if(flag("storeMobile"))body+=" You keep the supplier's hinge in your pocket. There may yet be another door.";
 if(flag("freeShelf"))body+=" The last shelf has no prices on it. Nobody needs to ask.";
 let rows=[];for(let i=0;i<6;i++)rows.push({who:i,text:endingEpilogue(i,id)});
 S.ending={id:id,title:title,body:body,epilogues:rows};S.phase="ended";S.dialog=null;S.inspection=false;
 profile.completed++;if(!has(profile.endings,id))profile.endings.push(id);
 journal(title+". "+body);sfx("ending","The refrigerator hums. A final familiar tune.",0.27);persist();publish();
}
