// Retail actions are explicit, reversible until the till settles a sale, and idempotent afterwards.
function resetCheckout(){S.store.hand=-1;S.store.turned=false;S.store.scanned=false;S.store.bagged=false;S.paymentChoice="";}
function returnItem(){
 let p=S.store.hand;if(p<0)return;
 S.store.stock[p]++;
 if(p===2)S.store.coffee++;
 if(p===3)S.store.noodles++;
 resetCheckout();tell("Back on the shelf. No harm done.");
}
function useShelf(index){
 if(!whole(index,0,5))return;
 if(S.store.carryingCrate){stockShelf(index);return;}
 let c=activeCustomer();
 if(!c){tell("The shelves are ready. Click the door to welcome the next customer.");return;}
 if(S.store.hand===index){turnItem();return;}
 if(S.store.hand>=0)returnItem();
 if(S.store.stock[index]<=0){tell("An empty space on the shelf. Take the delivery box, then click this shelf to refill it.");return;}
 if(index===2 && S.store.coffee<=0){tell("The coffee pot is empty. Click the kettle to brew a fresh pot.");return;}
 if(index===3 && S.store.noodles<=0){tell("The noodles need hot water. Click the little hotplate.");return;}
 S.store.stock[index]--;S.store.hand=index;
 if(index===2)S.store.coffee--;
 if(index===3)S.store.noodles--;
 sfx("pick","Packaging rustles.",0.32);
 tell(PRODUCTS[index].name+" on the counter. Turn the package to find its barcode.");
}
function turnItem(){
 if(S.store.hand<0){tell("Take a product from the shelf first.");return;}
 if(S.store.bagged){tell("The purchase is safely bagged. Check payment, then press the till.");return;}
 if(S.store.scanned){tell("Already scanned. Slide it into the paper bag.");return;}
 S.store.turned=!S.store.turned;
 sfx("paper","The package turns in your hand.",0.20);
 tell(S.store.turned?"There it is: a barcode. Slide it over the scanner.":"The colourful side. The barcode is on the other side.");
}
function scanItem(){
 let c=activeCustomer();
 if(!c || S.store.hand<0){tell("The scanner is waiting for something with a barcode.");return;}
 if(S.store.hand!==c.item){tell(REGULARS[c.who].name+" gently points to "+PRODUCTS[c.item].name+". Return this item or pick their usual.");sfx("wrong","The scanner gives a polite double beep.",0.25);return;}
 if(S.store.scanned){tell("One scan is plenty. It goes in the bag now.");return;}
 if(!S.store.turned){tell("Turn the package so the barcode faces the scanner.");return;}
 S.store.scanned=true;sfx("scan","Beep. "+PRODUCTS[c.item].name+".",0.45);
 tell("Beep. Now into the paper bag.");
}
function bagItem(){
 if(!S.store.scanned){tell("Scan the item before bagging it.");return;}
 if(S.store.bagged){tell("The bag is ready. The payment tray and till are next.");return;}
 S.store.bagged=true;sfx("bag","A paper bag opens with a soft crackle.",0.50);
 tell("Bagged with care. Check the payment on the little brass tray.");
}
function settleSale(){
 let c=activeCustomer();
 if(!c || c.paid || has(S.shift.settledIds,c.id)){tell("The till is closed. A quiet little clunk.");return;}
 if(S.store.hand!==c.item || !S.store.scanned || !S.store.bagged){tell("Turn, scan and bag their usual before closing the till.");return;}
 if(c.payment!=="accept" && c.payment!=="gift"){tell("There is something on the payment tray. Check it before closing the till.");return;}
 // A sale is committed once, in one mutation; reloads cannot duplicate its token or relationship reward.
 c.paid=true;S.shift.settledIds.push(c.id);S.shift.served++;
 let r=S.characters[c.who];r.visits++;r.bond++;
 if(c.payment==="gift"){r.treated++;r.bond++;journal("You put "+REGULARS[c.who].name+"'s usual on the house.",c.who);}
 else applyPayment(c);
 c.state=S.stage===6 && (r.invited || r.bond>=8)?"settling":"leaving";c.age=0;
 resetCheckout();
 S.shift.spawnIn=Math.min(S.shift.spawnIn,2.5);
 sfx("till","The register opens. A receipt curls onto the counter.",0.43);
 tell(customerThanks(c));
 if(S.shift.served===2 && !S.shift.eventDone){S.shift.eventReady=true;sfx("cosmic","Something very far away changes. Something small arrives.",0.25);journal(SHIFTS[S.stage].eventLabel+". It is waiting in the shop.");}
 updateCosmic();persist();
}
function takeCrate(){
 S.store.carryingCrate=!S.store.carryingCrate;S.store.mop=false;
 if(S.store.carryingCrate){
  let empty=S.store.reserve.every(function(n){return n===0;});
  if(empty){for(let i=0;i<6;i++)S.store.reserve[i]=2;journal("A small emergency parcel arrives on the supplier's tab. No shop-ending shortage tonight.");}
  tell("Delivery in hand. Click any shelf to stock it. Q puts the box down.");
 }else tell("The delivery box is back beneath the counter.");
 sfx("box","Cardboard slides across the floor.",0.36);
}
function stockShelf(index){
 // A single depleted product must not strand a customer while other reserves remain.
 if(S.store.stock[index]===0 && S.store.reserve[index]===0){S.store.reserve[index]=2;journal("The supplier finds two more "+PRODUCTS[index].name+" in a forgotten pocket of the delivery box. Put it on the tab.");}
 let room=12-S.store.stock[index],qty=Math.min(4,room,S.store.reserve[index]);
 if(qty<=0){tell(room<=0?"This shelf is full. Another shelf could use a little care.":"No more of that in this crate. Try another shelf.");return;}
 S.store.stock[index]+=qty;S.store.reserve[index]-=qty;S.store.carryingCrate=false;
 markRoutine("stock");sfx("stock","Packages settle into a neat row.",0.36);tell(PRODUCTS[index].name+" restocked. The labels face forward. Professional.");
}
function startJob(kind){
 if(S.store.job){tell("The "+(S.store.job==="coffee"?"coffee":"noodles")+" will be ready in a moment.");return;}
 if(kind!=="coffee" && kind!=="noodles")return;
 S.store.job=kind;S.store.jobTime=kind==="coffee"?3.2:4.5;S.store.jobTotal=S.store.jobTime;
 sfx("kettle","The kettle begins its reassuring little argument with the water.",0.43);
 tell(kind==="coffee"?"Brewing a fresh pot. You can keep working while it warms.":"Hot water into the noodles. They need a moment to become dinner.");
}
function takeMop(){S.store.mop=!S.store.mop;S.store.carryingCrate=false;tell(S.store.mop?"Mop in hand. Click the little puddle to wipe it up.":"Mop back in its corner.");}
function cleanSpill(){
 if(S.store.spill<=0){tell("The floor is improbably clean.");return;}
 if(!S.store.mop){tell("Take the mop from beside the counter first.");return;}
 S.store.spill--;S.store.cleaned++;sfx("wipe","The mop whispers across the tiles.",0.36);
 if(S.store.spill===0){S.store.mop=false;markRoutine("clean");tell("Dry floor. One less impossible thing underfoot.");}
 else tell("A little more. Even cosmic rain comes up with a mop.");
}
function stepStore(dt){
 if(S.store.job){
  S.store.jobTime=Math.max(0,S.store.jobTime-dt*(S.cosmic.stasis>0?1.8:1));
  if(S.store.jobTime===0){let kind=S.store.job;S.store.job="";if(kind==="coffee")S.store.coffee+=3;else S.store.noodles+=2;markRoutine(kind);sfx("ready","A soft click. "+(kind==="coffee"?"The coffee":"The noodles")+" is ready.",0.32);tell(kind==="coffee"?"Fresh coffee, three cups. The entire shop smells better.":"Two warm noodle cups. No unapproved dimensions in the broth.");}
 }
}
