// Conversation identity is (customer, night), not a random quip or a score threshold.
function addGift(id,who){
 if(!id || has(S.gifts,id))return;
 S.gifts.push(id);
 if(who>=0)S.characters[who].gift=true;
}
function talkTo(id){
 let c=customerById(id);
 if(!c)return;
 if(c.state!=="counter" && c.state!=="sit"){tell(REGULARS[c.who].name+": "+(c.state==="browse"?"Just looking. I know what I like.":"Be with you in a moment."));return;}
 let r=S.characters[c.who];
 if(has(r.conversations,S.stage)){tell(r.lastLine || REGULARS[c.who].name+" is enjoying the company.");return;}
 S.dialog={type:"customer",who:c.who,customerId:c.id,node:S.stage,reply:"",resolved:false};
 sfx("motif-"+REGULARS[c.who].motif,"A small, familiar melody.",0.23);
}
function openEvent(){
 if(!S.shift.eventReady || S.shift.eventDone){tell(S.shift.eventDone?"You have already made room for tonight's impossible thing.":"For a moment, everything is exactly as it should be. Almost.");return;}
 S.dialog={type:"event",who:-1,customerId:0,node:S.stage,reply:"",resolved:false};
}
function currentDialogue(){if(!S.dialog)return null;return S.dialog.type==="event"?EVENTS[S.dialog.node]:DIALOGUES[S.dialog.who][S.dialog.node];}
function chooseDialogue(index){
 if(!S.dialog || S.dialog.resolved || !whole(index,0,1))return;
 let d=S.dialog, n=currentDialogue(), q=n.choices[index];
 if(d.type==="customer"){
  let r=S.characters[d.who];
  if(has(r.conversations,d.node))return;
  r.conversations.push(d.node);r.bond+=2;r.lastChoice=q.flag;r.lastLine=q.reply;
  if(q.invite)r.invited=true;
  let c=customerById(d.customerId);if(c)c.talked=true;
 }else{
  if(S.shift.eventDone)return;
  S.shift.eventDone=true;S.shift.eventChoice=q.flag;
  if(S.stage===0 && index===1)S.cosmic.pulse=5;
  if(S.stage===1){S.store.radio=index===0;refreshAudio();}
  if(S.stage===2 && index===0){S.cosmic.stasis=12;}
  if(S.stage===4){for(let i=0;i<6;i++)S.store.reserve[i]+=4;}
  if(S.stage===5){S.store.table=true;}
  if(S.stage===6)S.store.sign=index===0?"OPEN":"COME IN ANYWAY";
 }
 remember(q.flag);addGift(q.gift,d.who);
 d.resolved=true;d.reply=q.reply;
 journal((d.who>=0?REGULARS[d.who].name+": ":"")+q.reply,d.who);
 sfx("soft","A quiet moment settles into the shop.",0.25);
 persist();publish();
}
function closeDialogue(){
 if(!S.dialog)return;
 // Backing out of an unanswered conversation is safe; it is not marked as read.
 S.dialog=null;lastClock=Date.now();persist();publish();
}
function openNotebook(){overlay="notebook";lastClock=Date.now();persist();publish();}
