// All sounds are bundled original PCM. No network, microphone, speech model or autoplay.
function caption(text){if(settings.captions){soundCaption=text;captionTime=3.4;}}
function sfx(name,text,volume){
 if(text)caption(text);
 if(settings.muted || !running || paused)return;
 try{softn.audio.play("assets/audio/"+name+".wav",{volume:volume === undefined ? 0.45 : volume});}catch(e){}
}
function stopAudio(){audioGeneration++;audioStarted=false;try{softn.audio.stopAll();}catch(e){}}
function startAudio(){
 if(!S || !running || paused || settings.muted || audioStarted)return;
 audioStarted=true;
 try{
  softn.audio.play("assets/audio/fridge.wav",{loop:true,volume:0.30});
  softn.audio.play("assets/audio/outside-"+Math.min(2,Math.floor(S.stage/3))+".wav",{loop:true,volume:S.stage>5?0.07:0.23});
  if(settings.music && S.store.radio)softn.audio.play("assets/audio/radio.wav",{loop:true,volume:S.stage>4?0.11:0.16});
 }catch(e){audioStarted=false;}
}
function refreshAudio(){stopAudio();startAudio();}
function toggleSound(){settings.muted=!settings.muted;refreshAudio();persist();publish();}
function toggleMusic(){settings.music=!settings.music;refreshAudio();persist();publish();}
function toggleMotion(){settings.reducedMotion=!settings.reducedMotion;persist();publish();}
function toggleCaptions(){settings.captions=!settings.captions;persist();publish();}
