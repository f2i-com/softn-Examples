<Text className="pan-hint" style={{color:"inherit",fontSize:"inherit"}}>↔ Slide the shop sideways to reach every shelf. No hurry.</Text>
<Box className="scene-scroll">
 <Box className="scene" ariaLabel="The Last Light convenience store. Scroll sideways on a small screen to reach every shelf.">
  <Image loading="eager" className="scene-layer sky-layer" src={asset(view.sky)} alt={view.skyText} width="100%" height="100%" objectFit="fill" showPlaceholder={false}  />
  #each (star in starsView)
   <Box className={star.className} style={star.style} />
  #end
  <Box if={view.echo} className="rain-echo" />
  <Image loading="eager" className="scene-layer room-layer" src={asset("assets/store-room.svg")} alt="Warm fluorescent lights, fridges and colourful shelves." width="100%" height="100%" objectFit="fill" showPlaceholder={false}  />
  <Button disabled={!view.running || view.overlay!=="" || view.dialogue || view.inspection || view.phase!=="shift"} className="window-hotspot hotspot" @click={command("window")} ariaLabel="Look through the shop windows" ><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="window-note">{view.skyText}</Text></Button>
  <Button disabled={!view.running || view.overlay!=="" || view.dialogue || view.inspection || view.phase!=="shift"} className={view.ready ? "door-sign hotspot ready" : "door-sign hotspot"} @click={command("door")} ariaLabel={view.ready ? "Finish this shift" : "Welcome the next customer"}><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}}>{view.sign}</Text></Button>
  <Button disabled={!view.running || view.overlay!=="" || view.dialogue || view.inspection || view.phase!=="shift"} className="radio-hotspot hotspot" @click={command("radio")} ariaLabel="Switch the little radio on or off"><Image loading="eager" src={asset("assets/objects/radio.svg")} alt="Radio" width="100%" height="100%" showPlaceholder={false}  objectFit="contain" /><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="object-label">{view.radio ? "RADIO ON" : "RADIO OFF"}</Text></Button>
  #each (gift in keepsakesView)
   <Button disabled={!view.running || view.overlay!=="" || view.dialogue || view.inspection || view.phase!=="shift"} className="keepsake hotspot" style={gift.style} ariaLabel={gift.text} @click={command("gift:"+gift.id)}><Image loading="eager" src={asset(gift.art)} alt={gift.text} width="100%" height="100%" showPlaceholder={false}  objectFit="contain" /></Button>
  #end
  <Box if={view.starLamp} className="little-light" />
  <Image loading="eager" if={view.table} className="table-art" src={asset("assets/objects/table.svg")} alt="A mismatched table, with room for the regulars." width="100%" height="100%" showPlaceholder={false}  objectFit="contain" />
  #each (shelf in shelvesView)
   <Button disabled={!view.running || view.overlay!=="" || view.dialogue || view.inspection || view.phase!=="shift"} className={shelf.className} style={shelf.style} ariaLabel={shelf.label} @click={command("shelf:"+shelf.id)}><Image loading="eager" src={asset(shelf.art)} alt={shelf.name} width="100%" height="100%" showPlaceholder={false}  objectFit="contain" /><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="shelf-label">{shelf.key+" · "+shelf.short}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="stock-tooltip">{shelf.stock+" on shelf"}</Text></Button>
  #end
  <Button disabled={!view.running || view.overlay!=="" || view.dialogue || view.inspection || view.phase!=="shift"} if={view.spill} className="spill hotspot" style={view.spillStyle} ariaLabel="Wipe the puddle with the mop" @click={command("spill")}><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="object-label">A LITTLE RAIN</Text></Button>
  #each (p in peopleView)
   <Button disabled={!view.running || view.overlay!=="" || view.dialogue || view.inspection || view.phase!=="shift"} className={p.className} style={p.style} ariaLabel={p.label} @click={command("person:"+p.id)}>
    <Image loading="eager" className="character-art" src={asset(p.art)} alt={p.name} width="100%" height="100%" showPlaceholder={false}  objectFit="contain" />
    <Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} if={p.bubble!==""} className="speech-bubble">{p.bubble}</Text>
    <Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="person-name">{p.name}</Text>
    <Image loading="eager" if={p.bag} className="carried-bag" src={asset("assets/objects/bag-full.svg")} alt="Their usual, safely bagged." width="100%" height="100%" showPlaceholder={false}  objectFit="contain" />
   </Button>
  #end
  <Image loading="eager" className="scene-layer counter-layer" src={asset("assets/counter.svg")} alt="The shop counter." width="100%" height="100%" objectFit="fill" showPlaceholder={false}  />
  <Button disabled={!view.running || view.overlay!=="" || view.dialogue || view.inspection || view.phase!=="shift"} className={view.crate ? "crate-hotspot hotspot equipped" : "crate-hotspot hotspot"} @click={command("crate")} ariaLabel="Pick up the delivery box; then click a shelf to restock. Key Q."><Image loading="eager" src={asset("assets/objects/crate.svg")} alt="Delivery" width="100%" height="100%" showPlaceholder={false}  objectFit="contain" /><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="object-label">{view.crate ? "PICK A SHELF" : "DELIVERY · Q"}</Text></Button>
  <Button disabled={!view.running || view.overlay!=="" || view.dialogue || view.inspection || view.phase!=="shift"} className={view.mop ? "mop-hotspot hotspot equipped" : "mop-hotspot hotspot"} @click={command("mop")} ariaLabel="Take the mop. Key X."><Image loading="eager" src={asset("assets/objects/mop.svg")} alt="Mop" width="100%" height="100%" showPlaceholder={false}  objectFit="contain" /><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="object-label">{view.mop ? "WIPE THE SPILL" : "MOP · X"}</Text></Button>
  <Button disabled={!view.running || view.overlay!=="" || view.dialogue || view.inspection || view.phase!=="shift"} className={view.tillReady ? "till-hotspot hotspot ready" : "till-hotspot hotspot"} @click={command("till")} ariaLabel="Settle the sale at the till. Key E."><Image loading="eager" src={asset("assets/objects/till.svg")} alt="Till" width="100%" height="100%" showPlaceholder={false}  objectFit="contain" /><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="object-label">{view.tillReady ? "READY · E" : "TILL · E"}</Text></Button>
  <Button disabled={!view.running || view.overlay!=="" || view.dialogue || view.inspection || view.phase!=="shift"} if={view.hand && !view.bagged} className={view.turned ? "hand-hotspot hotspot turned" : "hand-hotspot hotspot"} @click={command("turn")} ariaLabel="Turn the package to find its barcode. Key R."><Image loading="eager" src={asset(view.handArt)} alt={view.handName} width="100%" height="100%" showPlaceholder={false}  objectFit="contain" /><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="object-label">{view.turned ? "BARCODE FOUND" : "TURN · R"}</Text></Button>
  <Button disabled={!view.running || view.overlay!=="" || view.dialogue || view.inspection || view.phase!=="shift"} className={view.scanned ? "scanner-hotspot hotspot scanned" : "scanner-hotspot hotspot"} @click={command("scan")} ariaLabel="Scan the item. Key S."><Image loading="eager" src={asset("assets/objects/scanner.svg")} alt="Scanner" width="100%" height="100%" showPlaceholder={false}  objectFit="contain" /><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="object-label">{view.scanned ? "BEEP. ✓" : "SCAN · S"}</Text></Button>
  <Button disabled={!view.running || view.overlay!=="" || view.dialogue || view.inspection || view.phase!=="shift"} className="bag-hotspot hotspot" @click={command("bag")} ariaLabel="Bag the scanned product. Key B."><Image loading="eager" src={asset(view.bagArt)} alt="Paper bag" width="100%" height="100%" showPlaceholder={false}  objectFit="contain" /><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="object-label">{view.bagged ? "BAGGED ✓" : "BAG · B"}</Text></Button>
  <Button disabled={!view.running || view.overlay!=="" || view.dialogue || view.inspection || view.phase!=="shift"} className={view.paymentReady ? "payment-hotspot hotspot ready" : "payment-hotspot hotspot"} @click={command("payment")} ariaLabel="Examine the customer's payment. Key P."><Image loading="eager" if={view.counter} src={asset(view.tokenArt)} alt={view.tokenName} width="100%" height="100%" showPlaceholder={false}  objectFit="contain" /><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="object-label">{view.paymentReady ? "CHECKED ✓" : "PAYMENT · P"}</Text></Button>
  <Button disabled={!view.running || view.overlay!=="" || view.dialogue || view.inspection || view.phase!=="shift"} className={view.job==="coffee" ? "coffee-hotspot hotspot brewing" : "coffee-hotspot hotspot"} @click={command("coffee")} ariaLabel="Brew a fresh pot of coffee. Key C."><Image loading="eager" src={asset("assets/objects/kettle.svg")} alt="Coffee kettle" width="100%" height="100%" showPlaceholder={false}  objectFit="contain" /><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="object-label">{view.job==="coffee" ? "BREWING…" : "COFFEE · C"}</Text></Button>
  <Button disabled={!view.running || view.overlay!=="" || view.dialogue || view.inspection || view.phase!=="shift"} className={view.job==="noodles" ? "noodles-hotspot hotspot brewing" : "noodles-hotspot hotspot"} @click={command("noodles")} ariaLabel="Prepare two warm noodle cups. Key N."><Image loading="eager" src={asset("assets/objects/hotplate.svg")} alt="Noodles hotplate" width="100%" height="100%" showPlaceholder={false}  objectFit="contain" /><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="object-label">{view.job==="noodles" ? "WARMING…" : "NOODLES · N"}</Text></Button>
  <Button disabled={!view.running || view.overlay!=="" || view.dialogue || view.inspection || view.phase!=="shift"} if={view.eventReady} className="event-hotspot hotspot" @click={command("event")} ariaLabel={view.eventName+". Key F."}><Image loading="eager" src={asset(view.eventArt)} alt={view.eventName} width="100%" height="100%" showPlaceholder={false}  objectFit="contain" /><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="event-label">{view.eventName}</Text></Button>
  <Box if={view.impossibleReceipt} className="impossible-receipt" />
  <Box if={view.stasis} className="time-note"><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}}>One minute, off duty.</Text></Box>
  <Box if={view.job!==""} className="brew-progress"><Box style={view.jobWidth} /></Box>
 </Box>
</Box>
