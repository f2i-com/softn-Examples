<Box className="counter-dock" if={view.phase==="shift" && view.overlay==="" && !view.dialogue && !view.inspection}>
 <Box className="counter-toolbar">
  <Box className="counter-summary"><Image className="dock-portrait" src={asset(view.customerArt)} alt="" width={32} height={40} showPlaceholder={false} objectFit="contain" /><Box><Text className="counter-eyebrow">{view.counter ? "AT YOUR COUNTER" : "LAST LIGHT · OPEN"}</Text><Text className="counter-customer">{view.counter ? view.customer : "A little shopkeeping"}</Text></Box></Box>
  <Button className="button primary next-action" disabled={view.nextDisabled} @click={command(view.nextCommand)}>{view.nextLabel}</Button>
 </Box>
 <Box className="counter-tabs">
  <Button className={view.panel === "shelves" ? "button counter-tab selected" : "button counter-tab"} ariaLabel="Toggle shelves" @click={toggleCounterPanel("shelves")}>Shelves</Button>
  <Button className={view.panel === "checkout" ? "button counter-tab selected" : "button counter-tab"} ariaLabel="Toggle checkout controls" @click={toggleCounterPanel("checkout")}>Checkout</Button>
  <Button className={view.panel === "shop" ? "button counter-tab selected" : "button counter-tab"} ariaLabel="Toggle shop tasks" @click={toggleCounterPanel("shop")}>Shop</Button>
 </Box>
 <Text className="counter-status">{view.notice !== "" ? view.notice : view.hint}</Text>
 <Box if={view.panel !== ""} className="counter-panel">
  <Box className="panel-heading"><Text>{view.panel === "shelves" ? "The usual things" : (view.panel === "checkout" ? "One little purchase" : "Keep the lights on")}</Text><Button className="button panel-close" ariaLabel="Close control panel" @click={toggleCounterPanel(view.panel)}>×</Button></Box>
  <Box if={view.panel === "shelves"} className="mobile-shelves">
   #each (product in shelvesView)
    <Button className={view.order === product.name ? "button mobile-product wanted" : "button mobile-product"} ariaLabel={product.label} @click={command("shelf:"+product.id)}><Image src={asset(product.art)} alt="" width={28} height={32} showPlaceholder={false} objectFit="contain" /><Box><Text className="product-title">{product.name}</Text><Text className="product-stock">{product.stock+" on shelf"}</Text></Box></Button>
   #end
  </Box>
  <Box if={view.panel === "checkout"} className="touch-counter">
   <Button className="button small" disabled={!view.hand} @click={command("turn")}>Turn</Button><Button className="button small" disabled={!view.hand} @click={command("scan")}>Scan</Button><Button className="button small" disabled={!view.scanned} @click={command("bag")}>Bag</Button><Button className="button small" disabled={!view.counter} @click={command("payment")}>Payment</Button><Button className="button small" disabled={!view.tillReady} @click={command("till")}>Till</Button><Button className="button small" disabled={!view.hand} @click={command("return")}>Return item</Button>
   <Button if={view.counter} className="button counter-talk" @click={command("person:"+view.customerId)}>Make a little conversation</Button>
  </Box>
  <Box if={view.panel === "shop"} className="mobile-chores">
   <Text className="receipt-copy">{view.routineDone ? "✓ "+view.routine : view.routine}</Text>
   <Button className="button" @click={command("door")}>{view.ready ? "Finish shift" : "Welcome visitor"}</Button>
   <Button className="button" @click={command("crate")}>{view.crate ? "Delivery held ✓" : "Pick up delivery"}</Button>
   <Button className="button" @click={command("coffee")}>{view.job === "coffee" ? "Brewing…" : "Brew coffee"}</Button>
   <Button className="button" @click={command("noodles")}>{view.job === "noodles" ? "Warming…" : "Warm noodles"}</Button>
   <Button className="button" @click={command("mop")}>{view.mop ? "Mop held ✓" : "Take mop"}</Button>
   <Button if={view.spill} className="button" @click={command("spill")}>Wipe spill</Button>
   <Button if={view.eventReady} className="button primary" @click={command("event")}>{view.eventName}</Button>
   <Button className="button" @click={command("radio")}>{view.radio ? "Radio off" : "Radio on"}</Button>
   <Button className="button" @click={command("window")}>Look outside</Button>
  </Box>
 </Box>
</Box>
