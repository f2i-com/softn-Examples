<Box if={view.dialogue && view.overlay===""} className="dialogue-dock" role="dialog" ariaLabel={view.dialogueName}>
 <Image loading="eager" className="dialogue-portrait" src={asset(view.dialogueArt)} alt="" width={110} height={150} showPlaceholder={false}  objectFit="contain" />
 <Box className="dialogue-content"><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="eyebrow">{view.dialogueResolved ? "A LITTLE THING, REMEMBERED" : "THERE IS TIME TO LISTEN"}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="customer-title">{view.dialogueName}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="dialogue-line">{view.dialogueLine}</Text>
  <Box className="choices" if={!view.dialogueResolved}>#each (choice in choicesView)
   <Button className="button choice" @click={chooseDialogue(choice.id)}>{choice.text}</Button>
  #end</Box>
  <Button className={view.dialogueResolved ? "button primary" : "text-button"} @click={closeDialogue}>{view.dialogueResolved ? "Back to the little things" : "Let me finish something first"}</Button>
 </Box>
</Box>
<Box if={view.inspection && view.overlay===""} className="payment-dock" role="dialog" ariaLabel="Inspect the physical payment">
 <Button className={view.tokenInspected ? "token-display inspected" : "token-display"} @click={examinePayment} ariaLabel={view.tokenAction}><Image loading="eager" src={asset(view.tokenArt)} alt={view.tokenName} width={140} height={160} showPlaceholder={false}  objectFit="contain" /></Button>
 <Box className="payment-content"><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="eyebrow">ON THE BRASS TRAY</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="customer-title">{view.tokenName}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="dialogue-line">{view.tokenText}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="payment-effect" if={view.tokenInspected}>{"If accepted: "+view.tokenEffect}</Text>
  <Box className="choices"><Button if={!view.tokenInspected} className="button primary" @click={examinePayment}>{view.tokenAction}</Button><Button if={view.tokenInspected} className="button primary" @click={decidePayment("accept")}>The till can make room for this</Button><Button className="button" @click={decidePayment("gift")}>Slide it back. This one's on me.</Button><Button className="text-button" @click={closePayment}>Leave it on the tray for now</Button></Box>
 </Box>
</Box>
