<logic src="../logic/main.logic" />
<import World from="./world.ui" />
<import Counter from="./counter.ui" />
<import Dialogue from="./dialogue.ui" />
<import Screens from="./screens.ui" />
<style>
/* Bespoke shop presentation. Layout is scoped to this bundle, not the host theme. */
.lastlight{--cream:#eee1bd;--muted:#a9b6a3;--gold:#e6bd79;--ink:#203d37;--color-text:#eee1bd;--text-base:14px;color:var(--cream)!important;background:#132824;min-height:100%;width:100%;font-family:Georgia,'Times New Roman',serif;line-height:1.55;box-sizing:border-box;overflow-wrap:break-word;padding:0 0 24px;container-type:inline-size;container-name:store}
.lastlight *,.lastlight *::before,.lastlight *::after{box-sizing:border-box}.lastlight button{font-family:Arial,sans-serif}.lastlight button:focus-visible{outline:3px solid #fae5a6!important;outline-offset:4px;z-index:20}.lastlight button:disabled{cursor:default;opacity:1}.lastlight img{user-select:none;-webkit-user-drag:none}.lastlight .button{display:inline-flex!important;align-items:center;justify-content:center;min-height:44px;padding:11px 18px!important;border:1px solid #9da68180!important;border-radius:6px!important;color:var(--cream)!important;background:#29463b!important;font-size:13px!important;line-height:1.45!important;font-weight:600!important;white-space:normal!important;height:auto!important;cursor:pointer;box-shadow:none!important;transition:background .15s,transform .15s}
.lastlight .button:hover{background:#3b5947!important}.lastlight .button:active{transform:translateY(1px)}.lastlight .button.primary{background:var(--gold)!important;border-color:var(--gold)!important;color:#293d31!important}.lastlight .button.primary:hover{background:#f5cf8a!important}.lastlight .text-button{display:inline-flex!important;padding:7px 0!important;min-height:40px;height:auto!important;border:0!important;border-radius:0!important;background:transparent!important;color:#dfc998!important;font-size:12px!important;white-space:normal;line-height:1.5!important;text-decoration:underline;text-underline-offset:4px;box-shadow:none!important;cursor:pointer;text-align:left}
.lastlight .shell{max-width:1240px;margin:0 auto;padding:0 24px}.lastlight .masthead{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:24px 0 20px}.lastlight .brand{display:flex;gap:12px;align-items:center}.lastlight .brand-icon{width:37px;height:43px}.lastlight .eyebrow{display:block;font:700 9px/1.5 Arial,sans-serif!important;letter-spacing:2px;color:var(--muted)!important}.lastlight .brand-title{display:block;font:500 17px/1.4 Georgia,serif!important;color:var(--cream)!important;max-width:440px}.lastlight .tools{display:flex;gap:16px;align-items:center}.lastlight .night-bar{display:flex;justify-content:space-between;gap:12px;align-items:center;border-top:1px solid #acb39130;padding:14px 0;color:#c1cbb4;font:12px/1.5 Arial,sans-serif!important}.lastlight .night-title{display:block;font-size:12px!important;letter-spacing:.2px}.lastlight .clock{font-size:11px!important;letter-spacing:1px;color:#d6c195!important;font-variant-numeric:tabular-nums}.lastlight .stage-wrap{position:relative}.lastlight .scene-scroll{overflow-x:auto;overflow-y:hidden;border-radius:10px 10px 0 0!important;box-shadow:0 22px 70px #0003!important;scrollbar-color:#9b9672 #203a35;scrollbar-width:thin}.lastlight .scene{position:relative;aspect-ratio:1200/760;width:100%;min-width:760px;isolation:isolate;overflow:hidden;background:#182936}.lastlight .scene-layer{position:absolute!important;inset:0;width:100%!important;height:100%!important;pointer-events:none}.lastlight .sky-layer{z-index:0}.lastlight .room-layer{z-index:2}.lastlight .counter-layer{z-index:8}.lastlight .star{position:absolute;width:2px;height:2px;background:#f7edc8;border-radius:50%!important;z-index:1;box-shadow:0 0 4px #f5e9ca66!important}.lastlight .twinkle{animation:twinkle 7s ease-in-out infinite}.lastlight .hotspot,.lastlight .shelf-hotspot,.lastlight .person,.lastlight .token-display{position:absolute!important;display:block!important;min-width:0!important;min-height:44px;padding:0!important;margin:0!important;border:0!important;background:transparent!important;border-radius:5px!important;box-shadow:none!important;height:auto;line-height:1!important;white-space:normal;cursor:pointer;touch-action:manipulation;color:var(--cream)!important}.lastlight .hotspot img,.lastlight .shelf-hotspot img,.lastlight .person img{object-fit:contain;width:100%;height:100%;pointer-events:none}.lastlight .hotspot:hover,.lastlight .shelf-hotspot:hover{filter:drop-shadow(0 0 7px #f6d48999)}.lastlight .hotspot.equipped{filter:drop-shadow(0 0 6px #ffdfa3)}.lastlight .window-hotspot{left:21.5%;top:12%;width:52%;height:22%;z-index:3}.lastlight .window-note{display:none;color:#f2e4c4!important;background:#20362ded;padding:10px 14px;border:1px solid #b9bca944;border-radius:6px!important;position:absolute;left:12%;right:12%;top:15%;font:12px/1.6 Georgia,serif!important}.lastlight .window-hotspot:hover .window-note,.lastlight .window-hotspot:focus-visible .window-note{display:block}.lastlight .door-sign{left:88%;top:29%;width:8%;height:5.6%;min-height:36px;z-index:4;background:#264639!important;border:2px solid #caba8b!important;color:#e6dca5!important;font:700 10px/1.3 Arial,sans-serif!important;letter-spacing:1px;transform:rotate(-3deg)}.lastlight .door-sign.ready{background:#d5b06e!important;color:#253e31!important;animation:lamplight 4s ease-in-out infinite}.lastlight .radio-hotspot{left:17.8%;top:37%;width:5%;height:9%;z-index:5}.lastlight .keepsake{width:3.3%;height:6%;min-height:30px;z-index:5;transform:translateY(-90%)}.lastlight .little-light{position:absolute;left:31.2%;top:22%;width:8px;height:8px;border-radius:50%!important;background:#fff2b1;box-shadow:0 0 22px 16px #ffd89c44!important;z-index:3;pointer-events:none;animation:lamplight 5s ease-in-out infinite}.lastlight .table-art{position:absolute!important;left:16%;top:48%;width:18%!important;height:20%!important;z-index:5;pointer-events:none}.lastlight .shelf-hotspot{width:6.7%;height:12%;transform:translate(-50%,-50%);z-index:5;transition:filter .15s}.lastlight .shelf-hotspot.wanted{filter:drop-shadow(0 0 6px #f2d19090)}.lastlight .shelf-hotspot.empty img{opacity:.26}.lastlight .shelf-label{position:absolute;left:50%;bottom:-12px;transform:translateX(-50%);color:#273e33!important;background:#e8d1a8;padding:4px 5px;border-radius:2px!important;white-space:nowrap;font:700 8px/1.2 Arial,sans-serif!important;box-shadow:0 1px 2px #142b3633!important}.lastlight .stock-tooltip{display:none;position:absolute;left:50%;top:-30px;transform:translateX(-50%);white-space:nowrap;color:var(--cream)!important;background:#233f35;padding:7px 9px;font:11px/1.2 Arial,sans-serif!important;border-radius:4px!important}.lastlight .shelf-hotspot:hover .stock-tooltip,.lastlight .shelf-hotspot:focus-visible .stock-tooltip{display:block}.lastlight .person{width:11.5%;height:27%!important;transform:translate(-50%,-100%);transition:left .10s linear,top .10s linear;z-index:6}.lastlight .character-art{filter:drop-shadow(0 4px 1px #112b3330)}.lastlight .person.idle .character-art{animation:breathe 4s ease-in-out infinite;transform-origin:50% 95%}.lastlight .person.walking .character-art{animation:waddle .46s ease-in-out infinite;transform-origin:50% 90%}.lastlight .person.seated{height:23%!important}.lastlight .person:nth-child(2n){animation-delay:-1s}.lastlight .person:hover .character-art{filter:drop-shadow(0 0 4px #dfcd8d77)}.lastlight .speech-bubble{position:absolute;bottom:98%;left:50%;transform:translateX(-50%);padding:9px 12px;background:#f3e7c6;color:#354938!important;border:1px solid #baa582;border-radius:13px 13px 13px 2px!important;font:12px/1.2 Georgia,serif!important;white-space:nowrap;box-shadow:0 4px 10px #1a2f3233!important}.lastlight .person-name{position:absolute;bottom:-8px;left:50%;transform:translateX(-50%);white-space:nowrap;color:#e9e0c1!important;background:#1f3e35d9;border-radius:5px!important;padding:4px 7px;font:10px/1.3 Arial,sans-serif!important}.lastlight .carried-bag{position:absolute!important;right:-2%;bottom:10%;width:36%!important;height:40%!important}.lastlight .spill{left:17%;top:62%;width:11%;height:5%;min-height:30px;border-radius:50%!important;transform:rotate(-10deg);background:#a9d8cf!important;border:2px solid #cfe5d2aa!important;z-index:5}.lastlight .spill .object-label{transform:translateX(-50%) rotate(10deg)}
.lastlight .crate-hotspot{left:3%;top:76%;width:9%;height:17%;z-index:10}.lastlight .mop-hotspot{left:1.5%;top:55%;width:7%;height:20%;z-index:9}.lastlight .till-hotspot{left:17%;top:68%;width:12%;height:20%;z-index:10}.lastlight .hand-hotspot{left:33%;top:72%;width:7%;height:13%;z-index:10;transition:transform .3s}.lastlight .hand-hotspot.turned{transform:rotate(8deg)}.lastlight .scanner-hotspot{left:44%;top:76%;width:10%;height:14%;z-index:10}.lastlight .bag-hotspot{left:57%;top:70%;width:10%;height:19%;z-index:10}.lastlight .payment-hotspot{left:70%;top:73%;width:7%;height:12%;z-index:10}.lastlight .coffee-hotspot{left:82%;top:69%;width:8%;height:17%;z-index:10}.lastlight .noodles-hotspot{left:91%;top:74%;width:8%;height:15%;z-index:10}.lastlight .object-label{position:absolute;left:50%;bottom:-9px;transform:translateX(-50%);display:block!important;color:#ece0b9!important;font:700 9px/1.3 Arial,sans-serif!important;letter-spacing:.6px;white-space:nowrap;padding:4px 6px;border-radius:3px!important;background:#2c493eef;pointer-events:none}.lastlight .ready{filter:drop-shadow(0 0 6px #ffda7899)}.lastlight .scanned:after{content:'';position:absolute;left:23%;top:47%;width:56%;height:3px;background:#f0c598;box-shadow:0 0 7px #ffd990!important;transform:rotate(1deg)}.lastlight .event-hotspot{left:76.5%;top:18%;width:7%;height:13%;z-index:6;filter:drop-shadow(0 0 10px #edd099);animation:float-object 5s ease-in-out infinite}.lastlight .event-label{position:absolute;left:50%;top:100%;transform:translateX(-50%);font:12px/1.4 Georgia,serif!important;white-space:nowrap;background:#2a3b32f2;border:1px solid #d1b180;color:#eedbab!important;padding:7px 11px;border-radius:4px!important}.lastlight .brew-progress{position:absolute;left:83%;top:92%;width:12%;height:4px;background:#274d3e;z-index:11;border-radius:2px!important;overflow:hidden}.lastlight .brew-progress>div{height:100%;background:var(--gold)}.lastlight .brewing:after{content:'∿';position:absolute;left:44%;top:-15px;color:#ede9c5;font:32px/1 Georgia,serif;animation:steam 2s ease-out infinite}.lastlight .unmoored .keepsake{animation:float-object 7s ease-in-out infinite}.lastlight .rain-echo{position:absolute;left:22%;top:12%;width:52%;height:22%;z-index:1;background:repeating-linear-gradient(109deg,transparent 0 17px,#c9e4cd33 18px 19px,transparent 20px 34px);animation:rainfall 2s linear infinite;box-shadow:inset 0 0 80px #bab77950!important}.lastlight .time-note{position:absolute;left:46%;top:21%;font:italic 12px/1.5 Georgia,serif!important;color:#efe4c3!important;z-index:3}.lastlight .held-time .twinkle{animation-play-state:paused}
.lastlight .counter-dock{display:grid;grid-template-columns:255px 1fr 225px;gap:22px;align-items:start;padding:22px 20px 18px;background:#233f35;border:1px solid #b1b59825;border-top:2px solid #998260;border-radius:0 0 10px 10px!important;position:relative}.lastlight .current-customer{display:flex;align-items:center;gap:14px}.lastlight .dock-portrait{width:58px!important;height:88px!important;object-fit:contain;flex-shrink:0}.lastlight .customer-title{display:block;font:600 20px/1.25 Georgia,serif!important;color:#f1e4c1!important;margin:5px 0 8px}.lastlight .guidance{display:block;font:15px/1.6 Georgia,serif!important;color:#f0e1b9!important}.lastlight .notice{display:block;font:12px/1.6 Arial,sans-serif!important;color:#b8c5ad!important;margin-top:8px}.lastlight .caption{display:block;font:italic 11px/1.5 Georgia,serif!important;color:#c7cdb8!important;margin-top:10px}.lastlight .receipt-note{border-left:1px dashed #b6b48b55;padding-left:18px}.lastlight .receipt-copy{display:block;font:12px/1.6 Georgia,serif!important;color:#d8d4b7!important;margin-top:8px}.lastlight .receipt-note .button{margin-top:10px;width:100%;padding:9px!important;font-size:11px!important}.lastlight .touch-counter{grid-column:1/-1;display:flex;justify-content:center;gap:7px;flex-wrap:wrap;border-top:1px solid #afbd9420;padding-top:12px}.lastlight .small{min-height:40px!important;font-size:11px!important;padding:7px 14px!important}.lastlight .dialogue-dock,.lastlight .payment-dock{position:relative;display:flex;gap:28px;padding:28px 34px;background:#263f35;border:1px solid #aab29155;border-top:3px solid #d4b171;border-radius:0 0 12px 12px!important;min-height:240px;scroll-margin-top:20px}.lastlight .dialogue-portrait{flex:0 0 110px;width:110px!important;height:165px!important;object-fit:contain;align-self:center}.lastlight .dialogue-content,.lastlight .payment-content{flex:1;min-width:0}.lastlight .dialogue-line{display:block;font:17px/1.75 Georgia,serif!important;color:#eee1bd!important;margin:9px 0 18px}.lastlight .choices{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:16px}.lastlight .choice{flex:1 1 250px;text-align:left;justify-content:flex-start!important}.lastlight .dialogue-content>.text-button{margin-top:8px}.lastlight .token-display{position:relative!important;flex:0 0 150px;width:150px;height:180px!important;align-self:center;background:radial-gradient(ellipse,#c7a26c33 0,transparent 68%)!important;transition:transform .4s}.lastlight .token-display.inspected{transform:rotate(-12deg);filter:drop-shadow(0 0 10px #d4c18355)}.lastlight .payment-effect{display:block;font:12px/1.6 Arial,sans-serif!important;color:#ccd2b6!important;border-left:2px solid #d9ba7d;padding-left:12px}.lastlight .welcome-card{position:absolute;left:4%;top:10%;max-width:470px;background:#18382fec;border:1px solid #c3b58177;border-radius:10px!important;padding:32px 34px;box-shadow:0 20px 60px #07161566!important;z-index:30;backdrop-filter:blur(9px)}.lastlight .welcome-title{display:block;font:500 42px/1.13 Georgia,serif!important;color:#f0e3be!important;letter-spacing:-1px;margin:15px 0 7px}.lastlight .welcome-subtitle{display:block;font:italic 20px/1.5 Georgia,serif!important;color:#d6c694!important;margin-bottom:20px}.lastlight .body-copy{display:block;font:14px/1.75 Georgia,serif!important;color:#d8dcc4!important;margin:8px 0}.lastlight .small-copy{display:block;font:12px/1.75 Arial,sans-serif!important;color:#b5c4aa!important;margin:12px 0 0}.lastlight .warning{display:block;font:12px/1.6 Arial,sans-serif!important;color:#f4b8a0!important;margin-top:12px}.lastlight .sheet{position:relative;background:#203f34;border:1px solid #acb08866;border-radius:10px!important;z-index:31;padding:30px 38px;margin-top:-26%;box-shadow:0 20px 70px #06191480!important}.lastlight .sheet-head{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:20px}.lastlight .sheet-title{display:block;font:500 31px/1.3 Georgia,serif!important;color:#f0e3bf!important;margin:9px 0}.lastlight .section-heading{display:block;font:600 19px/1.5 Georgia,serif!important;color:#eddfb9!important;margin:26px 0 10px}.lastlight .setting-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.lastlight .confirm-box{border:1px solid #bda577;background:#1a322d;padding:20px;margin:20px 0;border-radius:6px!important}.lastlight .confirm-box .button{margin:10px 10px 0 0}.lastlight .save-code{display:block;white-space:pre-wrap;word-break:break-all;max-height:260px;overflow:auto;font:11px/1.5 monospace!important;user-select:text;padding:16px;background:#132922;margin-top:18px}.lastlight .journal-list{max-height:530px;overflow-y:auto;margin-top:20px;padding-right:20px}.lastlight .journal-entry{padding:15px 0;border-top:1px solid #afbc9530}.lastlight .night-receipt{position:relative;max-width:600px;margin:-23% auto 0;background:#e8dabe;z-index:25;padding:40px 50px;border-radius:4px!important;box-shadow:0 25px 60px #071f2680!important;border-top:8px dotted #c8b68f;color:#304638!important}.lastlight .night-receipt .sheet-title,.lastlight .night-receipt .dialogue-line{color:#304638!important}.lastlight .night-receipt .small-copy,.lastlight .night-receipt .eyebrow{color:#677760!important}.lastlight .night-receipt .button{margin-top:25px}.lastlight .receipt-thanks{display:block;margin-top:30px;padding-top:20px;border-top:1px dashed #7d987477;font:10px/1.6 Arial,sans-serif!important;letter-spacing:2px;text-align:center;color:#aebca1!important}.lastlight .night-receipt .receipt-thanks{color:#5f745b!important}.lastlight .ending-sheet{position:relative;margin:-15% auto 0;max-width:960px;z-index:25;background:#1c392ff2;padding:38px 44px;border:1px solid #b2af8155;border-radius:10px!important;box-shadow:0 20px 70px #081c2877!important}.lastlight .ending-choices{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:22px 0}.lastlight .ending-choice{display:block!important;text-align:left!important;padding:18px 20px!important}.lastlight .ending-choice .customer-title{font-size:18px!important}.lastlight .ending-choice .body-copy{font-size:13px!important}.lastlight .ending-title{display:block;font:42px/1.2 Georgia,serif!important;color:#f0e1b7!important;margin:14px 0 20px}.lastlight .epilogues{display:grid;grid-template-columns:1fr 1fr;gap:24px;border-top:1px solid #c0be8930;padding-top:28px;margin-top:26px}.lastlight .epilogue{display:flex;align-items:flex-start;gap:15px}.lastlight .epilogue img{flex:0 0 68px;object-fit:contain}.lastlight .epilogue .customer-title{font-size:18px!important}.lastlight .epilogue .body-copy{font-size:13px!important}.lastlight .footnote{display:flex;justify-content:space-between;gap:15px;padding:20px 0 0;font:10px/1.6 Arial,sans-serif!important;color:#849c88!important}.lastlight .footnote span{font-size:10px!important}
@keyframes breathe{0%,100%{transform:scaleY(1)}50%{transform:scaleY(1.015)}}@keyframes waddle{0%,100%{transform:rotate(-2deg) translateY(0)}50%{transform:rotate(2deg) translateY(-2px)}}@keyframes twinkle{0%,100%{filter:brightness(.7)}50%{filter:brightness(1.5)}}@keyframes lamplight{0%,100%{opacity:.82}50%{opacity:1}}@keyframes float-object{0%,100%{translate:0 0}50%{translate:0 -7px}}@keyframes steam{0%{opacity:0;transform:translateY(8px)}50%{opacity:.7}100%{opacity:0;transform:translateY(-14px)}}@keyframes rainfall{to{background-position:34px 74px}}
.lastlight.still *{animation:none!important;transition:none!important;scroll-behavior:auto!important}@media(prefers-reduced-motion:reduce){.lastlight *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
@container store (max-width:1050px){.lastlight .counter-dock{grid-template-columns:230px 1fr}.lastlight .receipt-note{grid-column:1/-1;border-left:0;border-top:1px dashed #b6b48b44;padding:12px 0 0}.lastlight .receipt-copy{display:inline;margin-left:10px}.lastlight .welcome-card{top:6%;padding:24px 28px;max-width:440px}.lastlight .welcome-title{font-size:36px!important}.lastlight .welcome-card .body-copy{font-size:13px!important}.lastlight .welcome-card .welcome-subtitle{margin-bottom:12px}.lastlight .welcome-card .small-copy{font-size:11px!important}.lastlight .setting-grid{grid-template-columns:1fr 1fr}}
@container store (max-width:700px){.lastlight .shell{padding:0 12px}.lastlight .masthead{padding:16px 0 12px;gap:8px;align-items:flex-start}.lastlight .brand-icon{display:none}.lastlight .brand-title{font-size:14px!important;max-width:245px}.lastlight .brand .eyebrow{font-size:8px!important;letter-spacing:1.4px}.lastlight .tools{gap:10px;flex-direction:column;align-items:flex-end}.lastlight .tools .text-button{font-size:11px!important;padding:0!important;min-height:25px}.lastlight .night-bar{font-size:10px!important;padding:10px 0}.lastlight .night-title{font-size:11px!important}.lastlight .clock{font-size:9px!important;white-space:nowrap}.lastlight .counter-dock{grid-template-columns:1fr;gap:14px;padding:17px}.lastlight .current-customer{gap:12px}.lastlight .dock-portrait{width:47px!important;height:66px!important}.lastlight .customer-title{font-size:20px!important}.lastlight .receipt-note{grid-column:auto}.lastlight .receipt-copy{display:block;margin:6px 0 0}.lastlight .welcome-card{position:relative;left:auto;top:auto;max-width:none;margin:-110px 10px 0;padding:25px}.lastlight .welcome-title{font-size:35px!important}.lastlight .welcome-card .body-copy{font-size:14px!important}.lastlight .welcome-card .small-copy{font-size:12px!important}.lastlight .dialogue-dock,.lastlight .payment-dock{gap:15px;padding:20px 18px;flex-wrap:wrap}.lastlight .dialogue-portrait{width:58px!important;height:84px!important;flex:0 0 58px;align-self:flex-start}.lastlight .dialogue-content{flex-basis:230px}.lastlight .dialogue-line{font-size:16px!important}.lastlight .token-display{width:100px!important;height:130px!important;flex-basis:100px}.lastlight .payment-content{flex-basis:220px}.lastlight .sheet{margin-top:-160px;padding:22px}.lastlight .sheet-head{flex-wrap:wrap}.lastlight .sheet-title{font-size:28px!important}.lastlight .setting-grid{grid-template-columns:1fr 1fr}.lastlight .setting-grid .button{font-size:12px!important;padding:10px!important}.lastlight .night-receipt{margin:-100px 8px 0;padding:28px}.lastlight .ending-sheet{margin:-70px 0 0;padding:25px}.lastlight .ending-choices,.lastlight .epilogues{grid-template-columns:1fr}.lastlight .ending-title{font-size:34px!important}.lastlight .epilogue .body-copy{font-size:14px!important}.lastlight .footnote{flex-direction:column;gap:6px}.lastlight .choices{align-items:stretch}.lastlight .choices>.button{flex-grow:1}.lastlight .small{min-height:44px!important}}

/* Softn Button sets inline height/transform; geometry must explicitly win.
   CSS variables retain a single source for both native and reference players. */
.lastlight .scene button{height:var(--hotspot-height,auto)!important;transform:var(--hotspot-transform,none)!important;opacity:1!important;transition:left .1s linear,top .1s linear,filter .15s!important}
.lastlight .window-hotspot{--hotspot-height:22%}.lastlight .door-sign{--hotspot-height:5.6%;--hotspot-transform:rotate(-3deg)}.lastlight .radio-hotspot{--hotspot-height:9%}.lastlight .keepsake{--hotspot-height:6%;--hotspot-transform:translateY(-90%)}.lastlight .shelf-hotspot{--hotspot-height:12%;--hotspot-transform:translate(-50%,-50%)}.lastlight .person{--hotspot-height:27%;--hotspot-transform:translate(-50%,-100%)}.lastlight .person.seated{--hotspot-height:23%}.lastlight .spill{--hotspot-height:5%;--hotspot-transform:rotate(-10deg)}.lastlight .crate-hotspot{--hotspot-height:17%}.lastlight .mop-hotspot{--hotspot-height:20%}.lastlight .till-hotspot{--hotspot-height:20%}.lastlight .hand-hotspot{--hotspot-height:13%}.lastlight .hand-hotspot.turned{--hotspot-transform:rotate(8deg)}.lastlight .scanner-hotspot{--hotspot-height:14%}.lastlight .bag-hotspot{--hotspot-height:19%}.lastlight .payment-hotspot{--hotspot-height:12%}.lastlight .coffee-hotspot{--hotspot-height:17%}.lastlight .noodles-hotspot{--hotspot-height:15%}.lastlight .event-hotspot{--hotspot-height:13%}.lastlight .token-display{transform:none!important}.lastlight .token-display.inspected{transform:rotate(-12deg)!important}.lastlight .text-button{white-space:normal!important;text-decoration:underline!important}.lastlight .hotspot img,.lastlight .person img,.lastlight .shelf-hotspot img{object-fit:contain!important}.lastlight .impossible-receipt{position:absolute;left:31%;top:81%;width:7%;height:7%;z-index:9;background:repeating-linear-gradient(0deg,#e5d9b7 0 7px,#8c9d8855 8px 9px,#e5d9b7 10px 13px);border-radius:50% 10% 40% 10%!important;transform:rotate(-8deg);box-shadow:0 3px 5px #112c3255!important;pointer-events:none}
.lastlight.still .scene button{transition:none!important}@media(prefers-reduced-motion:reduce){.lastlight .scene button{transition:none!important}}
.lastlight .pan-hint{display:none;font:11px/1.5 Arial,sans-serif!important;color:#b9c7ab!important;padding:8px 12px;background:#203d35}@container store (max-width:700px){.lastlight .pan-hint{display:block}.lastlight .epilogue>div:first-child{flex:0 0 68px}}






/* MOBILE EDITION START */
/* Last Light 0.2.2: one screen, with a compact counter floating over the shop. */
.lastlight {height:100%;min-height:0!important;overflow:hidden;padding:0 max(8px,env(safe-area-inset-right)) max(8px,env(safe-area-inset-bottom)) max(8px,env(safe-area-inset-left));}
.lastlight .shell {height:100%;max-width:1440px;padding:0;display:flex;flex-direction:column;min-height:0;}
.lastlight .masthead {flex:none;padding:10px 8px;gap:12px;}
.lastlight .brand-title {font-size:17px!important;}
.lastlight .tools {gap:16px;flex-direction:row;}
.lastlight .text-button {min-height:44px!important;}
.lastlight .night-bar {flex:none;padding:6px 8px;gap:6px;}
.lastlight .clock {font-size:10px!important;}
.lastlight .footnote,.lastlight .pan-hint {display:none!important;}
.lastlight .stage-wrap {flex:1;min-height:0;position:relative;overflow:hidden;border:1px solid #9fae7f50;border-radius:12px;background:#142f29;isolation:isolate;}
.lastlight .scene-scroll {position:absolute;inset:0;overflow:hidden;container-type:size;border-radius:0;}
.lastlight .scene {position:absolute;top:0;left:50%;transform:translateX(-50%);width:max(100cqw,calc(100cqh * 1.578947));height:100cqh;min-width:0;aspect-ratio:auto;}
.lastlight .counter-dock {position:absolute;top:12px;left:12px;width:min(480px,calc(100% - 24px));max-height:calc(100% - 24px);z-index:30;display:flex!important;flex-direction:column;gap:0;padding:12px!important;background:#17382ff5;border:1px solid #c4c39370;border-radius:12px;box-shadow:0 8px 30px #071a2370;backdrop-filter:blur(12px);overflow:hidden;}
.lastlight .counter-toolbar {display:flex;align-items:center;gap:10px;flex:none;}
.lastlight .counter-summary {display:flex;align-items:center;gap:9px;min-width:0;flex:1;}
.lastlight .dock-portrait {width:32px!important;height:40px!important;flex:none;}
.lastlight .counter-eyebrow {display:block!important;font:700 9px/1.4 Arial,sans-serif!important;letter-spacing:1.4px;color:#b7c8a6!important;}
.lastlight .counter-customer {display:block!important;font:17px/1.25 Georgia,serif!important;color:#f3e9cc!important;}
.lastlight .next-action {min-width:128px;max-width:52%;padding:10px 14px!important;font-size:13px!important;flex-shrink:0;}
.lastlight .counter-tabs {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin-top:10px;flex:none;}
.lastlight .counter-tab {min-width:0;min-height:44px!important;padding:7px 8px!important;background:#284a3e!important;border-color:#9eae7b55!important;font-size:12px!important;}
.lastlight .counter-tab.selected {background:#e4c88d!important;color:#233f32!important;border-color:#e4c88d!important;}
.lastlight .counter-status {display:block!important;font:12px/1.45 Arial,sans-serif!important;color:#d3ddbe!important;margin:9px 0 0!important;flex:none;max-height:3em;overflow:auto;}
.lastlight .counter-panel {min-height:0;flex:1 1 auto;overflow-y:auto;overscroll-behavior:contain;margin-top:10px;padding-top:8px;border-top:1px solid #a9bd8d55;scrollbar-color:#9bac81 #17382f;}
.lastlight .panel-heading {display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px;}
.lastlight .panel-heading>span {font:italic 17px/1.3 Georgia,serif!important;color:#eddfb6!important;}
.lastlight .panel-close {width:44px;min-height:44px!important;padding:0!important;font-size:24px!important;}
.lastlight .mobile-shelves {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;}
.lastlight .mobile-product {display:flex!important;align-items:center;gap:7px;min-width:0;min-height:62px;padding:8px 6px!important;text-align:left;font-size:12px!important;}
.lastlight .mobile-product img {width:28px!important;height:32px!important;object-fit:contain!important;}
.lastlight .mobile-product.wanted {border:2px solid #f5d294!important;background:#465d3e!important;}
.lastlight .product-title {display:block!important;font:600 12px/1.2 Arial,sans-serif!important;color:#f1e6c8!important;}
.lastlight .product-stock {display:block!important;font:10px/1.4 Arial,sans-serif!important;color:#bed0ab!important;margin-top:3px;}
.lastlight .mobile-chores,.lastlight .touch-counter {display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;}
.lastlight .mobile-chores .button,.lastlight .touch-counter .button {min-height:44px!important;padding:8px 6px!important;font-size:12px!important;}
.lastlight .mobile-chores .receipt-copy,.lastlight .counter-talk {grid-column:1/-1;}
.lastlight .mobile-chores .receipt-copy {font:12px/1.4 Arial,sans-serif!important;padding:0 0 6px;margin:0;}
.lastlight .button:disabled {opacity:.45!important;}
.lastlight .welcome-card,.lastlight .sheet,.lastlight .dialogue-dock,.lastlight .payment-dock,.lastlight .night-receipt,.lastlight .ending-sheet {position:absolute;top:12px;left:12px;right:12px;bottom:auto;width:auto;max-width:680px;max-height:calc(100% - 24px);margin:0!important;transform:none;padding:22px!important;z-index:40;overflow:auto;overscroll-behavior:contain;box-shadow:0 12px 35px #071a2370;}
.lastlight .dialogue-dock,.lastlight .payment-dock {background:#183b32f7;border:1px solid #b7bd8b80;border-radius:12px;flex-wrap:wrap;}
.lastlight .dialogue-content,.lastlight .payment-content {min-width:0;flex:1 1 220px;}
.lastlight .dialogue-line {font-size:16px!important;}
.lastlight .sheet-head {flex-wrap:wrap;gap:10px;}
.lastlight .setting-grid {grid-template-columns:repeat(2,minmax(0,1fr));}
@media(max-width:760px) {
 .lastlight .masthead {padding:6px 2px;flex-wrap:nowrap;align-items:center;gap:8px;}
 .lastlight .brand-icon,.lastlight .brand .eyebrow,.lastlight .clock {display:none!important;}
 .lastlight .brand {min-width:0;flex:1;}
 .lastlight .brand-title {font-size:12px!important;line-height:1.25!important;}
 .lastlight .tools {width:auto;gap:6px;flex-shrink:0;}
 .lastlight .tools .text-button {font-size:11px!important;min-height:36px!important;padding:6px 9px!important;border:1px solid #9eae7b55!important;border-radius:6px!important;background:#203f35!important;text-decoration:none!important;max-width:none;white-space:nowrap!important;text-align:center;line-height:1.2!important;}
 .lastlight .night-bar {padding:4px 3px 6px;}
 .lastlight .night-title {font-size:10px!important;}
 .lastlight .stage-wrap {display:flex;flex-direction:column;}
 .lastlight .scene-scroll {position:relative;inset:auto;flex:none;width:100%;aspect-ratio:1200/760;height:auto;container-type:inline-size;}
 .lastlight .scene {position:relative;top:auto;left:0;transform:none;width:100%;height:100%;min-width:0;aspect-ratio:1200/760;}
 .lastlight .scene .hotspot,.lastlight .scene .shelf-hotspot,.lastlight .scene .person {min-width:34px!important;min-height:34px!important;}
 .lastlight .counter-dock {position:relative;top:auto;left:auto;width:100%;max-height:none;flex:1;min-height:0;padding:10px!important;border-radius:0;border-left:0;border-right:0;border-bottom:0;justify-content:flex-start;}
 .lastlight .counter-customer {font-size:15px!important;}
 .lastlight .counter-eyebrow {font-size:8px!important;letter-spacing:.8px;}
 .lastlight .next-action {min-width:112px;padding:8px!important;font-size:12px!important;}
 .lastlight .dock-portrait {width:26px!important;height:34px!important;}
 .lastlight .counter-summary {gap:6px;}
 .lastlight .counter-status {font-size:11px!important;}
 .lastlight .mobile-product {flex-direction:column;gap:4px;align-items:center;text-align:center;}
 .lastlight .welcome-card,.lastlight .sheet,.lastlight .dialogue-dock,.lastlight .payment-dock,.lastlight .night-receipt,.lastlight .ending-sheet {top:8px;left:8px;right:8px;max-height:calc(100% - 16px);padding:18px!important;}
 .lastlight .welcome-title {font-size:32px!important;}
 .lastlight .welcome-card .body-copy {font-size:13px!important;}
 .lastlight .welcome-card .small-copy {font-size:11px!important;}
 .lastlight .sheet-title {font-size:25px!important;}
 .lastlight .setting-grid {grid-template-columns:1fr;}
 .lastlight .scene .object-label,.lastlight .scene .shelf-label {display:none!important;}
}
@media(max-height:500px) and (orientation:landscape) {
 .lastlight .masthead {padding:2px 8px;}
 .lastlight .night-bar {padding:2px 8px 4px;}
 .lastlight .brand .eyebrow,.lastlight .brand-icon {display:none!important;}
 .lastlight .counter-dock {display:grid!important;grid-template-columns:1fr 1fr;column-gap:14px;width:calc(100% - 16px);top:8px;left:8px;max-height:calc(100% - 16px);padding:8px!important;}
 .lastlight .counter-status {max-height:1.5em;margin-top:5px!important;}
 .lastlight .counter-tabs {margin-top:0;}
 .lastlight .counter-status {grid-column:1/-1;}
 .lastlight .counter-panel {grid-column:1/-1;margin-top:6px;padding-top:6px;}
 .lastlight .panel-heading {display:none!important;}
 .lastlight .mobile-shelves {grid-template-columns:repeat(6,minmax(0,1fr));}
 .lastlight .mobile-chores {grid-template-columns:repeat(4,minmax(0,1fr));}
 .lastlight .touch-counter {grid-template-columns:repeat(6,minmax(0,1fr));}
 .lastlight .mobile-product {flex-direction:row;min-height:52px;}
}
.lastlight .counter-tabs {display:grid!important;}

/* MOBILE EDITION END */
</style>
<Box className={view.rootClass}>
 <Loop interval={100} running={running && !paused} @tick={tick} />
 <Box className="shell">
  <Box className="masthead"><Box className="brand"><Image loading="eager" className="brand-icon" src={asset("assets/icon.svg")} alt="" width={37} height={43} showPlaceholder={false} objectFit="contain" /><Box><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="eyebrow">LAST LIGHT · MINI MART</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="brand-title">Convenience Store at the End of the Universe</Text></Box></Box><Box className="tools"><Button className="text-button" @click={openNotebook}>The notebook</Button><Button className="text-button" @click={openSettings}>Pause &amp; settings</Button></Box></Box>
  <Box className="night-bar"><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="night-title">{"NIGHT "+view.night+" / 7  —  "+view.shiftName}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="clock">{view.clock+"  ·  LOCAL, MORE OR LESS"}</Text></Box>
  <Box className="stage-wrap"><World /><Counter /><Dialogue /><Screens /></Box>
  <Box className="footnote"><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}}>The usual things. Until the end of everything.</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}}>Built with Softn · Last Light edition 0.2.3 · No rush.</Text></Box>
 </Box>
</Box>
