<Box if={view.overlay==="welcome"} className="welcome-card">
 <Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="eyebrow">A SHOP AT THE END OF EVERYTHING</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="welcome-title">The lights stay on.</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="welcome-subtitle">Someone still needs coffee.</Text>
 <Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="body-copy">Seven nights. Six familiar faces. A tiny convenience store surrounded by a universe that is quietly coming apart.</Text>
 <Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="body-copy">Take their usual from the shelf. Turn it, scan it, bag it. Make room in the till for something unusual. Make a little time for the person who brought it.</Text>
 <Box className="choices"><Button className="button primary" @click={beginShift}>{view.hasProgress ? "Return to the counter" : "Open the little shop"}</Button><Button className="text-button" @click={openSettings}>Settings &amp; saved games</Button></Box>
 <Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="small-copy">No hurry. No disappearing customers. Conversations pause the shop.</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} if={view.saveBlocked} className="warning">{view.saveStatus}</Text>
</Box>
<Box if={view.overlay==="settings"} className="sheet" role="dialog" ariaLabel="Settings and saved games">
 <Box className="sheet-head"><Box><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="eyebrow">THE SHOP CAN WAIT</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="sheet-title">A moment behind the counter</Text></Box><Button className="button primary" @click={resumeGame}>Return to the shop</Button></Box>
 <Box className="setting-grid"><Button className="button" @click={toggleSound}>{view.muted ? "Sound: off" : "Sound: on"}</Button><Button className="button" @click={toggleMusic}>{view.music ? "Quiet radio music: on" : "Quiet radio music: off"}</Button><Button className="button" @click={toggleMotion}>{view.motion ? "Reduced motion: on" : "Reduced motion: off"}</Button><Button className="button" @click={toggleCaptions}>{view.captions ? "Sound captions: on" : "Sound captions: off"}</Button></Box>
 <Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="section-heading">Your little corner of the universe</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="body-copy">{view.saveStatus}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="small-copy">Export before replacing or updating a bundle. Some Softn hosts give each build its own storage space. Original v1 JSON saves can be imported here; the original copy is never removed.</Text>
 <Box className="choices"><Button if={view.saveBlocked} className="button" @click={exportProtectedSave}>Export the protected original</Button><Button className="button" @click={exportSave}>Export this save</Button><Button className="button" @click={pickSave}>Import a save file</Button><Button className="text-button" @click={requestReset}>Start a new seven-night story</Button></Box>
 <Box if={view.pendingImport} className="confirm-box"><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="body-copy">A valid saved game is ready. Replace this session? A separate pre-import backup will be kept.</Text><Button className="button primary" @click={confirmImport}>Keep a backup and restore this file</Button><Button className="button" @click={cancelImport}>Cancel</Button></Box>
 <Box if={view.confirmReset} className="confirm-box"><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="body-copy">Start again at night one? This resets the current story, not your collected endings. A separate backup will be kept.</Text><Button className="button primary" @click={newGame}>Yes, keep a backup and start again</Button><Button className="button" @click={cancelReset}>Keep this story</Button></Box>
 <Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="section-heading">Hands, not a hurry</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="small-copy">Click the shop itself. 1–6: shelves. R: turn. S: scan. B: bag. P: payment. E: till. T / Space: talk. Q: delivery. C: coffee. N: noodles. X: mop. F: tonight's oddity. Escape: pause / step back.</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="small-copy">Use the Shelves, Checkout and Shop tabs at the top of the scene. The gold button suggests the next step. Nothing advances while this page, a conversation, or payment inspection is open.</Text>
 <Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} if={view.saveText!==""} className="save-code">{view.saveText}</Text>
</Box>
<Box if={view.overlay==="notebook"} className="sheet" role="dialog" ariaLabel="The shop notebook">
 <Box className="sheet-head"><Box><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="eyebrow">BEHIND THE TILL</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="sheet-title">Little things worth keeping</Text></Box><Button className="button primary" @click={resumeGame}>Close the notebook</Button></Box><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="small-copy">Not a ledger. Just the things you would rather not forget.</Text>
 <Box className="journal-list">#each (entry in journalView)<Box className="journal-entry"><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="eyebrow">{"NIGHT "+entry.night+" · "+entry.name}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="body-copy">{entry.text}</Text></Box>#end</Box>
</Box>
<Box if={view.phase==="interlude" && view.overlay===""} className="night-receipt">
 <Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="eyebrow">{"END OF NIGHT "+view.night}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="sheet-title">{view.shiftName}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="dialogue-line">{view.closeLine}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="small-copy">Your regulars remember. The things they left are still on the windowsill.</Text><Button className="button primary" @click={nextShift}>Put the kettle on for tomorrow</Button><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="receipt-thanks">THANK YOU FOR BEING HERE.</Text>
</Box>
<Box if={view.phase==="finale" && view.overlay===""} className="ending-sheet">
 <Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="eyebrow">THE LAST SHIFT IS OVER. THE LIGHT IS STILL ON.</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="sheet-title">What do we do with a little shop?</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="dialogue-line">{view.finaleLine}</Text>
 <Box className="ending-choices">#each (ending in endingsView)<Button className="button ending-choice" @click={chooseEnding(ending.id)}><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="customer-title">{ending.name}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="body-copy">{ending.detail}</Text></Button>#end</Box>
</Box>
<Box if={view.phase==="ended" && view.overlay===""} className="ending-sheet">
 <Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="eyebrow">LAST LIGHT · AN ENDING</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="ending-title">{view.endingTitle}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="dialogue-line">{view.endingBody}</Text><Box className="epilogues">#each (person in epiloguesView)<Box className="epilogue"><Image loading="eager" src={asset(person.art)} alt="" width={68} height={102} showPlaceholder={false}  objectFit="contain" /><Box><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="customer-title">{person.name}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="body-copy">{person.text}</Text></Box></Box>#end</Box><Box className="choices"><Button className="button" @click={openNotebook}>Read the little things again</Button><Button className="button" @click={openSettings}>Keep this ending / start another story</Button></Box><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="receipt-thanks">THE FRIDGE HUMS. SOMEWHERE, IT IS MORNING.</Text>
</Box>
