// MazeEscape3D — Procedural cavern maze with 3 rune crystals, PBR sconces & portal

let CELL = 2.0
let MOVE = 3.8
let RUN = 5.7
let P_R = 0.32
let EYE = 1.52

let mazeSize = 15
let ROWS = 15
let COLS = 15

let objects = []
let sceneStatic = []
let lights = []
let cameraPos = { x: 2.0, y: 1.52, z: 2.0 }
let cameraLookAt = { x: 6.0, y: 1.52, z: 2.0 }
let sceneFog = { color: "#0b0e14", near: 7, far: 44 }
let sceneEffects = {
  ambientOcclusion: { radius: 0.72, intensity: 0.9 },
  bloom: { strength: 0.42, radius: 0.28, threshold: 1.05 },
  vignette: 0.35
}

let started = false
let paused = false
let won = false
let touchMode = false
let touchSprint = false
let timeText = "0:00"
let bestText = "—"
let mapItems = []
let toast = ""
let toastTimer = 0.0

let maze = []
let visited = []
let runes = []
let runesCollected = 0
let portalOpen = false
let portalSpin = 0.0
let stepAccum = 0.0

let px = 2.0
let pz = 2.0
let yaw = Math.PI / 2
let pitch = 0.0
let vx = 0.0
let vz = 0.0
let startTime = 0
let elapsedMs = 0
let bestMs = 0
let exitX = 13
let exitZ = 13
let rngSeed = 1
let lastLocked = false
let bobPhase = 0.0
let steps = 0
let lastCell = -1
let muted = false
let pad = { presses: {} }
let sconceLights = []
let emberPositions = []
let titleAngle = 0.0
let camY = EYE

function playSfx(name, volume) {
  if (muted) { return }
  try {
    if (typeof softn !== "undefined" && softn.audio && softn.audio.play) {
      softn.audio.play("assets/sfx/" + name + ".wav", { volume: volume || 0.4 })
    }
  } catch (err) {}
}

function toggleMute() {
  muted = !muted
  try {
    if (typeof localStorage !== "undefined") { localStorage.setItem("maze3d:muted", muted ? "1" : "0") }
  } catch (err) {}
}

function myRand() {
  rngSeed = (rngSeed * 48271) % 2147483647
  return rngSeed / 2147483647
}

function loadBestForSize(sz) {
  let k = sz === 15 ? "maze3d:best" : "maze3d:best" + sz
  try {
    if (typeof localStorage !== "undefined") {
      bestMs = parseInt(localStorage.getItem(k) || "0", 10) || 0
    } else { bestMs = 0 }
  } catch (err) { bestMs = 0 }
  bestText = bestMs > 0 ? clock(bestMs) : "—"
}

function selectSize(sz) {
  mazeSize = sz
  ROWS = sz
  COLS = sz
  loadBestForSize(sz)
  if (!started) {
    carveMaze()
    placeRunes()
    buildScene()
    spawn()
    buildLights()
    composeObjects()
    buildMap()
  }
}

function isLikelyTouch() {
  if (typeof window === "undefined") { return false }
  let coarse = false
  try { coarse = !!(window.matchMedia && window.matchMedia("(pointer: coarse)").matches) } catch (err) {}
  return (typeof navigator !== "undefined" && navigator.maxTouchPoints > 0) || coarse || window.innerWidth <= 860
}

function _init() {
  if (typeof window !== "undefined" && window.__mzCleanup) { window.__mzCleanup() }
  rngSeed = (Date.now() % 100000) + 29
  pad = { presses: {} }
  touchSprint = false
  touchMode = isLikelyTouch()
  if (typeof window !== "undefined") {
    window.__mzTouch = touchMode
    window.__scene3dLocked = false
    window.__scene3dWantLock = false
    window.__scene3dReleaseLock = false
    function onTouch() { window.__mzTouch = true; touchMode = true }
    window.addEventListener("touchstart", onTouch, { passive: true })
    window.__mzCleanup = function () { window.removeEventListener("touchstart", onTouch) }
  }
  loadBestForSize(mazeSize)
  try {
    if (typeof localStorage !== "undefined") {
      muted = localStorage.getItem("maze3d:muted") === "1"
    }
  } catch (err) { muted = false }
  initEmbers()
  carveMaze()
  placeRunes()
  buildScene()
  spawn()
  buildLights()
  composeObjects()
  buildMap()
}

function _onHide() {
  pad = { presses: {} }
  if (started && !paused && !won) { paused = true }
  if (typeof window !== "undefined" && window.__mzCleanup) {
    window.__mzCleanup()
    window.__mzCleanup = null
  }
}

function onControlPress(action) {
  if (action === "mute") { toggleMute(); return }
  if (action === "pause" && started && !won) {
    if (paused) { resumeGame() } else { pauseGame() }
  }
}

function initEmbers() {
  emberPositions = []
  let i = 0
  while (i < 90) {
    emberPositions.push(1.0 + ((i * 17) % Math.max(4, (COLS - 2) * CELL)))
    emberPositions.push(0.35 + ((i * 11) % 22) * 0.1)
    emberPositions.push(1.0 + ((i * 23) % Math.max(4, (ROWS - 2) * CELL)))
    i = i + 1
  }
}

function carveMaze() {
  maze = []
  let i = 0
  while (i < ROWS * COLS) { maze.push(1); i = i + 1 }
  let stack = [[1, 1]]
  maze[1 * COLS + 1] = 0
  while (stack.length > 0) {
    let top = stack[stack.length - 1]
    let r = top[0]
    let c = top[1]
    let options = []
    if (r - 2 >= 1 && maze[(r - 2) * COLS + c] === 1) { options.push([r - 2, c, r - 1, c]) }
    if (r + 2 < ROWS - 1 && maze[(r + 2) * COLS + c] === 1) { options.push([r + 2, c, r + 1, c]) }
    if (c - 2 >= 1 && maze[r * COLS + c - 2] === 1) { options.push([r, c - 2, r, c - 1]) }
    if (c + 2 < COLS - 1 && maze[r * COLS + c + 2] === 1) { options.push([r, c + 2, r, c + 1]) }
    if (options.length === 0) {
      stack = stack.slice(0, stack.length - 1)
    } else {
      let pick = options[Math.floor(myRand() * options.length)]
      maze[pick[2] * COLS + pick[3]] = 0
      maze[pick[0] * COLS + pick[1]] = 0
      stack.push([pick[0], pick[1]])
    }
  }
  let extra = Math.floor((ROWS * COLS) / 38)
  let n = 0
  while (n < extra) {
    let r = 1 + Math.floor(myRand() * (ROWS - 2))
    let c = 1 + Math.floor(myRand() * (COLS - 2))
    if (maze[r * COLS + c] === 1 && ((r % 2 === 1) !== (c % 2 === 1))) { maze[r * COLS + c] = 0; n = n + 1 }
  }
  exitX = COLS - 2
  exitZ = ROWS - 2
  visited = []
  i = 0
  while (i < ROWS * COLS) { visited.push(0); i = i + 1 }
}

function placeRunes() {
  runes = []
  runesCollected = 0
  portalOpen = false
  let candidates = []
  let r = 1
  while (r < ROWS - 1) {
    let c = 1
    while (c < COLS - 1) {
      if (maze[r * COLS + c] === 0 && !(r === 1 && c === 1) && !(r === exitZ && c === exitX)) {
        let walls = (wallAt(c + 1, r) ? 1 : 0) + (wallAt(c - 1, r) ? 1 : 0) + (wallAt(c, r + 1) ? 1 : 0) + (wallAt(c, r - 1) ? 1 : 0)
        if (walls >= 3 || ((r + c) % 5 === 0 && Math.abs(r - c) >= 3)) {
          candidates.push({ r: r, c: c, prio: walls * 10 + (r + c) })
        }
      }
      c = c + 1
    }
    r = r + 1
  }
  candidates.sort(function (a, b) { return b.prio - a.prio })
  let i = 0
  let step = Math.max(1, Math.floor(candidates.length / 3))
  while (runes.length < 3 && i < candidates.length) {
    let pick = candidates[i]
    runes.push({
      id: "rune-" + (runes.length + 1),
      c: pick.c,
      r: pick.r,
      x: pick.c * CELL,
      z: pick.r * CELL,
      collected: false
    })
    i = i + step
  }
  // Fallback if small maze had fewer spread candidates
  let ci = 0
  while (runes.length < 3 && ci < candidates.length) {
    let pick = candidates[ci]
    let dup = false
    let ri = 0
    while (ri < runes.length) {
      if (runes[ri].c === pick.c && runes[ri].r === pick.r) { dup = true }
      ri = ri + 1
    }
    if (!dup) {
      runes.push({ id: "rune-" + (runes.length + 1), c: pick.c, r: pick.r, x: pick.c * CELL, z: pick.r * CELL, collected: false })
    }
    ci = ci + 1
  }
}

function wallAt(col, row) {
  if (row < 0 || row >= ROWS || col < 0 || col >= COLS) { return true }
  return maze[row * COLS + col] === 1
}

function blocked(x, z) {
  let minC = Math.floor((x - P_R) / CELL + 0.5)
  let maxC = Math.floor((x + P_R) / CELL + 0.5)
  let minR = Math.floor((z - P_R) / CELL + 0.5)
  let maxR = Math.floor((z + P_R) / CELL + 0.5)
  let r = minR
  while (r <= maxR) {
    let c = minC
    while (c <= maxC) {
      if (wallAt(c, r)) {
        let wx = c * CELL
        let wz = r * CELL
        let half = CELL / 2
        let nx = Math.max(wx - half, Math.min(x, wx + half))
        let nz = Math.max(wz - half, Math.min(z, wz + half))
        if ((x - nx) * (x - nx) + (z - nz) * (z - nz) < P_R * P_R) { return true }
      }
      c = c + 1
    }
    r = r + 1
  }
  return false
}

function buildScene() {
  initEmbers()
  let out = []
  let span = COLS * CELL
  out.push({
    id: "mz-floor",
    type: "box",
    position: { x: (COLS - 1) * CELL * 0.5, y: -0.1, z: (ROWS - 1) * CELL * 0.5 },
    width: span + 2,
    height: 0.2,
    depth: span + 2,
    color: "#222936",
    roughness: 0.92,
    receiveShadow: true
  })

  // Instanced exposed stone maze walls
  let wallPos = []
  sconceLights = []
  let r = 0
  while (r < ROWS) {
    let c = 0
    while (c < COLS) {
      if (maze[r * COLS + c] === 1) {
        let exposed = !wallAt(c - 1, r) || !wallAt(c + 1, r) || !wallAt(c, r - 1) || !wallAt(c, r + 1)
        if (exposed) {
          wallPos.push(c * CELL, 1.35, r * CELL)
        }
      } else if (((r * 7 + c * 11) % 13 === 0 || (r === 1 && c === 2) || (r === 2 && c === 1)) && (r !== 1 || c !== 1) && (r !== exitZ || c !== exitX)) {
        let dirs = [[1, 0], [0, 1], [-1, 0], [0, -1]]
        let k = 0
        let found = false
        while (k < 4 && !found) {
          let d = dirs[(r + c + k) % 4]
          if (wallAt(c + d[0], r + d[1])) {
            found = true
            let wx = c * CELL + d[0] * (CELL * 0.48)
            let wz = r * CELL + d[1] * (CELL * 0.48)
            let rotY = Math.atan2(-d[0], -d[1])
            out.push({
              id: "sc-" + r + "_" + c,
              type: "model",
              modelUrl: "assets/models/wall-sconce.glb",
              fit: 0.55,
              position: { x: wx, y: 1.55, z: wz },
              rotation: { x: 0, y: rotY, z: 0 },
              castShadow: false
            })
            sconceLights.push({ x: wx - d[0] * 0.35, y: 1.85, z: wz - d[1] * 0.35 })
          }
          k = k + 1
        }
      }
      c = c + 1
    }
    r = r + 1
  }

  out.push({
    id: "mz-walls-inst",
    type: "instanced",
    shape: "box",
    width: CELL,
    height: 2.7,
    depth: CELL,
    color: "#515c72",
    roughness: 0.88,
    instances: wallPos,
    castShadow: true,
    receiveShadow: true
  })

  // Start Obelisk Guardian tucked in the corner clear of spawn
  out.push({
    id: "mz-start-obelisk",
    type: "model",
    modelUrl: "assets/models/stone-obelisk.glb",
    fit: 1.25,
    position: { x: CELL * 0.66, y: 0, z: CELL * 0.66 },
    castShadow: true,
    receiveShadow: true
  })

  sceneStatic = out
}

function buildLights() {
  let flicker = started ? (Math.sin(portalSpin * 6.0) * 0.6 + Math.cos(portalSpin * 11.0) * 0.35) : 0
  let list = [
    { id: "ambient", type: "ambient", color: "#8a9ab8", intensity: started ? 0.28 : 1.15 },
    { id: "hemi", type: "hemisphere", color: "#9db4ef", groundColor: "#141826", intensity: started ? 0.52 : 1.1 },
    {
      id: "torch",
      type: "point",
      color: "#ffd194",
      intensity: (started ? 10.5 : 4.0) + flicker,
      distance: 15,
      decay: 1.8,
      castShadow: started,
      shadowMapSize: 512,
      position: { x: px, y: 2.0, z: pz }
    },
    {
      id: "exitglow",
      type: "point",
      color: portalOpen ? "#4ade80" : "#fbbf24",
      intensity: portalOpen ? 18 : 10,
      distance: 16,
      decay: 1.8,
      position: { x: exitX * CELL, y: 2.0, z: exitZ * CELL }
    }
  ]
  let refX = started ? px : cameraPos.x
  let refZ = started ? pz : cameraPos.z
  let nearest = []
  let si = 0
  while (si < sconceLights.length) {
    let sl = sconceLights[si]
    let d2 = (sl.x - refX) * (sl.x - refX) + (sl.z - refZ) * (sl.z - refZ)
    if (nearest.length < 4 || d2 < nearest[nearest.length - 1].d2) {
      let placed = false
      let k = 0
      while (k < nearest.length) {
        if (d2 < nearest[k].d2) {
          nearest.splice(k, 0, { d2: d2, sl: sl })
          placed = true
          break
        }
        k = k + 1
      }
      if (!placed) { nearest.push({ d2: d2, sl: sl }) }
      if (nearest.length > 4) { nearest.pop() }
    }
    si = si + 1
  }
  let ni = 0
  while (ni < nearest.length) {
    let sl = nearest[ni].sl
    let wf = Math.sin(portalSpin * 3.1 + ni * 1.7 + sl.x) * 0.45
    list.push({ id: "sl-" + ni, type: "point", color: "#ff8c38", intensity: 3.3 + wf, distance: 9, decay: 2.0, position: sl })
    ni = ni + 1
  }
  lights = list
}

function composeObjects() {
  let out = [
    {
      id: "sparks",
      type: "particles",
      particlePositions: emberPositions,
      particleSize: 0.14,
      particleShape: "soft",
      color: "#ffbe3b",
      opacity: 0.85,
      fog: true
    }
  ]

  // 3 Rune Crystal pickups with counter-spinning halo
  let ri = 0
  while (ri < runes.length) {
    let rn = runes[ri]
    if (!rn.collected) {
      let bobY = 0.72 + Math.sin(portalSpin * 2.5 + ri) * 0.12
      out.push({
        id: rn.id,
        type: "model",
        modelUrl: "assets/models/rune-crystal.glb",
        fit: 0.9,
        position: { x: rn.x, y: bobY, z: rn.z },
        parts: {
          Crystal_Core: { rotation: { x: 0, y: portalSpin * 1.6, z: 0 } },
          Ring: { rotation: { x: Math.sin(portalSpin + ri) * 0.4, y: -portalSpin * 2.2, z: 0 } }
        },
        castShadow: true
      })
    }
    ri = ri + 1
  }

  // Exit Portal Gate
  out.push({
    id: "mz-exit",
    type: "model",
    modelUrl: "assets/models/exit-portal.glb",
    fit: 2.2,
    position: { x: exitX * CELL, y: 0, z: exitZ * CELL },
    parts: {
      Portal_Ring: {
        rotation: { x: 0, y: 0, z: portalOpen ? portalSpin * 2.8 : portalSpin * 0.45 },
        scale: portalOpen ? 1.0 : 0.78
      }
    },
    castShadow: true,
    receiveShadow: true
  })

  objects = out
}

function titleDrift() {
  let mid = (COLS - 1) * CELL / 2
  let radius = Math.max(8, COLS * 0.65)
  px = mid + Math.cos(titleAngle) * radius
  pz = mid + Math.sin(titleAngle) * radius
  camY = Math.max(14, COLS * 1.1)
  yaw = Math.atan2(mid - px, mid - pz)
  pitch = -1.02
  if (typeof window !== "undefined") {
    window.__scene3dYaw = yaw
    window.__scene3dPitch = pitch
  }
  updateCamera()
}

function spawn() {
  px = CELL
  pz = CELL
  camY = EYE
  vx = 0; vz = 0
  yaw = wallAt(2, 1) ? 0 : Math.PI / 2
  pitch = 0
  if (typeof window !== "undefined") {
    window.__scene3dYaw = yaw
    window.__scene3dPitch = pitch
  }
  updateCamera()
}

function startGame() {
  carveMaze()
  placeRunes()
  buildScene()
  spawn()
  startTime = Date.now()
  elapsedMs = 0
  steps = 0
  lastCell = -1
  bobPhase = 0
  won = false
  paused = false
  started = true
  timeText = "0:00"
  if (!touchMode && typeof window !== "undefined") { window.__scene3dWantLock = true }
  showToast("Collect 3 Rune Shards to unseal the Exit Portal!")
  playSfx("start", 0.42)
  buildLights()
  composeObjects()
  buildMap()
}

function pauseGame() { paused = true }
function resumeGame() {
  paused = false
  if (!touchMode && typeof window !== "undefined") { window.__scene3dWantLock = true }
}
function toggleTouchMode() {
  touchMode = !touchMode
  if (typeof window !== "undefined") {
    window.__mzTouch = touchMode
    if (touchMode) { window.__scene3dReleaseLock = true }
  }
}
function toggleTouchSprint() { touchSprint = !touchSprint }
function pulseRuneHint() {
  let tx = exitX * CELL
  let tz = exitZ * CELL
  let label = portalOpen ? "Exit Portal" : "Rune"
  if (!portalOpen) {
    let bestD = 1e9
    let ri = 0
    while (ri < runes.length) {
      let rn = runes[ri]
      if (!rn.collected) {
        let d = (rn.x - px) * (rn.x - px) + (rn.z - pz) * (rn.z - pz)
        if (d < bestD) { bestD = d; tx = rn.x; tz = rn.z }
      }
      ri = ri + 1
    }
  }
  let ang = Math.atan2(tx - px, tz - pz) - yaw
  while (ang > Math.PI) { ang = ang - Math.PI * 2 }
  while (ang < -Math.PI) { ang = ang + Math.PI * 2 }
  let distM = Math.round(Math.hypot(tx - px, tz - pz))
  let dir = Math.abs(ang) < 0.45 ? "Ahead" : (Math.abs(ang) > 2.65 ? "Behind" : (ang > 0 ? "Turn Left" : "Turn Right"))
  showToast(label + " ~" + distM + "m · " + dir)
  playSfx("found", 0.35)
}
function backToTitle() {
  started = false; won = false; paused = false
  if (typeof window !== "undefined") { window.__scene3dReleaseLock = true }
}

function showToast(text) {
  toast = text
  toastTimer = 2.6
}

function clock(ms) {
  let s = Math.floor(ms / 1000)
  let m = Math.floor(s / 60)
  let rem = s % 60
  return m + ":" + (rem < 10 ? "0" + rem : rem)
}

function updateCamera() {
  let bob = Math.sin(bobPhase) * 0.04
  cameraPos = { x: px, y: camY + bob, z: pz }
  let cp = Math.cos(pitch)
  cameraLookAt = { x: px + Math.sin(yaw) * cp * 5, y: camY + Math.sin(pitch) * 5, z: pz + Math.cos(yaw) * cp * 5 }
}

function frameStep(rawDt) {
  let dt = rawDt || 0.016
  if (dt > 0.08) { dt = 0.08 }
  portalSpin = portalSpin + dt * 1.4
  if (toastTimer > 0.0) {
    toastTimer = Math.max(0.0, toastTimer - dt)
    if (toastTimer <= 0.0) { toast = "" }
  }

  if (!started) {
    titleAngle = titleAngle + dt * 0.14
    titleDrift()
    buildLights()
    composeObjects()
    return
  }

  let locked = typeof window !== "undefined" ? !!window.__scene3dLocked : false
  if (lastLocked && !locked && !touchMode && !won) { paused = true }
  lastLocked = locked
  if (typeof window !== "undefined" && window.__mzTouch) { touchMode = true }
  if (paused || won) { return }

  if (typeof window !== "undefined") {
    if (window.__scene3dYaw !== undefined) { yaw = window.__scene3dYaw }
    if (window.__scene3dPitch !== undefined) { pitch = window.__scene3dPitch }
  }

  let fwd = (pad.up ? 1 : 0) - (pad.down ? 1 : 0)
  let str = (pad.right ? 1 : 0) - (pad.left ? 1 : 0)
  let len = Math.sqrt(fwd * fwd + str * str)
  if (len > 0) { fwd = fwd / len; str = str / len }
  let speed = (pad.sprint || touchSprint) ? RUN : MOVE
  let wx = Math.sin(yaw) * fwd - Math.cos(yaw) * str
  let wz = Math.cos(yaw) * fwd + Math.sin(yaw) * str
  let blend = Math.min(1.0, 14.0 * dt)
  vx = vx + (wx * speed - vx) * blend
  vz = vz + (wz * speed - vz) * blend
  let nx = px + vx * dt
  if (blocked(nx, pz)) { vx = 0 } else { px = nx }
  let nz = pz + vz * dt
  if (blocked(px, nz)) { vz = 0 } else { pz = nz }

  if ((vx * vx + vz * vz) > 1.2) {
    bobPhase = bobPhase + dt * 9.0
    stepAccum = stepAccum + dt * (pad.sprint ? 1.4 : 1.0)
    if (stepAccum >= 0.42) {
      stepAccum = 0.0
      playSfx("step", 0.16)
    }
  } else {
    stepAccum = 0.2
  }

  // Minimap cell reveal
  let cc = Math.floor(px / CELL + 0.5)
  let cr = Math.floor(pz / CELL + 0.5)
  if (cr >= 0 && cr < ROWS && cc >= 0 && cc < COLS) {
    let cell = cr * COLS + cc
    if (cell !== lastCell) {
      lastCell = cell
      if (visited[cell] === 0) {
        visited[cell] = 1
        steps = steps + 1
        playSfx("found", 0.15)
      }
      buildMap()
    }
  }

  // Rune pickup check
  let ri = 0
  while (ri < runes.length) {
    let rn = runes[ri]
    if (!rn.collected) {
      let rdx = px - rn.x
      let rdz = pz - rn.z
      if (rdx * rdx + rdz * rdz < 1.25) {
        rn.collected = true
        runesCollected = runesCollected + 1
        playSfx("rune", 0.55)
        if (runesCollected >= 3) {
          portalOpen = true
          playSfx("portal", 0.55)
          showToast("All 3 Runes Found — Exit Portal UNSEALED!")
        } else {
          showToast("Rune Crystal " + runesCollected + " / 3 collected!")
        }
        buildMap()
      }
    }
    ri = ri + 1
  }

  elapsedMs = Date.now() - startTime
  timeText = clock(elapsedMs)
  let dx = px - exitX * CELL
  let dz = pz - exitZ * CELL
  if (dx * dx + dz * dz < 1.35) {
    if (portalOpen) {
      finish()
    } else if (toastTimer <= 0.1) {
      showToast("Portal Sealed! Gather " + (3 - runesCollected) + " more Rune Crystal(s)")
    }
  }

  updateCamera()
  buildLights()
  composeObjects()
}

function finish() {
  won = true
  if (typeof window !== "undefined") { window.__scene3dReleaseLock = true }
  playSfx("win", 0.6)
  if (bestMs === 0 || elapsedMs < bestMs) {
    bestMs = elapsedMs
    bestText = clock(bestMs)
    let k = mazeSize === 15 ? "maze3d:best" : "maze3d:best" + mazeSize
    try {
      if (typeof localStorage !== "undefined") { localStorage.setItem(k, String(bestMs)) }
    } catch (err) {}
    showToast("New Best Time (" + mazeSize + "x" + mazeSize + ")!")
  }
}

function buildMap() {
  let items = []
  let r = 0
  while (r < ROWS) {
    let c = 0
    while (c < COLS) {
      let val = maze[r * COLS + c]
      let seen = visited[r * COLS + c] === 1
      let here = Math.floor(px / CELL + 0.5) === c && Math.floor(pz / CELL + 0.5) === r
      let isExit = r === exitZ && c === exitX
      let hasRune = false
      let ri = 0
      while (ri < runes.length) {
        if (!runes[ri].collected && runes[ri].c === c && runes[ri].r === r) { hasRune = true }
        ri = ri + 1
      }
      if (here) { items.push("#38bdf8") }
      else if (isExit) { items.push(portalOpen ? "#4ade80" : "#fbbf24") }
      else if (hasRune) { items.push("#22d3ee") }
      else if (!seen) { items.push("#111622") }
      else if (val === 1) { items.push("#475569") }
      else { items.push("#1e293b") }
      c = c + 1
    }
    r = r + 1
  }
  mapItems = items
}

function onSceneClick(hit) {}
