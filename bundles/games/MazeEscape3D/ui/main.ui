<logic src="../logic/main.logic" />

<style>
.mz-root { position: relative; width: 100%; height: 100%; min-height: 0; overflow: hidden; background: #0b0e14; font-family: "Segoe UI", system-ui, sans-serif; color: #e6e9f4; user-select: none; touch-action: none; -webkit-touch-callout: none; }
.mz-scene { position: absolute; inset: 0; }
.mz-ovl { position: absolute; pointer-events: none; }
.mz-panel { background: rgba(8, 11, 18, 0.72); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; backdrop-filter: blur(8px); }
.mz-hud { top: 14px; left: 14px; padding: 10px 14px; }
.mz-map { top: 14px; right: 14px; padding: 8px; pointer-events: auto; cursor: pointer; z-index: 16; }
.mz-toast { bottom: 26px; left: 50%; transform: translateX(-50%); padding: 8px 18px; border-radius: 999px; border-color: rgba(56,189,248,0.45); }
.mz-vig { inset: 0; background: radial-gradient(110% 100% at 50% 50%, rgba(0,0,0,0) 55%, rgba(0,0,0,0.48) 100%); }
.mz-card-wrap { inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: auto; background: linear-gradient(180deg, rgba(4,6,12,0.35) 0%, rgba(4,6,12,0.68) 100%); z-index: 25; }
.mz-card { width: min(540px, calc(100% - 32px)); padding: 30px 32px 26px; text-align: center; background: rgba(8,11,18,0.86); border: 1px solid rgba(255,255,255,0.12); border-radius: 18px; box-shadow: 0 30px 80px rgba(0,0,0,0.65); backdrop-filter: blur(10px); touch-action: pan-y; }
.mz-keys { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 18px auto 0; text-align: left; max-width: 340px; }
.mz-kbd { display: inline-block; min-width: 26px; padding: 2px 7px; border-radius: 6px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.18); font-family: ui-monospace, monospace; text-align: center; }
.mz-touch { position: absolute; left: 12px; bottom: 16px; pointer-events: auto; z-index: 15; touch-action: none; -webkit-touch-callout: none; }
.mz-touchbar { position: absolute; right: 12px; bottom: 16px; pointer-events: auto; display: flex; flex-direction: column; align-items: flex-end; gap: 8px; z-index: 15; touch-action: none; -webkit-touch-callout: none; }
.mz-corner { top: 14px; right: 14px; display: flex; gap: 6px; pointer-events: auto; z-index: 16; }
@media (max-width: 640px) {
  .mz-hud { top: 8px; left: 8px; padding: 8px 10px; }
  .mz-map { top: 8px; right: 8px; padding: 6px; }
  .mz-toast { bottom: 185px; max-width: calc(100vw - 24px); text-align: center; font-size: 12px; padding: 6px 12px; }
  .mz-card { padding: 22px 16px; width: calc(100vw - 24px); }
}
</style>

<Box className="mz-root">
  <Loop frame running={true} @tick={frameStep} />
  <Controls
    :bind={pad}
    enabled={started && !won}
    keys={{
      up: "w ArrowUp",
      down: "s ArrowDown",
      left: "a ArrowLeft",
      right: "d ArrowRight",
      sprint: "ShiftLeft ShiftRight",
      hint: "h",
      mute: "m",
      pause: "p Escape"
    }}
    @press={onControlPress}
  />

  <Box className="mz-scene">
    <Scene3D
      fill={true}
      objects={objects}
      staticObjects={sceneStatic}
      lights={lights}
      camera={{ position: cameraPos, lookAt: cameraLookAt, fov: 75 }}
      antialias={true}
      shadows={true}
      pointerLock={started && !paused && !won && !touchMode}
      mouseLook={started && !paused && !won}
      crosshair={started && !paused && !won}
      pitchLimit={0.95}
      cameraSmoothing={0.38}
      maxPixelRatio={1.5}
      mouseLookSensitivity={touchMode ? 0.0056 : 0.0024}
      fog={sceneFog}
      environment={{ url: "assets/env/cavern-torch.hdr", background: true, backgroundIntensity: 0.72 }}
      environmentIntensity={0.68}
      toneMapping="agx"
      toneMappingExposure={1.1}
      effects={sceneEffects}
      @click={onSceneClick}
    >
      <SceneAnchor if={started && !won && (portalOpen || exitSeen)} object="mz-exit" offset={{ y: 2.35 }} place="above" clickThrough={true}>
        <Box style={{ background: "rgba(8,12,20,0.86)", border: portalOpen ? "1px solid #4ade80" : "1px solid #fbbf24", borderRadius: "6px", padding: "3px 9px", whiteSpace: "nowrap" }}>
          <Text style={{ fontSize: "10px", fontWeight: 700, color: portalOpen ? "#4ade80" : "#fbbf24" }}>
            {portalOpen ? "EXIT PORTAL OPEN" : ("SEALED (" + runesCollected + "/3 RUNES)")}
          </Text>
        </Box>
      </SceneAnchor>
    </Scene3D>
  </Box>
  <Box className="mz-ovl mz-vig" />

  <Box if={started} className="mz-ovl mz-panel mz-hud">
    <Text style={{ display: "block", fontSize: "11px", letterSpacing: "0.14em", color: "#94a3b8" }}>TIME</Text>
    <Text style={{ display: "block", fontSize: "24px", fontWeight: 800, color: "#ffffff", lineHeight: 1.1 }}>{timeText}</Text>
    <Text style={{ display: "block", fontSize: "12px", fontWeight: 700, color: portalOpen ? "#4ade80" : "#22d3ee", marginTop: "4px" }}>
      {portalOpen ? "Portal Unsealed!" : ("Runes: " + runesCollected + " / 3")}
    </Text>
    <Text style={{ display: "block", fontSize: "11px", color: "#94a3b8", marginTop: "2px" }}>{"Best (" + mazeSize + "x" + mazeSize + "): " + bestText}</Text>
  </Box>

  <Box if={started} className="mz-ovl mz-panel mz-map" @click={toggleMap}>
    <Text style={{ display: "block", fontSize: "10px", fontWeight: 700, letterSpacing: "0.1em", color: "#94a3b8", marginBottom: mapCollapsed ? "0px" : "5px", textAlign: "center" }}>{mapCollapsed ? "MAP [+]" : "MAP [–]"}</Text>
    <Box if={!mapCollapsed}>
      <PixelGrid rows={ROWS} cols={COLS} cellSize={ROWS > 15 ? 5 : 7} items={mapItems} background="rgba(0,0,0,0.4)" />
    </Box>
  </Box>

  <Box if={toast !== ""} className="mz-ovl mz-panel mz-toast">
    <Text style={{ fontSize: "13px", color: "#ffffff", fontWeight: 600 }}>{toast}</Text>
  </Box>

  <Box if={started && touchMode && !won && !paused} className="mz-touch">
    <DPad :bind={pad} buttonSize={48} />
  </Box>
  <Box if={started && touchMode && !won && !paused} className="mz-touchbar">
    <Stack direction="horizontal" gap={6}>
      <Button variant="ghost" style={{ padding: "8px 12px", minHeight: "40px", borderRadius: "10px", fontWeight: 700, fontSize: "12px", background: "rgba(8,11,18,0.8)", color: "#22d3ee", border: "1px solid rgba(34,211,238,0.45)" }} @click={pulseRuneHint}>Hint</Button>
      <Button variant="ghost" style={{ padding: "8px 12px", minHeight: "40px", borderRadius: "10px", fontWeight: 700, fontSize: "12px", background: touchSprint ? "rgba(250,204,21,0.35)" : "rgba(8,11,18,0.8)", color: "#fff", border: touchSprint ? "1px solid #facc15" : "1px solid rgba(255,255,255,0.22)" }} @click={toggleTouchSprint}>{touchSprint ? "Run ON" : "Run"}</Button>
    </Stack>
    <Stack direction="horizontal" gap={6}>
      <Button variant="ghost" style={{ padding: "8px 12px", minHeight: "40px", borderRadius: "10px", fontWeight: 700, fontSize: "12px", background: "rgba(8,11,18,0.8)", color: "#fff", border: "1px solid rgba(255,255,255,0.22)" }} @click={toggleMute}>{muted ? "Unmute" : "Mute"}</Button>
      <Button variant="ghost" style={{ padding: "8px 12px", minHeight: "40px", borderRadius: "10px", fontWeight: 700, fontSize: "12px", background: "rgba(8,11,18,0.8)", color: "#fff", border: "1px solid rgba(255,255,255,0.22)" }} @click={pauseGame}>Pause</Button>
    </Stack>
  </Box>
  <Box if={started && !touchMode && !won && !paused} className="mz-touchbar">
    <Stack direction="horizontal" gap={6}>
      <Button variant="ghost" style={{ padding: "8px 12px", minHeight: "36px", borderRadius: "10px", fontWeight: 700, fontSize: "12px", background: "rgba(8,11,18,0.72)", color: "#22d3ee", border: "1px solid rgba(34,211,238,0.4)" }} @click={pulseRuneHint}>Hint (H)</Button>
      <Button variant="ghost" style={{ padding: "8px 12px", minHeight: "36px", borderRadius: "10px", fontWeight: 700, fontSize: "12px", background: "rgba(8,11,18,0.72)", color: "#cbd5e1", border: "1px solid rgba(255,255,255,0.16)" }} @click={toggleTouchMode}>Touch Pad</Button>
    </Stack>
  </Box>

  <!-- Title -->
  <Box if={!started} className="mz-ovl mz-card-wrap">
    <Box className="mz-card">
      <Text style={{ display: "block", fontSize: "12px", letterSpacing: "0.4em", color: "#4ade80" }}>CAVERN LABYRINTH</Text>
      <Text style={{ display: "block", marginTop: "8px", fontSize: "48px", fontWeight: 900, letterSpacing: "-0.03em", lineHeight: 1, color: "#ffffff" }}>Maze Escape 3D</Text>
      <Text style={{ display: "block", marginTop: "10px", fontSize: "14px", color: "#cbd5e1" }}>Collect 3 glowing Rune Crystals to unseal the Exit Portal. Every labyrinth is freshly carved.</Text>

      <Stack direction="horizontal" gap={8} style={{ justifyContent: "center", marginTop: "16px", flexWrap: "wrap" }}>
        <Button variant="ghost" @click={selectSize(11)} style={{ padding: "8px 14px", fontSize: "12px", borderRadius: "8px", background: mazeSize === 11 ? "#0284c7" : "rgba(255,255,255,0.08)", color: "#fff", border: "1px solid rgba(255,255,255,0.16)" }}>Small 11x11</Button>
        <Button variant="ghost" @click={selectSize(15)} style={{ padding: "8px 14px", fontSize: "12px", borderRadius: "8px", background: mazeSize === 15 ? "#0284c7" : "rgba(255,255,255,0.08)", color: "#fff", border: "1px solid rgba(255,255,255,0.16)" }}>Classic 15x15</Button>
        <Button variant="ghost" @click={selectSize(21)} style={{ padding: "8px 14px", fontSize: "12px", borderRadius: "8px", background: mazeSize === 21 ? "#0284c7" : "rgba(255,255,255,0.08)", color: "#fff", border: "1px solid rgba(255,255,255,0.16)" }}>Grand 21x21</Button>
      </Stack>

      <Stack direction="horizontal" gap={10} style={{ justifyContent: "center", marginTop: "18px" }}>
        <Button @click={startGame} style={{ padding: "13px 34px", borderRadius: "10px", fontWeight: 800, fontSize: "16px", background: "#4ade80", color: "#052e16", border: "1px solid #4ade80" }}>Enter Maze</Button>
      </Stack>
      <Text if={bestText !== "—"} style={{ display: "block", marginTop: "12px", fontSize: "13px", color: "#94a3b8" }}>{"Best (" + mazeSize + "x" + mazeSize + "): " + bestText}</Text>
      <Button variant="ghost" @click={toggleMute} style={{ marginTop: "10px", padding: "6px 14px", borderRadius: "8px", fontSize: "12px", background: "rgba(255,255,255,0.08)", color: muted ? "#94a3b8" : "#fff", border: "1px solid rgba(255,255,255,0.14)" }}>{muted ? "Sound off" : "Sound on"}</Button>

      <Box className="mz-keys">
        <Text style={{ color: "#cfd8e6", fontSize: "13px" }}><Text className="mz-kbd" style={{ fontSize: "11px", color: "#fff" }}>W A S D</Text></Text><Text style={{ color: "#cfd8e6", fontSize: "13px" }}>move · <Text className="mz-kbd" style={{ fontSize: "11px", color: "#fff" }}>Shift</Text> sprint</Text>
        <Text style={{ color: "#cfd8e6", fontSize: "13px" }}><Text className="mz-kbd" style={{ fontSize: "11px", color: "#fff" }}>Mouse</Text></Text><Text style={{ color: "#cfd8e6", fontSize: "13px" }}>look · <Text className="mz-kbd" style={{ fontSize: "11px", color: "#fff" }}>H</Text> hint · <Text className="mz-kbd" style={{ fontSize: "11px", color: "#fff" }}>Esc</Text> pause · <Text className="mz-kbd" style={{ fontSize: "11px", color: "#fff" }}>M</Text> mute</Text>
      </Box>
    </Box>
  </Box>

  <!-- Paused -->
  <Box if={started && paused && !won} className="mz-ovl mz-card-wrap">
    <Box className="mz-card">
      <Text style={{ display: "block", fontSize: "26px", fontWeight: 800, color: "#ffffff" }}>Paused</Text>
      <Text style={{ display: "block", marginTop: "8px", fontSize: "14px", color: "#cbd5e1" }}>{"Time " + timeText + " · Runes " + runesCollected + "/3"}</Text>
      <Stack direction="horizontal" gap={10} style={{ justifyContent: "center", marginTop: "20px", flexWrap: "wrap" }}>
        <Button @click={resumeGame} style={{ padding: "12px 26px", borderRadius: "10px", fontWeight: 700, fontSize: "15px", background: "#4ade80", color: "#052e16" }}>Resume</Button>
        <Button variant="ghost" @click={startGame} style={{ padding: "12px 26px", borderRadius: "10px", fontWeight: 700, fontSize: "15px", background: "rgba(255,255,255,0.1)", color: "#fff", border: "1px solid rgba(255,255,255,0.2)" }}>New Maze</Button>
        <Button variant="ghost" @click={backToTitle} style={{ padding: "12px 26px", borderRadius: "10px", fontWeight: 700, fontSize: "15px", background: "rgba(255,255,255,0.1)", color: "#fff", border: "1px solid rgba(255,255,255,0.2)" }}>Title</Button>
      </Stack>
    </Box>
  </Box>

  <!-- Won -->
  <Box if={won} className="mz-ovl mz-card-wrap">
    <Box className="mz-card">
      <Text style={{ display: "block", fontSize: "12px", letterSpacing: "0.4em", color: "#fbbf24" }}>PORTAL CROSSED · YOU ESCAPED</Text>
      <Text style={{ display: "block", marginTop: "8px", fontSize: "44px", fontWeight: 900, color: "#ffffff" }}>{timeText}</Text>
      <Text style={{ display: "block", marginTop: "6px", fontSize: "14px", color: "#cbd5e1" }}>{"Best (" + mazeSize + "x" + mazeSize + "): " + bestText + " · " + steps + " cells explored"}</Text>
      <Stack direction="horizontal" gap={10} style={{ justifyContent: "center", marginTop: "20px", flexWrap: "wrap" }}>
        <Button @click={startGame} style={{ padding: "12px 26px", borderRadius: "10px", fontWeight: 800, fontSize: "15px", background: "#4ade80", color: "#052e16" }}>Another Maze</Button>
        <Button variant="ghost" @click={backToTitle} style={{ padding: "12px 26px", borderRadius: "10px", fontWeight: 700, fontSize: "15px", background: "rgba(255,255,255,0.1)", color: "#fff", border: "1px solid rgba(255,255,255,0.2)" }}>Title</Button>
      </Stack>
    </Box>
  </Box>
</Box>
