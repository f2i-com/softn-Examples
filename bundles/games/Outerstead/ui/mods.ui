<div className="os-modal-head"><div><span className="os-label">COMMUNITY / MOD API 1</span><div className="os-modal-title">Make this frontier yours.</div></div><button className="os-btn os-icon-btn" title="Close menu" @click={closeDialog}>×</button></div>
<span className="os-prose">Install a ZIP, review what it can change, then enable it for this colony. Mods run while you play. Disabling stops future changes; supplies, memories and events already created remain.</span>
#if (!modAvailable)
  <div className="os-card">This Softn host needs the sandbox and ZIP-text runtime extension supplied with Outerstead 0.15. The base game remains playable.</div>
#end
<div className="os-row" style={{ margin: "14px 0", flexWrap: "wrap" }}><button className="os-btn os-primary" disabled={!modAvailable || modImportBusy} @click={importModZip}>{modImportBusy ? "Reading ZIP…" : "Install mod ZIP"}</button><button className="os-btn" disabled={!modAvailable} @click={stageCampfireMod}>Try Campfire Stories</button></div>
<div className="os-card"><span className="os-prose">{modStatus}</span></div>
#if (modPreview)
  <div className="os-card" style={{ marginTop: "12px" }}><div className="os-section-title">{modPreview.name} · {modPreview.version}</div><span className="os-small os-dim">{modPreview.author}</span><p className="os-prose">{modPreview.description}</p><p className="os-small">Changes: {modPreview.capabilities}</p><span className="os-small os-dim">Runs in its own ZIPP sandbox, without access to your files, network, or other mods. Installed code is stored in this browser; saves contain only its identity and private data.</span><div className="os-row" style={{ marginTop: "12px", flexWrap: "wrap" }}><button className="os-btn os-primary" @click={installPendingMod}>Install disabled</button><button className="os-btn" @click={cancelModImport}>Cancel</button></div></div>
#end
#if (modCards.length === 0)
  <p className="os-prose">No mods installed. Campfire Stories adds a daily shared meal and conversation, using wood and meals to improve recreation and morale.</p>
#end
#each (m in modCards) key={m.id}
  <div className="os-card" style={{ marginTop: "12px" }}><div className="os-section-title">{m.name} · {m.version}</div><span className="os-small os-dim">{m.author}</span><p className="os-prose">{m.description}</p><div className="os-small">{m.status}</div><div className="os-tiny os-dim" style={{ marginTop: "6px" }}>Changes: {m.capabilities}</div><div className="os-row" style={{ marginTop: "12px", flexWrap: "wrap" }}>
    #if (m.available)
      <button className="os-btn" disabled={!modAvailable || !m.canEnable} oson={String(m.enabled)} @click={() => toggleColonyMod(m.id)}>{m.enabled ? "Disable" : "Enable for colony"}</button><button className="os-btn" @click={() => uninstallMod(m.id)}>Uninstall</button>
    #end
    #if (m.linked || !m.available)
      <button className="os-btn" @click={() => removeModLink(m.id)}>Remove saved link</button>
    #end
  </div></div>
#end
<p className="os-tiny os-dim">API 1 · up to 8 installed mods · 256 KiB ZIP limit · text and JavaScript files · mod scripts run at most once every 20 simulation seconds. Use Save → Export before experimenting with a colony you want to keep.</p>
