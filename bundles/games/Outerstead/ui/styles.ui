.os-wall .os-sprite{height:48px;transform:translateY(-16px)}

/* Actor motion stays on child transforms; world movement and name labels stay stable. */
.os-colonist-rest-frame,.os-colonist-body{width:32px;height:40px;transform-origin:50% 75%}
.os-actor[oschild="true"] .os-colonist-rest-frame{transform:scale(.72);transform-origin:50% 100%}.os-actor[osgroundsleep="true"] .os-colonist-rest-frame{transform:rotate(72deg) scale(.85);transform-origin:center}
.os-pose-sleep{animation:os-breathe 3.2s ease-in-out infinite}
.os-pose-walk{animation:os-step .34s ease-in-out infinite alternate}
.os-pose-work-heavy{animation:os-work-swing .8s ease-in-out infinite}
.os-actor[osleft="true"] .os-pose-work-heavy{animation-name:os-work-swing-left}
.os-pose-work-light{animation:os-work-nod 1.25s ease-in-out infinite}
.os-pose-eat{animation:os-eating 1.8s ease-in-out infinite}
.os-actor:nth-of-type(2n) .os-colonist-body{animation-delay:-.35s}
.os-actor:nth-of-type(3n) .os-colonist-body{animation-delay:-.7s}
.os-sleep-sign{position:absolute;left:25px;top:0;color:#d2e7dc;font:700 10px Georgia,serif;text-shadow:0 1px 2px #10242a;pointer-events:none}
.os-sleep-sign span{position:absolute;left:0;top:0;opacity:.75;animation:os-sleep-rise 3.2s ease-out infinite}
.os-sleep-sign span+span{left:5px;top:-6px;font-size:12px;animation-delay:-1.6s}
.os-actor[ospose="walk"] .os-carry{animation:os-carry-step .34s ease-in-out infinite alternate}
.os-work-dot{animation:os-work-pulse 1.1s ease-in-out infinite}
.os-actor[osanimate="false"] .os-colonist-body,.os-actor[osanimate="false"] .os-sleep-sign span,.os-actor[osanimate="false"] .os-carry,.os-actor[osanimate="false"] .os-work-dot{animation-play-state:paused}
.os-reduced .os-colonist-body,.os-reduced .os-sleep-sign span,.os-reduced .os-carry,.os-reduced .os-work-dot{animation:none!important}
@keyframes os-breathe{0%,100%{transform:scaleY(1)}50%{transform:translateY(-.6px) scaleY(1.025)}}
@keyframes os-step{from{transform:translateY(0)}to{transform:translateY(-.65px)}}
@keyframes os-work-swing{0%,100%{transform:rotate(-3deg)}45%{transform:translateY(1px) rotate(5deg)}65%{transform:rotate(1deg)}}
@keyframes os-work-swing-left{0%,100%{transform:rotate(3deg)}45%{transform:translateY(1px) rotate(-5deg)}65%{transform:rotate(-1deg)}}
@keyframes os-work-nod{0%,100%{transform:translateY(0)}45%{transform:translateY(1px) rotate(1.5deg)}}
@keyframes os-eating{0%,70%,100%{transform:rotate(0)}30%{transform:translateY(1px) rotate(-3deg)}}
@keyframes os-sleep-rise{0%{opacity:0;transform:translate(0,2px) scale(.7)}20%{opacity:.85}85%{opacity:0;transform:translate(7px,-15px) scale(1.15)}100%{opacity:0;transform:translate(7px,-15px) scale(1.15)}}
@keyframes os-carry-step{from{transform:translateY(0)}to{transform:translateY(-1px) rotate(3deg)}}
@keyframes os-work-pulse{0%,100%{opacity:.45}50%{opacity:1}}

.os-ground-weapon{background:#1a3030ce;border:1px solid #d6bb73;border-radius:5px;box-shadow:0 0 0 2px #11292d88}
.os-held-weapon{position:absolute;left:12px;top:10px;width:30px;height:30px;transform-origin:4px 50%;pointer-events:none;z-index:2}
.os-pose-attack{animation:os-combat-recoil .35s ease-out both}
.os-actor[osleft="true"] .os-pose-attack{animation-name:os-combat-recoil-left}
.os-pose-equip{animation:os-equip .55s ease-out both}
.os-pose-hurt{animation:os-hit .3s ease-out both}
@keyframes os-hit{0%,100%{filter:none}40%{filter:brightness(1.7) sepia(.5);transform:translateY(1px)}}
.os-predator-strike{animation:os-predator-strike .4s ease-out both}
@keyframes os-combat-recoil{0%,100%{transform:translateX(0)}25%{transform:translateX(-2px) rotate(-4deg)}}
@keyframes os-combat-recoil-left{0%,100%{transform:translateX(0)}25%{transform:translateX(2px) rotate(4deg)}}
@keyframes os-equip{0%,100%{transform:translateY(0)}40%{transform:translateY(3px) rotate(5deg)}}
@keyframes os-predator-strike{0%,100%{transform:translateY(0)}35%{transform:translateY(3px) scaleY(1.08)}}
.os-weapon-range{position:absolute;border:1px dashed #e1c28277;border-radius:50%;background:#e1c28205;pointer-events:none;box-sizing:border-box}
.os-pose-play{animation:os-work-nod 1.8s ease-in-out infinite}
.os-pose-chat{animation:os-chat 2.8s ease-in-out infinite}
.os-pose-relax{animation:os-breathe 4s ease-in-out infinite}
@keyframes os-chat{0%,65%,100%{transform:rotate(0)}25%{transform:rotate(3deg)}40%{transform:rotate(-2deg)}}
