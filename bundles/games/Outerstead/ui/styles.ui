.os-header{display:flex;align-items:center;gap:18px;justify-content:space-between;padding:12px 16px 10px;border-bottom:1px solid #3c4a4c;background:linear-gradient(180deg,#1b2a30,#14232a);flex-shrink:0;z-index:20;min-height:70px}.os-brand{display:flex;align-items:center;gap:10px;min-width:177px}.os-brand-icon{width:36px;height:36px;object-fit:contain}.os-brand-name{font-size:16px;letter-spacing:3.5px;color:#e6d7b6;font-weight:500}.os-brand-meta{font-size:9px;letter-spacing:2px;color:#94acae;margin-top:2px}.os-resources{display:flex;align-items:center;gap:17px;flex:1;justify-content:center}.os-resource{min-width:37px;display:flex;flex-direction:column;align-items:center;gap:2px;font-variant-numeric:tabular-nums}.os-resource-top{display:flex;align-items:center;gap:6px;font-size:16px;color:#e7decb}.os-resource-icon{color:#c9b477;font-size:17px}.os-resource-label{font-size:8px;text-transform:uppercase;letter-spacing:1.2px;color:#91a6a6}.os-time-controls{display:flex;flex-direction:column;align-items:flex-end;gap:5px}.os-clock{font-size:11px;letter-spacing:.5px;color:#c7d0c7;font-variant-numeric:tabular-nums}.os-time-button{padding:3px 7px!important;min-height:24px!important;font-size:10px!important}
.os-body{flex:1;display:flex;min-height:0;position:relative}.os-roster{width:181px;flex-shrink:0;background:linear-gradient(180deg,#15242b,#101e25);border-right:1px solid #33484a;padding:14px 10px;overflow-y:auto;display:flex;flex-direction:column;gap:10px;z-index:14}.os-colonist{padding:10px 8px;border:1px solid #33494b;background:#1a2d33;border-radius:6px;cursor:pointer;transition:border-color .15s}.os-colonist:hover,.os-colonist[oson="true"]{border-color:#acbc9b;background:#22353a}.os-avatar{width:32px;height:42px;object-fit:contain;filter:drop-shadow(0 3px 3px #0008)}.os-colonist-name{font-size:14px;font-weight:550;letter-spacing:.3px}.os-colonist-role{font-size:9px;color:#91a8a6}.os-colonist-action{margin-top:7px;min-height:29px;line-height:1.35;font-size:10px;color:#b4c4bd}.os-mini-bars{display:grid;grid-template-columns:1fr 1fr 1fr;gap:4px;margin-top:6px}.os-bar{height:5px;background:#08191f;border-radius:5px;overflow:hidden;flex:1}.os-bar-fill{height:100%;border-radius:4px;background:#a9c4ac}.os-roster-note{margin-top:auto;border-top:1px solid #314449;padding-top:12px;font-size:10px;line-height:1.65;color:#7f999d}.os-roster-note b{color:#b5c5bd;font-weight:500}
.os-viewport{position:relative;flex:1;min-width:0;min-height:0;overflow:hidden;background:#111e26;touch-action:none}.os-tilemap{display:block!important;image-rendering:pixelated}.os-world{position:absolute;touch-action:none}.os-world[osbiome="sepia(.28) hue-rotate(-14deg) saturate(1.08)"] .os-tilemap{filter:sepia(.28) hue-rotate(-14deg) saturate(1.08)}.os-world[osbiome="hue-rotate(10deg) saturate(1.15)"] .os-tilemap{filter:hue-rotate(10deg) saturate(1.15)}.os-sprite{width:100%;height:100%;object-fit:fill;pointer-events:none;image-rendering:auto}.os-grid{position:absolute;inset:0;z-index:11;pointer-events:none;background-image:linear-gradient(#d5e3bf22 1px,transparent 1px),linear-gradient(90deg,#d5e3bf22 1px,transparent 1px);background-size:32px 32px}.os-night{position:absolute;inset:0;background:#071522;z-index:3;pointer-events:none}.os-actor-label{position:absolute;top:36px;left:50%;transform:translateX(-50%);white-space:nowrap;padding:1px 4px;border-radius:3px;background:#0c1c21dc;font-size:8px;line-height:1.3;letter-spacing:.2px;pointer-events:none}.os-actor[osselected="true"]::after{content:"";position:absolute;left:0;right:0;top:6px;bottom:0;border:1.5px solid #dce3bf;border-radius:10px}.os-actor[osdrafted="true"]::before{content:"◆";position:absolute;right:-4px;top:-3px;color:#e1b470;font-size:11px}.os-carry{position:absolute;width:11px;height:9px;background:linear-gradient(#c8a86c,#a88a52);border:1px solid #5e4a2a;left:19px;top:25px;box-shadow:1px 1px #151c21,inset 0 1px #e2c98f;z-index:3}.os-actor[osleft="true"] .os-carry{left:auto;right:19px}.os-actor[osseated="true"] .os-carry,.os-actor[ospose="sleep"] .os-carry{display:none}.os-work-dot{position:absolute;left:0;top:5px;width:4px;height:4px;border-radius:50%;background:#e5d79e}.os-blueprint{border:1px dashed #a2ded5;background:#80cfcc30}.os-map-progress{position:absolute;left:5px;right:5px;bottom:3px;height:3px;background:#13252bbf;overflow:hidden}.os-map-progress i{display:block;height:100%;background:#cb