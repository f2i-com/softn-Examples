.os-inspector{width:304px;flex-shrink:0;border-left:1px solid #374b4d;background:linear-gradient(160deg,#1a2a31,#102129);display:flex;flex-direction:column;z-index:15;min-height:0}.os-inspector-head{padding:14px 15px 10px;border-bottom:1px solid #33474a;display:flex;align-items:center;justify-content:space-between;gap:10px}.os-inspector-content{padding:14px;overflow:auto;flex:1;min-height:0}.os-card{background:#13262dc9;border:1px solid #35494b;border-radius:5px;padding:11px}.os-goal{display:flex;align-items:flex-start;gap:8px;padding:9px 0;border-bottom:1px solid #2c4248}.os-goal-icon{font-size:17px;line-height:1.3;color:#b49d69}.os-goal[osdone="true"] .os-goal-icon{color:#a8c998}.os-goal-title{font-size:11px;color:#d3d7c8}.os-chapter-title{font-size:13px;color:#e8dcc0;margin-top:6px;letter-spacing:.02em}.os-goal-detail{font-size:10px;color:#8fa7a7;line-height:1.5;margin-top:3px}.os-alert{border-left:2px solid #8aada8;padding:8px 9px;background:#172b32;border-radius:0 4px 4px 0}.os-alert[ostype="warning"]{border-color:#d2b177}.os-alert[ostype="danger"]{border-color:#d28671}.os-alert-title{font-size:11px;color:#d9dbcc;margin-bottom:3px}.os-alert-body{font-size:10px;color:#9eb0ab;line-height:1.5}.os-research-shortcut{border:1px solid #506869;background:linear-gradient(130deg,#1f3b42,#162b32);border-radius:5px;padding:11px;cursor:pointer}.os-catalogue{display:flex;flex-direction:column;gap:7px}.os-catalogue-item{display:flex;gap:10px;border:1px solid #395055;border-radius:5px;padding:10px;background:#162930;cursor:pointer;position:relative}.os-catalogue-item:hover,.os-catalogue-item[oson="true"]{border-color:#b4be98;background:#25383a}.os-catalogue-item[oslocked="true"]{opacity:.5}.os-item-icon{width:42px;height:42px;object-fit:contain;flex-shrink:0;filter:drop-shadow(1px 2px 3px #07171d)}.os-item-name{font-size:11px;font-weight:600;color:#dbe0d1;line-height:1.35}.os-item-cost{font-size:9px;color:#b6a77f;margin-top:4px}.os-item-desc{font-size:10px;color:#8fa8a7;line-height:1.45;margin-top:4px}.os-category-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;margin:10px 0 12px}.os-category-grid button{font-size:9px!important;padding:5px 3px!important;min-height:26px!important}.os-portrait{width:60px;height:74px;object-fit:contain;image-rendering:auto;filter:drop-shadow(1px 4px 4px #081a21)}.os-selected-title{font-size:21px;font-weight:500;line-height:1.15;color:#e7dec8;letter-spacing:-.3px}.os-need-row{display:flex;align-items:center;gap:8px;font-size:10px;color:#b6c5bd}.os-need-label{min-width:61px}.os-need-value{font:10px ui-monospace,monospace;min-width:24px;text-align:right}.os-detail{display:flex;justify-content:space-between;gap:12px;font-size:11px;padding:6px 0;border-bottom:1px solid #2b4249}.os-detail b{font-weight:500;color:#d7d9c9;text-align:right}.os-thought{display:flex;justify-content:space-between;gap:8px;font-size:11px;padding:7px 0;border-bottom:1px solid #294149}.os-thought[ospositive="true"] b{color:#accc9a}.os-thought[ospositive="false"] b{color:#dba086}.os-injury{border-left:2px solid #bc8a75;background:#3f302c;padding:6px 8px;font-size:10px;color:#e2b4a1}.os-research-card{border:1px solid #35535a;border-radius:5px;padding:11px;background:#142930}.os-research-card[osactive="true"]{border-color:#c9b783;background:#263938}.os-research-card[osdone="true"]{opacity:.65}.os-research-name{font-size:12px;color:#d8dbc9;font-weight:550}.os-tech-progress{height:3px;background:#0b2027;margin:9px 0}.os-tech-progress i{display:block;background:#b7c598;height:100%}.os-journal-entry{position:relative;border-left:1px solid #436264;margin-left:3px;padding:0 0 19px 14px}.os-journal-entry::before{content:"";position:absolute;left:-4px;top:3px;width:7px;height:7px;border-radius:50%;background:#a2baaa}.os-journal-entry[oskind="hollow"]::before{background:#86d4d4;box-shadow:0 0 8px #78d6d466}.os-journal-date{font-size:9px;letter-spacing:1.4px;color:#8aa5a9;margin-bottom:4px}.os-journal-title{font-size:12px;color:#dcdac7;margin-bottom:4px}.os-journal-body{font-size:10px;line-height:1.65;color:#9eb2ad;white-space:pre-line}
.os-toolbar{min-height:65px;flex-shrink:0;display:flex;justify-content:center;align-items:center;gap:6px;padding:9px 14px;border-top:1px solid #45564e;background:linear-gradient(180deg,#1c2e34,#15262d);z-index:20}.os-tool{display:flex;align-items:center;gap:7px;min-width:100px;justify-content:center!important;padding:10px 11px!important;border-color:transparent!important;background:transparent!important;font-size:10px!important;letter-spacing:.6px}.os-tool span{font-size:16px;color:#c2cbb3}.os-tool[oson="true"]{border-color:#777b5d!important;background:#34433b!important;color:#ede1b7!important}.os-toolbar-divider{width:1px;height:25px;background:#40504d;margin:0 3px}.os-status{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:5px 15px;min-height:27px;flex-shrink:0;background:#0e1b22;font-size:10px;color:#8ea7a4;border-top:1px solid #243a40}.os-toast{position:absolute;bottom:107px;left:50%;transform:translateX(-50%);width:max-content;max-width:75%;padding:11px 17px;background:#eee2bf;color:#17282c;border:1px solid #c0b28c;border-radius:5px;box-shadow:0 8px 25px #0005;font-size:12px;z-index:50;pointer-events:none;text-align:center}
.os-modal-wrap{position:absolute;inset:0;z-index:60;display:flex;align-items:center;justify-content:center;background:#051218ba;backdrop-filter:blur(5px);padding:24px}.os-modal{position:relative;width:min(590px,100%);max-height:100%;overflow:auto;background:linear-gradient(135deg,#203039,#13252d);border:1px solid #728074;border-radius:9px;box-shadow:0 25px 95px #0009;padding:27px}.os-modal.os-modal-wide{width:min(920px,100%)}.os-modal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;gap:10px}.os-modal-title{font-size:27px;font-weight:450;color:#e8dec0;line-height:1.2;letter-spacing:-.6px}.os-modal-body{font-size:13px;line-height:1.85;white-space:pre-line;color:#b8c9c3}.os-modal-art{width:100%;height:160px;object-fit:cover;object-position:50% 58%;border-radius:4px;margin:14px 0;opacity:.85}.os-modal-choice{display:block!important;width:100%;text-align:left!important;margin-top:10px;padding:13px!important}.os-choice-detail{display:block;font-size:10px;color:#a5b8af;margin-top:4px;font-weight:400}.os-modal-choice.os-primary .os-choice-detail{color:#3a4e48}.os-modal-footer{display:flex;gap:8px;justify-content:flex-end;margin-top:22px;flex-wrap:wrap}.os-save-slot{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px;background:#122830;border:1px solid #395258;border-radius:4px}.os-save-field{font:11px ui-monospace,monospace!important;width:100%;min-height:150px;height:180px;resize:vertical;background:#091d26!important;color:#b9d5cb!important;padding:10px!important;border:1px solid #46636a!important;user-select:text!important;line-height:1.5!important}.os-help-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.os-help-heading{font-size:14px;color:#e0c996;margin-bottom:7px}.os-work-table{min-width:690px;width:100%;border-collapse:collapse;font-size:11px}.os-work-table th{font-size:9px;font-weight:500;letter-spacing:.6px;color:#9db6b6;border-bottom:1px solid #527071;padding:8px 5px;text-align:center}.os-work-table td{padding:8px 4px;border-bottom:1px solid #345057;text-align:center}.os-work-table td:first-child{text-align:left;color:#e2d4b4;min-width:80px}.os-priority{padding:4px 6px!important;min-height:24px!important;min-width:26px!important;font-size:10px!important}.os-priority[ospriority="1"]{color:#d1dfa5!important;border-color:#7b9475!important;background:#355145!important}.os-priority[ospriority="0"]{opacity:.35}.os-art-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.os-art-grid img{width:100%;height:auto;border-radius:5px;border:1px solid #46575a}.os-art-grid .os-art-logo{background:#b2bfbd;padding:15px}
@media(max-width:1250px){.os-resources{gap:11px}.os-header{gap:10px;padding:9px 12px}.os-brand-name{font-size:14px;letter-spacing:2.5px}.os-brand{min-width:156px}.os-inspector{width:282px}.os-roster{width:164px}.os-tool{min-width:83px;padding:9px 7px!important}.os-resource-label{font-size:7px}.os-resource-top{font-size:14px}}
