@media(max-width:380px){.os-brand>div{display:none}.os-resources{gap:10px}.os-resource-label{font-size:7px}.os-root .os-tool{font-size:9px!important}.os-title-pane{padding:18px}.os-title-actions .os-row{flex-wrap:wrap}.os-title-actions .os-tab{flex-basis:100%}.os-inspector-head{gap:4px}.os-inspector-head .os-label{font-size:9px;letter-spacing:.8px}}
@media(max-height:560px) and (max-width:1100px){
 .os-root .os-header{display:grid;grid-template-columns:minmax(0,1fr) auto;min-height:0;padding:3px 8px;gap:2px 8px}.os-brand{display:flex;min-width:0}.os-resources{grid-column:1 / -1;display:flex;overflow-x:auto;gap:10px;padding:2px 0;justify-content:space-between}.os-time-controls{display:flex;flex-direction:row;justify-content:flex-end;align-items:center;gap:4px;min-width:0}.os-time-button{min-width:44px}.os-clock{white-space:nowrap;font-size:10px}.os-body{display:grid;grid-template-rows:48px minmax(0,1fr);grid-template-columns:minmax(0,1fr)}.os-roster{display:flex;height:48px;width:100%;flex-direction:row;overflow-x:auto;padding:2px 6px}.os-roster>.os-between,.os-roster>.os-btn,.os-roster>.os-row,.os-roster-note{display:none}.os-colonist{min-width:105px;flex:1;padding:3px}.os-colonist-action,.os-colonist .os-mini-bars,.os-colonist .os-tiny{display:none}.os-colonist .os-avatar{height:28px;width:22px}.os-viewport{grid-row:2}.os-root .os-inspector{display:none;top:0;bottom:0;left:auto;right:0;width:min(350px,58%);height:100%;border-radius:10px 0 0 10px}.os-root[ospanelopen="true"] .os-inspector{display:flex}.os-mobile-close{display:inline-flex!important}.os-toolbar{display:flex;flex-wrap:nowrap;overflow-x:auto;min-height:52px;padding:4px;gap:4px}.os-root .os-tool{flex:0 0 auto;min-width:74px}.os-toolbar-divider,.os-status,.os-edge,.os-map-coordinate{display:none}.os-map-zoom{flex-direction:row;top:8px;bottom:auto;right:8px}.os-map-zoom .os-btn{min-width:44px;width:44px}.os-map-hint{max-width:calc(100% - 215px)}.os-pause-pill{bottom:10px;left:50%}.os-touch-actions{bottom:8px;left:8px}.os-toast{bottom:65px}.os-title{display:flex;flex-direction:row;overflow:auto}.os-title-showcase{width:38%;flex-shrink:0}.os-title-pane{width:62%;max-width:none;flex:none;min-height:0;padding:20px}.os-title-tagline{font-size:24px}
}
@media(pointer:coarse){.os-root .os-btn{min-height:44px!important}.os-root .os-field{font-size:16px!important}.os-toolbar,.os-roster{scrollbar-width:thin}.os-touch-actions{user-select:none}}
.os-catalogue-item{width:100%;text-align:left;font:inherit;color:inherit;cursor:pointer}.os-catalogue-item:focus-visible{outline:2px solid #e2cc92;outline-offset:2px}
@media(max-width:600px){.os-save-slot{flex-wrap:wrap}.os-save-slot>.os-row{margin-left:auto}.os-help-grid .os-detail{flex-wrap:wrap;gap:6px}}

/* Lightweight atmospheric layers: no per-particle simulation or UI updates. */
.os-event-options{flex-wrap:wrap;gap:6px}.os-event-options .os-btn{flex:1;min-width:70px}
.os-title-clouds,.os-title-aurora,.os-title-embers,.os-title-smoke{position:absolute;pointer-events:none;z-index:5}
.os-title-clouds{inset:-15%;background:radial-gradient(ellipse at 25% 40%,#b1c7b420,transparent 45%),radial-gradient(ellipse at 75% 75%,#b1c7b419,transparent 40%);animation:os-cloud-drift 18s ease-in-out infinite alternate}
.os-title-aurora{inset:0;background:linear-gradient(125deg,transparent 15%,#6fe1bf30 35%,transparent 50%,#91a6fa22 65%,transparent 80%);animation:os-aurora 8s ease-in-out infinite alternate}
.os-title-smoke{left:536px;top:74px;width:30px;height:70px}.os-title-smoke i{position:absolute;bottom:0;width:14px;height:20px;border-radius:50%;background:#c4d3ce42;animation:os-smoke 5s linear infinite}.os-title-smoke i:nth-child(2){animation-delay:-1.7s}.os-title-smoke i:nth-child(3){animation-delay:-3.4s}
.os-title-embers{left:320px;top:320px;width:140px;height:100px}.os-title-embers i{position:absolute;left:20%;bottom:0;width:3px;height:3px;background:#edc58d;border-radius:50%;animation:os-ember 6s linear infinite}.os-title-embers i:nth-child(2){left:65%;animation-delay:-2s}.os-title-embers i:nth-child(3){left:90%;animation-delay:-4s}
@keyframes os-cloud-drift{to{transform:translate(65px,-30px)}}@keyframes os-aurora{from{opacity:.3;transform:translateX(-20px)}to{opacity:1;transform:translateX(20px)}}@keyframes os-smoke{from{transform:translate(0,0) scale(.6);opacity:0}20%{opacity:.7}to{transform:translate(25px,-70px) scale(2);opacity:0}}@keyframes os-ember{from{transform:translateY(0);opacity:0}25%{opacity:.8}to{transform:translate(-20px,-95px);opacity:0}}
.os-weather{overflow:hidden}.os-weather.storm,.os-weather.echo{opacity:.24;background:repeating-linear-gradient(110deg,transparent 0 22px,#b8dbea50 23px 24px,transparent 25px 42px)}.os-weather.storm i:first-child,.os-weather.echo i:first-child{position:absolute;inset:-40px;background:inherit;animation:os-rainfall .8s linear infinite}.os-weather.storm i:last-child{position:absolute;inset:0;background:#b5cee2;animation:os-storm-light 9s ease-in-out infinite}.os-weather.echo{background-color:#68cfb21a}
.os-weather.snow{opacity:.55;background:radial-gradient(circle,#e0eff0b0 1px,transparent 2px);background-size:45px 39px}.os-weather.snow i{position:absolute;inset:-50px;background:inherit;animation:os-snowfall 7s linear infinite}.os-weather.heat{opacity:.3;background:linear-gradient(0deg,#eeb26a45,transparent 80%);animation:os-heat 7s ease-in-out infinite alternate}.os-weather.glass{opacity:.3;background:repeating-linear-gradient(165deg,transparent 0 60px,#99d8ca55 61px,transparent 63px 100px)}.os-weather.glass i{position:absolute;inset:-100px;background:inherit;animation:os-glasswind 2s linear infinite}
.os-caption{position:absolute;left:12px;right:12px;bottom:46px;z-index:20;background:#0f2128ee;border:1px solid #4d6b6a;border-radius:8px;padding:9px 13px;max-height:46%;display:flex;flex-direction:column;gap:6px;backdrop-filter:blur(4px);box-shadow:0 6px 24px #05121880}.os-caption-head{display:flex;align-items:center;gap:10px}.os-caption-title{flex:1;font-size:13px;color:#e8dcc0}.os-caption-body{font-size:11.5px;line-height:1.55;color:#d3d7c8;white-space:pre-line;overflow:auto;max-height:118px}.os-caption-choices{display:flex;flex-wrap:wrap;gap:6px}.os-caption-choice{text-align:left;padding:5px 9px;max-width:270px}.os-caption-choice span{display:block;font-size:9.5px;color:#8fa7a7;margin-top:2px;line-height:1.35}.os-caption-foot{display:flex;align-items:center;gap:10px}.os-caption-timer{flex:1;height:3px;background:#2c4248;border-radius:2px;overflow:hidden}.os-caption-timer div{height:100%;background:#c5ad77;transition:width .2s linear}@media(max-width:820px){.os-caption{left:6px;right:6px;bottom:58px;max-height:52%}.os-caption-body{max-height:80px}}
.os-weather-notice{position:absolute;top:12px;left:50%;transform:translateX(-50%);z-index:15;padding:6px 12px;border:1px solid #bbcebc55;border-radius:20px;background:#12262de6;color:#e0e9d8;font-size:11px;pointer-events:none;max-width:65%;text-align:center}.os-root[osplaying="false"] .os-weather-notice{top:50px}
.os-incident{position:absolute;width:96px;height:96px;z-index:9;pointer-events:none}.os-incident i{position:absolute;inset:15px;border:2px solid #b8e9e4;border-radius:50%;animation:os-incident-ring 2.4s ease-out infinite}.os-incident i:nth-child(2){animation-delay:-.8s}.os-incident i:nth-child(3){animation-delay:-1.6s}.os-incident.impact i{border-color:#e5c98c}
@keyframes os-rainfall{to{transform:translate(-15px,40px)}}@keyframes os-storm-light{0%,55%,100%{opacity:0}65%{opacity:.22}80%{opacity:.04}}@keyframes os-snowfall{to{transform:translate(45px,39px)}}@keyframes os-heat{to{opacity:.12}}@keyframes os-glasswind{to{transform:translate(100px,-27px)}}@keyframes os-incident-ring{from{transform:scale(.25);opacity:.8}to{transform:scale(1.3);opacity:0}}
.os-root[osplaying="false"] .os-weather,.os-root[osplaying="false"] .os-weather i,.os-root[osplaying="false"] .os-incident i{animation-play-state:paused!important}
.os-reduced .os-title-clouds,.os-reduced .os-title-aurora,.os-reduced .os-title-smoke i,.os-reduced .os-title-embers i,.os-reduced .os-weather,.os-reduced .os-weather i,.os-reduced .os-incident i{animation:none!important}
@media(prefers-reduced-motion:reduce){.os-root:not([osmotion="on"]) :is(.os-title-clouds,.os-title-aurora,.os-title-smoke i,.os-title-embers i,.os-weather,.os-weather i,.os-incident i){animation:none!important}}


.os-title-signal{position:absolute;left:511px;top:443px;width:42px;height:42px;z-index:5;pointer-events:none}.os-title-signal i{position:absolute;inset:0;border:2px solid #98dcc7;border-radius:50%;animation:os-title-broadcast 3s ease-out infinite}.os-title-signal i:nth-child(2){animation-delay:-1.5s}
@keyframes os-title-broadcast{from{transform:scale(.25);opacity:.8}to{transform:scale(2);opacity:0}}
.os-scene-glow{animation:os-lamplight 5s ease-in-out infinite alternate}@keyframes os-lamplight{from{opacity:.65}to{opacity:1}}
.os-reduced .os-title-signal i,.os-reduced .os-scene-glow{animation:none!important}.os-reduced .os-title-signal{opacity:.3}

.os-actor[osseated="true"] .os-colonist-body{transform-origin:50% 70%}.os-actor[osseated="true"] .os-actor-label{top:37px;font-size:7px}.os-seat-mark{position:absolute;left:11px;top:32px;width:10px;height:2px;background:#8bb9a6;border-radius:2px;pointer-events:none}
.os-meal-bowl{position:absolute;right:0;top:23px;width:8px;height:5px;border-radius:1px 1px 5px 5px;background:#d6dbb7;border-top:2px solid #bf9766;pointer-events:none}.os-actor[osleft="true"] .os-meal-bowl{right:auto;left:0}

.os-scene-mina{--os-route-time:14s;--os-route-delay:-4s}.os-scene-jin{--os-route-time:17s;--os-route-delay:-8s}.os-scene-mara{--os-route-time:16s;--os-route-delay:-2s}.os-scene-sol{--os-route-time:19s;--os-route-delay:-6s}
.os-title-facing,.os-title-step{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.os-title-outbound{animation:os-title-forward var(--os-route-time) linear var(--os-route-delay) infinite}.os-title-inbound{opacity:0;animation:os-title-back var(--os-route-time) linear var(--os-route-delay) infinite}
.os-title-step-1{animation:os-title-step .36s steps(1,end) infinite}.os-title-step-2{opacity:0;animation:os-title-step .36s steps(1,end) -.18s infinite}
@keyframes os-title-forward{0%,49.999%{opacity:1}50%,100%{opacity:0}}@keyframes os-title-back{0%,49.999%{opacity:0}50%,100%{opacity:1}}@keyframes os-title-step{0%,49.999%{opacity:1}50%,100%{opacity:0}}
.os-reduced .os-title-facing,.os-reduced .os-title-step{animation:none!important}

.os-opening{position:absolute;inset:0;overflow:auto;background:#07121e;isolation:isolate;text-align:center}.os-opening-stars{position:absolute;inset:0;background:radial-gradient(circle,#e0e3c9 1px,transparent 1.7px) 0 0/97px 83px,radial-gradient(circle,#88b8ba90 1px,transparent 2px) 25px 30px/157px 139px;opacity:.4;animation:os-opening-sky 40s linear infinite;z-index:-2}.os-opening-horizon{position:absolute;inset:25% -20% -40%;border-radius:50%;background:radial-gradient(ellipse at 50% 0%,#428a8344,#112b38aa 45%,transparent 65%);z-index:-1;pointer-events:none}.os-opening-content{position:relative;max-width:920px;min-height:100%;margin:auto;padding:24px 22px 18px;box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center}.os-opening-logo{width:170px;height:90px;object-fit:contain;animation:os-opening-logo 3s ease-out both}.os-opening h1{font:normal clamp(24px,3.5vw,38px)/1.15 Georgia,serif;color:#e8ddb9;max-width:720px;margin:8px 0 10px}.os-opening-line{color:#b1c9c6;max-width:580px;min-height:40px;font-size:14px;line-height:1.6;margin:0 0 16px}.os-opening-window{position:relative;flex-shrink:0;width:min(100%,740px);height:300px;overflow:hidden;border:1px solid #b1d4c735;border-radius:90px 90px 12px 12px;box-shadow:0 0 80px #50958420;transition:opacity 2s,filter 2s;opacity:.6;filter:brightness(.65)}.os-opening-window .os-title-scene{transform:translate(-50%,-50%) scale(.85)}.os-opening[osstage="2"] .os-opening-window,.os-opening[osstage="3"] .os-opening-window{opacity:1;filter:brightness(1)}.os-opening-shade{position:absolute;inset:0;background:linear-gradient(#07121e30,transparent 50%,#07121eaa);pointer-events:none}.os-opening-actions{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:20px}.os-opening-actions .os-btn{min-height:44px!important;padding:10px 16px!important}.os-opening-credit{font-size:10px;color:#92aca7;letter-spacing:1px;margin:13px 0 0}
@keyframes os-opening-sky{to{background-position:97px 83px,182px 169px}}@keyframes os-opening-logo{from{opacity:0;transform:translateY(12px) scale(.94)}to{opacity:1;transform:translateY(0) scale(1)}}
.os-reduced .os-opening-stars,.os-reduced .os-opening-logo{animation:none!important}.os-reduced .os-opening-window{transition:none}
@media(max-width:600px){.os-opening-content{padding:20px 16px}.os-opening-logo{height:70px;width:140px}.os-opening-window{height:230px;border-radius:65px 65px 10px 10px}.os-opening-window .os-title-scene{transform:translate(-50%,-50%) scale(.57)}.os-opening-line{font-size:13px}.os-opening-actions{gap:6px}.os-opening-actions .os-btn{font-size:11px!important}.os-opening h1{font-size:27px}}
@media(max-height:500px){.os-opening-content{justify-content:flex-start}.os-opening-window{height:180px}.os-opening-logo{height:55px}.os-opening-line{min-height:0}}

.os-opening{--os-intro-scale:.85;--os-intro-end:.95}.os-opening-logo{width:210px;height:105px;filter:drop-shadow(0 0 16px #a6dace44)}.os-opening[osstarted="true"] .os-title-scene{animation:os-opening-camera 14s ease-in-out both}
@keyframes os-opening-camera{from{transform:translate(-50%,-50%) scale(var(--os-intro-scale))}to{transform:translate(-52%,-48%) scale(var(--os-intro-end))}}
.os-reduced .os-opening .os-title-scene{animation:none!important}
@media(max-width:600px){.os-opening{--os-intro-scale:.57;--os-intro-end:.64}.os-opening-logo{width:160px;height:80px}}

.os-opening-brand{font:500 clamp(22px,4vw,38px)/1.2 system-ui,sans-serif;letter-spacing:.22em;color:#e3eddf;margin:0 0 16px;padding-left:.22em;animation:os-opening-logo 3s ease-out both}.os-reduced .os-opening-brand{animation:none!important}

/* Shared vector identity. Wordmark is outlined geometry, not a font or bitmap. */
.os-vector-logo{position:relative;width:100%;aspect-ratio:2;isolation:isolate}.os-vector-logo img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;pointer-events:none}.os-logo-base{animation:os-logo-arrive 1.1s ease-out both}.os-logo-orbit{animation:os-logo-draw 1.8s ease-out both}.os-logo-signal{animation:os-logo-beacon 3.2s ease-in-out infinite}
.os-opening-logo{width:min(380px,90vw);height:auto;aspect-ratio:2;filter:none;animation:none;margin:0 auto 8px}.os-title-logo{width:min(320px,100%);height:auto;aspect-ratio:2;filter:none;opacity:1;object-position:initial}
@keyframes os-logo-arrive{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}@keyframes os-logo-draw{from{clip-path:inset(0 100% 0 0);opacity:.35}to{clip-path:inset(0);opacity:1}}@keyframes os-logo-beacon{0%,100%{opacity:.55}50%{opacity:1}}
.os-reduced .os-vector-logo img{animation:none!important}
@media(max-width:600px){.os-opening-logo{width:min(310px,100%);height:auto}.os-title-logo{width:min(270px,100%);height:auto}}
@media(max-height:500px) and (min-width:601px){.os-opening-logo{width:240px;height:auto}}
@media(min-width:601px) and (min-height:501px) and (max-height:800px){.os-opening-logo{width:320px}.os-opening-window{height:260px}}

.os-opening-window{opacity:1;filter:none}.os-trailer-shot{position:absolute;inset:0;overflow:hidden;animation:os-trailer-cut .65s ease-out both}.os-trailer-map{position:absolute;left:50%;top:50%;width:768px;height:576px;transform:translate(-50%,-50%) scale(var(--os-intro-scale));animation:os-trailer-camera 6s linear both}.os-opening[osstarted="true"] .os-trailer-shot .os-title-scene{animation:os-trailer-camera 6s linear both}.os-trailer-map canvas{display:block!important}.os-trailer-building{position:absolute;object-fit:fill;filter:drop-shadow(2px 4px 2px #06162288)}.os-trailer-actor{position:absolute;width:32px;height:40px;z-index:4;transform-origin:50% 75%}.os-trailer-unload{animation:os-trailer-unload 4s linear both}.os-trailer-explore{animation:os-trailer-explore 6s linear both}.os-trailer-breathe{animation:os-trailer-breathe 2.5s ease-in-out infinite}.os-trailer-eat{animation:os-eating 1.8s ease-in-out infinite}.os-trailer-repair{animation:os-work-swing .9s ease-in-out infinite}.os-trailer-tool{position:absolute;right:-7px;top:15px;color:#f0d79a;font-size:14px}.os-trailer-landing-dust{position:absolute;left:285px;top:225px;width:110px;height:65px;border-radius:50%;border:3px solid #d6c69b66;animation:os-incident-ring 4s ease-out infinite;pointer-events:none}.os-trailer-surge,.os-trailer-hollow{position:absolute;width:96px;height:96px;pointer-events:none;z-index:5}.os-trailer-surge{left:304px;top:240px}.os-trailer-hollow{left:384px;top:224px}.os-trailer-surge i,.os-trailer-hollow i{position:absolute;inset:0;border:2px solid #abe7da;border-radius:50%;animation:os-incident-ring 2.8s ease-out infinite}.os-trailer-surge i:nth-child(2),.os-trailer-hollow i:nth-child(2){animation-delay:-1.4s}.os-trailer-rain{position:absolute;inset:-40px;z-index:6;pointer-events:none;opacity:.3;background:repeating-linear-gradient(110deg,transparent 0 22px,#b8dbea70 23px 24px,transparent 25px 42px);animation:os-rainfall .8s linear infinite}.os-trailer-storm-light{position:absolute;inset:0;background:#b2d5ed;opacity:.03;pointer-events:none;z-index:6;animation:os-storm-light 4s ease-in-out infinite}.os-trailer-shot-4{background:#06101e}.os-trailer-shot-4 .os-trailer-map{filter:brightness(.7)}.os-trailer-shot-5 .os-trailer-map{filter:brightness(.72) saturate(.8)}.os-trailer-mist{position:absolute;inset:-15%;pointer-events:none;background:radial-gradient(ellipse at 40% 65%,#83ccc43a,transparent 65%);animation:os-cloud-drift 9s ease-in-out infinite alternate;z-index:6}
.os-opening-actions{margin-top:12px}
@keyframes os-trailer-cut{from{opacity:0}to{opacity:1}}@keyframes os-trailer-camera{from{transform:translate(-50%,-50%) scale(var(--os-intro-scale))}to{transform:translate(-51%,-49%) scale(var(--os-intro-end))}}@keyframes os-trailer-unload{to{transform:translateX(-55px)}}@keyframes os-trailer-explore{to{transform:translateX(20px)}}@keyframes os-trailer-breathe{50%{transform:translateY(1px)}}
.os-reduced .os-trailer-shot,.os-reduced .os-trailer-shot *{animation:none!important;transition:none!important}
@media(max-width:600px){.os-opening-logo{width:min(260px,100%)}.os-opening-window{height:215px}}
@media(min-width:601px) and (min-height:501px) and (max-height:800px){.os-opening-logo{width:280px}.os-opening-window{height:240px}}
.os-opening{overflow-x:hidden}
.os-world-colour,.os-title-colour{position:absolute;inset:0;overflow:hidden}.os-world-colour{contain:paint}.os-picture-preview{position:relative;height:120px;overflow:hidden;border:1px solid #718476;border-radius:8px;margin:16px 0;background:#415044}.os-picture-ground{position:absolute;width:512px;height:auto;left:0;top:0;image-rendering:pixelated}.os-picture-house{position:absolute;width:100px;left:calc(50% - 70px);top:10px}.os-picture-person{position:absolute;width:38px;height:48px;left:calc(50% + 45px);top:55px}.os-picture-presets{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin:14px 0}.os-picture-presets .os-btn[oson="true"]{background:#c9b47b!important;color:#132831!important}.os-picture-brightness{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:12px 0}.os-picture-brightness span{font-size:12px}.os-picture-presets .os-btn,.os-picture-brightness .os-btn{min-height:44px!important;padding:8px!important}
.os-picture-settings .os-row{gap:6px;margin:6px 0}.os-picture-settings .os-btn{min-height:44px!important}.os-picture-preview canvas{display:block!important}
.os-root[osdetail="high"] canvas{image-rendering:auto!important}
.os-picture-settings > .os-btn[oson="true"]{background:#c9b47b!important;color:#132831!important}

/* Local effects remain small, bounded and clear of input. */
.os-vfx{position:absolute;z-index:12;pointer-events:none;color:#ffcf91}.os-vfx i,.os-vfx b{position:absolute;display:block;pointer-events:none}.os-vfx em{position:absolute;top:-5px;left:50%;transform:translateX(-50%);font:bold 13px/1.3 monospace;font-style:normal;color:#ffe7cb;background:#4e211bdd;border:1px solid #ed9b7277;border-radius:4px;padding:1px 4px;animation:os-damage-rise 1.4s ease-out both;white-space:nowrap}.os-vfx em:empty{display:none}
.os-vfx-hit i,.os-vfx-acid-hit i{left:45%;top:56%;width:5px;height:17px;border-radius:50%;background:currentColor;animation:os-hit-spark .7s ease-out both}.os-vfx-hit i:nth-child(2),.os-vfx-acid-hit i:nth-child(2){rotate:70deg;animation-delay:.04s}.os-vfx-hit i:nth-child(3),.os-vfx-acid-hit i:nth-child(3){rotate:140deg;animation-delay:.08s}.os-vfx-hit b,.os-vfx-acid-hit b{inset:25%;border:2px solid currentColor;border-radius:50%;animation:os-hit-ring .65s ease-out both}.os-vfx-acid-hit{color:#b7e789}.os-vfx-acid-hit em{color:#daffb5;background:#233b21dd}
.os-vfx-muzzle b{inset:12%;background:#fff4bc;clip-path:polygon(50% 0,60% 36%,100% 50%,63% 60%,50% 100%,39% 63%,0 50%,38% 38%);animation:os-muzzle .35s ease-out both}
.os-vfx-explosion b,.os-vfx-impact b{inset:20%;border-radius:50%;background:radial-gradient(circle,#fff2c8 0 12%,#ffc765 25%,#d87936aa 50%,transparent 72%);animation:os-blast 1s ease-out both}.os-vfx-explosion i,.os-vfx-impact i{inset:10%;border:3px solid #e8b46b;border-radius:50%;animation:os-blast-ring 1.3s ease-out both}.os-vfx-explosion i:nth-child(2),.os-vfx-impact i:nth-child(2){inset:18%;border:12px solid #58616a66;animation:os-blast-smoke 3s ease-out both}.os-vfx-explosion i:nth-child(3),.os-vfx-impact i:nth-child(3){border:5px dotted #a48f73;animation-duration:1.8s}
.os-vfx-surge{color:#acf3ff}.os-vfx-surge b{inset:12%;background:currentColor;clip-path:polygon(60% 0,25% 53%,48% 53%,32% 100%,82% 37%,56% 37%);animation:os-surge-fade 2s ease-out both}.os-vfx-surge i{inset:6%;border:2px dashed #95dbea;animation:os-blast-ring 1.4s ease-out both}.os-vfx-debris i{inset:20%;border:5px dotted #c1c3ad;animation:os-blast-ring 1.4s ease-out both}
.os-vfx-fire i,.os-ambient-fire i{bottom:15%;left:35%;width:30%;height:52%;border-radius:60% 30% 55% 45%;background:linear-gradient(#ffeac0,#efac4e 50%,#c75b28bb);transform-origin:50% 100%;animation:os-flame .75s ease-in-out infinite alternate}.os-vfx-fire i:nth-child(2),.os-ambient-fire i:nth-child(2){left:22%;height:36%;width:25%;animation-delay:-.4s}.os-vfx-fire i:nth-child(3){left:57%;height:33%;width:21%;animation-delay:-.2s}.os-vfx-fire b,.os-ambient-fire b{left:27%;top:15%;width:45%;height:32%;background:#77818166;border-radius:50%;animation:os-fire-smoke 2.8s ease-out infinite}.os-vfx-fire{background:radial-gradient(ellipse at 50% 72%,#ffbd5029,transparent 60%)}.os-ambient-fire{position:absolute;right:9px;bottom:7px;width:24px;height:34px;pointer-events:none}.os-ambient-fire i{bottom:0;height:66%}.os-ambient-fire b{top:0}
.os-actor[ospose="hurt"] .os-colonist-body{filter:drop-shadow(0 0 3px #ff9471) brightness(1.2)}
@keyframes os-damage-rise{0%{opacity:1;translate:0 0}75%{opacity:1}100%{opacity:0;translate:0 -22px}}@keyframes os-hit-spark{from{transform:scale(.7);opacity:1}to{transform:translateY(-14px) scale(.2);opacity:0}}@keyframes os-hit-ring{from{scale:.4;opacity:1}to{scale:1.5;opacity:0}}@keyframes os-muzzle{from{scale:1;opacity:1}to{scale:.2;opacity:0}}@keyframes os-blast{0%{scale:.25;opacity:1}40%{scale:1;opacity:.85}100%{scale:1.4;opacity:0}}@keyframes os-blast-ring{from{scale:.2;opacity:.9}to{scale:1.15;opacity:0}}@keyframes os-blast-smoke{from{scale:.5;opacity:.7}to{scale:1.25;translate:0 -28px;opacity:0}}@keyframes os-surge-fade{from{opacity:.9}to{opacity:0}}@keyframes os-flame{from{transform:scale(.9,1) rotate(-6deg)}to{transform:scale(1.05,.8) rotate(6deg)}}@keyframes os-fire-smoke{from{translate:0 0;scale:.5;opacity:.6}to{translate:10px -30px;scale:1.4;opacity:0}}
.os-root[osplaying="false"] .os-vfx *,.os-root[osplaying="false"] .os-ambient-fire *{animation-play-state:paused!important}.os-reduced .os-vfx *,.os-reduced .os-ambient-fire *{animation:none!important}.os-reduced .os-vfx em{opacity:1}.os-reduced .os-vfx i{opacity:.55}.os-reduced .os-vfx b{opacity:.4}
.os-vfx-fire i,.os-ambient-fire i{clip-path:polygon(50% 0%,65% 27%,62% 42%,85% 25%,90% 62%,100% 77%,88% 94%,65% 100%,28% 100%,8% 86%,0 65%,23% 36%,27% 60%,40% 43%);border-radius:0;background:linear-gradient(#ffdb96,#f2a34a 45%,#c85c27)}

/* Responsive menus: bounded scroll regions and reachable controls at every size. */
.os-root{padding-bottom:env(safe-area-inset-bottom,0px)}
.os-modal-wrap{padding:max(8px,env(safe-area-inset-top,0px)) max(8px,env(safe-area-inset-right,0px)) max(8px,env(safe-area-inset-bottom,0px)) max(8px,env(safe-area-inset-left,0px));min-height:0;overflow:hidden}
.os-modal{min-width:0;max-height:100%;overscroll-behavior:contain;overflow-wrap:anywhere;scroll-padding-top:100px}
.os-modal-head{position:sticky;top:-27px;z-index:2;background:#1a2c34;padding:10px 0;border-bottom:1px solid #3b5155;align-items:flex-start}
.os-modal-head>div{min-width:0;flex:1}.os-modal-head>.os-btn{flex-shrink:0}
.os-modal :is(.os-row,.os-between,.os-save-slot){flex-wrap:wrap}
.os-modal :is(.os-row,.os-between,.os-save-slot)>div{min-width:0}
.os-modal .os-btn{max-width:100%;overflow-wrap:anywhere}
.os-inspector-head{flex-wrap:wrap}.os-inspector-head>.os-label{min-width:0;flex:1}
.os-inspector-content :is(.os-row,.os-between){flex-wrap:wrap}
.os-inspector-content :is(.os-row,.os-between)>div{min-width:0}
.os-inspector-content :is(.os-card,.os-catalogue-item,.os-research-card){min-width:0}
.os-work-mobile{display:none}.os-work-scroll{max-width:100%;overflow:auto;overscroll-behavior:contain}
.os-modal-close{position:sticky;bottom:-27px;background:#1a2c34;padding-top:10px;margin-top:16px;border-top:1px solid #3b5155;z-index:2}
.os-modal-close .os-btn{width:100%;min-height:44px!important}
@media(max-width:1000px){.os-modal-head{top:-16px}.os-modal-close{bottom:-16px}}
@media(max-width:1000px),(pointer:coarse){
 .os-root .os-icon-btn{min-width:44px;width:44px;min-height:44px!important}
 .os-field,.os-save-field{font-size:16px!important}
 .os-modal-title{font-size:clamp(20px,4vw,27px)}
 .os-work-desktop{display:none}.os-work-mobile{display:grid;gap:12px;margin-top:16px}
 .os-work-priorities{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin-top:10px}
 .os-work-priorities .os-priority{display:flex;flex-direction:column;gap:3px;min-height:54px!important;min-width:0!important}
 .os-work-priorities .os-priority span{font-size:10px}.os-work-priorities .os-priority b{font-size:14px}
 .os-work-schedule{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px;margin-top:10px}
 .os-root .os-inspector{height:min(86%,600px)}
 .os-title-pane{justify-content:flex-start}
}
@media(max-width:480px){
 .os-modal{padding:12px}.os-modal-head{top:-12px}.os-modal-close{bottom:-12px}
 .os-modal-footer>.os-btn{flex:1 1 100%}.os-picture-presets{grid-template-columns:repeat(2,minmax(0,1fr))}
 .os-picture-brightness{flex-wrap:wrap}.os-picture-brightness>span{flex:1 1 100%}
 .os-save-slot>div:first-child{flex-basis:100%}.os-save-slot>.os-row{width:100%}.os-save-slot .os-btn{flex:1}
 .os-inspector-head{gap:5px;padding:5px 8px}.os-inspector-content{padding:10px}
 .os-title-actions .os-row{flex-wrap:wrap}.os-title-actions .os-tab{flex:1 1 90px}
 .os-opening-content{padding:16px 12px}.os-opening-actions{width:100%}.os-opening-actions .os-btn{flex:1 1 130px}
}
@media(max-height:560px) and (max-width:1100px){
 .os-root .os-inspector{position:absolute;height:100%;width:min(390px,70%);top:0;bottom:0;right:0;left:auto}
 .os-inspector-head>.os-link{display:none}.os-inspector-head{padding:2px 8px}
 .os-title-showcase{width:34%;padding:14px 10px}.os-title-pane{width:66%;padding:16px;min-height:0}
 .os-map-hint{max-width:calc(100% - 210px)}
}
@media(max-height:400px){.os-modal-art{height:90px}.os-opening-content{justify-content:flex-start}.os-modal-head{margin-bottom:10px}.os-modal-title{font-size:20px}}

.os-opening-horizon{left:0;right:0}
.os-priority{min-width:32px!important;min-height:32px!important}
/* The HUD and opening share the same refined vector composition. */
.os-vector-logo,.os-opening-logo,.os-title-logo{aspect-ratio:16 / 9}
.os-logo-orbit{animation:none!important;clip-path:none!important}
.os-hud-logo{width:112px;height:63px;object-fit:contain;flex-shrink:0}
.os-brand{gap:10px;min-width:0}.os-brand-colony{min-width:0;max-width:125px}.os-brand-colony .os-brand-meta{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
@media(max-width:1250px){.os-hud-logo{width:100px;height:56px}.os-brand-colony{display:none}}
@media(max-width:1000px){.os-hud-logo{width:88px;height:50px;max-width:100%;flex-shrink:1}.os-brand{overflow:hidden}.os-brand-colony{display:none}}
@media(max-width:380px){.os-hud-logo{width:58px;height:36px}.os-time-controls>.os-row{gap:4px}}
@media(max-height:560px) and (max-width:1100px){.os-brand{display:flex;flex-shrink:0}.os-hud-logo{width:64px;height:36px}.os-time-controls{flex:1;min-width:0}}
@media(max-height:560px) and (max-width:480px){.os-hud-logo{width:32px;height:28px}.os-clock{display:none}.os-time-controls{justify-content:flex-end}.os-time-controls>.os-row{gap:0}}
/* Centre the title identity over its action column at every breakpoint. */
.os-title-pane{justify-content:flex-start}
.os-title-heading{width:100%;text-align:center;flex-shrink:0}
.os-title-heading .os-title-logo,.os-title-heading .os-title-tagline{margin-left:auto;margin-right:auto}
.os-title-desc{align-self:center;text-align:center}
.os-title-pane>.os-setup-toggle{align-self:center}
.os-title-footer{text-align:center}.os-credit-link{color:#c5ad77;text-decoration:none;border-bottom:1px dotted #c5ad7788;pointer-events:auto}.os-credit-link:hover{color:#f0dfb0;border-bottom-color:#f0dfb0}.os-credits{white-space:nowrap;margin:0 12px;font-size:10px;letter-spacing:.04em}
.os-carry[oskind]::after{content:"";position:absolute;left:50%;top:50%;translate:-50% -50%;font-size:9px;line-height:1;color:#f2e6c8;text-shadow:0 1px 1px #000}
.os-carry[oskind="wood"]::after{content:"W"}.os-carry[oskind="stone"]::after{content:"S"}.os-carry[oskind="ore"]::after{content:"O"}.os-carry[oskind="metal"]::after{content:"M"}.os-carry[oskind="parts"]::after{content:"P"}.os-carry[oskind="fuel"]::after{content:"F"}.os-carry[oskind="raw"]::after{content:"R"}.os-carry[oskind="meals"]::after{content:"E"}.os-carry[oskind="medicine"]::after{content:"+"}.os-carry[oskind="glass"]::after{content:"G"}.os-carry[oskind="cores"]::after{content:"C"}.os-carry[oskind="body"]::after{content:"†"}.os-carry[oskind="kit"]::after{content:"K"}
.os-smoke{position:absolute;left:50%;top:-6px;width:0;height:0;pointer-events:none;z-index:7}.os-smoke i{position:absolute;left:-6px;top:0;width:12px;height:12px;border-radius:50%;background:radial-gradient(circle,#9aa3a8cc,#5b646880 60%,transparent 72%);animation:os-smoke-rise 2.6s linear infinite}.os-smoke i:nth-child(2){animation-delay:.9s;left:-2px}.os-smoke i:nth-child(3){animation-delay:1.8s;left:-9px}
@keyframes os-smoke-rise{0%{translate:0 0;scale:.6;opacity:0}20%{opacity:.85}100%{translate:0 -34px;scale:1.5;opacity:0}}
.os-steam{position:absolute;left:50%;top:0;width:0;height:0;pointer-events:none;z-index:7}.os-steam i{position:absolute;left:-4px;top:0;width:9px;height:9px;border-radius:50%;background:radial-gradient(circle,#f4f7f8cc,#dfe6e880 60%,transparent 72%);animation:os-smoke-rise 1.8s linear infinite}.os-steam i:nth-child(2){animation-delay:.8s;left:2px}
.os-hammer{position:absolute;right:4px;top:4px;width:10px;height:10px;border-radius:50%;background:#ffd67a;box-shadow:0 0 8px #ffb84a;animation:os-hammer 0.5s steps(2) infinite;pointer-events:none;z-index:8}
@keyframes os-hammer{0%{scale:.6;opacity:.4}100%{scale:1;opacity:1}}
.os-minimap{position:relative;width:100%;aspect-ratio:1/1;border:1px solid #2f4b52;border-radius:6px;overflow:hidden;background:#0b1519;cursor:crosshair;box-shadow:inset 0 0 0 1px #00000060,0 0 18px #0a3a4020}.os-minimap-ground{position:absolute;inset:0;width:100%;height:100%;image-rendering:pixelated;display:block;opacity:.92}
.os-minimap-view{position:absolute;border:1px solid #a5ded4aa;box-sizing:border-box;pointer-events:none;box-shadow:0 0 0 1px #00000080}
.os-minimap-mark{position:absolute;width:3px;height:3px;margin:-1.5px 0 0 -1.5px;border-radius:50%;pointer-events:none}.os-mm-settler{background:#f4e8c8;box-shadow:0 0 3px #fff}.os-mm-selected{background:#8fe7df;width:5px;height:5px;margin:-2.5px 0 0 -2.5px;box-shadow:0 0 5px #8fe7df}.os-mm-threat{background:#ff6b5a;width:4px;height:4px;margin:-2px 0 0 -2px;box-shadow:0 0 4px #ff6b5a}.os-mm-ruin{background:#50d4dc;width:4px;height:4px;margin:-2px 0 0 -2px;border-radius:1px}.os-mm-camp{background:#f0a050;width:4px;height:4px;margin:-2px 0 0 -2px;border-radius:1px}
.os-minimap-label{position:absolute;left:6px;bottom:4px;font-size:9px;letter-spacing:.14em;color:#8fbdb8;text-shadow:0 1px 2px #000;pointer-events:none}
.os-help-topics{display:flex;gap:6px;flex-wrap:wrap;padding:10px 15px 0}
.os-cyan{color:#8fe7df}
.os-building .os-sprite{transition:translate .22s ease,opacity .22s ease}.os-building[osopen="true"] .os-sprite{translate:0 -58%;opacity:.35}
.os-made{position:absolute;right:3px;bottom:3px;width:14px;height:11px;background:linear-gradient(#c8a86c,#a88a52);border:1px solid #5e4a2a;box-shadow:1px 1px #151c21,inset 0 1px #e2c98f;z-index:7;pointer-events:none}.os-made::after{content:"";position:absolute;left:50%;top:50%;translate:-50% -50%;font-size:9px;line-height:1;color:#f2e6c8;text-shadow:0 1px 1px #000}.os-made[oskind="meals"]::after{content:"E"}.os-made[oskind="parts"]::after{content:"P"}.os-made[oskind="metal"]::after{content:"M"}.os-made[oskind="fuel"]::after{content:"F"}.os-made[oskind="medicine"]::after{content:"+"}.os-made[osfull="true"]{box-shadow:0 0 0 1px #e98671,0 0 8px #e9867180,inset 0 1px #e2c98f}
.os-task-mark{position:absolute;left:-4px;top:2px;min-width:12px;height:12px;padding:0 2px;border-radius:6px;background:#0f1d22e6;border:1px solid #3d5a5c;color:#dfe9e4;font-size:9px;line-height:11px;text-align:center;pointer-events:none;z-index:4}.os-actor[osleft="true"] .os-task-mark{left:auto;right:-4px}
.os-crew-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:12px;margin:12px 0}.os-crew-card{background:#14242b;border:1px solid #2f4b52;border-radius:8px;padding:12px;display:flex;flex-direction:column;gap:8px}.os-crew-name{font-weight:600;font-size:15px}.os-crew-skills{display:grid;grid-template-columns:1fr 1fr;gap:3px 10px}.os-crew-skill{display:flex;align-items:center;gap:6px;font-size:11px}.os-crew-skill[osstrong="true"] .os-crew-skill-value{color:#f4d27a}.os-crew-skill-label{width:52px;color:#93a9a5}.os-crew-skill-value{width:auto;min-width:34px;white-space:nowrap;flex-shrink:0;text-align:right;font-variant-numeric:tabular-nums}.os-crew-summary{display:flex;flex-wrap:wrap;gap:8px;margin:6px 0 4px}.os-crew-good{color:#a6d69a;font-size:12px}.os-crew-bad{color:#e98671;font-size:12px}
.os-modal[osdialog="crew"]{width:min(1120px,100%)}
.os-crew-controls{display:flex;flex-wrap:wrap;gap:8px;margin:2px 0 12px}.os-crew-controls .os-btn{flex:1 1 150px;min-height:34px!important;font-size:11px!important;padding:6px 10px!important}
.os-crew-grid{grid-template-columns:repeat(auto-fit,minmax(235px,1fr));gap:14px;margin:12px 0 14px}
.os-crew-card{padding:14px;gap:10px;box-shadow:inset 0 1px #ffffff0a,0 6px 18px #0004}
.os-crew-head{display:flex;gap:12px;align-items:center}.os-crew-ident{min-width:0;flex:1;display:flex;flex-direction:column;gap:3px}
.os-crew-portrait{flex:none;width:64px;height:72px;border-radius:12px;background:radial-gradient(circle at 50% 30%,#2c4a54,#0f1e25 72%);border:1px solid #2f4b52;display:flex;align-items:flex-end;justify-content:center;overflow:hidden}
.os-crew-portrait img{width:54px;height:66px;object-fit:contain;filter:drop-shadow(0 3px 3px #061217)}
.os-crew-name{font-size:16px;line-height:1.15;color:#eee6cc;font-weight:600;overflow-wrap:anywhere}
.os-crew-chips{display:flex;flex-wrap:wrap;gap:4px;margin-top:2px}
.os-chip-mini{font-size:9px;letter-spacing:.35px;text-transform:uppercase;padding:2px 6px;border-radius:9px;border:1px solid #3d5a5c;color:#dfe9e4;background:#0f1d22;white-space:nowrap}
.os-chip-mini[oskind="calling"]{border-color:#c9a552;color:#f4d27a}.os-chip-mini[oskind="knack"]{border-color:#3f8f8a;color:#8fe7df}
.os-crew-skills{gap:4px 14px}.os-crew-skill{font-size:11px;gap:7px}.os-crew-skill-label{width:44px}.os-crew-skill-value{width:auto;min-width:34px;white-space:nowrap;flex-shrink:0}
.os-crew-bio{font-size:11.5px;line-height:1.5;color:#c9d3cc;flex:1}
.os-crew-ties{color:#8fe7df;font-size:11px}.os-crew-motto{font-style:italic;color:#93a9a5;font-size:11px}
.os-crew-card>.os-btn{flex:0 0 auto;margin-top:auto;min-height:32px!important}
.os-crew-summary{padding:8px 10px;border-radius:8px;background:#0f1d22;border:1px solid #2f4b52;margin:0}
.os-crew-summary:empty{display:none}
.os-crew-good,.os-crew-bad{padding:2px 8px;border-radius:9px;border:1px solid}.os-crew-good{border-color:#5a8a4f55;background:#a6d69a12}.os-crew-bad{border-color:#e9867155;background:#e9867112}
.os-crew-codeline{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:2px 0}
.os-crew-code{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:11px;color:#8fe7df;background:#0f1d22;border:1px solid #2f4b52;border-radius:6px;padding:4px 8px;user-select:all;overflow-wrap:anywhere}
@media(max-width:600px){.os-crew-grid{grid-template-columns:1fr;gap:10px;margin:10px 0}.os-crew-card{padding:12px}.os-crew-controls .os-btn{flex-basis:100%}.os-modal[osdialog="crew"] .os-modal-title{font-size:19px}.os-modal[osdialog="crew"] .os-modal-head .os-row{gap:6px}}
@media(min-width:601px) and (max-width:900px){.os-crew-grid{grid-template-columns:1fr 1fr}}
/* More life: windows, chimneys, sparks, crops, rain on roofs, crates, footprints, motes, tools, chat. */
.os-glow{position:absolute;left:50%;bottom:18%;width:78%;height:60%;translate:-50% 0;border-radius:50%;background:radial-gradient(ellipse at center,#ffd88a66,#ffb94d22 55%,transparent 75%);opacity:0;transition:opacity 1.8s ease;pointer-events:none;z-index:2}
.os-building[oslit="true"] .os-glow{opacity:1;animation:os-lamp-breathe 5s ease-in-out infinite}
@keyframes os-lamp-breathe{0%,100%{opacity:.8}50%{opacity:1}}
.os-chimney{position:absolute;right:22%;top:-3px;width:0;height:0;pointer-events:none;z-index:7}
.os-chimney i{position:absolute;left:-4px;top:0;width:8px;height:8px;border-radius:50%;background:radial-gradient(circle,#d8dde0aa,#9aa3a866 60%,transparent 72%);animation:os-chimney-rise 3.4s linear infinite}
.os-chimney i:nth-child(2){animation-delay:1.7s;left:-1px}
@keyframes os-chimney-rise{0%{opacity:0;translate:0 0;scale:.6}15%{opacity:.7}100%{opacity:0;translate:6px -26px;scale:1.8}}
.os-sparks{position:absolute;left:55%;bottom:34%;width:0;height:0;pointer-events:none;z-index:8}
.os-sparks i{position:absolute;left:0;top:0;width:2px;height:2px;border-radius:50%;background:#ffd27a;box-shadow:0 0 4px #ff9a3c;animation:os-spark-a .7s ease-out infinite}
.os-sparks i:nth-child(2){animation:os-spark-b .8s ease-out infinite;animation-delay:.25s}
.os-sparks i:nth-child(3){animation:os-spark-c .6s ease-out infinite;animation-delay:.4s}
@keyframes os-spark-a{0%{opacity:1;translate:0 0}100%{opacity:0;translate:7px -14px}}
@keyframes os-spark-b{0%{opacity:1;translate:0 0}100%{opacity:0;translate:-6px -12px}}
@keyframes os-spark-c{0%{opacity:1;translate:0 0}100%{opacity:0;translate:2px -17px}}
.os-building[ossown="true"] .os-sprite{animation:os-sway 3.6s ease-in-out infinite}
.os-world[osweather="storm"] .os-building[ossown="true"] .os-sprite,.os-world[osweather="glass"] .os-building[ossown="true"] .os-sprite{animation-duration:1.1s}
@keyframes os-sway{0%,100%{rotate:-1.2deg}50%{rotate:1.2deg}}
.os-building[osroof="true"]::before{content:"";position:absolute;left:8%;right:8%;top:4%;height:40%;background:radial-gradient(circle,#e3f1f8cc 1px,transparent 1.8px);background-size:10px 8px;opacity:0;pointer-events:none;z-index:6;transition:opacity .8s}
.os-world[osweather="rain"] .os-building[osroof="true"]::before,.os-world[osweather="storm"] .os-building[osroof="true"]::before,.os-world[osweather="echo"] .os-building[osroof="true"]::before{opacity:.55;animation:os-roofdrops .55s steps(3) infinite}
@keyframes os-roofdrops{0%{background-position:0 0}100%{background-position:10px 8px}}
.os-made[osstack="2"]{box-shadow:1px 1px #151c21,inset 0 1px #e2c98f,-3px -3px 0 -1px #b89a5e,-3px -3px 0 0 #5e4a2a}
.os-made[osstack="3"]{box-shadow:1px 1px #151c21,inset 0 1px #e2c98f,-3px -3px 0 -1px #b89a5e,-3px -3px 0 0 #5e4a2a,-6px -6px 0 -1px #a88a52,-6px -6px 0 0 #5e4a2a}
.os-footprint{position:absolute;width:8px;height:5px;z-index:2;pointer-events:none;animation:os-print-fade 8s linear both}
.os-footprint::before,.os-footprint::after{content:"";position:absolute;top:0;width:3px;height:2px;border-radius:50%;background:#2a3a33}
.os-footprint::before{left:0}.os-footprint::after{left:5px;top:3px}
.os-footprint[ossnow="true"]::before,.os-footprint[ossnow="true"]::after{background:#9fb4bd}
@keyframes os-print-fade{0%{opacity:.6}100%{opacity:0}}
.os-motes{position:absolute;inset:0;z-index:4;pointer-events:none;opacity:0;transition:opacity 2s;background:radial-gradient(circle,#fff3c455 1px,transparent 1.6px);background-size:170px 140px;animation:os-motes 22s linear infinite}
.os-world[osweather="clear"][osnight="false"] .os-motes,.os-world[osweather="heat"][osnight="false"] .os-motes{opacity:.5}
@keyframes os-motes{0%{background-position:0 0}100%{background-position:60px -140px}}
.os-colonist-body{transition:rotate .16s linear}
.os-actor[ospose="walk"][osphase="1"] .os-colonist-body{rotate:1.5deg}.os-actor[ospose="walk"][osphase="3"] .os-colonist-body{rotate:-1.5deg}
.os-actor[osidle="true"] .os-colonist-body{animation:os-idle 4.2s ease-in-out infinite}
@keyframes os-idle{0%,100%{translate:0 0}50%{translate:0 -.5px}}
.os-handtool{position:absolute;left:21px;top:22px;width:3px;height:11px;background:#7d6547;border-radius:1px;transform-origin:50% 100%;pointer-events:none;z-index:3;animation:os-tool-swing .8s ease-in-out infinite}
.os-handtool::after{content:"";position:absolute;left:-3px;top:-2px;width:9px;height:4px;background:#b8bfc4;border-radius:1px}
.os-handtool[oskind="pick"]::after{width:11px;height:3px;left:-4px;border-radius:2px 2px 0 0}
.os-handtool[oskind="axe"]::after{width:6px;height:6px;left:1px;border-radius:0 3px 3px 0;background:#c9ced2}
.os-handtool[oskind="hoe"]::after{width:7px;height:2px;left:0;top:-1px;background:#9aa0a6}
.os-handtool[oskind="sickle"]::after{width:8px;height:8px;left:-4px;top:-5px;border:2px solid #c9ced2;border-color:#c9ced2 transparent transparent #c9ced2;background:none;border-radius:50%}
.os-handtool[oskind="hoe"],.os-handtool[oskind="sickle"]{animation-duration:1.25s}
.os-actor[osleft="true"] .os-handtool{left:auto;right:21px;animation-name:os-tool-swing-left}
@keyframes os-tool-swing{0%,100%{rotate:-35deg}45%{rotate:25deg}}
@keyframes os-tool-swing-left{0%,100%{rotate:35deg}45%{rotate:-25deg}}
.os-chat{position:absolute;left:24px;top:-5px;width:16px;height:10px;border-radius:6px;background:#eef3ecdd;border:1px solid #6a807a;pointer-events:none;z-index:4;display:flex;align-items:center;justify-content:center;gap:2px}
.os-chat i{width:2px;height:2px;border-radius:50%;background:#2c3d3a;animation:os-chat-dot 1.2s ease-in-out infinite}
.os-chat i:nth-child(2){animation-delay:.2s}.os-chat i:nth-child(3){animation-delay:.4s}
@keyframes os-chat-dot{0%,100%{opacity:.25}50%{opacity:1}}
.os-actor[osleft="true"] .os-chat{left:auto;right:24px}
.os-carry[oskind]::after{content:""!important}
.os-carry[oskind="wood"]{background:repeating-linear-gradient(90deg,#b07a45 0 3px,#8a5b31 3px 4px);border-color:#4a2f18;height:7px;top:26px;border-radius:3px}
.os-carry[oskind="stone"]{background:linear-gradient(#a9adaa,#7f8582);border-color:#4b5250;border-radius:3px 3px 2px 2px}
.os-carry[oskind="ore"]{background:radial-gradient(circle at 30% 30%,#8d8f93,#4b4e55);border-color:#26282c;border-radius:4px 5px 3px 4px}
.os-carry[oskind="metal"]{background:linear-gradient(#d5d9dc,#9aa2a8);border-color:#5b646a;height:6px;top:27px;border-radius:1px}
.os-carry[oskind="parts"]{background:radial-gradient(circle,#8fe7df 28%,#2a4d4e 32%);border-color:#173536;border-radius:50%;width:10px;height:10px}
.os-carry[oskind="fuel"]{background:linear-gradient(#f0b85a,#c6862e);border-color:#6a4514;width:8px;height:11px;top:23px;border-radius:2px}
.os-carry[oskind="raw"]{background:linear-gradient(#a9c96c,#6f9a3d);border-color:#3e5c1f;border-radius:5px 5px 2px 2px;height:10px;top:24px}
.os-carry[oskind="meals"]{background:linear-gradient(#f2ecd2,#cfc39c);border-color:#7d6c45;border-radius:1px 1px 6px 6px;height:7px;top:26px;border-top:2px solid #bf9766}
.os-carry[oskind="medicine"]{background:#f4f6f5;border-color:#7b8a86}.os-carry[oskind="medicine"]::after{content:"+"!important;color:#d64545;font-weight:bold}
.os-carry[oskind="glass"]{background:linear-gradient(135deg,#d7fbf6,#5fc9c0);border-color:#2f7f7a;width:9px;height:9px;rotate:45deg;top:25px}
.os-carry[oskind="cores"]{background:radial-gradient(circle,#e7d1ff,#8a5bd6 60%,#4b2a8a);border-color:#2a1650;border-radius:50%;width:10px;height:10px;box-shadow:0 0 6px #a57cff}
.os-carry[oskind="body"]{background:linear-gradient(#8d9599,#5f676b);border-color:#30373b;width:16px;height:6px;top:27px;border-radius:3px}
.os-carry[oskind="kit"]{background:linear-gradient(#c8b48a,#9d8a5f);border-color:#5b4a2a;border-radius:2px}.os-carry[oskind="kit"]::after{content:""!important;width:4px;height:2px;background:#5b4a2a;border-radius:1px;left:50%;top:1px;translate:-50% 0}
.os-reduced .os-glow,.os-reduced .os-chimney i,.os-reduced .os-sparks i,.os-reduced .os-handtool,.os-reduced .os-chat i,.os-reduced .os-motes,.os-reduced .os-footprint,.os-reduced .os-building .os-sprite,.os-reduced .os-actor .os-colonist-body{animation:none!important}
.os-root[osplaying="false"] .os-chimney i,.os-root[osplaying="false"] .os-sparks i,.os-root[osplaying="false"] .os-handtool,.os-root[osplaying="false"] .os-chat i,.os-root[osplaying="false"] .os-motes,.os-root[osplaying="false"] .os-building .os-sprite,.os-root[osplaying="false"] .os-footprint{animation-play-state:paused!important}
.os-actor[osanimate="false"] .os-handtool,.os-actor[osanimate="false"] .os-chat i{animation-play-state:paused}
.os-region-map{display:block;width:100%;max-width:240px;margin:6px auto 4px;border-radius:50%;box-shadow:0 6px 18px #0005}
/* The road out: the Frontier chart, parties on the road, the plan dialog. */
.os-frontier-head{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}.os-frontier-title{font-size:12px;color:#dbe0d1;margin-top:4px}.os-frontier-head .os-frontier-home{flex:0 0 auto;min-width:0;white-space:nowrap}
.os-chart{position:relative;width:100%;max-width:270px;margin:6px auto 0;aspect-ratio:1/1;border-radius:50%;box-shadow:0 10px 26px #0007}
.os-chart-ground{display:block;width:100%;height:100%;border-radius:50%}
.os-chart-mark{position:absolute;translate:-50% -50%;width:24px;height:24px;min-height:0!important;padding:0!important;margin:0;border:none!important;background:transparent!important;box-shadow:none!important;border-radius:50%!important;cursor:pointer;z-index:2;appearance:none}
.os-chart-mark i{display:block;width:10px;height:10px;margin:7px;border-radius:50%;border:2px solid #f4d27a;background:#f4d27a;box-shadow:0 0 0 2px #0b171c}
.os-chart-region i{width:16px;height:16px;margin:4px;background:transparent;border:1px solid transparent;box-shadow:none}
.os-chart-region:hover i,.os-chart-region:focus-visible i{border-color:#e8dec0cc;background:#e8dec022}.os-chart-region[oson="true"] i{border-color:#f4d27a88;border-style:dashed}
.os-chart-party i{animation:os-chart-pulse 1.8s ease-in-out infinite}
.os-chart-rover i{background:#8fe7df;border-color:#8fe7df;animation:os-chart-pulse 1.8s ease-in-out infinite}
.os-chart-party[oson="true"] i,.os-chart-rover[oson="true"] i{box-shadow:0 0 0 2px #0b171c,0 0 0 5px #f4d27a66}
@keyframes os-chart-pulse{0%,100%{box-shadow:0 0 0 2px #0b171c,0 0 0 0 #f4d27a77}50%{box-shadow:0 0 0 2px #0b171c,0 0 0 9px #f4d27a00}}
.os-chart-legend{display:flex;justify-content:center;gap:10px 14px;margin:8px 0 2px;font-size:10px;color:#91a4a5;flex-wrap:wrap}.os-chart-legend span{display:inline-flex;align-items:center;gap:5px}
.os-chart-key{display:inline-block;width:9px;height:9px;border-radius:50%}.os-key-ring{border:1px dashed #6f8b92;width:11px;height:11px}.os-key-party{background:#f4d27a}.os-key-rover{background:#8fe7df}.os-key-camp{background:#c9b48a;border-radius:1px}
.os-party-card{border-left:3px solid #7a6a48}.os-party-card[oson="true"]{border-left-color:#f4d27a;background:#1b3038}
.os-party-track{height:5px;border-radius:3px;background:#0b171c;margin-top:8px;overflow:hidden;box-shadow:inset 0 0 0 1px #2f4b52}.os-party-track i{display:block;height:100%;background:linear-gradient(90deg,#c9b47b,#f4d27a);border-radius:3px;transition:width .6s}
.os-region-card{border-left:3px solid var(--os-region,#8fb9d9)}.os-region-card[osout="true"]{opacity:.82}
.os-region-swatch{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:6px;vertical-align:1px}
.os-region-badges{display:flex;flex-wrap:wrap;gap:4px;margin-top:6px}.os-badge{font-size:9px;letter-spacing:.4px;text-transform:uppercase;padding:2px 6px;border-radius:3px;background:#0f1d23;border:1px solid #2f4b52;color:#9caeaa;white-space:nowrap}
.os-badge-danger-0{color:#9cc9a0}.os-badge-danger-1{color:#c9c37b}.os-badge-danger-2{color:#dfbe7e;border-color:#6a5a34}.os-badge-danger-3{color:#e08a7a;border-color:#6a3a34}.os-badge-ok{color:#97c9c1;border-color:#2f5a57}.os-badge-camp{color:#132831;background:#c9b47b;border-color:#c9b47b}.os-badge-out{color:#f4d27a;border-color:#6a5a34}
.os-plan-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:14px}.os-plan-stat{background:#13262dc9;border:1px solid #35494b;border-radius:6px;padding:9px 10px;display:flex;flex-direction:column;gap:3px;min-width:0}.os-plan-stat b{font-size:14px;font-weight:600;color:#e8e2d4;overflow-wrap:anywhere;line-height:1.25}
.os-danger-0{color:#9cc9a0!important}.os-danger-1{color:#c9c37b!important}.os-danger-2{color:#dfbe7e!important}.os-danger-3{color:#e08a7a!important}
.os-plan-who{margin-top:16px}
.os-plan-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:8px;margin-top:8px}
.os-plan-card{position:relative;text-align:left;display:flex;flex-direction:column;gap:3px;background:#14242b;border:1px solid #2f4b52;border-radius:8px;padding:11px 12px 11px 36px;color:#d8ded5;cursor:pointer;min-height:0;font:inherit;appearance:none;transition:border-color .15s,background .15s}
.os-plan-card:hover{border-color:#859994;background:#1b3038}.os-plan-card[oson="true"]{border-color:#f4d27a;background:#1f3238;box-shadow:inset 0 0 0 1px #f4d27a55}.os-plan-card:disabled{opacity:.5;cursor:not-allowed}
.os-plan-check{position:absolute;left:11px;top:12px;width:16px;height:16px;border-radius:4px;border:1px solid #6f8b92;font-size:11px;line-height:14px;text-align:center;color:#132831}.os-plan-card[oson="true"] .os-plan-check{background:#f4d27a;border-color:#f4d27a}
.os-plan-name{font-size:13px;font-weight:600;color:#e8e2d4}.os-plan-role{font-size:10px;color:#8fa8a7}
.os-plan-skill{display:block;height:4px;border-radius:2px;background:#0b171c;overflow:hidden;margin:4px 0 2px}.os-plan-skill i{display:block;height:100%;background:#97c9c1;border-radius:2px}
.os-plan-check-line{margin-top:12px;padding:9px 11px;border-radius:6px;font-size:11px;line-height:1.5;background:#0f1d23;border:1px solid #2f4b52;color:#b7c2bc}.os-plan-check-line[oson="true"]{border-color:#2f5a57;color:#97c9c1}
.os-watch-banner{position:absolute;top:10px;left:50%;translate:-50% 0;z-index:16;display:flex;align-items:center;gap:10px;padding:6px 8px 6px 14px;border-radius:999px;background:#0b171ce6;border:1px solid #f4d27a66;color:#e8dec0;font-size:11px;box-shadow:0 8px 24px #0008;max-width:calc(100% - 24px)}.os-watch-banner span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.os-watch-banner .os-btn{flex:0 0 auto;min-height:30px!important;white-space:nowrap}
@media(max-width:600px){.os-plan-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.os-plan-grid{grid-template-columns:1fr}.os-chart{max-width:240px}.os-watch-banner{top:6px;font-size:10px;padding:5px 6px 5px 10px}}
@media(pointer:coarse){.os-chart-mark{width:32px;height:32px}.os-chart-mark i{margin:11px}.os-chart-region i{margin:8px}}
.os-mm-home{background:#f4d27a;width:5px;height:5px;margin:-2.5px 0 0 -2.5px;box-shadow:0 0 5px #f4d27a;border-radius:1px}.os-mm-rover{background:#8fe7df;box-shadow:0 0 3px #8fe7df}.os-mm-site{background:transparent;border:1px solid #dfe9e4aa;width:5px;height:5px;margin:-2.5px 0 0 -2.5px;border-radius:50%}.os-mm-farcamp{background:#c9b48a;width:4px;height:4px;margin:-2px 0 0 -2px;border-radius:1px}
</style>
