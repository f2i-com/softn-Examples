<style>
.os-root{position:relative;width:100%;height:100%;min-height:640px;display:flex;flex-direction:column;background:#101b21;color:#e8e2d4;overflow:hidden;font-family:Inter,"Segoe UI",Arial,sans-serif;font-size:13px;line-height:1.45;user-select:none;--color-text:#e8e2d4;--color-text-muted:#93a9aa;--color-surface:#1b2a30;--color-surface-hover:#273940;--color-border:#35464b;--color-border-hover:#809b99;--color-background:#101b21;--color-primary:#c5ad77;--color-primary-hover:#e2c890;--os-amber:#dfbe7e;--os-cyan:#97c9c1}
.os-root *{box-sizing:border-box}.os-root img{display:block}.os-root h1,.os-root h2,.os-root h3,.os-root p{margin:0}.os-root button{font:inherit}.os-root ::-webkit-scrollbar{width:5px;height:5px}.os-root ::-webkit-scrollbar-thumb{background:#405259;border-radius:9px}.os-root ::-webkit-scrollbar-track{background:transparent}
.os-row{display:flex;align-items:center;gap:8px}.os-between{display:flex;align-items:center;justify-content:space-between;gap:8px}.os-wrap{flex-wrap:wrap}.os-stack{display:flex;flex-direction:column;gap:10px}.os-small{font-size:11px}.os-tiny{font-size:10px}.os-dim{color:#91a4a5!important}.os-amber{color:#dfbe7e!important}.os-cyan{color:#97c9c1!important}.os-label{display:block;color:#9caeaa;font-size:10px;font-weight:650;letter-spacing:1.8px;text-transform:uppercase}.os-section-title{font-size:20px!important;font-weight:500!important;letter-spacing:-.4px;color:#e8e2d4!important}.os-prose{font-size:12px;line-height:1.7;color:#b7c2bc;white-space:pre-line}.os-rule{height:1px;background:#334348;margin:14px 0}.os-chip{font-size:10px;letter-spacing:.5px;padding:3px 7px;border:1px solid #4a5756;border-radius:4px;color:#d4bd86;background:#2b302b}.os-key{font:10px ui-monospace,monospace;border:1px solid #405157;border-bottom-width:2px;border-radius:3px;padding:0 4px;color:#b2bfbd}
.os-btn{border:1px solid #405057!important;background:#203138!important;border-radius:5px!important;color:#d8ded5!important;padding:7px 10px!important;min-height:30px!important;font-size:11px!important;box-shadow:none!important;cursor:pointer;transition:background .12s,border-color .12s;white-space:normal;line-height:1.4!important}.os-btn:hover{background:#2d444a!important;border-color:#859994!important}.os-btn:focus-visible{outline:2px solid #b7d3c6;outline-offset:2px}.os-btn:disabled{opacity:.38!important;cursor:not-allowed}.os-btn[oson="true"],.os-btn.os-primary{background:#d1b77b!important;border-color:#e1c893!important;color:#172328!important;font-weight:650}.os-btn.os-primary:hover{background:#e2c68b!important}.os-btn.os-ghost{background:transparent!important}.os-btn.os-danger{color:#efa897!important;border-color:#70493e!important}.os-btn.os-wide{width:100%}.os-btn.os-icon-btn{width:31px;min-width:31px;padding:4px!important;font-size:16px!important}.os-btn.os-link{border-color:transparent!important;background:transparent!important;color:#a7c9c3!important;padding:3px 0!important}.os-tab{flex:1;padding:6px 5px!important;min-height:28px!important;font-size:10px!important}
