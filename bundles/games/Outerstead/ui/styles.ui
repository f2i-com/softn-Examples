@media(pointer:coarse){.os-edge{display:none}.os-inspector,.os-toolbar,.os-mobile-roster{touch-action:pan-x pan-y}}
@media(max-width:820px) and (max-height:500px){.os-mobile-roster{display:none!important}.os-header{flex-wrap:nowrap}.os-resources{order:0;flex:1;width:auto}.os-brand{display:none}.os-time-controls{flex-shrink:0}.os-root .os-inspector{height:95%}.os-map-zoom{flex-direction:row;top:auto;bottom:8px}.os-map-hint{max-width:65%}.os-pause-pill{left:45px}.os-title{flex-direction:row}.os-title-showcase{width:42%;align-self:center;padding:16px}.os-title-pane{width:58%;padding:20px;align-self:flex-start}.os-scene-frame{height:260px}.os-title-scene{transform:translate(-50%,-50%) scale(.5)}.os-title-tagline{font-size:23px}}
.os-animal-gait{animation:os-animal-step .48s ease-in-out infinite;transform-origin:center bottom}
@keyframes os-animal-step{0%,100%{transform:translateY(0)}50%{transform:translateY(-1.5px)}}
.os-reduced .os-animal-gait{animation:none!important}
@media(prefers-reduced-motion:reduce){.os-root:not([osmotion="on"]) .os-animal-gait{animation:none!important}}
.os-actor{position:absolute;left:0;top:0;width:32px;height:40px;z-index:8;transition:transform 95ms linear;pointer-events:none}
.os-animal{position:absolute;left:0;top:0;z-index:7;transition:transform 95ms linear;pointer-events:none}.os-animal[osglow="true"]{z-index:9;filter:drop-shadow(0 0 7px #ffe08a)}.os-animal[osmarked="true"]{outline:2px dashed #e0b46a;outline-offset:2px;border-radius:50%}.os-animal[ostamed="true"]{outline:2px dotted #a8c998;outline-offset:2px;border-radius:50%}
.os-colonist{text-align:left;font:inherit;color:inherit;flex-shrink:0}
@media(max-width:820px){.os-body{display:grid;grid-template-rows:74px minmax(0,1fr);grid-template-columns:minmax(0,1fr)}.os-roster{display:flex;width:100%;height:74px;flex-direction:row;gap:5px;padding:4px 7px;overflow-x:auto;overflow-y:hidden;border-bottom:1px solid #3b504d}.os-roster>.os-between,.os-roster>.os-btn,.os-roster>.os-row,.os-roster-note{display:none}.os-colonist{flex:1;min-width:88px;padding:4px}.os-colonist .os-avatar{width:23px;height:29px}.os-colonist-name{font-size:10px}.os-colonist-role,.os-colonist .os-tiny,.os-colonist .os-mini-bars{display:none}.os-colonist .os-row{gap:4px}.os-colonist-action{font-size:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-height:0;max-width:100px;margin-top:3px}.os-viewport{grid-row:2}}
