<div className="os-help-heading">Incident severity</div>
<div className="os-row os-event-options"><button className="os-btn os-tab" oson={String(eventSeverityChoice === "gentle")} @click={() => setEventSetting("severity","gentle")}>Gentle</button><button className="os-btn os-tab" oson={String(eventSeverityChoice === "standard")} @click={() => setEventSetting("severity","standard")}>Standard</button><button className="os-btn os-tab" oson={String(eventSeverityChoice === "severe")} @click={() => setEventSetting("severity","severe")}>Severe</button></div>
<p className="os-small os-dim">Gentle excludes harmful random encounters and dangerous weather. Severe doubles weather/electrical damage and increases warned predator packs. Sanctuary always prevents hostile random encounters.</p>
<div className="os-help-heading">Incident & weather frequency</div>
<div className="os-row os-event-options"><button className="os-btn os-tab" oson={String(eventFrequencyChoice === "off")} @click={() => setEventSetting("frequency","off")}>Off</button><button className="os-btn os-tab" oson={String(eventFrequencyChoice === "relaxed")} @click={() => setEventSetting("frequency","relaxed")}>Relaxed</button><button className="os-btn os-tab" oson={String(eventFrequencyChoice === "normal")} @click={() => setEventSetting("frequency","normal")}>Normal</button><button className="os-btn os-tab" oson={String(eventFrequencyChoice === "mayhem")} @click={() => setEventSetting("frequency","mayhem")}>Mayhem</button></div>
<p className="os-small os-dim">{eventSettingsText || "Normal: encounters every 16–28 game hours. Settings can be changed from the pause menu."}</p>
