  researchSummary=(osGame.researchId?techName(osGame.researchId)+" · "+Math.floor(osGame.researchProgress[osGame.researchId]||0)+" / "+techById(osGame.researchId).cost:"Choose your next discovery")+(researchQueue().length?" · "+researchQueue().length+" queued":"");
  let work=[],living=dialog==="work"?alivePeople():[];for(let i=0;i<living.length;i++){let c=living[i],priorities=[];for(let j=0;j<WORK_KEYS.length;j++){let k=WORK_KEYS[j];priorities.push({id:k,label:WORK_LABELS[j],value:c.priorities[k]||"–",raw:c.priorities[k],skill:Math.floor(c.skills[k]||0)});}work.push({id:c.id,name:c.short,role:c.role,quirks:quirkText(c),schedule:c.schedule,priorities:priorities});}workCards=work;
  let storage=[];for(let i=0;activePanel==="storage"&&i<RESOURCE_KEYS.length;i++){let k=RESOURCE_KEYS[i];storage.push({id:k,name:k==="meals"?("Meals"+((osGame.qualityMeals||0)>0?" · "+Math.min(Math.floor(osGame.stock.meals),Math.floor(osGame.qualityMeals))+" from the kitchen":"")):k==="parts"?"Components":k==="raw"?"Raw ingredients":k==="glass"?"Hollowglass":k==="cores"?"Echo cores":k.charAt(0).toUpperCase()+k.slice(1),amount:Math.floor(osGame.stock[k]),hasTarget:osGame.policy[k]!==undefined,target:osGame.policy[k]||0});}storageCards=storage;
  let trades=[];for(let i=0;activePanel==="frontier"&&i<TRADE_OFFERS.length;i++){let t=TRADE_OFFERS[i],remaining=tradeLimit(t)-(osGame.trades[t.id]||0);trades.push({id:t.id,name:t.name,cost:costText(t.give),receive:t.weapon?WEAPONS[t.weapon].name+" · delivered south of camp":costText(t.receive),remaining:remaining,available:(!t.weapon||osGame.weapons.length<128)&&osGame.traderUntil>osGame.minutes&&remaining>0&&stockHas(t.give)});}tradeCards=trades;
  projectWatchBanner();if(activePanel==="frontier")projectFrontierMood();if(activePanel==="frontier"||dialog==="expedition")projectRegions();if(dialog==="expedition")expeditionPlanView=expeditionPlanCard();
  blueprintCount=0;if(activePanel==="build")for(let i=0;i<osGame.buildings.length;i++)if(!osGame.buildings[i].built)blueprintCount++;
  supplyMessage=osGame.traderUntil>osGame.minutes?"Meridian caravan · "+Math.ceil((osGame.traderUntil-osGame.minutes)/60)+" hours remaining · goodwill "+osGame.standing.Meridian:"No visiting caravan. A powered signal mast can call one in.";
  let ruins=[];for(let i=0;activePanel==="frontier"&&i<osGame.sites.length;i++){let s=osGame.sites[i];if(!s.known)continue;ruins.push({id:s.id,name:s.name,status:excavationCheck(s),studied:s.studied,progress:Math.min(100,Math.floor(s.progress/95*100))});}ruinCards=ruins;
