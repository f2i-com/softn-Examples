  for(let i=0;i<osGame.jobs.length;i++){let j=osGame.jobs[i];if(j.type==="survey"&&tileInView(j.x,j.y,1,1,bounds))jobs.push({id:j.id,label:"◇",style:{position:"absolute",left:worldPx(j.x)+"px",top:worldPy(j.y)+"px",width:"32px",height:"32px",color:"#8fe7df",textAlign:"center",fontSize:"24px",zIndex:11,pointerEvents:"none"}});}
