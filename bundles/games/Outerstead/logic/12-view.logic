}
function refreshAll() {let started=perfEnabled?perfNow():0;try{serviceViewWindow();refreshAtlas(true);return withView(function(){return projectAll(true);});}finally{perfRecord("projection",started);}}
// The periodic refresh: the cheap, always-changing parts every time; structures, panels, the campaign and the
// record only when their domain changed since the last pass, with a full pass at least every two seconds.
function refreshPeriodic() {let started=perfEnabled?perfNow():0;try{serviceViewWindow();if(activePanel==="overview"||projectionAge>=1.5)refreshAtlas(projectionAge>=1.5);return withView(function(){return projectAll(false);});}finally{perfRecord("projection",started);}}
let lastPanel="",lastDisconnected=-1;
let minimapSrc="",minimapMarks=[],minimapView={display:"none"};
let watchBannerText="";
// The survey display: one small SVG of the explored map, rebuilt on the full pass, with marks laid over it.
function minimapRow(y,colours) {
  let out="",runStart=0,runKey="";
  for(let x=0;x<=MAP_SIZE;x++){let key="";if(x<MAP_SIZE){let i=y*MAP_SIZE+x;key=!osGame.explored[i]?"u":(osGame.floorTiles&&osGame.floorTiles[i])?"f":osGame.terrain[i]===3?"w":osGame.terrain[i]===4?"r":osGame.terrain[i]===5?"m":"g"+Math.min(2,osGame.terrain[i]);}
    if(key!==runKey){if(runKey&&runKey!=="u")out+='<rect x="'+runStart+'" y="'+y+'" width="'+(x-runStart)+'" height="1" fill="'+colours[runKey]+'"/>';runStart=x;runKey=key;}}
  return out;
}
const MINIMAP_COLOURS={u:"#0b1519",g0:"#2d4839",g1:"#35543f",g2:"#4a6a3f",w:"#1c4a60",r:"#5a625c",m:"#2f5a55",f:"#7a6a48"};
function refreshMinimap(full) {
  // The ground picture is rebuilt only when tiles were revealed or structures changed, and only on a full pass;
  // rows are cached, so a revealed patch costs its rows and the join, not the map.
  if((full&&minimapBuiltEpoch!==minimapEpoch&&osGame.elapsed-minimapBuiltAt>=4)||!minimapSrc){minimapBuiltEpoch=minimapEpoch;minimapBuiltAt=osGame.elapsed;
    if(minimapRows.length!==MAP_SIZE){minimapRows=[];for(let y=0;y<MAP_SIZE;y++)minimapRows.push(minimapRow(y,MINIMAP_COLOURS));minimapRowsDirty={};}
    else{let keys=Object.keys(minimapRowsDirty);for(let i=0;i<keys.length;i++){let y=Number(keys[i]);if(y>=0&&y<MAP_SIZE)minimapRows[y]=minimapRow(y,MINIMAP_COLOURS);}minimapRowsDirty={};}
    if(minimapStructBuilt!==minimapStructEpoch){minimapStructBuilt=minimapStructEpoch;let rects=[];
      for(let i=0;i<osGame.buildings.length;i++){let b=osGame.buildings[i];if(!b.built||!onMap(b.x,b.y)||!osGame.explored[tileId(b.x,b.y)])continue;rects.push('<rect x="'+(b.x-WX)+'" y="'+(b.y-WY)+'" width="'+b.w+'" height="'+b.h+'" fill="'+(b.kind==="wall"||b.kind==="door"?"#a08a5a":b.kind==="floor"?"#7a6a48":"#d3b06a")+'"/>');}
      minimapStructSvg=rects.join("");}
    minimapSrc="data:image/svg+xml;utf8,"+encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 '+MAP_SIZE+' '+MAP_SIZE+'" shape-rendering="crispEdges"><rect width="'+MAP_SIZE+'" height="'+MAP_SIZE+'" fill="'+MINIMAP_COLOURS.u+'"/>'+minimapRows.join("")+minimapStructSvg+'</svg>');
  }
  let marks=[],pct=100/MAP_SIZE;
  for(let i=0;i<osGame.sites.length;i++){let s=osGame.sites[i];if(s.known)marks.push({id:s.id,kind:"ruin",style:{left:((s.x-WX+1.5)*pct)+"%",top:((s.y-WY+1.5)*pct)+"%"}});}
  for(let i=0;i<(osGame.camps||[]).length;i++){let c=osGame.camps[i];marks.push({id:c.id,kind:"camp",style:{left:((c.x-WX+1)*pct)+"%",top:((c.y-WY+1)*pct)+"%"}});}
  for(let i=0;i<osGame.animals.length;i++){let a=osGame.animals[i];if(a.dead||!a.hostile||!onMap(a.x,a.y)||!osGame.explored[tileId(a.x,a.y)])continue;marks.push({id:a.id,kind:"threat",style:{left:((a.x-WX)*pct)+"%",top:((a.y-WY)*pct)+"%"}});}
  for(let i=0;i<osGame.people.length;i++){let c=osGame.people[i];if(c.dead)continue;marks.push({id:c.id,kind:selectedId===c.id?"selected":"settler",style:{left:((c.x-WX)*pct)+"%",top:((c.y-WY)*pct)+"%"}});}
  minimapMarks=marks;
  let v=visibleTileRange;minimapView=v&&v.width>0?{left:(v.x*pct)+"%",top:(v.y*pct)+"%",width:(v.width*pct)+"%",height:(v.height*pct)+"%"}:{display:"none"};
}

function timedPart(name,fn){let started=perfEnabled?perfNow():0;try{fn();}finally{perfRecord(name,started);}}
function projectAll(full) {
  if(!osGame){refreshCamera();return;}
  serviceTopology();timedPart("projection:sight",refreshSight);if(terrainDirty)timedPart("projection:terrain",rebuildTerrainView);else if(terrainRowsPending)timedPart("projection:terrain-rows",rebuildTerrainRows);
  projectionAge+=0.5;if(full||viewDirty||projectionAge>=2){full=true;projectionAge=0;}
  let living=alivePeople(),p=osGame.power||{generation:0,demand:0,stored:0,capacity:0},foodDays=(osGame.stock.meals+osGame.stock.raw*0.65)/Math.max(1,living.length*1.5);
  hud={name:osGame.name,sol:dayNow(),time:clockText(osGame.minutes%1440),weather:osGame.weather,temperature:Math.round(osGame.temperature),population:everyoneAlive().length,wood:Math.floor(osGame.stock.wood),stone:Math.floor(osGame.stock.stone),metal:Math.floor(osGame.stock.metal),parts:Math.floor(osGame.stock.parts),meals:Math.floor(osGame.stock.meals),medicine:Math.floor(osGame.stock.medicine),foodDays:foodDays.toFixed(1),power:Math.round(p.generation)+" / "+Math.round(p.demand)+" W",stored:Math.round(p.stored)+" / "+Math.round(p.capacity)+" Wh",season:["Thaw","Longlight","Emberfall","Deepcold"][Math.floor((dayNow()-1)/12)%4]};
  let everyone=everyoneAlive(),cards=[];for(let i=0;i<everyone.length;i++){let c=everyone[i];cards.push({id:c.id,name:c.short,role:c.role,quirks:quirkText(c),away:!!c.away,action:c.action,mood:c.away?"AWAY":c.rover?(c.rover.party?"ON THE ROAD":"ROVING"):moodName(c.mood),moodValue:Math.round(c.mood),sprite:actorSprite(c),selected:selectedId===c.id,drafted:c.drafted,health:Math.round(c.health),healthStyle:needsBar(c.health,"#ca997e"),restStyle:needsBar(c.rest,"#8baebd"),foodStyle:needsBar(c.food,"#a4ba73"),colour:c.colour});}colonistCards=cards;
  if(full||storyDirty)timedPart("projection:campaign",projectCampaign);
  let alerts=[];if(foodDays<2)alerts.push({id:"food",action:"Plan food production",title:"Low food reserves",body:hud.foodDays+" Sols estimated. Expand crops or trade.",type:"warning"});
  let wounded=0,hostiles=0,raiders=0,disconnected=0;for(let i=0;i<living.length;i++)if(living[i].health<65||living[i].bleed>0)wounded++;
  for(let i=0;i<osGame.animals.length;i++)if(osGame.animals[i].hostile&&!osGame.animals[i].dead&&osGame.explored[tileId(osGame.animals[i].x,osGame.animals[i].y)]){hostiles++;if(osGame.animals[i].kind==="raider")raiders++;}
  for(let i=0;i<osGame.buildings.length;i++){let b=osGame.buildings[i];if(b.built&&b.on&&BUILDINGS[b.kind].power&&!b.powered)disconnected++;}
  if(disconnected!==lastDisconnected){lastDisconnected=disconnected;structuresDirty=true;}
  if(raiders)alerts.push({id:"hostiles",action:"Locate a hostile",title:"Raiders at the stores",body:raiders+" Ashwalkers are after the warehouse. Draft settlers and guard the racks; bring them down before they reach the edge.",type:"danger"});
  else if(hostiles)alerts.push({id:"hostiles",action:"Locate a hostile",title:"Hostile creatures",body:hostiles+" detected. Draft settlers and hold a defensible line.",type:"danger"});
  if(osGame.weather==="Glass Wind"){let exposed=exposedPeople().length;if(exposed)alerts.push({id:"exposed",action:"Find an exposed settler",title:"Glass Wind · "+exposed+" outside",body:"Cuts mount in the open. Rooms shelter; give them indoor work or let them wait it out.",type:"warning"});}
  if(wounded)alerts.push({id:"medical",action:"Find injured colonist",title:"Treatment needed",body:wounded+" injured. Enable Treat for a healthy colonist.",type:"danger"});
  let unburied=0;for(let i=0;i<osGame.people.length;i++)if(osGame.people[i].dead&&!osGame.people[i].buried)unburied++;
  if(unburied&&!freeGrave(""))alerts.push({id:"burial",action:"Plan a grave",title:unburied===1?"A settler lies unburied":unburied+" settlers lie unburied",body:"Build a grave (4 stone). A hauler will carry the fallen there and the colony will gather to say goodbye.",type:"warning"});
  if(osGame.funeral)alerts.push({id:"funeral",title:"A funeral for "+osGame.funeral.name,body:"Settlers are gathering at the grave. Drafted settlers and those in need stay away.",type:"info"});
  if(disconnected)alerts.push({id:"power",action:"Find unpowered equipment",title:"Equipment without power",body:disconnected+" devices. Check conduits, generation, and fuel.",type:"warning"});
  if(osGame.eventQueue.length)alerts.push({id:"incoming",action:"Read the chronicle",title:"Something is approaching",body:"A forecast or security warning is pending. See the chronicle.",type:"warning"});
  if(osGame.traderUntil>osGame.minutes)alerts.push({id:"trade",action:"Open trading",title:"Caravan at the gate",body:"Trading available in Frontier.",type:"info"});
  if(!alerts.length)alerts.push({id:"calm",title:"A quiet moment",body:"A chance to build something that lasts.",type:"info"});alertCards=alerts;
  suggestShelter=countBuilt("bed")<4||!(osGame.rooms&&osGame.rooms.length);
  
  if(full)timedPart("projection:camps",projectCamps);if(full||storyDirty)timedPart("projection:record",projectRecord);
  refreshAtmosphere();
  let sun=sunAmount();worldNight=(1-sun)*0.36;worldSnow=Math.floor((dayNow()-1)/12)%4===3;
  let t=toolKind;toolLabel=t.indexOf("build:")===0?"Build · "+BUILDINGS[t.slice(6)].name:t==="harvest"?"Gather · drag over resources":t==="survey"?"Survey · click a destination":t==="erase"?"Dismantle · click structures":t==="shelter"?"Bunkhouse · 8 × 8 blueprint":"Select / inspect";
  footerText=touchControls?(t==="select"?"Tap to inspect · drag to pan · pinch to zoom":toolPaints()?"Drag to draw it out · tap then Apply for one tile · two fingers to pan":"Tap a tile, then Apply · drag to pan · pinch to zoom"):(t==="select"?"Drag to pan · right-click to order or clear":toolPaints()?"Drag to draw it out · right-click to cancel":"Right-click to cancel · drag to place");
  fpsLabel=osGame.jobs.length+" tasks · 10 Hz simulation · seed "+osGame.seedLabel;
  autoMode=!!osGame.autoMode;refreshAutoStatus();refreshPerformance();
  if(full||stockDirty||researchDirty||storyDirty||activePanel!==lastPanel)timedPart("projection:panels",refreshPanels);lastPanel=activePanel;
  timedPart("projection:inspector",refreshInspector);
  if(!full&&!structuresDirty&&doorsBusy())structuresDirty=true;
  if(full||structuresDirty)timedPart("projection:structures",refreshStructures);
  refreshActors();refreshCamera();
  viewDirty=false;structuresDirty=false;stockDirty=false;researchDirty=false;storyDirty=false;
}

// Authored diorama uses the exact terrain atlas and structure sprites used in play.
// Independent of the simulation: opening the menu must not spend resources or RNG.
function initialiseTitleScene() {
  let ground=[],floor=[],objects=[];
  for(let y=0;y<18;y++){
    let row=[],deck=[],trees=[];
    for(let x=0;x<24;x++){
      let water=x<3+Math.sin(y*.5)*1.5;
      row.push(water?6+(y%2):(x*7+y*11)%4);
      deck.push(x>=8&&x<=16&&y>=5&&y<=11?12+(x+y)%2:-1);
      trees.push(!water&&(y<2||y>15||x>21)&&(x*3+y)%4===0?16+(x+y)%3:-1);
    }
    ground.push(row);floor.push(deck);objects.push(trees);
  }
  titleLayers=[ground,floor,objects];
  let pieces=[["lander",4,7],["farm",18,6],["farm",18,10],["solar",9,2],["solar",13,2],["generator",16,3],["bed",9,6],["bed",11,6],["lab",14,6],["table",12,9],["kitchen",9,9],["stockpile",6,12],["lamp",8,8],["lamp",17,10],["radio",16,13]];
  let result=[];
  for(let i=0;i<pieces.length;i++){let p=pieces[i],d=BUILDINGS[p[0]];result.push({id:i,sprite:spritePath(p[0]),style:{position:"absolute",left:p[1]*32+"px",top:p[2]*32+"px",width:d.w*32+"px",height:d.h*32+"px"}});}
  let titleWalls={};for(let x=8;x<=16;x++)titleWalls[tileId(x,5)]={kind:"wall",built:true,x:x,y:5};
  for(let x=8;x<=16;x++)result.push({id:"wall"+x,sprite:joinedWallSprite(titleWalls[tileId(x,5)],titleWalls),style:{position:"absolute",left:x*32+"px",top:"144px",width:"32px",height:"48px",zIndex:9}});
  titleStructures=result;
}
// Following: the actor tick sets where the camera should be; the game loop eases the pan there every frame in whole
// pixels, with no CSS transition, so the world and the tile map's clip window never disagree for a frame.
let followPanX=0,followPanY=0,followHasTarget=false;
function tickFollowCamera() {
  if(!followColonistId||pointerState||screen!=="game")return;
  let c=findColonist(followColonistId);
  if(!c||c.dead){followColonistId="";followHasTarget=false;return;}
  let o=viewOrigin(),s=TILE*zoomLevel;followPanX=(o.size/2-(c.x-o.wx))*s;followPanY=(o.size/2-(c.y-o.wy))*s;followHasTarget=true;
  if(Math.abs(followPanX-panX)>viewportPxW*1.5||Math.abs(followPanY-panY)>viewportPxH*1.5){panX=followPanX;panY=followPanY;}
}
function tickCameraEase(dt){
  if(!followColonistId||pointerState||!followHasTarget||screen!=="game")return;
  let k=1-Math.exp(-(dt||0.016)/0.09),dx=followPanX-panX,dy=followPanY-panY;
  if(Math.abs(dx)<0.4&&Math.abs(dy)<0.4){if(dx||dy){panX=followPanX;panY=followPanY;refreshCamera();}return;}
  panX+=dx*k;panY+=dy*k;refreshCamera();
}

// Side-profile herbivores use front/rear drawings for vertical travel. The
// top-down crawler rotates from its artwork's south-facing baseline.
// Pose lives on a child so a turn cannot spin the world-position transform.
function animalPose(a) {
  let dx=typeof a.headingX==="number"?a.headingX:(animalRotates(a.kind)?0:(a.facing===-1?-1:1));
  let dy=typeof a.headingY==="number"?a.headingY:(animalRotates(a.kind)?1:0);
  let sprite=a.kind,transform="none";
  if(animalStats(a.kind).sideOnly){if(dx<0)transform="scaleX(-1)";return {sprite:spritePath(sprite),style:{width:"100%",height:"100%",transform:transform,transformOrigin:"50% 50%"}};}
  if(animalRotates(a.kind))transform="rotate("+round1(Math.atan2(dy,dx)*180/Math.PI-90)+"deg)";
  else if(Math.abs(dy)>Math.abs(dx))sprite+="-"+(dy<0?"north":"south");
  else if(dx<0)transform="scaleX(-1)";
  return {sprite:spritePath(sprite),style:{width:"100%",height:"100%",transform:transform,transformOrigin:"50% 50%"}};
}
function animalActivity(a) {
  if(a.hostile)return a.movingUntil>osGame.elapsed?"Pursuing":"Alert";
  return a.movingUntil>osGame.elapsed?"Roaming":"Foraging";
}

// What a settler on the road is doing, for their card.
function partyText(c){let e=expeditionById(c.rover.party);if(!e)return "With a party";let reg=regionById(e.regionId);return (EXPEDITION_PURPOSES[e.purpose]||"Walking")+" · "+(reg?reg.name:"the country")+" · "+(e.phase==="out"?"walking out":e.phase==="work"?"at the site":e.phase==="camp"?"holding the camp":"walking home");}
