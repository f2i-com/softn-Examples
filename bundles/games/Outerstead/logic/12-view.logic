// Renderer window affects presentation only; offscreen simulation continues.
let visibleTileRange=null;
function setVisibleTileRange(r){
 if(!r||typeof r!=="object")return;
 let size=Math.max(MAP_SIZE,viewMapTiles||0);
 for(let k of ["x","y","width","height"])if(typeof r[k]!=="number"||!Number.isFinite(r[k])||r[k]<0||r[k]>size)return;
 if(r.x+r.width>size||r.y+r.height>size)return;
 if(visibleTileRange&&visibleTileRange.x===r.x&&visibleTileRange.y===r.y&&visibleTileRange.width===r.width&&visibleTileRange.height===r.height)return;
 visibleTileRange={x:r.x,y:r.y,width:r.width,height:r.height};if(r.x>0&&r.y>0&&r.x+r.width<size&&r.y+r.height<size)hintViewport(r.width*TILE*zoomLevel,r.height*TILE*zoomLevel);
 // A renderer report only updates culling. Moving/rebuilding the map here can
 // cause another report to enter the same refresh while it is still publishing.
 if(osGame&&screen==="game")withView(function(){refreshStructures();projectActors();});
}
function tileInView(x,y,w,h,bounds){
 // Renderer reports arrive after drawing and can describe the previous window
 // during zoom/rebase. Once measured, the live camera is authoritative: never
 // unmount visible sprites because a delayed report is stale or briefly empty.
 if(viewportKnown){let r=bounds||visibleWorldRect(),pad=2+96/(TILE*zoomLevel);return x+(w||1)>=r.x-pad&&y+(h||1)>=r.y-pad&&x<=r.x+r.w+pad&&y<=r.y+r.h+pad;}
 if(!visibleTileRange)return true;
 let r=visibleTileRange;if(!r.width||!r.height)return false;
 x=x-WX;y=y-WY;return x+(w||1)>=r.x-2&&y+(h||1)>=r.y-2&&x<=r.x+r.width+2&&y<=r.y+r.height+2;
}
// Compact view models are the only bridge between persistent simulation and UI.
// Rendering does not draw random numbers or award gameplay milestones.
let categoryCards=[];
let pageTitle="Settlement";
let researchSummary="No active project";
let gridStyle={};
let landingScenario="landing";
let endingCards=[];
let ambienceText="Sound off";
let debugStatus="";
let blockedWorkCards=[];
let blueprintCount=0;
let worldBiomeFilter="none";
let recordCards=[];
function projectRecord(){
  if(activePanel!=="chronicle"){recordCards=[];return;}
  let s=osGame.stats,t=osGame.threats||{waves:0};
  recordCards=[{name:"Sols",value:String(dayNow())},{name:"People who called it home",value:String(osGame.people.length)},{name:"Died here",value:String(s.deaths)},{name:"Harvests",value:String(s.harvests)},{name:"Meals cooked",value:String(Math.floor(s.mealsCooked))},{name:"Discoveries",value:String(Object.keys(osGame.tech).length)},{name:"Archives recovered",value:s.studied+" of 3"},{name:"Predators brought down",value:String(s.attacks)},{name:"Waves survived",value:String(t.waves||0)},{name:"Raids suffered · camps broken",value:(s.raided||0)+" · "+(s.campsBroken||0)},{name:"Born here",value:String(s.births||0)},{name:"Mossbacks tamed · food grazed",value:(s.tamed||0)+" · "+(s.grazed||0)},{name:"Ridge",value:osGame.ridgeName||"Unnamed"}];
}
let workBoardText="";
let workRetryAvailable=false;
function refreshWorkBoard() {
  blockedWorkCards=[];workBoardText="";workRetryAvailable=false;
  if(!osGame||(activePanel!=="work"&&dialog!=="work"))return;
  let cards=[],total=0,claimed=0,blocked=0;
  for(let i=0;i<osGame.jobs.length;i++){
    let j=osGame.jobs[i];if(!jobStillValid(j))continue;total++;
    if(j.claimed){claimed++;continue;}
    let reason="";
    if(j.blockedUntil>osGame.elapsed){reason=j.reason||"Waiting to try again";workRetryAvailable=true;}
    else {
      let enabled=false;for(let k=0;k<osGame.people.length;k++){let c=osGame.people[k];if(!c.dead&&c.priorities[j.category]){enabled=true;break;}}
      if(!enabled)reason="No living colonist has "+WORK_LABELS[WORK_KEYS.indexOf(j.category)]+" enabled.";
    }
    if(!reason)continue;blocked++;
    if(cards.length<12){let target=targetForJob(j),name=j.type==="survey"?"Survey destination":j.type==="treat"?target.name:j.type==="excavate"?target.name:j.type==="gather"?(target.kind==="pile"?"Dropped supplies":target.kind==="tree"?"Ironbark stand":target.kind==="berries"?"Sunberry bush":target.kind+" deposit"):BUILDINGS[target.kind].name;
      cards.push({id:j.id,name:name,reason:reason,location:Math.floor(j.x)+", "+Math.floor(j.y)});
    }
  }
  blockedWorkCards=cards;workBoardText=total+" tasks · "+claimed+" claimed · "+blocked+" blocked"+(blocked>12?" · showing first 12":"");
}
function clockText(minute) {let h=Math.floor(minute/60)%24,m=Math.floor(minute%60);return (h<10?"0":"")+h+":"+(m<10?"0":"")+m;}
function needsBar(value,colour) {return {width:Math.round(clamp(value,0,100))+"%",background:colour};}
function spritePath(kind) {return "assets/sprites/"+kind+".svg";}
function actorSprite(c) {if(c.look)return spritePath(c.look);if(c.spriteIndex!==undefined)return spritePath("colonist"+(c.spriteIndex%4));let i=0;for(let j=0;j<FOUNDERS.length;j++)if(c.colour===FOUNDERS[j].colour)i=j;return spritePath("colonist"+i);}
function moodName(value) {return value>=85?"Inspired":value>=65?"Content":value>=45?"Steady":value>=25?"Struggling":"Distressed";}
function taskExplanation(c) {
  if(c.dead)return "Their story lives in the colony chronicle.";
  if(c.drafted)return "Command mode: click a destination or creature. Stand down to resume autonomous work.";
  if(c.health<22)return "Downed. Another colonist with Treat enabled must reach them.";
  if(c.equipTarget)return "Walking to a reserved weapon. Other settlers cannot take it. Drafting cancels pickup; your current weapon stays with you until the swap.";
  if(c.task&&c.task.leisure)return "Optional downtime. Checks for work every 1.2 simulation seconds; hunger, bedtime and danger take precedence.";
  if(c.task){if(c.task.phase==="deliver")return "Supplies enter the warehouse only when this delivery arrives.";if(c.task.type==="sleep")return "Resting until recovered, or until hunger becomes urgent.";if(c.task.type==="eat")return "A meal has been reserved; cancellation returns it to stock.";let job=c.task.jobId?getJob(c.task.jobId):null;if(job){if(job.type==="treat"&&c.partner===job.target)return "Ran to their partner. Friends and partners reach the wounded before strangers do.";if(job.type==="treat"&&hasQuirk(c,"firstIn"))return "First in, as always: treatment weighs far more for them than any other job.";if(hasQuirk(c,"openSky")&&!roomAt(job.x,job.y)&&osGame.weather!=="Glass Wind")return "Took the outdoor job first: they hate enclosed rooms.";if(hasQuirk(c,"stormworker")&&stormyWeather()&&!roomAt(job.x,job.y))return "Out in the weather by choice, and working a quarter faster for it.";}if(osGame.weather==="Glass Wind")return roomAt(c.x,c.y)?"Working under a roof while the glass wind blows outside.":"Out in the glass wind: cuts mount every hour and a half without shelter.";return "Selected by work priority, skill, distance, and current needs.";}
  let count=0,blocked=0;for(let i=0;i<osGame.jobs.length;i++){let j=osGame.jobs[i];if(c.priorities[j.category]&&(!j.claimed||j.claimed===c.id)){count++;if(j.blockedUntil>osGame.elapsed)blocked++;}}
  return count?(blocked?blocked+" eligible tasks are blocked. Check materials, power, and paths.":"Matching available work to priorities and reachable targets."):"No eligible unclaimed tasks. Designate resources, place blueprints, or choose research.";
}
// The camera is drawn for whichever window the screen shows, so a call from outside a window (every frame, drags, hovers) sizes and places the world like the projection does.
function refreshCamera() {if(contextDepth===0)projectWatchBanner();if(contextDepth===0&&viewMode==="far"&&viewWindow)return withView(refreshCameraInWindow);return refreshCameraInWindow();}
function refreshCameraInWindow() {
  // While following, the camera eases with exactly the same timing as the actors, so the followed
  // settler stays put on screen instead of lagging the viewport and jumping to catch up.
  let following=!!followColonistId&&!pointerState;
  worldBiomeFilter=osGame?biomeOf().filter:"none";
  let px=Math.round(panX),py=Math.round(panY);
  worldStyle={position:"absolute",left:"50%",top:"50%",width:(MAP_SIZE*TILE)+"px",height:(MAP_SIZE*TILE)+"px",transform:"translate(-50%, -50%) translate("+px+"px, "+py+"px) scale("+round1(zoomLevel*100)/100+")",transformOrigin:"center center",transition:"none"};
  let w=1,h=1;
  if(toolKind.indexOf("build:")===0){let d=BUILDINGS[toolKind.slice(6)];if(d){w=d.w;h=d.h;}}
  if(toolKind==="shelter"){w=8;h=8;}
  if(hoverCellX<0||hoverCellY<0){hoverStyle={display:"none"};return;}
  let x=hoverCellX,y=hoverCellY,colour="#9cccc5";
  if(toolKind==="erase")colour="#e98671";
  if(pointerState&&pointerState.mode==="paint"&&(toolKind==="harvest"||toolKind==="erase")){x=Math.min(x,pointerState.x);y=Math.min(y,pointerState.y);w=Math.abs(hoverCellX-pointerState.x)+1;h=Math.abs(hoverCellY-pointerState.y)+1;}
  mapPlan=[];
  if(pointerState&&pointerState.mode==="paint"&&toolKind.indexOf("build:")===0&&toolPaints()&&osGame){let kind=toolKind.slice(6),cells=planCells(kind,pointerState.x,pointerState.y,hoverCellX,hoverCellY),ok=0;
    for(let i=0;i<cells.length&&i<400;i++){let c=cells[i],r=placementCheck(kind,c.x,c.y,true);if(r.ok)ok++;mapPlan.push({id:c.x+"_"+c.y,style:{position:"absolute",left:(worldPx(c.x))+"px",top:(worldPy(c.y))+"px",width:TILE+"px",height:TILE+"px",background:(r.ok?"#a6d69a":"#e98671")+"55",boxShadow:"inset 0 0 0 1px "+(r.ok?"#a6d69a":"#e98671"),boxSizing:"border-box",zIndex:12,pointerEvents:"none"}});}
    let shape=planShape(kind,pointerState.x,pointerState.y,hoverCellX,hoverCellY);footerText=ok+" of "+cells.length+" "+BUILDINGS[kind].name.toLowerCase()+"(s) can go here"+(shape==="outline"?" · room outline":shape==="fill"?" · filled area":"")+" · release to place";
    hoverStyle={display:"none"};return;}
  if(toolKind.indexOf("build:")===0&&osGame){let result=placementCheck(toolKind.slice(6),x,y,false);colour=result.ok?"#a6d69a":"#e98671";footerText=result.reason;}
  hoverStyle={display:"block",position:"absolute",left:worldPx(x)+"px",top:worldPy(y)+"px",width:(w*TILE)+"px",height:(h*TILE)+"px",border:"2px solid "+colour,background:toolKind==="select"?"transparent":colour+"25",boxSizing:"border-box",zIndex:12,pointerEvents:"none"};
}
function walkingSprite(c) {
  let base=actorSprite(c).slice(0,-4),dx=c.headingX||0,dy=typeof c.headingY==="number"?c.headingY:1;
  if(Math.abs(dx)>Math.abs(dy))base+="-"+(dx<0?"west":"east");
  else if(dy<0)base+="-north";
  if(!reducedMotion&&!c.dead&&c.pathCursor<c.path.length)base+="-walk"+(Math.floor(osGame.elapsed*6)%2+1);
  return base+".svg";
}
// A glyph for the work in hand, shown beside the settler while they are at it.
const TASK_MARKS={treat:"✚",rescue:"✚",research:"◎",build:"⚒",repair:"⚒",sow:"✿",harvest:"✂",produce:"⚙",excavate:"⛏",survey:"◇",hunt:"➶",tame:"♥",bury:"†",strike:"⚔",gather:"⌁"};
function taskMark(c){let t=c.task;if(!t||t.personal||c.dead||c.health<22)return "";if(t.phase!=="work"&&t.type!=="hunt"&&t.type!=="tame"&&t.type!=="strike")return "";return TASK_MARKS[t.type]||"";}
function colonistPose(c) {
  if(c.dead||c.health<22)return "still";
  if(c.hurtUntil>osGame.elapsed)return "hurt";
  if(c.drafted&&c.attackUntil>osGame.elapsed)return "attack";
  if(c.equippedUntil>osGame.elapsed)return "equip";
  if(c.path&&c.pathCursor<c.path.length)return "walk";
  if(c.drafted||!c.task||c.task.phase!=="work")return "still";
  if(c.task.leisure)return c.task.activity==="games"?"play":c.task.activity==="social"?"chat":"relax";
  let kind=c.task.type;
  if(kind==="sleep")return "sleep";
  if(kind==="eat")return "eat";
  if(kind==="build"||kind==="repair"||kind==="gather"||kind==="excavate")return "work-heavy";
  if(kind==="research"||kind==="produce"||kind==="sow"||kind==="harvest"||kind==="treat")return "work-light";
  return "still";
}
function refreshActors() {let started=perfEnabled?perfNow():0;try{return withView(function(){return projectActors();});}finally{perfRecord("actorProjection",started);}}
function projectActors() {
  if(!osGame)return;
  // left/top change the window basis instantly; transform animates only real
  // world movement. A zoom-induced rebase must never animate a stationary actor.
  projectWeapons();projectVisualFx();
  let people=[],animals=[],shots=[],tables={},bounds=viewportKnown?visibleWorldRect():null;
  for(let i=0;i<osGame.people.length;i++){let c=osGame.people[i];if(!c.dead&&!c.away&&seatedAtTable(c))tables[c.task.targetId]=(tables[c.task.targetId]||0)+1;}
  if(mapPrints.length){let kept=[];for(let i=0;i<mapPrints.length;i++){let age=osGame.elapsed-mapPrints[i].at;if(age>=0&&age<8)kept.push(mapPrints[i]);}mapPrints=kept;}
  for(let i=0;i<osGame.people.length;i++){
    let c=osGame.people[i];if(c.away||c.carried||c.buried||!osGame.explored[tileId(c.x,c.y)]||!tileInView(c.x-1,c.y-2,2,3,bounds))continue;
    let pose=colonistPose(c),sleeping=pose==="sleep",bed=sleeping?getBuilding(c.task.targetId):null,groundSleep=sleeping&&(!bed||bed.kind==="bedroll"),py=sleeping?(groundSleep?worldPy(c.y)-20:worldPy(bed.y)+7):worldPy(c.y)-27;
    let weapon=heldWeapon(c),armed=!!(weapon&&c.drafted&&!c.dead&&c.health>=22),aimX=typeof c.headingX==="number"?c.headingX:1,aimY=c.headingY||0,aimAngle=Math.atan2(aimY,aimX)*180/Math.PI;
    let range=weaponStats(c).range*TILE;
    let seated=!!seatedAtTable(c),seatBuilding=seated?getBuilding(c.task.targetId):null;
    let seatX=seated?worldPx(seatBuilding.x)+(c.task.seat<2?12:52):worldPx(c.x),seatY=seated?worldPy(seatBuilding.y)+22+(c.task.seat%2)*25:0;
    if(seated)py=seatY-27;
    let tool="";if(pose==="work-heavy"||pose==="work-light"){let kind=c.task.type;if(kind==="build"||kind==="repair")tool="hammer";else if(kind==="excavate")tool="pick";else if(kind==="gather"){let node=getNode(c.task.targetId);tool=node&&node.kind==="tree"?"axe":"pick";}else if(kind==="sow")tool="hoe";else if(kind==="harvest")tool="sickle";}
    let chat=pose==="chat"||(seated&&(tables[c.task.targetId]||0)>1&&(Math.floor(osGame.elapsed/2.5)+i)%3===0);
    if(pose==="walk"&&!c.dead&&!reducedMotion){let tr=printTrack[c.id];if(!tr||sqDistance(tr.x,tr.y,c.x,c.y)>=0.6){let ter=osGame.terrain[tileId(c.x,c.y)];if(ter===5||worldSnow||osGame.weather==="Rain"||osGame.weather==="Storm"||osGame.weather==="Echo Rain"){mapPrints.push({id:"fp"+(printSeq++),at:osGame.elapsed,snow:worldSnow&&ter!==5,style:{position:"absolute",left:round1(worldPx(c.x)-4)+"px",top:round1(worldPy(c.y)-2)+"px",transform:"rotate("+Math.round(Math.atan2(c.headingY||0,c.headingX||1)*180/Math.PI)+"deg)"}});if(mapPrints.length>90)mapPrints.shift();}printTrack[c.id]={x:c.x,y:c.y};}}
    people.push({phase:Math.floor(osGame.elapsed*6)%4,tool:tool,chat:chat,idle:pose==="still"&&!c.dead&&!c.drafted&&c.health>=22,seated:seated,child:!!c.child,id:c.id,name:c.short,showRange:selectedId===c.id&&c.drafted&&!c.dead&&c.health>=22,rangeStyle:{width:(range*2)+"px",height:(range*2)+"px",left:(16-range)+"px",top:(27-range)+"px"},armed:armed,weaponSprite:weapon?spritePath("weapon-"+weapon.kind):"",weaponStyle:{transform:"rotate("+round1(aimX<0?aimAngle-180:aimAngle)+"deg)"+(aimX<0?" scaleX(-1)":"")},sprite:seated?actorSprite(c).slice(0,-4)+(c.task.seat<2?"-east-sit.svg":"-west-sit.svg"):sleeping?actorSprite(c).slice(0,-4)+"-sleep.svg":walkingSprite(c),pose:pose,sleeping:sleeping,groundSleep:groundSleep,animate:!paused&&!dialogPausesSimulation()&&!reducedMotion&&!osGame.over&&!c.dead&&c.health>=22,left:(c.headingX||0)<0,drafted:c.drafted,dead:c.dead,carrying:!!c.carry||!!c.carryBody||!!c.kit,carryKind:c.carry?Object.keys(c.carry)[0]:(c.carryBody?"body":c.kit?"kit":""),selected:selectedId===c.id,working:pose==="work-heavy"||pose==="work-light",mark:taskMark(c),style:{left:(-WX*TILE)+"px",top:(-WY*TILE)+"px",transform:"translate("+round1(seatX+WX*TILE-16)+"px,"+round1(py+WY*TILE)+"px)"+(c.dead?" rotate(80deg)":""),opacity:c.dead?0.55:1},labelStyle:{color:c.drafted?"#ffbc82":c.colour}});
  }
  for(let i=0;i<osGame.animals.length;i++){let a=osGame.animals[i];if(!osGame.explored[tileId(a.x,a.y)]||!tileInView(a.x-1,a.y-1,2,2,bounds)||!inSight(a.x,a.y))continue;
    let size=animalSize(a.kind),pose=animalPose(a);animals.push({id:a.id,glow:!!animalStats(a.kind).flying,marked:!!a.marked,tamed:!!a.tamed,sprite:pose.sprite,poseStyle:pose.style,moving:!paused&&!dialogPausesSimulation()&&!reducedMotion&&!a.dead&&a.movingUntil>osGame.elapsed,hostile:a.hostile,attacking:!paused&&!dialogPausesSimulation()&&!reducedMotion&&!a.dead&&a.attackUntil>osGame.elapsed,style:{left:(-WX*TILE)+"px",top:(-WY*TILE)+"px",width:size+"px",height:size+"px",transform:"translate("+round1(a.x*TILE-size/2)+"px,"+round1(a.y*TILE-size/2)+"px)"+(a.dead?" rotate(90deg)":""),opacity:a.dead?0.3:1}});
  }
  for(let i=0;i<osGame.effects.length;i++){let f=osGame.effects[i];let dx=(f.bx-f.ax)*TILE,dy=(f.by-f.ay)*TILE;if(!onMap(Math.floor(f.ax),Math.floor(f.ay))||!osGame.explored[tileId(f.ax,f.ay)]||!tileInView(Math.min(f.ax,f.bx),Math.min(f.ay,f.by),Math.abs(f.bx-f.ax),Math.abs(f.by-f.ay),bounds))continue;shots.push({id:f.id,style:{position:"absolute",left:worldPx(f.ax)+"px",top:worldPy(f.ay)+"px",width:Math.sqrt(dx*dx+dy*dy)+"px",height:"2px",transform:"rotate("+(Math.atan2(dy,dx)*180/Math.PI)+"deg)",transformOrigin:"left center",background:f.kind==="acid"?"#a9e088":f.kind==="claw"?"#d76c57":f.kind==="melee"?"#d9e5df":"#f5d491",zIndex:10,opacity:reducedMotion?0.4:0.85,pointerEvents:"none"}});}
  mapColonists=people;mapAnimals=animals;mapEffects=shots;projectStoryCaption();tickFollowCamera();
}
let wallSpritesDirty=true;
let wallSpriteCache={};
function joinedWallSprite(b,cells) {
  let mask=0,other=null;
  if(b.y>WY){other=cells[tileId(b.x,b.y-1)];if(other&&(!b.built||other.built))mask+=1;}
  if(b.x<WX+MAP_SIZE-1){other=cells[tileId(b.x+1,b.y)];if(other&&(!b.built||other.built))mask+=2;}
  if(b.y<WY+MAP_SIZE-1){other=cells[tileId(b.x,b.y+1)];if(other&&(!b.built||other.built))mask+=4;}
  if(b.x>WX){other=cells[tileId(b.x-1,b.y)];if(other&&(!b.built||other.built))mask+=8;}
  return spritePath(b.kind+"-join"+mask);
}
let doorsOpenKey="";
function doorsBusy(){let key="";for(let i=0;i<mapBuildings.length;i++){let b=mapBuildings[i];if(b.kind==="door")key+=b.open?"1":"0";}let walkers=[];for(let i=0;i<osGame.people.length;i++){let c=osGame.people[i];if(!c.dead)walkers.push(c);}let now="";for(let i=0;i<mapBuildings.length;i++){let b=mapBuildings[i];if(b.kind==="door"){let src=getBuilding(b.id);now+=src&&doorInUse(src,walkers)?"1":"0";}}return now!==key;}
function doorInUse(b,walkers){for(let i=0;i<walkers.length;i++){let w=walkers[i];if(Math.abs(w.x-(b.x+.5))<1.3&&Math.abs(w.y-(b.y+.5))<1.3)return true;}return false;}
function refreshStructures() {refreshSight();
  let buildings=[],sites=[],jobs=[],activeWork={},bounds=viewportKnown?visibleWorldRect():null;
  let walkers=[];for(let i=0;i<osGame.people.length;i++){let c=osGame.people[i],t=c.task;if(c.dead||c.carried||c.buried)continue;walkers.push(c);if(t&&!t.personal&&t.phase==="work"&&t.targetId)activeWork[t.targetId]=t.type;}
  for(let i=0;i<osGame.animals.length;i++){let a=osGame.animals[i];if(!a.dead&&a.tamed)walkers.push(a);}
  if(wallSpritesDirty){
    let cells={};wallSpriteCache={};
    for(let i=0;i<osGame.buildings.length;i++){let b=osGame.buildings[i];if((b.kind==="wall"||b.kind==="door")&&onMap(b.x,b.y))cells[tileId(b.x,b.y)]=b;}
    let keys=Object.keys(cells);for(let i=0;i<keys.length;i++){let b=cells[keys[i]];wallSpriteCache[b.id]=joinedWallSprite(b,cells);}
    wallSpritesDirty=false;
  }
  for(let i=0;i<osGame.buildings.length;i++){
    let b=osGame.buildings[i],d=BUILDINGS[b.kind];if((d.underlay||d.wire)&&b.built)continue;if(!osGame.explored[tileId(b.x,b.y)]||!tileInView(b.x,b.y,b.w,b.h,bounds)||(b.built&&!inSight(b.x+b.w/2,b.y+b.h/2)))continue;
    let raised=b.kind==="wall"||b.kind==="door";
    let glow=b.built&&b.powered&&b.on&&(b.kind==="lamp"||b.kind==="heater"||b.kind==="generator"||b.kind==="archive"||b.kind==="beacon");
    let night=worldNight>0.16,canGlow=b.built&&["lamp","cookfire","kitchen","lab","clinic","workshop","archive","beacon","radio","heater","generator","chemist","smelter"].indexOf(b.kind)>=0;
    let lit=canGlow&&night&&b.on!==false&&(b.kind==="cookfire"||b.kind==="generator"||!d.power||b.powered);
    let chimney=b.built&&b.on!==false&&((b.kind==="heater"&&b.powered&&osGame.temperature<8)||(b.kind==="generator"&&!!(osGame.power&&osGame.power.generation>0))||(b.kind==="smelter"&&!!activeWork[b.id]));
    let sparks=!!activeWork[b.id]&&activeWork[b.id]==="produce"&&(b.kind==="workshop"||b.kind==="smelter"||b.kind==="fuelpress");
    let roof=b.built&&!raised&&!d.crop&&!d.underlay&&!d.wire&&b.kind!=="cookfire"&&b.kind!=="lamp"&&b.kind!=="stockpile";
    let madeCount=0;if(b.made){let mk=Object.keys(b.made);for(let k=0;k<mk.length;k++)madeCount+=b.made[mk[k]]||0;}
