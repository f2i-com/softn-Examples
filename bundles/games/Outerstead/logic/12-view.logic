  }else if(selectedType==="ruin"){
    let s=getSite(selectedId);if(!s)return;selectedCard={type:"ruin",id:s.id,name:s.name,subtitle:"HOLLOW ARCHIVE",sprite:spritePath("ruin"+osGame.sites.indexOf(s)),description:s.studied?s.text:"A sealed structure beneath the stone. Assign an explorer to recover its archive and unusual materials.",action:excavationCheck(s),progress:Math.min(100,Math.floor(s.progress/95*100)),studied:s.studied,ready:excavationCheck(s)==="Ready to explore"};
  }else if(selectedType==="animal"){
    let a=getAnimal(selectedId);if(!a)return;selectedCard={type:"animal",id:a.id,name:a.name,subtitle:a.tamed?"TAMED · GRAZING":a.hostile?"HOSTILE WILDLIFE":"NATIVE WILDLIFE",huntable:!a.hostile&&!!animalStats(a.kind).meat&&!a.tamed,marked:!!a.marked,hostile:a.hostile,tamed:!!a.tamed,taming:!!a.taming,tameable:a.kind==="mossback"&&!a.hostile&&!a.tamed&&hasTech("husbandry"),sprite:animalPose(a).sprite,description:a.kind==="lanternwing"?"A nocturnal flier that glows softly and keeps to the water. Harmless. Settlers who see them sleep a little easier.":a.kind==="raider"?"An Ashwalker after the warehouse. Raiders fight anyone within reach, take what they can carry from the racks or lifeboat, and run for the map edge. Bring them down to recover the goods.":a.kind==="pilgrim"?"Tall, pale and slow, crossing the map on business of its own. It has never been seen to hurt anyone. Settlers who watch it remember, and some of them dream.":a.kind==="maw"?"A burrowing predator drawn up by mining. Armoured, slow and hard-biting; it does not stop. Fight it at range or from behind barricades.":a.kind==="spitter"?"A glass-backed predator that spits from five tiles away. Walls block its attack; carbines outrange it.":a.kind==="mossback"?"A heavy, moss-coated herbivore. Usually peaceful; dangerous when provoked.":a.kind==="needlehare"?"A small native forager. More interested in the plants than the people.":"An aggressive frontier predator. Keep colonists together and use cover.",action:a.dead?"Dead":Math.round(a.health)+" health · "+animalActivity(a),dead:a.dead};
  }else if(selectedType==="node"){
