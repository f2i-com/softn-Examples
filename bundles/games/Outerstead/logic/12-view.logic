// A room is named for the people whose beds are in it; more than two and it is a bunkhouse.
function roomLabel(room){
  let owners=[];for(let i=0;i<osGame.buildings.length;i++){let b=osGame.buildings[i];if(b.built&&b.kind==="bed"&&b.room===room.id&&b.owner){let o=findColonist(b.owner);if(o&&!o.dead&&owners.indexOf(o.short)<0)owners.push(o.short);}}
  if(!owners.length)return room.beds>0?"Bunkroom":"Room";if(owners.length===1)return owners[0]+"'s room";if(owners.length===2)return owners[0]+" and "+owners[1]+"'s room";return "Bunkhouse";
}
