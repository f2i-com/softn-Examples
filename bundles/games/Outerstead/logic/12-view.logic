    let details=[],room=roomAt(b.x,b.y);details.push({name:"Condition",value:Math.round(b.hp)+" / "+d.hp});
    if(d.power)details.push({name:"Power demand",value:d.power+" W"});if(d.produce)details.push({name:"Generating",value:Math.round(b.output||0)+" W"});if(recipeFor(b)||hasGoods(b.input))details.push({name:"Inputs",value:bufferText(b)});if(hasGoods(b.made)){let base=baseRecipeFor(b);details.push({name:"Finished",value:costText(b.made)+(base&&madeFull(b,base)?" · output full · waiting for a hauler":" · waiting for a hauler")});}if(d.capacity)details.push({name:"Battery",value:Math.round(b.charge)+" / "+d.capacity+" Wh"});
