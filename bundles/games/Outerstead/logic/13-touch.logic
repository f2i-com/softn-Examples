// DOM pointer details are projected by the template; game logic sees plain data.
let touchControls=false;
let mapTouches={};
let touchRect=null;
let pinchState=null;
let touchSuppressed=false;
let touchPlacement=false;
function resetMapGesture() {pendingMapJump=null;mapTouches={};pinchState=null;touchRect=null;touchSuppressed=false;touchPlacement=false;pointerState=null;stopEdgePan();}
function mapPointer(kind,id,type,x,y,button,shift,tag,left,top,width,height,viewportWidth,viewportHeight) {
  if(kind==="down")pendingMapJump=null;
  // The target is the whole transformed map (or a sprite), not the clipped viewport.
  noteViewport(viewportWidth,viewportHeight);
  return withView(function(){return mapPointerInWindow(kind,id,type,x,y,button,shift,tag,left,top,width,height);});
}
function mapPointerInWindow(kind,id,type,x,y,button,shift,tag,left,top,width,height) {
  let e={pointerId:id,pointerType:type,clientX:x,clientY:y,button:button,shiftKey:shift,targetTag:tag,targetLeft:left,targetTop:top,targetWidth:width,targetHeight:height};
  if(type!=="touch"){
    if(kind==="down")onWorldPointerDown(e);if(kind==="move")onWorldPointerMove(e);if(kind==="up")onWorldPointerUp(e);if(kind==="cancel")onWorldPointerCancel();return;
  }
  if(screen!=="game"||dialog||!osGame){resetMapGesture();return;}
  if(!touchControls){touchControls=true;footerText="Tap to inspect · drag to pan · pinch to zoom";}stopEdgePan();
  if(kind==="down"){
    if(screen!=="game"||dialog||!osGame||!eventOnMap(e))return;
    mapTouches[String(id)]={x:x,y:y};let keys=Object.keys(mapTouches);
    touchPlacement=false;
    if(keys.length===1&&!touchSuppressed){touchRect={left:left,top:top,width:width,height:height};onWorldPointerDown(e);if(pointerState){pointerState.touch=true;if(toolKind!=="select"&&!panMode)pointerState.mode="touchAim";}}
    else if(keys.length===2&&!touchSuppressed){
      let a=mapTouches[keys[0]],b=mapTouches[keys[1]];
      pinchState={distance:Math.max(1,Math.sqrt(sqDistance(a.x,a.y,b.x,b.y))),mx:(a.x+b.x)/2,my:(a.y+b.y)/2,zoom:zoomLevel,panX:panX,panY:panY,cx:touchRect.left+touchRect.width/2,cy:touchRect.top+touchRect.height/2};pointerState=null;followColonistId="";
    }else{pinchState=null;pointerState=null;touchSuppressed=true;}
    return;
  }
  if(!mapTouches[String(id)])return;
  if(kind==="cancel"){delete mapTouches[String(id)];pinchState=null;pointerState=null;touchPlacement=false;touchSuppressed=Object.keys(mapTouches).length>0;return;}
  if(kind==="move"){
    mapTouches[String(id)]={x:x,y:y};let keys=Object.keys(mapTouches);
    if(pinchState&&keys.length===2){
      let a=mapTouches[keys[0]],b=mapTouches[keys[1]],p=pinchState;
      zoomLevel=clampZoom(p.zoom*Math.sqrt(sqDistance(a.x,a.y,b.x,b.y))/p.distance);
      let ratio=zoomLevel/p.zoom;
      panX=clamp(p.panX+(a.x+b.x)/2-p.mx+(p.mx-p.cx)*(1-ratio),-panLimit(),panLimit());
      panY=clamp(p.panY+(a.y+b.y)/2-p.my+(p.my-p.cy)*(1-ratio),-panLimit(),panLimit());hoverCellX=-1;hoverCellY=-1;refreshCamera();return;
    }
    if(!touchSuppressed&&pointerState){
      if(pointerState.mode==="touchAim"&&sqDistance(x,y,pointerState.clientX,pointerState.clientY)>=64){if(toolPaints())pointerState.mode="paint";else{pointerState.mode="pan";followColonistId="";}}
      onWorldPointerMove(e);
    }
    return;
  }
  if(kind==="up"){
    delete mapTouches[String(id)];
    if(pinchState||touchSuppressed){pinchState=null;pointerState=null;touchPlacement=false;touchSuppressed=Object.keys(mapTouches).length>0;return;}
    if(pointerState&&pointerState.mode==="touchAim"){
      let p=canvasPosition(e,pointerState.rect);pointerState=null;
      if(p){hoverCellX=p.x;hoverCellY=p.y;touchPlacement=true;refreshCamera();}return;
    }
    onWorldPointerUp(e);
    // Leave the map available after a touch order; selection can be reopened from the roster.
    if(selectedType==="colonist"){let c=findColonist(selectedId);if(c&&c.drafted)mobilePanelOpen=false;}
  }
}
function applyTouchTool() {
  if(screen!=="game"||!touchPlacement||hoverCellX<0||hoverCellY<0||dialog||!osGame)return;
  let x=hoverCellX,y=hoverCellY;touchPlacement=false;
  pointerState={mode:"paint",x:x,y:y,rect:{left:0,top:0,width:MAP_SIZE,height:MAP_SIZE}};
  onWorldPointerUp({clientX:x-WX+.5,clientY:y-WY+.5});
}
function rightClickMap(e) {
  pointerState=null;touchPlacement=false;stopEdgePan();
  if(toolKind!=="select"||panMode){cancelTool();say("Tool cancelled.");return;}
  let p=canvasPosition(e);if(!p)return;
  let c=selectedType==="colonist"?findColonist(selectedId):null;
  if(c&&c.rover&&!c.dead&&c.rover.party){say(c.short+" is walking with a party. Bring the party home from the Frontier chart if you need them back.");return;}
  if(c&&c.rover&&!c.dead){if(!tileMade(p.x,p.y)){say("That ground is still unmade. Send them toward it and the country will appear as they walk.");return;}roverOrder(c,p.x,p.y);say(c.short+" is walking. The country is made as they reach it.");refreshAll();return;}
  if(c&&!c.dead&&c.health>=22){
    if(!osGame.explored[tileId(p.x,p.y)]){say("Survey that ground before issuing orders.");return;}
    let enemy=null;for(let i=0;i<osGame.animals.length;i++){let a=osGame.animals[i];if(!a.dead&&sqDistance(a.x,a.y,p.x+.5,p.y+.5)<1.3){enemy=a;break;}}
    if(!enemy&&findPath(c.x,c.y,p.x,p.y)===null){say("No safe path to that position.");return;}
    releaseTask(c,true);cancelWeaponPickup(c);c.order=null;c.combatTarget="";c.drafted=true;c.autoDefend=false;
    commandColonist(c,p.x,p.y,enemy?enemy.id:"");mobilePanelOpen=false;refreshAll();say(c.short+(enemy?" is targeting "+enemy.name:" is moving in command mode")+". Stand down to resume work.");return;
  }
  cancelTool();say("Selection cleared. Select a settler, then right-click to give an order.");
}
