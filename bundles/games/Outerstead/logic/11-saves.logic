String(fc.by,40,"far camp founder");}}if(g.facets!==undefined){requireRecord(g.facets,"facets");if(FACET_STATES.indexOf(g.facets.state)<0||FACET_KNOWERS.indexOf(g.facets.knows)<0||FACET_CONNECTIONS.indexOf(g.facets.connection)<0||FACET_COMPLICATIONS.indexOf(g.facets.complication)<0)failSave("Unknown facet.");}if(g.cast!==undefined){requireRecord(g.cast,"cast");let ck=Object.keys(g.cast);for(let k=0;k<ck.length;k++){if(CAST_KEYS.indexOf(ck[k])<0)failSave("Invalid cast role.");boundedString(g.cast[ck[k]],40,"cast member");}}if(g.director!==undefined){requireRecord(g.director,"director");boundedNumber(g.director.lastStoryAt||0,0,100100000,"director clock");boundedNumber(g.director.lastClueAt||0,0,100100000,"director clue clock");}
  if(g.birthPending!==undefined&&g.birthPending!==null){requireRecord(g.birthPending,"pending birth");boundedString(g.birthPending.a,40,"parent");boundedString(g.birthPending.b,40,"parent");listBound(g.birthPending.names,2,"child names");if(g.birthPending.names.length!==2)failSave("Two names are needed.");for(let k=0;k<2;k++)boundedString(g.birthPending.names[k],30,"child name");}
  if(g.funeral!==undefined&&g.funeral!==null){requireRecord(g.funeral,"funeral");boundedString(g.funeral.graveId,40,"funeral grave");boundedString(g.funeral.deadId,40,"funeral settler");boundedString(g.funeral.name,30,"funeral name");boundedNumber(g.funeral.until,0,100100000,"funeral clock");boundedNumber(g.funeral.attended,0,64,"funeral attendance");if(g.funeral.speaker!==undefined)boundedString(g.funeral.speaker,30,"funeral speaker");}
  for(let i=0;i<g.nodes.length;i++){if(Array.isArray(g.nodes[i]))g.nodes[i]=decodeNode(g.nodes[i]);let n=g.nodes[i];identity(n);position(n);if(n.x%1||n.y%1||["tree","stone","ore","berries","pile","glass"].indexOf(n.kind)<0)failSave("Invalid resource node.");if(n.debris!==undefined&&typeof n.debris!=="boolean")failSave("Invalid debris flag.");boundedNumber(n.amount,0,1000000,"resource quantity");if(n.kind==="pile"&&RESOURCE_KEYS.indexOf(n.resource)<0)failSave("Invalid resource crate.");}
  for(let i=0;i<g.animals.length;i++){let a=g.animals[i];identity(a);position(a);path(a);if(!ANIMAL_STATS[a.kind])failSave("Unknown wildlife.");boundedNumber(a.health,-1000,200,"wildlife health");if(a.headingX!==undefined)boundedNumber(a.headingX,-1,1,"wildlife heading");if(a.headingY!==undefined)boundedNumber(a.headingY,-1,1,"wildlife heading");if(a.movingUntil!==undefined)boundedNumber(a.movingUntil,0,100000001,"wildlife movement time");if(a.diedAt!==undefined)boundedNumber(a.diedAt,0,100100000,"wildlife death time");if(a.loot!==undefined&&a.loot!==null)validateGoods(a.loot,"raider loot");if(a.lootTarget!==undefined)boundedString(a.lootTarget,40,"raid target");if(a.fleeing!==undefined&&typeof a.fleeing!=="boolean")failSave("Invalid raider state.");if(a.goalX!==undefined)boundedNumber(a.goalX,-1000000,1000000,"pilgrim goal");if(a.goalY!==undefined)boundedNumber(a.goalY,-1000000,1000000,"pilgrim goal");if(a.flyX!==undefined)boundedNumber(a.flyX,-1000000,1000000,"flight target");if(a.flyY!==undefined)boundedNumber(a.flyY,-1000000,1000000,"flight target");if(a.campId!==undefined)boundedString(a.campId,40,"camp reference");if(a.marked!==undefined&&typeof a.marked!=="boolean")failSave("Invalid hunt mark.");if(a.tamed!==undefined&&typeof a.tamed!=="boolean")failSave("Invalid tamed flag.");if(a.taming!==undefined&&typeof a.taming!=="boolean")failSave("Invalid taming flag.");if(a.penId!==undefined)boundedString(a.penId,40,"pen");if(a.grazeAt!==undefined)boundedNumber(a.grazeAt,0,100100000,"graze clock");if(a.structureTarget!==undefined)boundedString(a.structureTarget,40,"structure target");if(a.structureAt!==undefined)boundedNumber(a.structureAt,0,100100000,"structure clock");if(a.defending!==undefined&&typeof a.defending!=="boolean")failSave("Invalid defender state.");if(a.gone)failSave("Departed creatures cannot be saved.");}
  for(let i=0;i<g.sites.length;i++){let s=g.sites[i];identity(s);position(s);boundedString(s.text,3000,"archive");boundedString(s.name,100,"ruin name");boundedNumber(s.progress,0,100,"excavation");}
  for(let i=0;i<g.jobs.length;i++){let j=g.jobs[i];identity(j);if(WORK_KEYS.indexOf(j.category)<0)failSave("Invalid job category.");if(["build","repair","gather","sow","harvest","research","produce","treat","excavate","survey","strike","bury","rescue","supply","collect","hunt","tame"].indexOf(j.type)<0)failSave("Invalid job type.");boundedNumber(j.x,-1000000,1000000,"job position");boundedNumber(j.y,-1000000,1000000,"job position");}
  let dictionaries=["tech","researchProgress","policy","objectives","achievements","stats","standing","trades","storySeen"];for(let i=0;i<dictionaries.length;i++)requireRecord(g[dictionaries[i]],dictionaries[i]);
  let tk=Object.keys(g.tech);for(let i=0;i<tk.length;i++)if(!techById(tk[i])||typeof g.tech[tk[i]]!=="boolean")failSave("Unknown technology.");
  if(g.researchId&&!techById(g.researchId))failSave("Unknown research project.");
  if(g.researchQueue!==undefined){listBound(g.researchQueue,8,"research queue");for(let i=0;i<g.researchQueue.length;i++)if(!techById(g.researchQueue[i]))failSave("Unknown queued research.");}
  let rk=Object.keys(g.researchProgress);for(let i=0;i<rk.length;i++){if(!techById(rk[i]))failSave("Unknown research progress.");boundedNumber(g.researchProgress[rk[i]],0,1000000,"research progress");}
  let clocks=["jobClock","needsClock","environmentClock","socialClock","directorClock"];for(let i=0;i<clocks.length;i++)boundedNumber(g[clocks[i]],0,100000000,clocks[i]);
  let pk=Object.keys(g.policy);for(let i=0;i<pk.length;i++){if(["meals","parts","metal","fuel","medicine"].indexOf(pk[i])<0)failSave("Unknown production target.");boundedNumber(g.policy[pk[i]],0,300,"production target");}
  boundedNumber(g.storyStage,0,3,"story stage");boundedNumber(g.nextEvent,0,100100000,"event clock");boundedNumber(g.weatherUntil,0,100100000,"weather clock");boundedString(g.weather,32,"weather");
  for(let i=0;i<g.eventQueue.length;i++){let e=g.eventQueue[i];if(["attack","storm"].indexOf(e.kind)<0)failSave("Unknown queued event.");boundedNumber(e.due,0,100100000,"event date");if(e.kind==="attack")boundedNumber(e.count,1,8,"attack size");if(e.kinds!==undefined){listBound(e.kinds,8,"attack kinds");for(let k=0;k<e.kinds.length;k++)if(!ANIMAL_STATS[e.kinds[k]]||!ANIMAL_STATS[e.kinds[k]].hostile)failSave("Unknown attacker.");}}
  validateModStories(g);
  if(g.pendingEvent&&!STORY_EVENTS[g.pendingEvent.id])failSave("Unknown pending event.");
  if(g.autoMode!==undefined&&typeof g.autoMode!=="boolean")failSave("Invalid auto mode.");
  g.autoMode=!!g.autoMode;
  if(g.autoBuild!==undefined&&typeof g.autoBuild!=="boolean")failSave("Invalid auto-build setting.");
  if(g.autoConfigured!==undefined&&typeof g.autoConfigured!=="boolean")failSave("Invalid auto production setting.");
  if(g.autoPlanAt!==undefined)boundedNumber(g.autoPlanAt,0,100100000,"auto plan clock");
  g.autoBuild=!!g.autoBuild;g.autoConfigured=!!g.autoConfigured;g.autoPlanAt=g.autoPlanAt||0;
  if(g.coldChain){requireRecord(g.coldChain,"cold chain");boundedNumber(g.coldChain.lost,0,1000000,"cold chain losses");if(typeof g.coldChain.active!=="boolean"||typeof g.coldChain.reported!=="boolean")failSave("Invalid cold chain state.");}
  if(g.campaign!==undefined){requireRecord(g.campaign,"campaign");boundedNumber(g.campaign.chapter,0,CAMPAIGN_CHAPTERS.length,"campaign chapter");if(g.campaign.chapter%1)failSave("Invalid campaign chapter.");requireRecord(g.campaign.done,"campaign progress");let ck=Object.keys(g.campaign.done);for(let i=0;i<ck.length;i++)if(!campaignKeyValid(ck[i])||g.campaign.done[ck[i]]!==true)failSave("Invalid campaign progress.");boundedString(g.campaign.beat,40,"campaign beat");if(g.campaign.beat&&!campaignById(g.campaign.beat))failSave("Unknown campaign beat.");}
  if(g.tagAt!==undefined)boundedNumber(g.tagAt,0,100100000,"tag clock");if(g.choirAt!==undefined)boundedNumber(g.choirAt,0,100100000,"choir clock");if(g.ashwalkerPeace!==undefined&&typeof g.ashwalkerPeace!=="boolean")failSave("Invalid Ashwalker state.");
  if(g.standing.Choir===undefined)g.standing.Choir=0;
  if(g.threats!==undefined){requireRecord(g.threats,"threats");boundedNumber(g.threats.nextAt,0,100100000,"threat clock");boundedNumber(g.threats.wildAt,0,100100000,"wildlife clock");boundedNumber(g.threats.waves,0,1000000,"threat waves");}
  validateEventSettings(g);validateSavedMods(g);g.nextId=Math.max(g.nextId,maxId+1);g.effects=[];return g;
}
function restoreSettlement(g) {
  resetSight();roverRouteSearches={};pendingMapJump=null;roverContexts={};viewRoverId="";viewMode="main";viewWindow=null;atlasSrc="";atlasBuiltKeys="";atlasSvgCache={};refCache={};refCacheKeys=[];if(!g.atlas)g.atlas={};
  for(let i=0;i<g.people.length;i++){let c=g.people[i];if(c.rover){c.path=[];c.pathCursor=0;c.pathEpoch=-1;}}
  setMapSize(g.mapSize||96);if(!g.chunks)g.chunks={"0,0":true};if(!g.window)g.window={x:0,y:0};WX=g.window.x;WY=g.window.y;if(!g.plane)g.plane={};if(g.homeOrigin===undefined)g.homeOrigin=CENTRE-HOME_SIZE/2;if(g.centre&&typeof g.centre.x==="number")CENTRE=g.centre.x;else g.centre={x:CENTRE,y:CENTRE};if(!g.farCamps)g.farCamps=[];
  resetMapGesture();invalidateMods();incidentFx=null;clearVisualFx();
  jobLookup={};colonistLookup={};wallSpritesDirty=true;minimapSrc="";minimapRows=[];
  osGame=g;autoMode=!!g.autoMode;stopEdgePan();objectIndex={};nodeIndex={};nodeAtCell=[];pathEpoch=0;navSerial=0;navSeen=[];navClosed=[];navCost=[];navFrom=[];
  for(let i=0;i<g.nodes.length;i++){let n=g.nodes[i];nodeIndex[n.id]=n;if(n.amount>0)nodeAtCell[tileId(n.x,n.y)]=n.id;}
  topologyDirty=true;terrainDirty=true;serviceTopology();
  initialiseWeapons();
  // Saves from before 0.24 begin the campaign at whatever chapter their colony has already earned.
  let hadCampaign=!!g.campaign;campaignState();threatState();if(!hadCampaign)updateCampaign(true);
  for(let i=0;i<g.people.length;i++){g.people[i].attackUntil=0;g.people[i].hurtUntil=0;g.people[i].equippedUntil=0;if(g.people[i].health<22){cancelWeaponPickup(g.people[i]);dropWeapon(g.people[i]);}}
  for(let i=0;i<g.people.length;i++)g.people[i].pathEpoch=pathEpoch;
  // Saves from before quirks existed: the same hash gives the same habits on every load.
  if(g.widowPending&&!g.widowQueue){let w=findColonist(g.widowPending);if(w)g.widowQueue=[{survivor:w.id,lost:w.partner||""}];}g.widowPending="";
  for(let i=0;i<g.people.length;i++){if(!Array.isArray(g.people[i].quirks))assignQuirks(g.people[i]);if(!g.people[i].values)assignValues(g.people[i]);}
  for(let i=0;i<g.animals.length;i++)g.animals[i].pathEpoch=pathEpoch;
  paused=true;gameSpeed=1;screen="game";mobilePanelOpen=false;panMode=false;followColonistId="";activePanel="overview";selectedId="";selectedType="";pointerState=null;toolKind="select";loopAccumulator=0;realSaveClock=0;panX=0;panY=30;zoomLevel=0.95;
  registerModStories();
  if(g.pendingEvent&&g.pendingEvent.id==="funeral")buildFuneralChoices();
  if(g.pendingEvent&&g.pendingEvent.id==="newName")buildBirthChoices();
  if(g.pendingEvent&&g.pendingEvent.id==="ofAge")buildOfAgeChoices();
  storyCard=g.pendingEvent?mysteryStory(g.pendingEvent.id,STORY_EVENTS[g.pendingEvent.id]):null;dialog=g.pendingEvent&&!storyCaptions?"story":"";if(storyCard){storyTimerTotal=storyTimeout(storyCard);storyTimer=storyTimerTotal;}
  if(g.over){archiveTitle="The last light";archiveBody="This settlement's chronicle has ended. Start a new expedition from the menu.";dialog="ending";}
  refreshAll();refreshMods();
}
function loadSaveText(text) {
  let previous=osGame;
  try{let g=validateSave(text);restoreSettlement(g);saveMessage="Settlement restored. Simulation is paused.";let missing=missingModCount();if(missing){saveMessage+=" "+missing+" active mod(s) unavailable. Open User mods to inspect.";modStatus=saveMessage;}say(saveMessage);return true;}
  catch(error){if(osGame!==previous&&previous)restoreSettlement(previous);else if(previous){setMapSize(previous.mapSize||96);CENTRE=previous.centre?previous.centre.x:CENTRE;WX=previous.window?previous.window.x:0;WY=previous.window?previous.window.y:0;}saveMessage="Could not load: "+String(error.message||error);say(saveMessage);return false;}
}
function slotKey(kind,index) {return SAVE_PREFIX+kind+index;}
function saveSlot(index,automatic) {
  if(!osGame)return false;let kind=automatic?"auto":"manual",key=slotKey(kind,index);
  try{let text=snapshotText();localStorage.setItem(key,text);let check=localStorage.getItem(key);if(check!==text)throw new Error("The host did not retain the save.");
    localStorage.setItem(SAVE_PREFIX+"latest",key);if(localStorage.getItem(SAVE_PREFIX+"resume")!=="1")localStorage.setItem(SAVE_PREFIX+"resume","1");saveAvailable=true;saveMessage=(automatic?"Autosaved":"Saved")+" "+osGame.name+" · Sol "+dayNow()+".";if(!automatic)say(saveMessage);refreshSlots();return true;
  }catch(error){saveMessage="Local storage failed: "+String(error.message||error)+". Use Export text to preserve the colony.";say(saveMessage);return false;}
}
function loadSlot(index,automatic) {
  try{let text=localStorage.getItem(slotKey(automatic?"auto":"manual",index));if(!text){say("That slot is empty.");return false;}return loadSaveText(text);}catch(error){saveMessage=String(error.message||error);say(saveMessage);return false;}
}
function refreshSlots() {
  let cards=[];
  for(let a=0;a<2;a++)for(let i=0;i<3;i++){let label=(a?"Autosave ":"Manual ")+(i+1),description="Empty",filled=false;
    try{let text=localStorage.getItem(slotKey(a?"auto":"manual",i));if(text){let data=JSON.parse(text);description=data.game.name+" · Sol "+(Math.floor(data.game.minutes/1440)+1);filled=true;}}catch(error){description="Unreadable slot";}
    cards.push({id:(a?"auto":"manual")+i,index:i,automatic:a===1,label:label,description:description,filled:filled});
  }slotCards=cards;saveAvailable=false;for(let i=0;i<cards.length;i++)if(cards[i].filled)saveAvailable=true;
}
function resumeLatest() {
  try{let key=localStorage.getItem(SAVE_PREFIX+"latest");let text=key?localStorage.getItem(key):null;if(text&&loadSaveText(text))return;}
  catch(error){saveMessage="Last save unavailable.";}
  refreshSlots();dialog="saves";say("Choose a saved settlement or paste an exported save.");
}
function exportChronicle() {
  if(!osGame)return;
  let lines=[osGame.name+" · Hollow-7 · Sol "+dayNow(),"Outerstead First Light "+OS_VERSION,""];
  let s=osGame.stats,t=osGame.threats||{waves:0};
  lines.push("THE RECORD","People who called it home: "+osGame.people.length,"Died here: "+s.deaths,"Born here: "+(s.births||0),"Harvests: "+s.harvests,"Meals cooked: "+Math.floor(s.mealsCooked),"Discoveries: "+Object.keys(osGame.tech).length,"Archives recovered: "+s.studied+" of 3","Predators brought down: "+s.attacks,"Waves survived: "+(t.waves||0),"Raids suffered: "+(s.raided||0)+" · camps broken: "+(s.campsBroken||0),"Ridge: "+(osGame.ridgeName||"Unnamed"),"");
  lines.push("THE CHRONICLE (most recent first)","");
  for(let i=0;i<osGame.chronicle.length;i++){let e=osGame.chronicle[i];lines.push("SOL "+e.sol+" · "+clockText(e.minute)+" · "+e.title);if(e.body)lines.push("  "+e.body.replace(/\n+/g," "));lines.push("");}
  saveText=lines.join("\n");resetMapGesture();paused=true;dialog="saves";refreshSlots();
  if(!downloadText(saveFileName("-chronicle.txt"),saveText,"text/plain;charset=utf-8","Downloaded {name}. The chronicle text is also below."))saveMessage="The chronicle is in the text box below. Select all, copy, and keep it wherever you like.";
}
function openSaves() {resetMapGesture();paused=true;dialog="saves";saveText="";saveMessage="Three manual slots and three rotating autosaves. Refreshing or closing the page autosaves and resumes. Download a save file to keep a copy outside the browser.";refreshSlots();}
// Files: the host hands the browser a download and opens its file picker. Text stays as the fallback.
function filesAvailable() {return typeof softn!=="undefined"&&!!softn.files&&typeof softn.files.saveFile==="function";}
function saveFileName(suffix) {return ("Outerstead-"+(osGame?osGame.name:"colony")+"-Sol"+(osGame?dayNow():0)).replace(/[^A-Za-z0-9._-]+/g,"-")+suffix;}
function downloadText(name,text,mime,doneMessage) {
  if(!filesAvailable())return false;
  saveMessage="Preparing "+name+"…";
  try{softn.files.saveFile(name,text,{mime:mime},function(result){saveMessage=result&&result.ok?doneMessage.replace("{name}",result.name||name):"The download was not available: "+(result&&result.error?result.error:"unknown host error")+". The text below still works.";});}
  catch(error){saveMessage="The download failed: "+String(error.message||error)+". Copy the text below instead.";}
  return true;
}
function exportSave() {
  try{saveText=snapshotText();
    if(!downloadText(saveFileName(".json"),saveText,"application/json","Downloaded {name} to the browser download folder. The same text is below if you ever need it."))saveMessage="Select and copy the text below into a .json file. Keep it outside the browser before updating the app.";
  }catch(error){saveMessage=String(error.message||error);}
}
function importSaveFile() {
  if(!filesAvailable()||typeof softn.files.pickFile!=="function"||typeof softn.files.readText!=="function"){saveMessage="Choosing files is not available in this host. Paste the save text instead.";return;}
  saveMessage="Choose an Outerstead .json save file.";
  try{softn.files.pickFile({accept:".json,application/json,text/plain",multiple:false},function(files){
    if(!files||!files.length||!files[0]||!files[0].ref){saveMessage="No file was chosen.";return;}
    softn.files.readText(files[0].ref,function(result){
      let text=typeof result==="string"?result:(result&&typeof result.text==="string"?result.text:(result&&typeof result.value==="string"?result.value:""));
      if(!text){saveMessage="That file could not be read"+(result&&result.error?": "+result.error:".");return;}
      saveText=text;if(loadSaveText(text))saveMessage="Restored from "+files[0].name+". The colony is paused.";
    });
  });}catch(error){saveMessage="The file picker failed: "+String(error.message||error);}
}
// Every save marks the session for automatic resume (saveSlot), so a refresh opens the latest save.
// Leaving or refreshing the page still autosaves, but a host that keeps saves outside the page (FormLogic)
// may lose a save made as the page closes, so resuming does not depend on it.
function onGameUnload() {
  try{if(screen==="game"&&osGame&&!osGame.over){saveSlot(autosaveIndex,true);autosaveIndex=(autosaveIndex+1)%3;}}catch(error){/* Nothing to do at unload. */}
}
// The player chose the title screen or a new settlement: a refresh opens the title, not the last save.
function clearResume() {try{if(localStorage.getItem(SAVE_PREFIX+"resume")!==null)localStorage.removeItem(SAVE_PREFIX+"resume");}catch(error){/* Nothing to clear. */}}
// Switching tabs, minimising or locking a phone saves over the newest autosave, at most every 15 seconds,
// without rotating, so frequent switching does not use up the three autosaves. Where the logic cannot see
// the document (SoftN's ZIPP engine passes the window's events in, not the document), either change saves.
let lastHiddenSave = 0;
function onGameHidden() {
  if(typeof document!=="undefined"&&document&&typeof document.visibilityState==="string"&&document.visibilityState!=="hidden")return;
  let now=perfNow();if(now-lastHiddenSave<15000)return;lastHiddenSave=now;
  try{if(screen==="game"&&osGame&&!osGame.over)saveSlot((autosaveIndex+2)%3,true);}catch(error){/* The periodic autosave still runs. */}
}
function resumeFromLastSession() {
  try{
    if(localStorage.getItem(SAVE_PREFIX+"resume")!=="1")return false;
    let key=localStorage.getItem(SAVE_PREFIX+"latest"),text=key?localStorage.getItem(key):null;
    if(text&&loadSaveText(text)){finishOpening();say("Restored from your last session. The colony is paused.");return true;}
  }catch(error){/* Fall through to the title. */}
  return false;
}
function importSave() {if(!saveText.trim()){saveMessage="Paste an Outerstead save first.";return;}loadSaveText(saveText);}
