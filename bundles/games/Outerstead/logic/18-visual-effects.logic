// Bounded presentation-only effects. They never consume simulation RNG or enter saves.
let visualFx=[];
let visualFxViews=[];
let visualFxSerial=0;
function clearVisualFx(){visualFx=[];visualFxViews=[];}
function emitVisualFx(kind,x,y,damage){
 if(!osGame||!Number.isFinite(x)||!Number.isFinite(y))return;
 if(["hit","acid-hit","muzzle","explosion","fire","impact","surge","debris"].indexOf(kind)<0)return;
 let duration=kind==="fire"?12:kind==="impact"?4:kind==="explosion"?3:kind==="muzzle"?.35:kind==="surge"?2:1.4;
 if(kind==="fire"){for(let f of visualFx)if(f.kind===kind&&f.x===x&&f.y===y){f.until=osGame.elapsed+duration;viewDirty=true;return;}}
 visualFx.push({id:++visualFxSerial,kind:kind,x:x,y:y,damage:damage>0?Math.max(1,Math.round(damage)):0,until:osGame.elapsed+duration});
 if(visualFx.length>48)visualFx.splice(0,visualFx.length-48);
 viewDirty=true;
}
function projectVisualFx(){
 if(!osGame){clearVisualFx();return;}
 visualFx=visualFx.filter(function(f){return f.until>osGame.elapsed;});
 let views=[];
 for(let f of visualFx){
  let x=Math.floor(f.x),y=Math.floor(f.y);if(!onMap(x,y)||!osGame.explored[tileId(x,y)]||!tileInView(x-2,y-3,4,5))continue;
  let large=f.kind==="explosion"||f.kind==="impact"||f.kind==="fire",size=large?112:f.kind==="muzzle"?24:48;
  views.push({id:f.id,kind:f.kind,damage:f.damage?"−"+f.damage:"",style:{left:(worldPx(f.x)-size/2)+"px",top:(worldPy(f.y)-size*.72)+"px",width:size+"px",height:size+"px"}});
 }
 visualFxViews=views;
}
function hasFlareTarget(){return osGame.buildings.some(function(b){return b.built&&["generator","fuelpress"].indexOf(b.kind)>=0;});}
function resolveFuelFlare(vented){
 let targets=osGame.buildings.filter(function(b){return b.built&&["generator","fuelpress"].indexOf(b.kind)>=0;});
 if(!targets.length){chronicle("The vent settles","There is no fuel equipment at risk.","weather");return;}
 let b=pick(targets),x=b.x+b.w/2,y=b.y+b.h/2,damage=vented?0:30*eventDamageFactor();
 if(damage>0){b.hp=Math.max(1,b.hp-damage);emitVisualFx("explosion",x,y,0);emitVisualFx("fire",x,y,0);generateJobs();addJob("repair",b.id,"build",b.x,b.y,18);chronicle("A flare at the fuel vent",BUILDINGS[b.kind].name+" is damaged. The contained fuel burns off; builders can repair the equipment.","danger");playCue("warning");}
 else{emitVisualFx("surge",x,y,0);chronicle("The fuel vent holds","The pressure is released safely. No equipment was damaged.","colony");}
 tickPower(0);viewDirty=true;
}
