// Persistent people, needs, memories, injuries, and reciprocal social history.
function createColonist(profile,x,y) {
  let p=JSON.parse(JSON.stringify(profile));
  p.id=entityId("c");p.x=x+0.5;p.y=y+0.5;p.health=100;p.food=85;p.rest=85;p.recreation=75;p.mood=72;p.bleed=0;p.injuries=[];p.memories=[];p.relations={};
  p.priorities={};for(let i=0;i<WORK_KEYS.length;i++){let k=WORK_KEYS[i];p.priorities[k]=p.skills[k]>=8?1:(p.skills[k]>=5?2:3);}
  p.schedule="day";p.task=null;p.path=[];p.pathCursor=0;p.pathEpoch=-1;p.pathFailed=false;p.destination=null;p.carry=null;p.dead=false;p.drafted=false;p.combatTarget="";p.order=null;p.facing=1;p.action="Awaiting orders";p.waitUntil=0;p.lastShot=0;p.breakUntil=0;p.breakCooldown=0;
  if(!p.personality)p.personality={empathy:40+randomInt(0,50),nerve:p.role==="Survey ranger"?85:45+randomInt(0,35),discipline:50+randomInt(0,40),curiosity:45+randomInt(0,45),sociability:35+randomInt(0,55)};
  delete p.ties;delete p.profileId;delete p.motto;delete p.years;
  assignQuirks(p);assignValues(p);p.exposure=0;
  osGame.people.push(p);remember(p,"We made it to the surface",8,1440*2);return p;
}
// Four chairs per table; reservations live on tasks and release with them.
function isDiningTable(b){return b&&b.built&&b.on&&(b.kind==="table"||b.kind==="recreation");}
function tableSeats(b){return [{x:b.x-1,y:b.y,seat:0},{x:b.x-1,y:b.y+1,seat:1},{x:b.x+b.w,y:b.y,seat:2},{x:b.x+b.w,y:b.y+1,seat:3}];}
function tableSeatFree(c,b,p){
 if(!passable(p.x,p.y))return false;
 for(let other of osGame.people){let t=other.task;if(other.id!==c.id&&!other.dead&&t&&t.targetId===b.id&&t.seat===p.seat)return false;}
 return true;
}
function startTableTask(c,type,inputs){
 let tables=nearestBuilding(c,["table","recreation"],false);
 for(let i=0;i<Math.min(4,tables.length);i++){let b=tables[i];if(sqDistance(c.x,c.y,b.x,b.y)>576)continue;
  let seats=tableSeats(b);seats.sort(function(a,b){return sqDistance(c.x,c.y,a.x,a.y)-sqDistance(c.x,c.y,b.x,b.y);});
  for(let p of seats)if(tableSeatFree(c,b,p)&&routeTo(c,p,true)){
   c.task={type:type,personal:true,phase:"travel",targetId:b.id,seat:p.seat,progress:0,committed:false};
   if(inputs){c.task.inputs=inputs;stockTake(inputs);}c.action=type==="eat"?"Taking a meal to a table":"Going to sit at a table";return true;
  }
 }return false;
}
function validTableSeat(c){let t=c.task,b=t?getBuilding(t.targetId):null;if(!t||t.seat===undefined||!isDiningTable(b))return null;let p=tableSeats(b)[t.seat];return p&&passable(p.x,p.y)?p:null;}
function seatedAtTable(c){let p=validTableSeat(c);return !!p&&!c.dead&&!c.drafted&&c.health>=22&&c.task.phase==="work"&&sqDistance(c.x,c.y,p.x+.5,p.y+.5)<.05;}
function faceTable(c){if(seatedAtTable(c)){c.headingX=c.task.seat<2?1:-1;c.headingY=0;c.facing=c.headingX;}}

// The kitchen count is settled when the meal is taken from the shelf, not when it is eaten: the reservation
// carries the answer, and a cancelled meal puts both the meal and its quality back.
function reserveMealQuality(c,quality){if(!c.task)return;c.task.qualityMeal=!!quality;if(quality)osGame.qualityMeals=Math.max(0,(osGame.qualityMeals||0)-1);}
function startNeedTask(c) {
  if(c.food<45&&(osGame.stock.meals>=1||osGame.stock.raw>=2)){
    let inputs=osGame.stock.meals>=1?{meals:1}:{raw:2},quality=!!inputs.meals&&(osGame.qualityMeals||0)>=1;
    if(startTableTask(c,"eat",inputs)){reserveMealQuality(c,quality);return true;}
    let places=nearestBuilding(c,["stockpile","lander"],false),ok=false;
    for(let i=0;i<places.length;i++)if(routeTo(c,places[i],false)){c.task={type:"eat",personal:true,phase:"travel",targetId:places[i].id,progress:0,inputs:inputs,committed:false};stockTake(inputs);reserveMealQuality(c,quality);ok=true;break;}
    if(ok){c.action="Getting something to eat";return true;}
  }
  let h=hourNow(),sleepTime=c.schedule==="night"?(h>8&&h<16):(h>21||h<5);
  let emergency=false;if(osGame.autoMode&&osGame.coldChain&&osGame.coldChain.active&&c.priorities.build&&c.rest>40&&c.food>30){for(let i=0;i<osGame.jobs.length;i++){let j=osGame.jobs[i],b=getBuilding(j.target);if(j.type==="repair"&&!j.claimed&&b&&(BUILDINGS[b.kind].produce||BUILDINGS[b.kind].wire||b.kind==="freezer")){emergency=true;break;}}}
  if(c.rest<25||(sleepTime&&c.rest<78&&c.schedule!=="flexible"&&!emergency)){
    let beds=nearestBuilding(c,c.health<60?["clinic","bed","bedroll"]:["bed","bedroll"],true);
    let openSky=hasQuirk(c,"openSky")&&osGame.weather!=="Glass Wind",partnerRoom=-1;
    if(c.partner){for(let i=0;i<osGame.buildings.length;i++){let x=osGame.buildings[i];if(x.built&&x.kind==="bed"&&x.owner===c.partner&&x.room>=0)partnerRoom=x.room;}}
    beds.sort(function(a,b){let ac=(a.kind==="bedroll"?100:0)+(a.room<0?(openSky?-25:25):0)+(a.owner===c.id?-20:0)+(partnerRoom>=0&&a.room===partnerRoom?-30:0)+sqDistance(c.x,c.y,a.x,a.y)*0.1;let bc=(b.kind==="bedroll"?100:0)+(b.room<0?(openSky?-25:25):0)+(b.owner===c.id?-20:0)+(partnerRoom>=0&&b.room===partnerRoom?-30:0)+sqDistance(c.x,c.y,b.x,b.y)*0.1;return ac-bc;});
    for(let i=0;i<beds.length;i++)if(routeTo(c,beds[i],true)){beds[i].reservedBy=c.id;c.task={type:"sleep",personal:true,phase:"travel",targetId:beds[i].id,progress:0};c.action="Going to bed";return true;}
    c.task={type:"sleep",personal:true,phase:"work",targetId:"",progress:0};c.action="Sleeping on the ground";return true;
  }
  if(c.recreation<25){
    if(startTableTask(c,"recreation",null))return true;
    let places=nearestBuilding(c,["memorial"],false);
    for(let i=0;i<places.length;i++)if(routeTo(c,places[i],false)){c.task={type:"recreation",personal:true,phase:"travel",targetId:places[i].id,progress:0};c.action="Taking a breather";return true;}
  }
  return false;
}
function updateNeedTask(c,dt) {
  if(!c.task)return;
  if(c.task.seat!==undefined&&!validTableSeat(c)){releaseTask(c,true);return;}
  if(c.task.leisure){updateLeisure(c,dt);return;}
  let t=c.task;if(t.phase==="travel"){
    let done=walkPath(c,dt,2.2);if(c.pathFailed){releaseTask(c,true);c.waitUntil=osGame.elapsed+3;return;}if(done)t.phase="work";return;
  }
  faceTable(c);t.progress+=dt;
  if(t.type==="eat"){
    c.action=seatedAtTable(c)?"Eating at a table":"Eating";
    if(t.progress>=3.5){let cooked=t.inputs.meals;c.food=clamp(c.food+(cooked?57:36),0,100);t.committed=true;
      let b=getBuilding(t.targetId),quality=cooked&&!!t.qualityMeal;remember(c,cooked?(quality?"A proper hot meal":"A simple, filling meal"):"Ate raw ingredients",cooked?(hasQuirk(c,"bigEater")?7:4):-3,600);
      if(seatedAtTable(c))remember(c,"Ate at a table",3,600);finishTask(c);
    }
  }else if(t.type==="sleep"){
    let b=getBuilding(t.targetId),room=b?roomAt(b.x,b.y):null,comfort=room?room.comfort:0,temp=room?room.temp:osGame.temperature;
    let warmth=temp>=18&&temp<=24?1:(temp>=10&&temp<=30?0.9:0.75),rate=(b?(b.kind==="bedroll"?0.21:0.34):0.14)*(1+comfort*0.03)*warmth;
    if(b&&b.kind==="bed"&&room&&temp<10)remember(c,"A cold night in bed",-3,1440);
    c.rest=clamp(c.rest+dt*GAME_MINUTES_PER_SECOND*rate,0,100);c.action="Sleeping";if(b&&b.kind==="bed"&&b.owner!==c.id){b.owner=c.id;structuresDirty=true;}
    if(b&&b.kind==="bed"&&room){
      if(hasQuirk(c,"openSky"))remember(c,"Walls too close",-3,1440);
      else remember(c,comfort>=6?"A good room":comfort>=3?"A bed and a roof":"A bed on bare ground",comfort>=6?7:comfort>=3?5:2,1440);
      if(room.noisy)remember(c,"Sleeping beside the machinery",-3,1440);
      if(room.beds>4)remember(c,"A crowded room",-2,1440);
    }
    else remember(c,hasQuirk(c,"openSky")?"Sky overhead":"Sleeping without a proper room",hasQuirk(c,"openSky")?2:-4,700);
    if(c.rest>=96||(c.food<12&&(osGame.stock.meals>0||osGame.stock.raw>=2)))finishTask(c);
  }else if(t.type==="recreation"&&t.hiding){
    c.action="Hiding";if(!nearestHostileAny(c.x,c.y,9)||(c.food<12&&!nearestHostileAny(c.x,c.y,6))){finishTask(c);}
  }else if(t.type==="recreation"&&t.mourn){
    let g=getBuilding(t.targetId);if(g){let dx=g.x+.5-c.x,dy=g.y+.5-c.y,l=Math.sqrt(dx*dx+dy*dy)||1;c.headingX=dx/l;c.headingY=dy/l;if(Math.abs(dx)>.01)c.facing=dx<0?-1:1;}
    c.action="Paying respects";
    if(t.progress>=15||!osGame.funeral){finishMourning(c);finishTask(c);}
  }else if(t.type==="recreation"){
    c.recreation=clamp(c.recreation+dt*2.7,0,100);c.action=seatedAtTable(c)?"Sitting at the table":"Enjoying a quiet moment";
    if(c.recreation>=80||t.progress>20){remember(c,"A little time to be human",5,1000);finishTask(c);}
  }
}
function tickPeople(dt) {
  for(let i=0;i<osGame.people.length;i++){
    let c=osGame.people[i];if(c.dead||c.away){if(c.dead&&c.rover&&contextDepth===0)roverDied(c);continue;}if(c.rover){tickRover(c,dt);continue;}
    if(c.health<=0){killColonist(c,"injuries");continue;}
    if(c.health<22){if(c.task)releaseTask(c,true);cancelWeaponPickup(c);dropWeapon(c);c.drafted=false;c.action="Downed · needs a doctor";continue;}
    let starving=(c.food<20||c.rest<8)&&(osGame.stock.meals>=1||osGame.stock.raw>=2||c.rest<8);
    if(!c.drafted&&!c.child&&nearestHostile(c.x,c.y,6)&&!(starving&&!nearestHostile(c.x,c.y,3))){releaseTask(c,true);cancelWeaponPickup(c);c.drafted=true;c.autoDefend=true;rallyDefenders(c);}
    if(c.child&&osGame.elapsed>=(c.hideAt||0)){c.hideAt=osGame.elapsed+2;let danger=nearestHostileAny(c.x,c.y,9);if(danger){if(!c.task||!c.task.hiding){releaseTask(c,true);let beds=nearestBuilding(c,["bed","bedroll","clinic"],false),hid=false;for(let k=0;k<beds.length&&!hid;k++){let room=roomAt(beds[k].x,beds[k].y);if(routeTo(c,beds[k],true)){c.task={type:"recreation",personal:true,phase:"travel",targetId:beds[k].id,progress:0,hiding:true};c.action="Hiding";hid=true;}}if(!hid){let dx=c.x-danger.x,dy=c.y-danger.y,l=Math.sqrt(dx*dx+dy*dy)||1,x=clamp(Math.floor(c.x+dx/l*6),WX+1,WX+MAP_SIZE-2),y=clamp(Math.floor(c.y+dy/l*6),WY+1,WY+MAP_SIZE-2);if(routeTo(c,{x:x,y:y},true))c.task={type:"recreation",personal:true,phase:"travel",targetId:"",progress:0,hiding:true};c.action="Running from danger";}}}else if(c.task&&c.task.hiding&&c.task.phase==="work")releaseTask(c,true);}
    if(c.drafted){tickDrafted(c,dt);continue;}
    if(c.equipTarget){tickWeaponPickup(c,dt);continue;}
    if(c.breakUntil>osGame.elapsed&&c.food<15&&(osGame.stock.meals>=1||osGame.stock.raw>=2))c.breakUntil=0;
    if(c.breakUntil>osGame.elapsed){c.action="Overwhelmed · taking time out";c.recreation=Math.min(100,c.recreation+dt);continue;}
    if(c.food<10&&c.task&&!c.task.personal&&c.task.phase!=="deliver"&&(osGame.stock.meals>=1||osGame.stock.raw>=2))releaseTask(c,true);
    if(c.rest<8&&c.task&&!c.task.personal&&c.task.phase!=="deliver")releaseTask(c,true);
    if(c.funeralAt&&c.task&&!c.task.personal&&c.task.phase!=="deliver"&&c.task.type!=="bury")releaseTask(c,true);
    if(c.funeralAt&&!c.task&&startMourning(c))continue;
    if(c.task)updateWorkTask(c,dt);else chooseJob(c);
  }
}
function tickNeeds(dt) {
  let mins=dt*GAME_MINUTES_PER_SECOND;
  for(let i=0;i<osGame.people.length;i++){
    let c=osGame.people[i];if(c.dead||c.away||c.rover)continue;
    c.food=clamp(c.food-mins*0.059*(hasQuirk(c,"bigEater")?1.25:1),0,100);
    if(!c.task||c.task.type!=="sleep")c.rest=clamp(c.rest-mins*0.052,0,100);
    c.recreation=clamp(c.recreation-mins*0.023,0,100);
    // Wounds clot on their own; treatment still heals, but nobody bleeds out for lack of a doctor alone.
    if(c.bleed>0){c.health-=dt*c.bleed;c.bleed=Math.max(0,c.bleed-dt*(c.task&&c.task.type==="sleep"?0.008:0.004));}
    if(c.food<=0)c.health-=dt*(osGame.difficulty==="peaceful"?0.02:0.1);
    let room=roomAt(c.x,c.y),temp=room?room.temp:osGame.temperature;
    if(temp<-4||temp>40){remember(c,temp<0?"Bitterly cold":"Dangerously hot",-7,160);c.health-=dt*0.025;}
    if(hasQuirk(c,"stormAnxious")&&stormyWeather()&&c.task&&!c.task.personal&&!room&&c.stormResentAt!==osGame.weatherUntil){c.stormResentAt=osGame.weatherUntil;remember(c,"Sent out in the storm",-4,1440*2);}
    if(c.bleed===0&&c.food>25&&c.health<100)c.health=Math.min(100,c.health+dt*(c.task&&c.task.type==="sleep"?0.08:0.017)*(c.health<22&&nearClinic(c)?2.5:1));
    let keep=[];for(let j=0;j<c.memories.length;j++)if(c.memories[j].until>osGame.minutes)keep.push(c.memories[j]);c.memories=keep;
    let mood=55+(c.trait==="Optimist"?8:0)+(c.food>60?4:0)+(c.rest>60?5:0)+(c.recreation>55?4:0);
    mood-=c.food<25?16:0;mood-=c.rest<25?15:0;mood-=c.recreation<15?8:0;mood-=(100-c.health)*0.18;
    if(countBuilt("memorial")>0)mood+=3;
    for(let j=0;j<c.memories.length;j++)mood+=c.memories[j].value;
    c.mood=clamp(mood,0,100);
    if(c.mood<13+(50-traitOf(c,"nerve"))/10&&osGame.elapsed>c.breakCooldown&&osGame.difficulty!=="peaceful"){
      releaseTask(c,true);c.breakUntil=osGame.elapsed+14;c.breakCooldown=osGame.elapsed+100;remember(c,"Took a moment",6,400);chronicle(c.short+" needs a moment","Exhaustion and worry caught up with "+c.name+". Improve their needs and give them time.","people");
    }
    if(c.health<=0)killColonist(c,c.food<=0?"starvation":"injuries");
    revealArea(c.x,c.y,7);
  }
}
// Relationship changes go through here so a friendship crossing the line is noticed once.
function adjustRelation(a,b,delta) {
  let before=a.relations[b.id]||0,after=clamp(before+delta,-100,100);a.relations[b.id]=after;
  if(before<=55&&after>55&&(b.relations[a.id]||0)>55)chronicle(a.short+" and "+b.short+" are friends","Enough shared work and shared tables that the colony would call them friends.","people");
}
function tickSocial() {
  let living=alivePeople();if(living.length<2)return;
  let a=pick(living);if(a.drafted||a.health<25||(a.task&&a.task.type==="sleep"))return;
  // Working side by side, or sharing a table, is where most friendships come from.
  if(a.task&&!a.task.personal&&a.task.phase==="work"){
    for(let i=0;i<living.length;i++){let b=living[i];if(b===a||b.drafted||!b.task||b.task.personal||b.task.phase!=="work"||sqDistance(a.x,a.y,b.x,b.y)>16)continue;
      adjustRelation(a,b,3);adjustRelation(b,a,3);remember(a,"Worked alongside "+b.short,2,700);remember(b,"Worked alongside "+a.short,2,700);return;}
  }
  if(seatedAtTable(a)){
    for(let i=0;i<living.length;i++){let b=living[i];if(b===a||!seatedAtTable(b)||b.task.targetId!==a.task.targetId)continue;
      adjustRelation(a,b,2);adjustRelation(b,a,2);remember(a,"A meal with "+b.short,2,700);remember(b,"A meal with "+a.short,2,700);return;}
  }
  let nearby=[];for(let i=0;i<living.length;i++){let b=living[i];if(b.id!==a.id&&!b.drafted&&sqDistance(a.x,a.y,b.x,b.y)<36&&(!b.task||b.task.type!=="sleep"))nearby.push(b);}
  if(!nearby.length)return;let b=pick(nearby);
  let calm=(traitOf(a,"empathy")+traitOf(b,"empathy")-100)/400;
  let opposed=opposedValues(a,b);
  let disagreement=randomUnit()<Math.max(0.04,(a.mood<30||b.mood<30?0.4:0.14)-calm+(opposed?0.12:0));let change=disagreement?-randomInt(3,7):randomInt(2,5);
  adjustRelation(a,b,change);adjustRelation(b,a,change);
  a.recreation=Math.min(100,a.recreation+4);b.recreation=Math.min(100,b.recreation+4);
  remember(a,disagreement?"An argument with "+b.short:"Good company: "+b.short,disagreement?-4:3,700);
  remember(b,disagreement?"An argument with "+a.short:"Good company: "+a.short,disagreement?-4:3,700);
  if(disagreement&&osGame.minutes-(osGame.lastArgumentAt||-1e9)>=480){osGame.lastArgumentAt=osGame.minutes;chronicle("A disagreement by the workbench",a.short+" and "+b.short+" argued about "+(opposed?argumentTopic(a,b):pick(["taking too many risks","whose turn it was to cook","the noise from the generator"]))+".","people");}
  if(a.relations[b.id]>=72&&b.relations[a.id]>=72&&!a.partner&&!b.partner&&dayNow()>=5)formPartnership(a,b);
}
// Partners: a lasting memory for both, and a beat the colony gets to answer.
function formPartnership(a,b) {
  a.partner=b.id;b.partner=a.id;remember(a,"A home with "+b.short,12,1440*20);remember(b,"A home with "+a.short,12,1440*20);
  chronicle("Something worth staying for",a.name+" and "+b.name+" have become partners.","people");
  noteFact("partners",[a.short,b.short]);osGame.partnerPending={a:a.id,b:b.id};osGame.storySeen.partners=0;
}
// Personality was generated from the start; now it reads on the card and shapes research, treatment and temper.
function traitOf(c,key) {let v=c&&c.personality?c.personality[key]:undefined;return typeof v==="number"?v:50;}
function personalityText(c) {
  let p=c.personality||{},parts=[];
  if(p.curiosity>=70)parts.push("Curious");if(p.sociability>=70)parts.push("Sociable");if(p.nerve>=75)parts.push("Steady nerves");if(p.empathy>=70)parts.push("Kind");if(p.discipline>=80)parts.push("Disciplined");
  if(p.nerve<50)parts.push("Easily shaken");if(p.sociability<45)parts.push("Private");if(p.curiosity<50)parts.push("Practical");
  return parts.length?parts.slice(0,3).join(" · "):"Even-tempered";
}
function injureColonist(c,damage,cause,quiet) {
  if(c.dead)return;
  if(hasTech("armour"))damage*=0.8;
  let covered=false;
  for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){if(c.away||!onMap(c.x+dx,c.y+dy))continue;let b=getBuilding(cellBuilding[tileId(c.x+dx,c.y+dy)]);if(b&&b.built&&BUILDINGS[b.kind].cover)covered=true;}
  if(covered)damage*=0.65;
  c.hurtUntil=osGame.elapsed+.65;emitVisualFx(String(cause).indexOf("spitter")>=0?"acid-hit":"hit",c.x,c.y,damage);c.health-=damage;c.bleed=clamp(c.bleed+damage*0.003,0,0.3);
  let part=pick(["Left arm","Right arm","Torso","Left leg","Right leg"]);
  c.injuries.unshift({part:part,cause:cause,severity:Math.round(damage),tended:false});if(c.injuries.length>6)c.injuries.length=6;
  if(!quiet)remember(c,"Hurt during "+cause,-7,1440);if(c.health<=0)killColonist(c,cause);viewDirty=true;
}
function killColonist(c,cause) {
  cancelWeaponPickup(c);dropWeapon(c);
  if(c.dead)return;releaseTask(c,true);dropCarriedGoods(c);c.dead=true;c.health=0;c.drafted=false;c.action="Died: "+cause;osGame.stats.deaths++;osGame.lastDeathAt=osGame.minutes;
  for(let i=0;i<osGame.people.length;i++){let p=osGame.people[i];if(p.dead)continue;if(p.partner===c.id){remember(p,"Lost "+c.short,-26,1440*12);if(!osGame.widowQueue)osGame.widowQueue=[];if(!osGame.widowQueue.some(function(w){return w.survivor===p.id&&w.lost===c.id;}))osGame.widowQueue.push({survivor:p.id,lost:c.id});osGame.storySeen.emptyChair=0;}else remember(p,"Lost "+c.short,(p.relations[c.id]||0)>30?-18:-10,1440*8);}
  noteFact("deaths",{name:c.name,cause:cause,sol:dayNow(),buried:false});
  chronicle("Remember "+c.name,c.name+" died from "+cause+". The colony will remember.","loss");
  say(c.name+" has died.");cancelTargetJobs(c.id);
  if(!everyoneAlive().length){paused=true;osGame.over=true;dialog="ending";archiveTitle="The last light went out";archiveBody=colonyEpitaph();chronicle("The last light went out",colonyEpitaph(),"ending");}
}
// Losing should read like a chronicle, not a scoreboard.
function colonyEpitaph() {
  let s=osGame.stats,techs=Object.keys(osGame.tech).length;
  return osGame.name+" survived until Sol "+dayNow()+".\n\n"+colonyLegend()+"\n\n"+osGame.people.length+" people called it home. "+s.deaths+" died there.\n"+s.harvests+" harvests were brought in and "+Math.floor(s.mealsCooked)+" meals cooked. "+techs+" discoveries were made and "+s.studied+" of three archives recovered.\n\nWhat you built is now another mark beneath Hollow-7's sky. Your chronicle remains.";
}
