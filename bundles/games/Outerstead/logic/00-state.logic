let terrainRows = {};
let terrainRowsPending = false;
let minimapEpoch = 0, minimapBuiltEpoch = -1, minimapBuiltAt = -1e9, minimapRows = [], minimapRowsDirty = {}, minimapStructEpoch = 0, minimapStructBuilt = -1, minimapStructSvg = "";
function dirtyTerrainRow(y) { y=y-WY; if(y<0||y>=MAP_SIZE)return; terrainRows[y] = true; terrainRowsPending = true; minimapRowsDirty[y] = true; minimapEpoch++; }
