const OS_VERSION = "0.61.6";
const SAVE_SCHEMA = 6;
// Older schemas are brought forward one step at a time before validation; each step is small and named.
const SAVE_MIGRATIONS = {
  1: function(g) { for(let i=0;i<(g.people||[]).length;i++){let c=g.people[i];if(c&&typeof c==="object"){if(!Array.isArray(c.quirks))delete c.quirks;if(!c.values||typeof c.values!=="object")delete c.values;}} g.schema=2; },
  // 2 -> 3: workstation buffers, quality meals, helper children, rescue and supply work. Older games have none of it;
  // the fields are optional, so the step only clears malformed leftovers and stamps the schema.
  2: function(g) { for(let i=0;i<(g.buildings||[]).length;i++){let b=g.buildings[i];if(b&&typeof b==="object"){if(b.input!==undefined&&(typeof b.input!=="object"||b.input===null))delete b.input;if(b.made!==undefined&&(typeof b.made!=="object"||b.made===null))delete b.made;}} if(typeof g.qualityMeals!=="number")delete g.qualityMeals; g.schema=3; },
  // 3 -> 4: built floors and conduits leave the structure list for two map layers.
  3: function(g) { let w=g.mapSize||96,n=w*w; if(!Array.isArray(g.floorTiles)||g.floorTiles.length!==n){g.floorTiles=[];for(let i=0;i<n;i++)g.floorTiles.push(0);} if(!Array.isArray(g.wireTiles)||g.wireTiles.length!==n){g.wireTiles=[];for(let i=0;i<n;i++)g.wireTiles.push(0);}
    if(Array.isArray(g.buildings))for(let i=g.buildings.length-1;i>=0;i--){let b=g.buildings[i];if(!b||typeof b!=="object"||!b.built)continue;if(b.kind==="floor"||b.kind==="conduit"){if(Number.isInteger(b.x)&&Number.isInteger(b.y)&&b.x>=0&&b.y>=0&&b.x<w&&b.y<w)(b.kind==="floor"?g.floorTiles:g.wireTiles)[b.y*w+b.x]=1;g.buildings.splice(i,1);}}
    g.schema=4; },
  // 4 -> 5: the map has a size and a set of generated chunks; older maps are 96 wide with one chunk.
  4: function(g) { if(g.mapSize===undefined)g.mapSize=96; if(!g.chunks||typeof g.chunks!=="object")g.chunks={"0,0":true}; g.schema=5; },
  // 5 -> 6: the map is a window on an infinite plane; older maps sit at the plane's origin with nothing stored beyond.
  5: function(g) { if(!g.window||typeof g.window!=="object")g.window={x:0,y:0}; if(!g.plane||typeof g.plane!=="object")g.plane={}; g.schema=6; }
};
function migrateSave(g,from) { let v=from; while(v<SAVE_SCHEMA){ let step=SAVE_MIGRATIONS[v]; if(!step)failSave("No migration from save schema "+v+"."); step(g); v++; } return g; }
let MAP_SIZE = 96;
const TILE = 32;
let CENTRE = 48;
let mapTiles = 96;
let mapSizeChoice = 288;
let WX = 0;
let WY = 0;
const HOME_SIZE = 96;
const MAP_SIZES = [96, 288, 480];
function setMapSize(n) {MAP_SIZE=n;CENTRE=Math.floor(n/2);mapTiles=n;}
function homeOrigin() {return osGame&&osGame.homeOrigin!==undefined?osGame.homeOrigin:CENTRE-HOME_SIZE/2;}
function setCentre(x,y) {CENTRE=x;if(osGame){osGame.centre={x:x,y:y};}}
function centreY() {return osGame&&osGame.centre?osGame.centre.y:CENTRE;}
const STEP_SECONDS = 0.1;
const GAME_MINUTES_PER_SECOND = 2;
const RESOURCE_KEYS = ["wood","stone","ore","metal","parts","fuel","raw","meals","medicine","glass","cores"];
const WORK_KEYS = ["build","haul","farm","cook","mine","craft","research","doctor","explore"];
const WORK_LABELS = ["Build","Haul","Farm","Cook","Mine","Craft","Study","Treat","Explore"];

function clamp(n, lo, hi) { return Math.max(lo, Math.min(hi, n)); }
function round1(n) { return Math.round(n * 10) / 10; }
function sqDistance(ax, ay, bx, by) { let dx=ax-bx; let dy=ay-by; return dx*dx+dy*dy; }
function tileId(x,y) { return (Math.floor(y)-WY)*MAP_SIZE+(Math.floor(x)-WX); }
function onMap(x,y) { return x>=WX && y>=WY && x<WX+MAP_SIZE && y<WY+MAP_SIZE; }
function hashSeed(value) {
  let s=String(value); let h=2166136261;
  for(let i=0;i<s.length;i++) { h=(h ^ s.charCodeAt(i))>>>0; h=Math.imul(h,16777619)>>>0; }
  return h || 731927;
}
function randomUnit() { osGame.rng=(Math.imul(osGame.rng,1664525)+1013904223)>>>0; return osGame.rng/4294967296; }
function randomInt(a,b) { return a+Math.floor(randomUnit()*(b-a+1)); }
function pick(list) { return list[Math.floor(randomUnit()*list.length)]; }
function entityId(prefix) { let id=prefix+osGame.nextId; osGame.nextId++; return id; }
function dayNow() { return Math.floor(osGame.minutes/1440)+1; }
function hourNow() { return (osGame.minutes%1440)/60; }
function hasTech(id) { return !!(osGame && osGame.tech[id]); }
function say(message) { toastText=message; toastRemaining=5; }
let colonistLookup={};
function findColonist(id) {
  if(!osGame||!id)return null;
  let index=colonistLookup[id],person=typeof index==="number"?osGame.people[index]:null;
  if(person&&person.id===id)return person;
  for(let i=0;i<osGame.people.length;i++)if(osGame.people[i].id===id){colonistLookup[id]=i;return osGame.people[i];}
  delete colonistLookup[id];return null;
}
function alivePeople() { let list=[]; for(let i=0;i<osGame.people.length;i++)if(!osGame.people[i].dead&&!osGame.people[i].away&&!osGame.people[i].rover)list.push(osGame.people[i]); return list; }
function getBuilding(id) { return objectIndex[id] || null; }
function getNode(id) { return nodeIndex[id] || null; }
function chronicle(title, body, type) {
  if(!osGame)return;
  osGame.chronicle.unshift({id:entityId("log"),sol:dayNow(),minute:Math.floor(osGame.minutes%1440),title:castText(title),body:castText(body||""),type:type||"colony"});
  if(osGame.chronicle.length>240)osGame.chronicle.length=240;
  viewDirty=true;storyDirty=true;
}
function remember(person,text,value,duration) {
  if(!person || person.dead)return;text=castText(text);
  for(let i=0;i<person.memories.length;i++) if(person.memories[i].text===text){person.memories[i].until=osGame.minutes+duration;return;}
  person.memories.push({text:text,value:value,until:osGame.minutes+duration});
  if(person.memories.length>16)person.memories.shift();
}
function stockHas(cost) { let keys=Object.keys(cost); for(let i=0;i<keys.length;i++)if((osGame.stock[keys[i]]||0)+0.0001<cost[keys[i]])return false; return true; }
// Kitchen meals never outnumber the meals there are; called wherever meals leave the larder.
function trimQualityMeals(){if(!osGame)return;if(!(osGame.qualityMeals>=0))osGame.qualityMeals=0;if(osGame.qualityMeals>osGame.stock.meals)osGame.qualityMeals=Math.max(0,Math.floor(osGame.stock.meals));}
function stockTake(cost) { if(!stockHas(cost))return false;stockDirty=true; let keys=Object.keys(cost);for(let i=0;i<keys.length;i++)osGame.stock[keys[i]]-=cost[keys[i]];if(cost.meals)trimQualityMeals();return true; }
function stockGive(goods) { stockDirty=true;let keys=Object.keys(goods);for(let i=0;i<keys.length;i++)if(RESOURCE_KEYS.indexOf(keys[i])>=0)osGame.stock[keys[i]]=clamp(osGame.stock[keys[i]]+goods[keys[i]],0,1000000); }
function costText(cost) { let out=[];let keys=Object.keys(cost);for(let i=0;i<keys.length;i++)out.push(cost[keys[i]]+" "+(keys[i]==="parts"?"components":keys[i]));return out.join(" · ") || "No materials"; }

let quietAudioMuted = false;

// Bounded, VM-owned diagnostics. Only performanceText crosses into the UI.
let autoMode = false;
let edgeScroll = true;
let edgeX = 0;let edgeY = 0;
let performanceText = "Profiler off";
let perfEnabled = false;
let perfStats = {};
function perfNow() { return Date.now(); }
function perfRecord(name,started) {
  if(!perfEnabled)return;
  let s=perfStats[name];if(!s){s={calls:0,total:0,max:0};perfStats[name]=s;}
  let ms=Math.max(0,perfNow()-started);s.calls++;s.total+=ms;s.max=Math.max(s.max,ms);
}
function toggleProfiler() {perfEnabled=!perfEnabled;perfStats={};pathRequests=0;pathHits=0;performanceText=perfEnabled?"Collecting VM timings…":"Profiler off";}
function refreshPerformance() {
  if(!perfEnabled)return;
  let s=perfStats.tick||{calls:0,total:0,max:0};
  performanceText="Tick "+(s.total/Math.max(1,s.calls)).toFixed(2)+" ms · peak "+s.max+" · paths "+pathRequests+" · cache "+Math.round(pathHits/Math.max(1,pathRequests)*100)+"%";
}

