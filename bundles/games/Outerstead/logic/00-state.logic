// Outerstead: VM-owned simulation, UI-facing projections, and deterministic helpers.
// The UI never references osGame or navigation scratch buffers directly.
let osGame = null;
let navBlocked = [];
let cellBuilding = [];
// Buildings and nodes by kind, rebuilt only when the arrays change, so a lookup for four beds does not walk
// every structure and the steward does not walk every node four times.
let buildingsByKind = {}, buildingsIndexRef = null, buildingsIndexLength = -1, buildingsEpoch = 0, buildingsIndexEpoch = -1;
let nodesByKind = {}, nodesIndexRef = null, nodesIndexLength = -1, nodesEpoch = 0, nodesIndexEpoch = -1;
function buildingsOfKind(kind) {
  if(!osGame)return [];
  if(buildingsIndexRef!==osGame.buildings||buildingsIndexLength!==osGame.buildings.length||buildingsIndexEpoch!==buildingsEpoch){
    buildingsByKind={};for(let i=0;i<osGame.buildings.length;i++){let b=osGame.buildings[i];(buildingsByKind[b.kind]||(buildingsByKind[b.kind]=[])).push(b);}
    buildingsIndexRef=osGame.buildings;buildingsIndexLength=osGame.buildings.length;buildingsIndexEpoch=buildingsEpoch;
  }
  return buildingsByKind[kind]||[];
}
function nodesOfKind(kind) {
  if(!osGame)return [];
  if(nodesIndexRef!==osGame.nodes||nodesIndexLength!==osGame.nodes.length||nodesIndexEpoch!==nodesEpoch){
    nodesByKind={};for(let i=0;i<osGame.nodes.length;i++){let n=osGame.nodes[i];if(n.amount>0)(nodesByKind[n.kind]||(nodesByKind[n.kind]=[])).push(n);}
    nodesIndexRef=osGame.nodes;nodesIndexLength=osGame.nodes.length;nodesIndexEpoch=nodesEpoch;
  }
  return nodesByKind[kind]||[];
}
