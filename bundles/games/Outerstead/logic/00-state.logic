  hills:{name:"Lantern Hills",blurb:"The original valley: balanced timber, stone and ore, mild seasons. Rock ridges with narrow passes, and ore thickest along their feet.",density:0.22,ore:0.12,stone:0.36,berries:0.43,temperature:0,extraWeather:[],stock:{},filter:"none"},
  rust:{name:"Rust Flats",blurb:"The hard site: open and exposed, ore-rich, timber-poor, hot days and glass on the wind. Old debris fields hold metal and Hollowglass; there are few places to hold a line. Bring metal, expect to trade for wood, and wall the camp early.",density:0.26,ore:0.30,stone:0.62,berries:0.66,temperature:2,extraWeather:["Glass Wind"],stock:{wood:-40,ore:30,metal:25},filter:"sepia(.28) hue-rotate(-14deg) saturate(1.08)"},
  verdant:{name:"Verdant Basin",blurb:"Thick timber and berries, little ore, wet and foggy. Dense forest, marsh and lakes make for long walks; the wildlife is plentiful. Easy to feed, hard to industrialise.",density:0.28,ore:0.05,stone:0.20,berries:0.42,temperature:1,extraWeather:["Rain","Fog"],stock:{wood:40,raw:12,ore:-8},filter:"hue-rotate(10deg) saturate(1.15)"}
};
