// The site's sense of humour, the visible part: toasts (short notes that pop up and fade), camera
// shake, bursts of dust, sparks or confetti, and the fireworks when the target falls. All cosmetic:
// nothing here affects the simulation, and a burst's random look comes from flavour()
// (fun/banter.logic), not rand(), so a seed still produces the same faults and forecasts.
// State: toasts, toastSerial, shake, bursts and fireworksUntil, session globals that are never
// saved; nextShift (mine/shift.logic) clears all but toastSerial. S.fun.celebrated (saved) stops
// the fireworks going off twice in a shift.
// Calls in: toast(), burst() and addShake() from all over; celebrateDelivery() from completeDump
// (mine/fleet.logic); toastRows() from refreshUI; appendBursts() from buildWorldFrame
// (world/scene.logic); cameraShakeOffset() from updateCamera (world/camera.logic); decayShake()
// from stepSimulation. Toasts age in real time (Date.now()); bursts and fireworks in shift time
// (S.time), so they freeze while the game is paused.
var toasts = [];

var toastSerial = 0;

var shake = 0;

var bursts = [];

// ---------- Toasts ----------

// A short message that pops up over the world and fades: "+80 t", "AIRTIME 1.2 s".
// kind picks its style in ui/screens/overlays.ui: 'info' (the default), 'good', 'gold' or 'memo'.
// Newest first; four at most.
function toast(text, kind) {
  toasts.unshift({ id: ++toastSerial, text: text, kind: kind || 'info', at: Date.now() });
  if (toasts.length > 4) toasts = toasts.slice(0, 4);
}

// The toasts for the overlay (refreshUI puts them in toastList). Each lasts 3.6 s; in its last 20%
// it gets mm-toast-out, which fades it.
function toastRows() {
  var now = Date.now();
  toasts = toasts.filter(function (t) {
    return now - t.at < 3600;
  });
  return toasts.map(function (t) {
    var age = (now - t.at) / 3600;
    return {
      id: t.id,
      text: t.text,
      className: 'mm-toast mm-toast-' + t.kind + (age > 0.8 ? ' mm-toast-out' : '')
    };
  });
}

// ---------- Shake ----------

// Shakes the camera, up to 1.2 in all; nothing with reduced motion. decayShake() calms it.
function addShake(amount) {
  if (motion) shake = Math.min(1.2, shake + amount);
}

// ---------- Bursts and fireworks ----------

// A puff, a spray of sparks or a shower of confetti at a point in the world, for a second or so.
// kind is 'dust', 'sparks' or 'confetti'; size scales its spread. The 12 newest are kept, each
// for 1.4 s of shift time (appendBursts).
function burst(kind, x, y, z, size) {
  bursts.push({
    kind: kind,
    x: x,
    y: y,
    z: z,
    size: size || 1,
    at: S ? S.time : 0,
    seed: Math.floor(flavour() * 1000)
  });
  if (bursts.length > 12) bursts.shift();
}

// Small celebrations the world can see.
// completeDump (mine/fleet.logic) calls this for every load tipped: a toast, and confetti over the
// crusher's tip bay (the tip point is x 72, z 138). The delivery that meets the target starts the
// fireworks. S.fun.celebrated is 1, not true, because validFun (fun/stats.logic) accepts only
// numbers in S.fun. t is not used.
function celebrateDelivery(t, tonnes) {
  toast('+' + Math.round(tonnes) + ' t delivered', 'good');
  burst('confetti', 74, 10, 138, 0.6);
  if (S.tonnes >= S.target && !S.fun.celebrated) {
    S.fun.celebrated = 1;
    startFireworks();
  }
}

// Shift time when the fireworks stop. While it is ahead, the robots wave and hop
// (world/actors.logic).
var fireworksUntil = 0;

// 14 s of fireworks, a gold toast, a little shake, and every robot waves for 6 s.
function startFireworks() {
  fireworksUntil = S.time + 14;
  toast('TARGET SMASHED', 'gold');
  addShake(0.3);
  for (var b of S.robots) b.waveUntil = S.time + 6;
}

// ---------- Each frame and each step ----------

// Adds the live bursts and the fireworks to this frame's scene objects as Scene3D particle objects
// (called by buildWorldFrame, world/scene.logic). Colours are RGB from 0 to 1.
function appendBursts(objects) {
  var now = S.time;
  bursts = bursts.filter(function (b) {
    return now - b.at < 1.4;
  });
  for (var i = 0; i < bursts.length; i++) {
    // age runs from 0 to 1 over the burst's 1.4 s; n is how many particles it has.
    var b = bursts[i],
      age = (now - b.at) / 1.4,
      pts = [],
      cols = [],
      n = b.kind === 'confetti' ? 26 : b.kind === 'sparks' ? 14 : 18;
    for (var k = 0; k < n; k++) {
      // 2.399 radians is the golden angle, which spreads the particles evenly around the centre;
      // the seed turns each burst a different way. They spread outwards as the burst ages (dust
      // widest). Dust drifts up; sparks and confetti rise and fall. (k % 3) * 0.25 stacks them
      // in three layers.
      var a = k * 2.399 + b.seed,
        r = (b.kind === 'dust' ? 1.2 + age * 4.5 : 1 + age * 3.4) * b.size,
        lift =
          b.kind === 'dust'
            ? age * 1.6
            : b.kind === 'sparks'
              ? 2.2 * age - 4 * age * age
              : 3 * age - 2 * age * age;
      pts.push(b.x + Math.cos(a) * r, b.y + lift + (k % 3) * 0.25, b.z + Math.sin(a) * r);
      if (b.kind === 'confetti') {
        var c = [
          [0.94, 0.71, 0.33],
          [0.47, 0.83, 0.76],
          [0.89, 0.42, 0.36],
          [0.86, 0.86, 0.9]
        ][k % 4];
        cols.push(c[0], c[1], c[2]);
      } else if (b.kind === 'sparks') cols.push(1, 0.78 - 0.3 * age, 0.35);
      else cols.push(0.72, 0.6, 0.44);
    }
    objects.push({
      id: 'burst-' + i + '-' + b.seed,
      type: 'particles',
      particlePositions: pts,
      particleColors: cols,
      particleSize: b.kind === 'dust' ? 1.6 * b.size : b.kind === 'sparks' ? 0.22 : 0.34,
      opacity: Math.max(0, 0.9 - age * 0.8)
    });
  }
  // The fireworks, skipped on low quality: five shells at fixed places, about 34 m up. Each
  // bursts every 1.8 s (0.55 bursts a second), offset by 0.37 of a cycle from the last so they
  // don't go off together; its 22 sparks spread to 9 m and sag up to 6 m as the cycle runs.
  if (fireworksUntil > now && quality !== 'low') {
    var fw = [],
      fc = [];
    for (var s = 0; s < 5; s++) {
      var cycle = (now * 0.55 + s * 0.37) % 1,
        cx = 25 + s * 14 - Math.sin(s * 1.7) * 10,
        cz = 60 + s * 9,
        cy = 34 + Math.sin(s * 2.3) * 6,
        rad = cycle * 9;
      var hue = [
        [1, 0.78, 0.36],
        [0.5, 0.95, 0.85],
        [1, 0.45, 0.4],
        [0.75, 0.6, 1],
        [1, 1, 0.85]
      ][s];
      for (var k = 0; k < 22; k++) {
        // a1 goes round (the golden angle again) and a2 down from the top: points over a sphere.
        var a1 = k * 2.399,
          a2 = k * 1.3;
        fw.push(
          cx + Math.cos(a1) * Math.sin(a2) * rad,
          cy + Math.cos(a2) * rad - cycle * cycle * 6,
          cz + Math.sin(a1) * Math.sin(a2) * rad
        );
        fc.push(hue[0], hue[1], hue[2]);
      }
    }
    objects.push({
      id: 'fireworks',
      type: 'particles',
      particlePositions: fw,
      particleColors: fc,
      particleSize: 0.75,
      opacity: 0.95,
      fog: false
    });
  }
}

// This frame's camera offset in metres (updateCamera, world/camera.logic): three sine waves of
// different speeds, in real time, scaled by the shake.
function cameraShakeOffset() {
  if (shake <= 0.001) return { x: 0, y: 0, z: 0 };
  var t = Date.now() / 1000;
  return {
    x: Math.sin(t * 61) * shake * 0.35,
    y: Math.sin(t * 47 + 1) * shake * 0.28,
    z: Math.cos(t * 53) * shake * 0.35
  };
}

// The shake dies away at 2.6 a second of shift time (called every simulation step).
function decayShake(dt) {
  shake = Math.max(0, shake - dt * 2.6);
}
