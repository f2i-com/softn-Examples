// Sound: one-shot effects, the site ambience, the looping sounds (the music, the diesel engine
// while you drive and the wind in bad weather) and the recorded radio voice lines. Everything plays
// through softn.audio (the host), inside try/catch, so a host without audio or a missing file
// never stops the game.
// State: the settings muted, musicEnabled and radioEnabled (globals in core/state.logic, saved in
// S.settings); ambientStarted; the loops (musicLoop, engineLoop and windLoop, below); and a handle
// plus a generation counter for the radio voice (core/state.logic).
// softn.audio.play hands back its handle later, in a callback, by which time the game may have
// changed its mind. So every sound keeps a generation counter, bumped at each change of mind, and a
// callback that arrives with an old count stops the sound it was given instead of keeping it.
// A new looping sound needs only a loop record and a setLoop() call: see Looping sounds below.
// Callers: sfx() from all over; refreshEngineAudio(), refreshMusic() and refreshWeatherAudio()
// from refreshUI (core/ui-state.logic) four times a second; startAudio() from newGame and
// continueGame (core/session.logic); toggleMusic() and toggleRadio() from the pause screen
// (ui/screens/pause.ui).

// Plays app/assets/audio/<name>.wav once, the horn a little louder than the rest. Silent while
// muted.
function sfx(name) {
  if (muted) return;
  try {
    if (typeof softn !== 'undefined' && softn.audio)
      softn.audio.play('assets/audio/' + name + '.wav', { volume: name === 'horn' ? 0.5 : 0.35 });
  } catch (e) {}
}

// Starts the looping site ambience and sets the master volume (0 when muted,
// as in toggleMute in core/settings.logic). Called when a game starts or continues.
function startAudio() {
  try {
    if (typeof softn !== 'undefined' && softn.audio) {
      softn.audio.setVolume(muted ? 0 : 0.65);
    }
  } catch (e) {}
  refreshAmbience();
  ambientStarted = ambienceLoop.handle !== null;
}

// ---------- Looping sounds ----------

// A sound that loops for as long as it is wanted. setLoop() starts and stops it; the rest is its
// bookkeeping. handle is null (silent), 'pending' (asked for; the host hasn't answered) or the
// host's handle (playing).
var ambienceLoop = { path: 'assets/audio/site-ambience.mp3', volume: 0.2, handle: null, generation: 0 };

var musicLoop = { path: 'assets/audio/shift-score.mp3', volume: 0.12, handle: null, generation: 0 };

var engineLoop = { path: 'assets/audio/diesel.wav', volume: 0.34, handle: null, generation: 0 };

var windLoop = { path: 'assets/audio/wind.wav', volume: 0.22, handle: null, generation: 0 };

// Starts the loop if it is wanted and silent; stops it if it is unwanted and playing (or on its
// way). Cheap enough to call four times a second: it does nothing when the loop is already as
// wanted. If the host answers without a handle, the loop stays silent and the next call asks again.
function setLoop(loop, wanted) {
  if (!wanted) {
    if (loop.handle === null) return;
    loop.generation++;
    try {
      if (loop.handle !== 'pending') softn.audio.stop(loop.handle);
    } catch (e) {}
    loop.handle = null;
    return;
  }
  if (loop.handle !== null) return;
  loop.handle = 'pending';
  var generation = ++loop.generation;
  try {
    softn.audio.play(loop.path, { loop: true, volume: loop.volume }, function (r) {
      var handle = r && r.handle ? r.handle : null;
      if (generation !== loop.generation) {
        if (handle) softn.audio.stop(handle);
        return;
      }
      loop.handle = handle;
    });
  } catch (e) {
    loop.handle = null;
  }
}

// The diesel loop runs while the player drives the ute or a truck on the play screen with the
// tablet down.
function refreshEngineAudio() {
  var driving = screen === 'play' && !tablet && (S.player.mode === 'ute' || S.player.mode === 'truck');
  setLoop(engineLoop, driving);
}

// The wind blows while the weather is bad (S.weather 'rain' or 'dust', set by the shift's forecast
// in mine/chapters.logic), on the play screen, tablet or not.
function refreshWeatherAudio() {
  setLoop(windLoop, screen === 'play' && !!S && S.weather !== 'dry');
}

// The music plays while it is on, on every screen but the title and pause screens.
function refreshMusic() {
  setLoop(musicLoop, musicEnabled && screen !== 'pause' && screen !== 'title');
}

// Site ambience runs whenever a shift session is open (play, pause or report), stopping on title.
function refreshAmbience() {
  setLoop(ambienceLoop, screen !== 'title');
  ambientStarted = ambienceLoop.handle !== null;
}

// Stops every looping track and active voice cue (used on return to title or host hide/unmount).
function stopAllAudio() {
  setLoop(ambienceLoop, false);
  setLoop(musicLoop, false);
  setLoop(engineLoop, false);
  setLoop(windLoop, false);
  ambientStarted = false;
  voiceGeneration++;
  try {
    if (typeof softn !== 'undefined' && softn.audio) {
      if (voiceHandle !== null) softn.audio.stop(voiceHandle);
      if (softn.audio.stopAll) softn.audio.stopAll();
    }
  } catch (e) {}
  voiceHandle = null;
}

// ---------- Settings and the radio voice ----------

// Pause-screen buttons. saveGame(true) stores the new setting in S.settings straight away.
function toggleMusic() {
  musicEnabled = !musicEnabled;
  refreshMusic();
  saveGame(true);
}

// Turning the radio voice off also cuts a line that is playing or still on its way.
function toggleRadio() {
  radioEnabled = !radioEnabled;
  if (!radioEnabled) {
    voiceGeneration++;
    try {
      if (voiceHandle !== null) softn.audio.stop(voiceHandle);
    } catch (e) {}
    voiceHandle = null;
  }
  saveGame(true);
}

// Plays a recorded radio voice line, assets/audio/radio-<name>.mp3: 'welcome' (newGame), 'fault'
// (shift 1's first incident), 'contract' (a contract completed) or 'target' (target met). Cuts off
// any line still playing. Skipped while muted, with the radio voice off, or before a game exists.
function radioCue(name) {
  if (muted || !radioEnabled || !S) return;
  voiceGeneration++;
  var gen = voiceGeneration;
  try {
    if (voiceHandle !== null) softn.audio.stop(voiceHandle);
    voiceHandle = null;
    softn.audio.play('assets/audio/radio-' + name + '.mp3', { volume: 0.7 }, function (r) {
      if (r && r.handle) {
        if (gen === voiceGeneration) voiceHandle = r.handle;
        else softn.audio.stop(r.handle);
      }
    });
  } catch (e) {}
}
