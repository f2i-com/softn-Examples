// Mine Management / First Shift. Game state stays in ZIPP (SoftN's engine; see app/NOTICE.md);
// rendering is a view.
// This file declares most of the shared globals and builds the saved game:
//   - S, the whole saved game. newState() makes a new one; core/persistence.logic saves it and
//     checks it on load (validState). newState() is not the whole schema: ensure*() functions add
//     their sections on first use (S.plant and S.excavators in ensureOperations, mine/plant.logic;
//     S.site in ensureSite; S.career, S.contracts and S.shiftStats in ensureProgress; S.rounds,
//     S.fun, S.memos and S.memoFx, S.props, S.kevin), which is also how older saves gain new
//     sections. A new section needs an ensure function and a validator called from validState.
//   - Session globals outside S: the screen, the settings (saveGame copies them into S.settings),
//     audio handles and loop timers.
//   - The view-model the UI pages read (hud and the *Rows arrays), rebuilt by refreshUI() in
//     core/ui-state.logic, and the scene arrays handed to Scene3D in ui/main.ui.
//   - Helpers used everywhere: rand(), getTruck(), getBot(), botFor(), notify() (the radio) and
//     spend().

// ---------- Version and the saved game ----------

// Shown on the title and pause screens.
var VERSION = '1.0.0';

// The whole saved game (see above). boot() sets it to a stand-in for the title screen.
var S = null;

// ---------- Screens and loading ----------

// 'title', 'play', 'pause' or 'report'. Only 'play' runs the simulation.
var screen = 'title';

// True while the PIT tablet is up over the play screen.
var tablet = false;

// The tablet's workspace (ui/tablet/tablet.ui): 'operations', 'fleet', 'workforce', 'workshop',
// 'ledger', 'log', 'guide', 'contracts', 'excavators' or 'site'.
var tab = 'operations';

// Loading state, kept by world/scene.logic. ready: Scene3D has drawn a frame (renderReady) and no
// model is still loading or has failed (modelStatuses, from Scene3D's @modelState). The title
// screen's buttons wait for it.
var ready = false;

// Nothing changes this: ui/main.ui draws the 3D world only while it is true.
var assetsReady = true;

var renderReady = false;

var modelStatuses = {};

// Bumped by retryAssets (world/scene.logic); models carry it, so Scene3D loads them again.
var assetGeneration = 0;

// The message for ui/main.ui's asset error banner, '' when all is well.
var modelError = '';

// ---------- Title screen and saves ----------

// The seed in the title screen's box. newGame builds the mine from it: the site profile and the
// random sequence.
var seedText = 'RED-DUST-4817';

// Save status for the title, pause and report screens (core/session.logic, saveGame()).
var canContinue = false;

var saveNote = 'No saved shift';

// ---------- Settings and audio ----------
// The settings (muted, musicEnabled, radioEnabled, quality, motion) are copied into S.settings by
// saveGame() and restored by continueGame(). The radio voice's handle and generation counter belong
// to core/audio.logic, which keeps the looping sounds' state itself (musicLoop, engineLoop).

var muted = false;

var musicEnabled = true;

var radioEnabled = true;

var voiceHandle = null;

var voiceGeneration = 0;

// Graphics quality: 'low', 'balanced' or 'high' (cycleQuality in core/settings.logic).
var quality = 'balanced';

// False for reduced motion: no camera shake and less cosmetic movement.
var motion = true;

// 'chase' or 'cab', switched with C (player/input.logic). Not saved.
var cameraMode = 'chase';

// ---------- Dialogs ----------

// The "press again to confirm" flag, shared by newGame (replace the saved mine) and recoverVehicle
// in player/interactions.logic (the pause screen's paid tow). resumeGame and returnTitle clear it;
// so do newGame, continueGame and pauseGame, so a press armed on one screen never confirms on another.
var resetConfirm = false;

// The PIT JSON export overlay (mine/pit-export.logic, ui/screens/export.ui).
var exportText = '';

var exportOpen = false;

// ---------- Game loop and input ----------

// Ticks since boot.
var frameNumber = 0;

// Date.now() at the last tick; 0 makes the next tick use a nominal 1/30 s (core/game-loop.logic).
var lastFrameTime = 0;

// Real seconds not yet simulated; the simulation eats them in fixed 0.05 s steps.
var accumulator = 0;

// Seconds since refreshUI last ran (it runs every 0.25 s).
var uiClock = 0;

// Keys held down, by lower-case key name (player/input.logic).
var keys = {};

// The field service job the player is working on (player/field-kit.logic), or null. Not saved:
// pausing or loading a game drops it.
var repairJob = null;

// ---------- The 3D scene, handed to Scene3D in ui/main.ui ----------

// Built by initWorld (world/scene.logic) when a game starts or loads: terrain, site, signs and
// scenery. refreshSky (world/lighting.logic) swaps its sun and clouds as the day turns.
var sceneStatic = [];

// Rebuilt every frame by buildWorldFrame (world/scene.logic): vehicles, robots, props, effects.
var sceneObjects = [];

// Lights, sky, background and fog: world/lighting.logic. The camera: world/camera.logic. These
// starting values are replaced as soon as boot() builds the first frame.
var sceneLights = [];

var sceneCamera = { position: { x: 80, y: 54, z: 170 }, lookAt: { x: 20, y: -4, z: -10 }, fov: 67 };

var sceneSky = 'day';

var sceneBackground = '#9cbfc9';

var sceneFog = { color: '#c7bda6', near: 160, far: 660 };

// ---------- The HUD and tablet view-model ----------
// Plain values and row arrays for the UI pages, refreshed by refreshUI in core/ui-state.logic
// unless noted.

// Text and numbers for the HUD, tablet and report pages. These are only the starting fields:
// refreshUI and the module refreshes it calls add many more (hud.goal, hud.haulTitle, ...), and
// notify() sets radio and speaker. progress and job are never used; battery and profit are kept up
// to date but no page shows them.
var hud = {
  shift: '01',
  clock: '06:00',
  tonnes: '0',
  target: '320', // a placeholder: refreshUI writes S.target
  money: '$6,500',
  mode: 'ON FOOT',
  speed: '0',
  location: 'Red Dust Mine',
  action: '',
  actionDetail: '',
  goal: '',
  goalDetail: '',
  radio: '',
  speaker: '',
  condition: 'Clear / dry',
  waypoint: '',
  fuel: '100',
  reportTitle: 'SHIFT COMPLETE',
  profit: '$0',
  rank: 'C'
};

// The Fleet page's rows (and the Operations page's count).
var fleetRows = [];

// The Workforce page's rows, refreshed by refreshWorkforce (mine/workforce.logic).
var robotRows = [];

// Open field alerts for the Operations page.
var alertRows = [];

// The Shift log: the latest 18 radio messages.
var logRows = [];

// The Production page's past shifts (S.history).
var historyRows = [];

// Truck markers on the Operations map. While the repeater is down (S.relay false) they keep their
// last positions.
var mapRows = [];

// Kevin on the Operations map: only while he is on the haul road (his paddock is off the map).
var mapKevin = { visible: false, style: {} };

// The haul road on the Operations map, drawn by initMapLines when the world is built.
var mapSegments = [];

// The Workshop page's upgrades.
var upgradeRows = [];

// The report screen's figures.
var summaryRows = [];

// Map markers for the player and the waypoint (CSS positions from positionStyle).
var mapPlayer = { left: '50%', top: '80%' };

var waypointStyle = { display: 'none' };

// The truck picked on the map or the Fleet page (selectTruck in mine/fleet.logic).
var selectedTruck = 1;

// The Production page's money lines.
var financialRows = [];

// Shift progress for the HUD's meter, 0 to 100 (per cent of the target).
var totalProgress = 0;

// ---------- More session state ----------

// Seconds the latest radio line stays on the HUD: notify() sets 8, tick() counts down.
var radioTimer = 0;

// Whether the site ambience has started (core/audio.logic).
var ambientStarted = false;

// Enables the Operations page's End shift button: finishShift refuses during the first minute.
var reportCanEnd = false;

// The field job's progress over its three steps, 0 to 100, and whether one is open
// (player/field-kit.logic). The HUD hides its objective and radio panels while isRepairing.
var repairPct = 0;

var isRepairing = false;

// S.time of the last successful save; tick() autosaves 30 s of shift time later.
var lastAutosave = 0;

// localStorage keys for the save and the last good save before it (core/persistence.logic).
// Changing them strands every existing save.
var KEY_SAVE = 'mine-management.save.v1';

var KEY_BACKUP = 'mine-management.backup.v1';

// ---------- Random numbers and lookups ----------

// The simulation's random numbers: a Park-Miller (MINSTD) generator whose state is S.rng, seeded
// from the seed text by seedValue() and saved with the game, so a seed replays the same way and a
// reload carries on the same sequence. Returns a number between 0 and 1 (never exactly either).
// Jokes and cosmetic variety use flavour() (fun/banter.logic) so they don't shift this sequence.
function rand() {
  // 48271 and 2^31 - 1 are the generator's constants. The product stays below 2^53, so it is exact.
  S.rng = (S.rng * 48271) % 2147483647;
  return S.rng / 2147483647;
}

// A truck or robot by id, or null.
function getTruck(id) {
  for (var i = 0; i < S.trucks.length; i++) if (S.trucks[i].id === id) return S.trucks[i];
  return null;
}

function getBot(id) {
  for (var i = 0; i < S.robots.length; i++) if (S.robots[i].id === id) return S.robots[i];
  return null;
}

// The robot operating truck t, or null (operator_id 0 means nobody).
function botFor(t) {
  return getBot(t.operator_id);
}

// ---------- Where the player and the ute start ----------

// Where a shift starts: outside the site office, facing the ute, the crusher and the parked fleet,
// with the ute pointed down a clear lane (it used to face a light pole).
var SPAWN = { x: -34, z: 141, yaw: 1.72, pitch: -0.06 };

// The ute's parking spot, facing east: a heading h points along x = sin h, z = cos h, so PI / 2
// is +x.
var UTE_PARK = { x: -19, z: 142, heading: Math.PI / 2 };

// A fresh player on foot at SPAWN: for a new game and each new shift (mine/shift.logic), and the
// place the pause screen's tow drops you (player/interactions.logic).
function spawnPlayer() {
  return {
    x: SPAWN.x,
    z: SPAWN.z,
    y: 4,
    yaw: SPAWN.yaw,
    pitch: SPAWN.pitch,
    mode: 'foot',
    vehicle: 0,
    speed: 0,
    steer: 0,
    vy: 0,
    jump: 0,
    grounded: true
  };
}

// Puts the ute back in its parking spot, stopped (a new shift, and the tow).
function parkUte(u) {
  u.x = UTE_PARK.x;
  u.z = UTE_PARK.z;
  u.y = 4;
  u.heading = UTE_PARK.heading;
  u.speed = 0;
}

// ---------- A new truck and a new game ----------

// A new Ironback 80 haul truck. progress is where it starts along the haul road: 0 at the pit's
// loading end, 1 at the crusher. Only HT-01 comes with an operator (Gary); buyTruck
// (mine/purchases.logic) delivers the rest without one. validState doesn't check fields it
// doesn't know about, so give a new field a check there.
function freshTruck(id, progress) {
  return {
    id: id,
    external_id: 'HT-0' + id,
    type: 'truck',
    model: 'Ironback 80',
    capacity: 80, // tonnes; validState accepts no other capacity
    phase: 'standby',
    active: false,
    operator_id: id === 1 ? 1 : 0, // robot id, 0 for none
    route_id: 1,
    progress: progress,
    queueAt: 0,
    service: 0,
    payload: 0,
    loads: 0,
    tonnes: 0,
    queueSeconds: 0,
    fuel: 100,
    health: 100,
    speed: 0,
    heading: 0,
    x: 0,
    y: 0,
    z: 0,
    stopped: false,
    recall: false,
    fault: '',
    policy: 'balanced', // driving policy: 'cautious', 'balanced' or 'urgent'
    cycleStart: 0,
    lastCycle: 0,
    odometer: 0,
    wheel: 0,
    version: 1
  };
}

// A brand-new saved game for a seed: shift 1, $6,500, two trucks and two robots (Gary and Mel).
// Only the core fields; the ensure*() functions add the rest (see the header). Used by boot() for
// the title screen's stand-in and by newGame() (core/session.logic).
function newState(seed) {
  return {
    story: { seen: [], nextAt: 12 }, // radio story beats (mine/story.logic)
    schema: 1, // validState accepts schema 1 only
    seed: seed,
    rng: seedValue(seed), // rand()'s state
    shift: 1,
    time: 0, // seconds since the shift started
    duration: 720, // the shift, 06:00 to 18:00 on the clock; validState insists on 720
    target: targetFor(1),
    cash: 6500,
    revenue: 0,
    costs: 0,
    tonnes: 0,
    lifetimeTonnes: 0,
    loads: [],
    events: [],
    history: [],
    alerts: [],
    nextId: 1, // the next id for a radio event or a load
    nextEvent: 105, // shift time of the first incident (mine/simulation.logic)
    nextChat: 30, // and of the first crew chatter
    faultNumber: 0,
    weather: 'dry',
    weatherUntil: 0,
    crusher: true, // false while a fault has the crusher offline (mine/incidents.logic)
    relay: true, // false while a fault has the radio repeater down; the Operations map then freezes
    extraction: 5000, // tonnes of exposed ore left to dig; each new shift adds 2,000
    oreGrade: 0.75, // newGame takes the seed's grade instead (mine/site-profile.logic)
    hasBegun: false, // set by newGame; incidents, memos, forecasts and Kevin wait for it
    upgrade: { loader: 0, crusher: 0, roads: 0, battery: 0, relay: 0 }, // Workshop levels
    // First-shift steps: the goal text in refreshUI and the checklist in mine/progression.logic.
    tutorial: { tablet: false, dispatch: false, drive: false, repair: false, delivery: false },
    trucks: [freshTruck(1, 0), freshTruck(2, 1)],
    // assigned: the id of the truck the robot drives, 0 for none, -1 for the excavator. x and z:
    // where it is when not out in a truck or on the excavator; idle robots walk to the chargers.
    robots: [
      {
        id: 1,
        name: 'Gary',
        trait: 'Cautious. Reads every sign.',
        skill: 0.85,
        battery: 100,
        assigned: 1,
        color: '#e2a83d',
        x: 25,
        z: 163
      },
      {
        id: 2,
        name: 'Mel',
        trait: 'Excellent with a bucket. Literal.',
        skill: 1,
        battery: 100,
        assigned: -1,
        color: '#66bfb1',
        x: 31,
        z: 163
      }
    ],
    player: spawnPlayer(),
    ute: { x: UTE_PARK.x, z: UTE_PARK.z, y: 4, heading: UTE_PARK.heading, fuel: 100, health: 100, speed: 0 },
    // The excavator the player drives: swing (yaw), tonnes in the bucket and the boom (anim).
    manualExcavator: { yaw: 0, bucket: 0, anim: 0 },
    waypoint: null,
    settings: { muted: false, quality: 'balanced', motion: true }, // rewritten by every saveGame()
    endPaid: false // true once finishShift has paid the shift out; a load then opens the report
  };
}

// ---------- The radio and money ----------

// Says something on the site radio: adds it to S.events (newest first, the latest 90 kept; the
// Shift log shows them), shows it on the HUD for 8 s and sounds the alert for a warning. kind is
// 'info' (the default), 'warning' or 'success'. Does nothing before a game exists.
function notify(speaker, message, kind) {
  if (!S) return;
  var e = { id: S.nextId++, at: S.time, speaker: speaker, message: message, kind: kind || 'info' };
  S.events.unshift(e);
  if (S.events.length > 90) S.events = S.events.slice(0, 90);
  hud.radio = message;
  hud.speaker = speaker;
  radioTimer = 8;
  if (kind === 'warning') sfx('alert');
}

// Pays amount out of the cash and books it as a cost. Short of cash, it says so on the radio and
// returns false with nothing charged; also false, silently, for a negative or non-numeric amount.
function spend(amount, why) {
  if (!Number.isFinite(amount) || amount < 0) return false;
  if (S.cash < amount) {
    notify('PIT', 'Not enough funds for ' + why + '.', 'warning');
    return false;
  }
  S.cash -= amount;
  S.costs += amount;
  return true;
}
