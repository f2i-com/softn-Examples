// Project small UI snapshots; never mirror the heightfield every frame.
// The view-model: refreshUI() turns S into the plain values and row arrays the UI pages read (hud,
// fleetRows, mapRows, summaryRows and the rest, declared in core/state.logic, plus toastList at
// the end of this file). tick() (core/game-loop.logic) calls it every 0.25 s on every screen, and
// actions call it straight away so a button's effect shows at once. It also runs each module's own
// refresh (refreshProgressUI, refreshWorkforce, refreshMemoUI...), so a new page's view-model
// usually gets a refreshX() called from here. It runs four times a second: keep it cheap.
// The Operations map: positionStyle() turns metres into CSS percentages, north (-z) up.

// ---------- The Operations map ----------

// A point's place on the Operations map (ui/tablet/operations.ui): x and z in metres to CSS left
// and top percentages. The map is a 370 m square running from -180 m to 190 m on both axes.
function positionStyle(x, z) {
  return { left: ((x + 180) / 370) * 100 + '%', top: ((z + 180) / 370) * 100 + '%' };
}

// Draws the haul road on the map (called by initWorld, world/scene.logic): a CSS line from every
// other HAUL_PATH point (x, y, z) to the point two further on, placed at its start, sized to its
// length and rotated to its angle. Length and angle assume a square map, as positionStyle does:
// keep .mm-map's aspect-ratio at 1 in ui/tablet/operations.ui.
function initMapLines() {
  var a = [];
  for (var i = 1; i < HAUL_PATH.length; i += 2) {
    var p = HAUL_PATH[i - 1],
      q = HAUL_PATH[Math.min(i + 1, HAUL_PATH.length - 1)],
      dx = ((q[0] - p[0]) / 370) * 100,
      dz = ((q[2] - p[2]) / 370) * 100;
    a.push({
      id: i,
      style: {
        left: ((p[0] + 180) / 370) * 100 + '%',
        top: ((p[2] + 180) / 370) * 100 + '%',
        width: Math.sqrt(dx * dx + dz * dz) + '%',
        transform: 'rotate(' + Math.atan2(dz, dx) + 'rad)'
      }
    });
  }
  mapSegments = a;
}

// ---------- Truck rows ----------

// A truck's status for the Fleet page and the map. Trouble comes before the phase; the phase names
// are the ones validState accepts (core/persistence.logic). Also used by mine/workforce.logic.
function phaseLabel(t) {
  if (t.trafficBlocked) return 'YIELDING / OBSTACLE';
  if (t.positioning) return 'MANOEUVRING';
  if (t.fault) return 'BLOCKED';
  if (t.stopped) return 'ON HOLD';
  var b = botFor(t);
  if (b && b.battery <= 0) return 'BATTERY EMPTY';
  return (
    {
      standby: 'PARKED',
      queued: 'LOAD QUEUE',
      loading: 'LOADING',
      hauling: 'HAULING',
      dump_queue: 'TIP QUEUE',
      dumping: 'TIPPING',
      returning: 'RETURNING',
      manual: 'PLAYER CONTROL'
    }[t.phase] || t.phase
  );
}

// The colour for a truck's status: orange for faulted or on hold, grey parked, amber loading or
// tipping, teal on the move.
function phaseColor(t) {
  return t.fault || t.stopped
    ? '#f2a17d'
    : t.phase === 'standby'
      ? '#9dada9'
      : t.phase === 'loading' || t.phase === 'dumping'
        ? '#eab966'
        : '#78cdb8';
}

// One truck's row for the Fleet page (ui/tablet/fleet.ui), as display strings. Speeds are stored in
// m/s, hence the 3.6 for km/h; fill is the payload bar's width.
function makeFleetRow(t) {
  var b = botFor(t),
    fuelPct = clamp(Math.round(t.fuel), 0, 100),
    healthPct = clamp(Math.round(t.health), 0, 100),
    batPct = b ? clamp(Math.round(b.battery), 0, 100) : 0;
  return {
    id: t.id,
    name: t.external_id,
    model: t.model,
    phase: phaseLabel(t),
    crew: b ? b.name : 'Unassigned',
    payload: Math.round(t.payload) + ' / ' + t.capacity + ' t',
    fuel: fuelPct + '%',
    battery: b ? batPct + '%' : 'N/A',
    health: healthPct + '%',
    fuelFill: {
      width: fuelPct + '%',
      background: fuelPct < 25 ? '#ea8f6b' : fuelPct < 50 ? '#e3b868' : '#78cdb8'
    },
    healthFill: {
      width: healthPct + '%',
      background: healthPct < 35 ? '#ea8f6b' : healthPct < 65 ? '#e3b868' : '#8ec99f'
    },
    batteryFill: {
      width: (b ? batPct : 0) + '%',
      background: !b ? '#5b6c73' : batPct < 25 ? '#ea8f6b' : batPct < 50 ? '#e3b868' : '#8ac6d0'
    },
    lowWarning: fuelPct < 25 || healthPct < 35 || (!!b && batPct < 25),
    loads: t.loads,
    tonnes: Math.round(t.tonnes),
    speed: Math.round(t.speed * 3.6) + ' km/h',
    policy: t.policy,
    action: t.active ? (t.stopped ? 'Release' : 'Hold') : 'Dispatch',
    policyLabel: 'Driving: ' + t.policy,
    color: phaseColor(t),
    style: { borderColor: phaseColor(t), color: phaseColor(t) },
    fill: { width: (t.payload / t.capacity) * 100 + '%' },
    cycle: t.lastCycle ? Math.round(t.lastCycle) + ' s' : 'Awaiting first cycle',
    wait: Math.round(t.queueSeconds) + ' s',
    selected: selectedTruck === t.id
  };
}

// Category helper and filter toggle for the Shift log workspace ('all', 'alerts', 'ops', 'crew').
function logCategoryFor(e) {
  if (e.kind === 'warning' || e.speaker === 'PIT ALERT' || e.speaker === 'FIELD ALERT' || e.speaker === 'ESCALATION')
    return 'alerts';
  if (
    e.speaker === 'WEIGHBRIDGE' ||
    e.speaker === 'DISPATCH' ||
    e.speaker === 'LOADING' ||
    e.speaker === 'CRUSHER' ||
    e.speaker === 'HYDRAULICS' ||
    e.speaker === 'FIELD SERVICE' ||
    e.speaker === 'SITE ROUNDS' ||
    e.speaker === 'CONTRACTS' ||
    e.speaker === 'EQUIPMENT' ||
    e.speaker === 'WORKSHOP'
  )
    return 'ops';
  return 'crew';
}

function setLogFilter(next) {
  if (['all', 'alerts', 'ops', 'crew'].indexOf(next) < 0) return;
  logFilter = next;
  sfx('click');
  refreshUI();
}

// Human-readable preview of an upgrade's current vs next performance effect for Workshop cards.
function upgradeEffectLabel(id, level) {
  if (id === 'loader') {
    var curL = Math.round(level * 24),
      nxtL = Math.round((level + 1) * 24);
    return level >= 3 ? 'Loader speed +' + curL + '% (max)' : 'Loader speed +' + curL + '% → +' + nxtL + '%';
  }
  if (id === 'crusher') {
    var curC = Math.round(12 * (1 + level * 0.25)),
      nxtC = Math.round(12 * (1 + (level + 1) * 0.25));
    return level >= 3 ? 'Base crusher ' + curC + ' t/s (max)' : 'Base crusher ' + curC + ' → ' + nxtC + ' t/s';
  }
  if (id === 'roads') {
    var curW = Math.round(100 / (1 + level)),
      nxtW = Math.round(100 / (1 + level + 1));
    return level >= 3
      ? 'Chassis wear ' + curW + '% · max rain grip'
      : 'Chassis wear ' + curW + '% → ' + nxtW + '% · +8% rain speed';
  }
  if (id === 'battery') {
    var curB = Math.round((1 - 1 / (1 + level * 0.3)) * 100),
      nxtB = Math.round((1 - 1 / (1 + (level + 1) * 0.3)) * 100);
    return level >= 3
      ? 'Drain -' + curB + '% · fast charge (max)'
      : 'Battery drain -' + curB + '% → -' + nxtB + '% · faster charge';
  }
  return level >= 1 ? 'Redundant link active (no relay faults)' : 'Eliminates telemetry repeater faults';
}

// ---------- refreshUI ----------

// Rebuilds the whole view-model from S (see the header). Safe to call at any time once S exists.
function refreshUI() {
  if (!S) return;
  // ---------- Module refreshes ----------
  // Each module rebuilds its own part. They run first because blocks below read what they write:
  // hud.excavatorTask (refreshOperations) and fieldView (refreshFieldUI).
  refreshProgressUI();
  refreshSiteUI();
  refreshRounds();
  refreshIncidentUI();
  refreshFieldUI();
  refreshFieldMechanism();
  refreshOperations();
  refreshTracking();
  refreshWorkforce();
  refreshControls();
  refreshDriving();
  // ---------- Top bar and vehicle readout ----------
  var p = S.player;
  // The ute or truck the player is in; null on foot or in an excavator.
  var vehicle = p.mode === 'ute' ? S.ute : p.mode === 'truck' ? getTruck(p.vehicle) : null;
  hud.relay = S.relay;
  hud.shift = String(S.shift).padStart(2, '0');
  hud.clock = clockLabel(S.time);
  hud.tonnes = String(Math.round(S.tonnes));
  hud.target = String(S.target);
  hud.money = money(S.cash);
  // In an excavator, p.vehicle is minus its id (player/interactions.logic).
  hud.mode =
    p.mode === 'foot'
      ? 'ON FOOT'
      : p.mode === 'ute'
        ? 'SITE UTE'
        : p.mode === 'truck'
          ? getTruck(p.vehicle).external_id
          : 'EXC-0' + Math.abs(p.vehicle);
  // m/s to km/h.
  hud.speed = String(Math.round(p.speed * 3.6));
  // Rough zones: south of z = 104 m is the surface compound, below y = -16 m the pit floor.
  hud.location = p.z > 104 ? 'SURFACE OPERATIONS' : p.y < -16 ? 'BENCH 1 / EXTRACTION' : 'HAUL ROAD';
  hud.condition =
    S.weather === 'rain'
      ? 'Rain / reduced traction'
      : S.weather === 'dust'
        ? 'Dust / low visibility'
        : 'Clear / dry haul road';
  hud.fuel = String(Math.round(vehicle ? vehicle.fuel : 100));
  // ---------- Progress meter and the End shift button ----------
  totalProgress = clamp((S.tonnes / S.target) * 100, 0, 100);
  // finishShift (mine/shift.logic) refuses during the shift's first minute.
  reportCanEnd = S.time >= 60;
  // ---------- Goal text: the HUD's objective panel and the Operations page's callout ----------
  // The first step that applies wins: the tutorial's first two steps, then the oldest open alert
  // (Kevin has his own wording), then recruiting, driving, the first delivery and the target. A
  // marked site-round check (mine/rounds.logic) overrides them all.
  var goal,
    first = S.alerts.length ? S.alerts[0] : null;
  if (!S.tutorial.tablet)
    goal = ['01 / CLOCK IN', 'Press T to raise your PIT tablet. The mine is waiting. So is Gary.'];
  else if (!S.tutorial.dispatch)
    goal = [
      '02 / START PRODUCTION',
      'In PIT Operations, press Start fleet. Gary takes HT-01 and reads every sign on the way.'
    ];
  else if (first && first.kind === 'kevin')
    goal = [
      'WILDLIFE ON THE HAUL ROAD',
      'Kevin the emu is holding up the trucks. Walk up to him, drive near him or honk (H).'
    ];
  else if (first)
    goal = [
      'FIELD SERVICE REQUIRED',
      first.title + '. Mark it in the tablet, go there and fix it with your actual hands.'
    ];
  // $2,500 is the third robot's price (recruitmentPrice in mine/purchases.logic).
  else if (S.robots.length < 3 && S.cash >= 2500)
    goal = [
      '03 / BUILD YOUR CREW',
      'Recruit Oscar in Workforce, then Start fleet again to put HT-02 to work.'
    ];
  else if (!S.tutorial.drive)
    goal = [
      '03 / LEAVE THE OFFICE',
      'The ute is parked out front. Walk over and press E. Everyone hits something on their first drive.'
    ];
  else if (!S.tutorial.delivery)
    goal = [
      'THE FIRST PAYLOAD',
      'Follow the trucks down the haul road, or take one yourself and do it properly.'
    ];
  else if (S.tonnes < S.target)
    goal = [
      'KEEP THE MINE MOVING',
      'Deliver ' +
        Math.max(0, Math.round(S.target - S.tonnes)) +
        ' more tonnes. More trucks, upgrades and fewer emus all help.'
    ];
  else
    goal = [
      'TARGET MET',
      "End the shift in PIT, or keep hauling for ore money. Bazza's ramp is just south of the compound. Just saying."
    ];
  if (S.waypoint && S.waypoint.inspectionId) {
    goal = [
      'SITE ROUNDS / ' + S.rounds.done.length + ' OF 3',
      S.waypoint.label + '. Walk close and use E or Interact.'
    ];
  }
  hud.goal = goal[0];
  hud.goalDetail = goal[1];
  // ---------- Action prompt: what E does here, and how ----------
  // Most urgent first: the excavator's task, a bucket pass or tip in progress (shown as a
  // percentage), the field job's stage, then what is in reach on foot, or leaving the vehicle. A
  // tip takes 4.5 s (mine/bays.logic).
  var near = p.mode === 'foot' ? nearestInteraction() : null;
  hud.action =
    p.mode === 'excavator'
      ? hud.excavatorTask
      : vehicle && vehicle.manualLoad
        ? 'BUCKET PASS / ' +
          Math.round(clamp((vehicle.manualLoad / loaderPassDuration()) * 100, 0, 100)) +
          '%'
        : vehicle && vehicle.manualTip
          ? 'HYDRAULICS / ' + Math.round(clamp((vehicle.manualTip / 4.5) * 100, 0, 100)) + '%'
          : repairJob
            ? serviceStage().toUpperCase()
            : p.mode === 'foot'
              ? near
                ? 'E  ' + near.label
                : ''
              : 'E  Leave ' + hud.mode;
  hud.actionDetail = repairJob
    ? fieldView.hint
    : vehicle && (vehicle.manualLoad || vehicle.manualTip)
      ? 'Vehicle secured. Remain in the cab until the cycle finishes.'
      : p.mode === 'foot'
        ? near && near.kind === 'repair'
          ? 'E opens the service panel. Complete its three steps.'
          : ''
        : p.mode === 'excavator'
          ? 'A D swing / W S boom / Space dig / L discharge / C camera'
          : p.mode === 'truck'
            ? 'WASD drive / Space brake / L bucket pass or tip / C camera'
            : 'WASD drive / Space brake / H horn / C camera';
  // With the touch pads on, swap the keyboard wording for the pads' wording.
  if (controlsEnabled) {
    if (p.mode === 'foot' && near && !repairJob) hud.action = near.label;
    else if (
      p.mode !== 'foot' &&
      !repairJob &&
      !(vehicle && (vehicle.manualLoad || vehicle.manualTip)) &&
      p.mode !== 'excavator'
    )
      hud.action = 'Operating ' + hud.mode;
    if (repairJob) hud.actionDetail = fieldView.hint;
    else if (p.mode === 'excavator')
      hud.actionDetail = 'Left pad: boom / swing. Dig at the face; discharge over a stopped truck.';
    else if (vehicle && !(vehicle.manualLoad || vehicle.manualTip))
      hud.actionDetail = 'Drag to steer and accelerate. Hold brake to stop. Cab / chase changes camera.';
    else if (p.mode === 'foot' && near && near.kind === 'repair')
      hud.actionDetail = 'Tap Interact to begin service. Stay at the equipment.';
  }

  // ---------- Waypoint and the player's map markers ----------
  hud.waypoint = S.waypoint
    ? waypointBearing() + ' / ' + S.waypoint.label + ' / ' + Math.round(dist2(p, S.waypoint)) + ' m'
    : '';
  mapPlayer = positionStyle(p.x, p.z);
  mapUte = positionStyle(S.ute.x, S.ute.z);
  waypointStyle = S.waypoint ? positionStyle(S.waypoint.x, S.waypoint.z) : { display: 'none' };
  // Context-sensitive HUD control hints by player operating mode.
  controlHints =
    p.mode === 'truck'
      ? ['WASD drive', 'Space brake', 'L load / tip', 'R fill tray', 'G guide', 'P park', 'C cam', 'E exit']
      : p.mode === 'excavator'
        ? ['A / D swing', 'W / S boom', 'Space dig', 'L discharge', 'C cam', 'T tablet', 'E exit']
        : p.mode === 'ute'
          ? ['WASD drive', 'Space brake', 'P park', 'H horn', 'C cam', 'F lamp', 'T tablet', 'E exit']
          : ['WASD move', 'Shift run', 'Space jump', 'E interact', 'T tablet', 'H horn', 'F lamp', 'Esc pause'];
  // ---------- Driving readouts, and the bays for the Operations page ----------
  hud.payload =
    p.mode === 'truck' ? Math.round(vehicle.payload) + ' / ' + vehicle.capacity + ' t PAYLOAD' : '';
  hud.roadGrade = vehicle ? Math.round(vehicleHandling(vehicle, p.mode).grade * 100) + '% GRADE' : '';
  hud.loadBay =
    S.manualExcavator.bucket > 0
      ? 'EMPTY MANUAL BUCKET'
      : S.deployment.remaining
        ? 'RELOCATING'
        : !loaderAvailable()
          ? 'LOADER HELD'
          : bayOwner('loading', 0) || 'Available';
  // Near capacity: less room in the hopper than one 80 t truckload.
  hud.tipBay = S.crusher
    ? hopperSpace() < 80
      ? 'HOPPER NEAR CAPACITY'
      : bayOwner('dumping', 0) || 'Available'
    : 'INTERLOCK / OFFLINE';
  hud.exposedOre = Math.round(S.extraction) + ' t';
  // ---------- Fleet rows and truck markers ----------
  var fleet = [],
    map = [],
    activeTruckCount = 0,
    fleetNeedsAttention = false;
  for (var i = 0; i < S.trucks.length; i++) {
    var t = S.trucks[i],
      tc = phaseColor(t),
      pos = positionStyle(t.x, t.z);
    fleet.push(makeFleetRow(t));
    if (t.active && !t.stopped && !t.fault) activeTruckCount++;
    if (t.fault || (t.operator_id > 0 && !t.active && t.phase !== 'manual')) fleetNeedsAttention = true;
    // A marker on the Operations map: the truck's name and live status colour at its position.
    map.push({
      id: t.id,
      name: t.external_id,
      phase: phaseLabel(t),
      payload: t.payload > 0 ? Math.round(t.payload) + 't' : '',
      selected: selectedTruck === t.id,
      faulted: !!t.fault,
      style: { left: pos.left, top: pos.top, borderColor: tc, color: tc }
    });
  }
  fleetRows = fleet;
  // With the repeater down the map keeps the last positions it had.
  if (S.relay) mapRows = map;
  // ---------- Alerts, Kevin on the map, the radio log and past shifts ----------
  // An incident keeps its own age (mine/incidents.logic); other alerts count from when they opened.
  alertRows = S.alerts.map(function (a) {
    var critical = !!(a.eventId && a.stage === 2);
    return {
      key: a.key,
      title: a.title,
      distance: Math.round(dist2(p, a)) + ' m',
      age: Math.max(0, Math.round(a.age === undefined ? S.time - a.at : a.age)) + ' s',
      kind: a.kind,
      critical: critical,
      severity: a.kind === 'kevin' ? 'WILDLIFE' : critical ? 'CRITICAL HOLD' : a.eventId ? 'WARNING' : 'SERVICE'
    };
  });
  mapAlerts = S.alerts
    .filter(function (a) {
      return a.kind !== 'kevin';
    })
    .map(function (a) {
      var ap = positionStyle(a.x, a.z);
      return {
        key: a.key,
        title: a.title,
        critical: !!(a.eventId && a.stage === 2),
        style: ap
      };
    });
  mapKevin = kevinOnRoad()
    ? { visible: true, style: positionStyle(S.kevin.x, S.kevin.z) }
    : { visible: false, style: {} };
  var counts = { all: S.events.length, alerts: 0, ops: 0, crew: 0 };
  var filteredEvents = [];
  for (var ei = 0; ei < S.events.length; ei++) {
    var ev = S.events[ei],
      cat = logCategoryFor(ev);
    counts[cat]++;
    if (logFilter === 'all' || logFilter === cat) filteredEvents.push(ev);
  }
  logCounts = counts;
  logRows = filteredEvents.slice(0, 45).map(function (e) {
    return {
      id: e.id,
      clock: clockLabel(e.at),
      speaker: e.speaker,
      message: e.message,
      kind: e.kind,
      category: logCategoryFor(e)
    };
  });
  historyRows = S.history.map(function (h) {
    return {
      shift: h.shift,
      tonnes: h.tonnes,
      target: h.target,
      profit: h.profit,
      profitText: money(h.profit),
      positive: h.profit >= 0,
      met: h.tonnes >= h.target,
      rank: h.rank
    };
  });
  // ---------- Weighbridge loads and unit economics ----------
  var tonnePrice = 39 + S.oreGrade * 16;
  loadRows = S.loads.slice(0, 15).map(function (l) {
    var cycleSec = l.loaded_at > 0 && l.dumped_at >= l.loaded_at ? Math.round(l.dumped_at - l.loaded_at) : 0;
    return {
      id: l.id,
      shift: l.shift,
      truck: l.truck_code,
      tonnes: l.tonnes + ' t',
      dumpedClock: clockLabel(l.dumped_at),
      haulTime: cycleSec > 0 ? cycleSec + ' s' : '—',
      value: money(Math.round(l.tonnes * tonnePrice))
    };
  });
  economicsRows = [
    {
      name: 'Ore grade value',
      value: money(tonnePrice) + ' / t',
      sub: Math.round(S.oreGrade * 100) + '% copper grade'
    },
    {
      name: 'Crusher throughput',
      value: (S.crusher ? Math.round(crusherRate() * 10) / 10 : 0) + ' t/s',
      sub: S.crusher ? money(crusherRate() * tonnePrice) + '/s revenue cap' : 'Interlock offline'
    },
    {
      name: 'Shift target bonus',
      value: money(1500 + S.shift * 250),
      sub: S.tonnes >= S.target ? 'Secured at reconciliation' : 'Paid when ' + S.target + ' t tipped'
    },
    {
      name: 'Shift site overhead',
      value: money(600 + S.robots.length * 70),
      sub: '$600 base + $70 × ' + S.robots.length + ' crew'
    }
  ];
  // ---------- Workshop upgrades and field service readiness ----------
  // Same price (70% more per level) and level cap (the relay stops at 1) as buyUpgrade in
  // mine/purchases.logic: change them together.
  var affordableUpgrades = 0;
  upgradeRows = upgradeCatalog.map(function (u) {
    var level = S.upgrade[u.id],
      cap = u.id === 'relay' ? 1 : 3,
      rawCost = Math.round(u.cost * (1 + level * 0.7)),
      isMax = level >= cap,
      canAfford = !isMax && S.cash >= rawCost;
    if (canAfford) affordableUpgrades++;
    return {
      id: u.id,
      name: u.name,
      detail: u.detail,
      effect: upgradeEffectLabel(u.id, level),
      level: level,
      cap: cap,
      levelPct: { width: Math.round((level / cap) * 100) + '%' },
      cost: money(rawCost),
      max: isMax,
      canAfford: canAfford
    };
  });
  var minFuel = Math.round(S.ute.fuel),
    minHealth = Math.round(S.ute.health),
    minBat = 100;
  for (var si = 0; si < S.trucks.length; si++) {
    minFuel = Math.min(minFuel, Math.round(S.trucks[si].fuel));
    minHealth = Math.min(minHealth, Math.round(S.trucks[si].health));
  }
  for (var bi = 0; bi < S.robots.length; bi++) {
    minBat = Math.min(minBat, Math.round(S.robots[bi].battery));
  }
  var repairFactor = S.memoFx ? S.memoFx.repair : 1;
  serviceStatusRows = [
    {
      id: 'workshop',
      name: 'Workshop overhaul',
      cost: money(Math.round(450 * repairFactor)),
      stat: 'Lowest condition: ' + minHealth + '%',
      warn: minHealth < 55
    },
    {
      id: 'fuel',
      name: 'Fuel farm refill',
      cost: money(Math.round(160 * repairFactor)),
      stat: 'Lowest tank: ' + minFuel + '%',
      warn: minFuel < 35
    },
    {
      id: 'charger',
      name: 'Charging bay service',
      cost: money(Math.round(120 * repairFactor)),
      stat: 'Lowest robot: ' + minBat + '%',
      warn: minBat < 35
    },
    {
      id: 'relay',
      name: 'Spare kits & repeater',
      cost: (S.site ? S.site.spares : 0) + ' kits (-$40/job)',
      stat: S.relay ? 'Telemetry online' : 'Repeater offline',
      warn: !S.relay
    }
  ];
  // ---------- Workspace navigation badges ----------
  var unassignedTrucks = S.trucks.some(function (tr) {
    return tr.operator_id === 0;
  });
  var canRecruit = S.robots.length < 6 && S.cash >= recruitmentPrice();
  var openContracts = contractCatalog.some(function (c) {
    return S.contracts.finished.indexOf(c.id) < 0 && S.duration - S.time >= 30;
  });
  var sitePending =
    (typeof chapterView !== 'undefined' && chapterView.canChoose) ||
    (S.site && S.site.commission && !S.site.commission.accepted && !S.site.commission.done && S.time <= 660);
  tabBadges = {
    operations: alertRows.length > 0 ? String(alertRows.length) : '',
    fleet: fleetNeedsAttention ? '!' : activeTruckCount + '/' + S.trucks.length,
    workforce: minBat < 25 ? 'LOW' : unassignedTrucks && canRecruit ? 'HIRE' : '',
    workshop: affordableUpgrades > 0 ? String(affordableUpgrades) : '',
    ledger: S.loads.length > 0 ? String(S.loads.length) : '',
    log: counts.alerts > 0 ? String(counts.alerts) : '',
    guide: '',
    contracts: S.contracts.active ? 'LIVE' : openContracts ? 'OPEN' : '',
    excavators: S.deployment.remaining > 0 ? 'MOVE' : S.excavators.length < 2 && S.cash >= 14000 ? 'NEW' : '',
    site: sitePending ? 'PLAN' : S.rounds && S.rounds.done.length < 3 ? 3 - S.rounds.done.length + ' CHK' : ''
  };
  hud.alertCount = alertRows.length;
  // ---------- The Production page's money ----------
  financialRows = [
    { name: 'Processed ore sales + bonuses', value: money(S.revenue) },
    {
      name: 'Hopper ore awaiting processing',
      value: Math.round(S.plant.hopper) + ' t / ' + money(S.plant.value)
    },
    { name: 'Purchases + service', value: money(S.costs) },
    { name: 'Shift net cash flow', value: money(S.revenue - S.costs) },
    {
      name: 'Fleet payload (not sold)',
      value:
        Math.round(
          S.trucks.reduce(function (n, t) {
            return n + t.payload;
          }, 0)
        ) + ' t'
    }
  ];
  // ---------- The report, Clive's memo, career records and toasts ----------
  // The grade is the one finishShift stored in S.history (mine/shift.logic). hud.profit is kept
  // up to date, but no page shows it.
  hud.rank = S.history.length ? S.history[0].rank : 'C';
  hud.profit = money(S.revenue - S.costs);
  refreshMemoUI();
  refreshReportUI();
  refreshCareerFun();
  toastList = toastRows();
  hud.reportTitle = (reportRankTitle || 'Shift complete').toUpperCase() + '.';
  summaryRows = [
    { name: 'Completed tonnes', value: Math.round(S.tonnes) + ' / ' + S.target + ' t' },
    { name: 'Cash flow this shift', value: money(S.revenue - S.costs) },
    { name: 'Field jobs done', value: String(S.shiftStats.repairs) },
    { name: 'Fleet', value: S.trucks.length + ' trucks / ' + S.robots.length + ' operators' },
    { name: 'Mine lifetime', value: Math.round(S.lifetimeTonnes) + ' t' },
    { name: 'Hopper carried over', value: Math.round(S.plant.hopper) + ' t' }
  ];
  // ---------- Light and sound ----------
  refreshLighting();
  refreshAmbience();
  refreshEngineAudio();
  refreshMusic();
  refreshWeatherAudio();
}

// The toasts on screen, for ui/screens/overlays.ui: refreshUI fills it from toastRows()
// (fun/effects.logic).
var toastList = [];
