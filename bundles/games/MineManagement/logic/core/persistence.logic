// Saving and loading. Namespaced SoftN localStorage. Portable JSON exports are available in PIT
// (mine/pit-export.logic).
// Format: the whole S as JSON, schema 1, under KEY_SAVE (core/state.logic). Before each write the
// previous save, if it still passes validState, is copied to KEY_BACKUP, so the backup is always
// the last good save, and loading falls back to it (core/session.logic). Only S is saved: the
// settings globals are copied into S.settings first, and nothing else outside S (the screen, the
// tablet's tab, toasts, an open repair job) is kept.
// Callers: saveGame() from the autosave in tick() (every 30 s of shift time), after most actions
// that matter (purchases, shift changes, settings), and the Save shift buttons on the pause screen
// and the tablet; readSave() from core/session.logic.
// npm run soak (scripts/soak.mjs) fails any save that wouldn't load again or is over 30,000
// characters, so run it after changing S, validState or saveText.

// ---------- Validation ----------
// validState(s) is true if a parsed save is safe to load. A save can be stale, truncated or edited
// by hand, and the game trusts whatever gets through, so every field it reads should be checked
// here or in its section's validator.
//   - It is a whitelist of values, not of fields. Truck phases, weathers, player modes, driving
//     policies, story beats and the ids of badges, contracts and memos must be in the lists here
//     or in the section validators, and some constants are pinned (duration 720, capacity 80,
//     upgrade levels 0 to 3, at most 4 trucks and 6 robots; validSite also wants the stored site
//     profile to equal siteProfile(seed)). Add a value or change a constant without changing its
//     check and every save that holds it is rejected.
//   - It doesn't look for unknown fields: a new field on S, or on a truck, loads unchecked until
//     you add a check.
//   - A section that older saves lack (undefined) passes; ensure*() adds it after loading.
// The sections other modules own have their own validators, called first: validOperations
// (mine/plant.logic), validSite (mine/chapters.logic), validRounds (mine/rounds.logic), validFun
// (fun/stats.logic), validProps (world/props.logic), validKevin (world/wildlife.logic) and
// validMemos (fun/memos.logic). A new section needs one, called from here.
function validState(s) {
  if (
    !s ||
    !validOperations(s) ||
    !validSite(s) ||
    !validRounds(s) ||
    !validFun(s) ||
    !validProps(s) ||
    !validKevin(s) ||
    !validMemos(s)
  )
    return false;
  // Career, shift stats and contracts (mine/progression.logic), each optional for older saves.
  if (s.career !== undefined) {
    var c = s.career;
    if (!c || !Array.isArray(c.badges) || c.badges.length > BADGES.length) return false;
    for (var badge of c.badges)
      if (
        !BADGES.some(function (b) {
          return b.id === badge;
        })
      )
        return false;
    for (var k of ['contracts', 'manualTonnes', 'repairs'])
      if (!Number.isFinite(c[k]) || c[k] < 0) return false;
  }
  if (s.shiftStats !== undefined) {
    if (!s.shiftStats) return false;
    for (var k of ['manualTonnes', 'repairs'])
      if (!Number.isFinite(s.shiftStats[k]) || s.shiftStats[k] < 0) return false;
  }
  // At most the three contracts a shift, each a known id; the active one's deadline is shift time.
  if (s.contracts !== undefined) {
    var c = s.contracts;
    if (
      !c ||
      !Array.isArray(c.finished) ||
      c.finished.length > 3 ||
      !Number.isFinite(c.earned) ||
      c.earned < 0
    )
      return false;
    for (var id of c.finished) if (!contractSpec(id)) return false;
    if (c.active) {
      var a = c.active;
      if (
        !contractSpec(a.id) ||
        c.finished.indexOf(a.id) >= 0 ||
        !Number.isFinite(a.baseline) ||
        a.baseline < 0 ||
        !Number.isFinite(a.deadline) ||
        a.deadline < 0 ||
        a.deadline > 720
      )
        return false;
    }
  }
  // The radio story beats seen so far (mine/story.logic): five known ids at most.
  if (s.story !== undefined) {
    if (
      !s.story ||
      !Array.isArray(s.story.seen) ||
      s.story.seen.length > 5 ||
      !Number.isFinite(s.story.nextAt) ||
      s.story.nextAt < 0
    )
      return false;
    for (var beat of s.story.seen)
      if (['dispatch', 'fault', 'repair', 'delivery', 'target'].indexOf(beat) < 0) return false;
  }
  // ---------- The core fields from newState() ----------
  // 80 characters: newGame cuts the seed to that length.
  if (!s || s.schema !== 1 || typeof s.seed !== 'string' || s.seed.length > 80) return false;
  var fields = [
    'time',
    'duration',
    'shift',
    'target',
    'cash',
    'revenue',
    'costs',
    'tonnes',
    'lifetimeTonnes',
    'extraction',
    'rng',
    'nextId',
    'nextEvent',
    'nextChat'
  ];
  for (var f = 0; f < fields.length; f++) if (!Number.isFinite(s[fields[f]])) return false;
  // 720: the shift's length in seconds. S.rng must be a valid state for rand(): 1 to 2^31 - 2.
  if (
    s.time < 0 ||
    s.time > 720 ||
    s.duration !== 720 ||
    s.shift < 1 ||
    s.shift > 10000 ||
    s.rng < 1 ||
    s.rng >= 2147483647
  )
    return false;
  if (!s.player || !s.ute || !s.upgrade || !s.tutorial || !s.settings || !s.manualExcavator) return false;
  if (
    typeof s.crusher !== 'boolean' ||
    typeof s.relay !== 'boolean' ||
    typeof s.endPaid !== 'boolean' ||
    typeof s.hasBegun !== 'boolean'
  )
    return false;
  // Lifetime tonnes include this shift's.
  if (
    s.tonnes < 0 ||
    s.lifetimeTonnes < s.tonnes ||
    s.extraction < 0 ||
    s.target < 1 ||
    s.cash < -10000000 ||
    s.cash > 1e12
  )
    return false;
  // ---------- The player, the ute and the manual excavator ----------
  // bucket: tonnes in the excavator's bucket, 20 at most.
  for (var ep of ['yaw', 'bucket', 'anim']) if (!Number.isFinite(s.manualExcavator[ep])) return false;
  if (s.manualExcavator.bucket < 0 || s.manualExcavator.bucket > 20) return false;
  for (var pp of ['yaw', 'pitch', 'speed', 'steer', 'vy', 'jump'])
    if (!Number.isFinite(s.player[pp])) return false;
  for (var up of ['heading', 'fuel', 'health', 'speed']) if (!Number.isFinite(s.ute[up])) return false;
  if (s.ute.fuel < 0 || s.ute.fuel > 100 || s.ute.health < 0 || s.ute.health > 100) return false;
  if (!Number.isFinite(s.oreGrade) || s.oreGrade < 0 || s.oreGrade > 1 || !Number.isFinite(s.weatherUntil))
    return false;
  if (['dry', 'rain', 'dust'].indexOf(s.weather) < 0) return false;
  // 500 m is a loose sanity bound; the world's solid edge is at 226 m (hitsSolid in
  // player/movement.logic).
  for (var v of [s.player, s.ute])
    if (
      !Number.isFinite(v.x) ||
      !Number.isFinite(v.y) ||
      !Number.isFinite(v.z) ||
      Math.abs(v.x) > 500 ||
      Math.abs(v.z) > 500
    )
      return false;
  if (['foot', 'ute', 'truck', 'excavator'].indexOf(s.player.mode) < 0) return false;
  // ---------- Trucks and robots ----------
  // buyTruck stops at four trucks and buyRobot at six robots (mine/purchases.logic).
  if (
    !Array.isArray(s.trucks) ||
    s.trucks.length < 1 ||
    s.trucks.length > 4 ||
    !Array.isArray(s.robots) ||
    s.robots.length < 2 ||
    s.robots.length > 6
  )
    return false;
  var ids = [];
  for (var i = 0; i < s.trucks.length; i++) {
    var t = s.trucks[i];
    if (ids.indexOf(t.id) >= 0 || !Number.isInteger(t.id)) return false;
    ids.push(t.id);
    // The timers of a bucket pass and a tip the player runs from the cab (mine/bays.logic): a tip
    // takes 4.5 s, a pass at most LONGEST_PASS_SECONDS (mine/excavators.logic).
    var timerLimits = { manualLoad: LONGEST_PASS_SECONDS + 0.1, manualTip: 4.6 };
    for (var timer in timerLimits)
      if (
        t[timer] !== undefined &&
        (!Number.isFinite(t[timer]) || t[timer] < 0 || t[timer] > timerLimits[timer])
      )
        return false;
    for (var key of [
      'payload',
      'capacity',
      'progress',
      'fuel',
      'health',
      'x',
      'y',
      'z',
      'heading',
      'queueAt',
      'wheel',
      'service',
      'loads',
      'tonnes',
      'odometer',
      'version'
    ])
      if (!Number.isFinite(t[key])) return false;
    if (
      Math.abs(t.x) > 500 ||
      Math.abs(t.z) > 500 ||
      typeof t.active !== 'boolean' ||
      typeof t.stopped !== 'boolean' ||
      typeof t.recall !== 'boolean' ||
      typeof t.fault !== 'string'
    )
      return false;
    if (['balanced', 'urgent', 'cautious'].indexOf(t.policy) < 0) return false;
    // 80.001: a full load of 80 t, with room for rounding.
    if (
      t.capacity !== 80 ||
      t.payload < 0 ||
      t.payload > 80.001 ||
      t.progress < 0 ||
      t.progress > 1 ||
      t.fuel < 0 ||
      t.fuel > 100 ||
      t.health < 0 ||
      t.health > 100
    )
      return false;
    // Every truck phase the simulation uses (the labels are in phaseLabel, core/ui-state.logic).
    if (
      ['standby', 'queued', 'loading', 'hauling', 'dump_queue', 'dumping', 'returning', 'manual'].indexOf(
        t.phase
      ) < 0
    )
      return false;
  }
  // Robots: unique integer ids; a positive assigned must be one of the trucks.
  var botIds = [];
  for (var j = 0; j < s.robots.length; j++) {
    var b = s.robots[j];
    if (
      !Number.isInteger(b.id) ||
      botIds.indexOf(b.id) >= 0 ||
      !Number.isInteger(b.assigned) ||
      !Number.isFinite(b.x) ||
      !Number.isFinite(b.z)
    )
      return false;
    botIds.push(b.id);
    if (b.assigned > 0 && ids.indexOf(b.assigned) < 0) return false;
    if (
      typeof b.name !== 'string' ||
      b.name.length > 30 ||
      !Number.isFinite(b.battery) ||
      b.battery < 0 ||
      b.battery > 100 ||
      !Number.isFinite(b.skill) ||
      b.skill < 0.1 ||
      b.skill > 2
    )
      return false;
  }
  // Each truck's operator is 0 (nobody) or one of the robots.
  for (var ti = 0; ti < s.trucks.length; ti++) {
    var tv = s.trucks[ti];
    if (!Number.isInteger(tv.operator_id) || (tv.operator_id !== 0 && botIds.indexOf(tv.operator_id) < 0))
      return false;
  }
  // ---------- Upgrades, lists and alerts ----------
  for (var k of ['loader', 'crusher', 'roads', 'battery', 'relay'])
    if (!Number.isInteger(s.upgrade[k]) || s.upgrade[k] < 0 || s.upgrade[k] > 3) return false;
  for (var a of ['events', 'history', 'loads', 'alerts'])
    if (!Array.isArray(s[a]) || s[a].length > 150) return false;
  for (var ai = 0; ai < s.alerts.length; ai++) {
    var alert = s.alerts[ai];
    if (
      !alert ||
      typeof alert.key !== 'string' ||
      typeof alert.title !== 'string' ||
      !Number.isFinite(alert.x) ||
      !Number.isFinite(alert.z)
    )
      return false;
  }
  // ---------- The waypoint ----------
  // A marked spot, or a tracked truck or robot: target, id, and at (the shift time of its last
  // position report).
  if (s.waypoint) {
    var w = s.waypoint;
    if (
      !Number.isFinite(w.x) ||
      !Number.isFinite(w.z) ||
      Math.abs(w.x) > 500 ||
      Math.abs(w.z) > 500 ||
      typeof w.label !== 'string' ||
      w.label.length > 160
    )
      return false;
    if (
      w.target !== undefined &&
      (['truck', 'robot'].indexOf(w.target) < 0 ||
        !Number.isInteger(w.id) ||
        (w.target === 'truck' ? ids : botIds).indexOf(w.id) < 0 ||
        !Number.isFinite(w.at) ||
        w.at < 0 ||
        w.at > 720)
    )
      return false;
  }
  // ---------- Optional vehicle fields from later versions ----------
  // Older saves lack them; when present they must have the right type.
  for (var machine of s.trucks.concat([s.ute])) {
    for (var f of ['bodyPitch', 'bodyRoll', 'steerAngle', 'wheel'])
      if (machine[f] !== undefined && !Number.isFinite(machine[f])) return false;
    for (var f of ['obstructed', 'trafficBlocked', 'positioning', 'routeHeld'])
      if (machine[f] !== undefined && typeof machine[f] !== 'boolean') return false;
  }
  for (var machine of s.trucks.concat([s.ute]))
    if (machine.parkBrake !== undefined && typeof machine.parkBrake !== 'boolean') return false;
  // Leaving the car park (setTruckPosition in mine/route.logic): stage 0 to 2, and while under way
  // the starting point, inside the world's 226 m edge.
  for (var truck of s.trucks)
    if (
      truck.departureStage !== undefined &&
      (!Number.isInteger(truck.departureStage) ||
        truck.departureStage < 0 ||
        truck.departureStage > 2 ||
        (truck.departureStage > 0 &&
          (!Number.isFinite(truck.departureX) ||
            !Number.isFinite(truck.departureZ) ||
            Math.abs(truck.departureX) > 226 ||
            Math.abs(truck.departureZ) > 226)))
    )
      return false;
  // A fill request only makes sense while the player is driving that truck.
  for (var truck of s.trucks)
    if (
      truck.fillRequested !== undefined &&
      (typeof truck.fillRequested !== 'boolean' ||
        (truck.fillRequested &&
          (truck.phase !== 'manual' || s.player.mode !== 'truck' || s.player.vehicle !== truck.id)))
    )
      return false;
  // The haul guidance's truck (player/haul-assist.logic) and the one the player drives must exist.
  if (s.waypoint && s.waypoint.haulTruck !== undefined && ids.indexOf(s.waypoint.haulTruck) < 0) return false;
  if (s.player.mode === 'truck' && ids.indexOf(s.player.vehicle) < 0) return false;
  return true;
}

// ---------- Saving ----------

// A save keeps the recent radio log and loads only: the latest 30 events and 25 loads (both lists
// are newest first). In memory they grow to 90 and 120 entries (notify in core/state.logic,
// completeDump in mine/fleet.logic), and a host's store may hold as little as 30,000 characters
// per value (FormLogic without IndexedDB); the full lists stay in memory for the PIT export. A save
// stays near 15 KB however long the mine runs.
function saveText() {
  return JSON.stringify(Object.assign({}, S, { events: S.events.slice(0, 30), loads: S.loads.slice(0, 25) }));
}

// Reads one save slot: the parsed save if it passes validState, otherwise null (also for anything
// over 1,000,000 characters, or storage that throws).
function readSave(key) {
  try {
    var raw = localStorage.getItem(key);
    if (!raw || raw.length > 1000000) return null;
    var data = JSON.parse(raw);
    return validState(data) ? data : null;
  } catch (e) {
    return null;
  }
}

// Saves S, first copying the previous save to the backup slot if that one is still valid. Sets
// saveNote and lastAutosave (the autosave clock in tick()). Returns false if storage fails, and
// says so on the radio unless silent. Does nothing on the title screen.
function saveGame(silent) {
  if (!S || screen === 'title') return false;
  try {
    // The settings globals travel in the save; continueGame() (core/session.logic) restores them.
    // A new setting needs a line here and there.
    S.settings = {
      muted: muted,
      quality: quality,
      motion: motion,
      music: musicEnabled,
      radio: radioEnabled,
      controls: controlsEnabled,
      controlsChosen: controlsChosen,
      lookSensitivity: lookSensitivity
    };
    var previous = localStorage.getItem(KEY_SAVE);
    if (previous && previous.length < 1000000) {
      try {
        if (validState(JSON.parse(previous))) localStorage.setItem(KEY_BACKUP, previous);
      } catch (e) {}
    }
    localStorage.setItem(KEY_SAVE, saveText());
    canContinue = true;
    saveNote = 'Saved / Shift ' + S.shift + ' / ' + clockLabel(S.time);
    lastAutosave = S.time;
    if (!silent) notify('PIT', 'Shift saved locally.');
    return true;
  } catch (e) {
    saveNote = 'Save unavailable. This session is not persisted.';
    if (!silent) notify('PIT', 'Browser storage is unavailable. This shift cannot be saved.', 'warning');
    return false;
  }
}
