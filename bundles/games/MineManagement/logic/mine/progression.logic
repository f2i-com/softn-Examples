// Progression: optional contracts (Contracts tab), career commendations (badges), the shift
// milestones checklist, and the HUD's contract, pace, time-left and compass lines.
// State: S.contracts ({ active, finished, earned }; nextShift resets it), S.career (lifetime:
// badges, contracts completed, manualTonnes, repairs; S.career.fun belongs to fun/stats.logic) and
// S.shiftStats (this shift's manualTonnes and repairs). ensureProgress creates them for older
// saves, and validState (core/persistence.logic) checks them. UI rows: contractRows,
// objectiveRows and badgeRows, built by refreshProgressUI (called by refreshUI).
// updateProgress runs every simulation step and after each delivery, repair and shift close: it
// settles the active contract, advances the story and awards the badges that follow from totals.
// The other badges are awarded where their feat happens (chapters, stunts, props, wildlife).

// Rows for the Contracts tab (tablet/contracts.ui), one per contract in contractCatalog.
var contractRows = [];

// The shift milestones checklist (Contracts and Field guide tabs).
var objectiveRows = [];

// One row per commendation in BADGES (Contracts tab).
var badgeRows = [];

// Career commendations. A save may hold any of these ids and no others.
// So never rename or remove an id: validState would reject saves that hold it. The detail is the
// player's description; the thresholds are in updateProgress and where the others are awarded.
var BADGES = [
  { id: 'first', name: 'First payload', detail: 'Deliver your first 80 t' },
  { id: 'service', name: 'Field engineer', detail: 'Resolve a field fault in person' },
  { id: 'driver', name: 'Owner operator', detail: 'Personally tip 80 t at the crusher' },
  { id: 'thousand', name: 'Thousand tonne club', detail: 'Deliver 1,000 t across shifts' },
  { id: 'fleet', name: 'Fleet builder', detail: 'Own four haul trucks' },
  { id: 'air', name: 'Frequent flyer', detail: 'Keep the ute airborne for 1.5 seconds' },
  { id: 'cones', name: 'Cone ranger', detail: 'Displace 25 cones in one shift. Sorry, Gary' },
  { id: 'emu', name: 'Emu whisperer', detail: 'Move Kevin off the haul road three times' },
  { id: 'opening', name: 'Grand reopening', detail: 'Meet the target on reopening day' }
];

// The optional contracts: one active at a time, each at most once a shift. target is in the
// contract's unit, reward in dollars; contractMetric says what each one counts. validState checks
// saved contract ids against this list too.
var contractCatalog = [
  {
    id: 'production',
    name: 'Copper on the clock',
    detail: 'Deliver 240 t in the next six minutes. Fleet or manual deliveries count.',
    target: 240,
    reward: 900,
    unit: 't'
  },
  {
    id: 'manual',
    name: 'Take the wheel',
    detail: 'Personally tip 80 t at the crusher before the shift ends.',
    target: 80,
    reward: 1200,
    unit: 't'
  },
  {
    id: 'service',
    name: 'Back in business',
    detail: 'Resolve one active field fault after accepting. Routine refuelling does not count.',
    target: 1,
    reward: 500,
    unit: 'repair'
  }
];

// Creates the progression state a save lacks, after the other ensure* functions it depends on.
// Safe to call at any time, and called often.
function ensureProgress() {
  ensureOperations();
  ensureStory();
  ensureSite();
  ensureRounds();
  if (!S.career) S.career = { badges: [], contracts: 0, manualTonnes: 0, repairs: 0 };
  if (!S.contracts) S.contracts = { active: null, finished: [], earned: 0 };
  if (!S.shiftStats) S.shiftStats = { manualTonnes: 0, repairs: 0 };
}

// ---------- Contracts ----------
// Optional contracts are measured from acceptance, and settled exactly once.

// The catalogue entry for a contract id, or null.
function contractSpec(id) {
  for (var i = 0; i < contractCatalog.length; i++)
    if (contractCatalog[i].id === id) return contractCatalog[i];
  return null;
}

// The running total a contract counts: the shift's tonnes (production), the tonnes the player has
// tipped this shift (manual), or this shift's field repairs (service). A contract's progress is
// this minus its value at acceptance (the baseline).
function contractMetric(id) {
  return id === 'production' ? S.tonnes : id === 'manual' ? S.shiftStats.manualTonnes : S.shiftStats.repairs;
}

// "Accept contract" (tablet/contracts.ui). Refused while another contract is active, if this one
// was already settled this shift, or with less than 30 s of the shift left. The production
// contract must be met within 360 s of acceptance (or by the end of the shift); the others by the
// shift's end.
function acceptContract(id) {
  if (screen !== 'play') return;
  ensureProgress();
  var spec = contractSpec(id);
  if (!spec || S.contracts.active || S.contracts.finished.indexOf(id) >= 0 || S.duration - S.time < 30)
    return;
  S.contracts.active = {
    id: id,
    baseline: contractMetric(id),
    deadline: id === 'production' ? Math.min(S.duration, S.time + 360) : S.duration
  };
  notify('CONTRACTS', spec.name + ' accepted. ' + money(spec.reward) + ' on completion.');
  refreshUI();
  saveGame(true);
}

// Settles the active contract: pays the reward when its progress reaches the target in time, or
// closes it at the deadline, unpaid but with no penalty. Either way it is finished for the shift.
function updateContracts() {
  ensureProgress();
  var a = S.contracts.active;
  if (!a) return;
  var spec = contractSpec(a.id);
  var progress = contractMetric(a.id) - a.baseline;
  if (progress >= spec.target && S.time <= a.deadline) {
    S.cash += spec.reward;
    S.revenue += spec.reward;
    S.contracts.earned += spec.reward;
    S.career.contracts++;
    S.contracts.finished.push(a.id);
    S.contracts.active = null;
    notify('CONTRACTS', spec.name + ' complete. ' + money(spec.reward) + ' credited.', 'success');
    radioCue('contract');
    sfx('success');
  } else if (S.time >= a.deadline) {
    S.contracts.finished.push(a.id);
    S.contracts.active = null;
    notify('CONTRACTS', spec.name + ' expired. No penalty; your ore revenue is retained.');
  }
}

// ---------- Badges and progress ----------

// Awards a commendation once; does nothing if it is already earned. id must be in BADGES.
function awardBadge(id, name) {
  if (S.career.badges.indexOf(id) >= 0) return;
  S.career.badges.push(id);
  notify('SITE RECORD', name + ' commendation earned.', 'success');
}

// See the header: contracts, story beats (story.logic) and the badges that follow from totals.
function updateProgress() {
  ensureProgress();
  updateContracts();
  updateStory();
  if (S.lifetimeTonnes >= 80) awardBadge('first', 'First payload');
  if (S.career.repairs >= 1) awardBadge('service', 'Field engineer');
  if (S.career.manualTonnes >= 80) awardBadge('driver', 'Owner operator');
  if (S.lifetimeTonnes >= 1000) awardBadge('thousand', 'Thousand tonne club');
  if (S.trucks.length >= 4) awardBadge('fleet', 'Fleet builder');
}

// ---------- PIT view ----------

// "Show next step" (HUD and the Contracts, Field guide and Operations tabs): goes to the most
// useful next thing. The first open alert; else the Operations tab until the tablet has been
// opened and the fleet dispatched; the Workforce tab while there are fewer than three robots; a
// waypoint on the ute until the player has driven; and after that, the Contracts tab.
function focusObjective() {
  if (S.alerts.length) {
    goAlert(S.alerts[0].key);
    return;
  }
  if (!S.tutorial.tablet || !S.tutorial.dispatch) {
    if (!tablet) toggleTablet();
    tab = 'operations';
  } else if (S.robots.length < 3) {
    if (!tablet) toggleTablet();
    tab = 'workforce';
  } else if (!S.tutorial.drive) {
    setWaypoint(S.ute.x, S.ute.z, 'Site ute');
    if (tablet) toggleTablet();
  } else {
    if (!tablet) toggleTablet();
    tab = 'contracts';
  }
  refreshUI();
}

// Builds contractRows, objectiveRows and badgeRows, and the HUD's checklist, contract, time-left,
// pace and compass lines. Called by refreshUI.
function refreshProgressUI() {
  ensureProgress();
  var a = S.contracts.active;
  contractRows = contractCatalog.map(function (c) {
    var active = a && a.id === c.id,
      finished = S.contracts.finished.indexOf(c.id) >= 0;
    var progress = active ? clamp(contractMetric(c.id) - a.baseline, 0, c.target) : 0;
    return {
      id: c.id,
      name: c.name,
      detail: c.detail,
      reward: money(c.reward),
      active: !!active,
      progress: Math.round(progress) + ' / ' + c.target + ' ' + c.unit,
      fill: { width: (progress / c.target) * 100 + '%' },
      time: active ? Math.max(0, Math.ceil(a.deadline - S.time)) + ' s remaining' : '',
      disabled: !!a || finished || S.duration - S.time < 30,
      button: active ? 'In progress' : finished ? 'Closed this shift' : 'Accept contract'
    };
  });
  objectiveRows = [
    { name: 'Open your PIT tablet', done: S.tutorial.tablet },
    { name: 'Dispatch the fleet', done: S.tutorial.dispatch },
    { name: 'Recruit a second truck operator', done: S.robots.length >= 3 },
    { name: 'Drive a site vehicle', done: S.tutorial.drive },
    { name: 'Complete a field service', done: S.tutorial.repair },
    { name: 'Deliver the first payload', done: S.tutorial.delivery },
    { name: 'Meet the shift target', done: S.tonnes >= S.target }
  ];
  var done = 0;
  for (var i = 0; i < objectiveRows.length; i++) {
    var o = objectiveRows[i];
    o.mark = o.done ? '✓' : '○';
    if (o.done) done++;
  }
  hud.checklist = done + ' / ' + objectiveRows.length + ' shift milestones';
  badgeRows = BADGES.map(function (b) {
    return {
      id: b.id,
      name: b.name,
      detail: b.detail,
      earned: S.career.badges.indexOf(b.id) >= 0,
      mark: S.career.badges.indexOf(b.id) >= 0 ? '★' : '☆'
    };
  });
  hud.contract = a
    ? contractSpec(a.id).name +
      ' · ' +
      Math.round(contractMetric(a.id) - a.baseline) +
      ' / ' +
      contractSpec(a.id).target
    : 'Optional contracts available in PIT';
  hud.contractEarned = money(S.contracts.earned);
  // Real minutes left: one real second is one minute on the shift clock.
  hud.remaining = Math.max(0, Math.ceil((S.duration - S.time) / 60)) + ' min left';
  // On pace means at least the target's share for the time elapsed so far.
  var expected = (S.target * S.time) / S.duration;
  hud.pace =
    S.tonnes >= S.target
      ? 'TARGET DELIVERED'
      : S.time < 60
        ? 'SHIFT START'
        : S.tonnes >= expected
          ? 'ON PACE'
          : 'BEHIND PACE';
  // 8-point compass label for the player's facing. A yaw points along x = sin(yaw), z = cos(yaw), so
  // yaw 0 faces south (+z) and PI / 2 faces east (+x): the compass bearing (0 north, 90 east) is
  // 180 degrees minus the yaw.
  var bearing = (((180 - (S.player.yaw * 180) / Math.PI) % 360) + 360) % 360;
  hud.heading = ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'][Math.floor((bearing + 22.5) / 45) % 8];
}
