// Faults in the field: the incident catalogue, spawning faults as alerts on S.alerts, what an open
// fault does to the mine, escalation and follow-up faults, and the tidy-up once one is repaired.
// The repair itself is the field kit's job (player/field-kit.logic); the flow is described above
// spawnIncident.
// State: incident alerts in S.alerts (alerts with an eventId; plain fuel/battery alerts and Kevin's
// alert share the list), S.faultNumber, and S.site.serial / resolved / looseOre / lockedPlant /
// lockedRelay. Globals: incidentCatalog and incidentMods (derived from S.alerts, never saved).
// Callers: stepSimulation (triggerIncident, advanceIncidents), the field kit (resolveIncident),
// chapters.logic (spawnIncident for story tasks) and refreshUI (refreshIncidentUI).
// Before changing: saved incident alerts are checked by validSite in chapters.logic (at most three,
// stage 1 or 2, a.ore 0..10 t adding up to S.site.looseOre), so keep the two in step. Fault ids are
// saved as a.eventId and named in chapters.logic, crew.logic and field-kit.logic: grep before
// renaming one, and never remove one, or saves holding it are rejected.

// ---------- Plain alerts and the fault timer ----------

// Adds a plain alert (no eventId) unless one with this key is already open, radios it, and marks it
// if nothing else is marked. simulation.logic raises these for a truck out of fuel or out of
// operator charge; they never escalate, and a field job clears them.
function raiseAlert(key, title, x, z, kind, truckId) {
  for (var i = 0; i < S.alerts.length; i++) if (S.alerts[i].key === key) return;
  S.alerts.push({ key: key, title: title, x: x, z: z, kind: kind, truckId: truckId || 0, at: S.time });
  notify('PIT ALERT', title + '. Physical intervention required.', 'warning');
  if (!S.waypoint) setWaypoint(x, z, title);
}

// Called by stepSimulation when S.nextEvent is due and fewer than three non-Kevin alerts are open.
// The first fault of the game (shift 1) is always the scripted crusher interlock, already critical,
// for the tutorial; every other fault is a weighted random pick that starts as a warning.
function triggerIncident() {
  S.faultNumber++; // faults this shift; nextShift resets it
  if (S.faultNumber === 1 && S.shift === 1) {
    radioCue('fault');
    spawnIncident('crusher_interlock', 0, true);
    return;
  }
  spawnIncident(chooseIncident(), 0, false);
}

// ---------- The incident catalogue ----------

// Forty authored faults share a few bounded effects and the field kit's physical recipes. Each
// incidentDef(id, title, place, effect, recipe, cost, tendency, detail, next) below adds one spec:
//   id        saved on the alert as a.eventId (see the header before renaming one).
//   title     the alert's name on the tablet, the radio and the journal.
//   place     where the alert sits (incidentPosition): 'truck' (on a truck), 'ute', 'excavator',
//             'road' or a fixed point: 'crusher', 'lights', 'relay', 'fuel', 'charger'. Only the
//             survey story task uses 'discovery' (chapters.logic); no spec does.
//   effect    what an open fault slows or stops (syncIncidentEffects): truck, plant, loader, road,
//             light, relay, fuel, battery or ute. Each place currently has exactly one effect.
//   recipe    the field-kit puzzle: a key of fieldRecipes in player/field-kit.logic.
//   cost      dollars charged on completion (times S.memoFx.repair; a spare kit takes $40 off).
//   tendency  fault family (hydraulics, electrical, roads, crew): the seed's tendency is weighted
//             four times as heavily in chooseIncident.
//   detail    the instruction shown on the field board and in the field kit.
//   next      optional follow-up fault id, started if this one is left open (advanceIncidents).
var incidentCatalog = [];

function incidentDef(id, title, place, effect, recipe, cost, tendency, detail, next) {
  incidentCatalog.push({
    id: id,
    title: title,
    place: place,
    effect: effect,
    recipe: recipe,
    cost: cost,
    tendency: tendency,
    detail: detail,
    next: next || ''
  });
}

