// The spec for fault id, or null. Callers pass any alert's eventId, so a plain alert gets null.
function incidentSpec(id) {
  for (var d of incidentCatalog) if (d.id === id) return d;
  return null;
}

// Where a new fault's alert goes. Alerts on a truck, the ute or an excavator are kept on it by
// syncIncidentEffects. The fixed points are the crusher service panel, the compound light tower,
// the telemetry repeater, the fuel farm and the charging bay; anything unknown goes to the crusher.
function incidentPosition(d, truckId) {
  var t = truckId ? getTruck(truckId) : null;
  if (d.place === 'truck' && t) return { x: t.x, z: t.z };
  if (d.place === 'ute') return { x: S.ute.x, z: S.ute.z };
  if (d.place === 'excavator') return excavatorLocation(S.activeExcavator);
  // 78% of the way from Bench 1 to the crusher, in the loaded lane (4.4 m off the centre line).
  if (d.place === 'road') return pathPosition(0.78, 4.4);
  return (
    {
      crusher: { x: 49, z: 143 },
      lights: { x: -20, z: 130 },
      relay: { x: 115, z: 105 },
      fuel: { x: 9, z: 157 },
      charger: { x: 31, z: 163 }
    }[d.place] || { x: 49, z: 143 }
  );
}

// ---------- Spawning a fault ----------

// How a fault flows, start to finish:
// 1. Something calls spawnIncident: triggerIncident on the S.nextEvent timer, a follow-up fault
//    from advanceIncidents, a chapter's story task (advanceSiteLife in chapters.logic) or a dev
//    command. It pushes an alert onto S.alerts at stage 1 (a warning: reduced output) or, when
//    critical, stage 2 (the equipment is held).
// 2. The player marks it on the tablet (goAlert in navigation.logic only sets S.waypoint; a new
//    fault marks itself if nothing else is marked), goes there on foot and presses E (interact).
// 3. beginFieldRepair (player/field-kit.logic) opens the field kit, and starting work makes the
//    fault critical at once: equipment is held while someone works on it. Progress is kept in
//    a.work.step, which is saved, so cancelling or reloading resumes from the last step.
// 4. After the third step finishFieldRepair charges the cost, removes the alert from S.alerts and
//    calls resolveIncident (below), which lifts the fault's effects.
// Escalation: a warning left alone becomes critical after 70 s (70 game minutes), plus any grace
// from the preventive rounds, and at 145 s a fault with a next starts that follow-up. Faults are
// not cleared overnight: nextShift keeps every alert with an eventId, and its age keeps counting.

// Opens fault id as an alert and returns it, or null when the id is unknown, three faults are
// already open (validSite allows no more) or the same fault is already open on that truck. Given no
// truck, Gary's and Oscar's gags find their own trucks; other truck faults take the first at work.
function spawnIncident(id, truckId, critical) {
  ensureSite();
  var d = incidentSpec(id);
  if (
    !d ||
    S.alerts.filter(function (a) {
      return !!a.eventId;
    }).length >= 3
  )
    return null;
  if (d.place === 'truck' && !truckId) {
    var owner = id === 'gary_signs' ? getBot(1) : id === 'oscar_shortcut' ? getBot(3) : null;
    if (owner && owner.assigned > 0) truckId = owner.assigned;
  }
  if (d.place === 'truck' && !truckId) {
    var active = S.trucks.filter(function (t) {
      return t.active && t.phase !== 'manual';
    });
    // A spill needs ore in the tray: prefer a loaded truck (chooseIncident only picks a spill
    // while one is at work).
    var loaded = active.filter(function (t) {
      return t.payload > 0;
    });
    if (id === 'spilled_payload' && loaded.length) active = loaded;
    truckId = (active.length ? active[0] : S.trucks[0]).id;
  }
  if (d.place !== 'truck') truckId = 0;
  if (
    S.alerts.some(function (a) {
      return a.eventId === id && a.truckId === truckId;
    })
  )
    return null;
  var p = incidentPosition(d, truckId),
    a = {
      key: 'incident-' + ++S.site.serial, // unique for the life of the mine
      title: d.title,
      x: p.x,
      z: p.z,
      // What code outside the catalogue reads: 'crusher' for plant faults (the shift-1 story beat),
      // 'cone' for cone jobs (scene.logic draws the cone), 'relay' for telemetry, else 'field'.
      kind:
        d.effect === 'plant'
          ? 'crusher'
          : d.recipe === 'cone'
            ? 'cone'
            : d.effect === 'relay'
              ? 'relay'
              : 'field',
      truckId: truckId || 0,
      at: S.time,
      eventId: id,
      place: d.place,
      machineId: d.place === 'excavator' ? S.activeExcavator : 0, // the excavator it is on
      age: 0, // seconds open; advanceIncidents escalates on it
      stage: critical ? 2 : 1, // 1 warning (reduced output), 2 critical (held)
      chained: false, // true once the follow-up fault (spec.next) has started
      work: { step: 0 }, // field-kit steps done, 0..2
      ore: 0 // tonnes of spilled ore this alert holds (spilled_payload only)
    };
  // A spill takes up to 10 t from the truck's tray and leaves it on the road (S.site.looseOre)
  // until resolveIncident returns it to the pit's available ore.
  if (id === 'spilled_payload') {
    var t = getTruck(truckId);
    a.ore = Math.min(10, t.payload);
    t.payload -= a.ore;
    S.site.looseOre += a.ore;
  }
  S.alerts.push(a);
  syncIncidentEffects();
  siteJournal(
    d.title,
    critical
      ? 'Equipment secured. Field intervention requested.'
      : 'Warning: reduced output. Unattended faults can escalate.'
  );
  notify(
    'FIELD ALERT',
    d.title + '. ' + (critical ? 'Equipment secured.' : 'Warning / inspect before escalation.'),
    'warning'
  );
  if (!S.waypoint) setWaypoint(a.x, a.z, a.title);
  return a;
}

// ---------- What open faults do to the mine ----------

// The effect of open faults right now. It is derived from S.alerts by syncIncidentEffects, never
// saved, and nothing else should write it; its default is repeated there. The numbers multiply a
// rate (1 is normal): plant the crusher (crusherRate), road the haul road (siteRoadFactor), loader
// the active excavator (loaderPassDuration, loaderAvailable), ute the site ute's top speed.
// The flags turn false while a critical fault is open: light (site lights at night), fuel (the fuel
// farm cannot refuel) and battery (robots do not recharge).
var incidentMods = { plant: 1, road: 1, loader: 1, ute: 1, light: true, fuel: true, battery: true };

// Rebuilds incidentMods, every truck's slow-down or hold, and the crusher and telemetry switches
// from the open alerts. Call it whenever an incident is added, removed or changes stage;
// continueGame and nextShift also run it, because incidentMods is not saved. A warning slows a
// truck, the crusher, the excavator or the ute to 82% and the road to 80%. A critical fault stops
// them (the road drops to 35% and closes within 20 m of the fault) and switches off telemetry, site
// lights, fuel or charging.
function syncIncidentEffects() {
  ensureSite();
  var plant = false,
    relay = false;
  incidentMods = { plant: 1, road: 1, loader: 1, ute: 1, light: true, fuel: true, battery: true };
  // Clear only the holds this function sets: a critical truck fault is written as 'incident:<id>'.
  for (var t of S.trucks) {
    if (t.fault.indexOf('incident:') === 0) t.fault = '';
    t.incidentFactor = 1;
  }
  for (var a of S.alerts) {
    if (!a.eventId) continue;
    var d = incidentSpec(a.eventId);
    if (!d) continue;
    var critical = a.stage === 2,
      factor = critical ? 0 : 0.82;
    if (a.truckId) {
      var t = getTruck(a.truckId);
      if (t) {
        a.x = t.x;
        a.z = t.z;
        t.incidentFactor = Math.min(t.incidentFactor, factor);
        if (critical && !t.fault) t.fault = 'incident:' + a.eventId;
      }
    }
    if (a.place === 'discovery') continue; // the survey story task holds nothing up
    if (d.effect === 'plant') {
      plant = plant || critical;
      incidentMods.plant = Math.min(incidentMods.plant, factor);
    }
    if (d.effect === 'relay') relay = relay || critical;
    // The alert follows its excavator, but only a fault on the active one slows loading.
    if (d.effect === 'loader') {
      var ep = excavatorLocation(a.machineId);
      a.x = ep.x;
      a.z = ep.z;
      if (a.machineId === S.activeExcavator) incidentMods.loader = Math.min(incidentMods.loader, factor);
    }
    if (d.effect === 'road') incidentMods.road = Math.min(incidentMods.road, critical ? 0.35 : 0.8);
    if (d.effect === 'ute') {
      a.x = S.ute.x;
      a.z = S.ute.z;
      incidentMods.ute = Math.min(incidentMods.ute, factor);
    }
    if (d.effect === 'light' && critical) incidentMods.light = false;
    if (d.effect === 'fuel' && critical) incidentMods.fuel = false;
    if (d.effect === 'battery' && critical) incidentMods.battery = false;
  }
  // A critical plant or relay fault switches the crusher or telemetry off. lockedPlant and
  // lockedRelay remember that the faults did it, so this only switches back on what it switched
  // off, and not while a plain crusher or relay alert is open (no current code raises one).
  if (plant) S.crusher = false;
  else if (
    S.site.lockedPlant &&
    !S.alerts.some(function (a) {
      return !a.eventId && a.kind === 'crusher';
    })
  )
    S.crusher = true;
  if (relay) S.relay = false;
  else if (
    S.site.lockedRelay &&
    !S.alerts.some(function (a) {
      return !a.eventId && a.kind === 'relay';
    })
  )
    S.relay = true;
  S.site.lockedPlant = plant;
  S.site.lockedRelay = relay;
}

// Speed multiplier on the haul road for truck t: fleet trucks (simulation.logic) and the truck the
// player drives (movement.logic). 0 means stop. Without a truck it gives the road-wide factor only.
function siteRoadFactor(t) {
  // Road faults, then the seed's road wear (0.9..1.1; more wear is slower).
  var factor = incidentMods.road / (S.site ? S.site.profile.roadWear : 1);
  // Shift 3 is the storm chapter; plan 'b' paid for slower driving in the rain.
  if (S.shift === 3 && S.site.chapter.choice === 'b' && S.weather === 'rain') factor *= 0.85;
  if (t) {
    factor *= t.incidentFactor === undefined ? 1 : t.incidentFactor;
    // A critical road fault closes the road within 20 m of it.
    for (var a of S.alerts)
      if (a.eventId && a.stage === 2 && incidentSpec(a.eventId).effect === 'road' && dist2(t, a) < 20)
        return 0;
  }
  return factor;
}

// ---------- Escalation and the next fault ----------

// Ages every open incident by dt; stepSimulation calls it every step. A warning becomes critical at
// 70 s, and a fault with a next starts that follow-up once, at 145 s, as a warning on the same
// truck (story tasks never chain). Both times add incidentGrace (rounds.logic): 60 s for a system
// whose check is recorded this shift. The 70 also appears in refreshIncidentUI and the Field guide.
function advanceIncidents(dt) {
  var follow = [];
  for (var a of S.alerts) {
    if (!a.eventId) continue;
    a.age += dt;
    if (a.stage === 1 && a.age >= 70 + incidentGrace(a)) {
      a.stage = 2;
      notify('ESCALATION', a.title + ' now requires a hold or restricted access.', 'warning');
      siteJournal('Escalated', a.title);
    }
    var d = incidentSpec(a.eventId);
    if (!a.chained && a.age >= 145 + incidentGrace(a) && d.next && !a.storyTask) {
      a.chained = true;
      follow.push({ id: d.next, truck: a.truckId });
    }
  }
  // Started after the loop, because spawnIncident pushes onto S.alerts.
  for (var f of follow) spawnIncident(f.id, f.truck, false);
  syncIncidentEffects();
}

// Picks the next random fault id with rand() (the simulation's generator) from a bag holding each
// eligible fault weight times. Left out: relay faults once redundant telemetry is bought, a spill
// with no loaded truck at work, and a crew gag whose robot is not hired yet.
function chooseIncident() {
  ensureSite();
  var bag = [];
  for (var d of incidentCatalog) {
    if (d.effect === 'relay' && S.upgrade.relay > 0) continue;
    if (
      d.id === 'spilled_payload' &&
      !S.trucks.some(function (t) {
        return t.active && t.payload > 0;
      })
    )
      continue;
    if (
      (d.id === 'gary_signs' && !getBot(1)) ||
      (d.id === 'oscar_shortcut' && !getBot(3)) ||
      (d.id === 'dot_sensor' && !getBot(4))
    )
      continue;
    // The seed's fault family starts at 4 instead of 1. Rain adds 3 to road faults, and any truck
    // below 75% health adds 2 to hydraulic ones.
    var weight = d.tendency === S.site.profile.tendency ? 4 : 1;
    if (S.weather === 'rain' && d.tendency === 'roads') weight += 3;
    if (
      d.tendency === 'hydraulics' &&
      S.trucks.some(function (t) {
        return t.health < 75;
      })
    )
      weight += 2;
    // Each hired robot whose signature mistake this is adds 1, or 3 if its seeded quirk index is 2.
    for (var b of S.robots) {
      var memory = crewMemory(b.id);
      if (crewProfiles[b.id - 1].mistake === d.id) weight += memory && memory.quirk === 2 ? 3 : 1;
    }
    for (var n = 0; n < weight; n++) bag.push(d.id);
  }
  return bag[Math.floor(rand() * bag.length)];
}

// ---------- Resolution and the field board ----------

// Settles a finished field job. finishFieldRepair (field-kit.logic) calls it after taking the alert
// off S.alerts, for incidents and plain alerts alike. Spilled ore goes back to the pit's available
// ore (not to sales), a chapter story task completes, the crew says thanks, and the effects lift.
function resolveIncident(a) {
  if (a.ore) {
    S.site.looseOre = Math.max(0, S.site.looseOre - a.ore);
    S.extraction += a.ore;
    a.ore = 0;
  }
  if (a.eventId) S.site.resolved++; // incidents only, shown on the Site journal
  finishChapterTask(a);
  crewRepairReaction(a);
  siteJournal('Field job completed', a.title);
  syncIncidentEffects();
}

// Builds incidentRows (declared in chapters.logic) for the Site journal's field board from every
// open alert: incidents, plain alerts and Kevin. refreshUI calls it every 0.25 s.
function refreshIncidentUI() {
  incidentRows = S.alerts.map(function (a) {
    var d = incidentSpec(a.eventId),
      kevin = a.kind === 'kevin';
    return {
      key: a.key,
      title: a.title,
      detail: d
        ? d.detail
        : kevin
          ? 'Kevin is standing in the haul lane, being an emu. Walk up to him, drive near him or honk. The trucks will wait. Forever, if necessary.'
          : 'Visit the marked service point.',
      // The countdown repeats advanceIncidents' 70 s escalation time.
      status: a.eventId
        ? a.stage === 2
          ? 'HELD / FIELD WORK'
          : 'WARNING / ' + Math.max(0, Math.ceil(70 + incidentGrace(a) - a.age)) + ' s to escalation'
        : kevin
          ? 'WILDLIFE / TRUCKS WAITING'
          : 'FIELD SERVICE',
      work: kevin ? 'Shoo' : a.work ? 'Steps ' + a.work.step + ' / 3' : 'Not inspected'
    };
  });
}
