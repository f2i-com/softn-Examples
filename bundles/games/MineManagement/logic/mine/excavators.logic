// The loaders at Bench 1. Only the deployed excavator (S.activeExcavator) loads trucks, from its
// place beside the loading bay; a second one (EXC-02, bought in PIT) waits at the surface staging
// pad until it is deployed, a 20 s relocation during which loading stops. Also the player's own
// dig-and-discharge cycle in an excavator, and the excavators' poses for the renderer.
// State: S.excavators (id, name, model, passes, tonnes, paused), S.activeExcavator, S.deployment
// ({ id, remaining } while relocating) and S.manualExcavator: yaw (the arm's swing: 0 over the
// loading bay, about -1.45 at the ore face), bucket (tonnes in it), dig and dump (timers in
// seconds, 0 when idle), target (the truck being filled), owner (the excavator the bucket belongs
// to) and anim (the boom's pose). ensureOperations creates them and validOperations checks them,
// both in plant.logic: a new field needs both.
// While the player is in an excavator, S.player.vehicle is minus its id (hence the Math.abs).
// A loading pass is 20 t, for robot and player trucks alike, and takes loaderPassDuration().

// ---------- Excavators and the loader ----------

function getExcavator(id) {
  for (var i = 0; i < S.excavators.length; i++) if (S.excavators[i].id === id) return S.excavators[i];
  return null;
}

// Where an excavator stands, as { x, y, z, heading }: the deployed one at Bench 1 beside the
// loading bay, facing west; any other at the surface staging pad, facing north.
function excavatorLocation(id) {
  return id === S.activeExcavator
    ? { x: 33, y: heightAt(33, -13), z: -13, heading: -Math.PI / 2 }
    : { x: -66, y: heightAt(-66, 170) + 0.09, z: 170, heading: Math.PI };
}

// True while the player operates the deployed excavator; robot loading waits for them.
function manualLoader() {
  return S.player.mode === 'excavator' && Math.abs(S.player.vehicle) === S.activeExcavator;
}

// True when the deployed excavator can load: no critical fault on it (incidentMods.loader is 0
// then), not relocating, not held from PIT.
function loaderAvailable() {
  return incidentMods.loader > 0 && !S.deployment.remaining && !getExcavator(S.activeExcavator).paused;
}

// Seconds per 20 t bucket pass: 4 for EXC-01 and 3.2 for EXC-02, times the site's ore hardness
// (0.88 to 1.12), shortened by loader upgrades (+24% speed a level) and lengthened while a loader
// fault is at warning stage (incidentMods.loader is 0.82; the 0.1 floor avoids dividing by zero).
function loaderPassDuration() {
  return (
    ((S.activeExcavator === 2 ? 3.2 : 4) * (S.site ? S.site.profile.hardness : 1)) /
    (1 + S.upgrade.loader * 0.24) /
    Math.max(0.1, incidentMods.loader)
  );
}

// The longest a pass can run, for validState (core/persistence.logic): EXC-01's 4 s on the hardest
// ground (x 1.12) with a loader fault at warning stage (/ 0.82) and no upgrade. A critical fault
// pauses the pass instead of slowing it (advanceManualLoading in bays.logic). Change this with
// loaderPassDuration, or saves taken during a slow pass will be rejected.
var LONGEST_PASS_SECONDS = (4 * 1.12) / 0.82;

// Credits a pass and its tonnes to the deployed excavator's totals (Excavators tab).
function recordPass(amount) {
  var q = getExcavator(S.activeExcavator);
  if (amount > 0) {
    q.passes++;
    q.tonnes += amount;
  }
}

// ---------- PIT orders (Excavators tab) ----------

// Buys EXC-02 for $14,000. It arrives at the surface staging pad; deployExcavator puts it to work.
function buyExcavator() {
  if (screen !== 'play' || S.excavators.length >= 2) return;
  if (!spend(14000, 'the second excavator')) return;
  S.excavators.push({ id: 2, name: 'EXC-02', model: 'Digger 240', passes: 0, tonnes: 0, paused: false });
  notify('EQUIPMENT', 'EXC-02 delivered to the surface staging pad. Deploy from PIT → Excavators.');
  refreshUI();
  saveGame(true);
}

// "Locate & head outside": puts a waypoint on the excavator, lowers the tablet and takes the mouse.
function locateExcavator(id) {
  var q = getExcavator(id);
  if (!q) return;
  var p = excavatorLocation(id);
  setWaypoint(p.x, p.z, q.name);
  tablet = false;
  takeMouse();
  refreshUI();
}

// Holds or releases an excavator (the tab offers it for the deployed one). Loading waits while it
// is held (loaderAvailable). Not during a relocation.
function holdExcavator(id) {
  var q = getExcavator(id);
  if (!q || S.deployment.remaining) return;
  q.paused = !q.paused;
  notify('LOADING', q.name + (q.paused ? ' held. Loading waits.' : ' released.'));
  refreshUI();
}

// Swaps excavator id in at Bench 1 for the deployed one: a 20 s relocation (S.deployment), with
// loading suspended, which advanceExcavators completes. Refused while the loading bay is taken, the
// manual bucket holds ore or is mid-cycle, or the player is in an excavator.
function deployExcavator(id) {
  if (screen !== 'play' || !getExcavator(id) || id === S.activeExcavator || S.deployment.remaining) return;
  if (
    bayOwner('loading', 0) ||
    S.manualExcavator.bucket ||
    S.manualExcavator.dig ||
    S.manualExcavator.dump ||
    S.player.mode === 'excavator'
  ) {
    notify(
      'DISPATCH',
      'Wait for the bucket and loading bay to clear, and leave the excavator before deployment.'
    );
    return;
  }
  S.deployment = { id: id, remaining: 20 };
  notify(
    'MOBILISATION',
    '20-second contractor relocation. Loading is suspended until the machine is spotted.'
  );
  refreshUI();
  saveGame(true);
}

// ---------- Simulation step ----------

// Every simulation step: counts down a relocation, then makes the new excavator the deployed one
// (released from any hold). Then runs the player's dig (2 s, then the bucket holds up to 20 t from
// the face) and discharge (1 s, into the target truck), cancelling either if its conditions fail.
function advanceExcavators(dt) {
  if (S.deployment.remaining > 0) {
    S.deployment.remaining = Math.max(0, S.deployment.remaining - dt);
    if (S.deployment.remaining === 0) {
      S.activeExcavator = S.deployment.id;
      S.deployment.id = 0;
      getExcavator(S.activeExcavator).paused = false;
      notify('LOADING', 'Replacement excavator spotted at Bench 1. Loading released.');
    }
  }
  var m = S.manualExcavator;
  if (m.dig > 0) {
    if (!manualLoader() || !loaderAvailable()) {
      m.dig = 0;
      return;
    }
    m.dig += dt;
    if (m.dig >= 2) {
      m.bucket = Math.min(20, S.extraction);
      S.extraction -= m.bucket;
      m.dig = 0;
      m.anim = -0.12;
      sfx('dump');
      notify(
        'BUCKET',
        Math.round(m.bucket) + ' t secured. Swing toward the loading bay, then L to discharge.'
      );
    }
  }
  if (m.dump > 0) {
    var t = getTruck(m.target);
    // The target must still be there: fault-free, stopped, under the bucket, with the arm over it.
    if (
      !manualLoader() ||
      !loaderAvailable() ||
      !t ||
      t.fault ||
      Math.abs(t.speed) > 1 ||
      dist2(t, { x: 19, z: -13 }) > 12 ||
      Math.abs(m.yaw) > 0.35
    ) {
      m.dump = 0;
      m.target = 0;
      return;
    }
    m.dump += dt;
    if (m.dump >= 1) {
      // What does not fit in the tray stays in the bucket.
      var add = Math.min(m.bucket, t.capacity - t.payload);
      t.payload += add;
      m.bucket -= add;
      t.loadedAt = S.time;
      m.dump = 0;
      m.target = 0;
      recordPass(add);
      sfx('dump');
      // An active robot truck that is now full sets off for the crusher.
      if (t.active && t.payload >= t.capacity - 0.001) {
        t.phase = 'hauling';
        t.service = 0;
      }
      notify(
        'LOADING',
        Math.round(add) +
          ' t transferred. ' +
          Math.round(t.payload) +
          ' / ' +
          t.capacity +
          ' t aboard ' +
          t.external_id +
          '.'
      );
    }
  }
}

// ---------- Presentation ----------

// The excavator's arm for the renderer (world/interpolation.logic): yaw (swing), boom, stick and
// curl angles, and how much ore shows in the bucket. Under the player's control it follows the dig
// and discharge timers. The deployed excavator plays one loading pass per loaderPassDuration()
// while a truck is loading, and otherwise rests facing the ore face; a staged one rests facing
// forward.
function excavatorPose(id) {
  var m = S.manualExcavator;
  if (S.player.mode === 'excavator' && Math.abs(S.player.vehicle) === id) {
    var dig = clamp(m.dig / 2, 0, 1);
    return {
      yaw: m.yaw,
      boom: m.dig ? smoothBlend(0.5, -0.12, (dig - 0.5) / 0.5) : m.anim,
      stick: 0.12,
      curl: m.dig
        ? smoothBlend(-0.7, 0.55, dig)
        : m.dump
          ? smoothBlend(0.55, -0.7, m.dump)
          : m.bucket
            ? 0.55
            : -0.7,
      ore: m.bucket > 0 || m.dig > 0,
      oreAmount: m.dig
        ? smoothBlend(0, 1, (dig - 0.2) / 0.5)
        : m.dump
          ? 1 - smoothBlend(0, 1, m.dump)
          : m.bucket
            ? 1
            : 0
    };
  }
  if (id !== S.activeExcavator) return { yaw: 0, boom: 0.48, stick: 0.15, curl: -0.63, ore: false };
  // Seconds into the pass of whichever truck is loading, robot or player-driven.
  var elapsed = -1;
  for (var i = 0; i < S.trucks.length; i++) {
    var t = S.trucks[i];
    if (t.phase === 'loading') elapsed = t.service;
    if (t.manualLoad) elapsed = t.manualLoad;
  }
  if (elapsed < 0)
    return { yaw: -1.45, boom: 0.5, stick: 0.15, curl: -0.5, ore: m.owner === id && m.bucket > 0 };
  // c is the fraction of the pass done. The pass: fill the bucket at the face (to 0.22), lift
  // (to 0.38), swing to the truck (to 0.64), empty the bucket (to 0.82), swing back (from 0.84).
  var c = clamp(elapsed / loaderPassDuration(), 0, 1);
  var yaw =
    c < 0.38
      ? -1.45
      : c < 0.64
        ? smoothBlend(-1.45, 0, (c - 0.38) / 0.26)
        : c < 0.84
          ? 0
          : smoothBlend(0, -1.45, (c - 0.84) / 0.16);
  var boom =
    c < 0.22
      ? 0.5
      : c < 0.38
        ? smoothBlend(0.5, -0.12, (c - 0.22) / 0.16)
        : c < 0.84
          ? -0.12
          : smoothBlend(-0.12, 0.5, (c - 0.84) / 0.16);
  var curl =
    c < 0.22
      ? smoothBlend(-0.5, 0.55, c / 0.22)
      : c < 0.64
        ? 0.55
        : c < 0.82
          ? smoothBlend(0.55, -0.75, (c - 0.64) / 0.18)
          : smoothBlend(-0.75, -0.5, (c - 0.82) / 0.18);
  return {
    yaw: yaw,
    boom: boom,
    stick:
      c < 0.22
        ? 0.15
        : c < 0.38
          ? smoothBlend(0.15, 0.08, (c - 0.22) / 0.16)
          : c < 0.84
            ? 0.08
            : smoothBlend(0.08, 0.15, (c - 0.84) / 0.16),
    curl: curl,
    ore: c > 0.1 && c < 0.82,
    oreAmount: c < 0.64 ? smoothBlend(0, 1, (c - 0.1) / 0.12) : 1 - smoothBlend(0, 1, (c - 0.64) / 0.18)
  };
}

// The HUD hint while the player is in an excavator (hud.excavatorTask, set by refreshOperations):
// what to do next, worded for the touch controls when they are on, otherwise for the keyboard.
function excavatorInstruction() {
  var m = S.manualExcavator;
  if (Math.abs(S.player.vehicle) !== S.activeExcavator)
    return 'Staging pad / deploy this excavator from PIT before digging';
  if (S.deployment.remaining) return 'Relocation in progress';
  if (!loaderAvailable()) return 'Loader held / release in PIT → Excavators';
  if (m.dig) return 'DIGGING / ' + Math.round((m.dig / 2) * 100) + '%';
  if (m.dump) return 'DISCHARGING / ' + Math.round(m.dump * 100) + '%';
  if (controlsEnabled) {
    if (m.bucket > 0)
      return Math.abs(m.yaw) > 0.35
        ? 'Bucket ' + Math.round(m.bucket) + ' t / swing left toward the truck'
        : 'Bucket ' + Math.round(m.bucket) + ' t / tap Discharge over the stopped truck';
    return m.yaw > -0.95 ? 'Swing right toward the ore face' : 'Aligned with ore / tap Dig bucket';
  }
  if (m.bucket > 0)
    return Math.abs(m.yaw) > 0.35
      ? 'Bucket ' + Math.round(m.bucket) + ' t / A swings back toward the truck'
      : 'Bucket ' + Math.round(m.bucket) + ' t / L discharges into a stopped, spotted truck';
  return m.yaw > -0.95
    ? 'D swings toward the ore face / W S boom'
    : 'Space starts a two-second dig / A swings toward the truck';
}
