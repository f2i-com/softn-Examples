// Fixed 20 Hz authoritative shift simulation. Three.js never awards production.
// stepSimulation(0.05) is one step of the whole game world: tick() in core/game-loop.logic calls it
// up to four times a frame while screen is 'play', and S.time advances 0.05 s per step. The robot
// trucks' haul cycle is worked here; the phases, and which code changes them, are listed at the
// top of fleet.logic.
// State: it advances S.time and sets S.weather, S.nextEvent and S.nextChat. On robot trucks it
// writes phase, progress, speed, fuel, health, payload, service, queueSeconds, loadedAt and
// routeHeld; it drains and charges operator batteries and takes ore from S.extraction.
// The order of a step matters: the render snapshot comes first, before anything moves; then
// incidents, site events, the clock, the player, the loader and crusher, manual loading and
// tipping, props, Kevin and memos; then each robot truck works its phase; then pitBays hands out
// the bays, every truck moves towards its pose, and the traffic watchers look at the result; then
// repairs, idle crew, weather, new incidents, crew chatter and progress; and the shift closes when
// its time is up.
// This function's own randomness (incident and chatter timing) comes from rand(), the saved,
// seeded simulation generator in core/state.logic.
function stepSimulation(dt) {
  if (!S || screen !== 'play') return;
  // Create any state an older save lacks.
  ensureOperations();
  ensureSite();
  ensureFun();
  ensureMemos();
  captureMotion(); // where things were before this step, for render interpolation
  advanceIncidents(dt);
  advanceSiteLife(dt);
  S.time = Math.min(S.duration, S.time + dt);
  updatePlayer(dt);
  advanceExcavators(dt);
  advanceCrusher(dt);
  advanceManualTip(dt);
  advanceFillRequests();
  advanceManualLoading(dt);
  advanceProps(dt);
  advanceWildlife(dt);
  advanceMemos(dt);
  decayShake(dt);
  // Head Office's trust-fall memo (fun/memos.logic) pauses every active robot truck for 20 s.
  var trustFall = S.memoFx.pauseUntil > S.time;
  for (var i = 0; i < S.trucks.length; i++) {
    var t = S.trucks[i];
    var b = botFor(t);
    if (t.phase === 'manual') continue; // the player drives it (player/movement.logic)
    var previousSpeed = t.speed;
    t.speed = 0;
    t.routeHeld = false;
    if (trustFall && t.active) {
      t.routeHeld = true;
      continue;
    }
    // A parked truck at the crusher end charges its operator (faster with battery upgrades), unless
    // a battery incident has knocked out charging. updateCrew charges idle robots as well.
    if (!t.active) {
      if (b && t.progress > 0.9 && incidentMods.battery) {
        b.battery = Math.min(100, b.battery + dt * (0.22 + S.upgrade.battery * 0.12));
      }
      continue;
    }
    // Held, faulted, out of fuel or with a flat operator: frozen where it is.
    if (t.stopped || t.fault || t.fuel <= 0 || (b && b.battery <= 0)) continue;
    // The operator's battery drains 0.027% a second (about a fifth of a charge a shift), less with
    // battery upgrades. An empty battery stops the truck until a field visit.
    if (b) b.battery = Math.max(0, b.battery - (dt * 0.027) / (1 + S.upgrade.battery * 0.3));
    if (b && b.battery === 0) {
      raiseAlert('battery-' + t.id, 'Operator battery exhausted', t.x, t.z, 'battery', t.id);
      continue;
    }
    // Time spent queueing, shown on the Fleet tab.
    if (t.phase === 'queued' || t.phase === 'dump_queue') {
      t.queueSeconds += dt;
    }
    // Still manoeuvring onto its pose, or leaving the car park: the phase waits until it is there.
    if (t.positioning || t.departureStage) continue;
    if (t.phase === 'loading') {
      // The loader waits while the player drives the excavator, while it is unavailable, and while
      // the manual bucket still holds ore. Each pass adds up to 20 t; the truck leaves full, or
      // with whatever it has once the face runs out.
      if (manualLoader() || !loaderAvailable() || S.manualExcavator.bucket > 0) continue;
      t.service += dt;
      if (t.service >= loaderPassDuration()) {
        var add = Math.min(20, t.capacity - t.payload, S.extraction);
        t.payload += add;
        S.extraction -= add;
        recordPass(add);
        t.service = 0;
        if (t.payload >= t.capacity - 0.001 || S.extraction <= 0) {
          t.phase = 'hauling';
          t.loadedAt = S.time;
        }
      }
    } else if (t.phase === 'dumping') {
      // The tip waits while the crusher's interlock is tripped. It takes 6 s, less with crusher
      // upgrades; then the load is credited and the truck heads back down, or parks if recalled.
      if (!S.crusher) continue;
      t.service += dt;
      if (t.service >= 6 / (1 + S.upgrade.crusher * 0.25)) {
        completeDump(t);
        t.service = 0;
        if (t.recall) {
          // Recalled (recallTruck): park in the car park at the crusher end, where the operator
          // charges.
          t.phase = 'standby';
          t.active = false;
          t.recall = false;
          t.progress = 1;
          notify('DISPATCH', t.external_id + ' parked at the surface. Charging operator.');
        } else {
          t.phase = 'returning';
        }
      }
    } else if (t.phase === 'hauling' || t.phase === 'returning') {
      var loaded = t.phase === 'hauling';
      // Speed in m/s: 8.2 loaded or 10 empty, times the driving policy, the weather (road upgrades
      // ease the rain), the operator's skill, their favourite policy (crewPolicyFactor in
      // crew.logic) and the road (siteRoadFactor in incidents.logic: 0 near a critical road fault).
      var policy = t.policy === 'urgent' ? 1.22 : t.policy === 'cautious' ? 0.8 : 1;
      var speed =
        (loaded ? 8.2 : 10) *
        policy *
        (S.weather === 'rain' ? 0.68 + S.upgrade.roads * 0.08 : 1) *
        (S.weather === 'dust' ? 0.82 : 1);
      speed *= (0.86 + (b ? b.skill : 0.8) * 0.14) * crewPolicyFactor(t) * siteRoadFactor(t);
      // Reserve spacing on the shared lane. A stopped truck is an obstacle, not a ghost.
      // A truck in the same phase (same lane, same direction) less than 20 m ahead slows this one,
      // to a stop at 13 m. Robot trucks never collide, so this spacing is what keeps them apart.
      for (var j = 0; j < S.trucks.length; j++) {
        var other = S.trucks[j];
        if (other.id === t.id) continue;
        if (other.phase === t.phase) {
          var gap = (other.progress - t.progress) * (loaded ? 1 : -1) * routeTotal;
          if (gap > 0 && gap < 20) speed = Math.min(speed, Math.max(0, (gap - 13) * 1.8));
        }
      }
      speed = Math.min(speed, previousSpeed + dt * 2.8); // accelerate at up to 2.8 m/s^2
      speed = routeSafeSpeed(t, speed, loaded); // stop for anything else in the lane (route.logic)
      var traveled = speed * dt;
      t.progress = clamp(t.progress + ((loaded ? 1 : -1) * traveled) / routeTotal, 0, 1);
      t.speed = speed;
      // Fuel in percent: 0.026 a second loaded, 0.019 empty, times the policy factor.
      t.fuel = Math.max(0, t.fuel - dt * (loaded ? 0.026 : 0.019) * policy);
      // Wear in percent condition: four times as fast when urgent, scaled by the site's road wear,
      // eased by road upgrades.
      t.health = Math.max(
        0,
        t.health -
          (dt * (t.policy === 'urgent' ? 0.008 : 0.002) * S.site.profile.roadWear) / (1 + S.upgrade.roads)
      );
      if (t.fuel === 0) raiseAlert('fuel-' + t.id, 'Fuel exhausted', t.x, t.z, 'fuel', t.id);
      // On reaching the first free slot of the queue ahead ((waiting + 1) x 15 m short of the bay
      // it is driving to), join that queue. queueAt, the arrival time, sets its place in the order.
      var waiting = 0;
      for (var q of S.trucks) if (q.phase === (loaded ? 'dump_queue' : 'queued')) waiting++;
      if (loaded && t.progress >= 1 - ((waiting + 1) * 15) / routeTotal) {
        t.phase = 'dump_queue';
        t.queueAt = S.time;
      } else if (!loaded && t.progress <= ((waiting + 1) * 15) / routeTotal) {
        t.phase = 'queued';
        t.queueAt = S.time;
      }
    }
  }
  pitBays(); // hand free bays to the heads of the queues (fleet.logic)
  for (var n = 0; n < S.trucks.length; n++) setTruckPosition(S.trucks[n], dt); // route.logic
  laneWatch(dt);
  fleetWatchdog(dt);
  advanceRepair(dt); // a field repair in progress (player/field-kit.logic)
  updateCrew(dt); // idle robots walk to the compound and charge (workforce.logic)
  if (S.weather !== 'dry' && S.time > S.weatherUntil) {
    S.weather = 'dry';
    notify('WEATHER', 'Conditions clearing. Haul road traction restored.');
  }
  // A new incident every 140 to 230 s (more often after the consultant memo), but not while three
  // or more alerts other than Kevin are open: then look again in 18 s.
  if (S.hasBegun && S.time >= S.nextEvent) {
    if (
      S.alerts.filter(function (a) {
        return a.kind !== 'kevin';
      }).length < 3
    ) {
      triggerIncident();
      S.nextEvent = S.time + (140 + rand() * 90) / S.memoFx.incidents;
    } else S.nextEvent = S.time + 18;
  }
  // Crew chatter every 38 to 78 s, unless the quiet memo is in force.
  if (S.time >= S.nextChat) {
    if (S.memoFx.quietUntil <= S.time) crewChat();
    S.nextChat = S.time + 38 + rand() * 40;
  }
  updateProgress(); // contracts, story beats and badges (progression.logic)
  if (S.time >= S.duration) finishShift();
}
