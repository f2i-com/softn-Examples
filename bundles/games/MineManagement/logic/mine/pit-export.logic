// The "PIT JSON snapshot" (PIT is the operations tablet): a read-only JSON export of the fleet, the
// haul route, production metrics, loads and radio events. It is labelled simulated game data
// (source 'SIMULATED GAME DATA ONLY', calibrated: false) and makes no network requests: showExport
// only puts the text in exportText, which the export screen (app/ui/screens/export.ui) shows in a
// read-only box for the player to copy.
// State: none saved; exportText and exportOpen are declared in core/state.logic.
// Callers: the PIT snapshot buttons on the report screen and the Production tab (showExport), and
// the export screen's Close button or Escape (hideExport, via keyDown in player/input.logic).
// Coordinates: the export's x is east and its y is the game's z (south); elevation is the game's y.

// Builds the snapshot object. Numbers are rounded to 0.1 (nround); headings stay in radians. loads
// and events are the lists in memory (up to 120 loads and 90 events); after a reload they hold only
// what the save kept (25 and 30, see saveText).
function pitSnapshot() {
  var f = [];
  for (var i = 0; i < S.trucks.length; i++) {
    var t = S.trucks[i],
      r = botFor(t);
    f.push({
      id: t.id,
      external_id: t.external_id,
      type: t.type,
      capacity: t.capacity,
      // down: held by a fault; delay: held from the tablet; ready: dispatched; standby: parked.
      status: t.fault ? 'down' : t.stopped ? 'delay' : t.active ? 'ready' : 'standby',
      operator_name: r ? r.name : null,
      route_id: 1,
      phase: t.phase,
      payload: nround(t.payload),
      x: nround(t.x),
      y: nround(t.z),
      elevation: nround(t.y),
      heading: t.heading,
      fuel_percent: nround(t.fuel),
      version: t.version
    });
  }
  return {
    schema: 'mine-management.pit-snapshot.v1',
    source: 'SIMULATED GAME DATA ONLY',
    calibrated: false,
    seed: S.seed,
    shift: S.shift,
    elapsed_seconds: nround(S.time),
    fleet: f,
    routes: [
      {
        id: 1,
        name: 'Bench 1 to crusher',
        origin_id: 1,
        destination_id: 2,
        // The haul road's centre line, Bench 1 to the crusher, as [x, y, elevation] points.
        geometry: {
          type: 'LineString',
          coordinates: HAUL_PATH.map(function (p) {
            return [p[0], p[2], p[1]];
          })
        }
      }
    ],
    // The two ends of the haul road (the first and last HAUL_PATH points).
    locations: [
      { id: 1, name: 'Bench 1', x: 17, y: -14, elevation: -22 },
      { id: 2, name: 'Crusher', x: 72, y: 138, elevation: 4 }
    ],
    metrics: {
      dumped_tonnes: nround(S.tonnes),
      target_tonnes: S.target,
      // Ore still in the trucks' trays.
      undumped_tonnes: S.trucks.reduce(function (n, t) {
        return n + t.payload;
      }, 0),
      hopper_tonnes: nround(S.plant.hopper),
      processed_tonnes: nround(S.plant.processed),
      pending_ore_value: nround(S.plant.value)
    },
    loads: S.loads,
    events: S.events
  };
}

// Helper to produce the current career save JSON string, either from the live shift or storage.
function currentCareerSaveJson() {
  if (S && screen !== 'title') {
    S.settings = {
      muted: muted,
      quality: quality,
      motion: motion,
      music: musicEnabled,
      radio: radioEnabled,
      controls: controlsEnabled,
      controlsChosen: controlsChosen,
      lookSensitivity: lookSensitivity
    };
    return saveText();
  }
  try {
    var stored = localStorage.getItem(KEY_SAVE) || localStorage.getItem(KEY_BACKUP) || '';
    return stored;
  } catch (e) {
    return '';
  }
}

// Switches between 'snapshot' (PIT telemetry export) and 'save' (portable career save backup/restore).
function switchExportMode(mode) {
  exportMode = mode === 'save' ? 'save' : 'snapshot';
  exportFeedback = '';
  exportFeedbackKind = 'info';
  if (exportMode === 'save') {
    exportText = currentCareerSaveJson();
  } else {
    exportText = S ? JSON.stringify(pitSnapshot(), null, 2) : '';
  }
  sfx('click');
}

// Opens the export screen with the snapshot as indented JSON, and frees the mouse so the text can
// be selected.
function showExport() {
  exportMode = 'snapshot';
  exportFeedback = '';
  exportFeedbackKind = 'info';
  exportText = JSON.stringify(pitSnapshot(), null, 2);
  exportOpen = true;
  releaseMouse();
}

// Opens the export screen directly on the portable career save backup & restore tab.
function showSaveBackup() {
  exportMode = 'save';
  exportFeedback = '';
  exportFeedbackKind = 'info';
  importText = '';
  exportText = currentCareerSaveJson();
  exportOpen = true;
  releaseMouse();
}

// Copies exportText to the system clipboard when permitted, with clear fallback instructions.
function copyExportText() {
  if (!exportText) {
    exportFeedback = 'Nothing to copy yet — start a shift first.';
    exportFeedbackKind = 'warning';
    return;
  }
  try {
    if (typeof navigator !== 'undefined' && navigator.clipboard && navigator.clipboard.writeText) {
      var clipRes = navigator.clipboard.writeText(exportText);
      if (clipRes && typeof clipRes.then === 'function') {
        clipRes.then(
          function () {
            exportFeedback =
              exportMode === 'save'
                ? 'Career save JSON copied to clipboard.'
                : 'PIT telemetry snapshot copied to clipboard.';
            exportFeedbackKind = 'success';
            if (S) refreshUI();
          },
          function () {
            exportFeedback = 'Clipboard blocked here — click inside the JSON box and press Ctrl+C (or Cmd+C).';
            exportFeedbackKind = 'info';
            if (S) refreshUI();
          }
        );
      }
      exportFeedback =
        exportMode === 'save'
          ? 'Career save JSON copied to clipboard.'
          : 'PIT telemetry snapshot copied to clipboard.';
      exportFeedbackKind = 'success';
      sfx('click');
      return true;
    }
  } catch (e) {}
  exportFeedback = 'Click inside the JSON box below and press Ctrl+C (or Cmd+C) to copy.';
  exportFeedbackKind = 'info';
  sfx('click');
  return false;
}

// Validates and restores a pasted career save JSON string into localStorage and loads it.
function importSaveData() {
  var raw = String(importText || '').trim();
  if (!raw) {
    exportFeedback = 'Paste a Mine Management career save JSON string into the restore box first.';
    exportFeedbackKind = 'warning';
    return false;
  }
  if (raw.length > 30000) {
    exportFeedback = 'Save JSON exceeds the 30,000-character storage limit (' + raw.length + ' chars).';
    exportFeedbackKind = 'warning';
    return false;
  }
  var parsed = null;
  try {
    parsed = JSON.parse(raw);
  } catch (e) {
    exportFeedback = 'Invalid JSON syntax. Paste the complete career save JSON without truncation.';
    exportFeedbackKind = 'warning';
    return false;
  }
  if (parsed && parsed.schema === 'mine-management.pit-snapshot.v1') {
    exportFeedback =
      'That is a PIT telemetry snapshot, not a restorable career save. Export from Career Save Backup instead.';
    exportFeedbackKind = 'warning';
    return false;
  }
  if (!validState(parsed)) {
    exportFeedback = 'Save rejected by schema validation. Only authentic schema v1 Red Dust saves can load.';
    exportFeedbackKind = 'warning';
    return false;
  }
  var normalized = JSON.stringify(
    Object.assign({}, parsed, {
      events: parsed.events.slice(0, 30),
      loads: parsed.loads.slice(0, 25)
    })
  );
  if (normalized.length > 30000) {
    exportFeedback = 'Normalized save exceeds 30,000 characters.';
    exportFeedbackKind = 'warning';
    return false;
  }
  try {
    var previous = localStorage.getItem(KEY_SAVE);
    if (previous && previous.length < 1000000) {
      try {
        if (validState(JSON.parse(previous))) localStorage.setItem(KEY_BACKUP, previous);
      } catch (e2) {}
    }
    localStorage.setItem(KEY_SAVE, normalized);
  } catch (e) {
    exportFeedback = 'Browser localStorage is unavailable in this environment.';
    exportFeedbackKind = 'warning';
    return false;
  }
  importText = '';
  exportFeedback = 'Save validated and restored: Shift ' + parsed.shift + ' (' + money(parsed.cash) + ').';
  exportFeedbackKind = 'success';
  checkSave();
  sfx('success');
  if (ready || screen !== 'title') {
    exportOpen = false;
    continueGame();
    toast('SAVE RESTORED · SHIFT ' + S.shift, 'good');
  } else {
    exportText = normalized;
    refreshUI();
  }
  return true;
}

function hideExport() {
  exportOpen = false;
  exportFeedback = '';
}
