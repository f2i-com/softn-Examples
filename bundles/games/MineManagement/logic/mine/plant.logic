// Finite material flow and an owned loader fleet. Authored game-scale values.
// The crusher plant: a 240 t receiving hopper, filled by tips (completeDump in fleet.logic) and
// emptied by the crusher at crusherRate() tonnes a second while it runs (S.crusher; a tripped
// interlock stops it). Tonnes count toward the shift target when they are tipped; their money
// (the value completeDump adds to S.plant.value) reaches S.cash and S.revenue only as the crusher
// processes them. A truck tips only if its whole payload fits, so while the crusher is stopped the
// hopper fills and the tip queue waits. The hopper and its unpaid value carry over between shifts.
// Also the operations part of the save: ensureOperations creates S.plant, S.excavators,
// S.activeExcavator, S.deployment and the newer S.manualExcavator fields for older saves, and
// validOperations (part of validState) checks them; a new field needs both.
// The 240 t capacity is repeated in refreshOperations, validOperations and world/scene.logic.
// Callers: advanceCrusher from stepSimulation; refreshOperations from refreshUI.

// Rows for the Excavators tab (tablet/excavators.ui), built by refreshOperations.
var excavatorRows = [];

// Creates the operations state a save lacks (see the header). Called every simulation step, by
// ensureProgress, and before a tip is credited. S.plant: hopper (tonnes waiting), value (their
// unpaid dollars), processed (tonnes ever crushed, which also sizes the stockpile in
// world/collision.logic and world/scene.logic; it starts at the mine's lifetime tonnes so an older
// save's stockpile matches its history), shaft and belt (animation phases, see advanceCrusher) and
// flow (tonnes a second crushed in the last step).
function ensureOperations() {
  if (!S.plant) S.plant = { hopper: 0, value: 0, processed: S.lifetimeTonnes, shaft: 0, belt: 0, flow: 0 };
  if (!S.excavators)
    S.excavators = [{ id: 1, name: 'EXC-01', model: 'Digger 200', passes: 0, tonnes: 0, paused: false }];
  if (!S.activeExcavator) S.activeExcavator = 1;
  if (!S.deployment) S.deployment = { id: 0, remaining: 0 };
  var m = S.manualExcavator;
  if (!m.owner) m.owner = 1;
  if (m.dig === undefined) m.dig = 0;
  if (m.dump === undefined) m.dump = 0;
  if (m.target === undefined) m.target = 0;
}

// ---------- Crusher and hopper ----------

// Tonnes a second the crusher processes: 12, plus 25% per crusher upgrade, times the plant's
// incident factor (0.82 while a plant fault is at warning stage) and the rebrand memo's 1.1.
function crusherRate() {
  return 12 * (1 + S.upgrade.crusher * 0.25) * incidentMods.plant * (S.memoFx ? S.memoFx.crusher : 1);
}

// Room left in the hopper, in tonnes.
function hopperSpace() {
  return Math.max(0, 240 - S.plant.hopper);
}

// Every simulation step: crushes up to dt x crusherRate() tonnes from the hopper and pays out their
// share of its value. Nothing happens while the interlock is tripped.
function advanceCrusher(dt) {
  var p = S.plant;
  p.flow = 0;
  if (!S.crusher) return;
  // Animation phases: the crusher's drive shaft (radians) turns faster with ore in the hopper; the
  // conveyor's phase, which moves its cleats and ore along the belt, loops from 0 to 1.
  p.shaft = (p.shaft + dt * (p.hopper > 0 ? 3.5 : 1.1)) % (Math.PI * 2);
  p.belt = (p.belt + dt * 0.13) % 1;
  var amount = Math.min(p.hopper, dt * crusherRate());
  if (amount <= 0) return;
  var value = p.value * (amount / p.hopper); // these tonnes' share of the hopper's unpaid value
  p.hopper = Math.max(0, p.hopper - amount);
  p.value = Math.max(0, p.value - value);
  p.processed += amount;
  p.flow = amount / dt;
  // Empty: clear the rounding dust so no value is left without ore.
  if (p.hopper < 0.000001) {
    p.hopper = 0;
    p.value = 0;
  }
  S.cash += value;
  S.revenue += value;
}

// ---------- PIT view ----------

// The plant lines of the HUD (state, hopper, processed, rate, unpaid value) and excavatorRows for
// the Excavators tab. Called by refreshUI (core/ui-state.logic).
function refreshOperations() {
  var p = S.plant;
  hud.plantState = !S.crusher
    ? 'INTERLOCK TRIPPED'
    : p.flow > 0
      ? 'CRUSHING & CONVEYING'
      : 'RUNNING / AWAITING FEED';
  hud.hopper = Math.round(p.hopper) + ' / 240 t';
  hud.processed = Math.round(p.processed) + ' t';
  hud.processRate = Math.round(S.crusher ? crusherRate() : 0) + ' t/s';
  hud.pendingValue = money(p.value);
  excavatorRows = S.excavators.map(function (q) {
    var active = q.id === S.activeExcavator;
    return {
      id: q.id,
      name: q.name,
      model: q.model,
      status:
        S.deployment.id === q.id
          ? 'RELOCATING / ' + Math.ceil(S.deployment.remaining) + ' s'
          : active
            ? q.paused
              ? 'ON HOLD'
              : 'BENCH 1 / LOADER'
            : 'SURFACE / STANDBY',
      // The base pass times from loaderPassDuration (excavators.logic); keep them in step.
      pass: q.id === 2 ? '20 t / 3.2 s base pass' : '20 t / 4.0 s base pass',
      tonnes: Math.round(q.tonnes) + ' t loaded',
      passes: q.passes,
      hold: q.paused ? 'Release loader' : 'Hold loader',
      deployed: active,
      disabled: active || S.deployment.remaining > 0
    };
  });
  hud.excavatorCount = S.excavators.length;
  hud.excavatorTask = S.player.mode === 'excavator' ? excavatorInstruction() : '';
}

// ---------- Save validation ----------

// Part of validState (core/persistence.logic): checks the operations fields of a save being loaded,
// each only if the save has it (ensureOperations adds missing ones after loading). Returns false to
// reject the save.
function validOperations(s) {
  if (s.plant !== undefined) {
    if (!s.plant) return false;
    for (var k of ['hopper', 'value', 'processed', 'shaft', 'belt', 'flow'])
      if (!Number.isFinite(s.plant[k]) || s.plant[k] < 0) return false;
    if (s.plant.hopper > 240.001 || s.plant.belt > 1 || s.plant.shaft > Math.PI * 2 + 0.001) return false;
  }
  if (s.excavators !== undefined) {
    if (!Array.isArray(s.excavators) || s.excavators.length < 1 || s.excavators.length > 2) return false;
    var ids = [];
    for (var q of s.excavators) {
      if (
        !q ||
        [1, 2].indexOf(q.id) < 0 ||
        ids.indexOf(q.id) >= 0 ||
        typeof q.paused !== 'boolean' ||
        typeof q.name !== 'string' ||
        typeof q.model !== 'string' ||
        !Number.isFinite(q.passes) ||
        q.passes < 0 ||
        !Number.isFinite(q.tonnes) ||
        q.tonnes < 0
      )
        return false;
      ids.push(q.id);
    }
    // The active excavator and the deployment are only checked alongside the excavators.
    if (ids.indexOf(s.activeExcavator) < 0) return false;
    if (
      !s.deployment ||
      !Number.isFinite(s.deployment.remaining) ||
      s.deployment.remaining < 0 ||
      s.deployment.remaining > 20 ||
      [0, 1, 2].indexOf(s.deployment.id) < 0 ||
      (s.deployment.remaining > 0 && ids.indexOf(s.deployment.id) < 0)
    )
      return false;
  }
  if (s.manualExcavator) {
    var m = s.manualExcavator;
    // The dig takes 2 s and the discharge 1 s.
    for (var k of ['dig', 'dump'])
      if (m[k] !== undefined && (!Number.isFinite(m[k]) || m[k] < 0 || m[k] > 2.1)) return false;
    if (m.owner !== undefined && [1, 2].indexOf(m.owner) < 0) return false;
  }
  return true;
}
