// The robot crew's personalities and what they remember: who each robot is, their radio lines, the
// Workforce tab's check-ins, and the rapport a repair earns.
// State: each robot's memory is an entry in S.site.crew ({ id, rapport 0..100, helped, talkedAt,
// quirk 0..2, checkIns }), created by ensureSite in chapters.logic and checked by validSite there.
// Global: crewProfiles.
// Callers: the Workforce tab (checkInCrew; workforce.logic shows the profiles), crewChat in
// fun/banter.logic (contextualCrewChat), resolveIncident (crewRepairReaction), the fleet simulation
// (crewPolicyFactor) and chooseIncident (each robot's signature mistake).
// Before changing: robots are hired in the order Gary, Mel, Oscar, Dot, Bazza, June (buyRobot) and
// get ids 1 to 6, so crewProfiles[id - 1] is that robot's profile; other files use the ids directly
// (getBot(3) is Oscar). Keep the two lists in the same order.

// One profile per robot, in id order:
//   preference  the driving policy the robot likes; a truck set to it runs 2.5% faster.
//   specialty, history  shown on the Workforce tab.
//   quirks      three; each mine shows one, picked by the memory's seeded quirk index.
//   hello, thanks, rain  radio lines for contextCrewLine.
//   mistake     the incident id this robot is prone to; chooseIncident weights it up.
var crewProfiles = [
  {
    name: 'Gary',
    preference: 'cautious',
    specialty: 'Traffic discipline',
    history:
      'Former warehouse marshal. Promoted himself to custodian of every sign at Red Dust. Nobody has had the heart to tell him.',
    quirks: [
      'Alphabetises warning signs',
      'Counts the cones twice, then once more for luck',
      'Keeps a pocket register of every sign he has met'
    ],
    hello: 'I have read the sign about reading the signs. It could be clearer.',
    thanks:
      'Thank you. I have recorded this as an example of a human following a useful instruction. It is my favourite entry.',
    rain: 'The wet-weather sign is now wet. Excellent corroborating evidence.',
    mistake: 'gary_signs'
  },
  {
    name: 'Mel',
    preference: 'balanced',
    specialty: 'Consistent bucket passes',
    history:
      'Learned excavation at a tiny quarry. Calls every oversized rock a training opportunity, and every training opportunity Trevor.',
    quirks: [
      'Names difficult rocks (they are all Trevor)',
      'Dislikes half buckets on principle',
      'Counts passes out loud, in binary'
    ],
    hello: 'The bucket is a very direct way of having a conversation with geology.',
    thanks: 'Good repair. I can resume applying the bucket to the problem.',
    rain: 'Wet ore. Same hole. I have adjusted my expectations downward and to the left.',
    mistake: 'boom_sensor'
  },
  {
    name: 'Oscar',
    preference: 'balanced',
    specialty: 'Steady haul cycles',
    history:
      'Ex-delivery robot. Believes every new route has a nice shortcut, despite a growing body of evidence and one very cross fence.',
    quirks: [
      'Collects route souvenirs (mostly gravel)',
      'Rates every parking space out of five',
      'Apologises to bollards, at length'
    ],
    hello: 'No shortcuts today. Unless the long way turns out to be a shortcut to somewhere else.',
    thanks: 'You came back for me. Five stars for roadside assistance. Would get stuck again.',
    rain: 'I have removed optimism from my stopping-distance estimate. It was doing most of the work.',
    mistake: 'oscar_shortcut'
  },
  {
    name: 'Dot',
    preference: 'cautious',
    specialty: 'Careful instrumentation',
    history:
      'A former laboratory assistant. Trusts a measurement only after checking the instrument that checked it, and then the bench it sat on.',
    quirks: [
      'Labels the calibration labels',
      'Carries a reference washer for emotional support',
      'Distrusts round numbers, especially ten'
    ],
    hello: 'The reading is suspiciously plausible. I will take another.',
    thanks: 'Repair verified. I have independently verified my satisfaction. It is within tolerance.',
    rain: 'Moisture detected. This time it is definitely outside the sensor.',
    mistake: 'dot_sensor'
  },
  {
    name: 'Bazza',
    preference: 'urgent',
    specialty: 'Fast surface turnaround',
    history:
      'Worked a salvage yard before the mine. Calls every machine mate, including the broken ones, and especially the ones that bite.',
    quirks: [
      'Names engines mate',
      'Collects spare brackets for a project he will not describe',
      'Prefers the noisy truck, as a lifestyle'
    ],
    hello: "How's the ute going, mate? And how are you going, other mate?",
    thanks: 'That is the sound of a machine feeling appreciated, mate.',
    rain: 'Bit slippery, mate. Even the confident wheels are taking it easy.',
    mistake: 'vibration'
  },
  {
    name: 'June',
    preference: 'balanced',
    specialty: 'Patient queue management',
    history:
      'Former night-shift depot coordinator. Knows that arriving calmly beats arriving dramatically, and has a diary to prove it.',
    quirks: [
      'Keeps a shift diary with a ribbon in it',
      'Enjoys quiet radio channels and loud thunderstorms',
      'Remembers every handover, word for word'
    ],
    hello: 'There is time to do the next thing properly. Usually that saves time later.',
    thanks: 'I have put the repair in the handover. Someone should remember the good bits too.',
    rain: 'I will keep the queue calm. You look after the road.',
    mistake: 'radio_failure'
  }
];

// ---------- Memory and check-ins ----------

// The saved memory for robot id in S.site.crew, or null if there is none yet.
function crewMemory(id) {
  if (!S.site) return null;
  for (var c of S.site.crew) if (c.id === id) return c;
  return null;
}

// Speed multiplier for fleet truck t (simulation.logic): 2.5% faster when its driving policy is the
// one its operator prefers.
function crewPolicyFactor(t) {
  var b = botFor(t);
  if (!b) return 1;
  return t.policy === crewProfiles[b.id - 1].preference ? 1.025 : 1;
}

// The Workforce tab's Radio check-in button. Each robot answers properly at most every 60 s (an
// hour on the game clock); each answer adds 2 rapport (up to 100) and calls contextCrewLine.
function checkInCrew(id) {
  if (screen !== 'play') return;
  ensureSite();
  var b = getBot(id),
    m = crewMemory(id);
  if (!b || !m) return;
  // Seconds since the mine's first shift began (720 per shift), so the limit holds across shifts.
  var stamp = (S.shift - 1) * 720 + S.time;
  if (stamp - m.talkedAt < 60) {
    notify(
      b.name.toUpperCase(),
      pick([
        'Still here. Still a robot. Let us get this shift done.',
        'You checked in a minute ago. I appreciate the enthusiasm.',
        'Nothing new to report, except that you keep asking. Which is nice.'
      ])
    );
    return;
  }
  m.talkedAt = stamp;
  m.checkIns++;
  m.rapport = Math.min(100, m.rapport + 2);
  contextCrewLine(b);
  refreshUI();
}

// Radios one line from robot b that fits the moment, first match wins: rain, its truck's fault, low
// battery, a full tray, else hello. Two overrides beat all of those: Gary talks about his sign
// register once it holds anything; otherwise rapport of 40 or more brings the thanks line.
function contextCrewLine(b) {
  var p = crewProfiles[b.id - 1],
    m = crewMemory(b.id),
    t = b.assigned > 0 ? getTruck(b.assigned) : null;
  var line =
    S.weather === 'rain'
      ? p.rain
      : t && t.fault
        ? 'I have stopped at the fault and put my hazard lights on. They are very bright. The alert has my location.'
        : b.battery < 20
          ? 'My battery is low. A calm return to charging would be appreciated. A dramatic one would also be fine.'
          : t && t.payload >= 80
            ? 'Full tray. Keeping the load on the road is now my entire personality.'
            : p.hello;
  if (b.id === 1 && S.site.signs > 0)
    line =
      'The sign register now holds ' +
      S.site.signs +
      ' field observation' +
      (S.site.signs === 1 ? '' : 's') +
      '. I have ordered an index for the index.';
  else if (m && m.rapport >= 40) line = p.thanks + ' I trust your timing.';
  notify(b.name.toUpperCase(), line);
}

// A random robot says its context line; crewChat (fun/banter.logic) calls this on the chat timer.
// The robot is picked with flavour(), the jokes' generator: who chats must never move rand(), or
// the same site would play out differently from one session to the next (npm run replay checks).
function contextualCrewChat() {
  ensureSite();
  var i = Math.floor(flavour() * S.robots.length) % S.robots.length;
  contextCrewLine(S.robots[i]);
}

// ---------- Reactions ----------

// After a field job (from resolveIncident): the robot it helped gains 4 rapport (up to 100) and
// says thanks: the truck's operator for a truck alert, Mel for an excavator fault, Gary for the
// rest, else the first robot. A cone job also adds to Gary's sign register (S.site.signs).
function crewRepairReaction(a) {
  ensureSite();
  var b = a.truckId ? botFor(getTruck(a.truckId)) : getBot(a.machineId ? 2 : 1);
  if (!b) b = S.robots[0];
  var m = crewMemory(b.id);
  m.helped++;
  m.rapport = Math.min(100, m.rapport + 4);
  if (a.kind === 'cone' || a.eventId === 'gary_signs' || a.eventId === 'cone') S.site.signs++;
  notify(b.name.toUpperCase(), crewProfiles[b.id - 1].thanks);
}
