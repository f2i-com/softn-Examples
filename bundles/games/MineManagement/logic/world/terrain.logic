// The ground: how high it is anywhere on the site, in metres. heightAt() reads the generated
// height field (HEIGHTS in world/terrain-data.logic); JUMPS adds two hand-made dirt ramps on top,
// and groundAt() is the sum of the two.
//
// Owns JUMPS (a constant); nothing on S. Called from all over: use groundAt() for anything that
// should ride over the jumps (the player, driven vehicles, props, Kevin, the camera's ground
// check) and heightAt() for the bare terrain (buildings, colliders, the haul road, scenery).
// The terrain is also drawn, as assets/models/terrain.glb, so heightAt() stays truthful only while
// HEIGHTS and that model change together (see the header of terrain-data.logic). The jumps are
// not in that model: scenery.logic draws them from JUMPS, so they always match.

// ---------- Height field ----------

// Bare terrain height at (x, z). Each FIELD_CELL (5 m) cell is two triangles, split along the
// diagonal from its low-x, low-z corner to its high-x, high-z corner (u >= v is the triangle on
// the high-x side), and the height is interpolated across the one the point is in. Points off
// the field take the edge height; the 1.001 keeps them inside the last cell, so n + FIELD_N + 1
// stays inside HEIGHTS.
function heightAt(x, z) {
  var a = clamp((x - FIELD_ORIGIN) / FIELD_CELL, 0, FIELD_N - 1.001),
    b = clamp((z - FIELD_ORIGIN) / FIELD_CELL, 0, FIELD_N - 1.001);
  var i = Math.floor(a),
    j = Math.floor(b),
    u = a - i,
    v = b - j,
    n = j * FIELD_N + i;
  return u >= v
    ? HEIGHTS[n] + u * (HEIGHTS[n + 1] - HEIGHTS[n]) + v * (HEIGHTS[n + FIELD_N + 1] - HEIGHTS[n + 1])
    : HEIGHTS[n] +
        v * (HEIGHTS[n + FIELD_N] - HEIGHTS[n]) +
        u * (HEIGHTS[n + FIELD_N + 1] - HEIGHTS[n + FIELD_N]);
}

// ---------- Dirt jumps ----------

// Unauthorised earthworks. Two dirt humps south of the compound turn the site ute into a stunt
// vehicle: drive over a crest fast enough and the ground falls away faster than gravity can follow.
// Heights are analytic, so walking, driving, the camera and the collision code all agree on them.
// Each jump: centre x, z; len along its run, wide across it and high at the crest, in metres; yaw
// is the direction of the run (0 runs along z, PI / 2 along x). The flying is in
// player/stunts.logic.
var JUMPS = [
  { id: 'bazza', name: "Bazza's Ramp (not approved)", x: -22, z: 192, len: 15, wide: 7, high: 2.3, yaw: 0 },
  { id: 'kicker', name: 'The Kicker', x: 38, z: 206, len: 12, wide: 6, high: 1.9, yaw: Math.PI / 2 }
];

// Height a jump adds at a point: a symmetric hump, highest across its middle. The profile is a
// tent (straight up to the crest, straight down again) and flat across the width, the shape of
// the prism that jumpObjects() in scenery.logic draws. Where jumps overlap, the higher one wins.
function jumpHeight(x, z) {
  var h = 0;
  for (var j of JUMPS) {
    var dx = x - j.x,
      dz = z - j.z,
      c = Math.cos(j.yaw),
      s = Math.sin(j.yaw);
    var along = dx * s + dz * c,
      across = dx * c - dz * s;
    if (Math.abs(across) > j.wide / 2 || Math.abs(along) > j.len / 2) continue;
    h = Math.max(h, j.high * (1 - Math.abs(along) / (j.len / 2)));
  }
  return h;
}

// The surface things stand on and drive over: the terrain plus any jump.
function groundAt(x, z) {
  return heightAt(x, z) + jumpHeight(x, z);
}
