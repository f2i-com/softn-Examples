// Flattening the scene for Scene3D. SoftN v0.0.8 loads GLB models only at the scene root: a model
// inside a group doesn't render. The actors are still built as nested groups, because that is the
// easy way to pose them (a truck is truck-1 > terrain-tilt > bed-pivot > tray), and flattenScene()
// then flattens those articulated assemblies into root objects, preserving local XYZ Euler
// transforms: each group's transform is baked into its leaves. A leaf's id becomes its path
// ('truck-1/terrain-tilt/chassis'), which is also the name a model that fails to load is reported
// under. Primitive-only camera-attached groups remain native groups: they pass through as they are.
//
// No state. flattenScene() runs on every frame from buildWorldFrame() (scene.logic) and for the
// sky (skyObjects in lighting.logic); rigging.logic uses the quaternion helpers too. Rotations are
// Euler angles in radians, in three.js's XYZ order, the way Scene3D reads them.

// ---------- Quaternions ----------

// The quaternion for an XYZ Euler rotation { x, y, z } (three.js order). No rotation gives the
// identity.
function rotationQuaternion(e) {
  var x = (e ? e.x : 0) * 0.5,
    y = (e ? e.y : 0) * 0.5,
    z = (e ? e.z : 0) * 0.5;
  var cx = Math.cos(x),
    sx = Math.sin(x),
    cy = Math.cos(y),
    sy = Math.sin(y),
    cz = Math.cos(z),
    sz = Math.sin(z);
  return {
    x: sx * cy * cz + cx * sy * sz,
    y: cx * sy * cz - sx * cy * sz,
    z: cx * cy * sz + sx * sy * cz,
    w: cx * cy * cz - sx * sy * sz
  };
}

// The product a * b: rotate by b, then by a. With a the parent's rotation and b the child's own,
// that is the child's rotation in the world.
function multiplyQuaternion(a, b) {
  return {
    x: a.x * b.w + a.w * b.x + a.y * b.z - a.z * b.y,
    y: a.y * b.w + a.w * b.y + a.z * b.x - a.x * b.z,
    z: a.z * b.w + a.w * b.z + a.x * b.y - a.y * b.x,
    w: a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z
  };
}

// Vector v rotated by q (q * v * q^-1).
function rotateVector(q, v) {
  var ix = q.w * v.x + q.y * v.z - q.z * v.y,
    iy = q.w * v.y + q.z * v.x - q.x * v.z,
    iz = q.w * v.z + q.x * v.y - q.y * v.x,
    iw = -q.x * v.x - q.y * v.y - q.z * v.z;
  return {
    x: ix * q.w - iw * q.x - iy * q.z + iz * q.y,
    y: iy * q.w - iw * q.y - iz * q.x + ix * q.z,
    z: iz * q.w - iw * q.z - ix * q.y + iy * q.x
  };
}

// Back from a quaternion to XYZ Euler angles, through the rotation matrix, as three.js does. The
// second branch is gimbal lock: with the y angle at +-90 degrees, x and z turn about the same axis.
function quaternionEuler(q) {
  var m11 = 1 - 2 * (q.y * q.y + q.z * q.z),
    m12 = 2 * (q.x * q.y - q.w * q.z),
    m13 = 2 * (q.x * q.z + q.w * q.y),
    m22 = 1 - 2 * (q.x * q.x + q.z * q.z),
    m23 = 2 * (q.y * q.z - q.w * q.x),
    m32 = 2 * (q.y * q.z + q.w * q.x),
    m33 = 1 - 2 * (q.x * q.x + q.y * q.y);
  var y = Math.asin(clamp(m13, -1, 1));
  return Math.abs(m13) < 0.9999999
    ? { x: Math.atan2(-m23, m33), y: y, z: Math.atan2(-m12, m11) }
    : { x: Math.atan2(m32, m22), y: y, z: 0 };
}

// ---------- Flattening ----------

// A scale as { x, y, z }: a number means the same on every axis, nothing means 1.
function scaleVector(v) {
  return typeof v === 'number' ? { x: v, y: v, z: v } : v || { x: 1, y: 1, z: 1 };
}

// Places spec in the world, given its parent's world transform, and pushes the result to output.
// A leaf is copied with its world position, rotation and scale; a group outputs nothing itself,
// only its children, placed in its frame. Scale combines per axis, which is exact while groups
// are unscaled (none in this game is); a non-uniformly scaled group with turned children would
// need a shear, which a flat object can't express.
function flattenObject(spec, parentPosition, parentRotation, parentScale, prefix, output) {
  // Camera-attached objects live in camera space, not the world: they pass through untouched,
  // children and all, so they must be built from primitives only.
  if (spec.attach === 'camera') {
    output.push(spec);
    return;
  }
  var q = multiplyQuaternion(parentRotation, rotationQuaternion(spec.rotation));
  var offset = spec.position || { x: 0, y: 0, z: 0 };
  offset = rotateVector(parentRotation, {
    x: offset.x * parentScale.x,
    y: offset.y * parentScale.y,
    z: offset.z * parentScale.z
  });
  var pos = {
    x: parentPosition.x + offset.x,
    y: parentPosition.y + offset.y,
    z: parentPosition.z + offset.z
  };
  var ownScale = scaleVector(spec.scale),
    scale = { x: parentScale.x * ownScale.x, y: parentScale.y * ownScale.y, z: parentScale.z * ownScale.z },
    id = prefix ? prefix + '/' + spec.id : spec.id;
  if (spec.type === 'group') {
    for (var i = 0; i < (spec.children || []).length; i++)
      flattenObject(spec.children[i], pos, q, scale, id, output);
  } else {
    var leaf = Object.assign({}, spec);
    leaf.id = id;
    leaf.position = pos;
    leaf.rotation = quaternionEuler(q);
    leaf.scale = scale;
    output.push(leaf);
  }
}

// Flattens a list of root objects (see the header) into a new list; the input is left as it was.
function flattenScene(objects) {
  var out = [];
  for (var i = 0; i < objects.length; i++)
    flattenObject(
      objects[i],
      { x: 0, y: 0, z: 0 },
      { x: 0, y: 0, z: 0, w: 1 },
      { x: 1, y: 1, z: 1 },
      '',
      out
    );
  return out;
}
