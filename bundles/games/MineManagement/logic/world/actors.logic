// The machines and the crew as scene objects: haul trucks, crew robots and excavators. Each
// builder returns one group, posed from the visual*() views (interpolation.logic), for
// buildWorldFrame() (scene.logic), the only caller, which flattens it. Draw-only: nothing here
// changes S. The numbers that place parts (axles, the bed pivot, the excavator's joints) belong
// to the GLB parts in assets/models. The bed pivot is repeated in tipRams() (vehicles.logic) and
// the excavator's joints in rigging.logic: change them together.

// A haul truck: the chassis, a tipping bed (tray and load) on its pivot, the tip rams, four wheels
// (the front pair steers), a beacon that flashes amber (red when faulted) and headlights, all
// tilted to the ground by bodyPitch and bodyRoll (settleVehicle in vehicles.logic).
function truckObject(t) {
  t = visualVehicle(t, false);
  var progress = tipProgress(t),
    tipping = tipAngle(progress),
    ore = visiblePayload(t);
  var tray = model('tray', 'haul-bed', 0, 0, 0);
  var bedChildren = [tray];
  // The load, its height in proportion to the payload, slides 0.7 m back as the bed tips.
  if (ore > 0.1)
    bedChildren.push(
      model('ore', 'payload', 0, 0.4, -smoothBlend(0, 0.7, (progress - 0.3) / 0.35), {
        x: 1,
        y: Math.max(0.015, ore / t.capacity),
        z: 1
      })
    );
  // The bed hinges 3.25 m up and 3.6 m behind the centre; tipRams() assumes the same spot.
  var children = [
    model('chassis', 'haul-body', 0, 0, 0),
    {
      id: 'bed-pivot',
      type: 'group',
      position: vec(0, 3.25, -3.6),
      rotation: vec(-tipping, 0, 0),
      children: bedChildren
    }
  ];
  children = children.concat(tipRams(tipping));
  // Wheels 3.3 m either side of the centre line: the rear axle (j = 0) 3.3 m back, the front one
  // (j = 1) 3 m forward, and it steers.
  for (var side = -1; side <= 1; side += 2) {
    for (var j = 0; j < 2; j++) {
      var wheel = model('wheel' + side + '-' + j, 'wheel', 0, 0, 0);
      wheel.rotation = vec(t.wheel, 0, 0);
      children.push(
        group(
          'axle' + side + '-' + j,
          side * 3.3,
          1.73,
          j === 0 ? -3.3 : 3,
          j === 1 ? t.steerAngle || 0 : 0,
          [wheel]
        )
      );
    }
  }
  // The beacon pulses, each truck a little out of step with the others.
  var beacon = box('beacon', 0, 6.22, 3, 0.4, 0.25, 0.4, t.fault ? '#ff6443' : '#f0b541');
  beacon.emissive = t.fault ? '#e34420' : '#ff9c22';
  beacon.emissiveIntensity = 0.5 + Math.sin(S.time * 6 + t.id) * 0.3;
  children.push(beacon);
  for (var x = -1; x <= 1; x += 2) {
    var light = box('head' + x, x * 2.9, 3.1, 5.31, 0.7, 0.28, 0.05, '#fff2cc');
    light.emissive = '#ffe4ab';
    light.emissiveIntensity = 1;
    children.push(light);
  }
  var tilt = group('terrain-tilt', 0, 0, 0, 0, children);
  tilt.rotation = vec(t.bodyPitch || 0, 0, t.bodyRoll || 0);
  return group('truck-' + t.id, t.x, t.y, t.z, t.heading, [tilt]);
}

// A crew robot standing at (x, y, z): GLB body and legs, box arms and a hard hat with a band in
// the robot's colour. working means walking: the legs swing and it faces where it is going;
// otherwise it faces north (PI), in a truck's cab too. During the fireworks both arms go up and it
// hops; a wave (b.waveUntil: a honk nearby, or the fireworks) raises the right arm.
function robotObject(b, x, z, y, working) {
  var swing = working && motion ? Math.sin(b.walkPhase || 0) * 0.38 * (b.walkBlend || 0) : 0;
  var col = b.color || '#e2a83d';
  var party = fireworksUntil > S.time,
    wave = party || (b.waveUntil || 0) > S.time,
    t = S.time * 11 + b.id;
  var hop = party && motion ? Math.abs(Math.sin(S.time * 6 + b.id)) * 0.4 : 0;
  // A leg turns about the hip, 0.85 m above the leg model's origin, so the origin is moved round
  // the hip as the leg swings.
  var left = model('leg-l', 'robot-leg', -0.26, 0.85 - 0.85 * Math.cos(swing), 0.04 - 0.85 * Math.sin(swing));
  left.rotation = vec(swing, 0, 0);
  var right = model(
    'leg-r',
    'robot-leg',
    0.26,
    0.85 - 0.85 * Math.cos(swing),
    -0.04 + 0.85 * Math.sin(swing)
  );
  right.rotation = vec(-swing, 0, 0);
  // Arms hang from the shoulder, so a wave is a wave and not a propeller.
  var al = group('arm-l', -0.45, 1.56, 0, 0, [box('arm', 0, -0.36, 0, 0.17, 0.75, 0.19, col)]);
  al.rotation = party ? vec(0, 0, 2.5 + Math.sin(t) * 0.3) : vec(-swing, 0, 0.08);
  var ar = group('arm-r', 0.45, 1.56, 0, 0, [box('arm', 0, -0.36, 0, 0.17, 0.75, 0.19, col)]);
  ar.rotation = wave ? vec(0, 0, -2.5 + Math.sin(t) * 0.35) : vec(swing, 0, -0.08);
  var parts = [model('body', 'robot-body', 0, 0, 0), left, right, al, ar];
  // The hard hat, unless Head Office's Casual Friday memo got a 'Hats off' (S.memoFx.hatsOff).
  if (!(S.memoFx && S.memoFx.hatsOff))
    parts.push(
      {
        id: 'hat-brim',
        type: 'cylinder',
        position: vec(0, 2.25, 0.02),
        radius: 0.27,
        height: 0.035,
        color: '#f3f0e6',
        roughness: 0.5
      },
      {
        id: 'hat-dome',
        type: 'sphere',
        position: vec(0, 2.27, 0),
        scale: { x: 1, y: 0.62, z: 1.08 },
        radius: 0.21,
        color: '#f3f0e6',
        roughness: 0.45
      },
      { id: 'hat-band', type: 'cylinder', position: vec(0, 2.29, 0), radius: 0.205, height: 0.05, color: col }
    );
  return group('robot-' + b.id, x, y + hop, z, working ? b.walkHeading || Math.PI : Math.PI, parts);
}

// An excavator at its fixed spot (excavatorLocation in mine/excavators.logic): tracks with a unit
// mark in that unit's colour, then the chain of joints posed by visualExcavatorPose(): turret
// (yaw), boom, stick and bucket (curl), with ore in the bucket when it is loaded, and the
// hydraulic rams from rigging.logic.
function excavatorObject(id) {
  id = id || S.activeExcavator;
  var pose = visualExcavatorPose(id),
    p = excavatorLocation(id);
  var bucketParts = [model('bucket', 'exc-bucket', 0, 0, 0)];
  if (pose.ore)
    bucketParts.push(
      model('bucket-ore', 'stockpile', 0, -0.28, 0.45, {
        x: 0.105,
        y: 0.12 * (pose.oreAmount === undefined ? 1 : Math.max(0.02, pose.oreAmount)),
        z: 0.09
      })
    );
  var stick = {
    id: 'stick',
    type: 'group',
    position: vec(0, 6, 6),
    rotation: vec(pose.stick, 0, 0),
    children: [
      model('stick-shape', 'exc-stick', 0, 0, 0),
      {
        id: 'bucket-joint',
        type: 'group',
        position: vec(0, -5, 3.3),
        rotation: vec(pose.curl, 0, 0),
        children: bucketParts
      }
    ]
  };
  var boom = {
    id: 'boom',
    type: 'group',
    position: vec(0, 1, 1.5),
    rotation: vec(pose.boom, 0, 0),
    children: [model('boom-shape', 'exc-boom', 0, 0, 0), stick].concat(stickRams(pose))
  };
  var number = box(
    'unit-mark',
    id === 1 ? -0.45 : 0.45,
    4.25,
    -4.8,
    0.65,
    0.6,
    0.08,
    id === 1 ? '#f3d595' : '#8ccabd'
  );
  return group('excavator-' + id, p.x, p.y, p.z, p.heading, [
    model('tracks', 'exc-base', 0, 0, 0),
    number,
    {
      id: 'turret',
      type: 'group',
      position: vec(0, 3.1, 0),
      rotation: vec(0, pose.yaw, 0),
      children: [model('turret-shape', 'exc-turret', 0, 0, 0), boom].concat(excavatorRams(pose))
    }
  ]);
}
