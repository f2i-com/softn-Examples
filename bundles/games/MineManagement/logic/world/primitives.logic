// Native SoftN Scene3D objects. Assets are original GLBs; simulation owns transforms.
// Builders for the plain objects every scene file uses (model, box, group) and the tables of the
// game's model and texture files. No state on S.
//
// Objects name their model or texture by bundle path (modelKey / textureKey) and the page turns
// the path into a URL as it draws: app/ui/main.ui maps modelKey to modelUrl and textureKey to
// textureUrl with asset(). A host may serve assets as data: URLs (FormLogic does, base64-encoded),
// and a URL written into every object would carry megabytes through the logic engine on every
// frame; putting them in each frame was slow. So the logic never holds an asset URL, only the key.
//
// A model whose name is not in MODELS gets no modelKey and draws nothing (scripts/soak.mjs fails
// on that). A model inside a group only draws once flattenScene() (scene-transforms.logic) has
// lifted it to the scene root.

// Model names, as model() takes them, to GLB files in the bundle. A new file must also be listed
// under files.assets in app/manifest.json.
var MODELS = {
  'crusher-drive': 'assets/models/crusher-drive.glb',
  'exc-base': 'assets/models/exc-base.glb',
  'exc-boom': 'assets/models/exc-boom.glb',
  'exc-bucket': 'assets/models/exc-bucket.glb',
  'exc-stick': 'assets/models/exc-stick.glb',
  'exc-turret': 'assets/models/exc-turret.glb',
  'haul-bed': 'assets/models/haul-bed.glb',
  'haul-body': 'assets/models/haul-body.glb',
  'payload': 'assets/models/payload.glb',
  'robot-body': 'assets/models/robot-body.glb',
  'robot-leg': 'assets/models/robot-leg.glb',
  'site': 'assets/models/site.glb',
  'stockpile': 'assets/models/stockpile.glb',
  'terrain': 'assets/models/terrain.glb',
  'ute': 'assets/models/ute.glb',
  'wheel': 'assets/models/wheel.glb'
};

// The sign pictures, by the `file` name initWorld() (scene.logic) gives each sign; the path becomes
// that sign's textureKey.
var SIGNS = {
  'office': 'assets/office.png',
  'crusher': 'assets/crusher.png',
  'workshop': 'assets/workshop.png',
  'pit': 'assets/pit.png'
};

function vec(x, y, z) {
  return { x: x, y: y, z: z };
}

// A GLB model. name is a key of MODELS; scale is a number or { x, y, z }. `reload` carries
// assetGeneration: retryAssets() (scene.logic) bumps it, and Scene3D fetches every model again.
function model(id, name, x, y, z, scale) {
  return {
    id: id,
    type: 'model',
    modelKey: MODELS[name],
    reload: assetGeneration,
    position: vec(x || 0, y || 0, z || 0),
    scale: scale === undefined ? 1 : scale,
    castShadow: true,
    receiveShadow: true
  };
}

// A box centred on (x, y, z): w along x, h along y, d along z. Matte, and it casts shadows.
function box(id, x, y, z, w, h, d, color) {
  return {
    id: id,
    type: 'box',
    position: vec(x, y, z),
    width: w,
    height: h,
    depth: d,
    color: color,
    roughness: 0.8,
    castShadow: true
  };
}

// A group turned by yaw about the vertical axis; its children are placed in its frame. Groups are
// flattened away before Scene3D sees them (camera-attached ones excepted): see flattenScene().
function group(id, x, y, z, yaw, children) {
  return { id: id, type: 'group', position: vec(x, y, z), rotation: vec(0, yaw || 0, 0), children: children };
}
