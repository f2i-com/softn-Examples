// Haul trucks tipping and loading, the site ute, and how a vehicle's body sits on the ground.
// The tipping and loading helpers turn a truck's timers into the bed angle, the load you can see
// and the falling ore; they only draw (callers: truckObject in actors.logic, buildWorldFrame in
// scene.logic), as does uteObject(). settleVehicle() is the exception: it runs in the simulation
// step (robot trucks in mine/route.logic, driven vehicles in player/movement.logic) and writes
// bodyPitch, bodyRoll, steerAngle and poseSpeed on the vehicle in S.
// The timings must match the simulation's: the 4.5 s manual tip (mine/bays.logic), the robot dump
// time (stepSimulation in mine/simulation.logic) and the loader's pass (loaderPassDuration).

// ---------- Tipping and loading ----------

// How far through a tip the truck is, from 0 to 1: a person's manual tip takes 4.5 s, a robot's
// dump 6 s, shortened by crusher upgrades. 0 when it isn't tipping.
function tipProgress(t) {
  return t.manualTip
    ? clamp(t.manualTip / 4.5, 0, 1)
    : t.phase === 'dumping'
      ? clamp(t.service / (6 / (1 + S.upgrade.crusher * 0.25)), 0, 1)
      : 0;
}

// The bed's angle in radians at tip progress c: raised to 0.95 rad (about 54 degrees) over the
// first 32% of the tip, held, then lowered over the last 24%.
function tipAngle(c) {
  return c < 0.32
    ? smoothBlend(0, 0.95, c / 0.32)
    : c < 0.76
      ? 0.95
      : smoothBlend(0.95, 0, (c - 0.76) / 0.24);
}

// Tonnes of ore to draw in the tray. While tipping, the load pours out between 35% and 71% of the
// tip. While loading, the next bucket (up to 20 t: what stepSimulation adds when the pass ends)
// appears between 64% and 82% of the pass, while excavatorMaterial() (rigging.logic) pours it in.
function visiblePayload(t) {
  var c = tipProgress(t);
  if (c) return t.payload * (1 - smoothBlend(0, 1, (c - 0.35) / 0.36));
  var elapsed = t.manualLoad || (t.phase === 'loading' ? t.service : 0);
  return Math.min(
    t.capacity,
    t.payload +
      Math.min(20, t.capacity - t.payload, S.extraction) *
        smoothBlend(0, 1, (elapsed / loaderPassDuration() - 0.64) / 0.18)
  );
}

// The two hydraulic rams that push the bed up, from the chassis (1.7 m either side) to a point on
// the bed 0.2 m up and 4.4 m forward of its pivot, which is where truckObject() (actors.logic)
// hinges it: 3.25 m up, 3.6 m behind the centre. None while the bed is down.
function tipRams(angle) {
  var out = [];
  if (angle < 0.01) return out;
  for (var side = -1; side <= 1; side += 2) {
    var x = side * 1.7,
      ay = 2.35,
      az = 0.1,
      by = 3.25 + 0.2 * Math.cos(angle) + 4.4 * Math.sin(angle),
      bz = -3.6 - 0.2 * Math.sin(angle) + 4.4 * Math.cos(angle),
      dy = by - ay,
      dz = bz - az,
      len = Math.hypot(dy, dz);
    var barrel = box(
      'ram-barrel-' + side,
      x,
      ay + dy * 0.22,
      az + dz * 0.22,
      0.3,
      len * 0.44,
      0.3,
      '#455c5c'
    );
    barrel.rotation = vec(Math.atan2(dz, dy), 0, 0);
    out.push(barrel);
    var rod = box('ram-rod-' + side, x, ay + dy * 0.7, az + dz * 0.7, 0.17, len * 0.6, 0.17, '#c0cecb');
    rod.rotation = vec(Math.atan2(dz, dy), 0, 0);
    out.push(rod);
  }
  return out;
}

// The ore pouring off the back of a tipping truck (from 35% to 73% of the tip), as particles
// falling in arcs; fewer on low quality. null when there is nothing to pour.
function tipMaterial(t) {
  var c = tipProgress(t);
  if (c < 0.35 || c > 0.73 || !t.payload) return null;
  var pts = [],
    n = quality === 'low' ? 6 : 14;
  for (var i = 0; i < n; i++) {
    var f = (c * 9 + i / n) % 1,
      side = Math.sin(i * 7.1) * 2,
      back = 4.7 + f * 1.6;
    pts.push(
      t.x - Math.sin(t.heading) * back + Math.cos(t.heading) * side,
      t.y + 3.6 - f * f * 3.3,
      t.z - Math.cos(t.heading) * back - Math.sin(t.heading) * side
    );
  }
  return {
    id: 'tip-stream-' + t.id,
    type: 'particles',
    particlePositions: pts,
    particleSize: 0.22,
    color: '#8b7050',
    opacity: 0.95
  };
}

// ---------- Body pose ----------

// Sits a vehicle's body on the ground: pitch and roll from the ground under its four wheels (half
// the wheelbase and half the track: 1.55 m and 1.12 m for the ute, 3.15 m and 3.3 m for a truck),
// plus, with motion on, a nod from braking and accelerating and a lean in turns. Eases the body
// and the front wheels' steering angle towards that. Runs in the simulation step, not the drawing.
function settleVehicle(v, kind, steer, dt) {
  var half = kind === 'ute' ? 1.55 : 3.15,
    width = kind === 'ute' ? 1.12 : 3.3,
    s = Math.sin(v.heading),
    c = Math.cos(v.heading);
  var front = groundAt(v.x + s * half, v.z + c * half),
    rear = groundAt(v.x - s * half, v.z - c * half),
    left = groundAt(v.x - c * width, v.z + s * width),
    right = groundAt(v.x + c * width, v.z - s * width);
  var pitch = clamp(-Math.atan2(front - rear, half * 2), -0.4, 0.4),
    roll = clamp(Math.atan2(right - left, width * 2), -0.3, 0.3),
    rate = Math.min(1, dt * 7);
  // Acceleration since the last call (v.poseSpeed holds the speed then), capped at 8 m/s^2.
  var acceleration = clamp(
    (v.speed - (v.poseSpeed === undefined ? v.speed : v.poseSpeed)) / Math.max(0.001, dt),
    -8,
    8
  );
  v.poseSpeed = v.speed;
  if (motion) {
    pitch -= acceleration * (kind === 'ute' ? 0.006 : 0.0025);
    roll += clamp(steer * v.speed * 0.007, -0.055, 0.055);
  }
  v.bodyPitch = lerp(v.bodyPitch || 0, pitch, rate);
  v.bodyRoll = lerp(v.bodyRoll || 0, roll, rate);
  v.steerAngle = lerp(v.steerAngle || 0, steer * (kind === 'ute' ? 0.45 : 0.3), rate);
}

// ---------- The ute ----------

// The site ute: body, four wheels (the front pair steers) and brake lights that glow with the park
// brake on, when it is blocked, or while its driver holds Space. The body tilts with
// settleVehicle()'s pose and drops by `squash` after a landing (player/stunts.logic).
function uteObject() {
  var v = visualVehicle(S.ute, true),
    parts = [model('body', 'ute', 0, 0, 0)];
  for (var side of [-1, 1])
    for (var axle of [-1, 1]) {
      // The truck's wheel model, shrunk to fit the ute.
      var w = model('wheel', 'wheel', 0, 0, 0, { x: 0.34, y: 0.36, z: 0.36 });
      w.rotation = vec(v.wheel || 0, 0, 0);
      parts.push(
        group(
          'axle-' + side + '-' + axle,
          side * 1.12,
          0.62,
          axle * 1.55,
          axle === 1 ? v.steerAngle || 0 : 0,
          [w]
        )
      );
    }
  for (var side of [-1, 1]) {
    var lamp = box('brake-' + side, side * 0.86, 1.25, -2.47, 0.28, 0.32, 0.025, '#bd533b');
    lamp.emissive = '#ff291b';
    lamp.emissiveIntensity =
      v.parkBrake || v.obstructed || (S.player.mode === 'ute' && controlActive(' ')) ? 1.7 : 0.15;
    parts.push(lamp);
  }
  var tilt = group('terrain-tilt', 0, -(v.squash || 0), 0, 0, parts);
  tilt.rotation = vec(v.bodyPitch || 0, 0, v.bodyRoll || 0);
  return group('ute', v.x, v.y, v.z, v.heading, [tilt]);
}
