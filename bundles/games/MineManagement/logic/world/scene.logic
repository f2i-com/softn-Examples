// The 3D world, as the Scene3D component in app/ui/main.ui draws it. initWorld() builds what never
// moves into sceneStatic (terrain and site models, signs, scenery, sun and clouds) and resets the
// collision and interpolation state; buildWorldFrame() rebuilds sceneObjects, everything that
// moves or changes, on every frame. Both arrays are declared in core/state.logic, as are the asset
// flags this file manages (ready, renderReady, modelStatuses, modelError, assetGeneration).
//
// Callers: initWorld() from boot() (core/game-loop.logic), newGame() and continueGame()
// (core/session.logic) and retryAssets(); buildWorldFrame() from tick() about 30 times a second on
// the play and title screens, and from cycleQuality() (core/settings.logic). retryAssets,
// sceneLoaded and modelState are handlers in main.ui.
// Every id in a frame must be unique after flattening (scripts/soak.mjs checks), and the frame is
// rebuilt ~30 times a second: keep per-frame work light; what doesn't move belongs in sceneStatic.

// ---------- Asset loading ----------

// Turns what Scene3D has reported into `ready`, which enables Start and Continue on the title
// screen once the first frame is drawn and no model is still loading, and `modelError`, the text
// of the error banner in main.ui. modelStatuses is keyed by flattened object id.
function refreshAssetStatus() {
  var names = Object.keys(modelStatuses),
    pending = false,
    error = '';
  for (var i = 0; i < names.length; i++) {
    var status = modelStatuses[names[i]];
    if (status.state === 'pending') pending = true;
    if (status.state === 'error') error = 'Asset failed: ' + names[i] + '. ' + (status.error || '');
  }
  modelError = error;
  ready = renderReady && !pending && !error;
}

// The error banner's "Retry assets" button. Bumping assetGeneration changes every model's `reload`
// number (see model() in primitives.logic), so Scene3D fetches them all again.
function retryAssets() {
  assetGeneration++;
  modelStatuses = {};
  ready = false;
  modelError = '';
  initWorld();
}

// ---------- The world ----------

// (Re)builds the world for the current S: tops up older saves (ensureOperations,
// migrateSiteClearance), rebuilds the colliders, drops the interpolation snapshot, builds
// sceneStatic, then the map's lines, the lighting and a first frame.
function initWorld() {
  ensureOperations();
  migrateSiteClearance();
  initCollisions();
  motionPrevious = null;
  sceneStatic = [model('terrain', 'terrain', 0, 0, 0), model('site', 'site', 0, 0, 0)];
  // The ground only receives shadows.
  sceneStatic[0].castShadow = false;
  // The signs are textured planes; `file` picks the picture from SIGNS (primitives.logic).
  var signs = [
    { id: 'office-sign', file: 'office', x: -35, y: 10.3, z: 146.81, w: 8, h: 1.6, ry: Math.PI },
    { id: 'crusher-sign', file: 'crusher', x: 49.245, y: 8.65, z: 140, w: 3, h: 1.55, ry: -Math.PI / 2 },
    { id: 'workshop-sign', file: 'workshop', x: -65, y: 11.6, z: 118.775, w: 10, h: 1.6, ry: Math.PI },
    { id: 'pit-sign', file: 'pit', x: -4, y: -18, z: -10, w: 5.3, h: 2.2, ry: Math.PI }
  ];
  for (var i = 0; i < signs.length; i++) {
    var a = signs[i];
    sceneStatic.push({
      id: a.id,
      type: 'plane',
      position: vec(a.x, a.y, a.z),
      rotation: vec(0, a.ry, 0),
      width: a.w,
      height: a.h,
      textureKey: SIGNS[a.file],
      color: '#ffffff',
      doubleSided: true
    });
  }
  sceneStatic = sceneStatic.concat(sceneryObjects());
  // The new sceneStatic has no sun or clouds yet: add them.
  skyPhase = '';
  refreshSky(true);
  initMapLines();
  refreshLighting();
  buildWorldFrame();
}

// Builds this frame's sceneObjects: trucks (and the ore they tip), the ute, excavators (and the ore
// they pour), robots, the crusher plant, status lights, dust, cones, the waypoint, the held tablet
// and rain, then what other files add. Machines are drawn from the visual*() views
// (interpolation.logic), so they glide between simulation steps. The list is flattened and the
// camera placed last.
function buildWorldFrame() {
  if (!S) return;
  var objects = [];
  for (var i = 0; i < S.trucks.length; i++) {
    objects.push(truckObject(S.trucks[i]));
    var stream = tipMaterial(visualVehicle(S.trucks[i], false));
    if (stream) objects.push(stream);
  }
  objects.push(uteObject());
  for (var ex = 0; ex < S.excavators.length; ex++) {
    var id = S.excavators[ex].id;
    objects.push(excavatorObject(id));
    var bucketStream = excavatorMaterial(id);
    if (bucketStream) objects.push(bucketStream);
  }
  // Robots: one driving rides in its truck's cab (2 m off the centre line, 3.5 m up); the one on
  // the excavator (assigned -1) is inside it and not drawn; the rest walk or stand about.
  for (var r = 0; r < S.robots.length; r++) {
    var b = S.robots[r];
    if (b.assigned === -1) continue;
    var t = b.assigned > 0 ? getTruck(b.assigned) : null;
    if (t) t = visualVehicle(t, false);
    if (t && t.active) {
      objects.push(
        robotObject(b, t.x + Math.cos(t.heading) * -2, t.z - Math.sin(t.heading) * -2, t.y + 3.5, false)
      );
    } else {
      var vb = visualRobot(b);
      objects.push(robotObject(vb, vb.x, vb.z, heightAt(vb.x, vb.z) + 0.36, !!vb.walkBlend));
    }
  }
  // The plant. The stockpile grows with all the tonnes ever processed, and the ore at the pit face
  // shrinks as it is loaded out; clearanceScore() (collision.logic) sizes their colliders the same.
  var p = visualPlant(),
    pileScale = 0.35 + Math.min(0.65, p.processed / 2500);
  objects.push(
    model('stockpile', 'stockpile', 82, 4, 168, {
      x: 1 + Math.min(0.5, p.processed / 6000),
      y: pileScale,
      z: 1 + Math.min(0.5, p.processed / 6000)
    })
  );
  objects.push(
    model('face-ore', 'stockpile', 33, heightAt(33, -33), -33, {
      x: 0.6,
      y: Math.max(0.1, S.extraction / 5000),
      z: 0.65
    })
  );
  // Axial drive and conveyor progress are authoritative simulation values.
  var drive = model('crusher-drive', 'crusher-drive', 57.1, 7.7, 140);
  drive.rotation = vec(motion ? p.shaft : 0, 0, 0);
  objects.push(drive);
  // Ore heaped in the hopper and at the receiving point, rising with the hopper's level (full at
  // 240 t).
  if (p.hopper > 0.01)
    objects.push(
      model('hopper-ore', 'stockpile', 53, 10.38, 126, {
        x: 0.48,
        y: 0.06 + (p.hopper / 240) * 0.38,
        z: 0.24
      })
    );
  if (p.hopper > 0.01)
    objects.push(
      model('receiving-ore', 'stockpile', 78.5, 4.7, 139, {
        x: 0.21,
        y: 0.09 + (p.hopper / 240) * 0.14,
        z: 0.2
      })
    );
  // While ore flows, two lumps ride the feeder (rising 6.2 m over 12 m, north into the hopper).
  // They and the conveyor's cleats below move with the belt's phase (still with reduced motion).
  if (p.flow > 0)
    for (var feed = 0; feed < 2; feed++) {
      var f = ((motion ? p.belt : 0) + feed * 0.5) % 1;
      objects.push(
        model('feeder-ore-' + feed, 'stockpile', 53, 4.42 + 6.2 * f, 138 - 12 * f, {
          x: 0.08,
          y: 0.07,
          z: 0.08
        })
      );
    }
  // The conveyor's cleats, and ore on it while ore flows. The conveyor runs 27 m east and 21 m
  // south from (53, 145), hence the turn of atan2(27, 21).
  var count = quality === 'low' ? 3 : 5;
  for (var belt = 0; belt < count; belt++) {
    var f = ((motion ? p.belt : 0) + belt / count) % 1;
    var cleat = box(
      'belt-cleat-' + belt,
      53 + 27 * f,
      8.52 + 2 * f,
      145 + 21 * f,
      2.5,
      0.08,
      0.18,
      '#88918a'
    );
    cleat.rotation = vec(0, Math.atan2(27, 21), 0);
    objects.push(cleat);
    if (p.flow > 0)
      objects.push(
        model('belt-ore-' + belt, 'stockpile', 53 + 27 * f, 8.6 + 2 * f, 145 + 21 * f, {
          x: 0.065,
          y: 0.06,
          z: 0.065
        })
      );
  }
  // Status lights: the crusher's (green running, red down) and the one on the relay mast (teal up,
  // orange down).
  var signal = box('crusher-signal', 49, 9.5, 143, 0.45, 0.45, 0.45, S.crusher ? '#8be1b5' : '#ff643c');
  signal.emissive = S.crusher ? '#56bd8c' : '#ff3311';
  signal.emissiveIntensity = 1.4;
  objects.push(signal);
  var relay = box('relay-signal', 115, 30, 105, 0.4, 0.4, 0.4, S.relay ? '#7fcad3' : '#ee6639');
  relay.emissive = S.relay ? '#3bbcc0' : '#ff4311';
  relay.emissiveIntensity = 1.5;
  objects.push(relay);
  // Dust (not on low quality): a trail behind each moving truck, each puff drifting from 5 to 17 m
  // back and rising 3 m, and a plume where the conveyor drops ore on the stockpile.
  var dust = [];
  var dustColors = [];
  if (quality !== 'low') {
    for (var d = 0; d < S.trucks.length; d++) {
      var tr = S.trucks[d];
      if (tr.speed < 1) continue;
      for (var k = 0; k < (quality === 'high' ? 13 : 7); k++) {
        var age = (S.time * 1.7 + k * 0.137) % 1,
          back = 5 + age * 12;
        dust.push(
          tr.x - Math.sin(tr.heading) * back + Math.sin(k * 2.4) * 2,
          tr.y + 1 + age * 3,
          tr.z - Math.cos(tr.heading) * back + Math.cos(k * 3.2) * 2
        );
        dustColors.push(0.73, 0.61, 0.43);
      }
    }
    if (S.plant.flow > 0)
      for (var q = 0; q < 12; q++) {
        dust.push(
          80 + Math.sin(q * 3.1) * 1.7,
          6 + ((S.time * 3 + q * 0.31) % 3),
          166 + Math.cos(q * 2.1) * 1.5
        );
        dustColors.push(0.61, 0.52, 0.39);
      }
    if (dust.length)
      objects.push({
        id: 'work-dust',
        type: 'particles',
        particlePositions: dust,
        particleColors: dustColors,
        particleSize: 1.5,
        opacity: 0.4
      });
  }
  // A 'cone' alert's traffic cone stands 7 m in front of its truck, except while the player is
  // carrying it for that job (player/field-kit.logic draws the carried one).
  for (var a = 0; a < S.alerts.length; a++) {
    var alert = S.alerts[a];
    if (alert.kind === 'cone' && !(repairJob && repairJob.alert.key === alert.key && carryingCone())) {
      var truck = getTruck(alert.truckId);
      var x = truck ? truck.x + Math.sin(truck.heading) * 7 : alert.x,
        z = truck ? truck.z + Math.cos(truck.heading) * 7 : alert.z;
      objects.push({
        id: 'cone-' + a,
        type: 'cone',
        position: vec(x, heightAt(x, z) + 0.65, z),
        radius: 0.42,
        height: 1.3,
        color: '#f39835'
      });
    }
  }
  // The waypoint: a glowing ring on the ground under a 15 m beam.
  if (S.waypoint) {
    var w = S.waypoint,
      wy = heightAt(w.x, w.z);
    var marker = {
      id: 'waypoint-ring',
      type: 'torus',
      position: vec(w.x, wy + 0.3, w.z),
      radius: 2.2,
      tube: 0.08,
      rotation: vec(Math.PI / 2, 0, 0),
      color: '#7aede0',
      emissive: '#3be2cc',
      emissiveIntensity: 1.2
    };
    objects.push(marker);
    objects.push({
      id: 'waypoint-beam',
      type: 'cylinder',
      position: vec(w.x, wy + 8, w.z),
      radius: 0.12,
      height: 15,
      color: '#8defdb',
      emissive: '#46cfb7',
      emissiveIntensity: 1,
      opacity: 0.55
    });
  }
  // Held hardware is a camera-attached Scene3D object, not an iframe or web page. Its position is
  // an offset in camera space (x right, y up, -z ahead): the PIT tablet, low and to the right.
  if (screen === 'play' && !tablet && S.player.mode === 'foot') {
    var c = group('held-tablet', 0.36, -0.43, -0.78, 0, [
      box('shell', 0, 0, 0, 0.26, 0.35, 0.025, '#283536'),
      box('glass', 0, 0, 0.016, 0.225, 0.29, 0.005, '#101f22'),
      box('stripe', 0, 0.11, 0.02, 0.19, 0.015, 0.005, '#d9a540'),
      box('line-a', -0.015, 0.055, 0.02, 0.155, 0.008, 0.005, '#72c2b3'),
      box('line-b', -0.035, 0.025, 0.02, 0.11, 0.008, 0.005, '#72c2b3'),
      box('glove', 0.04, -0.15, -0.03, 0.12, 0.1, 0.1, '#8b785b')
    ]);
    c.attach = 'camera';
    c.rotation = vec(-0.13, -0.12, -0.14);
    objects.push(c);
  }
  // Rain (not on low quality): drops within 35 m of the player, falling at 15 m/s through a 24 m
  // column.
  if (S.weather === 'rain' && quality !== 'low') {
    var rain = [];
    var p = S.player;
    for (var rr = 0; rr < (quality === 'high' ? 75 : 36); rr++)
      rain.push(
        p.x + Math.sin(rr * 12.989) * 35,
        p.y + ((((rr * 1.7 - S.time * 15) % 24) + 24) % 24),
        p.z + Math.cos(rr * 7.7) * 35
      );
    objects.push({
      id: 'rain',
      type: 'particles',
      particlePositions: rain,
      particleSize: 0.13,
      color: '#c4dcdf',
      opacity: 0.55
    });
  }
  // What other files add: the field kit (player/field-kit.logic), props, Kevin, Head Office's drone
  // (fun/memos.logic) and effect bursts (fun/effects.logic).
  appendFieldObjects(objects);
  appendPropObjects(objects);
  appendWildlifeObjects(objects);
  var drone = droneObject();
  if (drone) objects.push(drone);
  appendBursts(objects);
  // Scene3D only loads models at the scene root: bake the groups away (scene-transforms.logic).
  sceneObjects = flattenScene(objects);
  updateCamera();
}

// ---------- Scene3D events ----------

// Scene3D's firstFrame: the renderer is up (models may still be loading).
function sceneLoaded() {
  renderReady = true;
  refreshAssetStatus();
}

// Scene3D's modelState: one model's load state ('pending', 'loaded' or 'error' with a message),
// keyed by the flattened object id.
function modelState(info) {
  if (info && info.objectId) {
    modelStatuses[info.objectId] = info;
    refreshAssetStatus();
  }
}
