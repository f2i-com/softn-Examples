// Small procedural assemblies reuse the existing meshes; no new animation mixer.
// The excavator's hydraulic rams, the ore pouring from its bucket into a truck, and visualRobot(),
// the walking robots' version of the between-steps smoothing in interpolation.logic. No state, and
// nothing here changes S. Callers: excavatorObject() (actors.logic) for the rams, and
// buildWorldFrame() (scene.logic) for the ore stream and the robots.
// The joint offsets used here (turret 3.1 m up, boom pivot (0, 1, 1.5), stick pivot (0, 6, 6) on
// the boom, bucket joint (0, -5, 3.3) on the stick) copy excavatorObject(): change them together.

// ---------- Excavator rams ----------

// A hydraulic ram from point a to point b (in the parent's frame), as two boxes: a dark barrel of
// width r from the a end and a thinner, bright rod reaching to b. It only pitches about x, so a and
// b must have the same x.
function pistonPair(id, a, b, r) {
  var dx = b.x - a.x,
    dy = b.y - a.y,
    dz = b.z - a.z,
    len = Math.hypot(dx, dy, dz),
    axis = { x: Math.atan2(dz, dy), y: 0, z: 0 },
    out = [];
  for (var i = 0; i < 2; i++) {
    var f = i ? 0.72 : 0.24,
      p = box(
        id + (i ? '-rod' : '-barrel'),
        a.x + dx * f,
        a.y + dy * f,
        a.z + dz * f,
        r * (i ? 0.55 : 1),
        len * (i ? 0.56 : 0.48),
        r * (i ? 0.55 : 1),
        i ? '#bfcac3' : '#586b69'
      );
    p.rotation = axis;
    out.push(p);
  }
  return out;
}

// The two boom rams, from the turret (0.95 m either side) to a point on the boom that turns with
// pose.boom about the boom pivot. They go in the turret's group.
function excavatorRams(pose) {
  var end = rotateVector(rotationQuaternion(vec(pose.boom, 0, 0)), vec(0, 3.4, 3.7)),
    out = [];
  end.y += 1;
  end.z += 1.5;
  for (var side of [-1, 1])
    out = out.concat(
      pistonPair('boom-hydraulic-' + side, vec(side * 0.95, 0.6, 1.4), vec(side * 0.95, end.y, end.z), 0.27)
    );
  return out;
}

// The stick ram, from the boom to a point on the stick that turns with pose.stick about the stick
// pivot. It goes in the boom's group.
function stickRams(pose) {
  var end = rotateVector(rotationQuaternion(vec(pose.stick, 0, 0)), vec(0, -2.1, 1.7));
  return pistonPair('stick-hydraulic', vec(0, 4.6, 3.3), vec(0, 6 + end.y, 6 + end.z), 0.23);
}

// ---------- Ore from the bucket ----------

// The bucket's lip in world coordinates: a point in the bucket's frame carried up the same chain
// of joints excavatorObject() builds (curl, stick, boom, turret yaw), then turned and moved to
// where the excavator stands.
function bucketOutlet(id, pose) {
  var p = rotateVector(rotationQuaternion(vec(pose.curl, 0, 0)), vec(0, -0.35, 1.3));
  p.y -= 5;
  p.z += 3.3;
  p = rotateVector(rotationQuaternion(vec(pose.stick, 0, 0)), p);
  p.y += 6;
  p.z += 6;
  p = rotateVector(rotationQuaternion(vec(pose.boom, 0, 0)), p);
  p.y += 1;
  p.z += 1.5;
  p = rotateVector(rotationQuaternion(vec(0, pose.yaw, 0)), p);
  p.y += 3.1;
  var ex = excavatorLocation(id);
  p = rotateVector(rotationQuaternion(vec(0, ex.heading, 0)), p);
  return vec(p.x + ex.x, p.y + ex.y, p.z + ex.z);
}

// The ore pouring from the active excavator's bucket into a truck, as particles on an arc from the
// bucket's lip to 4 m above the truck. When a person runs the excavator it pours while they dump
// the bucket over their target truck; otherwise it pours from 64% to 82% of a robot loader's pass,
// the window in which visiblePayload() (vehicles.logic) shows the load arriving. null when there
// is nothing to pour.
function excavatorMaterial(id) {
  if (id !== S.activeExcavator || !loaderAvailable()) return null;
  var pose = visualExcavatorPose(id),
    m = S.manualExcavator,
    t = null,
    progress = 0;
  if (manualLoader()) {
    if (!m.dump || !m.bucket) return null;
    t = getTruck(m.target);
    progress = clamp(m.dump, 0, 1);
  } else {
    for (var tr of S.trucks)
      if (tr.phase === 'loading' || tr.manualLoad) {
        var c = (tr.manualLoad || tr.service) / loaderPassDuration();
        if (c >= 0.64 && c <= 0.82) {
          t = tr;
          progress = (c - 0.64) / 0.18;
        }
        break;
      }
  }
  if (!t || t.fault || t.payload >= t.capacity || (S.extraction <= 0 && !manualLoader())) return null;
  var start = bucketOutlet(id, pose),
    target = visualVehicle(t, false),
    end = vec(target.x, target.y + 4, target.z),
    pts = [],
    n = quality === 'low' ? 6 : 12;
  for (var i = 0; i < n; i++) {
    var f = ((motion ? motionTime() * 3 : 0) + i / n) % 1,
      scatter = Math.sin(i * 7.1) * 0.3;
    pts.push(
      lerp(start.x, end.x, f) + scatter,
      lerp(start.y, end.y, f) - 0.5 * f * (1 - f),
      lerp(start.z, end.z, f) + Math.cos(i * 3.7) * 0.3
    );
  }
  return {
    id: 'bucket-stream-' + id,
    type: 'particles',
    particlePositions: pts,
    particleSize: 0.2,
    color: '#987c55',
    opacity: 0.96
  };
}

// ---------- Robots ----------

// A copy of robot b with its position and walk cycle blended between simulation steps, as
// visualVehicle() (interpolation.logic) does for trucks; not blended after a move of 6 m or more.
function visualRobot(b) {
  var view = Object.assign({}, b);
  if (!motionPrevious || !motionPrevious.robots || renderAlpha >= 1) return view;
  for (var old of motionPrevious.robots)
    if (old.id === b.id && dist2(old, b) < 6) {
      view.x = lerp(old.x, b.x, renderAlpha);
      view.z = lerp(old.z, b.z, renderAlpha);
      view.walkPhase = lerp(old.walkPhase || 0, b.walkPhase || 0, renderAlpha);
      break;
    }
  return view;
}
