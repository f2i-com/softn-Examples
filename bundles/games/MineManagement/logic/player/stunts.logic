// The site ute's airtime: leaving the ground over a crest, flying, landing, and the applause.
// uteVertical runs each step the player drives the ute (updatePlayer in movement.logic), after the
// horizontal move. The humps that launch it are JUMPS in world/terrain.logic (groundAt includes
// them); navigation.logic can mark Bazza's ramp. Trucks never leave the ground.
// State, all on S.ute: air (airborne), vy (vertical speed, m/s), airTime (s in the air) and squash
// (m the body sinks on landing, drawn by uteObject in world/vehicles.logic). They are saved with S,
// but validState (core/persistence.logic) has no check for them.
// Records: S.fun.jumps, air and bestAir for the shift; S.career.fun.bestAir across shifts.

// Gravity for the airborne ute, m/s² (a jump on foot uses 13, in updatePlayer).
var AIR_GRAVITY = 16;

// The ute's vertical motion, after its horizontal move. prevY is where it was a step ago.
// On the ground it follows the terrain and keeps the speed of that climb or descent in vy, which
// a take-off carries into the air.
function uteVertical(v, dt, prevY) {
  var ground = groundAt(v.x, v.z),
    prevVy = Number.isFinite(v.vy) ? v.vy : 0;
  // The landing squash springs back at 1.4 m/s.
  if (v.squash) v.squash = Math.max(0, v.squash - dt * 1.4);
  if (v.air) {
    v.vy = prevVy - AIR_GRAVITY * dt;
    v.y = prevY + v.vy * dt;
    v.airTime = (v.airTime || 0) + dt;
    if (v.y <= ground) {
      var impact = -v.vy;
      v.y = ground;
      v.air = false;
      v.vy = 0;
      landUte(v, impact);
    }
    return;
  }
  // A recovery or a reload moves the ute without driving it: snap to the ground, carry no speed.
  if (Math.abs(ground - prevY) > 1.5) {
    v.y = ground;
    v.vy = 0;
    return;
  }
  var follow = (ground - prevY) / Math.max(dt, 0.001);
  // The wheels would have to accelerate downwards faster than gravity: the ute takes off.
  // Only above 8 m/s, when not already dropping (by 0.5 m/s or more), and when keeping to the
  // ground would take a downward pull over 1.6 × gravity. It leaves with the climb it had, at
  // most 9 m/s.
  if (Math.abs(v.speed) > 8 && prevVy > -0.5 && follow < prevVy - AIR_GRAVITY * dt * 1.6) {
    v.air = true;
    v.airTime = 0;
    v.vy = Math.min(prevVy, 9);
    v.y = prevY + v.vy * dt;
    return;
  }
  v.y = ground;
  // The vertical speed of following the ground, kept within ±8 m/s.
  v.vy = clamp(follow, -8, 8);
}

// Touch-down: impact is the downward speed in m/s. The body squashes (up to 0.35 m), the camera
// shakes and dust flies. Over 11 m/s the ute takes damage (1.5 health per m/s over, never below
// 1). A flight of 0.35 s or more counts as a jump: stats, a toast (gold over 1.1 s) and, over
// 1.1 s, a word from the crew; a 1.5 s best this shift earns the Frequent flyer badge.
function landUte(v, impact) {
  var t = v.airTime || 0;
  v.airTime = 0;
  v.squash = Math.min(0.35, impact * 0.03);
  addShake(Math.min(1, impact / 9));
  burst('dust', v.x, v.y + 0.3, v.z, 1.2 + Math.min(1.5, impact / 6));
  sfx(impact > 6 ? 'thud' : 'dump');
  if (impact > 11) {
    v.health = Math.max(1, v.health - (impact - 11) * 1.5);
  }
  if (t >= 0.35) {
    funCount('jumps');
    S.fun.air = (S.fun.air || 0) + t;
    S.fun.bestAir = Math.max(S.fun.bestAir || 0, t);
    S.career.fun.bestAir = Math.max(S.career.fun.bestAir || 0, t);
    toast('AIRTIME ' + t.toFixed(1) + ' s', t > 1.1 ? 'gold' : 'good');
    if (t > 1.1)
      banter(
        pick([
          ['BAZZA', 'MATE. That is the best thing that has ever happened on this lease.'],
          [
            'GARY',
            'The ute was airborne for ' +
              t.toFixed(1) +
              ' seconds. There is no form for this. I am making one.'
          ],
          ['HEAD OFFICE', 'We saw that on the telemetry. Legal saw it too. Legal is lying down.'],
          ['DOT', 'Peak altitude recorded. I have rounded it down for the insurance people.']
        ]),
        true
      );
    if (S.fun.bestAir >= 1.5) awardBadge('air', 'Frequent flyer');
  }
}
