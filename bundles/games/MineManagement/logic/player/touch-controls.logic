// The on-screen touch controls (app/ui/screens/touch-controls.ui): a drive pad, a look pad and
// action buttons. One drag controls both axes. Separate look and action controls support
// multitouch: moving and looking work with two thumbs at once.
// The on-screen pads are for touch: they turn on when a finger touches the game (touchInput, in
// camera-look.logic), unless the player has chosen for themselves with the Touch pads button in
// Pause or on the HUD (toggleScreenControls, core/settings.logic, sets controlsChosen). Both
// flags are saved in S.settings; continueGame (core/session.logic) restores them only if the
// player had chosen. Keyboard and mouse players get the whole view.
// The pads drive updatePlayer (movement.logic) through driveAxis and screenKeys, alongside the
// keyboard's `keys`. Every pad and button checks controlsAllowed(). refreshControls (refreshUI)
// labels them for the current mode.

// ---------- State ----------

// The pads are showing. They also make the view drag-to-look (lookMode, camera-look.logic).
var controlsEnabled = false;

// The player picked pads on or off themselves, so a touch no longer switches them on.
var controlsChosen = false;

// The drive pad: held or not, its output (each axis -1..1, added to the keys by updatePlayer;
// positive steer is left) and where touch-controls.ui draws its thumb.
var drivePadHeld = false;

var driveAxis = { forward: 0, steer: 0 };

var driveThumb = { left: '50%', top: '50%' };

// The look pad: held or not, and the last pointer position (px).
var lookPadHeld = false;

var lookPadPoint = { x: 0, y: 0 };

// On-screen buttons held down, by key name (' ' is the brake); controlActive counts them as keys.
var screenKeys = {};

// The touch Run toggle (on foot; Shift does the same on a keyboard).
var runEnabled = false;

// Free look in the ute, a truck or the excavator: radians from straight ahead. The mouse or the
// look pad moves it, and the view follows the machine's heading plus this. Pitch stays within
// ±0.65. Zeroed on getting in or out, changing camera, Centre view and loading a game.
var cameraYawOffset = 0;

var cameraPitchOffset = 0;

// ---------- Shared by keys and pads ----------

// Whether a control is held, on the keyboard or on screen. Names are lower-case e.key values
// (' ' is Space).
function controlActive(k) {
  return !!(keys[k] || screenKeys[k]);
}

// The player's controls are live: playing, no tablet or export open, and no field-kit job
// unless the player is carrying a cone.
function controlsAllowed() {
  return !!S && screen === 'play' && !tablet && !exportOpen && (!repairJob || carryingCone());
}

// ---------- The pads ----------

function stopDrivePad() {
  drivePadHeld = false;
  driveAxis = { forward: 0, steer: 0 };
  driveThumb = { left: '50%', top: '50%' };
}

function stopLookPad() {
  lookPadHeld = false;
}

// Let go of everything on screen, the Run toggle included (from resetInputs).
function resetScreenControls() {
  stopDrivePad();
  stopLookPad();
  screenKeys = {};
  runEnabled = false;
}

// pointerdown on the drive pad (touch-controls.ui); a touch reports button 0, like a left click.
function drivePadStart(e) {
  if (!controlsAllowed() || !e || e.button !== 0) return;
  drivePadHeld = true;
  drivePadMove(e);
}

// Turn the pointer's place on the pad into driveAxis. Its offset from the centre is measured in
// units of 40 % of the pad's size (so 1 is 80 % of the way to the rim) and capped at 1; the thumb
// is drawn up to 35 % from the centre. The first 12 % is a dead zone. Up is forward and left is
// positive steer, like W and A. e.targetLeft/Top/Width/Height (SoftN) give the pad's box.
function drivePadMove(e) {
  if (!drivePadHeld) return;
  if (!controlsAllowed() || !e || e.buttons === 0) {
    stopDrivePad();
    return;
  }
  if (
    !Number.isFinite(e.targetWidth) ||
    !Number.isFinite(e.targetHeight) ||
    e.targetWidth <= 0 ||
    e.targetHeight <= 0
  )
    return;
  var x = (e.clientX - e.targetLeft - e.targetWidth / 2) / (e.targetWidth * 0.4),
    y = (e.clientY - e.targetTop - e.targetHeight / 2) / (e.targetHeight * 0.4);
  if (!Number.isFinite(x) || !Number.isFinite(y)) return;
  var length = Math.hypot(x, y),
    scale = Math.max(1, length);
  x /= scale;
  y /= scale;
  driveThumb = { left: 50 + x * 35 + '%', top: 50 + y * 35 + '%' };
  var amount = clamp((length - 0.12) / 0.88, 0, 1),
    normal = length ? Math.min(1, length) : 1;
  driveAxis = { forward: (-y / normal) * amount, steer: (-x / normal) * amount };
}

function lookPadStart(e) {
  if (!controlsAllowed() || !e || e.button !== 0) return;
  lookPadHeld = true;
  lookPadPoint = { x: e.clientX, y: e.clientY };
}

// Turn the view by the drag: 0.006 rad per pixel times lookSensitivity (core/settings.logic), at
// most 100 px per event. In a machine the turn also goes into the free-look offsets; the pitch
// stays within ±1.15 rad.
function lookPadMove(e) {
  if (!lookPadHeld) return;
  if (!controlsAllowed() || !e || e.buttons === 0) {
    stopLookPad();
    return;
  }
  var dx = e.clientX - lookPadPoint.x,
    dy = e.clientY - lookPadPoint.y;
  lookPadPoint = { x: e.clientX, y: e.clientY };
  if (!Number.isFinite(dx) || !Number.isFinite(dy)) return;
  var yaw = -clamp(dx, -100, 100) * 0.006 * lookSensitivity,
    pitch = -clamp(dy, -100, 100) * 0.006 * lookSensitivity;
  if (S.player.mode !== 'foot') {
    cameraYawOffset = wrapAngle(cameraYawOffset + yaw);
    cameraPitchOffset = clamp(cameraPitchOffset + pitch, -0.65, 0.65);
  }
  var look = lookValues();
  setLook(look.yaw + yaw, clamp(look.pitch + pitch, -1.15, 1.15));
}

// ---------- Buttons ----------

function toggleRun() {
  if (controlsAllowed() && S.player.mode === 'foot') {
    runEnabled = !runEnabled;
    refreshUI();
  }
}

// The same hop as Space on foot (keyDown, input.logic).
function touchJump() {
  if (controlsAllowed() && S.player.mode === 'foot' && S.player.grounded) {
    S.player.vy = 5;
    S.player.grounded = false;
  }
}

function toggleLamp() {
  if (!controlsAllowed()) return;
  lamp = !lamp;
  sfx('click');
}

// Let go of the drive pad and the on-screen keys, then interact as a touch (fromButton).
function touchInteract() {
  stopDrivePad();
  screenKeys = {};
  interact(true);
}

// ---------- Labels ----------

// The pads' captions and the main button's label for the current mode (from refreshUI). The
// main button would say 'Cancel service' during a field-kit job, but touch-controls.ui hides
// the controls then, unless the player is carrying a cone.
function refreshControls() {
  var p = S.player,
    foot = p.mode === 'foot',
    exc = p.mode === 'excavator';
  hud.controlMode = p.mode;
  hud.padTitle = foot ? 'WALK' : exc ? 'BOOM / SWING' : 'DRIVE';
  hud.padTop = exc ? 'RAISE' : 'FORWARD';
  hud.padBottom = exc ? 'LOWER' : foot ? 'BACK' : 'REVERSE';
  hud.touchAction = repairJob
    ? carryingCone()
      ? 'Place cone'
      : 'Cancel service'
    : !foot
      ? 'Exit vehicle'
      : nearestInteraction()
        ? 'Interact'
        : 'Find equipment';
  hud.runLabel = runEnabled ? 'Run on' : 'Walk / run';
  hud.controlsHelp = foot
    ? 'Drag the left pad to move. Drag the view to look.'
    : exc
      ? 'Drag left pad: up/down boom, left/right swing.'
      : 'Drag left pad: forward/reverse and steering. Release to slow.';
}

// The main button: place the carried cone, cancel a field-kit job, or interact.
function controlInteract() {
  if (repairJob) {
    if (carryingCone()) fieldAction('place');
    else cancelField();
    refreshUI();
    return;
  }
  touchInteract();
}
