// Where the player is looking, and the bridge to the 3D view's mouse look.
// Scene3D (app/ui/main.ui) turns the mouse into look angles. Game and scene share them through
// window globals:
//   __scene3dYaw, __scene3dPitch  the look angles in radians: the scene moves them with the
//                                 mouse, the game sets them through setLook
//   __scene3dWantLock             ask the scene to capture the pointer on its next frame
//   __scene3dReleaseLock          ask the scene to give the pointer back (a panel needs it)
//   __scene3dLocked               set by the scene while it holds the pointer
// Each window access sits in try/catch, in case the host gives the script no window or touching
// it throws. Mouse look either captures the pointer or drags to look: see pointerLockBlocked.
// State (none of it saved): lamp (the headlamp), presentedYaw, pointerLockBlocked
// and lockCheckAt. Entry points: setLook (wherever the view is aimed), lookValues (updatePlayer),
// presentVehicleLook (world/camera.logic), checkPointerLock (tick), takeMouse and releaseMouse
// (play resumes, a panel opens), resetInputs, and touchInput (switches the touch pads on).

// ---------- Inputs ----------

// The headlamp (F, or the touch Headlamp button): world/lighting.logic hangs a spotlight on the
// camera while it, or night, is on. Not saved.
var lamp = false;

// Forget every held key, pad and field-kit hold or drag, and stop the player, the ute and a
// manually driven truck dead: nothing drives on without its driver. Called whenever control
// changes hands: pause, the tablet, losing focus, a window resize, getting in or out of a
// vehicle, and through releaseMouse.
function resetInputs() {
  fieldHeld = false;
  fieldDragging = false;
  keys = {};
  resetScreenControls();
  if (S) {
    S.player.speed = 0;
    S.player.steer = 0;
    S.ute.speed = 0;
    if (S.player.mode === 'truck') {
      var manual = getTruck(S.player.vehicle);
      if (manual) manual.speed = 0;
    }
  }
}

// ---------- The pointer ----------

// A panel or menu is opening: give the pointer back, cancel a pending capture, reset inputs.
function releaseMouse() {
  try {
    window.__scene3dReleaseLock = true;
    window.__scene3dWantLock = false;
  } catch (e) {}
  resetInputs();
}

// Back to the world: in capture mode, ask the scene for the pointer on its next frame, and hand
// it the player's current look.
function takeMouse() {
  try {
    window.__scene3dWantLock = lookMode() === 'capture';
    window.__scene3dYaw = S.player.yaw;
    window.__scene3dPitch = S.player.pitch || 0;
  } catch (e) {}
}

// ---------- Look angles ----------

// The look the scene shows now, as { yaw, pitch }. On foot that is simply the scene's yaw. In a
// vehicle the game re-aims the view all the time, so only the scene's change since the game last
// set it (presentedYaw) is the player's mouse movement, and it is added to S.player.yaw.
function lookValues() {
  var yaw = S.player.yaw,
    pitch = S.player.pitch;
  try {
    if (Number.isFinite(window.__scene3dYaw))
      yaw =
        S.player.mode === 'foot' || presentedYaw === null
          ? window.__scene3dYaw
          : S.player.yaw + wrapAngle(window.__scene3dYaw - presentedYaw);
    if (Number.isFinite(window.__scene3dPitch)) pitch = window.__scene3dPitch;
  } catch (e) {}
  return { yaw: yaw, pitch: pitch };
}

// The yaw the game last wrote to __scene3dYaw (setLook or presentVehicleLook); null until then.
var presentedYaw = null;

// Each rendered frame in the ute or a truck (world/camera.logic): aim the view along the
// vehicle's heading as drawn, interpolated between the 20 Hz steps, keeping any mouse movement
// the simulation has not used yet. `pitch` is not used: the pitch is left as it is.
function presentVehicleLook(yaw, pitch) {
  var pending = wrapAngle(lookValues().yaw - S.player.yaw);
  presentedYaw = yaw;
  try {
    window.__scene3dYaw = yaw + pending;
  } catch (e) {}
}

// Aim the view: the player's yaw and pitch and the scene's angles together, so the scene's next
// mouse movement starts from here.
function setLook(yaw, pitch) {
  presentedYaw = yaw;
  S.player.yaw = yaw;
  S.player.pitch = pitch;
  try {
    window.__scene3dYaw = yaw;
    window.__scene3dPitch = pitch;
  } catch (e) {}
}

// ---------- Keeping the view through a remount ----------

// app/ui/main.ui remounts Scene3D whenever its key (the quality and the look mode) changes, and a
// new Scene3D starts its look angles from the camera prop, not from where the player was looking,
// so the view would swing round. For 0.6 s after the key changes, the game writes its own angles to
// the scene every tick (before updatePlayer reads them back), until the new scene has taken them:
// on foot the player's yaw; in a vehicle the yaw it last presented (presentedYaw), so lookValues
// sees no mouse movement. The key can change in a click handler, and SoftN may remount the scene
// before the next tick, so the angles come from the game's state, never from the window.
// Every tick, from tick().
var lastSceneKey = '';

// Date.now() (ms) until which the game's angles are being written; 0 when not.
var holdLookUntil = 0;

function keepLookThroughRemount() {
  var key = quality + '-' + lookMode();
  if (key !== lastSceneKey) {
    if (lastSceneKey) holdLookUntil = Date.now() + 600;
    lastSceneKey = key;
  }
  if (!holdLookUntil || !S) return;
  if (Date.now() > holdLookUntil) {
    holdLookUntil = 0;
    return;
  }
  try {
    window.__scene3dYaw = S.player.mode === 'foot' || presentedYaw === null ? S.player.yaw : presentedYaw;
    window.__scene3dPitch = S.player.pitch || 0;
  } catch (e) {}
}

// Panels the player clicks on (the tablet, the field kit, the pause and report screens) need the
// cursor. releaseMouse() asks for it once, but a capture asked for a moment earlier can be granted
// after that request has been used up (Scene3D only acts on a release while it holds the pointer),
// leaving the cursor hidden over the panel. So while a panel is up and the scene still holds the
// pointer, ask again every tick. Carrying a cone keeps the kit open while you walk, so it doesn't
// count. Every tick, from tick().
function keepPointerFree() {
  if (!S) return;
  var panelUp = screen !== 'play' || tablet || (!!repairJob && !carryingCone());
  if (!panelUp) return;
  try {
    if (window.__scene3dLocked) {
      window.__scene3dWantLock = false;
      window.__scene3dReleaseLock = true;
    }
  } catch (e) {}
}

// ---------- Capture or drag ----------

// Mouse look captures the pointer where the page may (SoftN Runtime, a site of its own). A frame
// sandboxed without allow-pointer-lock (FormLogic's) refuses, and Scene3D's mouse look then does
// nothing at all, so a refused capture switches the scene to drag-to-look.
// Scene3D reads its pointerLock prop only when it mounts. So app/ui/main.ui gives it a key= that
// names the look mode, and a change of mode remounts the scene. main.ui writes lookMode()'s rule
// out again inline, in both key= and pointerLock=: change the rule in all three places.
// Never cleared: after one refusal the session drags to look until the page is reloaded.
var pointerLockBlocked = false;

// When (Date.now(), ms) to check that a capture asked for by a press on the view took hold;
// 0 when no check is waiting.
var lockCheckAt = 0;

// 'drag' (hold and drag the view to look) with the touch pads on, or where capture is refused;
// 'capture' (pointer lock) otherwise.
function lookMode() {
  return controlsEnabled || pointerLockBlocked ? 'drag' : 'capture';
}

// The window touchstart listener (added in boot, core/game-loop.logic): the first touch switches
// the on-screen pads on, unless the player has chosen for themselves (controlsChosen,
// touch-controls.logic). The pads drag to look, so the scene remounts in drag mode.
function touchInput() {
  if (controlsChosen || controlsEnabled) return;
  controlsEnabled = true;
  releaseMouse();
  if (S) refreshUI();
}

// Scene3D's pointerDown (app/ui/main.ui), with the press's details in info. In capture mode a left
// mouse press on the view asks the scene for the pointer, so start the 900 ms wait for
// checkPointerLock. Scene3D reports every press while it doesn't hold the pointer, whatever the
// button, so a right or middle click (which never asks for the pointer) is ignored here: counting
// it as a refusal would switch the session to drag-to-look for good.
function scenePointerDown(info) {
  if (info && info.button !== undefined && info.button !== 0) return;
  if (!S || screen !== 'play' || tablet || repairJob || lookMode() !== 'capture') return;
  lockCheckAt = Date.now() + 900;
}

// Every tick: once a check is due, no lock (while still playing with the tablet down) means
// this host refuses capture. Switch to drag-to-look for good and tell the player.
function checkPointerLock() {
  if (!lockCheckAt || Date.now() < lockCheckAt) return;
  lockCheckAt = 0;
  var locked = false;
  try {
    locked = !!window.__scene3dLocked;
  } catch (e) {}
  if (locked || screen !== 'play' || tablet) return;
  // main.ui's Scene3D key changes with this, so the scene remounts with pointerLock off.
  pointerLockBlocked = true;
  notify('PIT', 'This window will not lend me your mouse. Hold the left button and drag to look around.');
  refreshUI();
}

// ---------- Re-centring ----------

// The touch Centre view button: drop the free look. On foot, level the view; in a machine, face
// along its heading (the excavator's includes its swing) with the usual downward pitch.
function centerView() {
  cameraYawOffset = 0;
  cameraPitchOffset = 0;
  if (S.player.mode === 'foot') setLook(S.player.yaw, 0);
  else if (S.player.mode === 'excavator')
    setLook(
      excavatorLocation(Math.abs(S.player.vehicle)).heading + S.manualExcavator.yaw,
      cameraMode === 'chase' ? -0.24 : -0.18
    );
  else {
    var v = S.player.mode === 'ute' ? S.ute : getTruck(S.player.vehicle);
    setLook(v.heading, cameraMode === 'chase' ? -0.23 : -0.055);
  }
}
