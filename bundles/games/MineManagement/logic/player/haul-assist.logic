// Help for a player driving a haul truck: where to go next, asking for a full tray, and the HUD's
// haul panel and drive state; plus the park brake, which the ute has too.
// Guidance is a view of the real tray, bay and loader state, never a source of tonnes: loading
// and tipping happen in mine/bays.logic (manualLoad, advanceManualLoading, advanceManualTip).
// The bays: loading at Bench 1, (17, -14), within 23 m; tipping at the crusher, (72, 138), within
// 25 m. mine/bays.logic repeats these numbers: change them together.
// State on the truck: fillRequested (validState accepts it only on the truck the player is
// driving, in phase 'manual') and parkBrake; on the marker: S.waypoint.haulTruck.
// Entry points: P, G and R (input.logic); the touch Park brake and haul buttons; the HUD's Guide
// haul button; advanceFillRequests (stepSimulation); refreshDriving (refreshUI).

// ---------- Controls ----------

// Toggle the park brake on the ute or truck being driven; updatePlayer brakes while it is on.
// Also lets go of the drive pad.
function toggleParkBrake() {
  if (!controlsAllowed()) return;
  var v = manualVehicle();
  if (!v) return;
  v.parkBrake = !v.parkBrake;
  stopDrivePad();
  screenKeys = {};
  notify(
    'VEHICLE',
    v.parkBrake ? 'Parking brake applied. Release it before driving.' : 'Parking brake released.'
  );
  refreshUI();
}

// ---------- Where to next ----------

// 'load' while the tray is empty, or part loaded in the loading bay with ore left in the pit;
// otherwise 'tip'.
function haulDestination(t) {
  return t.payload <= 0 || (t.payload < t.capacity && S.extraction > 0 && dist2(t, { x: 17, z: -14 }) < 23)
    ? 'load'
    : 'tip';
}

// Mark the bay the driven truck needs next (G, the HUD's Guide haul, and below). The marker is
// tagged with the truck (haulTruck), so refreshHaulGuide keeps it up to date.
function guideHaul() {
  if (!S || screen !== 'play' || S.player.mode !== 'truck') return;
  var t = getTruck(S.player.vehicle),
    dest = haulDestination(t);
  setWaypoint(
    dest === 'load' ? 17 : 72,
    dest === 'load' ? -14 : 138,
    dest === 'load' ? 'Bench 1 / follow haul ramp' : 'Crusher tip bay / follow haul ramp'
  );
  S.waypoint.haulTruck = t.id;
  refreshUI();
}

// From refreshDriving: move the haul marker as the tray fills or empties, and drop it once the
// player is out of that truck.
function refreshHaulGuide() {
  var w = S.waypoint;
  if (!w || !w.haulTruck) return;
  if (S.player.mode !== 'truck' || S.player.vehicle !== w.haulTruck) {
    S.waypoint = null;
    return;
  }
  var t = getTruck(w.haulTruck),
    dest = haulDestination(t);
  w.x = dest === 'load' ? 17 : 72;
  w.z = dest === 'load' ? -14 : 138;
  w.label = dest === 'load' ? 'Bench 1 / follow haul ramp' : 'Crusher tip bay / follow haul ramp';
}

// ---------- Full-tray loading ----------

// R or the haul button: ask for bucket passes until the tray is full, or cancel the request.
// Needs the truck stopped (1 m/s or less) in the loading bay, with room in the tray and ore left.
function toggleFillTray() {
  if (!controlsAllowed() || S.player.mode !== 'truck') return;
  var t = getTruck(S.player.vehicle);
  if (t.fillRequested) {
    t.fillRequested = false;
    t.manualLoad = 0;
    notify('LOADING', 'Full-tray request cancelled. Completed bucket loads stay in the tray.');
    refreshUI();
    return;
  }
  if (Math.abs(t.speed) > 1) {
    notify('LOADING', 'Stop before requesting a full tray.');
    return;
  }
  if (dist2(t, { x: 17, z: -14 }) >= 23) {
    guideHaul();
    notify('LOADING', 'Drive to the marked loading bay via the haul ramp.');
    return;
  }
  if (t.payload >= t.capacity || S.extraction <= 0) {
    notify(
      'LOADING',
      t.payload >= t.capacity
        ? 'Tray full. Proceed to the crusher.'
        : 'No exposed ore remains. Tip any remaining payload.'
    );
    return;
  }
  t.fillRequested = true;
  t.speed = 0;
  guideHaul();
  notify('MEL', 'Full tray requested. Stay in the cab; each bucket is loaded in sequence.');
  refreshUI();
}

// Every simulation step: keep each full-tray request going. A request ends when the player leaves
// the truck or the bay, or when the tray is full or the pit is empty. Otherwise, with no pass
// running, the next one starts once the bay, the loader and the manual bucket are all free.
// manualLoad is the running pass's timer (mine/bays.logic): 0 for none, and 0.001 starts one.
function advanceFillRequests() {
  for (var i = 0; i < S.trucks.length; i++) {
    var t = S.trucks[i];
    if (!t.fillRequested) continue;
    if (
      t.phase !== 'manual' ||
      S.player.mode !== 'truck' ||
      S.player.vehicle !== t.id ||
      dist2(t, { x: 17, z: -14 }) >= 23
    ) {
      t.fillRequested = false;
      t.manualLoad = 0;
      continue;
    }
    if (t.payload >= t.capacity - 0.001 || S.extraction <= 0) {
      t.fillRequested = false;
      continue;
    }
    t.speed = 0;
    if (
      !t.manualLoad &&
      !bayOwner('loading', t.id) &&
      loaderAvailable() &&
      !manualLoader() &&
      S.manualExcavator.bucket === 0
    )
      t.manualLoad = 0.001;
  }
}

// ---------- The haul panel ----------

// What the haul panel (HUD) and the touch haul button say for a truck: { title, detail, action,
// disabled }. Read by refreshDriving and haulAction.
function haulStatus(t) {
  var dest = haulDestination(t),
    atLoad = dist2(t, { x: 17, z: -14 }) < 23,
    atTip = dist2(t, { x: 72, z: 138 }) < 25;
  if (t.manualTip)
    return {
      title: 'Tipping into receiving hopper',
      detail: 'Stay in the cab. Revenue follows crusher processing.',
      action: 'Tipping…',
      disabled: true
    };
  if (t.fillRequested || t.manualLoad) {
    // A bucket pass loads 20 t (mine/bays.logic).
    var passes = Math.ceil(Math.max(0, t.capacity - t.payload) / 20),
      remaining = Math.max(0, passes * loaderPassDuration() - (t.manualLoad || 0));
    return {
      title: t.fillRequested
        ? 'Filling tray / ' + Math.round(t.payload) + ' of ' + t.capacity + ' t'
        : 'Single bucket pass',
      detail: !loaderAvailable()
        ? 'Loader held or relocating. Loading resumes when released.'
        : S.manualExcavator.bucket > 0
          ? 'Empty the manual excavator bucket to resume.'
          : bayOwner('loading', t.id)
            ? 'Waiting for ' + bayOwner('loading', t.id) + ' to clear the bay.'
            : Math.ceil(remaining) + ' s of bucket work remaining / stay in the cab',
      action: t.fillRequested ? 'Cancel fill' : 'Loading…',
      disabled: !t.fillRequested
    };
  }
  if (Math.abs(t.speed) > 1)
    return {
      title: dest === 'load' ? 'Approach Bench 1' : 'Haul to the crusher',
      detail: 'Follow the signed ramp. Stop inside the marked bay.',
      action: dest === 'load' ? 'Fill tray' : 'Tip payload',
      disabled: true
    };
  if (dest === 'load') {
    if (S.extraction <= 0)
      return {
        title: 'Working face depleted',
        detail: 'No exposed ore remains this shift. Reconcile in PIT.',
        action: 'Face depleted',
        disabled: true
      };
    return {
      title: atLoad ? 'Ready for loading' : 'Next stop / Bench 1',
      detail: atLoad
        ? 'Request a full tray, or use L for one bucket pass.'
        : 'Use Guide haul to mark the loading bay. Follow the haul ramp.',
      action: atLoad ? 'Fill tray' : 'Guide to load',
      disabled: false
    };
  }
  if (!atTip)
    return {
      title: 'Next stop / crusher',
      detail: 'Loaded ore earns revenue after tipping and processing.',
      action: 'Guide to tip',
      disabled: false
    };
  var blocked = !S.crusher
    ? 'Crusher interlock / repair the field alert'
    : bayOwner('dumping', t.id)
      ? 'Tip bay occupied / wait for clearance'
      : hopperSpace() + 0.001 < t.payload
        ? 'Receiving hopper full / wait for processing'
        : '';
  return {
    title: blocked ? 'Waiting to tip' : 'Ready to tip / ' + Math.round(t.payload) + ' t',
    detail: blocked || 'Start the hydraulic tip and remain in the cab.',
    action: 'Tip payload',
    disabled: !!blocked
  };
}

// The touch haul button does what haulStatus offers: fill (or cancel), guide to the crusher, or
// tip (manualLoad tips when the truck is in the tip bay).
function haulAction() {
  if (!controlsAllowed() || S.player.mode !== 'truck') return;
  var t = getTruck(S.player.vehicle),
    state = haulStatus(t);
  if (state.disabled) return;
  if (t.fillRequested || haulDestination(t) === 'load') toggleFillTray();
  else if (dist2(t, { x: 72, z: 138 }) >= 25) guideHaul();
  else manualLoad();
}

// From refreshUI: the park brake's label, the drive state and, in a truck, the haul panel.
function refreshDriving() {
  refreshHaulGuide();
  var v = manualVehicle();
  hud.parkLabel = v && v.parkBrake ? 'Release park brake' : 'Park brake';
  hud.driveState = v
    ? v.parkBrake
      ? 'PARK BRAKE'
      : v.manualLoad || v.manualTip || v.fillRequested
        ? 'BAY SECURED'
        : v.obstructed
          ? 'OBSTACLE / REVERSE TO CLEAR'
          : v.speed < -0.15
            ? 'REVERSE'
            : v.speed > 0.15
              ? 'DRIVE'
              : 'STOPPED'
    : '';
  hud.haulVisible = S.player.mode === 'truck';
  if (hud.haulVisible) {
    var h = haulStatus(v);
    hud.haulTitle = h.title;
    hud.haulDetail = h.detail;
    hud.haulAction = h.action;
    hud.haulDisabled = h.disabled;
    hud.haulFill = { width: clamp((v.payload / v.capacity) * 100, 0, 100) + '%' };
  }
}
