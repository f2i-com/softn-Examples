// What E (or the touch Interact button) does: find the nearest thing in reach and act on it, get
// in and out of vehicles, and the paid tow back to the compound.
// Entry points: interact (keyDown in input.logic, touch-controls.logic), nearestInteraction (also
// refreshUI and refreshControls, for the prompts), exitVehicle (interact) and recoverVehicle
// (the Pause menu).
// Owns no state. Getting in sets S.player.mode and S.player.vehicle (0 for the ute, a truck's id,
// minus an excavator's id) and aims the view; movement.logic says what each mode does.
// The service points' coordinates match markPlace (navigation.logic) and incidentPosition
// (mine/incidents.logic), and the buildings in the world/ files: move one, move them all.

// ---------- What is in reach ----------

// The thing E would act on now, or null. First the nearest field alert within 8 m (not Kevin),
// then a marked site-rounds inspection (nearbyInspection, mine/rounds.logic), then the nearest of
// the ute, the service points, each excavator and truck and any knocked-over prop, each within
// its own radius. Returns { kind, label, x, z, ... }. Side effect: an alert on a truck is moved
// to the truck.
function nearestInteraction() {
  var p = S.player,
    best = null,
    distance = 1e9;
  for (var i = 0; i < S.alerts.length; i++) {
    var a = S.alerts[i];
    if (a.kind === 'kevin') continue;
    if (a.truckId) {
      var tr = getTruck(a.truckId);
      if (tr) {
        a.x = tr.x;
        a.z = tr.z;
      }
    }
    var d = dist2(p, a);
    if (d < 8 && d < distance) {
      best = { kind: 'repair', label: a.title, x: a.x, z: a.z, alert: a };
      distance = d;
    }
  }
  if (best) return best;
  var inspection = nearbyInspection();
  if (inspection) return inspection;
  // x, z in metres; radius is how close the player must be (m).
  var items = [
    { kind: 'ute', label: 'Enter site ute', x: S.ute.x, z: S.ute.z, radius: 5 },
    { kind: 'fuel', label: 'Refuel site equipment', x: 9, z: 157, radius: 6 },
    { kind: 'workshop', label: 'Service the fleet', x: -65, z: 129, radius: 10 },
    { kind: 'charger', label: 'Service robot batteries', x: 31, z: 163, radius: 7 },
    { kind: 'office', label: 'Open PIT operations', x: -35, z: 150, radius: 7 }
  ];
  for (var e = 0; e < S.excavators.length; e++) {
    var ex = S.excavators[e],
      ep = excavatorLocation(ex.id);
    items.push({ kind: 'excavator', id: ex.id, label: 'Operate ' + ex.name, x: ep.x, z: ep.z, radius: 9 });
  }
  for (var j = 0; j < S.trucks.length; j++) {
    var t = S.trucks[j];
    items.push({
      kind: 'truck',
      label: 'Take control of ' + t.external_id,
      x: t.x,
      z: t.z,
      id: t.id,
      radius: 8
    });
  }
  for (var pr of S.props || [])
    if (pr.tilt > 0.5 && !pr.moving)
      items.push({
        kind: 'prop',
        label: 'Stand the ' + pr.k + ' back up',
        x: pr.x,
        z: pr.z,
        radius: 2.6,
        prop: pr
      });
  for (var k = 0; k < items.length; k++) {
    var b = items[k],
      dd = dist2(p, b);
    if (dd < b.radius && dd < distance) {
      best = b;
      distance = dd;
    }
  }
  return best;
}

// ---------- Interacting ----------

// E or Interact. In a vehicle it gets out. On foot it acts on nearestInteraction(): repair an
// alert or start an inspection (both in the field kit), drive the ute, take over a truck (not
// while it has a fault), work an excavator, open the tablet at the site office, stand a prop
// back up, or service the fleet at the fuel farm, workshop or charger. fromButton is true from
// a touch button; the field kit keeps it as repairJob.touch, which nothing reads.
function interact(fromButton) {
  if (!S || screen !== 'play' || tablet || repairJob) return;
  var p = S.player;
  if (p.mode !== 'foot') {
    exitVehicle();
    return;
  }
  var near = nearestInteraction();
  if (!near) {
    notify('PIT', 'Move closer to a vehicle, workshop or marked service point.');
    return;
  }
  if (near.kind === 'repair') {
    startRepair(near.alert, !!fromButton);
    return;
  }
  if (near.kind === 'inspection') {
    startInspection(near.id);
    return;
  }
  if (near.kind === 'ute') {
    p.mode = 'ute';
    p.vehicle = 0;
    S.ute.speed = 0;
    S.tutorial.drive = true;
    setLook(S.ute.heading, -0.23);
    notify('SITE UTE', 'WASD to drive. Space brake. C cab/chase. E get out.');
  } else if (near.kind === 'truck') {
    var t = getTruck(near.id);
    if (t.fault) {
      notify('PIT', 'Repair the active fault before taking control.', 'warning');
      return;
    }
    // Out of dispatch: phase 'manual' until the player gets out (exitVehicle parks it).
    t.active = false;
    t.phase = 'manual';
    t.speed = 0;
    t.departureStage = 0;
    t.parkedManual = true;
    p.mode = 'truck';
    p.vehicle = t.id;
    S.tutorial.drive = true;
    setLook(t.heading, -0.23);
    notify('MANUAL CONTROL', 'L loads at Bench 1 or tips at the crusher. E exits; redispatch in PIT.');
  } else if (near.kind === 'excavator') {
    if (S.deployment.remaining) {
      notify('MOBILISATION', 'Wait until relocation is complete.');
      return;
    }
    // There is one manual bucket (S.manualExcavator) for every machine: it must be empty to swap.
    var m = S.manualExcavator;
    if (m.owner !== near.id && m.bucket > 0) {
      notify('MEL', 'Empty the previous excavator bucket before changing machines.');
      return;
    }
    m.owner = near.id;
    m.dig = 0;
    m.dump = 0;
    m.target = 0;
    p.mode = 'excavator';
    // Stored negated: read the excavator's id as Math.abs(S.player.vehicle).
    p.vehicle = -near.id;
    setLook(excavatorLocation(near.id).heading, -0.24);
    notify(
      'MEL',
      'D swings toward the face; Space digs. A swings to the truck; L discharges. C changes camera.'
    );
  } else if (near.kind === 'office') {
    tablet = true;
    tab = 'operations';
    S.tutorial.tablet = true;
    releaseMouse();
  } else if (near.kind === 'prop') {
    standProp(near.prop);
  } else {
    // A service point (fuel, workshop, charger) gets a one-off alert that is not in S.alerts:
    // closing the kit loses its steps, and finishFieldRepair applies it without counting a repair.
    // reach is the point's own radius, so E works wherever its prompt shows.
    startRepair(
      {
        key: near.kind,
        title: near.label,
        x: near.x,
        z: near.z,
        kind: near.kind,
        truckId: 0,
        reach: near.radius
      },
      !!fromButton
    );
  }
  resetInputs();
  cameraYawOffset = 0;
  cameraPitchOffset = 0;
  sfx('click');
  refreshUI();
}

// Get out at the first clear spot found around the vehicle (safeExit, world/collision.logic),
// 3.8 m out from the ute or 7 m from a truck or excavator; if there is none, stay in. A truck is
// left parked in standby for dispatch; an excavator's dig or discharge stops.
function exitVehicle() {
  var p = S.player,
    v =
      p.mode === 'ute'
        ? S.ute
        : p.mode === 'truck'
          ? getTruck(p.vehicle)
          : excavatorLocation(Math.abs(p.vehicle));
  var exit = safeExit(v, p.mode === 'ute' ? 3.8 : 7);
  if (!exit) {
    notify('CLEARANCE', 'No clear exit. Move the vehicle to an open area.');
    return;
  }
  resetInputs();
  cameraYawOffset = 0;
  cameraPitchOffset = 0;
  if (p.mode === 'excavator') {
    S.manualExcavator.dig = 0;
    S.manualExcavator.dump = 0;
    S.manualExcavator.target = 0;
  }
  if (p.mode === 'truck') {
    v.manualTip = 0;
    v.manualLoad = 0;
    v.fillRequested = false;
    v.phase = 'standby';
    v.active = false;
    v.speed = 0;
    v.parkedManual = true;
    // Back on the haul route at the nearest point, for when dispatch takes it again.
    v.progress = nearestRouteProgress(v.x, v.z);
  }
  if (p.mode === 'ute') v.speed = 0;
  var x = exit.x,
    z = exit.z,
    angle = v.heading || 0;
  p.mode = 'foot';
  p.vehicle = 0;
  p.x = x;
  p.z = z;
  p.y = heightAt(x, z);
  p.speed = 0;
  p.jump = 0;
  setLook(angle, -0.06);
  refreshUI();
}

// ---------- The tow ----------

// The Pause menu's "Stuck? Tow me to the compound": the first press only arms it (resetConfirm),
// the second pays $250 and brings the player back on foot to the spawn point, the ute to its
// parking spot and a truck being driven to the parking row, each with at least 20 % fuel. A
// truck keeps its payload.
function recoverVehicle() {
  if (!resetConfirm) {
    resetConfirm = true;
    return;
  }
  var p = S.player;
  var cost = 250;
  if (S.cash < cost) {
    resetConfirm = false;
    notify(
      'RECOVERY',
      'The tow driver wants $250 up front. Head Office says the cheque is in the mail. The tow driver has heard that one.',
      'warning'
    );
    return;
  }
  S.cash -= cost;
  S.costs += cost;
  if (p.mode === 'truck') {
    var t = getTruck(p.vehicle);
    // The parking row: one bay every 10 m by truck id, facing north (heading π), at the surface
    // end of the route (progress 1).
    t.x = 83 + (t.id - 2) * 10;
    t.z = 104;
    t.y = 4;
    t.progress = 1;
    t.heading = Math.PI;
    t.phase = 'standby';
    t.active = false;
    t.parkedManual = true;
    t.speed = 0;
    t.fillRequested = false;
    t.manualLoad = 0;
    t.manualTip = 0;
    t.departureStage = 0;
    t.parkBrake = false;
    t.fuel = Math.max(20, t.fuel);
    t.fault = '';
  }
  parkUte(S.ute);
  S.ute.fuel = Math.max(20, S.ute.fuel);
  var home = spawnPlayer();
  p.mode = 'foot';
  p.vehicle = 0;
  p.x = home.x;
  p.z = home.z;
  p.y = home.y;
  p.speed = 0;
  p.jump = 0;
  resetConfirm = false;
  setLook(home.yaw, home.pitch);
  notify('RECOVERY', 'Returned to the compound. Payload preserved. ' + money(cost) + ' recovery fee.');
  resumeGame();
  saveGame(true);
}
