<!--
  04 Workshop: permanent upgrades for the site (logic/mine/purchases.logic) and where to go for
  routine service. Upgrades make the haul cycle faster; broken things still need fixing by hand.
-->
<div if={tab === 'workshop'}>
  <div class="mm-page-head">
    <div>
      <span class="mm-label">CAPITAL IMPROVEMENTS</span>
      <h2>Spend less time apologising.</h2>
      <p class="mm-muted">Permanent upgrades for the site. Faults still need a human with a field kit; that part of the job is not for sale.</p>
    </div>
    <span class="mm-money-large">{hud.money}</span>
  </div>

  <div class="mm-upgrade-grid">
    #each (item in upgradeRows) key={item.id}
      <article class="mm-upgrade-card" class:mm-upgrade-ready={item.canAfford} class:mm-upgrade-max={item.max}>
        <div class="mm-upgrade-head">
          <span class="mm-label">LEVEL {item.level} OF {item.cap}</span>
          <span class="mm-upgrade-effect">{item.effect}</span>
        </div>
        <div class="mm-meter mm-upgrade-meter"><div style={item.levelPct}></div></div>
        <h3>{item.name}</h3>
        <p class="mm-muted">{item.detail}</p>
        <button class="mm-secondary" class:mm-primary={item.canAfford} type="button" @click={buyUpgrade(item.id)} disabled={item.max}>{item.max ? 'Fully upgraded' : 'Install / ' + item.cost}</button>
      </article>
    #end
  </div>

  <section class="mm-card mm-service-guide">
    <div class="mm-card-title"><span>Field services & fleet readiness</span><span class="mm-small">ON-FOOT FIELD KIT</span></div>
    <div class="mm-service-body">
      <p>Routine overhauls happen at the compound bays: walk to the marker, press E (or Interact) and complete the three-step field kit.</p>
      <div class="mm-service-grid">
        #each (svc in serviceStatusRows) key={svc.id}
          <div class="mm-service-stat" class:mm-service-warn={svc.warn}>
            <span class="mm-label">{svc.name}</span>
            <strong>{svc.stat}</strong>
            <span class="mm-small">{svc.cost}</span>
            <button class="mm-small-button" type="button" @click={markPlace(svc.id)}>Mark on HUD →</button>
          </div>
        #end
      </div>
    </div>
  </section>
</div>

<style>
  .mm-upgrade-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 17px;
  }
  .mm-upgrade-card {
    padding: 22px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .mm-upgrade-card.mm-upgrade-ready {
    border-color: #9e8a52;
  }
  .mm-upgrade-card.mm-upgrade-max {
    border-color: #4f7b6b;
  }
  .mm-upgrade-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }
  .mm-upgrade-card .mm-label {
    font-size: 8px;
  }
  .mm-upgrade-effect {
    font: 10px monospace;
    color: #95d5c4;
  }
  .mm-upgrade-meter {
    height: 4px;
    margin: 9px 0 13px;
  }
  .mm-upgrade-card .mm-muted {
    min-height: 40px;
    margin: 8px 0 17px;
    font-size: 12px;
  }
  .mm-service-guide {
    margin-top: 22px;
  }
  .mm-service-body {
    padding: 18px 20px 22px;
    font-size: 12px;
    line-height: 1.7;
    color: #c1cfb8;
  }
  .mm-service-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 14px;
  }
  .mm-service-stat {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 14px;
    background: #1d2d34;
    border: 1px solid #455a63;
    border-radius: 7px;
  }
  .mm-service-stat.mm-service-warn {
    background: #332520;
    border-color: #d68a59;
  }
  .mm-service-stat strong {
    font-size: 13px;
    color: #edf1e0;
  }
  .mm-service-stat button {
    margin-top: 6px;
  }
  @media (max-width: 960px) {
    .mm-service-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 620px) {
    .mm-upgrade-grid,
    .mm-service-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
