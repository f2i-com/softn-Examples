<!--
  06 Shift log: the radio, written down. Filterable up to 45 recent messages (logRows in
  logic/core/ui-state.logic, from notify() in logic/core/state.logic).
-->
<div if={tab === 'log'}>
  <div class="mm-page-head">
    <div>
      <span class="mm-label">RADIO & EVENT HISTORY</span>
      <h2>For the incident report.</h2>
      <p class="mm-muted">Recent transmissions from your surprisingly chatty workforce, weighbridge telemetry, Head Office and one emu-adjacent sensor.</p>
    </div>
    <div class="mm-log-filters" role="group" aria-label="Filter shift log">
      <button class="mm-small-button" class:mm-log-filter-active={logFilter === 'all'} type="button" @click={setLogFilter('all')}>All ({logCounts.all})</button>
      <button class="mm-small-button" class:mm-log-filter-active={logFilter === 'alerts'} type="button" @click={setLogFilter('alerts')}>Alerts ({logCounts.alerts})</button>
      <button class="mm-small-button" class:mm-log-filter-active={logFilter === 'ops'} type="button" @click={setLogFilter('ops')}>Dispatch & plant ({logCounts.ops})</button>
      <button class="mm-small-button" class:mm-log-filter-active={logFilter === 'crew'} type="button" @click={setLogFilter('crew')}>Crew & HQ ({logCounts.crew})</button>
    </div>
  </div>
  <section class="mm-card">
    #each (entry in logRows) key={entry.id}
      <div class="mm-log-row" class:mm-log-warn={entry.kind === 'warning'} class:mm-log-ok={entry.kind === 'success'}>
        <span class="mm-log-clock">{entry.clock}</span>
        <span class="mm-log-name">{entry.speaker}</span>
        <span>{entry.message}</span>
      </div>
    #empty
      <p class="mm-empty">No radio entries match this filter yet. Enjoy the quiet while it lasts.</p>
    #end
  </section>
</div>

<style>
  .mm-log-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .mm-small-button.mm-log-filter-active {
    background: #314852;
    border-color: var(--gold);
    color: #f4d292;
  }
  .mm-log-row {
    display: grid;
    grid-template-columns: 53px 132px 1fr;
    gap: 15px;
    padding: 15px 20px;
    border-bottom: 1px solid var(--line);
    border-left: 3px solid transparent;
    font-size: 12px;
    line-height: 1.65;
  }
  .mm-log-row.mm-log-warn {
    background: #2b2222;
    border-left-color: #ee9368;
  }
  .mm-log-row.mm-log-ok {
    background: #1d2d2a;
    border-left-color: #7bd6b5;
  }
  .mm-log-clock {
    font: 10px monospace;
    color: #9bcbc6;
  }
  .mm-log-name {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.7px;
    color: #dbc087;
  }
  .mm-log-warn .mm-log-name {
    color: #f7b18c;
  }
  .mm-log-ok .mm-log-name {
    color: #9ce6c9;
  }
  @media (max-width: 620px) {
    .mm-log-row {
      grid-template-columns: 44px 1fr;
      gap: 6px 12px;
      padding: 13px;
    }
    .mm-log-row > span:last-child {
      grid-column: 2;
      font-size: 11px;
    }
  }
</style>
