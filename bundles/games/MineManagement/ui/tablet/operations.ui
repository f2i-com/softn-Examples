<!--
  01 Operations: the whole mine at a glance. Headline numbers, the two bays, the crushing circuit,
  a map of the site with the fleet on it, the faults that need you in person, and the button that
  ends the shift. Map positions come from positionStyle() in logic/core/ui-state.logic.
-->
<div if={tab === 'operations'}>
  <div class="mm-page-head">
    <div>
      <span class="mm-label">LIVE OVERVIEW</span>
      <h2>Keep the next move clear.</h2>
      <p class="mm-muted">You manage the fleet. You are also the entire field-service team. Congratulations on the promotion.</p>
    </div>
    <button class="mm-primary" type="button" @click={dispatchAll}>Start fleet →</button>
  </div>

  <div class="mm-metrics">
    <div><span class="mm-label">DELIVERED</span><span class="mm-metric-value">{hud.tonnes}<small>t</small></span><span class="mm-small">{hud.target} t shift target</span></div>
    <div><span class="mm-label">OPERATING CASH</span><span class="mm-metric-value">{hud.money}</span><span class="mm-small">After purchases and repairs</span></div>
    <div><span class="mm-label">ON THE BOOKS</span><span class="mm-metric-value">{fleetRows.length}<small>trucks</small></span><span class="mm-small">{robotRows.length} KILN operators</span></div>
    <div><span class="mm-label">FIELD ALERTS</span><span class="mm-metric-value">{alertRows.length}<small>active</small></span><span class="mm-small">{hud.condition}</span></div>
  </div>

  <div class="mm-process-strip">
    <div><span class="mm-label">01 / LOADING BAY</span><span>{hud.loadBay}</span></div>
    <div><span class="mm-label">02 / CRUSHER TIP BAY</span><span>{hud.tipBay}</span></div>
    <div><span class="mm-label">EXPOSED ORE REMAINING</span><span>{hud.exposedOre}</span></div>
  </div>

  <div class="mm-plant-strip">
    <div>
      <span class="mm-label">CRUSHING CIRCUIT / {hud.plantState}</span>
      <h3>{hud.hopper}</h3>
      <span class="mm-small">Receiving hopper · {hud.processRate} processing rate</span>
    </div>
    <div>
      <span class="mm-label">PROCESSED TO STOCKPILE</span>
      <h3>{hud.processed}</h3>
      <span class="mm-small">{hud.pendingValue} of ore waiting to be processed</span>
    </div>
  </div>

  <div class="mm-operations-grid">
    <section class="mm-card">
      <div class="mm-card-title"><span>Local mine grid</span><span class="mm-small">METRES / NORTH ↑</span></div>
      <div class="mm-map">
        <div class="mm-map-pit"></div>
        <div class="mm-map-pit mm-bench-b"></div>
        <div class="mm-map-pit mm-bench-c"></div>
        <div class="mm-route-line" each={mapSegments} as="segment" style={segment.style}></div>
        <span class="mm-map-label mm-map-bench">BENCH 01</span>
        <span class="mm-map-label mm-map-office">OPERATIONS</span>
        <span class="mm-map-label mm-map-crusher">CRUSHER</span>
        <button class="mm-map-truck" each={mapRows} as="unit" type="button" style={unit.style} @click={selectTruck(unit.id)}>{unit.name}</button>
        <span class="mm-map-kevin" if={mapKevin.visible} style={mapKevin.style}>◐ KEVIN</span>
        <span class="mm-map-waypoint" style={waypointStyle}>◎</span>
        <span class="mm-map-player" style={mapPlayer}>◆<span>YOU</span></span>
        <p class="mm-map-stale" if={!hud.relay}>LAST KNOWN POSITIONS / REPAIR THE REPEATER</p>
        <p class="mm-map-legend"><span>● FLEET</span><span>◆ YOU</span><span>◎ WAYPOINT</span></p>
      </div>
      <div class="mm-map-tracking" if={hud.waypoint !== ''}>
        <span>{hud.waypoint}</span>
        <span class="mm-small">{hud.tracking}</span>
        <button class="mm-small-button" type="button" @click={clearWaypoint}>Clear marker ×</button>
      </div>
      <div class="mm-place-links">
        <button type="button" @click={markPlace('pit')}>Bench 1</button>
        <button type="button" @click={markPlace('crusher')}>Crusher</button>
        <button type="button" @click={markPlace('office')}>Office</button>
        <button type="button" @click={markPlace('fuel')}>Fuel</button>
        <button type="button" @click={markPlace('workshop')}>Workshop</button>
        <button type="button" @click={markPlace('charger')}>Charging</button>
        <button type="button" @click={markPlace('ramp')}>Bazza's ramp</button>
      </div>
    </section>

    <div class="mm-stack">
      <section class="mm-card">
        <div class="mm-card-title"><span>Needs your boots</span><span class="mm-pill">{alertRows.length}</span></div>
        <div class="mm-all-clear" if={alertRows.length === 0}>
          <span class="mm-check">✓</span>
          <h3>All clear. For now.</h3>
          <p class="mm-muted">A good time to put another truck to work. Or to try Bazza's ramp. One of those.</p>
        </div>
        <div class="mm-alert-row" each={alertRows} as="alert">
          <span class="mm-alert-title">{alert.title}</span>
          <span class="mm-small">{alert.distance} away / opened {alert.age} ago</span>
          <button class="mm-warning-button" type="button" @click={goAlert(alert.key)}>{alert.kind === 'kevin' ? 'Go and shoo him →' : 'Mark it and head outside →'}</button>
        </div>
      </section>

      <section class="mm-callout">
        <span class="mm-label">{hud.pace} / {hud.remaining}</span>
        <h3>{hud.goal}</h3>
        <p>{hud.goalDetail}</p>
        <button class="mm-small-button" type="button" @click={focusObjective}>Show next step →</button>
        <span class="mm-small">{hud.contract}</span>
      </section>

      <section class="mm-card mm-end-shift">
        <span class="mm-label">WHEN THE WORK IS DONE</span>
        <p class="mm-muted">Target reached? Finish now, or keep hauling for ore money. At 18:00 the shift ends whether you like it or not.</p>
        <button class="mm-secondary" type="button" @click={finishShift} disabled={!reportCanEnd}>End shift and reconcile</button>
      </section>
    </div>
  </div>
</div>

<style>
  .mm-plant-strip {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    margin: 0 0 22px;
    background: #263a3c;
    border: 1px solid #526765;
    border-left: 3px solid #80c6b3;
    border-radius: 8px;
  }
  .mm-plant-strip > div {
    padding: 16px 20px;
  }
  .mm-plant-strip .mm-label {
    font-size: 9px;
  }
  .mm-game .mm-plant-strip h3 {
    margin: 7px 0;
    font-size: 23px;
    font-weight: 450;
    color: #e5e7d5;
  }
  .mm-operations-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(250px, 1fr);
    align-items: start;
    gap: 20px;
  }

  /* ---------- Map ---------- */
  /* Square: positionStyle and initMapLines (logic/core/ui-state.logic) map 370 m to 100% on both axes. */
  .mm-map {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    isolation: isolate;
    background-color: #172d31;
    background-image: linear-gradient(#8bb3ae0b 1px, transparent 1px), linear-gradient(90deg, #8bb3ae0b 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .mm-map-pit {
    position: absolute;
    left: 16%;
    top: 4%;
    width: 69%;
    height: 65%;
    transform: rotate(-14deg);
    background: #1c31234d;
    border: 1px solid #64795355;
    border-radius: 45% 48% 42% 53%;
  }
  .mm-bench-b {
    left: 23%;
    top: 11%;
    width: 53%;
    height: 51%;
    background: #172c218a;
  }
  .mm-bench-c {
    left: 32%;
    top: 22%;
    width: 34%;
    height: 31%;
    background: #142a22aa;
  }
  .mm-route-line {
    position: absolute;
    z-index: 1;
    height: 2px;
    transform-origin: 0 50%;
    background: #ab9855;
    opacity: 0.85;
  }
  .mm-map-label {
    position: absolute;
    z-index: 2;
    font-size: 8px;
    letter-spacing: 1.5px;
    color: #99a884;
  }
  .mm-map-bench {
    top: 32%;
    left: 40%;
  }
  .mm-map-office {
    top: 92%;
    left: 30%;
  }
  .mm-map-crusher {
    top: 80%;
    left: 60%;
  }
  .mm-map-truck {
    position: absolute;
    z-index: 4;
    padding: 3px 5px;
    transform: translate(-50%, -50%);
    background: #233a2a;
    border: 1px solid #adbc6f;
    border-radius: 3px;
    box-shadow: 0 2px 5px #071a14aa;
    font: 8px/1.2 monospace;
    color: #f1edba;
    white-space: nowrap;
  }
  .mm-map-kevin {
    position: absolute;
    z-index: 5;
    padding: 2px 5px;
    transform: translate(-50%, -50%);
    background: #4b2d16;
    border: 1px solid #ff8a1e;
    border-radius: 10px;
    font: 700 8px monospace;
    color: #ffc58a;
    white-space: nowrap;
  }
  .mm-map-player {
    position: absolute;
    z-index: 6;
    transform: translate(-50%, -50%);
    font-size: 16px;
    line-height: 1;
    color: #7de3bd;
    text-shadow: 0 0 8px #70e3ba66;
  }
  .mm-map-player span {
    position: absolute;
    top: 15px;
    left: -3px;
    font-size: 7px;
    letter-spacing: 1px;
  }
  .mm-map-waypoint {
    position: absolute;
    z-index: 3;
    transform: translate(-50%, -50%);
    font-size: 22px;
    color: #d9edb0;
  }
  .mm-map-legend {
    position: absolute;
    left: 10px;
    bottom: 9px;
    display: flex;
    gap: 12px;
    font-size: 7px;
    letter-spacing: 0.5px;
    color: #b6c89a;
  }
  .mm-map-stale {
    position: absolute;
    inset: 0;
    z-index: 8;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: #18271ca9;
    font-size: 9px;
    letter-spacing: 1px;
    text-align: center;
    color: #e1b480;
    pointer-events: none;
  }
  .mm-map-tracking {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background: #253b40;
    font-size: 11px;
  }
  .mm-map-tracking button {
    margin-left: auto;
  }
  .mm-place-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 10px;
    border-top: 1px solid var(--line);
  }
  .mm-place-links button {
    padding: 5px 9px;
    background: transparent;
    border: 1px solid #51646b;
    border-radius: 3px;
    font-size: 9px;
    color: #bfcfd2;
  }

  /* ---------- Alerts and the end of the shift ---------- */
  .mm-all-clear {
    padding: 23px;
    text-align: center;
  }
  .mm-game .mm-all-clear h3 {
    font-size: 17px;
  }
  .mm-all-clear .mm-muted {
    font-size: 11px;
  }
  .mm-check {
    display: inline-grid;
    place-items: center;
    width: 37px;
    height: 37px;
    margin-bottom: 7px;
    border: 1px solid #679b8b;
    border-radius: 50%;
    font-size: 18px;
    color: #91d8c0;
  }
  .mm-alert-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 17px;
    border-bottom: 1px solid var(--line);
  }
  .mm-alert-title {
    font-size: 13px;
    font-weight: 600;
    color: #efc294;
  }
  .mm-alert-row .mm-small {
    font-size: 10px;
  }
  .mm-end-shift {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px;
  }
  .mm-end-shift .mm-muted {
    font-size: 11px;
  }

  @media (max-width: 1180px) {
    .mm-operations-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(220px, 1fr);
    }
  }
  @media (max-width: 750px) {
    .mm-plant-strip {
      grid-template-columns: 1fr;
    }
    .mm-plant-strip > div {
      padding: 12px 16px;
    }
  }
  @media (max-width: 700px) {
    .mm-operations-grid {
      grid-template-columns: 1fr;
    }
    .mm-place-links button {
      min-height: 40px;
    }
    .mm-map-truck {
      min-width: 40px;
      min-height: 32px;
    }
  }
</style>
