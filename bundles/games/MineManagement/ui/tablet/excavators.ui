<!--
  09 Excavators: the loading machines. Buy a second one, deploy one to Bench 1's loading face, hold
  it, or go and drive it yourself. `excavatorRows` is built in logic/mine/plant.logic.
-->
<div if={tab === 'excavators'}>
  <div class="mm-page-head">
    <div>
      <span class="mm-label">LOADING EQUIPMENT / {hud.excavatorCount} OWNED</span>
      <h2>Put the right bucket to work.</h2>
      <p class="mm-muted">There is one loading face. Mel runs whichever excavator is deployed there, and has feelings about all of them.</p>
    </div>
    <button class="mm-primary" type="button" @click={buyExcavator} disabled={hud.excavatorCount >= 2}>Buy EXC-02 / $14,000</button>
  </div>

  <div class="mm-exc-grid">
    #each (ex in excavatorRows) key={ex.id}
      <article class="mm-exc-card">
        <span class="mm-label">{ex.status}</span>
        <h2>{ex.name}</h2>
        <span class="mm-exc-model">{ex.model}</span>
        <p class="mm-muted">{ex.pass}</p>
        <div class="mm-process-strip">
          <div><span class="mm-label">BUCKET PASSES</span><span>{ex.passes}</span></div>
          <div><span class="mm-label">PRODUCTION</span><span>{ex.tonnes}</span></div>
        </div>
        <button class="mm-primary" type="button" @click={locateExcavator(ex.id)}>Locate & head outside →</button>
        <button class="mm-secondary" type="button" if={ex.deployed} @click={holdExcavator(ex.id)}>{ex.hold}</button>
        <button class="mm-secondary" type="button" @click={deployExcavator(ex.id)} disabled={ex.disabled}>{ex.deployed ? 'Deployed at Bench 1' : 'Deploy to Bench 1 / 20 s'}</button>
      </article>
    #end
  </div>

  <div class="mm-callout">
    <span class="mm-label">DIG → LIFT → SWING → DISCHARGE</span>
    <p>Walk to the excavator and press E. D swings toward the face and Space fills the bucket (two seconds). A swings back to the truck, and L empties the bucket into a stopped truck underneath. W and S move the boom, C changes the camera, E gets out. Deploying needs an empty bucket and a clear loading bay, and Mel asks that you wipe your boots.</p>
  </div>
</div>

<style>
  .mm-exc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 0 0 24px;
  }
  .mm-exc-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 25px;
    background: linear-gradient(145deg, #2c4048, #22333b);
    border: 1px solid #52636b;
    border-top: 3px solid var(--gold);
    border-radius: 10px;
  }
  .mm-exc-card > .mm-label {
    color: #dfbc79;
  }
  .mm-game .mm-exc-card h2 {
    margin: 0;
    font-size: 35px;
    font-weight: 450;
  }
  .mm-exc-model {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.5px;
  }
  .mm-exc-card .mm-process-strip {
    grid-template-columns: 1fr 1fr;
    margin: 12px 0;
  }
  .mm-exc-card > button {
    width: 100%;
  }
  @media (max-width: 750px) {
    .mm-exc-grid {
      grid-template-columns: 1fr;
    }
    .mm-exc-card {
      padding: 19px;
    }
  }
</style>
