<!--
  10 Site journal: the story so far. This shift's chapter and its plan choice, the seed's
  commission, the optional preventive rounds, every open fault and the handover notes that carry
  from shift to shift. Data comes from logic/mine/chapters.logic, rounds.logic and incidents.logic.
-->
<div if={tab === 'site'}>
  <div class="mm-page-head">
    <div>
      <span class="mm-label">THE MINE REMEMBERS</span>
      <h2>{chapterView.title}</h2>
      <p class="mm-muted">{chapterView.detail}</p>
    </div>
  </div>

  <div class="mm-site-conditions">
    <div>
      <span class="mm-label">SHIFT SEED</span>
      <span>{chapterView.seed}</span>
      <span class="mm-small">{chapterView.conditions}</span>
    </div>
    <div>
      <span class="mm-label">FORECAST</span>
      <span>{chapterView.forecast}</span>
      <span class="mm-small">{chapterView.spares} · {chapterView.resolved}</span>
    </div>
  </div>

  <section class="mm-card mm-site-plan">
    <span class="mm-label">{chapterView.choice}</span>
    <div class="mm-site-choice" if={chapterView.canChoose}>
      <button class="mm-primary" type="button" @click={chooseChapter('a')}>{chapterView.a}</button>
      <button class="mm-secondary" type="button" @click={chooseChapter('b')}>{chapterView.b}</button>
    </div>
    <span class="mm-small">Plans, repairs and crew trust stay with this mine. Faults you leave open are still open tomorrow. They do not fix themselves. We checked.</span>
  </section>

  <section class="mm-card mm-site-plan">
    <span class="mm-label">SEED COMMISSION</span>
    <h3>{commissionView.title}</h3>
    <p>{commissionView.detail}</p>
    <span class="mm-small">{commissionView.status}</span>
    <button class="mm-secondary" type="button" @click={acceptCommission} disabled={commissionView.disabled}>Accept commission</button>
  </section>

  <section class="mm-card mm-site-plan">
    <span class="mm-label">OPTIONAL / PREVENTIVE ROUNDS</span>
    <h3>Catch the little things.</h3>
    <p>{roundSummary}</p>
    <span class="mm-small">Record three on-site checks. Each one gives that system 60 more seconds before a warning gets worse, until the next shift. Faults that are already critical still need a repair.</span>
    #each (check in roundRows) key={check.id}
      <div class="mm-round-row">
        <div>
          <span class="mm-label">{check.status}</span>
          <h3>{check.title}</h3>
          <span class="mm-small">{check.detail}</span>
        </div>
        <button class="mm-secondary" type="button" @click={markInspection(check.id)} disabled={check.disabled}>{check.done ? 'Recorded ✓' : 'Visit / ' + check.distance}</button>
      </div>
    #end
  </section>

  <h3 class="mm-site-heading">Field board</h3>
  #each (job in incidentRows) key={job.key}
    <section class="mm-card mm-site-job">
      <span class="mm-label">{job.status} · {job.work}</span>
      <h3>{job.title}</h3>
      <p>{job.detail}</p>
      <button class="mm-warning-button" type="button" @click={goAlert(job.key)}>Mark the job →</button>
    </section>
  #empty
    <p class="mm-muted">No open faults. Check the forecast, say hello to the crew, or stand very still and enjoy it.</p>
  #end

  <h3 class="mm-site-heading">Handover journal</h3>
  #each (entry in journalRows)
    <div class="mm-journal-entry">
      <span class="mm-label">{entry.when}</span>
      <h3>{entry.title}</h3>
      <p class="mm-muted">{entry.message}</p>
    </div>
  #end
</div>

<style>
  .mm-site-conditions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 20px 0;
    padding: 20px;
    background: #10262d;
    border: 1px solid #35514d;
    border-radius: 12px;
  }
  .mm-site-conditions > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .mm-site-plan,
  .mm-site-job {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 14px 0;
    padding: 20px 22px;
  }
  .mm-site-plan > button,
  .mm-site-job > button {
    align-self: flex-start;
  }
  .mm-site-choice {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 6px 0 2px;
  }
  .mm-site-choice button {
    min-height: 48px;
    white-space: normal;
  }
  .mm-game .mm-site-heading {
    margin: 26px 0 4px;
  }
  .mm-round-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-top: 1px solid #436057;
  }
  .mm-round-row > div {
    flex: 1;
  }
  .mm-game .mm-round-row h3 {
    margin: 7px 0;
  }
  .mm-round-row button {
    min-height: 44px;
    white-space: normal;
  }
  .mm-journal-entry {
    margin: 18px 0;
    padding: 5px 0 5px 18px;
    border-left: 2px solid #547c70;
  }
  .mm-game .mm-journal-entry h3 {
    margin: 8px 0;
  }
  @media (max-width: 700px) {
    .mm-site-conditions {
      grid-template-columns: 1fr;
    }
    .mm-round-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 9px;
    }
  }
</style>
