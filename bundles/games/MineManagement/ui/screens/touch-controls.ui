<!--
  On-screen controls for touch: a drive pad (bottom left), a look pad and contextual action buttons
  (bottom right). They appear once a finger touches the game, or from Pause. Each pad reports its
  own drags (logic/player/touch-controls.logic), so moving and looking work with two thumbs at once.
-->
<div class="mm-screen-controls" if={controlsEnabled && (!isRepairing || fieldView.carry)}>
  <div class="mm-drive-cluster">
    <span class="mm-control-caption">{hud.padTitle} / DRAG TO MOVE</span>
    <div class="mm-drive-pad" @pointerdown={drivePadStart} @pointermove={drivePadMove} @pointerup={stopDrivePad} @pointercancel={stopDrivePad} @pointerleave={stopDrivePad}>
      <span class="mm-pad-north">{hud.padTop}</span>
      <span class="mm-pad-west">‹</span>
      <span class="mm-pad-east">›</span>
      <span class="mm-pad-south">{hud.padBottom}</span>
      <div class="mm-pad-cross"></div>
      <div class="mm-drive-thumb" style={driveThumb}>+</div>
    </div>
    <span class="mm-control-caption">Let go to stop</span>
  </div>

  <p class="mm-control-help">
    <span>{hud.controlsHelp}</span>
    <span>Keyboard: WASD / E interact / H horn / C camera / P park</span>
  </p>

  <div class="mm-action-cluster">
    <div class="mm-look-pad" @pointerdown={lookPadStart} @pointermove={lookPadMove} @pointerup={stopLookPad} @pointercancel={stopLookPad} @pointerleave={stopLookPad}>
      <span>LOOK AROUND</span>
      <span>Drag here or on the view</span>
    </div>
    <div class="mm-action-grid">
      <button class="mm-control-action mm-control-main" type="button" @click={controlInteract}>{hud.touchAction}</button>
      #if (hud.controlMode === 'foot')
        <button class="mm-control-action" type="button" @click={toggleRun}>{hud.runLabel}</button>
        <button class="mm-control-action" type="button" @click={touchJump}>Jump</button>
      #end
      #if (hud.controlMode === 'ute' || hud.controlMode === 'truck')
        <button class="mm-control-action mm-control-brake" type="button" @pointerdown={pressControl(' ')} @pointerup={releaseControl(' ')} @pointerleave={releaseControl(' ')} @pointercancel={releaseControl(' ')}>Hold brake</button>
      #end
      #if (hud.controlMode !== 'foot')
        <button class="mm-control-action" type="button" @click={toggleCamera}>Cab / chase</button>
      #end
      #if (hud.controlMode === 'truck')
        <button class="mm-control-action mm-control-main" type="button" @click={haulAction} disabled={hud.haulDisabled}>{hud.haulAction}</button>
      #end
      #if (hud.controlMode === 'ute')
        <button class="mm-control-action" type="button" @click={honk}>Horn</button>
      #end
      #if (hud.controlMode === 'excavator')
        <button class="mm-control-action" type="button" @click={scoopBucket}>Dig bucket</button>
        <button class="mm-control-action" type="button" @click={manualLoad}>Discharge</button>
      #end
      #if (hud.controlMode === 'ute' || hud.controlMode === 'truck')
        <button class="mm-control-action mm-park-button" type="button" @click={toggleParkBrake}>{hud.parkLabel}</button>
      #end
      <button class="mm-control-action" type="button" @click={centerView}>Centre view</button>
      <button class="mm-control-action" type="button" @click={toggleLamp}>Headlamp</button>
    </div>
  </div>
</div>

<style>
  .mm-screen-controls {
    --pad-size: 152px;
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* Nothing inside a pad takes the pointer: the pad itself tracks the whole drag. */
  .mm-drive-pad *,
  .mm-look-pad * {
    pointer-events: none;
    user-select: none;
  }
  .mm-drive-pad,
  .mm-look-pad,
  .mm-control-action {
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  .mm-control-caption {
    font-size: 9px;
    letter-spacing: 0.7px;
    color: #c3d3d4;
    text-shadow: 0 1px 4px #07151d;
  }

  /* ---------- Drive pad ---------- */
  .mm-drive-cluster {
    position: absolute;
    left: max(12px, env(safe-area-inset-left));
    bottom: max(14px, env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }
  .mm-drive-pad {
    position: relative;
    width: var(--pad-size);
    height: var(--pad-size);
    overflow: hidden;
    background: radial-gradient(circle, #54777577, #16353fde 65%);
    border: 1px solid #9dbabf88;
    border-radius: 50%;
    box-shadow: inset 0 0 0 8px #122b3566, 0 5px 20px #0003;
    cursor: move;
    pointer-events: auto;
  }
  .mm-pad-cross {
    position: absolute;
    inset: 21%;
    border: 1px solid #b5d2ca33;
    border-radius: 50%;
  }
  .mm-drive-thumb {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    transform: translate(-50%, -50%);
    background: linear-gradient(#afc5b2, #688e87);
    border: 2px solid #d0e6cf99;
    border-radius: 50%;
    box-shadow: 0 3px 9px #071b2277;
    font-size: 24px;
    color: #153b40;
    will-change: left, top;
  }
  .mm-pad-north,
  .mm-pad-south {
    position: absolute;
    left: 0;
    right: 0;
    font-size: 7px;
    letter-spacing: 0.8px;
    color: #d5e5da;
  }
  .mm-pad-north {
    top: 12px;
  }
  .mm-pad-south {
    bottom: 12px;
  }
  .mm-pad-west,
  .mm-pad-east {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 24px;
    color: #cedfd9;
  }
  .mm-pad-west {
    left: 12px;
  }
  .mm-pad-east {
    right: 12px;
  }

  /* ---------- Help text between the pads ---------- */
  .mm-control-help {
    position: absolute;
    left: 220px;
    right: 280px;
    bottom: 24px;
    text-align: center;
    font-size: 10px;
    color: #c2d4d5;
    text-shadow: 0 1px 4px #082028;
  }
  .mm-control-help > span {
    display: block;
  }
  .mm-control-help > span:last-child {
    margin-top: 6px;
    font-size: 9px;
    color: #a2bec3;
  }

  /* ---------- Look pad and action buttons ---------- */
  .mm-action-cluster {
    position: absolute;
    right: max(12px, env(safe-area-inset-right));
    bottom: max(14px, env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 228px;
    pointer-events: auto;
  }
  .mm-look-pad {
    min-height: 60px;
    padding: 12px;
    background: #1a3945d9;
    border: 1px solid #8ab4ba77;
    border-radius: 8px;
    text-align: center;
    cursor: move;
  }
  .mm-look-pad > span:first-child {
    display: block;
    font-size: 10px;
    letter-spacing: 1.1px;
    color: #c9e3df;
  }
  .mm-look-pad > span:last-child {
    display: block;
    margin-top: 3px;
    font-size: 9px;
    color: #afc6c9;
  }
  .mm-action-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 7px;
  }
  .mm-control-action {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 8px 10px;
    background: #19343fea;
    border: 1px solid #7d9ba199;
    border-radius: 7px;
    font-size: 11px;
    line-height: 1.2;
    color: #e4e9d9;
  }
  .mm-control-action:active {
    background: #527975;
  }
  .mm-control-main {
    background: #bd9254f0;
    border-color: #dfb374;
    color: #142d34;
  }
  .mm-control-brake {
    border-color: #d5a570;
    color: #ffd9a0;
  }
  .mm-park-button {
    border-color: #d4ae6b;
  }

  @media (max-width: 1050px) {
    .mm-action-cluster {
      width: 200px;
    }
    .mm-control-help {
      left: 200px;
      right: 240px;
    }
  }
  @media (max-width: 700px) {
    .mm-screen-controls {
      --pad-size: 138px;
    }
    .mm-drive-cluster,
    .mm-action-cluster,
    .mm-action-grid {
      gap: 6px;
    }
    .mm-action-cluster {
      width: 180px;
    }
    .mm-control-action {
      padding: 7px;
      font-size: 10px;
    }
    .mm-control-caption {
      font-size: 8px;
      letter-spacing: 0.3px;
    }
    .mm-control-help {
      display: none;
    }
    .mm-look-pad {
      min-height: 54px;
      padding: 9px;
    }
  }
  @media (max-width: 390px) {
    .mm-screen-controls {
      --pad-size: 124px;
    }
    .mm-action-cluster {
      right: 8px;
      width: 166px;
    }
    .mm-drive-cluster {
      left: 8px;
    }
  }
  @media (max-height: 620px) {
    .mm-control-help {
      display: none;
    }
  }
</style>
