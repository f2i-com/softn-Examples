<!--
  Things that pop up over the world while playing:
    - toasts: short notes that fade ("+80 t delivered", "AIRTIME 1.2 s"), from toast() in
      logic/fun/effects.logic, refreshed into `toastList` by refreshUI();
    - Clive's memo: a decision from Head Office with two answers (logic/fun/memos.logic). Click an
      answer or press 1 or 2. Silence for 45 seconds counts as a polite no. While the tablet is
      open the same memo is shown at the top of the tablet instead (tablet/tablet.ui), so it never
      covers a workspace.
-->
<div class="mm-toasts" if={screen === 'play'} aria-live="polite">
  #each (note in toastList) key={note.id}
    <p class={note.className}>{note.text}</p>
  #end
</div>

<aside class="mm-memo" if={screen === 'play' && memoView.visible && !tablet} aria-live="assertive">
  <header class="mm-memo-head">
    <span class="mm-memo-from">MEMO FROM CLIVE / HEAD OFFICE</span>
    <span class="mm-memo-timer">{memoView.left}</span>
  </header>
  <span class="mm-label">{memoView.tag}</span>
  <h3>{memoView.title}</h3>
  <p>{memoView.body}</p>
  <div class="mm-memo-answers">
    <button class="mm-primary" type="button" @click={answerMemo('a')}><kbd>1</kbd>{memoView.a}</button>
    <button class="mm-secondary" type="button" @click={answerMemo('b')}><kbd>2</kbd>{memoView.b}</button>
  </div>
</aside>

<style>
  /* ---------- Toasts: top centre, newest first ---------- */
  .mm-toasts {
    position: absolute;
    top: 96px;
    left: 50%;
    z-index: 7;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .mm-toast {
    padding: 8px 16px;
    background: #12262fe6;
    border: 1px solid #8fb7b555;
    border-radius: 20px;
    box-shadow: 0 6px 18px #0004;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.6px;
    color: #f2f0e4;
    white-space: nowrap;
    animation: mm-toast-in 0.28s ease-out;
    transition: opacity 0.5s, transform 0.5s;
  }
  .mm-toast-good {
    border-color: #77d4c2aa;
    color: #b8f0e2;
  }
  .mm-toast-gold {
    padding: 10px 20px;
    background: linear-gradient(90deg, #4a3712f0, #6b4d17f0);
    border-color: var(--gold);
    font-size: 16px;
    color: #ffe2a6;
  }
  .mm-toast-memo {
    border-color: #e1b16c99;
    color: #f4d49b;
  }
  .mm-toast-out {
    opacity: 0;
    transform: translateY(-6px);
  }
  @keyframes mm-toast-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.96);
    }
  }

  /* ---------- Memo from Head Office: a sheet of fax paper on the right ---------- */
  .mm-memo {
    position: absolute;
    right: 28px;
    top: 38%;
    z-index: 8;
    width: 330px;
    padding: 16px 18px 18px;
    transform: translateY(-50%);
    background: linear-gradient(160deg, #fbf3df, #efe2c2);
    border: 1px solid #c9b07a;
    border-radius: 6px;
    box-shadow: 0 18px 50px #000a, inset 0 0 0 4px #ffffff55;
    color: #2b2a24;
    animation: mm-memo-in 0.35s cubic-bezier(0.2, 1.4, 0.4, 1);
  }
  .mm-memo-head {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 2px dashed #c9b07a;
    font: 700 9px monospace;
    letter-spacing: 1px;
    color: #7a5c22;
  }
  .mm-memo .mm-label {
    color: #9b3b20;
  }
  .mm-game .mm-memo h3 {
    margin: 4px 0 8px;
    font-size: 18px;
    color: #23221c;
  }
  .mm-memo p {
    font-size: 12px;
    line-height: 1.6;
    color: #3c3a30;
  }
  .mm-memo-answers {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-top: 14px;
  }
  .mm-memo-answers button {
    justify-content: flex-start;
    white-space: normal;
    text-align: left;
  }
  .mm-memo .mm-secondary {
    background: #fffaf0;
    border-color: #b9a578;
    color: #2b2a24;
  }
  .mm-memo .mm-secondary:hover:not(:disabled) {
    background: #f6ecd6;
  }
  .mm-memo kbd {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    margin-right: 8px;
    border: 1px solid currentColor;
    border-radius: 3px;
    font: 700 10px monospace;
    opacity: 0.7;
  }
  @keyframes mm-memo-in {
    from {
      opacity: 0;
      transform: translate(30px, -50%) rotate(3deg);
    }
  }

  @media (max-width: 700px) {
    .mm-toasts {
      top: 70px;
    }
    .mm-toast {
      font-size: 11px;
    }
    .mm-memo {
      top: 76px;
      left: 12px;
      right: 12px;
      width: auto;
      transform: none;
    }
    @keyframes mm-memo-in {
      from {
        opacity: 0;
        transform: translateY(-14px);
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mm-toast,
    .mm-memo {
      animation: none;
    }
  }
</style>
