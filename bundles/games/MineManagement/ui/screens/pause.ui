<!--
  Pause: stops the shift clock, saves, and holds the settings. Esc opens and closes it. Switching to
  another window pauses too (focusLost in logic/player/input.logic).
-->
<div class="mm-modal-shade" if={screen === 'pause'}>
  <section class="mm-pause-modal" aria-label="Paused">
    <span class="mm-label">THE MINE CAN WAIT</span>
    <h2>Tools down.</h2>
    <p class="mm-muted">The shift is paused. The robots are enjoying this more than they will admit.</p>
    <button class="mm-primary" type="button" @click={resumeGame}>Back to work →</button>
    <div class="mm-pause-save-row">
      <button class="mm-secondary" type="button" @click={saveGame(false)}>Save shift</button>
      <button class="mm-secondary" type="button" @click={showSaveBackup}>Backup / export</button>
    </div>

    <div class="mm-setting-row" aria-label="Settings">
      <button type="button" @click={toggleMute}>{muted ? 'Sound off' : 'Sound on'}</button>
      <button type="button" @click={cycleQuality}>Graphics: {quality}</button>
      <button type="button" @click={toggleMotion}>{motion ? 'Motion on' : 'Reduced motion'}</button>
      <button type="button" @click={toggleMusic}>{musicEnabled ? 'Music on' : 'Music off'}</button>
      <button type="button" @click={toggleRadio}>{radioEnabled ? 'Radio voice on' : 'Radio voice off'}</button>
      <button type="button" @click={toggleScreenControls}>{controlsEnabled ? 'Touch pads on' : 'Touch pads off'}</button>
      <button type="button" @click={cycleSensitivity}>Look: {lookSensitivity < 1 ? 'gentle' : lookSensitivity > 1 ? 'fast' : 'standard'}</button>
    </div>

    <div class="mm-pause-save-row">
      <button class="mm-secondary" type="button" @click={recoverVehicle}>{resetConfirm ? 'Confirm recovery / $250' : 'Stuck? Tow me to the compound / $250'}</button>
      <button class="mm-small-button" type="button" if={resetConfirm} @click={cancelResetConfirm}>Cancel</button>
    </div>
    <button class="mm-text-button" type="button" @click={returnTitle}>Save and return to the title</button>

    <div class="mm-pause-help">
      <span class="mm-small">WASD move · E interact · T tablet · H horn · Space brake or jump · C camera · 1 / 2 answer a memo</span>
      <span class="mm-small">Mouse or touch: drag the view to look. Hitting things is not the goal, though it is a goal.</span>
      <span class="mm-small">MINE MANAGEMENT / v{VERSION}</span>
    </div>
    <p class="mm-small mm-centre">{saveNote}</p>
  </section>
</div>

<style>
  .mm-pause-modal {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 470px;
    max-width: 100%;
    max-height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 34px;
    background: #1e3039;
    border: 1px solid #60727a;
    border-radius: 13px;
    box-shadow: 0 20px 100px #07191088;
  }
  .mm-game .mm-pause-modal h2 {
    margin: 0;
    font-size: 38px;
    font-weight: 500;
  }
  .mm-pause-modal > .mm-primary {
    margin-top: 6px;
  }
  .mm-pause-save-row {
    display: flex;
    gap: 8px;
  }
  .mm-pause-save-row > .mm-secondary {
    flex: 1;
  }
  .mm-setting-row {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }
  .mm-setting-row button {
    padding: 8px 10px;
    background: #2e424c;
    border: 1px solid #536873;
    border-radius: 4px;
    font-size: 10px;
    color: #dae4e5;
  }
  .mm-setting-row button:hover {
    background: #3a525d;
  }
  .mm-pause-help {
    margin-top: 4px;
    padding-top: 12px;
    border-top: 1px solid #445b60;
  }
  .mm-pause-help .mm-small {
    font-size: 10px;
  }
  .mm-centre {
    text-align: center;
  }
  @media (max-width: 620px) {
    .mm-pause-modal {
      padding: 25px;
    }
  }
</style>
