<!--
  The end-of-shift report: grade, rank title and Clive's verdict (logic/fun/awards.logic), the
  shift's numbers (summaryRows), the awards nobody asked for (awardRows) and, on the day Red Dust
  reopens, the ending. Next shift carries the mine forward; the report survives a reload.
-->
<div class="mm-modal-shade mm-report-shade" if={screen === 'report'}>
  <section class="mm-report" aria-label="Shift report">
    <span class="mm-label">PIT SOFTWARE / END-OF-SHIFT RECONCILIATION</span>
    <h1>{hud.reportTitle}</h1>

    <div class="mm-report-grade">
      <span class="mm-grade">{hud.rank}</span>
      <div>
        <span class="mm-label">SHIFT {hud.shift} / {hud.tonnes} OF {hud.target} TONNES</span>
        <p class="mm-verdict">{reportVerdict}</p>
      </div>
    </div>

    <!-- Reopening day: the story's ending, once. -->
    <div class="mm-ending" if={endingView.visible}>
      <span class="mm-label">THE GRAND REOPENING</span>
      <h2>Red Dust is officially open.</h2>
      <p>The ribbon was cut at 17:00. Gary read the commemorative sign aloud, twice. Mel named the ribbon Trevor. Kevin attended, uninvited, in hi-vis. Clive took the credit in a press release.</p>
      <p>The mine is yours. It keeps running: more shifts, bigger targets, the same emu.</p>
    </div>

    <div class="mm-report-stats">
      #each (row in summaryRows)
        <div><span class="mm-label">{row.name}</span><span>{row.value}</span></div>
      #end
    </div>

    <h3 class="mm-awards-title">Shift awards</h3>
    <ul class="mm-awards">
      #each (award in awardRows)
        <li><span class="mm-award-icon" aria-hidden="true">{award.icon}</span><div><strong>{award.title}</strong><span>{award.detail}</span></div></li>
      #end
    </ul>

    <p class="mm-muted">The target bonus is paid only when the target is met; site overheads are charged now. Vehicles, ore in the hopper, crew and upgrades carry over, and the overnight service refuels everything and charges the robots.</p>
    <div class="mm-report-actions">
      <button class="mm-primary" type="button" @click={nextShift}>Next shift →</button>
      <button class="mm-secondary" type="button" @click={showExport}>PIT JSON snapshot</button>
      <button class="mm-secondary" type="button" @click={showSaveBackup}>Save backup</button>
      <button class="mm-text-button" type="button" @click={returnTitle}>Save and return to the title</button>
    </div>
    <p class="mm-small">{saveNote}</p>
  </section>
</div>

<style>
  .mm-report {
    width: 790px;
    max-width: 100%;
    max-height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 42px;
    background: #1e3039;
    border: 1px solid #60727a;
    border-radius: 13px;
  }
  .mm-game .mm-report h1 {
    margin: 18px 0 24px;
    font-size: 45px;
    letter-spacing: -2px;
  }
  .mm-report-grade {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-bottom: 25px;
  }
  .mm-grade {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 86px;
    height: 86px;
    background: #ddb96d;
    border-radius: 7px;
    font-size: 44px;
    font-weight: 700;
    letter-spacing: -3px;
    color: #223726;
  }
  .mm-verdict {
    margin-top: 6px;
    font-size: 15px;
    line-height: 1.55;
    color: #e8e3cf;
  }

  /* ---------- The ending ---------- */
  .mm-ending {
    margin-bottom: 24px;
    padding: 22px 24px;
    background: linear-gradient(120deg, #5a4318, #2e3a24);
    border: 1px solid var(--gold);
    border-radius: 10px;
    box-shadow: 0 0 40px #efb55433;
  }
  .mm-ending .mm-label {
    color: #f6d58f;
  }
  .mm-game .mm-ending h2 {
    margin: 8px 0 10px;
    font-size: 30px;
    color: #fff1cc;
  }
  .mm-ending p {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.7;
    color: #efe6cf;
  }

  /* ---------- Numbers ---------- */
  .mm-report-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-bottom: 23px;
    overflow: hidden;
    background: #50606b;
    border: 1px solid #50606b;
    border-radius: 6px;
  }
  .mm-report-stats > div {
    padding: 18px 20px;
    background: #273b44;
  }
  .mm-report-stats .mm-label {
    font-size: 8px;
  }
  .mm-report-stats > div > span:last-child {
    display: block;
    margin-top: 8px;
    font-size: 21px;
    letter-spacing: -0.4px;
  }

  /* ---------- Awards ---------- */
  .mm-game .mm-awards-title {
    margin: 0 0 12px;
    font-size: 17px;
  }
  .mm-awards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0 0 22px;
    padding: 0;
    list-style: none;
  }
  .mm-awards li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 14px;
    background: #253740;
    border: 1px solid #455a63;
    border-radius: 8px;
  }
  .mm-award-icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 32px;
    height: 32px;
    background: #3e3a22;
    border: 1px solid #8f7a3e;
    border-radius: 50%;
    font-size: 15px;
    color: #f1c873;
  }
  .mm-awards strong {
    display: block;
    font-size: 13px;
    color: #f1e8cf;
  }
  .mm-awards li span:last-child {
    display: block;
    margin-top: 2px;
    font-size: 11px;
    line-height: 1.5;
    color: #b9c8c8;
  }
  .mm-report > .mm-muted {
    font-size: 12px;
    line-height: 1.8;
  }
  .mm-report-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 25px 0 15px;
  }

  @media (max-width: 620px) {
    .mm-report {
      padding: 24px;
    }
    .mm-game .mm-report h1 {
      font-size: 32px;
      letter-spacing: -1px;
    }
    .mm-report-grade {
      gap: 16px;
    }
    .mm-grade {
      width: 66px;
      height: 66px;
      font-size: 35px;
    }
    .mm-report-stats {
      grid-template-columns: 1fr 1fr;
    }
    .mm-report-stats > div {
      padding: 15px;
    }
    .mm-report-stats > div > span:last-child {
      font-size: 17px;
    }
    .mm-awards {
      grid-template-columns: 1fr;
    }
  }
</style>
