<!--
  Theme: the colours, type and building blocks every screen shares. This page draws nothing; its
  rules join the app's stylesheet. Screens add their own rules in their own files.

  Colour tokens are custom properties on .mm-game, so a screen says var(--gold) rather than a hex
  value, and a palette change happens here once.

  SoftN doesn't promise to add this page's styles before the screens', so a screen that changes a
  class defined here must outweigh it (.mm-primary.mm-start), and the base button rule uses
  :where() so that any button class beats it.
-->
<style>
  /* ---------- Root and tokens ---------- */
  .mm-game {
    --ink: #f0eee6;            /* body text */
    --muted: #a7b5b8;          /* secondary text */
    --faint: #8ea3aa;          /* captions and fine print */
    --gold: #efb554;           /* the accent: primary actions, progress */
    --gold-hover: #f4c77b;
    --mint: #77d4c2;           /* good news, live telemetry */
    --rust: #f2a17d;           /* warnings, faults */
    --line: #405159;           /* borders */
    --surface: #1c2a31;        /* tablet workspace background */
    --panel: #22323a;          /* cards */
    --panel-raised: #273841;   /* card headers */
    --shadow: 0 8px 30px #0003;
    --radius: 9px;

    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    isolation: isolate;
    background: #233831;
    color: var(--ink);
    font: 14px/1.5 "Segoe UI", Inter, Arial, sans-serif;
  }
  .mm-game * {
    box-sizing: border-box;
  }

  /* The 3D world fills the window; every screen sits on top of it. */
  .mm-world {
    position: absolute;
    inset: 0;
  }

  /* ---------- Type ---------- */
  .mm-game h1,
  .mm-game h2,
  .mm-game h3 {
    margin: 0;
    color: var(--ink);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }
  .mm-game h2 {
    margin: 5px 0 10px;
    font-size: 30px;
    font-weight: 650;
  }
  .mm-game h3 {
    margin: 6px 0 12px;
    font-size: 19px;
    font-weight: 600;
  }
  .mm-game p {
    margin: 0;
  }
  .mm-game small {
    font-size: 13px;
    font-weight: 400;
    color: var(--muted);
  }
  /* Small caps-style labels above values and headings. */
  .mm-label {
    display: block;
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 1.6px;
    line-height: 1.6;
    text-transform: uppercase;
    color: var(--muted);
  }
  .mm-small {
    display: block;
    font-size: 11px;
    line-height: 1.7;
    color: var(--muted);
  }
  .mm-muted {
    display: block;
    font-size: 13px;
    line-height: 1.65;
    color: var(--muted);
  }

  /* ---------- Layout helpers ---------- */
  .mm-inline {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .mm-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .mm-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold);
  }

  /* ---------- Buttons ---------- */
  /* The base for every button. :where() takes the class's weight away, leaving that of a plain
     button rule: any button style with a class (.mm-primary's dark text on gold, a tab's grey)
     overrides it, wherever SoftN puts this page's styles. */
  :where(.mm-game) button {
    font: inherit;
    color: inherit;
    cursor: pointer;
    touch-action: manipulation;
    transition: background 0.16s, transform 0.16s, border-color 0.16s;
  }
  .mm-game button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .mm-game button:focus-visible,
  .mm-game input:focus-visible,
  .mm-game textarea:focus-visible {
    outline: 3px solid #91dfcb;
    outline-offset: 2px;
  }
  .mm-primary,
  .mm-secondary,
  .mm-small-button,
  .mm-warning-button,
  .mm-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 40px;
    padding: 11px 18px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
  }
  /* The one thing to do next. */
  .mm-primary {
    background: var(--gold);
    border: 1px solid var(--gold);
    color: #1b2529;
  }
  .mm-primary:hover:not(:disabled) {
    background: var(--gold-hover);
    transform: translateY(-1px);
  }
  .mm-secondary {
    background: #2b3b42;
    border: 1px solid #51626a;
    color: var(--ink);
  }
  .mm-secondary:hover:not(:disabled) {
    background: #354b54;
  }
  .mm-small-button {
    min-height: 32px;
    padding: 7px 12px;
    background: transparent;
    border: 1px solid #50626a;
    color: #d0dbdd;
    font-size: 11px;
  }
  .mm-small-button:hover:not(:disabled) {
    background: #344950;
  }
  .mm-warning-button {
    padding: 9px 12px;
    background: #b66f3925;
    border: 1px solid #855c3d;
    color: #edbc89;
    font-size: 11px;
  }
  .mm-close {
    min-height: 40px;
    padding: 7px 12px;
    background: #ffffff07;
    border: 1px solid #50626a;
    color: #d0dbdd;
  }
  .mm-text-button {
    padding: 8px;
    background: transparent;
    border: 0;
    color: #b9c9bb;
    font-size: 12px;
  }

  /* ---------- Progress meter: a track with a filled bar inside ---------- */
  .mm-meter {
    height: 4px;
    overflow: hidden;
    border-radius: 5px;
    background: #ffffff13;
  }
  .mm-meter > div {
    height: 100%;
    border-radius: 5px;
    background: var(--gold);
    transition: width 0.25s;
  }

  /* ---------- Cards, callouts and page headings (used throughout the tablet) ---------- */
  .mm-page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }
  .mm-page-head .mm-label {
    font-size: 9px;
    letter-spacing: 1.5px;
  }
  .mm-page-head > .mm-primary {
    flex-shrink: 0;
  }
  .mm-card {
    overflow: hidden;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .mm-card-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 13px 16px;
    background: var(--panel-raised);
    border-bottom: 1px solid var(--line);
    font-size: 12px;
    font-weight: 600;
  }
  .mm-card-title .mm-small {
    font-size: 8px;
    letter-spacing: 0.6px;
  }
  /* A highlighted note: tips, rules of thumb, the current objective. */
  .mm-callout {
    margin-top: 20px;
    padding: 19px 21px;
    background: #373729;
    border: 1px solid #625a3e;
    border-left: 3px solid var(--gold);
    border-radius: 7px;
    font-size: 12px;
    line-height: 1.8;
    color: #cdd0b5;
  }
  .mm-stack > .mm-callout {
    margin-top: 0;
  }
  .mm-callout h3 {
    margin: 7px 0;
    font-size: 16px;
    color: #e3d4a8;
  }
  .mm-callout .mm-label {
    margin-bottom: 8px;
    font-size: 9px;
    color: #c2ba84;
  }
  .mm-callout > .mm-small,
  .mm-callout > .mm-small-button {
    margin-top: 12px;
  }
  .mm-callout > .mm-small-button {
    display: flex;
    width: max-content;
  }
  .mm-pill {
    padding: 2px 7px;
    border-radius: 4px;
    background: #354631;
    font-size: 10px;
    color: #d4ddb1;
  }
  .mm-empty {
    padding: 35px;
    text-align: center;
    font-size: 12px;
    color: #a1b396;
  }
  .mm-money-large {
    font-size: 30px;
    letter-spacing: -1px;
    color: #e1c384;
    white-space: nowrap;
  }

  /* ---------- Metric strip: big figures in a row of cells ---------- */
  .mm-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px;
    margin-bottom: 23px;
    overflow: hidden;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .mm-metrics > div {
    padding: 17px 20px;
    background: #23343b;
  }
  .mm-metrics .mm-label {
    font-size: 8px;
    letter-spacing: 1.25px;
  }
  .mm-metrics .mm-small {
    font-size: 9px;
  }
  .mm-metric-value {
    display: block;
    margin: 5px 0 4px;
    font-size: 28px;
    font-weight: 450;
    letter-spacing: -1px;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
  }
  .mm-metric-value small {
    margin-left: 0.22em;
  }

  /* ---------- Process strip: a few labelled states side by side (Operations, Excavators) ---------- */
  .mm-process-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin: 0 0 20px;
    overflow: hidden;
    background: #41545b;
    border: 1px solid #41545b;
    border-radius: 8px;
  }
  .mm-process-strip > div {
    padding: 13px 16px;
    background: #20343b;
  }
  .mm-process-strip .mm-label {
    margin-bottom: 5px;
    font-size: 9px;
    color: #9ebbc0;
  }
  .mm-process-strip > div > span:last-child {
    display: block;
    font-size: 13px;
    color: #f2d099;
  }
  @media (max-width: 620px) {
    .mm-process-strip {
      grid-template-columns: 1fr;
    }
    .mm-process-strip > div {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 9px 12px;
    }
    .mm-process-strip .mm-label {
      margin: 0;
    }
  }

  /* ---------- Checklist rows: a tick or a circle, then the item (Field guide, Contracts) ---------- */
  .mm-checklist-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid #ffffff0c;
    font-size: 13px;
  }
  .mm-checklist-row > span:first-child {
    color: #8edac8;
  }

  /* ---------- Modal backdrop (pause, report, export) ---------- */
  .mm-modal-shade {
    position: absolute;
    inset: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 25px;
    background: #081720c7;
  }

  /* ---------- Asset failure banner ---------- */
  .mm-error {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 20px;
    background: #71321ee8;
    color: #fff3e0;
    font-size: 12px;
  }

  @media (max-width: 700px) {
    .mm-metrics > div {
      padding: 14px;
    }
    .mm-metrics > div:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
    .mm-metric-value {
      font-size: 24px;
    }
    .mm-money-large {
      font-size: 24px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mm-game button,
    .mm-meter > div {
      transition: none;
    }
  }
</style>
