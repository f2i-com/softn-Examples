// Deterministic 60 Hz frog physics. Render rate, audio and UI never change the rules.
function canJump() { let p=G.p;return p.grounded || p.coyote>0 || p.mode==="cling" || p.mode==="swim"; }
function jumpPress() {
    if(screen!=="play" || G.mission.done) return;
    if(G.tongue.state==="latched") {let t=findTarget(G.tongue.target);if(t && t.kind==="anchor") {
        releaseTongue();G.p.vy=Math.min(G.p.vy,-310);G.p.vx+=G.p.face*70;G.p.wallLock=0.2;
        G.p.charging=false;G.p.buffer=0;G.swings++;badge("swing");sound("jump");return;
    }}
    if(canJump()) {G.p.charging=true;G.p.charge=0;}
    else G.p.buffer=CFG.buffer;
}
function jumpRelease() {
    let p=G.p;
    if(p.charging && canJump()) launchJump(clamp(p.charge/CFG.chargeTime,0,1));
    else if(!p.charging && !p.grounded) p.buffer=CFG.buffer;
    p.charging=false;p.charge=0;
}
function launchJump(power) {
    let p=G.p;let s=findPlatform(p.support);let inherited=s?s.vx:0;let wall=p.mode==="cling"?p.wall:0;
    p.vy=-(CFG.hop+(CFG.chargedHop-CFG.hop)*clamp(power,0,1));
    if(wall) {p.vx=-wall*(270+power*100);p.face=-wall;}
    else {p.vx=clamp(p.vx+inherited+inputAxis()*(35+power*50),-720,720);}
    p.grounded=false;p.support="";p.coyote=0;p.buffer=0;p.charging=false;p.charge=0;p.wall=0;p.wallLock=0.2;p.mode="air";
    p.squash=-0.32;G.hops++;profile.hops++;sound("jump");burst(p.x,p.y,COLORS.paper,7,70);
    if(profile.hops>=20) badge("hops");
}
function horizontalOverlap(p,b) {return p.x+p.w/2>b.x+1 && p.x-p.w/2<b.x+b.w-1;}
function verticalOverlap(p,b) {return p.y>b.y+1 && p.y-p.h<b.y+b.h-1;}
function stickyContact() {
    let p=G.p;
    for(let i=0;i<G.world.platforms.length;i++) {let b=G.world.platforms[i];
        if(!b.sticky || !verticalOverlap(p,b)) continue;
        if(Math.abs((p.x+p.w/2)-b.x)<4) return 1;
        if(Math.abs((p.x-p.w/2)-(b.x+b.w))<4) return -1;
    }return 0;
}
function frogStep(dt) {
    let p=G.p;let oldSupport=p.support;let wasGrounded=p.grounded;let support=findPlatform(oldSupport);
    p.invulnerable=Math.max(0,p.invulnerable-dt);p.wallLock=Math.max(0,p.wallLock-dt);
    p.coyote=p.grounded?CFG.coyote:Math.max(0,p.coyote-dt);p.buffer=Math.max(0,p.buffer-dt);
    p.squash=approach(p.squash,0,dt*2.9);
    if(support && p.grounded) {p.x+=support.dx;p.y+=support.dy;}
    p.px=p.x;p.py=p.y;
    if(keys.jump && canJump() && !p.charging) {p.charging=true;p.charge=0;}
    if(p.charging) {p.charge=clamp(p.charge+dt,0,CFG.chargeTime);if(!canJump()) {p.charging=false;p.charge=0;}}
    if(p.buffer>0 && canJump() && !keys.jump) launchJump(0);
    let ax=inputAxis();if(ax) p.face=ax;
    let maxSpeed=CFG.speed*(p.charging?0.50:1);
    if(p.grounded) p.vx=approach(p.vx,(support && support.kind==="boat"?0:ax*maxSpeed),CFG.acceleration*dt);
    else if(ax) p.vx=approach(p.vx,ax*Math.max(maxSpeed,Math.abs(p.vx)*0.985),CFG.airAcceleration*dt);
    else p.vx*=Math.max(0,1-dt*0.16);
    p.x=clamp(p.x+p.vx*dt,p.w/2,G.world.width-p.w/2);
    for(let i=0;i<G.world.platforms.length;i++) {let b=G.world.platforms[i];
        if(!b.solid || !verticalOverlap(p,b) || !horizontalOverlap(p,b)) continue;
        if(p.px+p.w/2<=b.x+3) {p.x=b.x-p.w/2;p.vx=0;}
        else if(p.px-p.w/2>=b.x+b.w-3) {p.x=b.x+b.w+p.w/2;p.vx=0;}
    }
    // Low paper layers form walkable ramps instead of visually swallowing the frog.
    // Taller furniture still requires a jump; no mid-air or backwards auto-snapping.
    if(wasGrounded && ax) {
        for(let i=0;i<G.world.platforms.length;i++){let b=G.world.platforms[i];
            if((b.kind==="paper" || b.kind==="keyboard" || (b.kind==="monitor" && !b.solid)) && horizontalOverlap(p,b) && p.y-b.y>0 && p.y-b.y<=26) {
                p.y=b.y;p.squash=-0.10;if(b.kind==="keyboard")sound("key",0.28);
            }
        }
    }
    p.wall=stickyContact();
    let cling=p.wall!==0 && p.wallLock<=0 && p.grip>0 && (keys.up || keys.down || ax===p.wall || p.mode==="cling");
    if(cling && !p.grounded) {
        p.mode="cling";p.vy=keys.up?-CFG.climbSpeed:(keys.down?CFG.climbSpeed:0);
        p.grip=Math.max(0,p.grip-dt*(keys.up?0.13:0.045));p.face=p.wall;
    } else {
        p.vy=clamp(p.vy+CFG.gravity*dt,-1050,CFG.maxFall);if(!p.grounded)p.mode="air";
        for(let i=0;i<G.world.fans.length;i++) {let f=G.world.fans[i];
            if(p.x>f.x && p.x<f.x+f.w && p.y<f.y+8 && p.y>f.y-f.h) p.vy=Math.max(-380,p.vy-f.power*dt);
        }
    }
    let oldY=p.y;let nextY=p.y+p.vy*dt;let landing=null;let landingY=Infinity;
    for(let i=0;i<G.world.platforms.length;i++) {let b=G.world.platforms[i];
        if(!horizontalOverlap(p,b)) continue;
        if(p.vy>=0 && oldY<=b.y+3 && nextY>=b.y && b.y<landingY) {landing=b;landingY=b.y;}
        if(b.solid && p.vy<0 && oldY-p.h>=b.y+b.h-2 && nextY-p.h<=b.y+b.h) {nextY=b.y+b.h+p.h;p.vy=0;}
    }
    p.grounded=false;p.support="";p.y=nextY;
    if(landing) {
        let impact=p.vy;p.y=landingY;p.vy=0;p.grounded=true;p.support=landing.id;p.mode="ground";p.grip=1;p.wall=0;
        if(!wasGrounded || oldSupport!==landing.id) landed(impact,landing);
    }
    if(G.world.water) {
        let water=G.world.water;
        if(p.x>water.x && p.x<water.x+water.w && p.y>water.y+8 && !p.grounded) {
            let entering=p.mode!=="swim" && oldY<=water.y+8;
            p.y=water.y+13+Math.sin(G.time*4)*2;p.vy=0;p.mode="swim";p.coyote=CFG.coyote;p.grip=1;
            p.vx*=0.965;
            if(entering){sound("splash");burst(p.x,water.y,"#b2e7df",12,110);tell("Swimming is not a disciplinary offence. Hop back onto the mug.",3);}
        }
    }
    if(p.y<40){p.y=40;p.vy=Math.max(0,p.vy);}
    if(!p.grounded) p.airTime+=dt;else p.airTime=0;
    if(p.y>G.world.height+40 || !finite(p.x) || !finite(p.y)) respawn("Returned by emergency paperclip. No frog left behind.");
}
function landed(impact,b) {
    let p=G.p;p.lastImpact=impact;G.lastLanding=b.id;p.squash=clamp(impact/1800,0.07,0.35);b.compression=clamp(impact/70,0,12);
    if(impact>160) burst(p.x,p.y,b.kind==="carpet"?"#8aa39b":COLORS.paper,7,impact*0.13);
    sound(b.kind==="keyboard"?"key":"land",b.kind==="keyboard"?0.47:0.34);
    if(b.kind==="mat" || b.kind==="leaf" || b.kind==="stapler") {
        if(b.kind==="mat" && G.stage===1 && G.mission.carrying==="coffee" && G.mission.matIds.indexOf(b.id)<0 && impact>100) {
            G.mission.matIds.push(b.id);tell("Soft landing "+G.mission.matIds.length+" / 2. The coffee has retained its dignity.",3);
        }
        spillCoffee(Math.max(0,impact-760)*0.015);
        if(impact>110 && !keys.down) {
            p.vy=b.kind==="stapler"?-900:(b.kind==="leaf"?-510:-470);
            p.grounded=false;p.support="";p.mode="air";p.coyote=0;p.squash=-0.35;
            burst(p.x,p.y,COLORS.yellow,11,130);sound("boing");
        }
    } else spillCoffee(Math.max(0,impact-520)*0.047+Math.max(0,Math.abs(p.vx)-380)*0.012);
    if(b.kind==="chair" && impact>300) {b.vx+=p.face*25;sound("roll");}
}
function respawn(message) {
    if(!G) return;
    let x=G.checkpoint.x,y=G.checkpoint.y;
    let chair=findPlatform("chair");
    if(G.stage===6 && chair && !G.mission.braked) {x=chair.x+chair.w/2;y=chair.y;chair.vx=0;G.mission.chairStarted=false;}
    G.p=makeFrog(x,y);G.p.invulnerable=1.4;G.tongue=makeTongue();G.respawns++;G.health=Math.max(60,G.health);
    if(G.mission.carrying==="coffee")G.mission.coffee=100;
    for(let i=0;i<G.world.targets.length;i++) {let t=G.world.targets[i];if(t.kind==="plug"&&!t.attached){t.x=t.homeX;t.y=t.homeY;t.vx=0;t.vy=0;}}
    G.score=Math.max(0,G.score-15);clearInput();G.camera.x=clamp(x-340,0,G.world.width-VW);
    G.camera.y=clamp(y-570,0,G.world.height-VH);tell(message||"Emergency paperclip. HR has seen nothing.",4);sound("croak");
}
