// Corporate Ascent. Composed in manifest order; no DOM or external game engine.
let TITLE = "Frog Employee of the Month";
let VERSION = "0.2.1";
let VW = 1100;
let VH = 650;
let STEP = 1 / 60;
let CFG = {gravity: 1480, speed: 240, acceleration: 1700, airAcceleration: 880,
    maxAirSpeed: 470, hop: 435, chargedHop: 725, chargeTime: 0.65,
    coyote: 0.12, buffer: 0.14, tongueRange: 355, tongueSpeed: 1650,
    climbSpeed: 145, maxFall: 950, frogWidth: 32, frogHeight: 28};
let JOBS = [
 {name:"Quarterly ascent", role:"Intern Frog", room:"01 / ACCOUNTS RECEIVABLE", short:"Tongue the report off the high shelf. Deliver it to APPROVED.", help:"Hold SPACE for a higher jump. Land on the stapler, ride the drawer, then hold UP against the mint glass. Hold X to tongue the outlined report.", reward:"A tiny tie", reply:"Marion, Accounts: That is the first report to arrive with its own suction cups.", perk:"tie"},
 {name:"Coffee operations", role:"Beverage Associate", room:"02 / VERY IMPORTANT MEETINGS", short:"Carry coffee across two bendy desk mats. Deliver at least 40%.", help:"E collects or refills at the coffee pot. Soft desk-mat bounces protect the cup. Hard, fast landings spill it. Two distinct mats must be used.", reward:"A lanyard with no useful keys", reply:"Graham, Strategy: A frog brought this. Still the most organised person here.", perk:"lanyard"},
 {name:"Under-desk liaison", role:"Network Amphibian", room:"03 / INFORMATION TECHNOLOGY", short:"Tongue-pull both loose plugs to their matching sockets.", help:"Hold X on a striped cable plug and walk towards its numbered socket. Press E beside the socket while the plug is close. Green cables are swing anchors.", reward:"An appropriately sized mug", reply:"IT: We tried turning it off and on. Then we tried a frog.", perk:"mug"},
 {name:"The break-room sea", role:"Marine Administrator", room:"04 / BREAK ROOM", short:"Ride the floating mug across the flood. Sign in on dry land.", help:"Jump onto the blue mug. LEFT / RIGHT paddles while aboard; X can tow it from a cable ring. Falling in is fine. You are literally a frog.", reward:"Permission to croak in meetings", reply:"Facilities: The cup is now a company vessel. Please retain all receipts.", perk:"croak"},
 {name:"Reply all, airborne", role:"Memo Retrieval Lead", room:"05 / OPEN PLAN", short:"Catch three flying memos with your tongue.", help:"Use the fan updraft and hanging cable rings. Hold X for the outlined memo. C cycles reachable targets. Paper tastes like a meeting that could have been an email.", reward:"An executive desk plant", reply:"Janice, HR: You have eaten three memos. Communication has improved.", perk:"plant"},
 {name:"Above management", role:"Presentation Specialist", room:"06 / BOARD ROOM", short:"Climb to the ceiling and tongue-pull the projector cord.", help:"The green glass is sticky. UP climbs or reels in a tongue rope. Jump from the upper monitor ledge, then hold X on the gold projector cord.", reward:"Your portrait on the employee board", reply:"The board: Ribbit. A compelling five-year strategy. Unanimously approved.", perk:"portrait"},
 {name:"Chairman of the floor", role:"Senior Frog", room:"07 / FACILITIES", short:"Ride the runaway chair, pull the red brake cord, then escape.", help:"E releases the chair brake while aboard. Stay on for two seconds, then leap for the red cord and hold X. Reach the safe desk and press E.", reward:"A reserved lily pad", reply:"Facilities: The chair has been promoted to stationary furniture.", perk:"lily"},
 {name:"Paperwork, final boss", role:"Chief Frog Officer", room:"08 / PRINT SERVICES", short:"Dodge the paper. Climb the jams. Tongue-pull all three stuck sheets.", help:"Attacks are telegraphed on the printer LCD. A flashing pink sheet is vulnerable: hold X until it tears free. Jammed pages become platforms. Toner and trays still hit airborne frogs.", reward:"Employee of the Month", reply:"The board waits for your recommendation. You say ribbit. Motion carried.", perk:"crown"}
];
let BADGES = [
 {id:"first",name:"Employed, technically"},{id:"careful",name:"Surprisingly competent"},
 {id:"finish",name:"Shift happens"},{id:"fly",name:"Working lunch"},
 {id:"hops",name:"Agile methodology"},{id:"printer",name:"Paperwork completed"},
 {id:"swing",name:"Cross-functional collaboration"},{id:"coffee",name:"No-spill deliverable"}
];
let INK = "#243d3d";
let COLORS = {green:"#80cf73",darkGreen:"#397c59",mint:"#b7ddd3",pink:"#f17e97",yellow:"#f2d16f",paper:"#fff9e8",beige:"#dcd2b4",teal:"#277b79",orange:"#df8460"};
