<Box if={screen !== "play"} className="fg-overlay">
 <Box if={screen === "welcome"} className="fg-paper">
  <Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-label">FROG RESOURCES · NEW STARTER PACK · 1999(ISH)</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-heading">YOU'RE HIRED.</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-stamp">AMPHIBIAN APPROVED</Text>
  <Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-copy">Six centimetres. A very full calendar. The office is enormous, the printer is unstable, and nobody has questioned your qualifications.</Text>
  <Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-copy">Eight assignments. Every desk is a playground. All frog abilities are yours from the first jump.</Text>
  <Box className="fg-guide"><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-guide-text">← → / A D · Waddle and steer in the air.</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-guide-text">SPACE / Z · Hold to crouch. Release to leap.</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-guide-text">X / Q · Hold tongue on the outlined target.</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-guide-text">↑ ↓ / W S · Climb green glass or reel a rope.</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-guide-text">C · Cycle targets. Click a ring to aim at it.</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-guide-text">E · Use / talk. R · Return to a paperclip.</Text></Box>
  <Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-small">A tongue cable swings; it does not teleport. Jump while attached to release with momentum. Tap jumps for small steps. Hold DOWN to settle on bouncy surfaces.</Text>
  <Box className="fg-paper-actions"><Button variant="ghost" className="fg-btn fg-primary fg-desktop-start" @click={beginGame}>{hasSave ? "Resume my shift →" : "Clock in →"}</Button><Button variant="ghost" className="fg-btn fg-primary fg-mobile-start" @click={beginMobileGame}>{hasSave ? "Resume my shift →" : "Clock in →"}</Button><Button variant="ghost" className="fg-btn" @click={toggleSound}>{settings.muted ? "Sound: off" : "Sound: on"}</Button><Button variant="ghost" className="fg-btn" @click={toggleGentle}>{settings.gentle ? "Gentle mode: on" : "Gentle mode: off"}</Button></Box>
  <Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-small">{saveStatus}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-small fg-mobile-note">Touch: hold and release HOP; hold TONGUE. Landscape gives your desk more room.</Text>
 </Box>
 <Box if={screen === "pause"} className="fg-paper"><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-label">FORM 04-B · SCHEDULED AMPHIBIAN MAINTENANCE</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-heading">TEA BREAK.</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-copy">Your tongue has been safely retracted. The machinery is paused.</Text>
  <Box className="fg-guide"><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-guide-text">Move: arrows / WASD. Jump: hold SPACE, release.</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-guide-text">Tongue: hold X. Choose target: C / click.</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-guide-text">Climb or reel: UP / DOWN. Detach: jump.</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-guide-text">Use: E. Rescue: R. Croak: F. Pause: P / Esc.</Text></Box>
  <Box className="fg-paper-actions"><Button variant="ghost" className="fg-btn fg-primary" @click={pauseGame}>Back to the desk →</Button><Button variant="ghost" className="fg-btn" @click={restartAssignment}>Restart assignment</Button><Button variant="ghost" className="fg-btn" @click={openBoard}>Employee board</Button></Box>
  <Box className="fg-paper-actions"><Button variant="ghost" className="fg-btn fg-quiet" @click={toggleGentle}>{settings.gentle ? "Gentle mode: on" : "Gentle mode: off"}</Button><Button variant="ghost" className="fg-btn fg-quiet" @click={toggleMotion}>{settings.reducedMotion ? "Reduced motion: on" : "Reduced motion: off"}</Button><Button variant="ghost" className="fg-btn fg-quiet" @click={toggleTouch}>{settings.touch ? "Touch pad: forced on" : "Touch pad: automatic"}</Button><Button variant="ghost" className="fg-btn fg-quiet" @click={toggleSound}>{settings.muted ? "Sound: off" : "Sound: on"}</Button></Box>
  <Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-small">Gentle mode reduces damage and gives longer printer-jam windows. It does not remove the frog tasks. Saves use safe paperclip checkpoints, not an airborne snapshot.</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-small">{saveStatus}</Text>
 </Box>
 <Box if={screen === "report"} className="fg-paper"><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-label">FROG RESOURCES · PERFORMANCE REVIEW</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-heading">{reportTitle}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-stamp">MEETS / EXCEEDS / RIBBIT</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-copy">{reportText}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-label">NEW WORKPLACE PRIVILEGE</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-perk">{reportReward}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-small">Your employee board has physically updated. Earlier departments stay available for leisurely frog business.</Text><Box className="fg-paper-actions"><Button variant="ghost" className="fg-btn fg-primary" @click={nextAssignment}>{G.stage === 7 ? "Visit the employee board →" : "Next department →"}</Button><Button variant="ghost" className="fg-btn" @click={openBoard}>Employee board</Button></Box></Box>
 <Box if={screen === "board"} className="fg-paper"><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-label">FROG RESOURCES · DEPARTMENT DIRECTORY</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-heading">SMALL FROG. BIG CAREER.</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-copy">{profile.done} of 8 assignments approved. {roleText}.</Text>
  <Box className="fg-departments">
 #each (job in unlockedJobs)
   <Button variant="ghost" className="fg-btn fg-dept" disabled={job.locked} @click={selectJob(job.id)}>{job.done ? "✓" : (job.locked ? "—" : "→")} {job.number}. {job.name}</Button>
  #end
</Box>
  <Box className="fg-badges">
 #each (b in earnedBadges)
 <Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-badge">{b.name}</Text>
 #end
</Box>
  <Box className="fg-paper-actions"><Button variant="ghost" className="fg-btn fg-primary" @click={pauseGame}>Return to my desk</Button><Button variant="ghost" className="fg-btn fg-quiet" @click={requestReset}>New campaign</Button></Box>
  <Box if={confirmReset}><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-copy">Start the traversal campaign again? Your badges and best score stay. Your current assignment and promotion progress will reset.</Text><Box className="fg-paper-actions"><Button variant="ghost" className="fg-btn fg-danger" @click={newCampaign}>Yes, begin orientation</Button><Button variant="ghost" className="fg-btn" @click={requestReset}>Keep this shift</Button></Box></Box><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-small">{saveStatus}</Text>
 </Box>
</Box>
