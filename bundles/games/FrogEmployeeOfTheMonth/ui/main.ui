<logic src="../logic/main.logic" />
<import World from="./world.ui" />
<import Controls from="./controls.ui" />
<style>
.fg-root{--ink:#243d3d;--paper:#fff9e8;--mint:#b7ddd3;--pink:#f17e97;--color-text:#243d3d;position:relative;color:#243d3d!important;background:#b5c8b7;height:100%;min-height:0;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;container-type:size;padding:16px;font-family:'Trebuchet MS',Arial,sans-serif;font-size:14px!important;line-height:1.45!important;box-sizing:border-box}
.fg-root *{box-sizing:border-box}.fg-shell{max-width:1360px;margin:auto}.fg-root p,.fg-root span{color:inherit}.fg-top{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 4px 12px}.fg-brand{display:flex;align-items:center;gap:10px}.fg-logo{width:46px;height:43px;object-fit:contain}.fg-kicker{display:block;font-size:10px!important;font-weight:900!important;letter-spacing:2px;line-height:1.5!important}.fg-name{display:block;font-size:22px!important;font-weight:900!important;letter-spacing:-.8px;line-height:1.1!important}.fg-tools{display:flex;align-items:center;gap:8px}.fg-id{transform:rotate(2deg);background:var(--paper);border:1.5px solid var(--ink);padding:5px 16px;box-shadow:3px 3px 0 #789383;font-size:11px!important;font-weight:900!important;max-width:180px;text-align:center}.fg-id:before{content:'';display:block;width:24px;height:3px;background:#789383;margin:auto auto 4px;border-radius:4px}.fg-btn{font-family:inherit!important;background:#fff9e8!important;border:2px solid var(--ink)!important;color:var(--ink)!important;border-radius:5px!important;min-height:42px;height:auto!important;padding:9px 16px!important;font-size:13px!important;font-weight:900!important;line-height:1.25!important;white-space:normal!important;cursor:pointer;box-shadow:0 3px 0 #718c7b!important;touch-action:manipulation;display:inline-flex!important;align-items:center;justify-content:center;gap:6px}.fg-btn:hover{background:#f2e3b9!important}.fg-btn:active{transform:translateY(2px);box-shadow:none!important}.fg-btn:focus-visible,.fg-aim:focus-visible{outline:3px solid #c44e70!important;outline-offset:3px}.fg-btn:disabled{opacity:.4;cursor:not-allowed;box-shadow:none!important}.fg-primary{background:#7ecb83!important}.fg-primary:hover{background:#9ee293!important}.fg-quiet{background:#d8e4ca!important;box-shadow:none!important;padding:6px 10px!important;font-size:11px!important}.fg-danger{background:#f2c9c4!important}.fg-game{position:relative;border:3px solid var(--ink);border-radius:8px;box-shadow:7px 9px 0 #789383;background:#d8e0c2;overflow:hidden}.fg-viewport{position:relative;width:100%;aspect-ratio:1100/650;overflow:hidden;isolation:isolate;touch-action:none;background:#d6e0c5}.fg-scene{position:absolute!important;inset:0;width:100%;height:100%;pointer-events:none;user-select:none}.fg-aim{background:transparent!important;border:0!important;padding:0!important;min-width:0!important;min-height:0!important;height:auto;box-shadow:none!important;z-index:2;cursor:crosshair;color:transparent!important;opacity:1!important}.fg-aim:focus-visible{border-radius:50%!important;background:#fff8!important}.fg-assignment{position:absolute;right:18px;top:15px;z-index:3;width:292px;padding:13px 17px;background:#f6e5a8;border:1px solid #b8a474;box-shadow:3px 4px 0 #4a736926;transform:rotate(1deg);pointer-events:none}.fg-assignment:before{content:'';position:absolute;background:#fff9da90;width:67px;height:16px;top:-7px;left:95px;transform:rotate(-4deg)}.fg-label{display:block;font-size:9px!important;letter-spacing:1.5px;font-weight:900!important;line-height:1.4!important}.fg-task-title{display:block;font-size:19px!important;font-weight:900!important;letter-spacing:-.5px;line-height:1.15!important;margin:3px 0 5px}.fg-task-copy{display:block;font-size:12px!important;line-height:1.35!important}.fg-task-count{display:block;font-size:10px!important;font-weight:900!important;letter-spacing:.3px;margin-top:8px;padding-top:6px;border-top:1px dashed #b5a575}.fg-confidence{position:absolute;left:17px;top:16px;padding:7px 12px;background:#fff9e8df;border:1px solid #749482;border-radius:2px;font-size:11px!important;font-weight:900!important;z-index:3}.fg-strip{min-height:59px;padding:9px 15px;background:#fff9e8;display:flex;align-items:center;justify-content:space-between;gap:16px;border-top:2px solid var(--ink)}.fg-message{display:block;font-size:12px!important;line-height:1.4!important;max-width:900px}.fg-hint{display:block;font-size:10px!important;color:#507768!important;line-height:1.4!important;margin-top:3px}.fg-rescue{white-space:nowrap!important;flex-shrink:0}.fg-overlay{position:absolute;inset:0;z-index:10;display:flex;align-items:center;justify-content:center;padding:20px;background:#32594b66;overflow:auto;overscroll-behavior:contain;backdrop-filter:blur(2px)}.fg-paper{background:#fff9e8;width:min(100%,680px);max-height:100%;overflow:auto;padding:27px 35px;border:2px solid var(--ink);box-shadow:8px 9px 0 #254a4266;border-radius:3px;position:relative;scrollbar-color:#88a78e #fff9e8;overscroll-behavior:contain}.fg-paper:before{content:'';display:block;width:66px;height:10px;background:#85aa95;border:2px solid #426959;border-radius:5px;margin:-14px auto 16px}.fg-heading{display:block;font-size:clamp(28px,4.1vw,54px)!important;font-weight:900!important;line-height:.98!important;letter-spacing:-2px;margin:7px 0 13px}.fg-subheading{display:block;font-size:19px!important;font-weight:900!important;line-height:1.2!important;margin:10px 0}.fg-copy{display:block;font-size:13px!important;line-height:1.5!important;margin:9px 0}.fg-small{display:block;font-size:10px!important;line-height:1.45!important;color:#537465!important;margin-top:9px}.fg-stamp{display:inline-block;color:#397c59!important;border:3px solid #397c59;transform:rotate(-5deg);font-size:15px!important;font-weight:900!important;letter-spacing:2px;padding:5px 10px;margin:4px 0 9px}.fg-perk{background:#e7efd6;border-left:5px solid #7bb680;padding:11px 15px;margin:15px 0;font-size:17px!important;font-weight:900!important;display:block}.fg-paper-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}.fg-guide{display:grid;grid-template-columns:1fr 1fr;gap:8px 20px;padding:13px 0;margin:8px 0;border-top:1px dashed #9cab8c;border-bottom:1px dashed #9cab8c}.fg-guide-text{font-size:12px!important;line-height:1.45!important;display:block}.fg-departments{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:12px 0}.fg-dept{justify-content:flex-start!important;text-align:left!important;font-size:12px!important;min-height:48px}.fg-badges{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.fg-badge{border:1px solid #80a48b;background:#edf1d9;padding:3px 7px;font-size:10px!important}.fg-touch{display:none;justify-content:space-between;align-items:center;gap:20px;padding:12px 6px 0;user-select:none;-webkit-user-select:none;touch-action:none}.fg-force-touch .fg-touch{display:flex}.fg-dpad{display:grid;grid-template-columns:51px 51px 51px;grid-template-rows:43px 43px;gap:5px}.fg-pad{touch-action:none!important;user-select:none!important;-webkit-user-select:none!important;padding:6px!important;min-height:43px!important;height:100%!important;font-size:18px!important}.fg-up{grid-column:2;grid-row:1}.fg-left{grid-column:1;grid-row:2}.fg-down{grid-column:2;grid-row:2}.fg-right{grid-column:3;grid-row:2}.fg-touch-actions{display:flex;align-items:center;gap:9px}.fg-jump{width:88px;height:88px!important;border-radius:50%!important;background:#83cd7c!important;font-size:13px!important}.fg-tongue{width:88px;height:88px!important;border-radius:50%!important;background:#efadc0!important;font-size:12px!important}.fg-use{width:54px;height:54px!important;border-radius:50%!important;background:#f2d16f!important;font-size:12px!important}.fg-footer{display:flex;justify-content:space-between;padding:13px 5px 0;font-size:10px!important;color:#416452!important;gap:10px}.fg-footer-text{font-size:10px!important}.fg-mobile-note{display:none}.fg-paused .fg-touch{opacity:.45;pointer-events:none}
@media(pointer:coarse){.fg-touch{display:flex}.fg-mobile-note{display:block}}
@media(max-width:720px){.fg-root{padding:7px}.fg-top{padding:2px 3px 9px;gap:8px}.fg-logo{width:33px;height:34px}.fg-name{font-size:16px!important;letter-spacing:-.4px}.fg-kicker{font-size:8px!important;letter-spacing:1px}.fg-id{display:none}.fg-tools{gap:5px}.fg-assignment{width:206px;right:9px;top:12px;padding:9px 12px}.fg-assignment:before{left:68px}.fg-task-title{font-size:15px!important}.fg-task-copy{font-size:10px!important}.fg-task-count{font-size:8px!important;margin-top:5px;padding-top:4px}.fg-confidence{font-size:8px!important;left:8px;top:9px;padding:4px 6px}.fg-strip{padding:8px 9px;gap:8px}.fg-message{font-size:11px!important}.fg-hint{font-size:9px!important}.fg-overlay{padding:9px}.fg-paper{padding:17px 20px}.fg-heading{font-size:34px!important}.fg-guide{gap:7px 12px;padding:8px 0}.fg-guide-text{font-size:10px!important}.fg-copy{font-size:11px!important}.fg-paper-actions{margin-top:10px;gap:8px}.fg-paper:before{margin:-6px auto 10px}.fg-touch{display:flex;padding:12px 2px 0;gap:5px}.fg-dpad{grid-template-columns:42px 42px 42px;grid-template-rows:42px 42px;gap:4px}.fg-pad{min-height:42px!important}.fg-jump,.fg-tongue{width:66px;height:66px!important;font-size:11px!important}.fg-use{width:46px;height:46px!important}.fg-touch-actions{gap:6px}.fg-footer{padding-top:10px}.fg-mobile-note{display:block}.fg-rescue{padding:6px!important;font-size:9px!important;min-height:37px!important}.fg-departments{gap:6px}.fg-dept{font-size:10px!important;padding:7px!important}}
@media(max-width:480px){.fg-brand{gap:5px}.fg-quiet{font-size:9px!important;padding:6px!important;min-height:35px!important}.fg-assignment{position:relative;top:auto;right:auto;transform:none;box-shadow:none;width:100%;border:0;border-top:1px solid #9ea88d;padding:8px 12px}.fg-assignment:before{display:none}.fg-task-copy{display:none}.fg-task-title{font-size:14px!important;margin:2px 0}.fg-task-count{border:0;margin:3px 0 0;padding:0}.fg-overlay{position:absolute;inset:8px;z-index:100;padding:14px;background:#496d58ef}.fg-paper{max-height:100%}.fg-confidence{display:none}.fg-footer-text{font-size:9px!important}.fg-guide{grid-template-columns:1fr}.fg-heading{font-size:40px!important}.fg-touch-actions{gap:5px}.fg-jump,.fg-tongue{width:61px;height:61px!important}.fg-dpad{grid-template-columns:40px 40px 40px}.fg-use{width:42px;height:42px!important}.fg-touch{gap:2px}.fg-departments{grid-template-columns:1fr}}
@media(max-height:520px) and (min-width:600px){.fg-root{padding:4px 7px}.fg-top{padding:0 3px 6px}.fg-name{font-size:14px!important}.fg-kicker{font-size:8px!important}.fg-logo{width:30px;height:30px}.fg-id{display:none}.fg-game{width:min(100%,calc((100dvh - 106px)*1.6923));margin:auto}.fg-strip{min-height:40px;padding:4px 7px}.fg-message{font-size:9px!important}.fg-hint{display:none}.fg-confidence{font-size:8px!important}.fg-assignment{width:185px;top:10px;right:10px;padding:8px 11px}.fg-task-title{font-size:13px!important}.fg-task-copy{display:none}.fg-task-count{font-size:8px!important}.fg-rescue{min-height:26px!important;font-size:8px!important;padding:4px!important}.fg-touch{position:fixed;inset:auto 10px 12px;z-index:5;pointer-events:none}.fg-touch>*{pointer-events:auto}.fg-jump,.fg-tongue{width:61px;height:61px!important}.fg-dpad{grid-template-columns:38px 38px 38px;grid-template-rows:38px 38px}.fg-pad{min-height:38px!important}.fg-use{width:42px;height:42px!important}.fg-footer{padding-top:7px}.fg-paper{padding:17px 24px}.fg-heading{font-size:30px!important}.fg-copy{font-size:11px!important}.fg-guide-text{font-size:10px!important}.fg-overlay{padding:9px}.fg-guide{padding:8px 0}.fg-paper-actions{margin-top:10px}}
@media(prefers-reduced-motion:reduce){.fg-btn{transition:none}.fg-overlay{backdrop-filter:none}}




/* MOBILE EDITION START */
/* Mobile edition: a closer camera, usable aim rings, and thumb-safe controls. */
.fg-root {padding-left:max(8px,env(safe-area-inset-left));padding-right:max(8px,env(safe-area-inset-right));padding-bottom:max(12px,env(safe-area-inset-bottom));}
.fg-root .fg-btn {min-height:44px!important;min-width:44px;}
.fg-root .fg-aim {min-width:44px!important;min-height:44px!important;transform:translate(-50%,-50%)!important;}
.fg-viewport {aspect-ratio:var(--frog-ratio,1.6923077);}
.fg-root .fg-paper {overscroll-behavior:contain;}
.fg-root .fg-copy,.fg-root .fg-guide-text {font-size:13px!important;}
@media(max-width:720px) {
 .fg-root .fg-top {flex-wrap:wrap;}
 .fg-root .fg-tools {margin-left:auto;gap:6px;}
 .fg-root .fg-quiet {font-size:11px!important;}
 .fg-root .fg-dpad {grid-template-columns:repeat(3,44px);grid-template-rows:repeat(2,48px);gap:4px;}
 .fg-root .fg-touch {gap:8px;align-items:center;}
 .fg-root .fg-touch-actions {display:grid;grid-template-columns:48px 62px;gap:6px;}
 .fg-root .fg-use {width:48px;height:44px!important;grid-column:1;grid-row:1;}
 .fg-root .fg-tongue {width:62px;height:62px!important;grid-column:2;grid-row:1/3;}
 .fg-root .fg-jump {width:48px;height:44px!important;grid-column:1;grid-row:2;}
 .fg-root .fg-message {font-size:12px!important;}
 .fg-root .fg-footer {flex-wrap:wrap;}
 .fg-root .fg-task-copy {display:block;font-size:12px!important;}
 .fg-root .fg-assignment {position:relative;inset:auto;transform:none;box-shadow:none;width:100%;border:0;border-top:1px solid #9ea88d;padding:8px 12px;}
 .fg-root .fg-assignment:before {display:none;}
 .fg-root .fg-task-count {font-size:10px!important;}
 .fg-root .fg-overlay {position:absolute;inset:max(8px,env(safe-area-inset-top)) 8px max(8px,env(safe-area-inset-bottom));z-index:100;}
 .fg-root .fg-paper {max-height:100%;}
}
@media(max-height:520px) and (min-width:600px) {
 .fg-root {overflow:hidden;padding:4px 7px;}
 .fg-root .fg-shell {position:relative;padding:0 136px;height:100%;display:flex;flex-direction:column;min-height:0;}
 .fg-root .fg-top {padding:0 3px 4px;flex:0 0 auto;}
 .fg-root .fg-game {width:100%;flex:1 1 0;min-height:0;display:flex;flex-direction:column;}
 .fg-root .fg-viewport {height:auto;max-height:none;flex:1 1 0;min-height:0;aspect-ratio:auto;}
 .fg-root .fg-assignment,.fg-root .fg-footer,.fg-root .fg-confidence {display:none;}
 .fg-root .fg-touch {position:absolute;inset:54px max(8px,env(safe-area-inset-right)) 8px max(8px,env(safe-area-inset-left));padding:0;align-items:center;}
 .fg-root .fg-dpad {grid-template-columns:repeat(3,44px);grid-template-rows:repeat(2,44px);gap:2px;}
 .fg-root .fg-touch-actions {width:120px;display:flex;flex-wrap:wrap;justify-content:center;gap:6px;}
 .fg-root .fg-use {width:110px;height:44px!important;}
 .fg-root .fg-tongue,.fg-root .fg-jump {width:54px;height:54px!important;}
 .fg-root .fg-overlay {position:absolute;inset:8px;z-index:100;}
 .fg-root .fg-paper {max-height:100%;}
}
@media(min-width:721px) and (min-height:521px) {
 .fg-root {overflow:hidden;display:flex;flex-direction:column;padding:10px 16px 8px;}
 .fg-root .fg-shell {width:100%;height:100%;display:flex;flex-direction:column;min-height:0;margin:0 auto;}
 .fg-root .fg-top {padding:0 4px 8px;flex:0 0 auto;}
 .fg-root .fg-game {width:min(100cqw,calc((100cqh - 172px) * var(--frog-ratio,1.6923)));margin:auto;flex:0 0 auto;}
 .fg-root .fg-footer {padding:8px 5px 0;margin-top:auto;}
}
.fg-mobile-start{display:none!important}@media(max-width:720px) and (orientation:portrait){.fg-mobile-start{display:inline-flex!important}.fg-desktop-start{display:none!important}}

/* MOBILE EDITION END */
</style>
<Box style={{"--frog-ratio":VW / VH}} className={"fg-root" + (settings.touch ? " fg-force-touch" : "") + (screen !== "play" ? " fg-paused" : "")}><Box className="fg-shell">
 <Loop frame running={screen === "play"} @tick={tick} />
 <Box className="fg-top"><Box className="fg-brand"><Image loading="eager" className="fg-logo" src={asset("assets/icon.svg")} width={46} height={43} showPlaceholder={false} alt="Frog staff badge" /><Box><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-kicker">EMPLOYEE OF THE MONTH</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-name">FROG RESOURCES</Text></Box></Box><Box className="fg-tools"><Button variant="ghost" className="fg-btn fg-quiet" ariaLabel="Switch between close and wide camera" @click={toggleCamera}>{VW === 660 ? "Wide view" : "Close view"}</Button><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-id">{roleText}</Text><Button if={screen === "play" || screen === "pause"} variant="ghost" className="fg-btn fg-quiet" @click={pauseGame}>{screen === "play" ? "Tea break Ⅱ" : "Resume ▷"}</Button><Button variant="ghost" className="fg-btn fg-quiet" @click={toggleSound}>{settings.muted ? "Sound off" : "Sound on"}</Button></Box></Box>
 <World /><Controls />
 <Box className="fg-footer"><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-footer-text">SOFTN · CORPORATE ASCENT / v0.2.2</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-footer-text">No frog left behind. R = emergency paperclip.</Text></Box>
</Box></Box>