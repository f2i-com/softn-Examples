<import Screens from="./screens.ui" />
<Box className="fg-game">
 <Box className="fg-viewport">
  <Box style={backgroundStyle}><Image src={backgroundSource} width="100%" height="100%" objectFit="fill" loading="eager" showPlaceholder={false} alt="A giant office seen from frog height" /></Box>
  <Image className="fg-scene" src={sceneSource} width="100%" height="100%" objectFit="fill" loading="eager" showPlaceholder={false} alt="Frog, moving office machinery and tongue targets" />
  <Box if={screen === "play"}>
   #each (aim in targetHitboxes)
   <Button variant="ghost" className="fg-aim" style={aim.style} ariaLabel={aim.label} @click={chooseTarget(aim.id)} />
   #end
   <Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-confidence">CONFIDENCE {Math.ceil(G.health)}% · {G.stage + 1} / 8</Text>
  </Box>
 </Box>
 <Box if={screen === "play"} className="fg-assignment"><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-label">INTERNAL MEMO · TO: THE FROG</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-task-title">{missionTitle}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-task-copy">{missionText}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-task-count">{taskCounter}</Text></Box>
 <Box className="fg-strip"><Box><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-message">{notice}</Text><Text style={{color:"inherit",fontSize:"inherit",fontWeight:"inherit",lineHeight:"inherit"}} className="fg-hint">{contextHint}</Text></Box><Button if={screen === "play"} variant="ghost" className="fg-btn fg-quiet fg-rescue" @click={rescueButton}>Paperclip ↺</Button></Box>
 <Screens />
</Box>
