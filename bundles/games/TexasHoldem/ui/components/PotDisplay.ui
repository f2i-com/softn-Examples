// PotDisplay.ui - Pot amount and hero live hand-rank pill in center of table

<Box if={pot > 0 || gamePhase !== "waiting"} style={{
  display: "flex",
  flexDirection: "column",
  alignItems: "center",
  gap: "4px"
}}>
  <Box style={{
    background: "linear-gradient(180deg, rgba(15,23,42,0.76), rgba(2,6,23,0.86))",
    borderRadius: "16px",
    padding: "6px 16px",
    backdropFilter: "blur(8px)",
    border: "1px solid rgba(200,170,110,0.32)",
    boxShadow: "0 6px 20px rgba(0,0,0,0.25), inset 0 1px 0 rgba(255,255,255,0.06)",
    animation: potAnim()
  }}>
    <Text style={{ color: "#fbbf24", fontSize: "clamp(14px, 2.2vw, 17px)", fontWeight: "bold", letterSpacing: "0.4px", whiteSpace: "nowrap" }}>
      {"Pot: $" + pot}
    </Text>
  </Box>
  <Box if={heroHandPill()} style={{
    background: "rgba(200,170,110,0.16)",
    border: "1px solid rgba(200,170,110,0.36)",
    borderRadius: "999px",
    padding: "2px 10px",
    backdropFilter: "blur(6px)"
  }}>
    <Text style={{ color: "#f3e3be", fontSize: "10px", fontWeight: "700", letterSpacing: "0.3px", whiteSpace: "nowrap" }}>
      {heroHandPill()}
    </Text>
  </Box>
</Box>
