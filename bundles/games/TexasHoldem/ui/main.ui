// main.ui - Texas Hold'em Poker
// Multiplayer poker with P2P sync via Yjs + WebRTC

<logic src="../logic/main.logic" />

// Import pages FIRST (so their content is in the source before component replacements)
<import Lobby from="./pages/Lobby.ui" />
<import Table from="./pages/Table.ui" />

// Import attribute-less components AFTER pages (these get inlined into page content)
<import CommunityCards from="./components/CommunityCards.ui" />
<import ActionPanel from="./components/ActionPanel.ui" />
<import PotDisplay from="./components/PotDisplay.ui" />

// Import modals
<import SyncModal from="./modals/SyncModal.ui" />
<import ResultsModal from="./modals/ResultsModal.ui" />
<import LeaveModal from="./modals/LeaveModal.ui" />

<data>
  <collection name="poker_table" as="pokerTable" />
  <collection name="poker_players" as="pokerPlayers" />
  <collection name="poker_actions" as="pokerActions" limit={20} sort="timestamp:desc" />
</data>

<style>
@keyframes card-deal {
  from { opacity: 0; transform: translateY(-20px) scale(0.8); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes hole-deal {
  0% { opacity: 0; transform: translateY(-120px) scale(0.78) rotate(-8deg); filter: blur(0.6px); }
  65% { opacity: 1; transform: translateY(2px) scale(1.03) rotate(1deg); filter: blur(0); }
  100% { opacity: 1; transform: translateY(0) scale(1) rotate(0deg); filter: blur(0); }
}

@keyframes pulse-glow {
  0%, 100% { box-shadow: 0 0 0 0 rgba(200, 170, 110, 0); }
  50% { box-shadow: 0 0 20px 4px rgba(200, 170, 110, 0.3); }
}

@keyframes chip-slide {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes board-reveal {
  0% { opacity: 0; transform: translateY(-14px) rotate(-8deg) scale(0.86); }
  70% { opacity: 1; transform: translateY(1px) rotate(2deg) scale(1.02); }
  100% { opacity: 1; transform: translateY(0) rotate(0deg) scale(1); }
}

@keyframes flop-reveal {
  0% { opacity: 0; transform: translateY(-26px) scale(0.86) rotate(-7deg); filter: blur(0.8px); }
  70% { opacity: 1; transform: translateY(2px) scale(1.03) rotate(1deg); filter: blur(0); }
  100% { opacity: 1; transform: translateY(0) scale(1) rotate(0deg); filter: blur(0); }
}

@keyframes turn-reveal {
  0% { opacity: 0; transform: translateX(-20px) translateY(-14px) scale(0.9) rotate(-4deg); }
  75% { opacity: 1; transform: translateX(0) translateY(1px) scale(1.02) rotate(0.5deg); }
  100% { opacity: 1; transform: translateX(0) translateY(0) scale(1) rotate(0deg); }
}

@keyframes river-reveal {
  0% { opacity: 0; transform: translateX(20px) translateY(-14px) scale(0.9) rotate(4deg); }
  75% { opacity: 1; transform: translateX(0) translateY(1px) scale(1.02) rotate(-0.5deg); }
  100% { opacity: 1; transform: translateX(0) translateY(0) scale(1) rotate(0deg); }
}

@keyframes chip-bet-pop {
  0% { transform: translateY(10px) scale(0.86); opacity: 0; }
  70% { transform: translateY(-1px) scale(1.04); opacity: 1; }
  100% { transform: translateY(0) scale(1); opacity: 1; }
}

@keyframes pot-pulse {
  0% { transform: translateY(4px) scale(0.92); filter: brightness(1); }
  55% { transform: translateY(-1px) scale(1.05); filter: brightness(1.12); }
  100% { transform: translateY(0) scale(1); filter: brightness(1); }
}

::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(200, 170, 110, 0.2); border-radius: 4px; }
::selection { background: rgba(200, 170, 110, 0.25); }

button, [role="button"] {
  transition: all 180ms ease !important;
}
button:hover, [role="button"]:hover {
  filter: brightness(1.1);
}
button:active, [role="button"]:active {
  transform: scale(0.97) !important;
}

@media (max-height: 500px) {
  /* Top bar: compact single line */
  .poker-topbar {
    padding: 3px 8px !important;
    flex-wrap: nowrap !important;
    gap: 6px !important;
  }
  .poker-topbar-center {
    flex-direction: row !important;
    gap: 8px !important;
    padding: 2px 10px !important;
  }
  /* Hide non-essential top bar items */
  .poker-topbar-hide-mobile {
    display: none !important;
  }

  .poker-stage {
    padding: 2px 14px 4px !important;
  }

  /* Felt table: fit comfortably in landscape alongside bottom dock */
  .poker-felt {
    min-height: 90px !important;
    max-height: 100% !important;
    width: min(88vw, 760px) !important;
    border-width: 6px !important;
  }

  /* Seats: more compact */
  .poker-seat-occupied {
    width: 70px !important;
    height: 86px !important;
    padding-bottom: 30px !important;
  }
  .poker-seat-empty {
    width: 68px !important;
  }
  .poker-seat-avatar {
    width: 28px !important;
    height: 28px !important;
    min-width: 28px !important;
    min-height: 28px !important;
  }
  .poker-seat-card {
    width: 20px !important;
    height: 28px !important;
  }
  .poker-seat-cards {
    min-height: 30px !important;
  }

  /* Action panel: compact landscape layout */
  .poker-bottom-dock {
    padding: 0 6px 3px !important;
    gap: 2px !important;
  }
  .poker-action-panel {
    padding: 2px 8px !important;
    gap: 5px !important;
    flex-wrap: nowrap !important;
  }
  .poker-action-panel button {
    min-height: 30px !important;
    padding: 3px 10px !important;
    font-size: 12px !important;
  }
  .poker-action-primary {
    flex: 0 1 auto !important;
    flex-wrap: nowrap !important;
    min-width: 0 !important;
  }
  .poker-action-info {
    display: none !important;
  }
  .poker-action-raise-detail {
    display: none !important;
  }
  .poker-action-raise-label {
    display: none !important;
  }
  .poker-action-mycards {
    display: flex !important;
  }
  .poker-action-raise {
    flex: 1 1 240px !important;
    min-width: 200px !important;
    gap: 2px !important;
  }
  .poker-action-presets button {
    min-height: 26px !important;
    padding: 2px 6px !important;
  }
}

@media (pointer: coarse) and (max-height: 500px) {
  .poker-table-root {
    padding-bottom: 6px !important;
    box-sizing: border-box !important;
  }
}

@media (max-width: 680px) {
  .poker-topbar {
    padding: 6px 10px !important;
    gap: 6px !important;
    flex-wrap: wrap !important;
  }
  .poker-topbar-left {
    order: 1 !important;
    flex: 1 1 auto !important;
    min-width: 0 !important;
  }
  .poker-topbar-right {
    order: 2 !important;
    flex: 0 0 auto !important;
  }
  .poker-topbar-center {
    order: 3 !important;
    flex: 1 0 100% !important;
    max-width: 100% !important;
    flex-direction: row !important;
    justify-content: center !important;
    gap: 8px !important;
    padding: 4px 10px !important;
  }
  .poker-topbar-hide-mobile {
    display: none !important;
  }
  .poker-stage {
    padding: 24px 16px 26px !important;
  }
  .poker-felt {
    width: min(92vw, 460px) !important;
    height: 100% !important;
    max-height: 390px !important;
    min-height: 200px !important;
    border-width: 7px !important;
    border-radius: 104px !important;
  }
  .poker-seat-occupied {
    width: 74px !important;
    height: 108px !important;
    padding: 4px 4px 40px 4px !important;
  }
  .poker-seat-empty {
    width: 68px !important;
  }
  .poker-seat-avatar {
    width: 32px !important;
    height: 32px !important;
    min-width: 32px !important;
    min-height: 32px !important;
  }
  .poker-seat-card {
    width: 22px !important;
    height: 32px !important;
  }
  .poker-seat-cards {
    min-height: 34px !important;
  }
  .poker-bottom-dock {
    padding: 2px 6px max(8px, env(safe-area-inset-bottom)) !important;
  }
  .poker-action-panel {
    padding: 8px 10px !important;
    gap: 7px !important;
  }
  .poker-action-primary {
    flex: 1 0 100% !important;
  }
  .poker-action-info {
    display: none !important;
  }
  .poker-action-mycards {
    display: flex !important;
  }
  .poker-action-raise {
    flex: 1 0 100% !important;
    min-width: 0 !important;
  }
  .poker-action-raise-label {
    display: none !important;
  }
  .poker-action-raise-detail {
    display: none !important;
  }
}

@media (pointer: coarse) {
  .poker-action-panel button, .poker-topbar button, .poker-host-controls button {
    min-height: 36px;
  }
}
</style>

<Loop interval={pollIntervalMs()} running={currentPage === "table"} @tick={pollGameState} />

<App theme="dark">
  <Box style={{ width: "100%", height: "100%", overflow: "hidden", background: "#0d1b0e" }}>
    <Lobby />
    <Table />
  </Box>
  <SyncModal />
  <ResultsModal />
  <LeaveModal />
  <Toast if={toastMessage} message={toastMessage} type={toastType} />
  <Box if={authorityResumeError} style={{ position: "fixed", left: "50%", bottom: "16px", transform: "translateX(-50%)", zIndex: 40, display: "flex", alignItems: "center", gap: "12px", padding: "10px 14px", background: "#1f2937", color: "#f9fafb", border: "1px solid #f59e0b", borderRadius: "8px", maxWidth: "min(92vw, 640px)", fontSize: "13px" }}>
    <Text>{authorityResumeError}</Text>
    <Button variant="ghost" @click={retryResume} style={{ padding: "6px 12px", color: "#fbbf24", border: "1px solid #f59e0b", borderRadius: "6px", whiteSpace: "nowrap" }}>Try now</Button>
  </Box>
</App>
