// Lobby.ui - Quick Play vs Bots, Create/Join Peer Room, or Online Server Table

<Box if={currentPage === "lobby"} className="poker-lobby-root" style={{
  display: "flex",
  flexDirection: "column",
  alignItems: "center",
  justifyContent: "safe center",
  width: "100%",
  height: "100%",
  boxSizing: "border-box",
  overflowX: "hidden",
  overflowY: "auto",
  background: "linear-gradient(180deg, #0d1b0e 0%, #1a2e1a 50%, #0d1b0e 100%)",
  padding: "clamp(10px, 2vh, 20px) 12px max(12px, env(safe-area-inset-bottom))"
}}>
  // Title
  <Box style={{ textAlign: "center", marginBottom: "clamp(8px, 1.5vh, 14px)", width: "100%" }}>
    <Text style={{ display: "block", color: "#c8aa6e", fontSize: "clamp(24px, 4.2vw, 34px)", fontWeight: "bold", fontFamily: "Georgia, serif", letterSpacing: "2px", lineHeight: 1.15 }}>
      Texas Hold'em
    </Text>
    <Text style={{ display: "block", color: "rgba(255,255,255,0.48)", fontSize: "11px", marginTop: "3px", letterSpacing: "2.5px", textTransform: "uppercase" }}>
      Solo vs Bots · Peer P2P · Online Server
    </Text>
  </Box>

  // Main card
  <Card padding=md style={{
    background: "rgba(255,255,255,0.04)",
    border: "1px solid rgba(200,170,110,0.18)",
    borderRadius: "16px",
    width: "100%",
    maxWidth: "560px",
    boxSizing: "border-box",
    backdropFilter: "blur(12px)"
  }}>
    <Stack direction=vertical gap=sm>
      // 1-Click Hero CTA: Quick Play vs Bots
      <Box style={{
        background: "linear-gradient(135deg, rgba(200,170,110,0.14), rgba(34,197,94,0.08))",
        border: "1px solid rgba(200,170,110,0.32)",
        borderRadius: "12px",
        padding: "10px 12px",
        boxSizing: "border-box"
      }}>
        <Button @click={quickPlayBots} style={{
          width: "100%",
          background: "linear-gradient(135deg, #c8aa6e, #a08040)",
          color: "#1c1917",
          border: "none",
          borderRadius: "9px",
          padding: "11px 16px",
          fontSize: "15px",
          fontWeight: "800",
          cursor: "pointer",
          letterSpacing: "0.4px",
          boxShadow: "0 4px 16px rgba(200,170,110,0.28)"
        }}>
          Quick Play vs Bots
        </Button>
        <Text style={{ display: "block", color: "rgba(255,255,255,0.56)", fontSize: "11px", textAlign: "center", marginTop: "5px" }}>
          Instant 4-handed table with 3 AI bots · $1,000 starting stack · deals immediately
        </Text>
      </Box>

      // Player name (always shown)
      <Box style={{ display: "flex", alignItems: "center", gap: "10px", flexWrap: "wrap", paddingTop: "2px" }}>
        <Text style={{ color: "rgba(255,255,255,0.65)", fontSize: "11px", fontWeight: "700", textTransform: "uppercase", letterSpacing: "1px", flexShrink: 0 }}>
          Your Name
        </Text>
        <Input
          :bind={playerName}
          placeholder="Player (optional for Quick Play)"
          style={{
            flex: "1 1 180px",
            minWidth: 0,
            boxSizing: "border-box",
            background: "rgba(255,255,255,0.06)",
            border: "1px solid rgba(200,170,110,0.2)",
            borderRadius: "9px",
            padding: "9px 12px",
            color: "#fff",
            fontSize: "14px"
          }}
        />
      </Box>

      // ── External room: show pre-set room + join button ──
      <Box if={hasExternalRoom}>
        <Stack direction=vertical gap=sm>
          <Box style={{
            background: "rgba(200,170,110,0.08)",
            border: "1px solid rgba(200,170,110,0.2)",
            borderRadius: "10px",
            padding: "10px 14px",
            textAlign: "center"
          }}>
            <Text style={{ color: "rgba(255,255,255,0.5)", fontSize: "10px", fontWeight: "600", textTransform: "uppercase", letterSpacing: "1.5px", marginBottom: "4px" }}>
              Invited Room Code
            </Text>
            <Text style={{ color: "#c8aa6e", fontSize: "19px", fontWeight: "bold", fontFamily: "monospace", letterSpacing: "2px" }}>
              {syncRoom}
            </Text>
          </Box>

          <Button @click={joinRoom} style={{
            width: "100%",
            background: "rgba(200,170,110,0.2)",
            color: "#f3e3be",
            border: "1px solid rgba(200,170,110,0.4)",
            borderRadius: "9px",
            padding: "11px",
            fontSize: "14px",
            fontWeight: "700",
            cursor: "pointer"
          }}>
            Join Invited Room
          </Button>

          <Button @click={clearExternalRoom} style={{
            width: "100%",
            background: "rgba(255,255,255,0.04)",
            color: "rgba(255,255,255,0.55)",
            border: "1px solid rgba(255,255,255,0.1)",
            borderRadius: "9px",
            padding: "9px",
            fontSize: "12px",
            fontWeight: "500",
            cursor: "pointer"
          }}>
            Create or Join a Different Room
          </Button>
        </Stack>
      </Box>

      // ── Normal lobby: 2-column responsive layout for Peer Room & Online Server ──
      <Box if={!hasExternalRoom} style={{
        display: "flex",
        flexWrap: "wrap",
        gap: "10px",
        alignItems: "stretch",
        width: "100%",
        marginTop: "2px"
      }}>
        // Left Column: Peer Table (P2P Sync)
        <Box style={{
          flex: "1 1 225px",
          minWidth: 0,
          boxSizing: "border-box",
          background: "rgba(0,0,0,0.22)",
          border: "1px solid rgba(255,255,255,0.08)",
          borderRadius: "12px",
          padding: "11px",
          display: "flex",
          flexDirection: "column",
          gap: "8px"
        }}>
          <Box>
            <Text style={{ display: "block", color: "#e5e7eb", fontSize: "12px", fontWeight: "700", textTransform: "uppercase", letterSpacing: "0.8px" }}>
              Peer Room (Friends)
            </Text>
            <Text style={{ display: "block", color: "rgba(255,255,255,0.42)", fontSize: "11px", lineHeight: 1.35, marginTop: "2px" }}>
              WebRTC room for friends or custom bot seats.
            </Text>
          </Box>

          <Button @click={createRoom} style={{
            width: "100%",
            background: "rgba(200,170,110,0.18)",
            color: "#e6cf9c",
            border: "1px solid rgba(200,170,110,0.34)",
            borderRadius: "8px",
            padding: "9px 12px",
            fontSize: "13px",
            fontWeight: "700",
            cursor: "pointer"
          }}>
            Create Room
          </Button>

          <Box style={{ display: "flex", gap: "6px", width: "100%", marginTop: "auto" }}>
            <Input
              :bind={syncRoom}
              placeholder="poker-x9km2p"
              style={{
                flex: "1 1 0",
                minWidth: 0,
                boxSizing: "border-box",
                background: "rgba(255,255,255,0.06)",
                border: "1px solid rgba(200,170,110,0.2)",
                borderRadius: "8px",
                padding: "8px 10px",
                color: "#fff",
                fontSize: "13px",
                fontFamily: "monospace"
              }}
            />
            <Button @click={joinRoom} style={{
              background: "rgba(200,170,110,0.14)",
              color: "#c8aa6e",
              border: "1px solid rgba(200,170,110,0.3)",
              borderRadius: "8px",
              padding: "8px 13px",
              fontSize: "13px",
              fontWeight: "600",
              cursor: "pointer",
              flexShrink: 0
            }}>
              Join
            </Button>
          </Box>
        </Box>

        // Right Column: Online Table (Authority Server)
        <Box style={{
          flex: "1 1 225px",
          minWidth: 0,
          boxSizing: "border-box",
          background: "rgba(0,0,0,0.22)",
          border: "1px solid rgba(255,255,255,0.08)",
          borderRadius: "12px",
          padding: "11px",
          display: "flex",
          flexDirection: "column",
          gap: "8px"
        }}>
          <Box>
            <Text style={{ display: "block", color: "#e5e7eb", fontSize: "12px", fontWeight: "700", textTransform: "uppercase", letterSpacing: "0.8px" }}>
              Online Table (Server)
            </Text>
            <Text style={{ display: "block", color: "rgba(255,255,255,0.42)", fontSize: "11px", lineHeight: 1.35, marginTop: "2px" }}>
              Deck & cards stay private on softn-server.
            </Text>
          </Box>

          <Input
            :bind={authorityUrl}
            placeholder="http://localhost:9877"
            style={{
              width: "100%",
              boxSizing: "border-box",
              background: "rgba(255,255,255,0.06)",
              border: "1px solid rgba(200,170,110,0.2)",
              borderRadius: "8px",
              padding: "7px 10px",
              color: "#fff",
              fontSize: "12px",
              fontFamily: "monospace"
            }}
          />

          <Button @click={createOnlineTable} style={{
            width: "100%",
            background: "rgba(200,170,110,0.14)",
            color: "#c8aa6e",
            border: "1px solid rgba(200,170,110,0.3)",
            borderRadius: "8px",
            padding: "8px 12px",
            fontSize: "13px",
            fontWeight: "600",
            cursor: "pointer"
          }}>
            Create Online Table
          </Button>

          <Box style={{ display: "flex", gap: "6px", width: "100%" }}>
            <Input
              :bind={authorityJoinCode}
              placeholder="t-k3m9pq"
              style={{
                flex: "1 1 0",
                minWidth: 0,
                boxSizing: "border-box",
                background: "rgba(255,255,255,0.06)",
                border: "1px solid rgba(200,170,110,0.2)",
                borderRadius: "8px",
                padding: "8px 10px",
                color: "#fff",
                fontSize: "13px",
                fontFamily: "monospace"
              }}
            />
            <Button @click={joinOnlineTable} style={{
              background: "rgba(200,170,110,0.14)",
              color: "#c8aa6e",
              border: "1px solid rgba(200,170,110,0.3)",
              borderRadius: "8px",
              padding: "8px 13px",
              fontSize: "13px",
              fontWeight: "600",
              cursor: "pointer",
              flexShrink: 0
            }}>
              Join
            </Button>
          </Box>
        </Box>
      </Box>
    </Stack>
  </Card>
</Box>
