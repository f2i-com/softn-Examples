<Box if={overlay !== "" || paused} className="modal-backdrop">
 <Box className={overlay === "map" ? "modal modal-map" : "modal"}>
  <Box if={overlay === "welcome"}>
   <Box className="welcome-seal"><Image loading="eager" src={asset("assets/icon.svg")} width="86px" height="86px" alt="Employee identification" /><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="stamp-text">{"EMPLOYMENT\nCONFIRMED"}</Text></Box>
   <Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="eyebrow">LITTLEBOROUGH / PERSONNEL DEPARTMENT</Text>
   <Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="modal-title">{"You are a pigeon.\nYou have a job."}</Text>
   <Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="modal-copy">Neither fact concerns management. Take a stroll. Try a little flight. The paperwork can wait until you have enjoyed being a bird.</Text>
   <Box className="quick-controls"><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}}><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="key">WASD</Text> Waddle</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}}><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="key">F</Text> Fly / land</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}}><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="key">SPACE</Text> Hop</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}}><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="key">E</Text> Peck / use</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}}><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="key">C</Text> Grab / drop</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}}><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="key">Q</Text> Coo, naturally</Text></Box>
   <Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="modal-copy small-copy">For a report: collect a form, do the fieldwork, place it on the office clipboard, peck all three boxes, pick it up, hop onto the red stamp press, and return it to council.</Text>
   <Button variant="ghost" className="big-button" @click={beginPlay}>{S.time > 1 ? "Resume gainful employment →" : "Begin gainful employment →"}</Button>
   <Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="fine-print">Keyboard or touch · Local saves · No deadlines · No bird injuries</Text>
  </Box>
  <Box if={paused || overlay === "settings"}>
   <Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="eyebrow">TEA BREAK APPROVED</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="modal-title">The borough can wait.</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="modal-copy">Flight, traffic, gusts and paperwork are paused. Your tea is not billable.</Text>
   <Button variant="ghost" className="big-button" @click={closeOverlay}>Back to the borough →</Button>
   <Box className="settings-grid"><Button variant="ghost" className="setting" @click={toggleSound}>{settings.muted ? "Sound: off" : "Sound: on"}</Button><Button variant="ghost" className="setting" @click={toggleMotion}>{settings.reducedMotion ? "Reduced motion: on" : "Reduced motion: off"}</Button><Button variant="ghost" className="setting" @click={toggleAssist}>{settings.assist ? "Target marker: on" : "Target marker: off"}</Button><Button variant="ghost" className="setting" @click={toggleGentle}>{settings.gentle ? "Gentle wings & wind: on" : "Gentle wings & wind: off"}</Button></Box>
   <Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="modal-copy small-copy">F toggles flight. Space hops. Shift swoops. E pecks or operates nearby objects. C grabs, exchanges or drops lightweight items. R photographs nearby evidence. Q coos. M opens the map. J opens field notes.</Text>
   <Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="modal-copy small-copy">Land to perch on benches, roofs, the statue or a bus. A hop onto the stamp press only works with a checked report in your beak. The forms rack replaces a lost report without removing valid checks.</Text>
   <Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="fine-print">{saveStatus}</Text><Button variant="ghost" className="danger-link" @click={requestReset}>Start a new career</Button>
   <Box if={confirmReset} className="reset-confirm"><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}}>Replace this career? Earned distinctions are kept.</Text><Button variant="ghost" className="setting" @click={confirmNew}>Replace career</Button><Button variant="ghost" className="setting" @click={requestReset}>Keep this career</Button></Box>
  </Box>
  <Box if={overlay === "map"}>
   <Box className="modal-heading"><Box><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="eyebrow">OFFICIAL BOROUGH PLAN</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="modal-title compact">Know your jurisdiction.</Text></Box><Button variant="ghost" className="tool" @click={closeOverlay}>Close</Button></Box>
   <Box className="town-map"><Image loading="eager" src={asset("assets/art/town.svg")} width="100%" height="100%" alt="Map of Littleborough" />
    <Text className="map-label" style={{left:"20%",top:"22%"}}>{"COUNCIL\nForms / stamps / returns"}</Text><Text className="map-label" style={{left:"77%",top:"25%"}}>DUCK GARDENS</Text><Text className="map-label" style={{left:"49%",top:"46%"}}>FOUNTAIN</Text><Text className="map-label" style={{left:"80%",top:"52%"}}>{"ARCHIVE\nRoof + window"}</Text><Text className="map-label" style={{left:"21%",top:"89%"}}>BAKERY / AWNING</Text><Text className="map-label" style={{left:"85%",top:"89%"}}>WORKS / SOFA</Text><Text className="map-label" style={{left:"32%",top:"64%"}}>PARKING</Text><Text className="map-label" style={{left:"65%",top:"43%"}}>COMMITTEE</Text>
    #each (dot in mapDots)
     <Box className={dot.id === "you" ? "map-dot you" : "map-dot goal"} style={dot.style}><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}}>{dot.label}</Text></Box>
    #end
   </Box><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="modal-copy small-copy">{hud.objective}</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="fine-print">The map is a map, not a teleportation permit. It pauses the borough.</Text>
  </Box>
  <Box if={overlay === "journal"}>
   <Box className="modal-heading"><Box><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="eyebrow">{hud.form}</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="modal-title compact">Field notes.</Text></Box><Button variant="ghost" className="tool" @click={closeOverlay}>Close</Button></Box>
   #each (row in journalRows)
    <Box className={row.done ? "note-row complete" : "note-row"}><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="note-check">{row.done ? "✓" : "□"}</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}}>{row.text}</Text></Box>
   #end
   <Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="section-title">DUCKUMENTARY EVIDENCE</Text>
   #each (e in evidenceRows)
    <Box className={e.found ? "evidence-card found" : "evidence-card"}><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="evidence-title">{(e.found ? "✓ " : "○ ") + e.title}</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="evidence-source">{e.source}</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="small-copy">{e.text}</Text></Box>
   #end
   <Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="section-title">CIVIC DISTINCTIONS</Text><Box className="badge-grid">
   #each (b in badgeRows)
    <Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className={b.earned ? "badge earned" : "badge"}>{(b.earned ? "✓ " : "○ ") + b.name}</Text>
   #end
   </Box><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="fine-print">Field notes are read-only. Actual certification happens on the office clipboard.</Text>
  </Box>
  <Box if={overlay === "ending"}>
   <Image loading="eager" src={asset("assets/icon.svg")} width="86px" height="86px" alt="Mayoral seal" /><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="eyebrow">RETURNING OFFICER'S DECLARATION</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="modal-title">{S.ending}</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="modal-copy">{S.endingBody}</Text><Button variant="ghost" className="big-button" @click={closeOverlay}>Continue being a pigeon →</Button><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="fine-print">Campaign complete. Free-roam remains open, and your distinctions are saved.</Text>
  </Box>
 </Box>
</Box>
