<Box className="civic-header">
 <Box className="brand"><Image loading="eager" src={asset("assets/icon.svg")} width="42px" height="42px" alt="Municipal pigeon seal" /><Box><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="eyebrow">BOROUGH OF LITTLEBOROUGH</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="brand-title">Pigeon: Municipal Employee</Text></Box></Box>
 <Box className="header-tools"><Button variant="ghost" className="tool" ariaLabel="Town map, M" @click={showOverlay("map")}>Map <Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="key">M</Text></Button><Button variant="ghost" className="tool" ariaLabel="Field notes and evidence, J" @click={showOverlay("journal")}>Notes <Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="key">J</Text></Button><Button variant="ghost" className="tool" ariaLabel="Pause and settings" @click={pauseGame}>{paused ? "Resume" : "Pause"}</Button><Button variant="ghost" className="sound-button" ariaLabel="Toggle sound" @click={toggleSound}>{settings.muted ? "♫ off" : "♫ on"}</Button></Box>
</Box>
<Box className="assignment">
 <Box className="duty-number"><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="eyebrow">DUTY</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="duty-value">{hud.duty}</Text></Box>
 <Box className="assignment-copy"><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="assignment-title">{hud.objective}</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="assignment-detail">{hud.detail}</Text></Box>
 <Box className="bearing"><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="bearing-arrow">{hud.bearing}</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="bearing-caption">FIELD GUIDE</Text></Box>
</Box>
