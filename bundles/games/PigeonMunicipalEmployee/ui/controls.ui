<Box className="control-deck">
 <Box className="dpad" ariaLabel="Movement controls">
  <Button variant="ghost" className="pad up" ariaLabel="Waddle north" @pointerdown={padDown("ArrowUp")} @pointerup={padUp("ArrowUp")} @pointerleave={padUp("ArrowUp")} @pointercancel={clearInput}>↑</Button>
  <Button variant="ghost" className="pad left" ariaLabel="Waddle west" @pointerdown={padDown("ArrowLeft")} @pointerup={padUp("ArrowLeft")} @pointerleave={padUp("ArrowLeft")} @pointercancel={clearInput}>←</Button>
  <Button variant="ghost" className="pad down" ariaLabel="Waddle south" @pointerdown={padDown("ArrowDown")} @pointerup={padUp("ArrowDown")} @pointerleave={padUp("ArrowDown")} @pointercancel={clearInput}>↓</Button>
  <Button variant="ghost" className="pad right" ariaLabel="Waddle east" @pointerdown={padDown("ArrowRight")} @pointerup={padUp("ArrowRight")} @pointerleave={padUp("ArrowRight")} @pointercancel={clearInput}>→</Button>
  <Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="pad-note">WASD</Text>
 </Box>
 <Box className="action-grid">
  <Button variant="ghost" className="action primary" @click={command("peck")} ariaLabel="Peck or interact, E"><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}}>Peck / use</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="key">E</Text></Button>
  <Button variant="ghost" className="action flight" @click={command("fly")} ariaLabel="Take off or land, F"><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}}>{S.p.mode === "fly" ? "Land" : "Fly"}</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="key">F</Text></Button>
  <Button variant="ghost" className="action" @click={command("hop")} ariaLabel="Hop, Space"><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}}>Hop</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="key">SPACE</Text></Button>
  <Button variant="ghost" className="action" @click={command("carry")} ariaLabel="Grab, exchange or drop item, C"><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}}>{S.p.carry ? "Drop / swap" : "Grab"}</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="key">C</Text></Button>
  <Button variant="ghost" className="action" @click={command("coo")} ariaLabel="Coo, Q"><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}}>Coo</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="key">Q</Text></Button>
  <Button variant="ghost" className="action" @click={command("photo")} ariaLabel="Photograph nearby evidence, R"><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}}>Photo</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="key">R</Text></Button>
  <Button variant="ghost" className="action swoop" @click={command("swoop")} ariaLabel="Swoop, Shift"><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}}>Swoop</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="key">SHIFT</Text></Button>
 </Box>
 <Box className="official-footer"><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="eyebrow">ALLOWANCE</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="allowance">{money(S.coins)}</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="footer-small">{hud.evidence+" / 4 evidence records"}</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}} className="footer-small">{profile.achievements.length+" civic distinctions"}</Text></Box>
</Box>
<Box className="bottom-line"><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}}>SMALL BIRD. CONSIDERABLE JURISDICTION.</Text><Text style={{fontSize:"inherit",fontWeight:"inherit",color:"inherit",lineHeight:"inherit",margin:0}}>{saveStatus}</Text></Box>
