// Mild civic reactions, pedestrians, workers and the resident pigeon union.
function workerNpc() { for(let i=0;i<S.npcs.length;i++)if(S.npcs[i].id==="worker")return S.npcs[i];return null; }
function workerPlace() { let n=workerNpc();return {id:"worker",kind:"worker",name:"Works foreperson",x:n?n.x:1190,y:n?n.y:1030,z:0}; }
function npcSpeak(n,text) { if(!n)return;n.bubble=text;n.bubbleTime=3.7;n.react=0.7;n.cooldown=4.5; }
function reactNearby(kind,range) {
 let lines={coo:["Yes, officer.","Is this a consultation?","I'll put that in writing.","Lovely weather, Councillor."],peck:["I pay your salary. In seeds?","Please use the correct form.","Noted. Mildly."],camera:["Is this for the council website?","My good side, please."],flight:["Oh. Airborne management.","Mind the hair, officer."],paper:["Was that the final draft?","An impressive distribution strategy."],chip:["That was my chip.","I suppose it's an expense."]};
 let count=0;
 for(let i=0;i<S.npcs.length;i++) {
  let n=S.npcs[i];if(distance(S.p,n)<range && n.cooldown<=0 && count<2) {
   npcSpeak(n,pick(lines[kind]||lines.coo));count++;
   if(kind==="peck")markFun("annoy","Public consultation completed. The public was mildly inconvenienced.");
  }
 }
}
function coo() {
 if(S.cooCooldown>0)return;
 S.cooCooldown=0.9;S.p.peck=0.12;sound("coo",0.44);spawnDust(S.p.x,S.p.y-S.p.z,3,"coo");reactNearby("coo",145);
 if(S.p.perch==="chair" && S.mission===7 && !has(S.done,"meeting")) {S.meetingCoo=8;say("Your motion to coo is seconded. Remain seated for four seconds.");}
 if(near(placeById("meeting"),145,100)) {
  markFun("meeting","The committee pauses to acknowledge your extremely brief contribution.");
  for(let i=0;i<S.npcs.length;i++)if(S.npcs[i].id.indexOf("committee")===0)npcSpeak(S.npcs[i],"Motion carried. Somehow.");
 }
 let nearby=0;
 for(let j=0;j<S.birds.length;j++)if(distance(S.p,S.birds[j])<220){S.birds[j].follow=8;nearby++;}
 if(nearby>=3)markFun("flock","The local pigeons recognise your union credentials.");
}
function stepNPCs(dt) {
 for(let i=0;i<S.npcs.length;i++) {
  let n=S.npcs[i];n.cooldown=Math.max(0,n.cooldown-dt);n.bubbleTime=Math.max(0,n.bubbleTime-dt);n.react=Math.max(0,n.react-dt);
  n.t+=dt;
  let oldx=n.x,oldy=n.y;
  if(n.react<=0 && n.walk) {
   n.x=n.homeX+Math.sin(n.t*n.rate+n.offset)*n.rx;
   n.y=n.homeY+Math.sin(n.t*n.rate*0.58+n.offset)*n.ry;
   if(n.x!==oldx)n.facing=n.x>oldx?1:-1;
  }
  n.moving=Math.abs(n.x-oldx)+Math.abs(n.y-oldy)>0.1;
  if(S.p.z>18 && S.p.z<85 && distance(S.p,n)<48 && n.cooldown<=0)npcSpeak(n,"Mind the hair, officer.");
 }
 for(let j=0;j<S.birds.length;j++) {
  let b=S.birds[j];b.t+=dt;b.follow=Math.max(0,b.follow-dt);
  let tx=b.homeX+Math.sin(b.t*0.4+j)*40,ty=b.homeY+Math.cos(b.t*0.6+j)*28;
  if(b.follow>0 && S.p.z<20){tx=S.p.x+Math.cos(j*1.7)*42;ty=S.p.y+Math.sin(j*1.7)*38;}
  let dx=tx-b.x,dy=ty-b.y;let d=Math.sqrt(dx*dx+dy*dy);
  if(d>5){b.x+=dx/Math.max(d,1)*Math.min(d,43*dt);b.y+=dy/Math.max(d,1)*Math.min(d,43*dt);b.facing=dx>=0?1:-1;}
 }
 if(S.mission===7 && S.p.perch==="chair" && S.meetingCoo>0) {
  S.meetingTime+=dt;S.meetingCoo-=dt;
  if(S.meetingTime>=4 && !has(S.done,"meeting")){completeRequirement("meeting");say("Attendance recorded. You listened for longer than the chairperson.");}
 } else if(!has(S.done,"meeting"))S.meetingTime=0;
}
