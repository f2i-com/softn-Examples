// Semantic interactions. Input methods share these proximity-checked handlers.
function nearestInteraction() {
 if(!groundReady())return null;
 if(S.form.location==="board") {
  let best=null,range=25;
  for(let i=0;i<3;i++){let p=placeById("check"+i);if(near(p,range)){best=p;range=distance(S.p,p);}}
  if(best)return best;
 }
 if(S.p.carry==="form" && near(placeById("board"),66))return placeById("board");
 let best=null,range=57;
 for(let j=0;j<PLACES.length;j++) {
  let p=PLACES[j].id==="worker"?workerPlace():PLACES[j];
  if(p.kind==="check" || p.kind==="recipient" || p.kind==="perch")continue;
  if(p.kind==="ballot" && !S.electionReady)continue;
  if(near(p,range,26)){best=p;range=distance(S.p,p);}
 }
 return best;
}
function interact() {
 if(S.inspectCooldown>0)return;
 S.inspectCooldown=0.20;S.p.peck=0.25;
 if(!groundReady()){sound("coo",0.17);say("Land or perch before pecking official equipment.");return;}
 let p=nearestInteraction();sound("peck",0.20);
 if(!p) {
  let ate=false;
  for(let i=0;i<S.items.length;i++) {
   let it=S.items[i];if(it.active && it.type==="chip" && near(it,40,24)) {it.active=false;S.breadTotal++;S.p.stamina=Math.min(maxStamina(),S.p.stamina+12);markFun("chip","Chip requisitioned. Payment remains a matter for Finance.");ate=true;break;}
  }
  if(!ate)reactNearby("peck",68);
  if(S.breadTotal>=12)award("bread");
  return;
 }
 if(p.kind==="rack"){takeForm();return;}
 if(p.kind==="board"){placeForm();return;}
 if(p.kind==="check"){checkForm(p.index);return;}
 if(p.kind==="stamp"){say("The stamp is foot-operated. Carry the checked report, then hop onto its red base [Space].");return;}
 if(p.kind==="desk"){fileAtCouncil();return;}
 if(p.kind==="upgrade"){buyUpgrade(p.index);return;}
 if(p.kind==="ballot"){pigeonVote(p.choice);return;}
 if(p.kind==="traffic"){pressTraffic();return;}
 if(p.kind==="chips"){stealChip();return;}
 if(p.kind==="papers"){scatterPapers();return;}
 if(p.kind==="archive") {
  if(deliverOriginal())return;
  if(S.mission===8 && rankIndex()>=4 && !S.archiveUnlocked) {S.archiveUnlocked=true;say("Access card accepted. The archive roof clip is unlocked.");sound("button",0.3);}
  if(missionInspect(p))return;
  say(rankIndex()<4?"Archive window. Deliver recovered pages here; restricted records need a senior access card.":"Archive window. Originals accepted here. Copies regarded with suspicion.");return;
 }
 if(missionInspect(p)) {reactNearby("coo",75);return;}
 let descriptions={bench:"Bench status: bench. Residents appreciate the thoroughness.",pothole:"The pothole is considerably larger than the pigeon.",pond:"Four ducks. Not seven. They look away.",meter:"EXPIRED: 17 MINUTES. The display has no respect for excuses.",sign:"PARKING: 30 MIN. Notices require a verified meter reading.",dump:"One sofa, several bags, zero permits. Press R for a photograph.",fountain:"The fountain is flowing with improbable confidence.",survey:"A webbed signature on the permit. Press R from this roof.",bakery:"400 rolls: invoiced as ROAD INFRASTRUCTURE. Of course.",chair:"A chair reserved for municipal staff. Land on it. Coo to speak.",meeting:"The minutes have more words than the meeting had decisions.",worker:"The foreperson nods at your vest. Press C in flight to drop an authenticated notice."};
 say(descriptions[p.id] || (p.name+" inspected. The paperwork remains serious."));
 if(p.kind==="worker")npcSpeak(workerNpc(),"Good morning, officer.");
}
function contextHint() {
 if(!groundReady())return S.p.carry?"C · Drop from beak    F · Land    Shift · Swoop":"F · Land / perch    Shift · Swoop    C · Catch a loose page";
 let p=nearestInteraction();
 if(p) {
  if(p.kind==="stamp")return "Space · Hop on the stamp press";
  if(p.kind==="check")return "E · Peck: "+p.name;
  if(p.kind==="board")return S.form.location==="board"?"E · Peck checkbox    C · Pick up report":"E · Lay report on clipboard";
  if(p.kind==="ballot")return "E · Vote: "+p.name;
  return "E · "+p.name+(p.id==="dump" || p.id==="survey" || p.id==="meeting"?"    R · Photograph":"");
 }
 return S.p.carry?"C · Drop / exchange item    Space · Hop    Q · Coo":"Space · Hop    F · Short flight    E · Peck    Q · Coo";
}
