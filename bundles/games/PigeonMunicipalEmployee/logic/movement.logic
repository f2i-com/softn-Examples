// Authoritative traversal, altitude, collisions and landing. Fixed 1/60 s steps.
function waterAt(p) { let dx=(p.x-1280)/140,dy=(p.y-340)/83;return dx*dx+dy*dy<0.92; }
function allSurfaces() {
 let a=SURFACES.slice();
 for(let i=0;i<S.vehicles.length;i++) {
  let v=S.vehicles[i];a.push({id:v.id,x:v.x,y:v.y,w:v.w-10,h:36,z:v.z,solid:false,vx:v.vx});
 }
 return a;
}
function supportById(id) {
 let surfaces=allSurfaces();for(let i=0;i<surfaces.length;i++)if(surfaces[i].id===id)return surfaces[i];return null;
}
function blockedAt(p,z) {
 if(z<8 && waterAt(p))return true;
 for(let i=0;i<SURFACES.length;i++) {
  let r=SURFACES[i];if(r.solid && z<r.z-5 && rectContains(p,r,7))return true;
 }
 for(let j=0;j<TREES.length;j++)if(z<24 && distance(p,TREES[j])<16)return true;
 return false;
}
function movePlanar(dx,dy) {
 let p=S.p;
 let nx=clamp(p.x+dx,48,WORLD_W-48);
 if(!blockedAt({x:nx,y:p.y},p.z))p.x=nx;else p.vx*=0.15;
 let ny=clamp(p.y+dy,105,WORLD_H-36);
 if(!blockedAt({x:p.x,y:ny},p.z))p.y=ny;else p.vy*=0.15;
}
function hop() {
 let p=S.p;if(!groundReady())return;
 p.mode="hop";p.vz=184;p.perch="";p.stampHop=true;p.anim=0;
 sound("hop",0.22);spawnDust(p.x,p.y,4,"dust");
}
function toggleFlight() {
 let p=S.p;
 if(p.mode==="fly") { p.mode="glide";p.vz=-54;p.swoop=0;sound("wings",0.28);return; }
 if(p.stamina<16) { say("Wing break. Land or perch to recover stamina.");sound("coo",0.22);return; }
 p.mode="fly";p.vz=Math.max(145,p.vz);p.perch="";p.stampHop=false;
 sound("wings",0.38);spawnDust(p.x,p.y,5,"feather");
}
function swoop() {
 let p=S.p;
 if(p.mode!=="fly" && p.mode!=="glide") { hop();return; }
 p.swoop=0.68;p.mode="glide";p.vz=-118;
 let v=inputVector();
 if(v.x===0 && v.y===0) {p.vx=p.facing*250;p.vy=35;} else {p.vx=v.x*335;p.vy=v.y*335;}
 sound("swoop",0.38);
}
function safeLanding() {
 let p=S.p;
 if(waterAt(p) || blockedAt(p,0)) {
  // A deterministic nearby dry position; never strand a player inside a roof.
  let found=false;
  for(let ring=1;ring<=16 && !found;ring++) {
   for(let i=0;i<12;i++) {
    let a=i*Math.PI/6;let q={x:clamp(p.x+Math.cos(a)*ring*20,50,WORLD_W-50),y:clamp(p.y+Math.sin(a)*ring*20,105,WORLD_H-38)};
    if(!blockedAt(q,0)){p.x=q.x;p.y=q.y;found=true;break;}
   }
  }
  if(!found){p.x=700;p.y=450;}
  say("Emergency landing approved. The council does not insure swimming.");
  spawnDust(p.x,p.y,7,"water");
 }
 p.z=0;p.mode="ground";p.perch="";p.vz=0;
}
function landOn(surface,impact) {
 let p=S.p;
 p.z=surface?surface.z:0;p.vz=0;p.mode=surface?"perch":"ground";p.perch=surface?surface.id:"";p.land=0.26;
 if(!surface)safeLanding();
 sound("land",0.2+Math.min(0.18,impact/800));
 spawnDust(p.x,p.y,settings.reducedMotion?2:6,"dust");
 if(surface && surface.id==="statue")markFun("statue","You are now above previous management. Literally.");
 if(surface && surface.id==="bus")markFun("bus","Council travel allowance claimed: one bus roof.");
 if(p.stampHop && distance(p,placeById("stamp"))<39)stampForm();
 p.stampHop=false;p.swoop=0;
}
function stepMovement(dt) {
 let p=S.p,v=inputVector();
 p.peck=Math.max(0,p.peck-dt);p.land=Math.max(0,p.land-dt);p.swoop=Math.max(0,p.swoop-dt);
 p.stepSound=Math.max(0,p.stepSound-dt);
 let airborne=!groundReady();
 let speed=p.mode==="fly"?228:(p.mode==="glide"?246:125);
 speed+=p.mode==="fly"?upgradeLevel("wings")*8:0;
 if(p.carry)speed*=0.90;
 if(p.swoop>0)speed=340;
 let moving=v.x!==0 || v.y!==0;
 let approach=(airborne?4.8:14)*dt;
 if(p.swoop<=0 || moving) {
  p.vx+=(v.x*speed-p.vx)*Math.min(1,approach);
  p.vy+=(v.y*speed-p.vy)*Math.min(1,approach);
 }
 if(Math.abs(p.vx)>5)p.facing=p.vx>0?1:-1;
 if(p.perch) {
  let support=supportById(p.perch);
  if(support && support.vx)p.x+=support.vx*dt;
 }
 movePlanar(p.vx*dt,p.vy*dt);
 if(p.perch) {
  let support=supportById(p.perch);
  if(!support || !rectContains(p,support,2)) { p.perch="";p.mode="glide";p.vz=0; }
 }
 let oldZ=p.z;
 if(p.mode==="fly") {
  p.stamina=Math.max(0,p.stamina-dt*(p.carry?15:12)*(settings.gentle?0.72:1));
  p.vz+=(130-p.z)*12*dt-p.vz*5*dt;
  p.z=clamp(p.z+p.vz*dt,0,157);
  if(p.stamina<=0){p.mode="glide";p.vz=-32;say("Wing break due. Gliding to the nearest landing.");}
  if(p.stepSound<=0){sound("wings",0.14);p.stepSound=0.38;}
 } else if(p.mode==="hop" || p.mode==="glide") {
  p.vz-=(p.mode==="hop"?520:210)*dt;
  p.z+=p.vz*dt;
 } else {
  p.stamina=Math.min(maxStamina(),p.stamina+dt*(p.mode==="perch"?30:24));
  if(moving && p.stepSound<=0){sound("steps",0.12);p.stepSound=0.28;}
 }
 // Detect a top crossed this step, never snap upward through a roof.
 if(!groundReady() && p.vz<=0) {
  let surfaces=allSurfaces(),best=null;
  for(let i=0;i<surfaces.length;i++) {
   let r=surfaces[i];if(rectContains(p,r,2) && oldZ>=r.z-0.5 && p.z<=r.z && (!best || r.z>best.z))best=r;
  }
  if(best)landOn(best,-p.vz);else if(p.z<=0)landOn(null,-p.vz);
 }
 let mag=Math.sqrt(p.vx*p.vx+p.vy*p.vy);
 p.anim+=dt*(groundReady()?mag*0.11:14);
 if(mag<3 && groundReady())p.anim+=dt*0.5;
 if(p.carry)syncCarried();
 if(!settings.reducedMotion && p.swoop>0 && Math.floor(S.time*30)%3===0)spawnDust(p.x-p.vx*0.07,p.y,1,"feather");
}
