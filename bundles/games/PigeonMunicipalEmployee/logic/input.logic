// Keyboard and touch feed the same bounded action queue. Repeat-safe actions.
function clearInput() {keys={};commands=[];}
function beginPlay() {
 sessionReady=true;paused=false;overlay="";lastClock=Date.now();accumulator=0;
 startAmbience();sound("coo",0.35);persist();publish();
}
function command(id) {
 if(overlay==="welcome")beginPlay();
 if(!isPlaying())return;
 if(commands.length<12)commands.push(String(id));
}
function padDown(dir) {if(overlay==="welcome")beginPlay();if(!isPlaying())return;keys[dir]=true;}
function padUp(dir) {keys[dir]=false;}
function showOverlay(name) {
 clearInput();overlay=overlay===name?(sessionReady?"":"welcome"):name;paused=false;accumulator=0;lastClock=Date.now();
 if(overlay)stopAudio();else startAmbience();persist();publish();
}
function closeOverlay() {overlay=sessionReady?"":"welcome";paused=false;clearInput();lastClock=Date.now();accumulator=0;startAmbience();publish();}
function pauseGame() {
 if(overlay==="welcome" || overlay==="ending")return;
 if(overlay){closeOverlay();return;}
 paused=!paused;clearInput();lastClock=Date.now();accumulator=0;
 if(paused)stopAudio();else startAmbience();persist();publish();
}
function toggleAssist() {settings.assist=!settings.assist;persist();publish();}
function toggleMotion() {settings.reducedMotion=!settings.reducedMotion;persist();publish();}
function toggleGentle() {settings.gentle=!settings.gentle;persist();publish();}
function requestReset() {confirmReset=!confirmReset;publish();}
function confirmNew() {if(!confirmReset)return;stopAudio();resetGame();persist();}
function loseFocus() {
 clearInput();
 if(sessionReady && !overlay){paused=true;stopAudio();persist();publish();}
}
function keyDown(e) {
 let tag=String(e.targetTag || (e.target && e.target.tagName) || "").toLowerCase();
 if(tag==="input" || tag==="textarea" || tag==="select")return;
 let k=String(e.key||"");if(k.length===1)k=k.toLowerCase();
 if(k==="Tab")return; // Do not steal native focus traversal.
 if(k==="Escape" || k==="p"){if(!e.repeat)pauseGame();return;}
 if(k==="m"){if(!e.repeat)showOverlay("map");return;}
 if(k==="j"){if(!e.repeat)showOverlay("journal");return;}
 if(k==="Enter" && overlay==="welcome"){beginPlay();return;}
 if(tag==="button" && (k===" " || k==="Enter"))return;
 let moves=["w","a","s","d","ArrowUp","ArrowDown","ArrowLeft","ArrowRight"];
 let actionKeys={" ":"hop",f:"fly",e:"peck",q:"coo",c:"carry",r:"photo",Shift:"swoop"};
 if(!has(moves,k) && !actionKeys[k])return;
 if(e.preventDefault)e.preventDefault();
 if(overlay==="welcome")beginPlay();
 if(!isPlaying())return;
 if(has(moves,k))keys[k]=true;
 else if(!e.repeat && !keys[k]) {keys[k]=true;command(actionKeys[k]);}
}
function keyUp(e) {let k=String(e.key||"");if(k.length===1)k=k.toLowerCase();keys[k]=false;}
function installInput() {
 if(inputCleanup)inputCleanup();
 window.addEventListener("keydown",keyDown);window.addEventListener("keyup",keyUp);window.addEventListener("blur",loseFocus);
 inputCleanup=function(){window.removeEventListener("keydown",keyDown);window.removeEventListener("keyup",keyUp);window.removeEventListener("blur",loseFocus);};
}
function processAction(id) {
 if(id==="hop")hop();else if(id==="fly")toggleFlight();else if(id==="swoop")swoop();
 else if(id==="peck")interact();else if(id==="coo")coo();else if(id==="carry")carryAction();else if(id==="photo")photo();
}
