// Town simulation: seeded ambient life, vehicles, crossing lights and weather.
function worldSetup() {
 S.items=[
 {id:"awningpage",name:"Blown planning page",type:"paper",x:365,y:1110,z:54,vx:0,vy:0,vz:0,active:true},
 {id:"minutes",name:"Damp council minutes",type:"paper",x:1225,y:617,z:96,vx:0,vy:0,vz:0,active:true},
 {id:"chip1",name:"Illicit chip",type:"chip",x:818,y:452,z:0,vx:0,vy:0,vz:0,active:true},
 {id:"chip2",name:"Very small chip",type:"chip",x:710,y:471,z:0,vx:0,vy:0,vz:0,active:true},
 {id:"chip3",name:"Unattended chip",type:"chip",x:931,y:951,z:0,vx:0,vy:0,vz:0,active:true}
 ];
 S.npcs=[];
 let defs=[
 ["clerk",146,343,0,0,0,"clerk"],["worker",1190,1030,65,22,1,"worker"],
 ["chipsowner",818,477,0,0,0,"person-coral"],["resident",925,419,28,7,1,"person-blue"],
 ["walker1",736,512,94,90,1,"person-mint"],["walker2",520,697,126,14,1,"person-coral"],
 ["walker3",1045,987,92,19,1,"person-blue"],["walker4",1470,489,6,102,1,"person-yellow"],
 ["committee1",1082,535,0,0,0,"person-blue"],["committee2",1085,598,0,0,0,"person-coral"],
 ["cleaner",602,566,32,50,1,"worker"],["archivist",1162,650,0,0,0,"clerk"]
 ];
 for(let i=0;i<defs.length;i++){let d=defs[i];S.npcs.push({id:d[0],x:d[1],y:d[2],homeX:d[1],homeY:d[2],rx:d[3],ry:d[4],walk:!!d[5],art:d[6],t:0,rate:0.16+i*0.007,offset:i*1.8,facing:1,react:0,cooldown:0,bubble:"",bubbleTime:0,moving:false});}
 S.birds=[];
 for(let j=0;j<7;j++){let bx=j<4?680+j*23:1110+(j-4)*25;let by=j<4?477+j*9:441;S.birds.push({id:"bird"+j,x:bx,y:by,homeX:bx,homeY:by,t:j,follow:0,facing:1});}
 S.vehicles=[{id:"bus",x:150,y:822,w:154,z:43,speed:62,vx:62,art:"bus"},{id:"car1",x:1030,y:822,w:101,z:30,speed:77,vx:77,art:"car-mint"},{id:"car2",x:1180,y:917,w:105,z:30,speed:-71,vx:-71,art:"car-coral"}];
}
function spawnDust(x,y,n,type) {
 for(let i=0;i<n && S.particles.length<70;i++)S.particles.push({id:S.time+":"+i+":"+S.seed,x:x,y:y,z:4,vx:(rng()-0.5)*70,vy:(rng()-0.5)*45,vz:15+rng()*30,life:0.35+rng()*0.6,max:1,type:type});
}
function pressTraffic() {
 if(S.traffic.green>0){say("Crossing already green. Democracy has heard you.");return;}
 S.traffic.requested=1.1;sound("button",0.25);markFun("traffic","Crossing requested by authorised beak. Cars will wait.");
}
function stealChip() {
 if(S.chipCooldown>0){say("The citizen is guarding the remaining chips. Give them a moment.");return;}
 S.chipCooldown=10;S.breadTotal++;S.p.stamina=Math.min(maxStamina(),S.p.stamina+12);S.p.peck=0.35;
 sound("peck",0.28);reactNearby("chip",90);markFun("chip","Chip requisitioned. No paperwork was involved.");
 if(S.breadTotal>=12)award("bread");
}
function scatterPapers() {
 if(S.scatterCooldown>0)return;
 S.scatterCooldown=9;
 for(let i=0;i<5;i++) {
  let id="scrap"+i;if(S.p.carry===id)continue;let old=itemById(id);
  let item={id:id,name:"Committee draft",type:"paper",x:1050,y:571,z:22,vx:(rng()-0.5)*150,vy:(rng()-0.5)*100,vz:85+rng()*50,active:true};
  if(old){for(let j=0;j<S.items.length;j++)if(S.items[j].id===id)S.items[j]=item;}
  else S.items.push(item);
 }
 sound("paper",0.42);reactNearby("paper",155);markFun("papers","You have distributed the minutes. They are now extremely distributed.");
}
function stepWorld(dt) {
 S.traffic.cooldown=Math.max(0,S.traffic.cooldown-dt);
 if(S.traffic.requested>0){S.traffic.requested-=dt;if(S.traffic.requested<=0)S.traffic.green=6;}
 S.traffic.green=Math.max(0,S.traffic.green-dt);
 for(let i=0;i<S.vehicles.length;i++) {
  let v=S.vehicles[i],stop=S.traffic.green>0 || S.traffic.requested>0;
  let nearLine=v.speed>0?v.x>535 && v.x<658:v.x<888 && v.x>780;
  v.vx=stop && nearLine?0:v.speed;
  v.x+=v.vx*dt;
  if(v.x>WORLD_W+90 || v.x< -100) {
   v.x=v.speed>0?-90:WORLD_W+90;
   if(S.p.perch===v.id){S.p.x=clamp(v.x,60,WORLD_W-60);S.p.perch="";S.p.mode="glide";S.p.vz=-40;}
  }
  // A municipal bird is a yielding obstacle, not a damage source.
  if(S.p.z<18 && Math.abs(S.p.y-v.y)<30 && Math.abs(S.p.x-v.x)<v.w/2+30) {
   v.x-=v.vx*dt;v.vx=0;
   if(S.traffic.cooldown<=0){sound("horn",0.12);S.traffic.cooldown=5;}
  }
 }
 S.wind.time+=dt;
 if(S.wind.time>S.wind.next){S.wind.time=0;S.wind.next=24+rng()*14;S.wind.angle=-0.3+rng()*0.9;}
 S.wind.strength=S.wind.time<5?Math.sin(S.wind.time/5*Math.PI):0;
 if(S.wind.strength>0.7 && Math.floor(S.time*12)%4===0 && !settings.reducedMotion)spawnDust(S.p.x-170,S.p.y-30,1,"leaf");
 let keep=[];
 for(let j=0;j<S.particles.length;j++) {
  let p=S.particles[j];p.life-=dt;
  if(p.life>0){p.x+=p.vx*dt+(p.type==="leaf"?140*dt:0);p.y+=p.vy*dt;p.z+=p.vz*dt;p.vz-=85*dt;keep.push(p);}
 }
 S.particles=keep;
 S.chipCooldown=Math.max(0,S.chipCooldown-dt);S.scatterCooldown=Math.max(0,S.scatterCooldown-dt);S.cooCooldown=Math.max(0,S.cooCooldown-dt);S.inspectCooldown=Math.max(0,S.inspectCooldown-dt);
 S.stampTime=Math.max(0,S.stampTime-dt);S.photoTime=Math.max(0,S.photoTime-dt);S.promotionTime=Math.max(0,S.promotionTime-dt);
}
