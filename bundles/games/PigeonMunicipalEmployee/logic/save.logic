// Versioned per-game persistence. Strict whitelists, bounded trees and safe v1
// migration preserve earned evidence/allowance, not incompatible old geometry.
function validTree(v,depth,budget) {
 if(depth>12 || budget.n++>8000)return false;
 if(v===null || typeof v==="boolean")return true;
 if(typeof v==="number")return isFinite(v) && Math.abs(v)<9007199254740991;
 if(typeof v==="string")return v.length<=1500;
 if(typeof v!=="object")return false;
 if(Array.isArray(v) && v.length>160)return false;
 let ks=Object.keys(v);if(ks.length>160)return false;
 for(let i=0;i<ks.length;i++){
  if(ks[i]==="__proto__" || ks[i]==="constructor" || ks[i]==="prototype")return false;
  if(!validTree(v[ks[i]],depth+1,budget))return false;
 }
 return true;
}
function num(n,lo,hi) {return typeof n==="number" && isFinite(n) && n>=lo && n<=hi;}
function uniqueAllowed(a,allowed) {
 if(!Array.isArray(a) || a.length>allowed.length)return false;
 for(let i=0;i<a.length;i++)if(typeof a[i]!=="string" || !has(allowed,a[i]) || a.indexOf(a[i])!==i)return false;return true;
}
function validPhysical(o) {
 return o && num(o.x,0,WORLD_W+200) && num(o.y,0,WORLD_H+100) && num(o.z,-10,180) && num(o.vx,-700,700) && num(o.vy,-700,700) && num(o.vz,-1200,500);
}
function savedState() {
 return {id:GAME_ID,version:VERSION,seed:S.seed,time:S.time,mission:S.mission,phase:S.phase,coins:S.coins,score:S.score,
 upgrades:copy(S.upgrades),evidence:S.evidence.slice(),breadTotal:S.breadTotal,done:S.done.slice(),meterRead:S.meterRead,
 p:copy(S.p),form:copy(S.form),items:copy(S.items),fun:copy(S.fun),archiveUnlocked:S.archiveUnlocked,electionReady:S.electionReady,ending:S.ending,endingBody:S.endingBody};
}
function validSave(g) {
 if(!g || g.id!==GAME_ID || g.version!==VERSION || !validTree(g,0,{n:0}))return false;
 if(!Number.isInteger(g.mission) || g.mission<0 || g.mission>=MISSIONS.length || !has(["play","free"],g.phase))return false;
 if(!num(g.seed,1,2147483646) || !num(g.time,0,1e9) || !num(g.coins,0,1e9) || !num(g.score,0,1e11) || !num(g.breadTotal,0,1e7))return false;
 if(!g.upgrades || typeof g.upgrades!=="object")return false;
 for(let i=0;i<UPGRADES.length;i++){let n=g.upgrades[UPGRADES[i].id];if(!Number.isInteger(n)||n<0||n>3)return false;}
 if(!uniqueAllowed(g.evidence,["duck1","duck2","duck3","duck4"]) || !uniqueAllowed(g.done,MISSIONS[g.mission].req))return false;
 let p=g.p,f=g.form;
 if(!validPhysical(p) || !has(["ground","perch","hop","fly","glide"],p.mode) || !num(p.stamina,0,154))return false;
 if(p.facing!==1 && p.facing!==-1)return false;
 if(typeof p.perch!=="string" || typeof p.carry!=="string" || typeof p.stampHop!=="boolean")return false;
 let counters=["anim","peck","land","swoop","stepSound"];
 for(let c=0;c<counters.length;c++)if(!num(p[counters[c]],-10,1e10))return false;
 if(!validPhysical(f) || f.mission!==g.mission || !has(["rack","beak","ground","board","filed"],f.location) || !Number.isInteger(f.serial))return false;
 if(!Array.isArray(f.checks) || f.checks.length!==3 || typeof f.stamped!=="boolean" || typeof f.delivered!=="boolean")return false;
 for(let j=0;j<3;j++)if(typeof f.checks[j]!=="boolean")return false;
 if(f.stamped && !(f.checks[0] && f.checks[1] && f.checks[2] && g.done.length===MISSIONS[g.mission].req.length))return false;
 if(f.delivered && (!f.stamped || !MISSIONS[g.mission].delivery))return false;
 if((p.carry==="form")!==(f.location==="beak"))return false;
 if(!Array.isArray(g.items) || g.items.length<5 || g.items.length>10)return false;
 let ids=[];
 for(let k=0;k<g.items.length;k++) {
  let it=g.items[k];if(!validPhysical(it) || !has(["paper","chip"],it.type) || typeof it.active!=="boolean" || typeof it.name!=="string")return false;
  if(!has(["awningpage","minutes","chip1","chip2","chip3","scrap0","scrap1","scrap2","scrap3","scrap4"],it.id) || has(ids,it.id))return false;
  ids.push(it.id);
  if(p.carry===it.id && it.active)return false;
 }
 if(p.carry && p.carry!=="form" && !has(ids,p.carry))return false;
 if(!has(ids,"minutes") || !has(ids,"awningpage"))return false;
 if(!g.fun || typeof g.fun!=="object" || Array.isArray(g.fun))return false;
 if(typeof g.meterRead!=="boolean" || typeof g.archiveUnlocked!=="boolean" || typeof g.electionReady!=="boolean" || typeof g.ending!=="string" || typeof g.endingBody!=="string")return false;
 if(g.meterRead && !has(g.done,"meter"))return false;
 if(g.electionReady && (g.mission!==9 || f.location!=="filed" || !f.stamped))return false;
 if(g.phase==="free" && (!g.electionReady || !g.ending))return false;
 return true;
}
function persist() {
 if(!S)return;
 try {
  let state=savedState();
  if(!validSave(state)){saveStatus="Save deferred: state validation failed";return;}
  localStorage.setItem(SAVE_KEY,JSON.stringify({schema:2,game:GAME_ID,state:state,profile:profile,settings:settings}));
  saveStatus="Saved on this device";
 } catch(err){saveStatus="Storage unavailable; this session still works";}
}
function restoreProfile(data) {
 if(data.profile && validTree(data.profile,0,{n:0})) {
  profile.best=num(data.profile.best,0,1e11)?data.profile.best:0;
  profile.completed=num(data.profile.completed,0,1e6)?Math.floor(data.profile.completed):0;
  let list=Array.isArray(data.profile.achievements)?data.profile.achievements:[];
  profile.achievements=[];for(let i=0;i<BADGES.length;i++)if(has(list,BADGES[i].id))profile.achievements.push(BADGES[i].id);
 }
 if(data.settings){let ks=Object.keys(settings);for(let j=0;j<ks.length;j++)settings[ks[j]]=data.settings[ks[j]]===true;}
}
function migrateLegacy(data) {
 let g=data && data.state;
 if(!data || data.schema!==1 || data.game!==GAME_ID || !g || g.id!==GAME_ID || g.version!==1 || !validTree(g,0,{n:0}))return false;
 if(!Number.isInteger(g.stage) || g.stage<0 || g.stage>5 || !num(g.coins,0,1e9) || !num(g.score,0,1e11))return false;
 if(!uniqueAllowed(g.evidence,["duck1","duck2","duck3","duck4"]))return false;
 S=freshState();worldSetup();missionSetup([0,1,2,5,8,9][g.stage]);
 S.coins=g.coins;S.score=g.score;S.evidence=g.evidence.slice();S.breadTotal=num(g.breadTotal,0,1e7)?g.breadTotal:0;
 if(g.upgrades)for(let i=0;i<UPGRADES.length;i++){let id=UPGRADES[i].id;if(Number.isInteger(g.upgrades[id]) && num(g.upgrades[id],0,3))S.upgrades[id]=g.upgrades[id];}
 restoreProfile(data);saveStatus="v1 career imported; current duty restarted in the new town";
 say(saveStatus+". Your original save has not been overwritten.");return true;
}
function restore() {
 try {
  let raw=localStorage.getItem(SAVE_KEY);
  if(!raw){let old=localStorage.getItem(LEGACY_KEY);if(old && old.length<250000)return migrateLegacy(JSON.parse(old));return false;}
  if(raw.length>250000)throw new Error("Oversize save");
  let data=JSON.parse(raw);
  if(data.schema!==2 || data.game!==GAME_ID || !validSave(data.state))throw new Error("Invalid save");
  S=freshState();worldSetup();let g=data.state,ks=Object.keys(g);
  let allowed=Object.keys(savedState());for(let i=0;i<ks.length;i++)if(has(allowed,ks[i]))S[ks[i]]=copy(g[ks[i]]);
  // Vehicle routes are ambient, not persisted. End a saved bus ride safely.
  if(has(["bus","car1","car2"],S.p.perch)){S.p.perch="";S.p.mode="glide";S.p.vz=-20;}
  restoreProfile(data);saveStatus="Saved career restored";return true;
 } catch(err){saveStatus="Old or damaged save ignored safely";return false;}
}
