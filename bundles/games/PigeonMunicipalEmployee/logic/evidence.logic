// Evidence is durable, deduplicated, source-specific and independent of UI state.
function addEvidence(id) {
 let record=null;for(let i=0;i<EVIDENCE.length;i++)if(EVIDENCE[i].id===id)record=EVIDENCE[i];
 if(!record || has(S.evidence,id))return false;
 S.evidence.push(id);sound("evidence",0.3);say("Evidence secured: "+record.title+".");
 if(S.evidence.length===4)award("evidence");
 persist();return true;
}
function hasAllEvidence() {
 for(let i=0;i<EVIDENCE.length;i++)if(!has(S.evidence,EVIDENCE[i].id))return false;return true;
}
function photo() {
 if(!groundReady()){say("Land or perch to take a steady photograph.");return false;}
 let candidates=[{req:"dumpPhoto",at:"dump",range:130},{req:"roofPhoto",at:"survey",range:102},{req:"meetingPhoto",at:"meeting",range:110}];
 for(let i=0;i<candidates.length;i++) {
  let c=candidates[i];if(near(placeById(c.at),c.range,34)) {
   if(c.req==="roofPhoto" && S.p.perch!=="archiveroof")continue;
   cameraFlash=0.14;S.photoTime=0.65;sound("camera",0.36);
   if(completeRequirement(c.req)) {
    if(c.req==="roofPhoto")addEvidence("duck2");
   } else say("Photograph retained. A very official composition.");
   reactNearby("camera",130);return true;
  }
 }
 cameraFlash=0.12;S.photoTime=0.5;sound("camera",0.3);
 say("Scenic photograph taken. For mission evidence, frame the actual subject nearby.");return false;
}
