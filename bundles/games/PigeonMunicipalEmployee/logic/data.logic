let EVIDENCE = [
 {id:"duck1",title:"A statistically ambitious duck",source:"Pond census",text:"The pond contains four ducks. The municipal register funds seven ducks and three imaginary benches."},
 {id:"duck2",title:"A signature with webbed feet",source:"Archive roof survey",text:"The rooftop permit bears the same webbed signature as the nonexistent-bench invoices."},
 {id:"duck3",title:"Bread is not a road",source:"Bakery & fountain audit",text:"Four hundred ceremonial bread rolls were charged to road infrastructure. The moat is real; its planning permission is not."},
 {id:"duck4",title:"The missing minutes",source:"Recovered archive original",text:"The damp minutes approve the bread diversion. All four records establish the chain from census to payment."}
];
let MISSIONS = [
 {id:"bench",title:"The seat of government",form:"17B / STREET FURNITURE",rank:0,req:["bench","pothole"],intro:"Welcome aboard. Inspect a bench and a pothole. Neither is your line manager.",reward:34},
 {id:"census",title:"Three bins. Four invoices.",form:"04D / PARKS CENSUS",rank:1,req:["bin1","bin2","bin3","ducks"],intro:"Count each bin once. The ducks have already submitted their own numbers.",reward:38},
 {id:"parking",title:"Due process, from above",form:"PC17 / PARKING NOTICE",rank:2,req:["meter","sign"],delivery:"parked",intro:"Read the meter AND the sign. Then serve a stamped notice from above. This is not a suggestion to guess.",reward:44},
 {id:"dumping",title:"The sofa has no permit",form:"81A / UNAUTHORISED SOFA",rank:3,req:["dumpPhoto","roofPhoto"],intro:"Photograph the dumping, then take a second record from the archive roof. The sofa denies everything.",reward:48},
 {id:"awning",title:"Gone with the form",form:"12W / DOCUMENT RECOVERY",rank:3,req:["awningPage"],intro:"A planning application is on the bakery awning. Bring the loose page to the archive window. File your own report afterwards.",reward:42},
 {id:"planning",title:"Bread is not infrastructure",form:"09P / PLANNING REVIEW",rank:4,req:["bakery","fountain"],intro:"Inspect the bakery account and the fountain outlet. Someone has budgeted for a bread-shop moat.",reward:50},
 {id:"serve",title:"Notice to a responsible adult",form:"S22 / WORKS NOTICE",rank:4,req:["worker","dumpCheck"],delivery:"worker",intro:"Speak to the foreperson, inspect the waste, and deliver their notice. Preferably not to a bin.",reward:46},
 {id:"committee",title:"A quorum of one pigeon",form:"CM1 / ATTENDANCE RECORD",rank:5,req:["meeting","meetingPhoto"],intro:"Perch on the empty committee chair, coo, and remain for four seconds. Take a record of the minutes.",reward:52},
 {id:"minutes",title:"The missing minutes",form:"A04 / CHAIN OF CUSTODY",rank:5,req:["minutes","archiveAccount"],intro:"Use your access card at the archive. Recover the damp minutes from its roof and hand them to the archive clerk.",reward:60},
 {id:"election",title:"The competent candidate",form:"M01 / MAYORAL NOMINATION",rank:6,req:["residents","delegation"],intro:"Hear the residents and the duck delegation. File your nomination, then peck a brass ballot tile outside council.",reward:70}
];
