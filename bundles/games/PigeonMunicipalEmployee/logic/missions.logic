// Requirements, form authentication, promotions and the retained three endings.
function missionSetup(index) {
 S.mission=index;S.done=[];S.meterRead=false;S.electionReady=false;S.meetingTime=0;S.meetingCoo=0;
 S.form={mission:index,location:"rack",x:175,y:260,z:0,vx:0,vy:0,vz:0,checks:[false,false,false],stamped:false,delivered:false,serial:S.form?S.form.serial+1:1};
 if(S.p.carry==="form")S.p.carry="";
 say(currentMission().intro);
}
function completeRequirement(id) {
 if(S.phase!=="play" || !has(currentMission().req,id) || has(S.done,id))return false;
 S.done.push(id);earn(5+upgradeLevel("badge"));
 if(id==="meter")S.meterRead=true;
 if(id==="ducks")addEvidence("duck1");
 if(S.mission===5 && requirementsReady())addEvidence("duck3");
 sound("success",0.24);
 if(requirementsReady())say("Fieldwork complete. Return to the clipboard, peck its three boxes, then hop on the stamp press.");
 else say("Recorded: "+REQUIREMENTS[id].text.replace(" [R]","")+".");
 persist();return true;
}
function requirementsReady() {
 let req=currentMission().req;for(let i=0;i<req.length;i++)if(!has(S.done,req[i]))return false;return true;
}
function checksReady() { return S.form.checks[0] && S.form.checks[1] && S.form.checks[2]; }
function missionInspect(place) {
 let req=currentMission().req;
 for(let i=0;i<req.length;i++) {
  let id=req[i],r=REQUIREMENTS[id];
  if(r.at===place.id && r.verb==="inspect") {
   if(has(S.done,id)) {say("Already recorded. Counting it twice would make you management.");return true;}
   if(id==="archiveAccount" && rankIndex()<4) {say("The archive requires an access card.");return true;}
   if(id==="meter")say("Meter expired by seventeen minutes. Due process begins with actually reading it.");
   completeRequirement(id);return true;
  }
 }
 return false;
}
function stampForm() {
 let f=S.form;
 if(S.p.carry!=="form" || f.location!=="beak") {say("Carry your form in your beak, then hop onto the stamp press.");return false;}
 if(!requirementsReady() || !checksReady()) {say("Stamp refused: finish the fieldwork and peck all three clipboard boxes first.");sound("reject",0.2);return false;}
 if(f.stamped){say("Already stamped. Further stamping will not increase legality.");return false;}
 f.stamped=true;S.stampTime=0.65;shake=0.14;sound("stamp",0.54);spawnDust(441,330,8,"ink");
 if(currentMission().delivery)say("Notice authenticated. Fly over the recipient and DROP it [C]. A carbon copy will stay with you.");
 else say("STAMPED. Carry the form to the council returns desk and peck [E].");
 persist();return true;
}
function tryServeNotice(item,oldZ) {
 let m=currentMission(),f=S.form;
 if(!m.delivery || f.delivered || item!==f || !f.stamped || !requirementsReady() || !checksReady())return false;
 if(m.id==="parking" && (!S.meterRead || !has(S.done,"sign")))return false;
 let target=placeById(m.delivery);
 // Delivery is a downward crossing of recipient height, not an arbitrary drop event.
 if(oldZ<(target.z||0)+7 || distance(f,target)>60 || f.z>(target.z||0)+8 || f.vz>=0 || !f.airdrop)return false;
 f.delivered=true;f.location="beak";f.vz=0;S.p.carry="form";syncCarried();
 if(m.id==="parking")award("legal");
 if(m.delivery==="worker")npcSpeak(workerNpc(),"Served by air mail. Of course.");
 sound("success",0.35);spawnDust(target.x,target.y,8,"paper");
 say("Notice served correctly. Carbon copy retained in beak. Return to council.");persist();return true;
}
function fileAtCouncil() {
 if(S.phase==="free"){say("Your office remains a branch. Management has adapted.");return;}
 let f=S.form;
 if(S.electionReady){say("Your nomination is filed. Peck one brass ballot tile outside, east of council.");return;}
 if(S.p.carry!=="form" || f.location!=="beak") {say("Council requires the physical report. Collect it at the forms rack or recover the dropped page.");return;}
 if(!requirementsReady() || !checksReady() || !f.stamped) {say("Returned unfiled. Fieldwork, three pecked boxes, and one stamp are required.");sound("reject",0.2);return;}
 if(currentMission().delivery && !f.delivered){say("Serve the stamped notice from the air before filing its carbon copy.");return;}
 S.p.carry="";f.location="filed";earn(currentMission().reward);award("first");award("careful");sound("jingle",0.35);
 if(S.mission===MISSIONS.length-1) {S.electionReady=true;say("Nomination accepted. Three brass ballot tiles await outside council. The evidence tile requires all four records.");persist();return;}
 let previousRank=rankIndex();missionSetup(S.mission+1);
 if(rankIndex()>previousRank){S.promotionTime=7;say("PROMOTED: "+RANKS[rankIndex()].name+". "+RANKS[rankIndex()].kit+".");}
 S.p.stamina=maxStamina();persist();
}
function pigeonVote(choice) {
 if(!S.electionReady || S.phase!=="play")return false;
 if(choice!=="coalition" && choice!=="expose" && choice!=="bread")return false;
 if(choice==="expose" && !hasAllEvidence()) {say("An allegation is not an evidence file. This platform requires all four distinct records.");sound("reject",0.25);return false;}
 let titles={coalition:"A very feathered coalition",expose:"Mayor, with receipts",bread:"Bread-based government"};
 let bodies={coalition:"The ducks accept a public bread budget, regular audits and a strict ban on imaginary benches. Your deputy is a duck. Your office chair is a branch.",expose:"The four records expose the entire bread scheme. The town elects its most competent employee: a pigeon with a paper trail. The chair budget is reduced by 99 percent.",bread:"You promise public crumbs and extremely short speeches. The town votes overwhelmingly yes. Economists request a word. You are a pigeon."};
 S.phase="free";S.ending=titles[choice];S.endingBody=bodies[choice];profile.completed++;award("finish");
 overlay="ending";clearInput();sound("jingle",0.42);persist();publish();return true;
}
function nextGoal() {
 if(S.phase==="free")return {at:"statue",text:"Shift complete. The town is yours to pigeon in.",detail:"Perch, fly, steal a chip. No more paperwork is compulsory."};
 if(S.electionReady)return {at:"ballot1",text:"Peck a brass ballot tile east of council",detail:"Coalition / expose the scheme / bread for everyone"};
 let f=S.form;
 if(S.p.carry==="awningpage" && S.mission===4)return {at:"archive",text:"Deliver the recovered page to the archive [E]",detail:"Your report is resting where you exchanged it."};
 if(S.p.carry==="minutes" && S.mission===8)return {at:"archive",text:"Hand the original minutes to the archive [E]",detail:"The chain of custody ends at the service window."};
 if(f.location==="rack")return {at:"rack",text:"Collect your blank form at council [E]",detail:currentMission().title};
 if(f.location==="ground")return {at:"lostform",text:"Recover your loose form [C]",detail:"The page is still real. The rack can also issue a replacement."};
 if(!requirementsReady()) {
  let req=currentMission().req;
  for(let i=0;i<req.length;i++)if(!has(S.done,req[i])) {
   let r=REQUIREMENTS[req[i]];
   if(req[i]==="awningPage" && S.p.carry==="awningpage")return {at:"archive",text:"Deliver the recovered page to the archive [E]",detail:"Your report remains safe where you left it."};
   if(req[i]==="minutes") {
    if(!S.archiveUnlocked)return {at:"archive",text:"Use your access card at the archive [E]",detail:"Then recover its rooftop minutes."};
    if(S.p.carry==="minutes")return {at:"archive",text:"Hand the original minutes to the archive [E]",detail:"Chain of custody matters."};
   }
   return {at:r.at,text:r.text,detail:currentMission().title};
  }
 }
 if(!checksReady()) {
  if(f.location!=="board")return {at:"board",text:"Place the report on the council clipboard [E]",detail:"Then walk to and peck each checkbox."};
  let n=0;while(n<3 && f.checks[n])n++;
  return {at:"check"+n,text:"Peck the clipboard checkbox [E]",detail:["Observed personally","Evidence attached","Applicant is a bird"][n]};
 }
 if(!f.stamped) {
  if(S.p.carry!=="form")return {at:"board",text:"Pick up the checked report [C]",detail:"Carry it to the red stamp press."};
  return {at:"stamp",text:"Hop onto the municipal stamp press [Space]",detail:"Carry the report. Land on the red base."};
 }
 if(currentMission().delivery && !f.delivered)return {at:currentMission().delivery,text:"Fly over the recipient and drop the notice [C]",detail:"A miss is recoverable. Read the target, not a floating label."};
 return {at:"desk",text:"Carry your stamped report to council returns [E]",detail:"One bird. Full chain of custody."};
}
