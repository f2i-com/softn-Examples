// main.ui — SoftDOS, an x86 PC and DOS machine emulated in .logic.
//
// A CRT monitor with a drive beside it: drop a program's files, or the zip a
// game came in, and run it from the prompt or from the list. The keyboard,
// the mouse over the screen and the touch pads all reach the program.
//
// The layout follows the window. Wide desktops put the drive and controls
// beside the monitor, which sizes itself so the whole picture stays on
// screen; narrower windows and tablets stack them below; a phone held
// sideways becomes a handheld, pads either side of the screen.

<logic src="../logic/main.logic" />

<style>
.dos-shell {
  --pc-beige: #d8d2c4;
  --pc-beige-dark: #b8b2a4;
  --pc-bezel: #242428;
  --pc-screen: #000000;
  --pc-green: #33ff33;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
  min-height: 100%;
  padding: clamp(0.45rem, 1.1vw, 0.9rem) clamp(0.5rem, 1.8vw, 1.4rem) 0.9rem;
  background: radial-gradient(circle at 50% 0%, #2a2a32 0%, #101014 80%);
}

/* The header: title and badges left, the buttons right, wrapping as needed. */
.dos-header {
  width: 100%;
  max-width: 100rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
}

.dos-header-buttons {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.25rem;
}

/* One column by default; the side column joins on wide windows. */
.dos-layout {
  width: 100%;
  max-width: 100rem;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 1rem;
  align-items: start;
  justify-items: center;
  min-width: 0;
}

/* The monitor keeps its whole picture on screen: its width is bounded by
   what the window's height allows, screen plus bezel and chrome. */
.dos-monitor-col {
  width: 100%;
  min-width: 0;
  max-width: min(100%, calc((100vh - 20.5rem) * 1.6 + 6.5rem));
}

.dos-theater .dos-monitor-col {
  max-width: min(100%, calc((100vh - 20.5rem) * 1.6 + 6.5rem));
}

.dos-side-col {
  width: 100%;
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 0.65rem;
  align-self: stretch;
}

.dos-card {
  min-width: 0;
}

.dos-crt-monitor {
  width: 100%;
  background: #d8d2c4;
  border-radius: 16px 16px 24px 24px;
  padding: clamp(0.6rem, 1.5vw, 1.25rem) clamp(0.6rem, 1.8vw, 1.5rem) clamp(0.75rem, 1.8vw, 1.5rem);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  border: 2px solid #b8b2a4;
}

.dos-screen-bezel {
  background: #242428;
  border-radius: 12px;
  padding: clamp(0.5rem, 1.4vw, 1.25rem) clamp(0.6rem, 2vw, 1.75rem) clamp(0.6rem, 1.6vw, 1.5rem);
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dos-crt-screen {
  background: #000;
  border-radius: 6px;
  overflow: hidden;
  width: 100%;
  aspect-ratio: 320 / 200;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid #141416;
  touch-action: none;
}

.dos-crt-screen canvas {
  image-rendering: pixelated;
  image-rendering: crisp-edges;
  display: block;
}

.dos-monitor-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.5rem;
  padding: 0 0.25rem;
}

.dos-inset {
  box-shadow: inset 0 3px 6px rgba(0, 0, 0, 0.7), inset 0 -1px 1px rgba(255, 255, 255, 0.1);
}

.dos-raised {
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.45);
}

.dos-btn {
  user-select: none;
  -webkit-user-select: none;
  touch-action: none;
  cursor: pointer;
  transition: transform 60ms, background 100ms;
}

.dos-btn:active {
  transform: translateY(2px);
}

.dos-key {
  display: inline-block;
  margin: 0 0.05rem 0.2rem 0;
  font-family: ui-monospace, Menlo, Consolas, monospace;
  font-size: 0.68rem;
  padding: 0.05rem 0.35rem;
  border-radius: 4px;
  background: #2a2a34;
  border: 1px solid #444450;
  color: #d8d8e0;
  white-space: nowrap;
}

.dos-program-chip {
  font-family: ui-monospace, Menlo, Consolas, monospace;
}

/* The touch pad: a D-pad and the keys games ask for most. */
.dos-touch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
}

.dos-keypad-grid {
  display: grid;
  grid-template-columns: repeat(3, clamp(38px, 10vw, 48px));
  gap: 5px;
}

.dos-keypad-grid .dos-btn {
  padding: 0.5rem 0;
  font-size: 0.85rem;
  background: #2e2e38;
  border: 1px solid #444450;
}

.dos-action-keys {
  flex: 1;
  min-width: 150px;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

/* The handheld/mobile docks are hidden on desktop unless media queries activate them. */
.dos-pad,
.dos-mobile-bar,
.dos-handheld-top,
.dos-handheld-overlay {
  display: none;
}

.dos-mobile-bar-chip {
  font-family: ui-monospace, Menlo, Consolas, monospace;
}

.dos-thumb-cluster {
  display: grid;
  grid-template-columns: repeat(2, minmax(56px, 1fr));
  gap: 0.35rem;
}

.dos-action-btn {
  min-width: 56px;
  min-height: 44px;
  font-weight: 700;
  font-size: 0.68rem;
  border-radius: 10px;
  letter-spacing: 0.03em;
  touch-action: none;
  user-select: none;
  -webkit-user-select: none;
}

.dos-mini-pad-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.28rem;
  align-items: center;
  justify-content: center;
}

.dos-key-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0.28rem;
}

.dos-key-pill {
  min-width: 33px;
  min-height: 36px;
  padding: 0.25rem 0.45rem;
  font-family: ui-monospace, Menlo, Consolas, monospace;
  font-size: 0.7rem;
  font-weight: 700;
  border-radius: 6px;
  touch-action: none;
  user-select: none;
  -webkit-user-select: none;
}

.dos-mobile-deck {
  background: #17171e;
  border: 1px solid #30303c;
  border-radius: 10px;
  padding: 0.48rem;
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
}

.dos-pad-split {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.45rem;
}

.dos-pad-center {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  align-items: stretch;
  min-width: 58px;
}

.dos-demo-strip {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  flex-wrap: wrap;
}

/* ---------------------------------------------------------------------------
   Wide windows: the drive and controls beside the monitor.
   --------------------------------------------------------------------------- */
@media (min-width: 64rem) {
  .dos-layout {
    grid-template-columns: minmax(0, 1fr) clamp(18rem, 26vw, 24rem);
  }
  .dos-layout.dos-theater {
    grid-template-columns: minmax(0, 1fr);
  }
  .dos-card {
    padding: 0.72rem 0.9rem !important;
  }
  .dos-help {
    line-height: 1.38 !important;
    font-size: 0.62rem !important;
    margin-top: 0.35rem !important;
    margin-bottom: 0.4rem !important;
  }
  .dos-keypad-grid {
    grid-template-columns: repeat(3, clamp(34px, 3vw, 42px));
    gap: 4px;
  }
  .dos-keypad-grid .dos-btn {
    padding: 0.35rem 0;
    min-height: 34px;
  }
  .dos-theater .dos-side-col {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    max-width: calc((100vh - 20.5rem) * 1.6 + 6.5rem);
  }
}

@media (min-width: 64rem) and (max-height: 860px) {
  .dos-shell {
    padding: 0.4rem clamp(0.5rem, 1.6vw, 1.2rem) 0.45rem;
    gap: 0.45rem;
  }
  .dos-header-buttons button {
    min-height: 34px;
  }
  .dos-side-col {
    gap: 0.45rem;
  }
  .dos-card {
    padding: 0.55rem 0.78rem !important;
  }
  .dos-help {
    line-height: 1.28 !important;
    font-size: 0.59rem !important;
    margin-top: 0.25rem !important;
    margin-bottom: 0.3rem !important;
  }
  .dos-keypad-grid {
    grid-template-columns: repeat(3, 34px);
    gap: 3px;
  }
  .dos-keypad-grid .dos-btn {
    padding: 0.2rem 0;
    min-height: 28px;
    font-size: 0.75rem;
  }
  .dos-action-keys {
    gap: 0.25rem;
  }
}

/* Tablets and small desktop windows: the two cards side by side below. */
@media (min-width: 44rem) and (max-width: 63.99rem) {
  .dos-side-col {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
  .dos-desktop-only {
    display: none !important;
  }
}

/* ---------------------------------------------------------------------------
   Phones held upright.
   --------------------------------------------------------------------------- */
@media (max-width: 44rem) {
  .dos-shell {
    padding: 0.4rem 0.4rem 1.25rem !important;
    gap: 0.4rem !important;
  }
  .dos-desktop-only {
    display: none !important;
  }
  .dos-header {
    gap: 0.3rem 0.45rem;
    justify-content: space-between;
  }
  .dos-header-buttons {
    width: 100%;
    justify-content: space-between;
  }
  .dos-header-buttons button {
    min-height: 34px;
    padding: 0.2rem 0.55rem !important;
  }
  .dos-monitor-col {
    max-width: 100%;
  }
  .dos-crt-monitor {
    border-radius: 12px 12px 16px 16px;
    padding: 0.45rem !important;
    gap: 0.4rem !important;
  }
  .dos-screen-bezel {
    padding: 0.4rem 0.45rem 0.45rem !important;
  }
  .dos-monitor-brand {
    display: none !important;
  }
  .dos-monitor-bar {
    padding: 0;
  }
  .dos-demo-strip {
    width: 100%;
    flex-wrap: wrap !important;
    overflow-x: visible;
    gap: 0.22rem;
    padding-bottom: 1px;
  }
  .dos-demo-strip button {
    flex-shrink: 0;
    min-height: 28px !important;
    padding: 0.14rem 0.38rem !important;
    font-size: 0.64rem !important;
  }
  .dos-help {
    display: none;
  }
  .dos-keypad-grid {
    grid-template-columns: repeat(3, clamp(42px, 13vw, 52px));
  }
  .dos-mobile-bar {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.15rem 0.05rem 0;
  }
  .dos-mobile-bar-tabs button {
    min-height: 36px;
    min-width: 38px;
  }
  .dos-side-col {
    display: none !important;
    grid-template-columns: minmax(0, 1fr) !important;
  }
  .dos-mobile-drive .dos-side-col {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) !important;
  }
  .dos-touch-card {
    display: none !important;
  }
}

/* ---------------------------------------------------------------------------
   Phones held sideways: a handheld, pads either side of the screen + slim bar.
   --------------------------------------------------------------------------- */
@media (max-height: 32rem) and (orientation: landscape) {
  .dos-shell {
    padding: 0.2rem 0.45rem !important;
    gap: 0.25rem !important;
    min-height: 100%;
    height: 100%;
    max-height: 100dvh;
    overflow: hidden;
    justify-content: space-between;
  }
  .dos-header,
  .dos-side-col,
  .dos-monitor-label,
  .dos-monitor-bar,
  .dos-status-line,
  .dos-mobile-bar {
    display: none !important;
  }
  .dos-handheld-top {
    width: 100%;
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
    padding: 0.12rem 0.35rem;
    background: rgba(24, 24, 32, 0.92);
    border: 1px solid #30303c;
    border-radius: 8px;
    flex-shrink: 0;
  }
  .dos-handheld-top-actions {
    display: flex;
    align-items: center;
    gap: 0.22rem;
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .dos-handheld-top button {
    min-height: 28px !important;
    min-width: 28px !important;
    padding: 0.12rem 0.45rem !important;
    font-size: 0.64rem !important;
    flex-shrink: 0;
  }
  .dos-layout {
    width: 100%;
    flex: 1;
    min-height: 0;
    grid-template-columns: auto minmax(0, 1fr) auto !important;
    align-items: center !important;
    gap: 0.45rem !important;
  }
  .dos-pad {
    display: flex !important;
    flex-direction: column;
    gap: 0.22rem;
    align-items: center;
    justify-content: center;
    min-width: 132px;
    max-width: 24vw;
  }
  .dos-pad-right .dos-thumb-cluster {
    grid-template-columns: repeat(2, minmax(52px, 1fr));
    gap: 0.24rem;
  }
  .dos-pad-right .dos-action-btn {
    min-width: 52px;
    min-height: 36px;
    font-size: 0.62rem;
    padding: 0.2rem 0.28rem;
  }
  .dos-pad .dos-key-pill {
    min-width: 26px;
    min-height: 26px;
    padding: 0.08rem 0.34rem;
    font-size: 0.58rem;
  }
  .dos-monitor-col {
    max-width: none;
    display: flex;
    justify-content: center;
    align-items: center;
    min-width: 0;
    min-height: 0;
  }
  .dos-crt-monitor {
    width: auto;
    max-width: 100%;
    padding: 0.25rem 0.4rem !important;
    gap: 0 !important;
    border-radius: 10px !important;
  }
  .dos-screen-bezel {
    padding: 0.25rem !important;
    justify-content: center;
  }
  /* Size CRT from available viewport height minus SoftN chrome + handheld bar. */
  .dos-crt-screen {
    height: min(calc(100dvh - 12.2rem), 43vw);
    max-height: calc(100vh - 10.5rem);
    width: auto;
    max-width: 100%;
  }
  .dos-handheld-overlay {
    position: fixed;
    top: 3rem;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 0.4rem;
    z-index: 40;
    display: flex !important;
    align-items: center;
    justify-content: center;
    background: rgba(10, 10, 14, 0.84);
    border-radius: 10px;
    padding: 0.5rem;
  }
  .dos-handheld-modal {
    width: min(560px, 100%);
    max-height: 100%;
    overflow-y: auto;
    background: #1b1b24;
    border: 1px solid #3a3a48;
    border-radius: 10px;
    padding: 0.65rem 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
}

/* ---------------------------------------------------------------------------
   Touch Screens (Coarse Pointer)
   --------------------------------------------------------------------------- */
@media (pointer: coarse) {
  .dos-btn {
    min-height: 40px;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
}

.dos-mobile-only-inline {
  display: none !important;
}

@media (max-width: 44rem) {
  .dos-mobile-only-inline {
    display: inline-flex !important;
  }
  .dos-phone-hide {
    display: none !important;
  }
}
</style>

<App theme="dark">
  <Box className={mobileDrawer === "drive" ? "dos-shell dos-mobile-drive" : "dos-shell"}>

    // ---- Top Status Bar (Desktop & Portrait) -----------------------------
    <Box className="dos-header">
      <Stack direction="horizontal" gap="sm" align="center" style={{ flexWrap: "wrap" }}>
        <Heading level={3} style={{ color: "#e0dcd0", margin: 0, letterSpacing: "0.05em", fontSize: "clamp(1rem, 2.2vw, 1.25rem)" }}>
          SoftDOS
        </Heading>
        <Badge variant="success">{cpuModeText}</Badge>
        <Badge variant="outline" style={{ fontFamily: "monospace", fontSize: "0.72rem" }}>{fpsText}</Badge>
        #if (cyclesText !== "")
          <Badge className="dos-desktop-only" variant="outline" style={{ fontFamily: "monospace", fontSize: "0.72rem" }}>{cyclesText}</Badge>
        #end
        #if (soundText !== "")
          <Badge variant="outline" style={{ fontFamily: "monospace", fontSize: "0.72rem", color: "#7fd4ff" }}>♪ {soundText}</Badge>
        #end
      </Stack>

      <Box className="dos-header-buttons">
        // CRT Color Themes (3 discrete buttons on desktop/tablet, 1 cycle pill on phone)
        <Button className="dos-phone-hide" @click={setCrtColor} size="xs" variant={crtTheme === "color" ? "primary" : "ghost"} style={{ fontSize: "0.65rem" }}>RGB</Button>
        <Button className="dos-phone-hide" @click={setCrtGreen} size="xs" variant={crtTheme === "green" ? "primary" : "ghost"} style={{ fontSize: "0.65rem", color: "#33ff33" }}>Green</Button>
        <Button className="dos-phone-hide" @click={setCrtAmber} size="xs" variant={crtTheme === "amber" ? "primary" : "ghost"} style={{ fontSize: "0.65rem", color: "#ffaa22" }}>Amber</Button>
        <Button className="dos-mobile-only-inline" @click={toggleCrtTheme} size="xs" variant="outline" style={{ fontSize: "0.65rem", color: crtTheme === "green" ? "#33ff33" : crtTheme === "amber" ? "#ffaa22" : "#e0dcd0" }}>
          {crtTheme === "green" ? "CRT: Green" : crtTheme === "amber" ? "CRT: Amber" : "CRT: RGB"}
        </Button>

        <Button className="dos-desktop-only" @click={toggleExpanded} size="xs" variant="ghost" style={{ fontSize: "0.65rem", marginLeft: "0.25rem" }}>
          {isExpanded ? "Standard View" : "Theater Mode"}
        </Button>
        <Button @click={togglePause} variant="ghost" size="xs" style={{ fontSize: "0.65rem" }}>
          {isRunning ? "Pause" : "Resume"}
        </Button>
        <Button @click={toggleMute} variant="ghost" size="xs" style={{ fontSize: "0.65rem" }}>
          {isMuted ? "Unmute" : "Mute"}
        </Button>
        <Button @click={launchShell} variant="ghost" size="xs" style={{ fontSize: "0.65rem" }}>
          Reboot DOS
        </Button>
      </Box>
    </Box>

    // ---- Handheld Top Utility Bar (Landscape Phone Only) -----------------
    <Box className="dos-handheld-top">
      <Stack direction="horizontal" gap="xs" align="center">
        <Text style={{ color: "#e0dcd0", fontWeight: 700, fontSize: "0.72rem", letterSpacing: "0.04em" }}>SoftDOS</Text>
        <Badge variant="success" style={{ fontSize: "0.58rem", padding: "0.08rem 0.35rem" }}>{cpuModeText}</Badge>
        <Button @click={launchFastDoom} size="xs" variant="primary" style={{ background: "#b91c1c", borderColor: "#ef4444", color: "#fff" }}>
          {doomLoading ? ("DOOM " + doomLoadPct + "%") : "▶ DOOM"}
        </Button>
        #if (customProgName !== "" && customProgName !== "FDOOM.EXE")
          <Button @click={launchCustomProg} size="xs" variant="outline">▶ {customProgName}</Button>
        #end
        #if (activeMode === "custom")
          <Button @click={quitToDos} size="xs" variant="outline">Quit</Button>
        #end
      </Stack>

      <Box className="dos-handheld-top-actions">
        <Button @click={() => setMobileDrawer("drive")} size="xs" variant={mobileDrawer === "drive" ? "primary" : "secondary"}>C:</Button>
        <Button @click={() => setMobileDrawer("demos")} size="xs" variant={mobileDrawer === "demos" ? "primary" : "outline"}>Demos</Button>
        <Button @click={() => setMobileDrawer("keys")} size="xs" variant={mobileDrawer === "keys" ? "primary" : "outline"}>Keys</Button>
        <Button @click={() => setMobileDrawer("cmd")} size="xs" variant={mobileDrawer === "cmd" ? "primary" : "outline"}>Cmd</Button>
        <Button @click={toggleCrtTheme} size="xs" variant="ghost" style={{ color: crtTheme === "green" ? "#33ff33" : crtTheme === "amber" ? "#ffaa22" : "#d8d8e4" }}>
          {crtTheme === "green" ? "GRN" : crtTheme === "amber" ? "AMB" : "RGB"}
        </Button>
        <Button @click={toggleMute} size="xs" variant={isMuted ? "outline" : "ghost"}>{isMuted ? "Muted" : "Audio"}</Button>
        <Button @click={togglePause} size="xs" variant={isRunning ? "ghost" : "primary"}>{isRunning ? "Pause" : "Resume"}</Button>
        <Button @click={launchShell} size="xs" variant="ghost">Reset</Button>
      </Box>
    </Box>

    <Box className={isExpanded ? "dos-layout dos-theater" : "dos-layout"}>

      // Left Handheld Pod (Phone Landscape): Esc/Tab + D-Pad + Y/N/RunLock
      <Box className="dos-pad dos-pad-left">
        <Box className="dos-mini-pad-row">
          <Button className="dos-btn dos-key-pill" @pointerdown={pressEsc} @pointerup={releaseEsc} @pointerleave={releaseEsc} @pointercancel={releaseEsc} variant="ghost" style={{ background: "#25252e" }}>ESC</Button>
          <Button className="dos-btn dos-key-pill" @pointerdown={pressTab} @pointerup={releaseTab} @pointerleave={releaseTab} @pointercancel={releaseTab} variant="ghost" style={{ background: "#25252e" }}>TAB</Button>
        </Box>
        <DPad @press={dpadPress} @release={dpadRelease} buttonSize={36} color="#2c2c38" />
        <Box className="dos-mini-pad-row">
          <Button className="dos-btn dos-key-pill" @pointerdown={pressKeyY} @pointerup={releaseKeyY} @pointerleave={releaseKeyY} @pointercancel={releaseKeyY} variant="ghost" style={{ background: "#25252e" }}>Y</Button>
          <Button className="dos-btn dos-key-pill" @pointerdown={pressKeyN} @pointerup={releaseKeyN} @pointerleave={releaseKeyN} @pointercancel={releaseKeyN} variant="ghost" style={{ background: "#25252e" }}>N</Button>
          <Button @click={toggleAutoRun} size="xs" variant={autoRunLock ? "primary" : "ghost"} style={{ background: autoRunLock ? undefined : "#25252e", fontSize: "0.58rem", minHeight: "26px" }}>
            {autoRunLock ? "Run ON" : "Run"}
          </Button>
        </Box>
      </Box>

      // ---- The CRT Monitor -----------------------------------------------
      <Box className="dos-monitor-col">
        <Box className="dos-raised dos-crt-monitor">

          // Screen Bezel
          <Box className="dos-inset dos-screen-bezel">

            // Monitor Brand & Model
            <Stack direction="horizontal" className="dos-monitor-label" style={{ width: "100%", justifyContent: "space-between", marginBottom: "0.4rem" }}>
              <Text style={{ fontSize: "0.65rem", color: "#888890", letterSpacing: "0.15em", fontWeight: 700 }}>VGA MULTISYNC COLOR</Text>
              <Text style={{ fontSize: "0.65rem", color: "#888890", letterSpacing: "0.1em" }}>{loadedFileName ? loadedFileName : "DRIVE C"}</Text>
            </Stack>

            // CRT Glass Tube Container. Pointer over it drives DOS mouse or Drag Turn.
            <Box className="dos-crt-screen"
              @pointermove={mouseMove} @pointerdown={mouseDown} @pointerup={mouseUp}
              @pointerleave={mouseLeave} @pointercancel={mouseLeave}
              style={{
                cursor: mouseCursorStyle,
                boxShadow: crtTheme === "green" ? "0 0 24px rgba(51,255,51,0.18)" : crtTheme === "amber" ? "0 0 24px rgba(255,170,34,0.18)" : "0 0 24px rgba(51,255,51,0.08)"
              }}>
              <PixelCanvas
                width={320}
                height={200}
                fit="contain"
                getFrame={frameSource}
                running={isRunning}
                smooth={false}
                @fps={fpsReport}
                style={{ width: "100%", height: "100%" }}
              />
            </Box>

            // Monitor Bezel Bottom Badge & Status
            <Stack direction="horizontal" align="center" className="dos-status-line" style={{ width: "100%", justifyContent: "space-between", marginTop: "0.5rem", gap: "0.5rem" }}>
              <Text style={{ fontSize: "0.62rem", color: "#888894", letterSpacing: "0.08em", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{statusText}</Text>
              <Stack direction="horizontal" gap="xs" align="center">
                <Box style={{ width: "8px", height: "8px", borderRadius: "50%", background: isRunning ? "#33ff33" : "#ff3333", boxShadow: isRunning ? "0 0 6px #33ff33" : "none" }} />
                <Text style={{ fontSize: "0.55rem", color: "#888890", fontWeight: 700 }}>PWR</Text>
              </Stack>
            </Stack>
          </Box>

          // Monitor Bottom: the prompt, a way out of a program, and the demos.
          <Box className="dos-monitor-bar">
            <Text className="dos-monitor-brand" style={{ fontSize: "0.75rem", fontWeight: 700, color: "#686458", letterSpacing: "0.1em" }}>SoftDOS / 486</Text>
            <Box className="dos-demo-strip">
              <Button @click={launchFastDoom} size="sm" variant="primary" style={{ fontSize: "0.7rem", background: "#b91c1c", borderColor: "#ef4444", color: "#fff" }}>
                {doomLoading ? ("FastDOOM " + doomLoadPct + "%") : "▶ FastDOOM"}
              </Button>
              #if (customProgName !== "" && customProgName !== "FDOOM.EXE")
                <Button @click={launchCustomProg} size="sm" variant="primary" style={{ fontSize: "0.7rem" }}>▶ {customProgName}</Button>
              #end
              <Button @click={launchShell} size="sm" variant="outline" style={{ fontSize: "0.7rem", background: "#eae6dc" }}>C:\ Prompt</Button>
              #if (activeMode === "custom")
                <Button @click={quitToDos} size="sm" variant="primary" style={{ fontSize: "0.7rem" }}>Quit to DOS</Button>
              #end
              <Button @click={launchPlasma} size="sm" variant="outline" style={{ fontSize: "0.7rem", background: "#eae6dc" }}>PLASMA</Button>
              <Button @click={launchMandel} size="sm" variant="outline" style={{ fontSize: "0.7rem", background: "#eae6dc" }}>MANDEL</Button>
              <Button @click={launchBoxes} size="sm" variant="outline" style={{ fontSize: "0.7rem", background: "#eae6dc" }}>BOXES</Button>
              <Button @click={launchRaycast} size="sm" variant="outline" style={{ fontSize: "0.7rem", background: "#eae6dc" }}>3D demo</Button>
            </Box>
          </Box>

          // Portrait Mobile Command Bar & Controller Dock
          <Box className="dos-mobile-bar">
            <Stack direction="horizontal" gap="xs" align="center" style={{ flexWrap: "nowrap" }}>
              <Button @click={toggleMobileInputMode} size="sm" variant="outline" style={{ fontSize: "0.68rem", padding: "0 0.45rem", flexShrink: 0, background: "#20202a", color: "#d8d8e4" }}>
                {mobileInputMode === "live" ? "Live" : "Cmd"}
              </Button>
              #if (mobileInputMode === "cmd")
                <Input :bind={mobileCmd} placeholder="DOS cmd (dir, cls, ver…)" size="sm" style={{ flex: 1, minWidth: "90px", background: "#141418", color: "#e8e4d8", border: "1px solid #444" }} />
                <Button @click={sendMobileCommand} size="sm" variant="primary" style={{ flexShrink: 0 }}>Run</Button>
              #else
                <Input value={mobileLiveText} @change={onLiveKeyInput} placeholder="Tap to type live DOS keys…" size="sm" style={{ flex: 1, minWidth: "90px", background: "#141418", color: "#e8e4d8", border: "1px solid #4a7c59" }} />
                <Button @click={liveTapBksp} size="sm" variant="outline" style={{ flexShrink: 0 }}>⌫</Button>
                <Button @click={liveTapEnter} size="sm" variant="primary" style={{ flexShrink: 0 }}>↵</Button>
              #end
              <Stack className="dos-mobile-bar-tabs" direction="horizontal" gap="xs" style={{ flexShrink: 0 }}>
                <Button @click={() => setMobileDrawer("pad")} size="sm" variant={mobileDrawer === "pad" ? "primary" : "secondary"}>Pad</Button>
                <Button @click={() => setMobileDrawer("keys")} size="sm" variant={mobileDrawer === "keys" ? "primary" : "secondary"}>Keys</Button>
                <Button @click={() => setMobileDrawer("drive")} size="sm" variant={mobileDrawer === "drive" ? "primary" : "secondary"}>C:</Button>
              </Stack>
            </Stack>

            // Portrait Dock 1: Two-Thumb Gamepad Deck
            <Box if={mobileDrawer === "pad"} className="dos-mobile-deck">
              <Stack direction="horizontal" gap="xs" align="center" style={{ justifyContent: "space-between", flexWrap: "nowrap" }}>
                <Button @click={toggleScreenTouchMode} size="xs" variant={screenTouchMode === "drag" ? "primary" : "ghost"} style={{ background: screenTouchMode === "drag" ? undefined : "#252530", fontSize: "0.6rem", padding: "0.15rem 0.4rem", minHeight: "30px" }}>
                  {screenTouchMode === "drag" ? "Drag Look" : "Direct Tap"}
                </Button>
                <Button @click={toggleAutoRun} size="xs" variant={autoRunLock ? "primary" : "ghost"} style={{ background: autoRunLock ? undefined : "#252530", fontSize: "0.6rem", padding: "0.15rem 0.4rem", minHeight: "30px" }}>
                  {autoRunLock ? "RunLock ON" : "RunLock"}
                </Button>
                <Button className="dos-btn dos-key-pill" @pointerdown={pressTab} @pointerup={releaseTab} @pointerleave={releaseTab} @pointercancel={releaseTab} variant="outline" style={{ background: "#252530", minHeight: "30px", minWidth: "36px" }}>TAB</Button>
                <Button className="dos-btn dos-key-pill" @pointerdown={pressKeyY} @pointerup={releaseKeyY} @pointerleave={releaseKeyY} @pointercancel={releaseKeyY} variant="outline" style={{ background: "#252530", minHeight: "30px", minWidth: "30px" }}>Y</Button>
                <Button className="dos-btn dos-key-pill" @pointerdown={pressKeyN} @pointerup={releaseKeyN} @pointerleave={releaseKeyN} @pointercancel={releaseKeyN} variant="outline" style={{ background: "#252530", minHeight: "30px", minWidth: "30px" }}>N</Button>
              </Stack>

              <Box className="dos-pad-split">
                <DPad @press={dpadPress} @release={dpadRelease} buttonSize={44} color="#2c2c38" />

                <Box className="dos-pad-center">
                  <Button className="dos-btn" @pointerdown={pressEsc} @pointerup={releaseEsc} @pointerleave={releaseEsc} @pointercancel={releaseEsc} size="xs" variant="ghost" style={{ background: "#262632", fontSize: "0.66rem", minHeight: "34px" }}>ESC</Button>
                  <Button className="dos-btn" @pointerdown={pressEnter} @pointerup={releaseEnter} @pointerleave={releaseEnter} @pointercancel={releaseEnter} size="xs" variant="outline" style={{ background: "#262632", fontSize: "0.66rem", minHeight: "34px" }}>ENTER</Button>
                  <Button @click={toggleTouchRightClick} size="xs" variant={touchRightClick ? "primary" : "ghost"} style={{ background: touchRightClick ? undefined : "#262632", fontSize: "0.6rem", minHeight: "32px" }}>
                    {touchRightClick ? "R-Click ON" : "L-Click"}
                  </Button>
                </Box>

                <Box className="dos-thumb-cluster">
                  <Button className="dos-btn dos-action-btn" @pointerdown={pressUse} @pointerup={releaseUse} @pointerleave={releaseUse} @pointercancel={releaseUse} variant="outline" style={{ background: "#2e2e3a" }}>USE</Button>
                  <Button className="dos-btn dos-action-btn" @pointerdown={pressFire} @pointerup={releaseFire} @pointerleave={releaseFire} @pointercancel={releaseFire} variant="primary">FIRE</Button>
                  <Button className="dos-btn dos-action-btn" @pointerdown={pressShift} @pointerup={releaseShift} @pointerleave={releaseShift} @pointercancel={releaseShift} variant="outline" style={{ background: "#262632" }}>RUN</Button>
                  <Button className="dos-btn dos-action-btn" @pointerdown={pressAlt} @pointerup={releaseAlt} @pointerleave={releaseAlt} @pointercancel={releaseAlt} variant="outline" style={{ background: "#262632" }}>STRAFE</Button>
                </Box>
              </Box>
            </Box>

            // Portrait Dock 2: Full DOS Keys, Weapons & Quick Commands
            <Box if={mobileDrawer === "keys"} className="dos-mobile-deck">
              <Box className="dos-key-grid">
                <Button className="dos-btn dos-key-pill" @click={() => tapVKey("1")} variant="outline" style={{ background: "#262632" }}>1</Button>
                <Button className="dos-btn dos-key-pill" @click={() => tapVKey("2")} variant="outline" style={{ background: "#262632" }}>2</Button>
                <Button className="dos-btn dos-key-pill" @click={() => tapVKey("3")} variant="outline" style={{ background: "#262632" }}>3</Button>
                <Button className="dos-btn dos-key-pill" @click={() => tapVKey("4")} variant="outline" style={{ background: "#262632" }}>4</Button>
                <Button className="dos-btn dos-key-pill" @click={() => tapVKey("5")} variant="outline" style={{ background: "#262632" }}>5</Button>
                <Button className="dos-btn dos-key-pill" @click={() => tapVKey("6")} variant="outline" style={{ background: "#262632" }}>6</Button>
                <Button className="dos-btn dos-key-pill" @click={() => tapVKey("7")} variant="outline" style={{ background: "#262632" }}>7</Button>
                <Button className="dos-btn dos-key-pill" @click={() => tapVKey("8")} variant="outline" style={{ background: "#262632" }}>8</Button>
                <Button className="dos-btn dos-key-pill" @click={() => tapVKey("9")} variant="outline" style={{ background: "#262632" }}>9</Button>
                <Button className="dos-btn dos-key-pill" @click={() => tapVKey("0")} variant="outline" style={{ background: "#262632" }}>0</Button>
              </Box>
              <Box className="dos-key-grid">
                <Button className="dos-btn dos-key-pill" @click={() => tapVKey("F1")} variant="ghost" style={{ background: "#262632" }}>F1</Button>
                <Button className="dos-btn dos-key-pill" @click={() => tapVKey("F2")} variant="ghost" style={{ background: "#262632" }}>F2</Button>
                <Button className="dos-btn dos-key-pill" @click={() => tapVKey("F3")} variant="ghost" style={{ background: "#262632" }}>F3</Button>
                <Button className="dos-btn dos-key-pill" @click={() => tapVKey("F4")} variant="ghost" style={{ background: "#262632" }}>F4</Button>
                <Button className="dos-btn dos-key-pill" @click={() => tapVKey("F5")} variant="ghost" style={{ background: "#262632" }}>F5</Button>
                <Button className="dos-btn dos-key-pill" @click={() => tapVKey("F10")} variant="ghost" style={{ background: "#262632" }}>F10</Button>
                <Button className="dos-btn dos-key-pill" @pointerdown={pressBksp} @pointerup={releaseBksp} @pointerleave={releaseBksp} @pointercancel={releaseBksp} variant="outline" style={{ background: "#262632" }}>BKSP</Button>
                <Button className="dos-btn dos-key-pill" @pointerdown={pressEnter} @pointerup={releaseEnter} @pointerleave={releaseEnter} @pointercancel={releaseEnter} variant="primary">ENT</Button>
              </Box>
              <Box className="dos-key-grid">
                <Button className="dos-btn dos-key-pill" @pointerdown={pressEsc} @pointerup={releaseEsc} @pointerleave={releaseEsc} @pointercancel={releaseEsc} variant="outline" style={{ background: "#262632" }}>ESC</Button>
                <Button className="dos-btn dos-key-pill" @pointerdown={pressTab} @pointerup={releaseTab} @pointerleave={releaseTab} @pointercancel={releaseTab} variant="outline" style={{ background: "#262632" }}>TAB</Button>
                <Button className="dos-btn dos-key-pill" @pointerdown={pressShift} @pointerup={releaseShift} @pointerleave={releaseShift} @pointercancel={releaseShift} variant="outline" style={{ background: "#262632" }}>SHIFT</Button>
                <Button className="dos-btn dos-key-pill" @pointerdown={pressAlt} @pointerup={releaseAlt} @pointerleave={releaseAlt} @pointercancel={releaseAlt} variant="outline" style={{ background: "#262632" }}>ALT</Button>
                <Button className="dos-btn dos-key-pill" @pointerdown={pressFire} @pointerup={releaseFire} @pointerleave={releaseFire} @pointercancel={releaseFire} variant="primary">CTRL</Button>
                <Button className="dos-btn dos-key-pill" @pointerdown={pressUse} @pointerup={releaseUse} @pointerleave={releaseUse} @pointercancel={releaseUse} variant="outline" style={{ background: "#262632" }}>SPC</Button>
                <Button className="dos-btn dos-key-pill" @pointerdown={pressKeyY} @pointerup={releaseKeyY} @pointerleave={releaseKeyY} @pointercancel={releaseKeyY} variant="outline" style={{ background: "#262632" }}>Y</Button>
                <Button className="dos-btn dos-key-pill" @pointerdown={pressKeyN} @pointerup={releaseKeyN} @pointerleave={releaseKeyN} @pointercancel={releaseKeyN} variant="outline" style={{ background: "#262632" }}>N</Button>
                <Button className="dos-btn dos-key-pill" @click={() => tapVKey("+")} variant="outline" style={{ background: "#262632" }}>+</Button>
                <Button className="dos-btn dos-key-pill" @click={() => tapVKey("-")} variant="outline" style={{ background: "#262632" }}>-</Button>
              </Box>
              <Box className="dos-key-grid">
                <Button className="dos-key-pill" @click={() => sendQuickCmd("DIR")} variant="ghost" style={{ background: "#22222c" }}>DIR</Button>
                <Button className="dos-key-pill" @click={() => sendQuickCmd("CLS")} variant="ghost" style={{ background: "#22222c" }}>CLS</Button>
                <Button className="dos-key-pill" @click={() => sendQuickCmd("VER")} variant="ghost" style={{ background: "#22222c" }}>VER</Button>
                <Button className="dos-key-pill" @click={() => sendQuickCmd("HELP")} variant="ghost" style={{ background: "#22222c" }}>HELP</Button>
                <Button className="dos-key-pill" @click={toggleScreenTouchMode} variant={screenTouchMode === "drag" ? "primary" : "ghost"} style={{ background: screenTouchMode === "drag" ? undefined : "#22222c" }}>
                  {screenTouchMode === "drag" ? "Touch: Drag" : "Touch: Direct"}
                </Button>
                <Button className="dos-key-pill" @click={toggleTouchRightClick} variant={touchRightClick ? "primary" : "ghost"} style={{ background: touchRightClick ? undefined : "#22222c" }}>
                  {touchRightClick ? "R-Click ON" : "L-Click"}
                </Button>
              </Box>
            </Box>
          </Box>
        </Box>
      </Box>

      // Right Handheld Pod (Phone Landscape): 1/2/3/ENT + 2x2 Thumb Cluster + Touch Mode
      <Box className="dos-pad dos-pad-right">
        <Box className="dos-mini-pad-row">
          <Button className="dos-btn dos-key-pill" @click={() => tapVKey("1")} variant="outline" style={{ background: "#25252e" }}>1</Button>
          <Button className="dos-btn dos-key-pill" @click={() => tapVKey("2")} variant="outline" style={{ background: "#25252e" }}>2</Button>
          <Button className="dos-btn dos-key-pill" @click={() => tapVKey("3")} variant="outline" style={{ background: "#25252e" }}>3</Button>
          <Button className="dos-btn dos-key-pill" @pointerdown={pressEnter} @pointerup={releaseEnter} @pointerleave={releaseEnter} @pointercancel={releaseEnter} variant="ghost" style={{ background: "#25252e" }}>ENT</Button>
        </Box>
        <Box className="dos-thumb-cluster">
          <Button className="dos-btn dos-action-btn" @pointerdown={pressUse} @pointerup={releaseUse} @pointerleave={releaseUse} @pointercancel={releaseUse} variant="outline" style={{ background: "#2e2e38" }}>USE</Button>
          <Button className="dos-btn dos-action-btn" @pointerdown={pressFire} @pointerup={releaseFire} @pointerleave={releaseFire} @pointercancel={releaseFire} variant="primary">FIRE</Button>
          <Button className="dos-btn dos-action-btn" @pointerdown={pressShift} @pointerup={releaseShift} @pointerleave={releaseShift} @pointercancel={releaseShift} variant="outline" style={{ background: "#25252e" }}>RUN</Button>
          <Button className="dos-btn dos-action-btn" @pointerdown={pressAlt} @pointerup={releaseAlt} @pointerleave={releaseAlt} @pointercancel={releaseAlt} variant="outline" style={{ background: "#25252e" }}>STRF</Button>
        </Box>
        <Box className="dos-mini-pad-row">
          <Button @click={toggleScreenTouchMode} size="xs" variant={screenTouchMode === "drag" ? "primary" : "ghost"} style={{ background: screenTouchMode === "drag" ? undefined : "#25252e", fontSize: "0.58rem" }}>
            {screenTouchMode === "drag" ? "Drag Look" : "Direct Tap"}
          </Button>
          <Button className="dos-btn dos-key-pill" @pointerdown={pressF1} @pointerup={releaseF1} @pointerleave={releaseF1} @pointercancel={releaseF1} variant="ghost" style={{ background: "#25252e" }}>F1</Button>
        </Box>
      </Box>

      // ---- Drive C and Desktop Touch Card ---------------------------------
      <Box className="dos-side-col">

        // Drive C: files in, programs out.
        <Card className="dos-card dos-drive-card" style={{ background: "#1c1c22", borderColor: "#33333c", padding: "1rem" }}>
          <Stack direction="horizontal" align="center" style={{ justifyContent: "space-between", marginBottom: "0.5rem" }}>
            <Text style={{ fontSize: "0.75rem", fontWeight: 700, color: "#a8a8b4", letterSpacing: "0.08em" }}>DRIVE C</Text>
            <Text style={{ fontSize: "0.65rem", color: "#787884" }}>{driveFileCount} file(s)</Text>
          </Stack>
          <FileChooser
            accept=".exe,.com,.zip,.bat,.dat,.wad,*"
            label="Add a game's files, or its zip"
            multiple={true}
            @select={chooseFiles}
          />
          <Button @click={launchFastDoom} size="sm" variant="primary" style={{ width: "100%", marginTop: "0.5rem", background: "#b91c1c", borderColor: "#ef4444", color: "#fff" }}>
            {doomLoading ? ("Loading FastDOOM (" + doomLoadPct + "%)…") : "▶ Play FastDOOM (Freedoom Phase 1)"}
          </Button>
          #if (customProgName !== "" && customProgName !== "FDOOM.EXE")
            <Button @click={launchCustomProg} size="sm" variant="primary" style={{ width: "100%", marginTop: "0.4rem" }}>
              ▶ Launch {customProgName}
            </Button>
          #end
          <Text className="dos-help" style={{ display: "block", fontSize: "0.65rem", color: "#787884", marginTop: "0.5rem", lineHeight: 1.45 }}>
            Everything lands on drive C, a zip unpacked. Then type the program's name at the
            prompt, or press it below. 16-bit .COM and .EXE programs run on the emulated CPU,
            and so do 32-bit DOS-extender images (DOS/4GW and the like). A program keeps its
            configuration and saved games on the drive for as long as the page is open. Sound
            comes through an AdLib, a Sound Blaster at 220/7/1 and the speaker; a game's setup
            program will find them. DOOM / FastDOOM gets a DEFAULT.CFG with sound on if it has none.
            Includes bundled open-source FastDOOM v1.3.0 (GPLv2, github.com/viti95/FastDoom) and
            Freedoom: Phase 1 v0.13.0 (Modified BSD-3-Clause, freedoom.github.io); notices under assets/fd/.
          </Text>

          #if (programList.length > 0)
            <Text style={{ display: "block", fontSize: "0.65rem", fontWeight: 700, color: "#a8a8b4", marginTop: "0.75rem", marginBottom: "0.35rem", letterSpacing: "0.08em" }}>PROGRAMS</Text>
            <Stack direction="horizontal" gap="xs" style={{ flexWrap: "wrap" }}>
              #each (name in programList)
                <Button className="dos-program-chip" @click={runListed(name)} size="xs" variant="outline" style={{ fontSize: "0.68rem", background: "#25252e" }}>{name}</Button>
              #end
            </Stack>
          #end
        </Card>

        // Desktop/Tablet keyboard docs + quick touch pad (hidden in < 44rem portrait drawer).
        <Card className="dos-card dos-touch-card" style={{ background: "#1c1c22", borderColor: "#33333c", padding: "1rem" }}>
          <Text style={{ fontSize: "0.75rem", fontWeight: 700, color: "#a8a8b4", marginBottom: "0.5rem", letterSpacing: "0.08em" }}>KEYBOARD, MOUSE & TOUCH</Text>

          <Text className="dos-help" style={{ display: "block", fontSize: "0.65rem", color: "#787884", lineHeight: 1.7, marginBottom: "0.6rem" }}>
            The keyboard goes to the program while the page has focus: letters, digits,
            <Text className="dos-key">Arrows</Text> <Text className="dos-key">Space</Text> <Text className="dos-key">Ctrl</Text> <Text className="dos-key">Alt</Text> <Text className="dos-key">Shift</Text> <Text className="dos-key">Enter</Text> <Text className="dos-key">Esc</Text> <Text className="dos-key">Tab</Text> <Text className="dos-key">F1</Text>–<Text className="dos-key">F10</Text>.
            The browser keeps F11, F12 and its Ctrl shortcuts. The mouse works over the screen for
            programs that use one. Esc reaches the program; Quit to DOS, under the monitor, leaves it.
          </Text>

          <Box className="dos-touch">
            <Box className="dos-keypad-grid">
              <Box />
              <Button className="dos-btn" @pointerdown={pressUp} @pointerup={releaseUp} @pointerleave={releaseUp} @pointercancel={releaseUp} ariaLabel="Up">▲</Button>
              <Box />
              <Button className="dos-btn" @pointerdown={pressLeft} @pointerup={releaseLeft} @pointerleave={releaseLeft} @pointercancel={releaseLeft} ariaLabel="Left">◀</Button>
              <Button className="dos-btn" @pointerdown={pressDown} @pointerup={releaseDown} @pointerleave={releaseDown} @pointercancel={releaseDown} ariaLabel="Down">▼</Button>
              <Button className="dos-btn" @pointerdown={pressRight} @pointerup={releaseRight} @pointerleave={releaseRight} @pointercancel={releaseRight} ariaLabel="Right">▶</Button>
            </Box>

            <Box className="dos-action-keys">
              <Stack direction="horizontal" gap="xs">
                <Button className="dos-btn" @pointerdown={pressFire} @pointerup={releaseFire} @pointerleave={releaseFire} @pointercancel={releaseFire} variant="primary" style={{ flex: 1, padding: "0.6rem 0.5rem", borderRadius: "6px", fontWeight: 700, fontSize: "0.75rem" }}>CTRL</Button>
                <Button className="dos-btn" @pointerdown={pressAlt} @pointerup={releaseAlt} @pointerleave={releaseAlt} @pointercancel={releaseAlt} variant="outline" style={{ flex: 1, padding: "0.6rem 0.5rem", borderRadius: "6px", fontWeight: 700, fontSize: "0.75rem", background: "#2e2e38" }}>ALT</Button>
                <Button className="dos-btn" @pointerdown={pressUse} @pointerup={releaseUse} @pointerleave={releaseUse} @pointercancel={releaseUse} variant="outline" style={{ flex: 1, padding: "0.6rem 0.5rem", borderRadius: "6px", fontWeight: 700, fontSize: "0.75rem", background: "#2e2e38" }}>SPACE</Button>
              </Stack>

              <Stack direction="horizontal" gap="xs" style={{ flexWrap: "wrap" }}>
                <Button className="dos-btn" @pointerdown={pressShift} @pointerup={releaseShift} @pointerleave={releaseShift} @pointercancel={releaseShift} size="xs" variant="ghost" style={{ flex: 0.9, fontSize: "0.65rem", background: "#25252e" }}>SHIFT</Button>
                <Button className="dos-btn" @pointerdown={pressEsc} @pointerup={releaseEsc} @pointerleave={releaseEsc} @pointercancel={releaseEsc} size="xs" variant="ghost" style={{ flex: 1, fontSize: "0.65rem", background: "#25252e" }}>ESC</Button>
                <Button className="dos-btn" @pointerdown={pressEnter} @pointerup={releaseEnter} @pointerleave={releaseEnter} @pointercancel={releaseEnter} size="xs" variant="ghost" style={{ flex: 1, fontSize: "0.65rem", background: "#25252e" }}>ENTER</Button>
                <Button className="dos-btn" @pointerdown={pressTab} @pointerup={releaseTab} @pointerleave={releaseTab} @pointercancel={releaseTab} size="xs" variant="ghost" style={{ flex: 0.8, fontSize: "0.65rem", background: "#25252e" }}>TAB</Button>
                <Button className="dos-btn" @pointerdown={pressF1} @pointerup={releaseF1} @pointerleave={releaseF1} @pointercancel={releaseF1} size="xs" variant="ghost" style={{ flex: 0.7, fontSize: "0.65rem", background: "#25252e" }}>F1</Button>
                <Button className="dos-btn" @pointerdown={pressKeyY} @pointerup={releaseKeyY} @pointerleave={releaseKeyY} @pointercancel={releaseKeyY} size="xs" variant="ghost" style={{ flex: 0.6, fontSize: "0.65rem", background: "#25252e" }}>Y</Button>
                <Button className="dos-btn" @pointerdown={pressKeyN} @pointerup={releaseKeyN} @pointerleave={releaseKeyN} @pointercancel={releaseKeyN} size="xs" variant="ghost" style={{ flex: 0.6, fontSize: "0.65rem", background: "#25252e" }}>N</Button>
              </Stack>
            </Box>
          </Box>
        </Card>
      </Box>
    </Box>

    // ---- Landscape Handheld Modal Overlay (C:, Demos, Keys, Cmd) ---------
    <Box if={mobileDrawer === "drive" || mobileDrawer === "demos" || mobileDrawer === "keys" || mobileDrawer === "cmd"} className="dos-handheld-overlay">
      <Box className="dos-handheld-modal">
        <Stack direction="horizontal" align="center" style={{ justifyContent: "space-between" }}>
          <Text style={{ color: "#e8e4d8", fontWeight: 700, fontSize: "0.82rem", letterSpacing: "0.06em" }}>
            {mobileDrawer === "drive" ? "DRIVE C & GAME FILES" : mobileDrawer === "demos" ? "BUILT-IN PROGRAMS & DEMOS" : mobileDrawer === "keys" ? "DOS KEYPAD" : "DOS COMMAND / LIVE KEYBOARD"}
          </Text>
          <Button @click={closeHandheldOverlay} size="xs" variant="secondary">Close</Button>
        </Stack>

        <Box if={mobileDrawer === "drive"} style={{ display: "flex", flexDirection: "column", gap: "0.5rem" }}>
          <FileChooser
            accept=".exe,.com,.zip,.bat,.dat,.wad,*"
            label="Add a game's files, or its zip"
            multiple={true}
            @select={chooseFiles}
          />
          <Button @click={launchFastDoom} size="sm" variant="primary" style={{ background: "#b91c1c", borderColor: "#ef4444", color: "#fff" }}>
            {doomLoading ? ("Loading FastDOOM (" + doomLoadPct + "%)…") : "▶ Play FastDOOM (Freedoom)"}
          </Button>
          #if (customProgName !== "" && customProgName !== "FDOOM.EXE")
            <Button @click={launchCustomProg} size="sm" variant="primary">▶ Launch {customProgName}</Button>
          #end
          <Text style={{ fontSize: "0.68rem", color: "#9898a8", lineHeight: 1.4 }}>
            Zips unpack onto Drive C ({driveFileCount} files). Includes FastDOOM 1.3.0 (GPLv2) + Freedoom Phase 1 0.13.0 (BSD-3-Clause) with Sound Blaster + AdLib DEFAULT.CFG.
          </Text>
          #if (programList.length > 0)
            <Stack direction="horizontal" gap="xs" style={{ flexWrap: "wrap" }}>
              #each (name in programList)
                <Button className="dos-program-chip" @click={runListed(name)} size="xs" variant="outline" style={{ fontSize: "0.68rem", background: "#25252e" }}>{name}</Button>
              #end
            </Stack>
          #end
        </Box>

        <Box if={mobileDrawer === "demos"} style={{ display: "flex", flexDirection: "column", gap: "0.5rem" }}>
          <Stack direction="horizontal" gap="xs" style={{ flexWrap: "wrap" }}>
            <Button @click={launchFastDoom} size="sm" variant="primary" style={{ background: "#b91c1c", borderColor: "#ef4444", color: "#fff" }}>
              {doomLoading ? ("FastDOOM " + doomLoadPct + "%") : "▶ FastDOOM"}
            </Button>
            #if (customProgName !== "" && customProgName !== "FDOOM.EXE")
              <Button @click={launchCustomProg} size="sm" variant="primary">▶ {customProgName}</Button>
            #end
            <Button @click={launchShell} size="sm" variant="outline">C:\ Prompt</Button>
            #if (activeMode === "custom")
              <Button @click={quitToDos} size="sm" variant="primary">Quit to DOS</Button>
            #end
            <Button @click={launchPlasma} size="sm" variant="outline">PLASMA</Button>
            <Button @click={launchMandel} size="sm" variant="outline">MANDEL</Button>
            <Button @click={launchBoxes} size="sm" variant="outline">BOXES</Button>
            <Button @click={launchRaycast} size="sm" variant="outline">3D demo</Button>
          </Stack>
        </Box>

        <Box if={mobileDrawer === "keys"} style={{ display: "flex", flexDirection: "column", gap: "0.4rem" }}>
          <Box className="dos-key-grid">
            <Button className="dos-btn dos-key-pill" @click={() => tapVKey("1")} variant="outline" style={{ background: "#262632" }}>1</Button>
            <Button className="dos-btn dos-key-pill" @click={() => tapVKey("2")} variant="outline" style={{ background: "#262632" }}>2</Button>
            <Button className="dos-btn dos-key-pill" @click={() => tapVKey("3")} variant="outline" style={{ background: "#262632" }}>3</Button>
            <Button className="dos-btn dos-key-pill" @click={() => tapVKey("4")} variant="outline" style={{ background: "#262632" }}>4</Button>
            <Button className="dos-btn dos-key-pill" @click={() => tapVKey("5")} variant="outline" style={{ background: "#262632" }}>5</Button>
            <Button className="dos-btn dos-key-pill" @click={() => tapVKey("6")} variant="outline" style={{ background: "#262632" }}>6</Button>
            <Button className="dos-btn dos-key-pill" @click={() => tapVKey("7")} variant="outline" style={{ background: "#262632" }}>7</Button>
            <Button className="dos-btn dos-key-pill" @click={() => tapVKey("8")} variant="outline" style={{ background: "#262632" }}>8</Button>
            <Button className="dos-btn dos-key-pill" @click={() => tapVKey("9")} variant="outline" style={{ background: "#262632" }}>9</Button>
            <Button className="dos-btn dos-key-pill" @click={() => tapVKey("0")} variant="outline" style={{ background: "#262632" }}>0</Button>
          </Box>
          <Box className="dos-key-grid">
            <Button className="dos-btn dos-key-pill" @click={() => tapVKey("F1")} variant="ghost" style={{ background: "#262632" }}>F1</Button>
            <Button className="dos-btn dos-key-pill" @click={() => tapVKey("F2")} variant="ghost" style={{ background: "#262632" }}>F2</Button>
            <Button className="dos-btn dos-key-pill" @click={() => tapVKey("F3")} variant="ghost" style={{ background: "#262632" }}>F3</Button>
            <Button className="dos-btn dos-key-pill" @click={() => tapVKey("F4")} variant="ghost" style={{ background: "#262632" }}>F4</Button>
            <Button className="dos-btn dos-key-pill" @click={() => tapVKey("F5")} variant="ghost" style={{ background: "#262632" }}>F5</Button>
            <Button className="dos-btn dos-key-pill" @click={() => tapVKey("F10")} variant="ghost" style={{ background: "#262632" }}>F10</Button>
            <Button className="dos-btn dos-key-pill" @click={() => tapVKey("+")} variant="outline" style={{ background: "#262632" }}>+</Button>
            <Button className="dos-btn dos-key-pill" @click={() => tapVKey("-")} variant="outline" style={{ background: "#262632" }}>-</Button>
            <Button className="dos-btn dos-key-pill" @pointerdown={pressBksp} @pointerup={releaseBksp} @pointerleave={releaseBksp} @pointercancel={releaseBksp} variant="outline" style={{ background: "#262632" }}>BKSP</Button>
            <Button className="dos-btn dos-key-pill" @pointerdown={pressEnter} @pointerup={releaseEnter} @pointerleave={releaseEnter} @pointercancel={releaseEnter} variant="primary">ENT</Button>
          </Box>
          <Box className="dos-key-grid">
            <Button className="dos-key-pill" @click={() => sendQuickCmd("DIR")} variant="ghost" style={{ background: "#22222c" }}>DIR</Button>
            <Button className="dos-key-pill" @click={() => sendQuickCmd("CLS")} variant="ghost" style={{ background: "#22222c" }}>CLS</Button>
            <Button className="dos-key-pill" @click={() => sendQuickCmd("VER")} variant="ghost" style={{ background: "#22222c" }}>VER</Button>
            <Button className="dos-key-pill" @click={toggleTouchRightClick} variant={touchRightClick ? "primary" : "ghost"} style={{ background: touchRightClick ? undefined : "#22222c" }}>
              {touchRightClick ? "R-Click ON" : "L-Click"}
            </Button>
          </Box>
        </Box>

        <Box if={mobileDrawer === "cmd"} style={{ display: "flex", flexDirection: "column", gap: "0.45rem" }}>
          <Stack direction="horizontal" gap="xs" align="center">
            <Button @click={toggleMobileInputMode} size="sm" variant="outline">{mobileInputMode === "live" ? "Live" : "Cmd"}</Button>
            #if (mobileInputMode === "cmd")
              <Input :bind={mobileCmd} placeholder="DOS cmd (dir, cls, ver…)" size="sm" style={{ flex: 1, background: "#141418", color: "#e8e4d8", border: "1px solid #444" }} />
              <Button @click={sendMobileCommand} size="sm" variant="primary">Run</Button>
            #else
              <Input value={mobileLiveText} @change={onLiveKeyInput} placeholder="Tap to type live DOS keys…" size="sm" style={{ flex: 1, background: "#141418", color: "#e8e4d8", border: "1px solid #4a7c59" }} />
              <Button @click={liveTapBksp} size="sm" variant="outline">⌫</Button>
              <Button @click={liveTapEnter} size="sm" variant="primary">↵</Button>
            #end
          </Stack>
        </Box>
      </Box>
    </Box>

    // Audio Output Sink
    <AudioStream
      getSamples={sampleSource}
      sampleRate={48000}
      channels={2}
      format="i16"
      running={isRunning}
      muted={isMuted}
    />
  </Box>
</App>
