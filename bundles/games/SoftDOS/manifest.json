{
  "name": "SoftDOS",
  "version": "0.4.0",
  "description": "An x86 PC emulator written in .logic with bundled one-click FastDOOM v1.3.0 (GPLv2) + Freedoom: Phase 1 v0.13.0 (Modified BSD-3-Clause): a 16/32-bit 386/486 CPU, VGA text/Mode 13h/Mode X, DPMI host, Sound Blaster + AdLib FM, mouse, touch/gamepad controls, and writable C: drive for classic MS-DOS games and programs.",
  "author": "SoftN",
  "main": "ui/main.ui",
  "icon": "assets/icon.svg",
  "files": {
    "ui": [
      "ui/main.ui"
    ],
    "logic": [
      "logic/main.logic",
      "logic/dos_state.logic",
      "logic/dos_mmu.logic",
      "logic/dos_vga.logic",
      "logic/dos_kernel.logic",
      "logic/dos_progs.logic",
      "logic/dos_loader.logic",
      "logic/dos_shell.logic",
      "logic/dos_cpu.logic",
      "logic/dos_ops.logic",
      "logic/dos_bc.logic",
      "logic/dos_int.logic",
      "logic/dos_jit.logic",
      "logic/dos_mouse.logic",
      "logic/dos_zip.logic",
      "logic/dos_opl.logic",
      "logic/dos_sb.logic"
    ],
    "assets": [
      "assets/icon.svg"
    ]
  },
  "config": {
    "execution": "worker",
    "window": {
      "title": "SoftDOS — x86 PC Emulator",
      "width": 960,
      "height": 840
    },
    "theme": {
      "primary": "#48d080",
      "mode": "dark"
    }
  }
}
