// main.logic — SoftDOS Shell Application
//
// Bridges the SoftN UI runtime (<PixelCanvas>, <AudioStream>, <FileChooser>)
// with the x86 16/32-bit DOS emulation machine.

import "./dos_state.logic"
import "./dos_mmu.logic"
import "./dos_vga.logic"
import "./dos_kernel.logic"
import "./dos_progs.logic"
import "./dos_cpu.logic"
import "./dos_ops.logic"
import "./dos_bc.logic"
import "./dos_int.logic"
import "./dos_jit.logic"
import "./dos_loader.logic"
import "./dos_shell.logic"
import "./dos_mouse.logic"
import "./dos_zip.logic"
import "./dos_opl.logic"
import "./dos_sb.logic"

// ---------------------------------------------------------------------------
// Reactive UI State (scalars synchronized with React UI)
// ---------------------------------------------------------------------------
let activeMode = "prompt";          // "prompt", "plasma", "raycast", "custom"
let cpuModeText = "16-Bit Real Mode";
let fpsText = "60 FPS";
let statusText = "MS-DOS 6.22 Ready";
let loadedFileName = "";
let isRunning = true;
let isMuted = false;
let isExpanded = false;
let crtTheme = "color";
let crtAspect = "16:10";            // "16:10" (square pixels) | "4:3" (classic CRT)
let keyMask = 0; // bit 0: Left, 1: Right, 2: Up, 3: Down, 4: Fire/Space
let mouseCursorStyle = "default";   // "none" while a program draws its own pointer
let programList = [];               // the .EXE and .COM files on drive C
let driveFileCount = 0;
let loadNote = "";                  // what the last load did
let soundText = "";                 // what the program is playing through: AdLib, Sound Blaster, speaker
let mobileCmd = "";
let mobileDrawer = "pad";           // "" | "pad" | "keys" | "drive" | "demos" | "cmd"
let mobileInputMode = "cmd";        // "cmd" | "live"
let mobileLiveText = "";
let mobileLivePrev = "";
let screenTouchMode = "cursor";     // "cursor" | "drag"
let touchRightClick = false;
let autoRunLock = false;
let customProgName = "";            // primary custom .EXE/.COM on Drive C (e.g. DOOM.EXE)
let doomLoading = false;
let doomLoadPct = 0;
let doomLoaded = false;

let FD_EXE_BYTES = 640376;
let FD_WAD_BYTES = 28795076;
let FD_SLICE_SIZE = 2880000;
let FD_CHUNK_COUNT = 10;
let FD_WAD_BUF = null;
let FD_AUTO_LAUNCH = false;

// The keys a DOS program expects to get whole; the browser would otherwise
// scroll on the arrows and Space, search on "/", and so on. F11 and F12 stay
// the browser's, and so does any Ctrl+letter chord.
let CAPTURED_KEYS = ["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", " ", "Tab", "Escape",
  "Backspace", "Home", "End", "PageUp", "PageDown", "Insert", "Delete", "Alt", "/", "'",
  "F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10"];

let pcmBuffer = null; // Preallocated audio buffer
let pcmMix = null;    // the mix before it is clamped to 16 bits
let winListenersBound = false;
let wasRunningBeforeHide = false;
let physHeld = {};

function onWindowKeyDown(e) {
  if (e && e.targetEditable === true) return;
  if (!e || typeof e.key !== "string") return;
  if (!e.ctrlKey && !e.metaKey && CAPTURED_KEYS.indexOf(e.key) >= 0) {
    if (typeof e.preventDefault === "function") e.preventDefault();
  }
  handleKeyEvent(e.key, true);
}

function onWindowKeyUp(e) {
  if (e && e.targetEditable === true) return;
  if (!e || typeof e.key !== "string") return;
  handleKeyEvent(e.key, false);
}

function releaseAllInputs() {
  releaseAllVirtualKeys();
  let pkeys = Object.keys(physHeld);
  for (let i = 0; i < pkeys.length; i++) {
    let k = pkeys[i];
    if (physHeld[k] === 1) {
      physHeld[k] = 0;
      let up = scanForKey(k);
      if (up !== 0) dosInt_pushScan(up | 0x80, 0);
    }
  }
  keyMask = 0;
  swipeActive = false;
  dosMouse_releaseAll();
  syncShiftState();
}

function onWindowBlur() {
  releaseAllInputs();
}

function bindWindowListeners() {
  if (winListenersBound) return;
  if (typeof window !== "undefined" && window.addEventListener) {
    window.addEventListener("keydown", onWindowKeyDown);
    window.addEventListener("keyup", onWindowKeyUp);
    window.addEventListener("blur", onWindowBlur);
    winListenersBound = true;
  }
}

function unbindWindowListeners() {
  if (!winListenersBound) return;
  if (typeof window !== "undefined" && window.removeEventListener) {
    window.removeEventListener("keydown", onWindowKeyDown);
    window.removeEventListener("keyup", onWindowKeyUp);
    window.removeEventListener("blur", onWindowBlur);
  }
  winListenersBound = false;
}

function _onHide() {
  wasRunningBeforeHide = isRunning;
  isRunning = false;
  DOS_SPEAKER_ON = 0;
  autoRunLock = false;
  releaseAllInputs();
  unbindWindowListeners();
}

function _onShow() {
  bindWindowListeners();
  lastFrameAt = 0;
  cyclesStamp = 0;
  if (wasRunningBeforeHide) {
    wasRunningBeforeHide = false;
    isRunning = true;
  }
}

function _init() {
  let wasDoomRunning = (activeMode === "custom" && loadedFileName === "FDOOM.EXE");
  dosState_init();
  dosOps_init();
  dosVga_init();
  dosLoader_bootShell();
  DOS_LOAD_NAME = "PROGRAM.EXE";
  activeMode = "prompt";
  cpuModeText = "16-Bit Real Mode";
  loadedFileName = "";
  statusText = wasDoomRunning ? "Reloading FastDOOM with JIT..." : "MS-DOS 6.22 Ready";
  CPU_BUDGET = 40000;
  runFrames = 0;
  cyclesRun = 0;
  lastFrameAt = 0;
  FD_ST_LOADING = false;
  FD_ST_PCT = 0;
  FD_ST_LOADED = false;
  FD_VFS_DIRTY = false;
  FD_LAUNCH_PENDING = false;
  FD_FAIL_MSG = "";
  FD_RESYNC_PHASE = 0;
  cyclesText = "";
  physHeld = {};
  virtualHeld = {};
  keyMask = 0;

  pcmBuffer = new Int16Array(4096 * 2);
  pcmMix = new Float32Array(4096 * 2);
  dosOpl_init();
  dosSb_reset();
  dosOpl_accelInit();

  // Install keyboard and focus-loss listeners on the window once.
  bindWindowListeners();
  refreshProgramList();
  doomLoading = false;
  doomLoadPct = 0;
  doomLoaded = false;
  FD_WAD_BUF = null;
  let resumeLaunch = FD_AUTO_LAUNCH || wasDoomRunning;
  FD_AUTO_LAUNCH = false;
  if (resumeLaunch) {
    doomLoading = true;
    statusText = wasDoomRunning ? "Reloading FastDOOM with JIT..." : "Loading FastDOOM engine...";
  }
  if (dosZip_hasBundleReader()) {
    fdStartPreload(resumeLaunch);
  }
}

// ---------------------------------------------------------------------------
// The mouse: the pointer over the screen, as a fraction of it each way. The
// canvas is scaled to fit its box, so the event's target rectangle is what
// places the pointer within the picture.
// ---------------------------------------------------------------------------
function mousePoint(e) {
  if (!e || e.targetTag !== "canvas") return 0;
  if (typeof e.targetWidth !== "number" || e.targetWidth <= 0 || e.targetHeight <= 0) return 0;
  let nx = (e.clientX - e.targetLeft) / e.targetWidth;
  let ny = (e.clientY - e.targetTop) / e.targetHeight;
  if (nx < 0) nx = 0; else if (nx > 0.9999) nx = 0.9999;
  if (ny < 0) ny = 0; else if (ny > 0.9999) ny = 0.9999;
  dosMouse_move(nx, ny);
  return 1;
}
function mouseButtonOf(e) {
  if (!e) return 0;
  if (e.button === 2) return 1;
  if (e.button === 1) return 2;
  return 0;
}
let swipeActive = false;
let swipeLastX = 0;
let swipeLastY = 0;
let swipeMoved = 0;
let swipeWidth = 320;
let swipeHeight = 200;

function effectiveButtonOf(e) {
  let b = mouseButtonOf(e);
  if (b === 0 && touchRightClick) return 1;
  return b;
}

function mouseMove(e) {
  if (screenTouchMode === "drag" && e) {
    if (!swipeActive) return;
    let dx = e.clientX - swipeLastX;
    let dy = e.clientY - swipeLastY;
    swipeLastX = e.clientX;
    swipeLastY = e.clientY;
    swipeMoved += Math.abs(dx) + Math.abs(dy);
    if (e.targetWidth > 0) swipeWidth = e.targetWidth;
    if (e.targetHeight > 0) swipeHeight = e.targetHeight;
    if (activeMode === "raycast") {
      dosLoader_turnRaycast(dx * 0.012);
    }
    dosMouse_moveRel(dx / swipeWidth, dy / swipeHeight);
    return;
  }
  mousePoint(e);
}

function mouseDown(e) {
  if (screenTouchMode === "drag" && e && e.targetTag === "canvas") {
    swipeActive = true;
    swipeLastX = e.clientX;
    swipeLastY = e.clientY;
    swipeMoved = 0;
    if (e.targetWidth > 0) swipeWidth = e.targetWidth;
    if (e.targetHeight > 0) swipeHeight = e.targetHeight;
    return;
  }
  if (mousePoint(e) === 1) dosMouse_button(effectiveButtonOf(e), 1);
}

function mouseUp(e) {
  if (screenTouchMode === "drag") {
    if (swipeActive && swipeMoved < 10) {
      let btn = effectiveButtonOf(e);
      dosMouse_button(btn, 1);
      dosMouse_button(btn, 0);
    }
    swipeActive = false;
    return;
  }
  mousePoint(e);
  dosMouse_button(effectiveButtonOf(e), 0);
}

function mouseLeave() {
  swipeActive = false;
  dosMouse_releaseAll();
}

// Set 1 scan codes for the keys a DOS program asks about by scan code
// rather than by character.
let SCAN_MAP = {
  "Escape": 0x01, "Backspace": 0x0E, "Tab": 0x0F, "Enter": 0x1C,
  "Control": 0x1D, "Shift": 0x2A, "RightShift": 0x36, "Alt": 0x38, " ": 0x39,
  "F1": 0x3B, "F2": 0x3C, "F3": 0x3D, "F4": 0x3E, "F5": 0x3F,
  "F6": 0x40, "F7": 0x41, "F8": 0x42, "F9": 0x43, "F10": 0x44,
  "Home": 0x47, "ArrowUp": 0x48, "PageUp": 0x49,
  "ArrowLeft": 0x4B, "ArrowRight": 0x4D,
  "End": 0x4F, "ArrowDown": 0x50, "PageDown": 0x51,
  "Insert": 0x52, "Delete": 0x53,
  "`": 0x29, "~": 0x29, "\\": 0x2B, "|": 0x2B,
  ":": 0x27, "\"": 0x28, "<": 0x33, ">": 0x34, "?": 0x35,
  "_": 0x0C, "+": 0x0D, "{": 0x1A, "}": 0x1B,
  "!": 0x02, "@": 0x03, "#": 0x04, "$": 0x05, "%": 0x06,
  "^": 0x07, "&": 0x08, "*": 0x09, "(": 0x0A, ")": 0x0B,
  "CapsLock": 0x3A, "NumLock": 0x45, "ScrollLock": 0x46,
  "F11": 0x57, "F12": 0x58
};
// Scan codes for the letter and digit rows, so a game reading the raw
// keyboard port sees what a real keyboard would send.
let SCAN_ROWS = ["1234567890-=", "qwertyuiop[]", "asdfghjkl;'", "zxcvbnm,./"];
let SCAN_ROW_BASE = [0x02, 0x10, 0x1E, 0x2C];

function scanForKey(key) {
  if (SCAN_MAP[key] !== undefined) return SCAN_MAP[key];
  if (key.length !== 1) return 0;
  let lower = key.toLowerCase();
  for (let r = 0; r < SCAN_ROWS.length; r++) {
    let idx = SCAN_ROWS[r].indexOf(lower);
    if (idx >= 0) return SCAN_ROW_BASE[r] + idx;
  }
  return 0;
}

function handleKeyEvent(key, isDown) {
  // The arrow keys and fire buttons also drive the built-in 3D demo, which
  // reads a bitmask rather than the BIOS buffer.
  let mask = 0;
  if (key === "ArrowLeft" || key === "a" || key === "A") mask = 0x01;
  else if (key === "ArrowRight" || key === "d" || key === "D") mask = 0x02;
  else if (key === "ArrowUp" || key === "w" || key === "W") mask = 0x04;
  else if (key === "ArrowDown" || key === "s" || key === "S") mask = 0x08;
  else if (key === " " || key === "Control") mask = 0x10;

  if (!isDown) {
    physHeld[key] = 0;
    keyMask = keyMask & ~mask;
    let up = scanForKey(key);
    if (up !== 0) dosInt_pushScan(up | 0x80, 0);   // the break code
    return;
  }
  physHeld[key] = 1;
  keyMask = keyMask | mask;

  let scan = scanForKey(key);
  let ascii = 0;
  if (key.length === 1) {
    let c = key.charCodeAt(0);
    if (c >= 32 && c < 127) ascii = c;
  } else if (key === "Enter") ascii = 13;
  else if (key === "Backspace") ascii = 8;
  else if (key === "Tab") ascii = 9;
  else if (key === "Escape") ascii = 27;

  if (scan === 0 && ascii === 0) return;
  // The make code, with its ASCII. A program that took over INT 9 reads the
  // port itself; the BIOS handler turns it into a word for INT 16h.
  dosInt_pushScan(scan, ascii);
}

// Hand the machine back to the prompt, whatever is running.
function quitToDos() {
  releaseAllVirtualKeys();
  autoRunLock = false;
  if (activeMode === "custom") dosShell_returnToPrompt("^C");
  soundText = "";
}

// ---------------------------------------------------------------------------
// Video Frame Producer (called on requestAnimationFrame by <PixelCanvas>)
// ---------------------------------------------------------------------------
// Cycles handed to the CPU per frame. This is a TIME budget in disguise: the
// emulator only draws once frameSource returns, so a budget that takes 375 ms
// to spend means the screen updates under three times a second however fast
// the CPU is underneath. The budget is retuned each frame toward a slice that
// leaves room to draw at 60 Hz, which costs no emulated throughput at all —
// the same cycles are simply handed over in more, smaller pieces.
let CPU_SLICE_MS = 16;    // wall-clock time a single slice should take
let CPU_BUDGET = 40000;   // cycles per frame; adapts from the first measurement
let runFrames = 0;        // frames the current program has had
let cyclesRun = 0;
let cyclesText = "";
let flipsAtStamp = 0;     // page flips seen at the last readout
let cyclesStamp = 0;
let lastFrameAt = 0;      // when the previous frame ran the CPU, for the clock

function updateCycleReadout() {
  let now = Date.now();
  if (cyclesStamp === 0) { cyclesStamp = now; cyclesRun = 0; return; }
  if (now - cyclesStamp >= 1000) {
    let mhz = cyclesRun / (now - cyclesStamp) / 1000;
    cyclesText = (mhz >= 1) ? ((Math.round(mhz * 10) / 10) + " MHz") : (Math.round(mhz * 1000) + " kHz");
    // Say when the host declined to accelerate, since that is a 10x difference.
    if (DOS_IS_32 === 1 && DOS_JIT_ACCEL === 0 && DOS_JIT_ACCEL_ERROR !== "") {
      let errNote = DOS_JIT_ACCEL_ERROR.slice(0, 64);
      if (errNote.indexOf("denied") >= 0) errNote = "click Allow in top bar for JIT speed";
      cyclesText += " · accel off (" + errNote + ")";
    }
    // Frames the guest itself finished, when it page-flips. This is the number
    // that matters for a game; the repaint rate next to it is not.
    let flips = DOS_VGA_FLIPS - flipsAtStamp;
    flipsAtStamp = DOS_VGA_FLIPS;
    if (flips > 0) {
      let gfps = flips * 1000 / (now - cyclesStamp);
      cyclesText = cyclesText + " \u00b7 " + (Math.round(gfps * 10) / 10) + " game fps";
    }
    cyclesRun = 0;
    cyclesStamp = now;
  }
}

function frameSource() {
  if (!isRunning) return null;

  if (activeMode === "prompt") {
    dosShell_tick();
    cpuModeText = "16-Bit Real Mode";
  } else if (activeMode === "raycast") {
    dosLoader_tickRaycaster(keyMask);
    cpuModeText = "Built-in 3D demo";
  } else if (activeMode === "custom") {
    let before = DOS_TOTAL_CYCLES;
    let started = Date.now();
    dosCpu_runCycles(CPU_BUDGET);
    let spentMs = Date.now() - started;
    cyclesRun += DOS_TOTAL_CYCLES - before;
    // The emulated clock is the achieved rate, smoothed, so the PIT's ticks
    // (expressed in cycles) come at their real rate whatever the throughput.
    if (lastFrameAt > 0 && started > lastFrameAt) {
      let achieved = (DOS_TOTAL_CYCLES - before) * 1000 / (started - lastFrameAt);
      let hz = Math.floor(DOS_CPU_HZ * 0.8 + achieved * 0.2);
      DOS_CPU_HZ = (hz < 1000000) ? 1000000 : hz;
    }
    lastFrameAt = started;
    // Retune toward CPU_SLICE_MS. Date.now has millisecond granularity, so a
    // slice that reads as 0 ms is simply too small to measure: grow it.
    if (spentMs <= 0) {
      CPU_BUDGET = Math.min(2000000, Math.floor(CPU_BUDGET * 1.5) + 1000);
    } else {
      let want = Math.floor(CPU_BUDGET * (CPU_SLICE_MS / spentMs));
      // Move part of the way so one slow frame cannot swing the budget wildly.
      CPU_BUDGET = Math.floor(CPU_BUDGET + (want - CPU_BUDGET) * 0.35);
      if (CPU_BUDGET < 4000) CPU_BUDGET = 4000;
      if (CPU_BUDGET > 2000000) CPU_BUDGET = 2000000;
    }
    cpuModeText = DOS_IS_32 ? "32-Bit Protected Mode (DPMI)" : "16-Bit Real Mode";

    // A 32-bit extender image that runs for seconds without asking the
    // machine for anything and without drawing is not going to start: say so
    // rather than spin behind a blank screen.
    runFrames++;
    if (DOS_IS_32 === 1 && runFrames > 240 && DOS_INT_COUNT === 0 && DOS_VIDEO_MODE === 0x03) {
      dosShell_returnToPrompt("");
      dosKernel_printStr("This 32-bit image never asked the machine for anything,\r\n");
      dosKernel_printStr("so it did not load: its objects are mapped, but something\r\n");
      dosKernel_printStr("in the image is wrong. 16-bit .COM and .EXE programs run.\r\n");
      dosShell_prompt();
      return dosVga_getFrame();
    }

    // A 32-bit image that started properly, asked for services and then went
    // quiet in text mode is waiting on something that is not implemented.
    // Name it rather than spin: the last refusal is almost always the reason.
    if (DOS_IS_32 === 1 && runFrames > 900 && DOS_VIDEO_MODE === 0x03 &&
        DOS_INT_COUNT > 0 && DOS_UNHANDLED_INT >= 0) {
      dosShell_returnToPrompt("");
      dosKernel_printStr("\r\nThe program started, but stopped waiting on a service\r\n");
      dosKernel_printStr("SoftDOS does not implement: INT " +
                         DOS_UNHANDLED_INT.toString(16).toUpperCase() + "h function " +
                         DOS_UNHANDLED_FN.toString(16).toUpperCase() + "h, " +
                         DOS_UNHANDLED_COUNT + " calls refused.\r\n");
      dosKernel_printStr("Hardware interrupts are the usual missing piece: a game\r\n");
      dosKernel_printStr("that installs its own timer or keyboard handler needs\r\n");
      dosKernel_printStr("interrupt delivery, which SoftDOS does not have yet.\r\n");
      dosShell_prompt();
      return dosVga_getFrame();
    }

    // What is sounding, for the badge: the FM chip (on the host when the
    // accelerator compiled it), the DAC, the speaker.
    let snd = "";
    if (dosOpl_active() === 1) snd = (DOS_OPL_ACCEL >= 0) ? "AdLib (host)" : "AdLib";
    if (DOS_SB_ACTIVE === 1 && DOS_SB_SPEAKER === 1) snd += (snd !== "" ? " + " : "") + "Sound Blaster";
    if (DOS_SPEAKER_ON === 1) snd += (snd !== "" ? " + " : "") + "speaker";
    if (snd !== soundText) soundText = snd;

    // The host's pointer stands in for the driver's: hidden while a program
    // that uses the mouse has asked for it hidden, since it draws its own.
    let cursor = (DOS_MOUSE_USED === 1 && DOS_MOUSE_CURSOR < 0) ? "none" : "default";
    if (cursor !== mouseCursorStyle) mouseCursorStyle = cursor;

    // A program that stopped, by INT 20h, INT 21h/4Ch, HLT or an instruction
    // the CPU does not know, gives the machine back to the shell.
    if (DOS_HALTED) {
      let note = "";
      if (DOS_LAST_ILLEGAL >= 0) {
        note = "Unsupported instruction at " + DOS_LAST_ILLEGAL.toString(16).toUpperCase() + "h. Program stopped.";
        DOS_LAST_ILLEGAL = -1;
      }
      dosShell_returnToPrompt(note);
    }
  }

  return dosVga_getFrame();
}

function fpsReport(fps) {
  fdSyncUi();
  let f = (typeof fps === "number") ? fps : ((fps && fps.fps) ? fps.fps : 0);
  if (f > 0) fpsText = Math.round(f) + " FPS";
  updateCycleReadout();
}

// ---------------------------------------------------------------------------
// Audio Sample Producer (called by <AudioStream>)
// ---------------------------------------------------------------------------
// The speaker, the AdLib and the Sound Blaster's DAC, mixed. The devices
// are advanced here, paced by the audio clock, muted or not: the Sound
// Blaster's interrupts come from its samples being consumed.
function sampleSource(wantFrames) {
  fdSyncUi();
  if (!isRunning || !pcmBuffer) return null;
  let frames = (typeof wantFrames === "number" && wantFrames > 0) ? Math.floor(wantFrames) : 512;
  if (frames < 128) frames = 128;
  if (frames > 4096) frames = 4096;
  let n2 = frames * 2;
  let mix = pcmMix;
  for (let i = 0; i < n2; i++) mix[i] = 0;

  let freq = DOS_SPEAKER_ON ? DOS_SPEAKER_FREQ : 0;
  if (freq > 0) {
    let step = freq / 48000;
    for (let i = 0; i < frames; i++) {
      DOS_AUDIO_PHASE += step;
      if (DOS_AUDIO_PHASE >= 1) DOS_AUDIO_PHASE -= 1;
      let val = (DOS_AUDIO_PHASE < 0.5) ? 3000 : -3000;
      mix[i * 2] += val;
      mix[i * 2 + 1] += val;
    }
  }
  dosOpl_mix(mix, frames);
  dosSb_mix(mix, frames);

  for (let i = 0; i < n2; i++) {
    let v = mix[i];
    if (v > 22000) v = 22000 + (v - 22000) * 0.35;
    else if (v < -22000) v = -22000 + (v + 22000) * 0.35;
    if (v > 32767) v = 32767; else if (v < -32768) v = -32768;
    pcmBuffer[i] = v;
  }
  let u8View = new Uint8Array(pcmBuffer.buffer, 0, frames * 4);
  return {
    pcm: u8View.toBase64(),
    frames: frames,
    rate: 48000
  };
}

// ---------------------------------------------------------------------------
// Mode Selectors & Quick Launch
// ---------------------------------------------------------------------------
function launchShell() {
  releaseAllVirtualKeys();
  autoRunLock = false;
  DOS_LOAD_NAME = "PROGRAM.EXE";
  activeMode = "prompt";
  dosLoader_bootShell();
  refreshProgramList();
  statusText = "MS-DOS 6.22 Ready";
  cpuModeText = "16-Bit Real Mode";
  loadedFileName = "";
}

// Run one of the programs on the virtual drive, as if it had been typed.
function launchProgram(name) {
  releaseAllVirtualKeys();
  if (activeMode !== "prompt") launchShell();
  let idx = dosKernel_vfsFind(name);
  if (idx < 0) { statusText = name + " is not on the drive"; return; }
  dosKernel_printStr(name + "\r\n");
  dosShell_run(name, idx);
  refreshProgramList();
}
function launchPlasma() { launchProgram("PLASMA.COM"); }
function launchMandel() { launchProgram("MANDEL.COM"); }
function launchBoxes() { launchProgram("BOXES.COM"); }
function launchHello() { launchProgram("HELLO.COM"); }
function launchCustomProg() {
  if (customProgName !== "") launchProgram(customProgName);
  else mobileDrawer = "drive";
}

// Worker-internal preload state (synced inside callFunction handlers like fpsReport
// so async resolve_host_call callbacks never swallow reactive UI diffs).
let FD_ST_LOADING = false;
let FD_ST_PCT = 0;
let FD_ST_LOADED = false;
let FD_VFS_DIRTY = false;
let FD_LAUNCH_PENDING = false;
let FD_FAIL_MSG = "";
let FD_EXPECTED_LIST_LEN = -1;
let FD_EXPECTED_FILE_COUNT = -1;
let FD_EXPECTED_CUSTOM = "";
let FD_RESYNC_PHASE = 0;

function fdSyncUi() {
  // Detect mid-game Allow worker restart when carry_out failed and update_context
  // copied the prior worker's running FDOOM.EXE UI state into a fresh VM.
  if (activeMode === "custom" && loadedFileName === "FDOOM.EXE" && DOS_LOAD_NAME !== "FDOOM.EXE") {
    activeMode = "prompt";
    loadedFileName = "";
    cpuModeText = "16-Bit Real Mode";
    autoRunLock = false;
    cyclesText = "";
    FD_AUTO_LAUNCH = true;
    FD_LAUNCH_PENDING = false;
    statusText = "Reloading FastDOOM with JIT...";
  }
  if (FD_RESYNC_PHASE === 2) {
    FD_RESYNC_PHASE = 0;
    refreshProgramList();
    if (FD_AUTO_LAUNCH && FD_ST_LOADED) {
      FD_AUTO_LAUNCH = false;
      FD_LAUNCH_PENDING = true;
    }
  } else if (
    FD_EXPECTED_LIST_LEN >= 0 &&
    (programList.length !== FD_EXPECTED_LIST_LEN ||
     driveFileCount !== FD_EXPECTED_FILE_COUNT ||
     customProgName !== FD_EXPECTED_CUSTOM)
  ) {
    // update_context from a prior worker injected stale list globals/baseline;
    // reset for one tick so host & worker converge before restoring true VFS.
    programList = [];
    driveFileCount = 0;
    customProgName = "";
    FD_EXPECTED_LIST_LEN = 0;
    FD_EXPECTED_FILE_COUNT = 0;
    FD_EXPECTED_CUSTOM = "";
    FD_RESYNC_PHASE = 2;
    doomLoading = FD_ST_LOADING;
    doomLoadPct = FD_ST_PCT;
    doomLoaded = FD_ST_LOADED;
    return;
  }
  if (doomLoading !== FD_ST_LOADING) doomLoading = FD_ST_LOADING;
  if (doomLoadPct !== FD_ST_PCT) doomLoadPct = FD_ST_PCT;
  if (doomLoaded !== FD_ST_LOADED) doomLoaded = FD_ST_LOADED;
  if (FD_ST_LOADING && FD_AUTO_LAUNCH) {
    statusText = FD_ST_PCT > 0 ? ("Loading FastDOOM (" + FD_ST_PCT + "%)...") : "Loading FastDOOM engine...";
  }
  if (FD_VFS_DIRTY) {
    FD_VFS_DIRTY = false;
    refreshProgramList();
  }
  if (FD_AUTO_LAUNCH && FD_ST_LOADED && !FD_LAUNCH_PENDING) {
    FD_AUTO_LAUNCH = false;
    FD_LAUNCH_PENDING = true;
  }
  if (FD_FAIL_MSG !== "") {
    let msg = FD_FAIL_MSG;
    FD_FAIL_MSG = "";
    statusText = msg;
    dosKernel_printStr("\r\n" + msg + "\r\n");
    dosShell_prompt();
  }
  if (FD_LAUNCH_PENDING) {
    FD_LAUNCH_PENDING = false;
    launchProgram("FDOOM.EXE");
  }
}

function fdReadBody(res) {
  if (typeof res === "string") return res;
  if (res && typeof res === "object" && res.ok !== false) {
    if (typeof res.body === "string") return res.body;
    if (typeof res.data === "string") return res.data;
  }
  return "";
}

function fdTextBytes(str) {
  let out = new Uint8Array(str.length);
  for (let i = 0; i < str.length; i++) out[i] = str.charCodeAt(i) & 0xFF;
  return out;
}

function fdFail(msg) {
  let wantLaunch = FD_AUTO_LAUNCH;
  FD_AUTO_LAUNCH = false;
  FD_ST_LOADING = false;
  FD_ST_PCT = 0;
  FD_WAD_BUF = null;
  if (wantLaunch) FD_FAIL_MSG = msg;
}

function fdSeedNotice() {
  if (dosKernel_vfsFind("DOOMINFO.TXT") >= 0) return;
  let txt =
    "FastDOOM v1.3.0 + Freedoom: Phase 1 v0.13.0\r\n" +
    "-------------------------------------------\r\n" +
    "Engine: FDOOM.EXE (GNU GPLv2) - https://github.com/viti95/FastDoom\r\n" +
    "Assets: FREEDM1.WAD (Modified 3-Clause BSD) - https://freedoom.github.io\r\n" +
    "License files: COPYING_GPL2.txt, COPYING_BSD.txt, NOTICE.txt in assets/fd/\r\n" +
    "Controls: Arrows=Move/Turn, Ctrl/FIRE=Shoot, Space/USE=Open, Alt/STRF=Strafe, Shift/RUN=Run\r\n";
  dosKernel_vfsAdd("DOOMINFO.TXT", fdTextBytes(txt));
}

function fdLoadWadChunk(idx) {
  if (idx >= FD_CHUNK_COUNT) {
      dosKernel_vfsAdd("FREEDM1.WAD", FD_WAD_BUF);
    FD_WAD_BUF = null;
    fdSeedNotice();
    FD_VFS_DIRTY = true;
    FD_ST_LOADING = false;
    FD_ST_PCT = 100;
    FD_ST_LOADED = true;
    if (FD_AUTO_LAUNCH) {
      FD_AUTO_LAUNCH = false;
      FD_LAUNCH_PENDING = true;
    }
    return;
  }
  let suffix = idx < 10 ? ("0" + idx) : String(idx);
  let assetPath = "assets/fd/wad" + suffix + ".b64";
  dosZip_readBundleText(assetPath, function(res) {
    let body = fdReadBody(res);
    if (body === "") {
      fdFail("Failed reading Freedoom slice " + (idx + 1) + "/" + FD_CHUNK_COUNT);
      return;
    }
    try {
      dosZip_b64DecodeInto(body, FD_WAD_BUF, idx * FD_SLICE_SIZE);
    } catch (err) {
      fdFail("Load error on Freedoom slice " + (idx + 1) + ": " + String(err && err.message ? err.message : err));
      return;
    }
    FD_ST_PCT = Math.round(((idx + 2) * 100) / (FD_CHUNK_COUNT + 1));
    fdLoadWadChunk(idx + 1);
  });
}

function fdStartPreload(autoLaunchAfter) {
  if (autoLaunchAfter) FD_AUTO_LAUNCH = true;
  if (dosKernel_vfsFind("FDOOM.EXE") >= 0 && dosKernel_vfsFind("FREEDM1.WAD") >= 0) {
    FD_ST_LOADING = false;
    FD_ST_PCT = 100;
    FD_ST_LOADED = true;
    FD_VFS_DIRTY = false;
    doomLoading = false;
    doomLoadPct = 100;
    doomLoaded = true;
    refreshProgramList();
    if (FD_AUTO_LAUNCH) {
      FD_AUTO_LAUNCH = false;
      FD_LAUNCH_PENDING = false;
      launchProgram("FDOOM.EXE");
    }
    return;
  }
  if (FD_ST_LOADING) {
    if (autoLaunchAfter) {
      doomLoading = true;
      doomLoadPct = FD_ST_PCT;
      statusText = FD_ST_PCT > 0 ? ("Loading FastDOOM (" + FD_ST_PCT + "%)...") : "Loading FastDOOM engine...";
    }
    return;
  }
  if (!dosZip_hasBundleReader()) {
    if (FD_AUTO_LAUNCH) {
      FD_AUTO_LAUNCH = false;
      statusText = "FastDOOM bundle reader unavailable";
    }
    return;
  }
  FD_ST_LOADING = true;
  FD_ST_PCT = 0;
  if (FD_AUTO_LAUNCH) {
    doomLoading = true;
    doomLoadPct = 0;
    statusText = "Loading FastDOOM engine...";
  }
  dosZip_readBundleText("assets/fd/fd_exe.b64", function(res) {
    let body = fdReadBody(res);
    if (body === "") {
      fdFail("Failed reading bundled FDOOM.EXE");
      return;
    }
    try {
      let exeBytes = dosZip_b64Decode(body, FD_EXE_BYTES);
          dosKernel_vfsAdd("FDOOM.EXE", exeBytes);
      FD_VFS_DIRTY = true;
    } catch (err) {
      fdFail("Load error on FDOOM.EXE: " + String(err && err.message ? err.message : err));
      return;
    }
    FD_WAD_BUF = new Uint8Array(FD_WAD_BYTES);
    FD_ST_PCT = Math.round(100 / (FD_CHUNK_COUNT + 1));
    fdLoadWadChunk(0);
  });
}

function launchFastDoom() {
  releaseAllVirtualKeys();
  mobileDrawer = "pad";
  if (dosKernel_vfsFind("FDOOM.EXE") >= 0 && dosKernel_vfsFind("FREEDM1.WAD") >= 0) {
    FD_AUTO_LAUNCH = false;
    FD_LAUNCH_PENDING = false;
    FD_ST_LOADING = false;
    FD_ST_PCT = 100;
    FD_ST_LOADED = true;
    FD_VFS_DIRTY = false;
    doomLoading = false;
    doomLoadPct = 100;
    doomLoaded = true;
    refreshProgramList();
    launchProgram("FDOOM.EXE");
    return;
  }
  fdStartPreload(true);
}

function launchRaycast() {
  releaseAllVirtualKeys();
  autoRunLock = false;
  DOS_LOAD_NAME = "PROGRAM.EXE";
  activeMode = "raycast";
  dosState_reset();
  dosProgs_install();
  refreshProgramList();
  dosVga_init();
  DOS_VIDEO_MODE = 0x13;
  statusText = "Built-in 3D demo (drawn by the host, not emulated x86)";
  cpuModeText = "Built-in 3D demo";
}

function togglePause() {
  isRunning = !isRunning;
  statusText = isRunning ? "Running" : "Paused";
}

function toggleMute() {
  isMuted = !isMuted;
}

// ---------------------------------------------------------------------------
// Files onto drive C: a game's files as they are, or the zip they came in.
// ---------------------------------------------------------------------------
let filesAdded = [];       // names from the load in progress

function chooseFiles(files) {
  if (!files || files.length === 0) return;

  statusText = "Reading files...";
  let pending = files.length;
  filesAdded = [];

  for (let i = 0; i < files.length; i++) {
    let f = files[i];
    (function(file) {
      softn.files.readBase64(file.ref, function(res) {
        let b64 = romPayload(res);
        if (b64) {
          let bytes = Uint8Array.fromBase64(b64);
          if (dosZip_isZip(bytes)) {
            try {
              dosZip_extract(bytes, function(name, data) {
                let idx = dosKernel_vfsAdd(name, data);
                if (idx >= 0) filesAdded.push(DOS_VFS_NAMES[idx]);
                return idx;
              });
            } catch (err) {
              loadNote = file.name + ": " + String(err && err.message ? err.message : err);
            }
          } else {
            let idx = dosKernel_vfsAdd(file.name, bytes);
            if (idx >= 0) filesAdded.push(DOS_VFS_NAMES[idx]);
          }
          loadedFileName = file.name;
        }

        pending--;
        if (pending === 0) {
          onFilesReady();
        }
      });
    })(f);
  }
}

// The program a load most likely wants run: the largest .EXE or .COM among
// the files just added that is not an installer or a viewer.
function likelyProgram(names) {
  let best = "";
  let bestSize = -1;
  for (let i = 0; i < names.length; i++) {
    let n = names[i];
    if (!(n.endsWith(".EXE") || n.endsWith(".COM"))) continue;
    if (n.startsWith("SETUP") || n.startsWith("INSTALL") || n.startsWith("UNINST") ||
        n.startsWith("README") || n.startsWith("HELPME") || n.startsWith("CATALOG") ||
        n.startsWith("ORDER")) continue;
    let idx = dosKernel_vfsFind(n);
    let size = (idx >= 0 && DOS_VFS_DATA[idx]) ? DOS_VFS_DATA[idx].length : 0;
    if (size > bestSize) { bestSize = size; best = n; }
  }
  return best;
}

let BUILTIN_VFS_PROGS = {
  "HELLO.COM": 1, "PLASMA.COM": 1, "MANDEL.COM": 1, "BOXES.COM": 1, "COMMAND.COM": 1
};

function refreshProgramList() {
  let list = [];
  let custom = [];
  for (let i = 0; i < DOS_VFS_COUNT; i++) {
    let n = DOS_VFS_NAMES[i];
    if (n !== "" && (n.endsWith(".EXE") || n.endsWith(".COM"))) {
      list.push(n);
      if (!BUILTIN_VFS_PROGS[n]) custom.push(n);
    }
  }
  programList = list;
  let picked = "";
  for (let i = 0; i < custom.length; i++) {
    if (custom[i] === "DOOM.EXE" || custom[i] === "FDOOM.EXE") {
      picked = custom[i];
      break;
    }
  }
  if (picked === "") picked = likelyProgram(custom);
  customProgName = picked;

  let count = 0;
  for (let i = 0; i < DOS_VFS_COUNT; i++) if (DOS_VFS_NAMES[i] !== "") count++;
  driveFileCount = count;
  FD_EXPECTED_LIST_LEN = list.length;
  FD_EXPECTED_FILE_COUNT = count;
  FD_EXPECTED_CUSTOM = picked;
}

function onFilesReady() {
  // Back to the prompt so the new files can be seen and run.
  if (activeMode !== "prompt") {
    activeMode = "prompt";
    DOS_VIDEO_MODE = 0x03;
    DOS_HALTED = 0;
    DOS_SHELL_ACTIVE = 1;
    DOS_CURSOR_VISIBLE = 1;
  }
  refreshProgramList();
  let run = likelyProgram(filesAdded);
  dosKernel_printStr("\r\n" + filesAdded.length + " file(s) added; " + driveFileCount + " on drive C.\r\n");
  if (run !== "") dosKernel_printStr("Type " + run + " to run it, or press Run.\r\n");
  dosShell_prompt();
  if (loadNote !== "") { statusText = loadNote; loadNote = ""; }
  else statusText = (run !== "") ? ("Ready: " + run) : (filesAdded.length + " file(s) on drive C:");
  loadedFileName = (run !== "") ? run : loadedFileName;
}

// A program picked from the list.
function runListed(name) {
  if (typeof name !== "string" || name === "") return;
  launchProgram(name);
  refreshProgramList();
}

function romPayload(result) {
  let s = result;
  if (s && typeof s === "object") {
    if (typeof s.data === "string") s = s.data;
    else if (typeof s.dataUrl === "string") s = s.dataUrl;
    else return "";
  }
  if (typeof s !== "string" || s === "") return "";
  let comma = s.indexOf(",");
  if (comma >= 0 && s.slice(0, 5) === "data:") return s.slice(comma + 1);
  return s;
}

function toggleExpanded() {
  isExpanded = !isExpanded;
}

function setAspect43() {
  crtAspect = "4:3";
}

function setAspect1610() {
  crtAspect = "16:10";
}

function toggleAspect() {
  crtAspect = (crtAspect === "4:3") ? "16:10" : "4:3";
}

function setCrtColor() {
  crtTheme = "color";
  DOS_VGA_TINT = 0;
}

function setCrtGreen() {
  crtTheme = "green";
  DOS_VGA_TINT = 1;
}

function setCrtAmber() {
  crtTheme = "amber";
  DOS_VGA_TINT = 2;
}

function toggleCrtTheme() {
  if (crtTheme === "color") setCrtGreen();
  else if (crtTheme === "green") setCrtAmber();
  else setCrtColor();
}

function toggleScreenTouchMode() {
  swipeActive = false;
  screenTouchMode = (screenTouchMode === "cursor") ? "drag" : "cursor";
}

function toggleTouchRightClick() {
  touchRightClick = !touchRightClick;
}

// Track actively held virtual keys so pointer/leave transitions never double-fire
// or leave keys stuck down.
let virtualHeld = {};

function syncShiftState() {
  let want = (virtualHeld["__run"] === 1 || autoRunLock) ? 1 : 0;
  if (want === 1 && virtualHeld["__shiftSent"] !== 1) {
    virtualHeld["__shiftSent"] = 1;
    handleKeyEvent("Shift", true);
    handleKeyEvent("RightShift", true);
  } else if (want === 0 && virtualHeld["__shiftSent"] === 1) {
    virtualHeld["__shiftSent"] = 0;
    handleKeyEvent("RightShift", false);
    handleKeyEvent("Shift", false);
  }
}

function vKey(key, down) {
  if (down) {
    if (virtualHeld[key] === 1) return;
    virtualHeld[key] = 1;
    handleKeyEvent(key, true);
  } else {
    if (virtualHeld[key] !== 1) return;
    virtualHeld[key] = 0;
    handleKeyEvent(key, false);
  }
}

function releaseAllVirtualKeys() {
  let keys = Object.keys(virtualHeld);
  for (let i = 0; i < keys.length; i++) {
    let k = keys[i];
    if (virtualHeld[k] !== 1) continue;
    virtualHeld[k] = 0;
    if (k === "__run") continue;
    if (k === "__shiftSent") {
      handleKeyEvent("RightShift", false);
      handleKeyEvent("Shift", false);
      continue;
    }
    handleKeyEvent(k, false);
  }
  syncShiftState();
}

function tapVKey(key) {
  if (typeof key !== "string" || key === "") return;
  handleKeyEvent(key, true);
  handleKeyEvent(key, false);
}

// Native SoftN <DPad> handlers
function dpadPress(dir) {
  if (dir === "up") vKey("ArrowUp", true);
  else if (dir === "down") vKey("ArrowDown", true);
  else if (dir === "left") vKey("ArrowLeft", true);
  else if (dir === "right") vKey("ArrowRight", true);
}
function dpadRelease(dir) {
  if (dir === "up") vKey("ArrowUp", false);
  else if (dir === "down") vKey("ArrowDown", false);
  else if (dir === "left") vKey("ArrowLeft", false);
  else if (dir === "right") vKey("ArrowRight", false);
}

// On-screen Virtual D-Pad buttons for touch / clicks
function pressUp() { vKey("ArrowUp", true); }
function releaseUp() { vKey("ArrowUp", false); }
function pressDown() { vKey("ArrowDown", true); }
function releaseDown() { vKey("ArrowDown", false); }
function pressLeft() { vKey("ArrowLeft", true); }
function releaseLeft() { vKey("ArrowLeft", false); }
function pressRight() { vKey("ArrowRight", true); }
function releaseRight() { vKey("ArrowRight", false); }

// Dedicated action buttons (essential for Doom and DOS games on touch)
function pressFire() { vKey("Control", true); }
function releaseFire() { vKey("Control", false); }
function pressUse() { vKey(" ", true); }
function releaseUse() { vKey(" ", false); }
function pressShift() { virtualHeld["__run"] = 1; syncShiftState(); }
function releaseShift() { virtualHeld["__run"] = 0; syncShiftState(); }
function toggleAutoRun() { autoRunLock = !autoRunLock; syncShiftState(); }
function pressEsc() { vKey("Escape", true); }
function releaseEsc() { vKey("Escape", false); }
function pressEnter() { vKey("Enter", true); }
function releaseEnter() { vKey("Enter", false); }
function pressBksp() { vKey("Backspace", true); }
function releaseBksp() { vKey("Backspace", false); }
function pressKeyY() { vKey("y", true); }
function releaseKeyY() { vKey("y", false); }
function pressKeyN() { vKey("n", true); }
function releaseKeyN() { vKey("n", false); }
function pressAlt() { vKey("Alt", true); }
function releaseAlt() { vKey("Alt", false); }
function pressTab() { vKey("Tab", true); }
function releaseTab() { vKey("Tab", false); }
function pressF1() { vKey("F1", true); }
function releaseF1() { vKey("F1", false); }

function setMobileDrawer(d) {
  releaseAllVirtualKeys();
  mobileDrawer = (mobileDrawer === d) ? "" : d;
}

function closeHandheldOverlay() {
  releaseAllVirtualKeys();
  mobileDrawer = "pad";
}

function toggleMobileInputMode() {
  mobileInputMode = (mobileInputMode === "cmd") ? "live" : "cmd";
  mobileLiveText = "";
  mobileLivePrev = "";
}

function extractInputVal(v) {
  if (typeof v === "string") return v;
  if (v && v.target && typeof v.target.value === "string") return v.target.value;
  if (v && typeof v.value === "string") return v.value;
  return "";
}

function onLiveKeyInput(v) {
  let next = extractInputVal(v);
  let prev = mobileLivePrev || "";
  let k = 0;
  let limit = Math.min(prev.length, next.length);
  while (k < limit && prev.charCodeAt(k) === next.charCodeAt(k)) k++;
  for (let i = prev.length; i > k; i--) {
    handleKeyEvent("Backspace", true);
    handleKeyEvent("Backspace", false);
  }
  for (let i = k; i < next.length; i++) {
    let ch = next.charAt(i);
    handleKeyEvent(ch, true);
    handleKeyEvent(ch, false);
  }
  mobileLivePrev = next;
  mobileLiveText = next;
}

function liveTapBksp() {
  if (mobileLiveText.length > 0) {
    mobileLiveText = mobileLiveText.slice(0, -1);
    mobileLivePrev = mobileLiveText;
  }
  handleKeyEvent("Backspace", true);
  handleKeyEvent("Backspace", false);
}

function liveTapEnter() {
  handleKeyEvent("Enter", true);
  handleKeyEvent("Enter", false);
  mobileLiveText = "";
  mobileLivePrev = "";
}

function sendMobileCommand() {
  let s = mobileCmd || "";
  for (let i = 0; i < s.length; i++) {
    let ch = s.charAt(i);
    handleKeyEvent(ch, true);
    handleKeyEvent(ch, false);
  }
  handleKeyEvent("Enter", true);
  handleKeyEvent("Enter", false);
  mobileCmd = "";
}

function sendQuickCmd(cmd) {
  if (activeMode !== "prompt") launchShell();
  let s = cmd || "";
  for (let i = 0; i < s.length; i++) {
    let ch = s.charAt(i);
    handleKeyEvent(ch, true);
    handleKeyEvent(ch, false);
  }
  handleKeyEvent("Enter", true);
  handleKeyEvent("Enter", false);
}

