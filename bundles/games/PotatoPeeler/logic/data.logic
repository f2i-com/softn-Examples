// Precompute local glTF surface centers for the 16 sculpted skin patches (4 axial bands x 4 quadrants)
// Blender (x, y, z) exports with export_yup=True to glTF (x, z, -y).
let PATCH_COORDS = []
function buildPatchCoords() {
  if (PATCH_COORDS.length === 16) { return }
  PATCH_COORDS = []
  let bi = 0
  while (bi < 4) {
    let theta = ((bi + 0.5) / 4.0) * Math.PI
    let ct = Math.cos(theta)
    let st = Math.sin(theta)
    let qi = 0
    while (qi < 4) {
      let phi = ((qi + 0.5) / 4.0) * Math.PI * 2.0
      let bx = ct * 0.30
      let by = st * Math.cos(phi) * 0.205
      let bz = st * Math.sin(phi) * 0.225
      PATCH_COORDS.push({
        idx: bi * 4 + qi,
        lx: bx,
        ly0: bz,
        lz0: -by
      })
      qi = qi + 1
    }
    bi = bi + 1
  }
}

