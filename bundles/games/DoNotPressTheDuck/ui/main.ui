<logic src="../logic/main.logic" />
<import Header from="./header.ui" />
<import Room from="./room.ui" />
<import Hero from="./hero.ui" />
<import Complications from="./complications.ui" />
<import Overlays from="./overlays.ui" />
<style>
/* An illustrated room, not an arcade dashboard. All artwork ships with the game. */
.duck-app { --ink:#293b38; --paper:#fff4d6; --gold:#f6ca50; --red:#da6252; --teal:#6ba7a1; --color-text:#293b38; --font-sans:'Trebuchet MS',Verdana,sans-serif; position:relative; width:100%; height:100%; min-height:0; overflow:hidden; display:flex; flex-direction:column; background:var(--paper)!important; color:var(--ink)!important; font-family:'Trebuchet MS',Verdana,sans-serif!important; font-size:14px!important; line-height:1.4!important; isolation:isolate; }
.duck-app *, .duck-app *::before,.duck-app *::after { box-sizing:border-box; }
.duck-app button,.duck-app span { font-family:inherit!important; }
.duck-app .smallprint { display:block; font-size:10px!important; font-weight:800!important; letter-spacing:1.9px; line-height:1.4!important; }
.duck-app button { touch-action:manipulation; -webkit-tap-highlight-color:transparent; }
.duck-app button:focus-visible { outline:4px solid #286967!important; outline-offset:5px; }
.duck-app button:disabled { cursor:default!important; }
.duck-app .ink-button { display:inline-flex!important; align-items:center!important; justify-content:center!important; background:var(--paper)!important; color:var(--ink)!important; min-height:44px; padding:10px 16px!important; height:auto!important; border:2px solid var(--ink)!important; border-radius:9px!important; font-size:11px!important; font-weight:900!important; letter-spacing:.7px; line-height:1.3!important; white-space:normal!important; box-shadow:0 3px 0 var(--ink)!important; cursor:pointer; transition:background .15s,box-shadow .15s; }
.duck-app .ink-button:hover { background:#ffe5a1!important; }
.duck-app .ink-button:active { box-shadow:0 1px 0 var(--ink)!important; }
.duck-app .ink-button:disabled { opacity:.5; }
.duck-app .button-red { background:var(--red)!important; color:var(--paper)!important; }
.duck-app .button-teal { background:var(--teal)!important; }
.duck-app .quiet-button { background:transparent!important; box-shadow:none!important; border-color:transparent!important; }
.masthead { flex:0 0 auto; min-height:104px; display:flex; align-items:center; justify-content:space-between; gap:20px; padding:18px 4%; z-index:30; border-bottom:3px solid var(--ink); }
.brand { display:flex; align-items:center; gap:15px; }
.brand-symbol { width:58px; height:58px; padding:6px; background:var(--gold); border:2px solid var(--ink); border-radius:50%!important; transform:rotate(-9deg); }
.brand-copy { display:flex; flex-direction:column; gap:3px; }
.game-title { display:block; font-size:clamp(20px,2.9vw,37px)!important; font-weight:1000!important; line-height:.95!important; letter-spacing:-1.7px; }
.game-title em { font-style:normal; }
.mast-tools { display:flex; align-items:center; gap:8px; }
.mast-tools .ink-button { font-size:10px!important; padding:9px 12px!important; }
.stage { flex:1 1 auto; min-height:0; position:relative; overflow:hidden; background:#b5d3c2; }
.world-back { position:absolute!important; inset:-3%; overflow:hidden; transform:rotate(var(--lean,0deg)); transition:transform 1s ease-in-out; pointer-events:none; }
.wall { position:absolute!important; inset:0 0 28%; background:radial-gradient(circle at 30% 45%,#f9f1d046 0 22%,transparent 48%),radial-gradient(#789b8222 1px,transparent 1px),#b5d3c2; background-size:auto,13px 13px,auto; }
.wall::after { content:''; position:absolute; bottom:0; left:0; right:0; height:12px; border-top:3px solid var(--ink); border-bottom:3px solid var(--ink); background:#77998a; }
.floor { position:absolute!important; inset:70% 0 0; background:repeating-linear-gradient(0deg,transparent 0 54px,#ad896144 54px 57px),repeating-linear-gradient(91deg,transparent 0 179px,#a8896755 179px 182px),#e7c792; box-shadow:inset 0 12px 0 #a68c6933; }
.floor::before { content:''; position:absolute; width:48%; height:65%; left:26%; top:10%; border:4px solid #325d595c; outline:5px solid #65938b; background:#79a69c; border-radius:50%; transform:rotate(-4deg); }
.floor::after { content:''; position:absolute; inset:18% 28% 39%; border:2px dashed #e5e9c6aa; border-radius:50%; transform:rotate(-4deg); }
.notice { position:absolute!important; left:50%; top:20%; width:clamp(154px,22vw,275px); transform:translate(-50%,-50%) rotate(-3deg); padding:18px 12px 13px; background:var(--paper); border:2px solid var(--ink); box-shadow:6px 7px 0 #325d5933; text-align:center; z-index:2; }
.notice::before,.notice::after { content:''; position:absolute; width:48px; height:17px; background:#d6b575aa; top:-8px; left:-11px; transform:rotate(-28deg); }
.notice::after { left:auto; right:-13px; transform:rotate(31deg); }
.notice .notice-title { display:block; font-size:clamp(22px,3vw,40px)!important; line-height:.94!important; letter-spacing:-1.5px; font-weight:1000!important; margin:7px 0; }
.notice .smallprint { font-size:8px!important; letter-spacing:1px; }
.odometer { position:absolute!important; left:4%; top:4%; display:flex; align-items:center; gap:10px; z-index:12; transform:rotate(-2deg); padding:8px 12px; border:2px solid var(--ink); border-radius:5px!important; background:var(--paper); box-shadow:3px 4px 0 #293b3833; }
.odometer .meter-label { font-size:8px!important; font-weight:900!important; line-height:1.2!important; letter-spacing:1px; max-width:84px; }
.odometer .meter-value { display:block; padding:2px 7px; background:var(--ink); color:var(--paper)!important; font-family:monospace!important; font-size:24px!important; font-weight:800!important; letter-spacing:4px; border:3px double #eac980; border-radius:3px; }
.era-label { position:absolute!important; left:50%; bottom:2%; transform:translateX(-50%); text-align:center; font-size:8px!important; letter-spacing:2px; font-weight:900!important; z-index:10; color:#34483ecc!important; white-space:nowrap; }
.scene-props,.scene-citizens { position:absolute!important; inset:0; pointer-events:none; }
.scenery,.citizen { position:absolute!important; pointer-events:none; }
.scenery img,.citizen img { display:block; width:100%; height:100%; object-fit:contain; }
.scenery { animation:arrive .45s cubic-bezier(.2,.8,.25,1) both; }
.citizen > * { transform-origin:50% 85%; }
.citizen.waddle > * { animation:waddle 2.8s ease-in-out infinite; }
.citizen.work > * { animation:work .75s ease-in-out infinite; }
.citizen.murmur > * { animation:murmur 1.6s ease-in-out infinite; }
.citizen.belt-duck > * { animation:convey 5s linear infinite; }
.scenery.gear > * { animation:spin 4s linear infinite; }
.scenery.gear-slow > * { animation:spin 11s linear infinite; }
.scenery.float > *,.citizen.float > * { animation:float 4s ease-in-out infinite; }
.scenery.float-small > * { animation:float-small 4s ease-in-out infinite; }
.scenery.breathe > *,.citizen.breathe > * { animation:breathe 3s ease-in-out infinite; }
.scenery.machine-breathe > * { animation:machine 1.1s ease-in-out infinite; }
.scenery.pencil-wag > * { animation:pencil 1.4s ease-in-out infinite; transform-origin:50% 95%; }
.scenery.cloud-drift > * { animation:cloud-drift 21s ease-in-out infinite alternate; }
.reverse > * { animation-direction:reverse!important; }
.scenery.kettle-wiggle > * { animation:kettle 3s ease-in-out infinite; }
.scenery.flame > * { animation:flame .18s ease-in-out infinite alternate; transform-origin:50% 0; }
.scenery.rocket-shake > * { animation:rocket .14s linear infinite; }
.scenery.orbit-satellite > * { animation:satellite 13s ease-in-out infinite; }
.scenery.mega-breathe > * { animation:mega 7s ease-in-out infinite; }
.hero-place { position:absolute!important; width:clamp(188px,26vw,340px); height:clamp(205px,29vw,370px); z-index:15; transform:translate(-50%,-50%); transition:left .4s,top .4s,width .4s,height .4s; }
.duck-app .hero-button { display:block!important; position:relative!important; width:100%!important; height:100%!important; padding:0!important; border:0!important; border-radius:45%!important; background:transparent!important; color:var(--ink)!important; box-shadow:none!important; cursor:pointer; outline-offset:2px!important; overflow:visible; }
.duck-app .hero-button:disabled { opacity:1!important; }
.hero-button * { pointer-events:none; }
.duck-shadow { position:absolute!important; left:9%; top:80%; width:86%; height:13%; background:#293b3835; border-radius:50%!important; filter:blur(2px); }
.button-bottom { position:absolute!important; left:13%; top:70%; width:75%; height:23%; background:#a0463d; border:4px solid var(--ink); border-radius:50%!important; }
.plinth-top { position:absolute!important; left:13%; top:64%; width:75%; height:24%; background:#df6c59; border:4px solid var(--ink); border-radius:50%!important; box-shadow:inset 0 -8px 0 #b75143,inset 0 5px 0 #f79877; }
.hero-body,.hero-head { position:absolute!important; inset:0; transform-origin:52% 70%; }
.hero-body { animation:duck-breathe 3.7s ease-in-out infinite; }
.hero-head { transform-origin:62% 47%; animation:duck-look 7s ease-in-out infinite; }
.hero-art { position:absolute!important; inset:0; width:100%; height:100%; object-fit:contain; }
.duck-eye { position:absolute!important; left:64.2%; top:25.8%; width:4.3%; height:5.6%; background:var(--ink); border-radius:50%!important; animation:blink 5.3s infinite; }
.duck-eye::after { content:''; position:absolute; left:46%; top:14%; width:29%; height:27%; background:var(--paper); border-radius:50%; }
.duck-eyebrow { display:none; position:absolute!important; left:61%; top:22%; width:10%; height:2%; border-radius:50%; background:var(--ink); transform:rotate(-15deg); }
.suspicious .duck-eyebrow { display:block; }
.button-label { position:absolute!important; left:33%; top:84%; font-size:clamp(8px,1vw,12px)!important; line-height:1!important; color:var(--paper)!important; font-weight:900!important; letter-spacing:2px; transform:rotate(-2deg); }
.hero-button:hover .hero-head,.hero-button:focus-visible .hero-head { filter:brightness(1.03); }
.hero-button:active .hero-body,.hero-button:active .hero-head { transform:translateY(7px) scaleY(.92); }
.pressed-a .hero-button { animation:squash-a .35s ease-out; }
.pressed-b .hero-button { animation:squash-b .35s ease-out; }
.hero-tiny { width:clamp(105px,13vw,156px); height:clamp(120px,15vw,177px); }
.hero-tiny .hero-body,.hero-tiny .hero-head { scale:.65; }
.hero-big { width:clamp(250px,38vw,460px); height:clamp(260px,39vw,470px); }
.hero-giant { width:clamp(310px,48vw,620px); height:clamp(330px,50vw,650px); }
.button-legs { display:none; position:absolute!important; inset:84% 19% 0; border-left:8px solid var(--ink); border-right:8px solid var(--ink); transform:skew(-10deg); }
.has-legs .button-legs { display:block; animation:legs .38s ease-in-out infinite alternate; }
.side-item { position:absolute!important; z-index:17; }
.duck-app .prop-button { border:none!important; box-shadow:none!important; background:transparent!important; padding:0!important; height:auto!important; min-width:44px; min-height:44px; display:flex!important; flex-direction:column!important; align-items:center!important; color:var(--ink)!important; cursor:pointer; overflow:visible; white-space:normal!important; }
.prop-button .prop-label { display:block; background:var(--paper); border:1px solid var(--ink); padding:3px 5px; font-size:8px!important; line-height:1.2!important; font-weight:800!important; border-radius:4px; max-width:140px; }
.lunch-bell { width:clamp(52px,7vw,92px); left:3%; bottom:8%; }
.lunch-bell .prop-button img { width:65px; height:60px; }
.quiet-plant-button { left:9%; top:56%; width:22%; height:29%; }
.quiet-plant-button .prop-button { width:100%; height:100%!important; justify-content:flex-end!important; }
.quiet-tea-button { right:20%; top:75%; width:80px; }
.quiet-tea-button img { width:62px; height:45px; }
.quiet-door-button { right:2%; top:25%; width:16%; height:43%; }
.quiet-door-button .prop-button { width:100%; height:100%!important; justify-content:flex-end!important; }
.duck-tv { right:2%; top:2%; width:clamp(117px,16vw,220px); height:clamp(92px,13vw,169px); }
.duck-tv .prop-button { position:relative; width:100%; height:100%!important; }
.duck-tv img { position:absolute; inset:0; width:100%; height:100%; object-fit:contain; }
.tv-headline { position:absolute!important; left:17%; top:47%; width:56%; font-size:clamp(6px,.67vw,9px)!important; line-height:1.1!important; padding:4px 2px; background:var(--ink); color:var(--paper)!important; font-weight:800!important; }
.gate-heading { position:absolute!important; left:50%; top:30%; transform:translate(-50%,-50%) rotate(-1deg); z-index:21; text-align:center; background:var(--paper); border:2px solid var(--ink); padding:9px 18px; box-shadow:4px 4px 0 #293b3833; width:max-content; max-width:83%; }
.gate-heading .smallprint { font-size:10px!important; letter-spacing:1px; }
.paper-form { position:absolute!important; left:50%; top:54%; transform:translate(-50%,-50%) rotate(2deg); background:#fff5dd; border:2px solid var(--ink); box-shadow:6px 6px 0 #293b3833; width:54%; height:46%; z-index:18; background-image:repeating-linear-gradient(0deg,transparent 0 26px,#e1d6b777 26px 27px); }
.duck-app .world-option { position:absolute!important; z-index:22; transform:translate(-50%,-50%); width:clamp(135px,19vw,234px); height:clamp(159px,22vw,256px)!important; min-width:68px; min-height:68px; padding:0 0 7px!important; display:flex!important; flex-direction:column!important; align-items:center!important; justify-content:center!important; border:0!important; background:transparent!important; box-shadow:none!important; color:var(--ink)!important; cursor:pointer; border-radius:20px!important; white-space:normal!important; transition:left .2s,top .2s; }
.world-option > * { pointer-events:none; }
.world-option .option-art { width:100%!important; height:76%!important; object-fit:contain; transition:transform .15s; }
.world-option:hover .option-art { transform:rotate(-4deg) scale(1.05); }
.world-option:active .option-art { transform:translateY(5px) scale(.94); }
.duck-app .option-small { width:clamp(84px,17vw,205px); height:clamp(135px,21vw,235px)!important; }
.option-label { display:block; max-width:100%; font-size:clamp(8px,.82vw,11px)!important; font-weight:900!important; letter-spacing:.6px; line-height:1.25!important; background:var(--paper); border:2px solid var(--ink); border-radius:5px; padding:5px 8px; }
.option-key { display:inline-flex!important; align-items:center; justify-content:center; width:25px; height:24px; background:var(--ink); border:1px solid var(--paper); border-radius:50%; color:var(--paper)!important; font-size:11px!important; font-weight:800!important; position:absolute; top:1%; left:1%; }
.option-clone::before { content:''; position:absolute; left:4%; right:4%; bottom:18%; height:22%; background:var(--red); border:3px solid var(--ink); border-radius:50%; z-index:-1; box-shadow:0 7px 0 #984e43; }
.option-chase::after { content:''; position:absolute; left:15%; right:15%; bottom:9%; height:12%; border-left:5px solid var(--ink); border-right:5px solid var(--ink); z-index:-2; transform:skew(-10deg); }
.option-done { opacity:.65!important; cursor:default!important; }
.option-done .option-label { color:#325d59!important; border:3px double #325d59; transform:rotate(-9deg); }
.option-done .option-art { transform:rotate(23deg); }
.turn-1 .option-art { transform:rotate(25deg); }
.turn-2 .option-art { transform:rotate(-25deg); }
.option-stamp { max-width:19%; }
.gate-tools { position:absolute!important; left:50%; top:82%; transform:translate(-50%,-50%); display:flex; flex-direction:column; align-items:center; gap:6px; z-index:24; max-width:92%; text-align:center; }
.gate-tools .ink-button { font-size:10px!important; min-height:40px; padding:7px 12px!important; }
.gate-hint { font-size:11px!important; max-width:600px; line-height:1.3!important; padding:4px 9px; border-radius:4px; background:var(--paper); color:var(--ink)!important; }
.help-actions { display:flex; gap:8px; }
.particles { position:absolute!important; inset:0; pointer-events:none; z-index:26; overflow:hidden; }
.particle { position:absolute!important; left:50%; top:60%; width:10px; height:12px; background:var(--gold); border:1px solid #293b3844; animation:particle-flight 1.3s var(--delay) ease-out both; }
.particle.shade-1 { background:var(--red); }
.particle.shade-2 { background:var(--teal); }
.particle.shade-3 { background:var(--paper); }
.particle-dust { width:26px; height:25px; border:0; border-radius:50%!important; background:#f7e9bdc9!important; }
.particle-heart { width:14px; height:14px; background:var(--red)!important; clip-path:polygon(50% 100%,0 42%,0 18%,18% 0,40% 0,50% 17%,60% 0,82% 0,100% 18%,100% 42%); }
.particle-star { clip-path:polygon(50% 0,62% 35%,100% 40%,72% 65%,80% 100%,50% 80%,20% 100%,28% 65%,0 40%,38% 35%); width:20px; height:20px; }
.particle-crumb { border-radius:3px!important; background:#d99c58!important; }
.particle-pop { width:25px; height:25px; background:transparent!important; border:3px solid var(--paper); border-radius:50%!important; }
.wall-crack { position:absolute!important; right:4%; top:0; width:17%; height:59%; background:#325d59; clip-path:polygon(48% 0,57% 13%,36% 28%,52% 44%,25% 56%,53% 82%,41% 100%,45% 80%,17% 54%,43% 44%,28% 28%,47% 13%,41% 0); opacity:.65; }
.ceiling-gone .wall { background:radial-gradient(ellipse at 50% 6%,#acd4d6 0 39%,transparent 40%),#b5d3c2; }
.scene-rooftop .wall,.scene-launch .wall { background:linear-gradient(#add4d2,#e9efcc)!important; }
.scene-rooftop .wall::after { height:42px; background:repeating-linear-gradient(90deg,#8fa89a 0 68px,#6c8b7d 68px 71px); }
.scene-launch .wall { animation:sky-launch 4.2s linear forwards; }
.scene-launch .world-back { animation:room-launch 4.2s ease-in both; }
.scene-space .stage,.scene-cosmos .stage { background:#213f43; }
.scene-space .wall,.scene-cosmos .wall { background:radial-gradient(circle at 12% 19%,#ffe8a1 0 2px,transparent 3px),radial-gradient(circle at 71% 28%,#c5eee5 0 2px,transparent 3px),radial-gradient(circle at 83% 9%,#ffe8a1 0 1px,transparent 2px),radial-gradient(circle at 37% 64%,#c5eee5 0 1px,transparent 2px),radial-gradient(ellipse at 54% 90%,#627363,#253f44 72%); background-size:153px 131px,223px 193px,181px 177px,97px 151px,auto; }
.scene-space .wall::after,.scene-cosmos .wall::after { background:#698b85; }
.scene-space .floor,.scene-cosmos .floor { background:radial-gradient(ellipse at 15% 66%,#849b8e 0 5%,transparent 5.4%),radial-gradient(ellipse at 70% 67%,#809388 0 8%,transparent 8.4%),#b7c3a4; }
.scene-cosmos .wall { background-color:#233940; }
.scene-cosmos .era-label,.scene-space .era-label { color:#293b38!important; }
.orbital-ring { position:absolute!important; left:11%; top:12%; width:81%; height:60%; border:14px double #f6ca50aa; border-radius:50%!important; transform:rotate(-18deg); z-index:2; pointer-events:none; }
.orbital-ring::before { content:''; position:absolute; left:0; top:45%; width:22px; height:22px; border:3px solid var(--ink); border-radius:50%; background:var(--paper); }
.launch-label,.alarm-light { position:absolute!important; z-index:23; }
.launch-label { top:33%; left:50%; transform:translateX(-50%) rotate(-3deg); padding:12px 18px; width:max-content; max-width:82%; background:var(--paper); border:3px solid var(--ink); font-size:14px!important; font-weight:900!important; text-align:center; }
.alarm-light { left:47%; top:6%; width:35px; height:27px; border:3px solid var(--ink); border-radius:20px 20px 3px 3px!important; background:var(--red); animation:alarm 1.3s ease-in-out infinite; }
.golden-hour .wall { background:linear-gradient(#d6cca0,#f4d5a3); }
.scene-garden .wall,.scene-park .wall,.scene-pond .wall { background:radial-gradient(circle at 77% 23%,#ffdc7b 0 8%,transparent 8.4%),linear-gradient(#b9dcd0,#f4e6b4); }
.scene-garden .wall::after,.scene-park .wall::after,.scene-pond .wall::after { background:#8cba94; border:none; height:35%; border-radius:45% 65% 0 0; }
.scene-garden .floor,.scene-park .floor { background:#9bb786; box-shadow:none; }
.scene-pond .floor { background:#77b1ac; box-shadow:none; }
.scene-pond .floor::before,.scene-park .floor::before { background:#89c4bf; border-color:#5f928b; outline:none; }
.scene-garden .floor::before { background:#ddc6a0; border:none; outline:none; }
.ending-certificate { position:absolute!important; left:50%; top:35%; transform:translate(-50%,-50%) rotate(-1deg); z-index:25; width:min(540px,86%); padding:23px 27px 20px; border:3px solid var(--ink); background:var(--paper); box-shadow:7px 8px 0 #293b3833; text-align:center; }
.ending-certificate::before { content:''; position:absolute; inset:7px; border:1px solid #c9b88a; pointer-events:none; }
.ending-title { display:block; font-size:clamp(21px,2.4vw,31px)!important; font-weight:1000!important; line-height:1.06!important; letter-spacing:-1px; margin:7px 0 12px; }
.ending-body { display:block; font-size:13px!important; line-height:1.6!important; }
.ending-seal { display:inline-block; margin:13px 0 9px; border:3px double #b95043; color:#a44438!important; padding:5px 12px; font-size:12px!important; line-height:1.1!important; font-weight:900!important; letter-spacing:1px; transform:rotate(-5deg); }
.ending-certificate .smallprint { font-size:8px!important; letter-spacing:1px; }
.ending-actions { display:flex; justify-content:center; gap:9px; margin-top:13px; }
.hero-ending { width:180px; height:190px; z-index:14; }
.finale-card { position:absolute!important; z-index:25; top:47%; left:50%; width:min(640px,93%); transform:translate(-50%,-50%); padding:20px; text-align:center; }
.finale-line { display:block; background:var(--paper); border:2px solid var(--ink); padding:12px 20px; font-weight:900!important; font-size:clamp(17px,2vw,28px)!important; line-height:1.15!important; box-shadow:5px 5px 0 #293b3833; transform:rotate(-2deg); }
.finale-choices { display:flex; justify-content:center; gap:15px; margin-top:28px; }
.duck-app .ending-choice { display:flex!important; flex-direction:column!important; align-items:center!important; gap:10px; width:31%; max-width:180px; height:150px!important; background:var(--paper)!important; color:var(--ink)!important; border:2px solid var(--ink)!important; border-radius:3px!important; padding:13px!important; box-shadow:4px 5px 0 #293b3855!important; white-space:normal!important; transform:rotate(-3deg); cursor:pointer; }
.ending-choice:nth-child(2) { transform:rotate(2deg); }
.ending-choice:nth-child(3) { transform:rotate(-1deg); }
.ending-choice img { width:72px; height:72px; object-fit:contain; }
.ending-choice span { font-size:11px!important; font-weight:900!important; line-height:1.2!important; }
.caption-strip { flex:0 0 auto; z-index:30; background:var(--paper); border-top:3px solid var(--ink); padding:14px 4% 10px; display:flex; align-items:center; justify-content:space-between; gap:18px; min-height:99px; }
.caption-main { display:flex; gap:13px; align-items:center; max-width:870px; }
.narrator-mark { display:flex; align-items:center; justify-content:center; width:38px; height:38px; flex:0 0 38px; border:2px solid var(--ink); border-radius:50%!important; font-size:23px!important; font-weight:900!important; background:var(--gold); transform:rotate(-7deg); }
.caption-copy { display:flex; flex-direction:column; gap:3px; }
.caption-speaker { font-size:9px!important; letter-spacing:1.5px; font-weight:900!important; }
.caption-text { display:block; font-size:clamp(13px,1.28vw,18px)!important; line-height:1.28!important; font-weight:700!important; }
.controls-hint { flex:0 0 auto; max-width:175px; font-size:9px!important; line-height:1.6!important; color:#496059!important; }
.overlay-back { position:absolute!important; inset:0; z-index:80; background:#213b38a8; display:flex; align-items:center; justify-content:center; padding:18px; overflow:auto; backdrop-filter:blur(3px); }
.paper-dialog { width:min(590px,100%); max-height:100%; overflow:auto; background:var(--paper); border:3px solid var(--ink); padding:25px 28px; box-shadow:8px 9px 0 #182e2a66; transform:rotate(-.5deg); }
.dialog-top { display:flex; justify-content:space-between; gap:14px; align-items:center; margin-bottom:15px; }
.dialog-title { display:block; font-size:29px!important; font-weight:1000!important; letter-spacing:-1px; line-height:1.1!important; }
.dialog-copy { display:block; font-size:14px!important; line-height:1.65!important; margin:10px 0; }
.pause-art { width:140px; height:126px; margin:0 auto; }
.dialog-buttons { display:flex; gap:10px; flex-wrap:wrap; margin-top:20px; }
.setting-row { display:flex; align-items:center; justify-content:space-between; gap:20px; padding:13px 0; border-bottom:1px dashed #b8aa87; }
.setting-label { font-size:13px!important; font-weight:800!important; }
.setting-note { display:block; font-size:11px!important; color:#52655a!important; line-height:1.4!important; }
.setting-row .ink-button { min-width:96px; }
.save-note { display:block; font-size:10px!important; line-height:1.5!important; color:#52655a!important; margin-top:14px; }
.reset-confirm { border:2px dashed var(--red); padding:15px; margin-top:16px; }
.scrapbook { display:grid; grid-template-columns:1fr 1fr; gap:13px; margin-top:18px; }
.scrap { min-height:112px; border:2px solid #a1906a; padding:13px; text-align:center; background:#fff9e8; transform:rotate(-2deg); }
.scrap:nth-child(even) { transform:rotate(2deg); }
.scrap .smallprint { letter-spacing:.6px; }
.scrap-title { display:block; font-size:13px!important; font-weight:800!important; margin-top:12px; }
.scrap-found .smallprint { border:3px double #b95043; padding:6px; color:#9d4b3e!important; transform:rotate(-3deg); }
.scrap-locked { border-style:dashed; color:#728277; }
.scrap-locked .smallprint { font-size:28px!important; color:#83917b!important; }
.breathe { transform-origin:50% 85%; }
.bump { animation:bump .32s ease-out; }
.still *,.still *::before,.still *::after { animation-play-state:paused!important; }
.low-motion *,.low-motion *::before,.low-motion *::after { animation:none!important; transition:none!important; }
@media(prefers-reduced-motion:reduce) { .duck-app *,.duck-app *::before,.duck-app *::after { animation:none!important; transition:none!important; } }
@keyframes arrive { from { opacity:0; filter:brightness(1.5); } to { opacity:1; filter:brightness(1); } }
@keyframes duck-breathe { 0%,100% { transform:scaleY(1); } 50% { transform:scaleY(1.018); } }
@keyframes duck-look { 0%,32%,54%,100% { transform:rotate(0); } 37%,48% { transform:rotate(-7deg); } 73%,86% { transform:rotate(4deg); } }
@keyframes blink { 0%,43%,46%,78%,81%,100% { transform:scaleY(1); } 44%,45%,79%,80% { transform:scaleY(.13); } }
@keyframes squash-a { 0%,100% { transform:scale(1); } 35% { transform:scale(1.07,.91) translateY(7px); } 65% { transform:scale(.98,1.02); } }
@keyframes squash-b { 0%,100% { transform:scale(1); } 35% { transform:scale(1.07,.91) translateY(7px); } 65% { transform:scale(.98,1.02); } }
@keyframes waddle { 0%,100% { transform:translateX(-5px) rotate(-4deg); } 25%,75% { transform:translateY(-4px) rotate(3deg); } 50% { transform:translateX(7px) rotate(-2deg); } }
@keyframes work { 0%,100% { transform:rotate(-7deg); } 55% { transform:rotate(9deg) translateY(-4px); } }
@keyframes murmur { 0%,100% { transform:rotate(-2deg); } 30% { transform:rotate(4deg) translateY(-3px); } 60% { transform:rotate(-3deg); } }
@keyframes convey { from { transform:translateX(-9px) rotate(-3deg); } 50% { transform:translateX(5px) rotate(3deg); } to { transform:translateX(18px) rotate(-3deg); } }
@keyframes spin { to { transform:rotate(360deg); } }
@keyframes float { 0%,100% { transform:translateY(-8px) rotate(-7deg); } 50% { transform:translateY(12px) rotate(8deg); } }
@keyframes float-small { 0%,100% { transform:translateY(-3px); } 50% { transform:translateY(4px); } }
@keyframes breathe { 0%,100% { transform:scale(1); } 50% { transform:scale(1.025); } }
@keyframes machine { 0%,100% { transform:translateY(0); } 40%,60% { transform:translateY(1px); } 50% { transform:translateY(-2px); } }
@keyframes pencil { 0%,100% { transform:rotate(-4deg); } 50% { transform:rotate(5deg); } }
@keyframes cloud-drift { from { transform:translateX(-12px); } to { transform:translateX(28px); } }
@keyframes kettle { 0%,30%,100% { transform:rotate(0); } 40%,60% { transform:rotate(3deg); } 50%,70% { transform:rotate(-3deg); } }
@keyframes flame { from { transform:scale(.88,.7); } to { transform:scale(1.09,1.12); } }
@keyframes rocket { 0%,100% { transform:translateX(-2px); } 50% { transform:translateX(2px); } }
@keyframes satellite { 0%,100% { transform:translate(0,-3px) rotate(-12deg); } 50% { transform:translate(15px,10px) rotate(14deg); } }
@keyframes mega { 0%,100% { transform:scale(1) rotate(-2deg); } 50% { transform:scale(1.06) rotate(2deg); } }
@keyframes legs { from { transform:skew(-18deg); } to { transform:skew(18deg); } }
@keyframes particle-flight { from { opacity:1; transform:translate(0,0) rotate(0) scale(.6); } to { opacity:0; transform:translate(var(--dx),var(--dy)) rotate(var(--twist)) scale(1); } }
@keyframes sky-launch { from { background-color:#add4d2; filter:brightness(1); } to { background-color:#213f43; filter:brightness(.4); } }
@keyframes room-launch { 0%,15% { transform:translateY(0); } 35% { transform:translateY(12px) rotate(-2deg); } 65% { transform:translateY(-16px) rotate(2deg); } 100% { transform:translateY(-28px); } }
@keyframes alarm { 0%,100% { box-shadow:0 0 0 0 #ff9a4830; } 50% { box-shadow:0 0 30px 15px #ff9a4860; } }
@keyframes bump { 0%,100% { transform:translate(0); } 25% { transform:translate(3px,2px); } 55% { transform:translate(-3px,-1px); } 80% { transform:translate(1px,1px); } }
@media(min-width:1600px) { .masthead,.caption-strip { padding-left:6%; padding-right:6%; } }
@media(max-width:760px) {
 .masthead { min-height:90px; padding:13px 4%; gap:9px; }
 .brand { gap:8px; } .brand-symbol { width:43px; height:43px; padding:4px; }
 .game-title { font-size:24px!important; letter-spacing:-1px; max-width:220px; }
 .brand-copy .smallprint { font-size:7px!important; letter-spacing:1px; }
 .mast-tools { gap:4px; } .mast-tools .ink-button { min-width:42px; padding:7px!important; font-size:9px!important; }
 .tool-word { display:none!important; }
 .caption-strip { padding:11px 4% 9px; min-height:111px; gap:8px; flex-direction:column; align-items:stretch; }
 .caption-main { gap:9px; } .narrator-mark { width:30px; height:30px; flex-basis:30px; font-size:19px!important; }
 .caption-text { font-size:14px!important; } .caption-speaker { font-size:8px!important; }
 .controls-hint { max-width:none; font-size:8px!important; text-align:center; }
 .notice { top:21%; width:178px; padding:12px 8px; } .notice .notice-title { font-size:28px!important; }
 .notice .smallprint { font-size:7px!important; }
 .odometer { padding:5px 7px; gap:6px; top:3%; }
 .odometer .meter-label { max-width:67px; font-size:6px!important; } .odometer .meter-value { font-size:19px!important; letter-spacing:2px; }
 .hero-place { width:210px; height:236px; }
 .hero-tiny { width:108px; height:122px; }
 .hero-big { width:280px; height:305px; }
 .hero-giant { width:355px; height:389px; }
 .hero-ending { width:165px; height:180px; }
 .gate-heading { top:28%; padding:8px 12px; max-width:90%; }
 .gate-heading .smallprint { font-size:9px!important; }
 .world-option { width:160px!important; height:185px!important; }
 .duck-app .option-small { width:100px!important; height:156px!important; }
 .duck-app .option-stamp { width:100px!important; max-width:24%; height:150px!important; }
 .paper-form { width:74%; height:43%; }
 .option-label { font-size:8px!important; padding:5px 5px; }
 .option-key { width:22px; height:22px; font-size:10px!important; }
 .gate-tools { top:83%; width:94%; }
 .gate-hint { font-size:10px!important; } .gate-tools .ink-button { font-size:9px!important; }
 .lunch-bell { bottom:6%; } .lunch-bell .prop-button img { width:48px; height:47px; }
 .era-label { font-size:6px!important; letter-spacing:1px; }
 .ending-certificate { padding:19px 18px 15px; top:34%; }
 .ending-title { font-size:23px!important; } .ending-body { font-size:12px!important; line-height:1.5!important; }
 .ending-seal { font-size:10px!important; margin:10px 0; }
 .ending-actions .ink-button { font-size:10px!important; }
 .finale-card { top:49%; padding:5px; }
 .finale-choices { gap:8px; margin-top:21px; }
 .duck-app .ending-choice { padding:9px 5px!important; height:133px!important; }
 .ending-choice img { width:60px; height:61px; }
 .ending-choice span { font-size:9px!important; }
 .paper-dialog { padding:19px; } .dialog-title { font-size:25px!important; }
 .setting-row { padding:9px 0; } .setting-label { font-size:12px!important; }
}
@media(max-width:390px) {
 .brand-symbol { display:none; } .game-title { max-width:185px; font-size:22px!important; }
 .duck-app .option-small { width:88px!important; }
 .quiet-tea-button { right:21%; width:61px; }
 .notice { width:152px; } .notice .notice-title { font-size:25px!important; }
}
@media(max-height:540px) and (min-width:600px) {
 .masthead { min-height:61px; padding:8px 3%; } .game-title { font-size:25px!important; } .brand-symbol { width:40px; height:40px; }
 .brand-copy .smallprint { font-size:7px!important; } .mast-tools .ink-button { min-height:36px; }
 .caption-strip { min-height:68px; padding:9px 3%; flex-direction:row; } .caption-text { font-size:13px!important; }
 .hero-place { width:150px; height:164px; } .hero-big { width:185px; height:205px; } .hero-giant { width:255px; height:280px; } .hero-tiny { width:90px; height:100px; }
 .notice { top:21%; padding:7px; width:145px; } .notice .notice-title { font-size:21px!important; margin:4px; } .notice .smallprint { font-size:6px!important; }
 .gate-heading { top:19%; padding:5px 10px; } .gate-heading .smallprint { font-size:9px!important; }
 .duck-app .world-option { width:115px!important; height:129px!important; } .duck-app .option-small { width:99px!important; height:125px!important; }
 .gate-tools { top:86%; flex-direction:row; width:95%; justify-content:center; } .gate-tools .ink-button { min-height:32px; font-size:8px!important; }
 .gate-hint { font-size:9px!important; max-width:370px; }
 .option-label { font-size:8px!important; padding:3px 5px; } .option-key { width:20px; height:20px; }
 .ending-certificate { top:43%; width:min(490px,82%); padding:12px 20px; } .ending-title { font-size:21px!important; margin:4px 0; } .ending-body { font-size:11px!important; line-height:1.3!important; } .ending-seal { margin:5px 0; font-size:9px!important; }
 .ending-actions { margin-top:7px; } .ending-actions .ink-button { min-height:34px; padding:6px 10px!important; font-size:9px!important; }
 .hero-ending { display:none; } .finale-choices { margin-top:13px; } .duck-app .ending-choice { height:111px!important; } .ending-choice img { height:46px; } .finale-line { font-size:17px!important; padding:9px; }
 .quiet-plant-button .prop-label,.quiet-door-button .prop-label { font-size:6px!important; } .quiet-tea-button img { width:40px; height:30px; } .quiet-tea-button { top:71%; }
 .lunch-bell .prop-button img { width:40px; height:36px; } .era-label { display:none!important; }
}
.notice-title,.meter-label,.ending-choice span { white-space:pre-line; }
.mast-tools .ink-button { font-size:20px!important; min-width:44px; gap:5px; }
.mast-tools .tool-word { font-size:10px!important; letter-spacing:0; }
.brand,.brand-copy { min-width:0; } .mast-tools { flex-shrink:0; }
.scene-pond .stage { background:#254c49; }
.scene-pond .wall { background:radial-gradient(circle at 20% 19%,#ffe8a1 0 2px,transparent 3px),radial-gradient(circle at 70% 34%,#bbe3d3 0 2px,transparent 3px),#254c49;background-size:167px 143px,231px 179px,auto; }
.scene-pond .wall::after { display:none; }
.scene-pond .floor { border-top:4px solid #426e66; background:repeating-radial-gradient(ellipse at 20% 100%,transparent 0 36px,#d4e9c833 38px 39px,transparent 41px 73px),#5b9790; }
.scene-pond .floor::before,.scene-pond .floor::after { display:none; }
.tuning-tv { right:auto;left:46%;top:53%;width:clamp(220px,37vw,460px);height:clamp(180px,30vw,360px);transform:translate(-50%,-50%);z-index:19; }
.tuning-tv .tv-headline { font-size:clamp(9px,1.4vw,16px)!important; }
.tv-static { position:absolute!important;left:16%;top:28%;width:58%;height:35%;background:repeating-linear-gradient(13deg,#d7dfc9 0 2px,#436b65 3px 5px,#fff4d6 6px 7px);opacity:.8;animation:tv-static .33s steps(2) infinite; }
.duck-app .option-knob { width:clamp(90px,13vw,160px)!important;height:clamp(125px,16vw,195px)!important;left:65%!important;top:61%!important; }
.gate-tools .ink-button { min-height:44px; }
@keyframes tv-static { 0%{background-position:0 0}100%{background-position:4px 8px} }
@media(max-width:760px){.duck-app .option-knob{left:75%!important;width:90px!important;height:125px!important;}}
@media(max-height:540px) and (min-width:600px){
 .duck-app .world-option{top:51%!important;height:108px!important;}
 .gate-tools{top:88%;}.gate-tools .ink-button{min-height:40px;}
 .tuning-tv{width:220px;height:172px;top:52%;}
 .duck-app .option-knob{left:66%!important;top:58%!important;width:85px!important;height:110px!important;}
}




/* MOBILE EDITION START */
/* Mobile edition: legible captions, safe areas and scrollable short-screen dialogs. */
.duck-app {padding-top:env(safe-area-inset-top);padding-bottom:env(safe-area-inset-bottom);}
.duck-app .masthead,.duck-app .caption-strip {padding-left:max(12px,env(safe-area-inset-left));padding-right:max(12px,env(safe-area-inset-right));}
.duck-app .ink-button {min-height:44px!important;min-width:44px;}
.duck-app .paper-dialog {max-height:100%;overflow:auto;overscroll-behavior:contain;}
.duck-app .controls-hint {font-size:11px!important;line-height:1.5!important;}
.duck-app .gate-hint {font-size:12px!important;}
@media(max-width:430px) {
 .duck-app .masthead {min-height:74px;padding:10px 12px;gap:8px;}
 .duck-app .game-title {font-size:clamp(18px,5.4vw,23px)!important;}
 .duck-app .brand-copy .smallprint {font-size:8px!important;letter-spacing:.6px;}
 .duck-app .caption-strip {min-height:82px;padding:8px 12px;}
 .duck-app .caption-main {min-width:0;}
 .duck-app .caption-text {font-size:14px!important;}
 .duck-app .hero-giant {width:min(330px,90vw);height:min(360px,98vw);}
 .duck-app .setting-row {flex-wrap:wrap;gap:8px;}
 .duck-app .option-label {font-size:11px!important;}
}
@media(max-height:540px) and (min-width:600px) {
 .duck-app .masthead {min-height:54px;padding-top:4px;padding-bottom:4px;}
 .duck-app .caption-strip {min-height:64px;padding-top:6px;padding-bottom:6px;}
 .duck-app .controls-hint {display:none;}
 .duck-app .gate-tools {top:auto;bottom:5px;}
 .duck-app .gate-hint {font-size:11px!important;}
 .duck-app .ending-certificate {max-height:95%;overflow:auto;top:50%;}
}

/* MOBILE EDITION END */
</style>
<Box className={view.rootClass}>
  <Header />
  <Box className={view.pressureClass}>
    <Room />
    <Hero />
    <Complications />
  </Box>
  <Box className="caption-strip">
    <Box className="caption-main" if={view.captions}>
      <Text className="narrator-mark">!</Text>
      <Box className="caption-copy"><Text className="caption-speaker">{view.speaker}</Text><Text className="caption-text">{view.caption}</Text></Box>
    </Box>
    <Text className="controls-hint">{view.footerHint}</Text>
  </Box>
  <Overlays />
  <Loop interval={50} running={true} @tick={tick} />
</Box>
