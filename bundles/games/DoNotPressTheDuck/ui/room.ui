<Box className="world-back" style={view.backgroundStyle}>
  <Box className="wall"><Box if={view.showCrack} className="wall-crack" /></Box>
  <Box className="floor" />
  <Box if={view.showRing} className="orbital-ring" />
  <Box className="scene-props">
    #each (a in scenery)
    <Box className={a.className} style={a.style}><Image loading="eager" src={asset(a.src)} width="100%" height="100%" objectFit="contain" showPlaceholder={false} alt="" /></Box>
    #end
  </Box>
  <Box if={view.showNotice} className="notice"><Text className="smallprint">IMPORTANT NOTICE / No. 001</Text><Text className="notice-title">{"DO NOT PRESS\nTHE DUCK."}</Text><Text className="smallprint">This includes polite pressing.</Text></Box>
  <Box className="scene-citizens">
    #each (a in cast)
    <Box className={a.className} style={a.style}><Image loading="eager" src={asset(a.src)} width="100%" height="100%" objectFit="contain" showPlaceholder={false} alt="" style={a.delayStyle} /></Box>
    #end
  </Box>
</Box>
<Box if={view.showMeter} className="odometer"><Text className="meter-label">{"UNAUTHORISED\nPRESSES"}</Text><Text className="meter-value">{view.pressLabel}</Text></Box>
<Text if={!view.showEnding} className="era-label">{view.era}</Text>
<Box if={view.showBell} className="side-item lunch-bell"><Button className="prop-button" ariaLabel="Ring the lunch bell for a free crumb" disabled={view.blocked} @click={sideAction("bell")}><Image loading="eager" src={asset("assets/art/bell.svg")} width="100%" height="100%" objectFit="contain" showPlaceholder={false} alt="" /><Text className="prop-label">LUNCH?</Text></Button></Box>
<Box if={view.showTV} className={view.tvClass}><Button className="prop-button" ariaLabel="Change the Duck TV channel" disabled={view.blocked || view.showGate} @click={sideAction("tv")}><Image loading="eager" src={asset("assets/art/tv.svg")} width="100%" height="100%" objectFit="contain" showPlaceholder={false} alt="" /><Box if={view.tvStatic} className="tv-static" /><Text className="tv-headline">{view.tvLine}</Text></Button></Box>
<Box if={view.showPlant} className="side-item quiet-plant-button"><Button className="prop-button" ariaLabel="Water the plant" disabled={view.blocked} @click={sideAction("plant")}><Text className="prop-label">{view.plantLabel}</Text></Button></Box>
<Box if={view.showTea} className="side-item quiet-tea-button"><Button className="prop-button" ariaLabel="Have some tea with the duck" disabled={view.blocked} @click={sideAction("tea")}><Image loading="eager" src={asset("assets/art/tea.svg")} width="100%" height="100%" objectFit="contain" showPlaceholder={false} alt="" /><Text className="prop-label">{view.teaLabel}</Text></Button></Box>
<Box if={view.showDoor} className="side-item quiet-door-button"><Button className="prop-button" ariaLabel="Open the door and go outside with the duck" disabled={view.blocked} @click={sideAction("door")}><Text className="prop-label">SOMEWHERE ELSE</Text></Button></Box>
<Box if={view.showAlarm} className="alarm-light" />
<Text if={view.showLaunch} className="launch-label">{view.launchLabel}</Text>
<Box className="particles">
  #each (a in particles)
  <Box className={a.className} style={a.style} />
  #end
</Box>
