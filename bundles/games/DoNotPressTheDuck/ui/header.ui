<Box className="masthead">
  <Box className="brand">
    <Box className="brand-symbol"><Image loading="eager" src={asset("assets/art/duck.svg")} width="100%" height="100%" objectFit="contain" showPlaceholder={false} alt="" /></Box>
    <Box className="brand-copy"><Text className="smallprint">AN INTERACTIVE CAUTIONARY TALE</Text><Text className="game-title">DO NOT PRESS THE DUCK</Text></Box>
  </Box>
  <Box className="mast-tools">
    <Button className="ink-button quiet-button" ariaLabel={view.soundAria} title={view.soundAria} disabled={view.blocked} @click={toggleSound}><Text>{view.muted ? "♪ ×" : "♪"}</Text><Text className="tool-word">{view.muted ? " OFF" : " ON"}</Text></Button>
    <Button className="ink-button quiet-button" ariaLabel="Open the ending scrapbook" title="Scrapbook" disabled={view.blocked} @click={openGallery}><Text>▧</Text><Text className="tool-word">{view.collectionLabel}</Text></Button>
    <Button className="ink-button" ariaLabel="Pause and settings, Escape" title="Pause / Escape" disabled={view.blocked} @click={pauseGame}>Ⅱ</Button>
  </Box>
</Box>
