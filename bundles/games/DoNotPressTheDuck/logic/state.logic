// Only S, profile and settings are persisted. Presentation and audio are disposable.
let S = null;
let profile = { endings: [], best: 0, sessions: 0, legacyCompleted: 0 };
let settings = { muted: false, volume: 0.65, reducedMotion: false, assist: false, captions: true, ambience: true };
let paused = false;
let overlay = "";
let resetIntent = "";
let lastClock = 0;
let saveClock = 0;
let saveStatus = "Saved only on this device";
let worldDirty = true;
let inputCleanup = null;
let cooldown = 0;
let actionCooldown = 0;
let effectLife = 0;
let effectKind = "";
let effectSerial = 0;
let soundUnlocked = false;
let audioClock = 0;
let audioGeneration = 0;
let soundTimes = {};
let pulse = false;
let autoPaused = false;
let hintShown = false;
let view = {};
let cast = [];
let scenery = [];
let particles = [];
let options = [];
let stamps = [];
let collection = [];
function clamp(n, a, b) { return Math.max(a, Math.min(b, n)); }
function copy(v) { return JSON.parse(JSON.stringify(v)); }
function isNumber(n, lo, hi) { return typeof n === "number" && isFinite(n) && n >= lo && n <= hi; }
function integer(n, lo, hi) { return isNumber(n, lo, hi) && Math.floor(n) === n; }
function freshState() {
    return {
        id: GAME_ID, version: VERSION, presses: 0, time: 0, patience: 0, quietBeat: 0,
        phase: "play", ending: "", finaleTime: 0, launchTime: 0, launched: false,
        gate: { kind: "", progress: 0, bits: 0, variant: 0, age: 0, mistakes: 0 },
        scene: "room", line: "There is one rule. You seem qualified.", speaker: "THE ROOM",
        effect: "", effectAt: 0, souvenir: false, tea: false, watered: false, doorOpen: false,
        extras: 0, tune: 0, gravity: 0, seed: 73129, history: [], assisted: 0
    };
}
function rnd() { S.seed = (S.seed * 48271) % 2147483647; return S.seed / 2147483647; }
function tell(line, speaker) { S.line = line; S.speaker = speaker || "THE ROOM"; }
function record(id) { if (S.history.indexOf(id) < 0) { S.history.push(id); if (S.history.length > 128) S.history.shift(); } }
function active() { return S && !paused && !overlay && S.phase === "play"; }
function currentEra() { let v = ERAS[0]; for (let i = 0; i < ERAS.length; i++) { if (S.presses >= ERAS[i].at) v = ERAS[i]; } return v; }
function endingById(id) { for (let i = 0; i < ENDINGS.length; i++) { if (ENDINGS[i].id === id) return ENDINGS[i]; } return null; }
function flashEffect(kind, duration) {
    effectKind = kind; effectLife = duration || 1.2; effectSerial++; pulse = !pulse;
    S.effect = kind; S.effectAt = S.time; worldDirty = true;
    buildParticles(kind);
}
function completeEnding(id) {
    if (S.phase === "ending" || !endingById(id)) return false;
    if ((id === "quiet" || id === "outside") && (S.presses !== 0 || S.phase !== "play")) return false;
    if (id === "quiet" && S.patience < 150) return false;
    if (id === "outside" && S.patience < 110) return false;
    if (id !== "quiet" && id !== "outside" && S.phase !== "finale") return false;
    S.ending = id; S.phase = "ending"; S.gate.kind = "";
    if (profile.endings.indexOf(id) < 0) profile.endings.push(id);
    profile.best = Math.max(profile.best, S.presses);
    S.scene = id === "pond" ? "pond" : (id === "park" ? "park" : (id === "president" ? "cosmos" : "garden"));
    let lastLines = { quiet: "The kettle is still warm.", outside: "The duck had never seen a real cloud before.", park: "A universe is a perfectly reasonable place to put a bench.", president: "Its inaugural address was one satisfying squeak.", pond: "The planning permission is still pending." };
    tell(lastLines[id], "THE END / FOR NOW");
    flashEffect(id === "quiet" || id === "outside" ? "hearts" : "confetti", 4);
    stopAmbience();
    playSound(id === "quiet" || id === "outside" ? "peace" : "finale", 0.7);
    persist(); publish(); return true;
}
