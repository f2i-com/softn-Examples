// Versioned, whitelisted local saves, bounded input, recoverable backup and v0.1 migration.
function validTree(v, depth, budget) {
    budget.n++;
    if (depth > 8 || budget.n > 4000) return false;
    if (v === null || typeof v === "boolean") return true;
    if (typeof v === "number") return isFinite(v) && Math.abs(v) < 9007199254740991;
    if (typeof v === "string") return v.length <= 1800;
    if (typeof v !== "object") return false;
    let ks = Object.keys(v);
    if (ks.length > 160) return false;
    for (let i = 0; i < ks.length; i++) {
        if (ks[i] === "__proto__" || ks[i] === "constructor" || ks[i] === "prototype") return false;
        if (!validTree(v[ks[i]], depth + 1, budget)) return false;
    }
    return true;
}
function validState(s) {
    if (!s || !validTree(s, 0, { n: 0 }) || s.id !== GAME_ID || s.version !== VERSION) return false;
    if (!integer(s.presses, 0, 100) || !isNumber(s.time, 0, 1000000) || !isNumber(s.patience, 0, 150)) return false;
    if (!integer(s.quietBeat, 0, QUIET_BEATS.length) || !isNumber(s.finaleTime, 0, 8) || !isNumber(s.launchTime, 0, 4.2)) return false;
    if (["play", "finale", "ending"].indexOf(s.phase) < 0 || ["room", "rooftop", "launch", "space", "cosmos", "garden", "pond", "park"].indexOf(s.scene) < 0) return false;
    if (typeof s.line !== "string" || typeof s.speaker !== "string" || typeof s.effect !== "string" || !isNumber(s.effectAt, 0, 1000000)) return false;
    if (typeof s.launched !== "boolean" || typeof s.souvenir !== "boolean" || typeof s.tea !== "boolean" || typeof s.watered !== "boolean" || typeof s.doorOpen !== "boolean") return false;
    if (!integer(s.extras, 0, 50) || !integer(s.tune, 0, 3) || !integer(s.gravity, -1, 1) || !integer(s.seed, 1, 2147483646) || !integer(s.assisted, 0, 100)) return false;
    if (!Array.isArray(s.history) || s.history.length > 128) return false;
    for (let i = 0; i < s.history.length; i++) { if (typeof s.history[i] !== "string" || s.history[i].length > 80) return false; }
    if (s.presses > 0 && s.patience !== 0) return false;
    if (s.phase === "finale" && s.presses !== 100) return false;
    if (s.phase === "play" && s.presses === 100) return false;
    if (s.phase === "ending") {
        if (!endingById(s.ending)) return false;
        if (s.ending === "quiet" || s.ending === "outside") { if (s.presses !== 0) return false; if (s.patience < (s.ending === "quiet" ? 150 : 110)) return false; }
        else if (s.presses !== 100) return false;
    } else if (s.ending !== "") return false;
    let g = s.gate;
    if (!g || typeof g !== "object" || typeof g.kind !== "string") return false;
    if (!integer(g.progress, 0, 3) || !integer(g.bits, 0, 7) || !integer(g.variant, 0, 2) || !isNumber(g.age, 0, 3600) || !integer(g.mistakes, 0, 100)) return false;
    if (g.kind) {
        if (s.phase !== "play" || !GATE_SPECS[g.kind]) return false;
        let b = beatAt(s.presses);
        if (!b || b[4] !== g.kind || g.progress >= GATE_SPECS[g.kind].need) return false;
        if (g.kind === "permit" && (g.bits > 3 || g.progress !== ((g.bits & 1 ? 1 : 0) + (g.bits & 2 ? 1 : 0)))) return false;
        if (g.kind === "dish" && g.progress !== ((g.bits & 1 ? 1 : 0) + (g.bits & 2 ? 1 : 0) + (g.bits & 4 ? 1 : 0))) return false;
    }
    if (s.launchTime > 0 && (s.presses !== 80 || s.phase !== "play" || s.scene !== "launch")) return false;
    return true;
}
function decodeSave(raw) {
    if (typeof raw !== "string" || raw.length > 100000) return null;
    try {
        let d = JSON.parse(raw);
        if (!d || d.schema !== VERSION || d.game !== GAME_ID || !validTree(d, 0, { n: 0 }) || !validState(d.state)) return null;
        return d;
    } catch (e) { return null; }
}
function applyEnvelope(d) {
    // Copy only expected fields: unknown future keys never enter the game.
    let fresh = freshState(), names = Object.keys(fresh);
    for (let i = 0; i < names.length; i++) fresh[names[i]] = copy(d.state[names[i]]);
    S = fresh;
    let p = d.profile || {};
    profile = { endings: [], best: integer(p.best, 0, 100) ? p.best : S.presses, sessions: integer(p.sessions, 0, 1000000) ? p.sessions : 0, legacyCompleted: integer(p.legacyCompleted, 0, 1000000) ? p.legacyCompleted : 0 };
    if (Array.isArray(p.endings)) {
        for (let j = 0; j < ENDINGS.length; j++) { if (p.endings.indexOf(ENDINGS[j].id) >= 0) profile.endings.push(ENDINGS[j].id); }
    }
    if (S.phase === "ending" && profile.endings.indexOf(S.ending) < 0) profile.endings.push(S.ending);
    let t = d.settings || {}, bs = ["muted", "reducedMotion", "assist", "captions", "ambience"];
    for (let k = 0; k < bs.length; k++) { if (typeof t[bs[k]] === "boolean") settings[bs[k]] = t[bs[k]]; }
    if (isNumber(t.volume, 0, 1)) settings.volume = t.volume;
}
function persist() {
    if (!S) return false;
    try {
        let previous = localStorage.getItem(SAVE_KEY);
        if (previous && decodeSave(previous)) localStorage.setItem(SAVE_KEY + ":backup", previous);
        localStorage.setItem(SAVE_KEY, JSON.stringify({ schema: VERSION, game: GAME_ID, state: S, profile: profile, settings: settings }));
        saveStatus = "Saved on this device. No cloud. No duck tracking."; return true;
    } catch (e) { saveStatus = "Storage is unavailable. This room still works; progress may not survive closing it."; return false; }
}
function migrateLegacy(raw) {
    if (!raw || raw.length > 250000) return false;
    try {
        let d = JSON.parse(raw), old = d && d.state;
        if (!d || d.schema !== 1 || d.game !== GAME_ID || !old || !validTree(d, 0, { n: 0 })) return false;
        if (old.id !== GAME_ID || old.version !== 1 || !isNumber(old.presses, 0, 100000) || !isNumber(old.wait, 0, 1000000)) return false;
        S = freshState(); S.presses = Math.min(100, Math.floor(old.presses));
        S.time = isNumber(old.time, 0, 1000000) ? old.time : 0;
        S.patience = S.presses === 0 ? Math.min(149, old.wait) : 0;
        for (let q = 0; q < QUIET_BEATS.length; q++) { if (S.patience >= QUIET_BEATS[q][0]) S.quietBeat = q + 1; }
        S.scene = sceneForPress(S.presses); S.launched = S.presses >= 80;
        if (S.presses === 100) { S.phase = "finale"; S.finaleTime = 4; }
        else { let b = beatAt(S.presses); if (b && b[4]) startGate(b[4]); }
        let oldProfile = d.profile || {};
        profile.best = S.presses;
        profile.legacyCompleted = integer(oldProfile.completed, 0, 1000000) ? oldProfile.completed : 0;
        if (d.settings) { settings.muted = d.settings.muted === true; settings.reducedMotion = d.settings.reducedMotion === true; settings.assist = d.settings.gentle === true; }
        tell("Your old room has been renovated. Press progress carried over; the ducks have new ideas.", "WELCOME BACK");
        // Keep the original v1 key intact; currency and unsafe old health mechanics do not migrate.
        persist(); saveStatus = "Previous press progress migrated. Original v0.1 save retained."; return true;
    } catch (e) { return false; }
}
function restore() {
    try {
        let raw = localStorage.getItem(SAVE_KEY), data = decodeSave(raw);
        if (data) { applyEnvelope(data); saveStatus = "Room restored from this device."; return true; }
        let backup = decodeSave(localStorage.getItem(SAVE_KEY + ":backup"));
        if (backup) { applyEnvelope(backup); saveStatus = "Recovered the previous valid local save."; return true; }
        if (!raw && migrateLegacy(localStorage.getItem(LEGACY_KEY))) return true;
        if (raw) saveStatus = "A damaged save was ignored safely. A fresh room is ready.";
    } catch (e) { saveStatus = "Storage is unavailable. This room will run without saving."; }
    return false;
}
