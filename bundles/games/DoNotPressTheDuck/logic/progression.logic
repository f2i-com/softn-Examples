// The authoritative press timeline. CSS never completes an action or changes a rule.
function beatAt(n) { return n > 0 && n <= BEATS.length ? BEATS[n - 1] : null; }
function sceneForPress(n) { return n >= 90 ? "cosmos" : (n >= 80 ? "space" : (n >= 55 ? "rooftop" : "room")); }
function pressDuck() {
    if (!active() || cooldown > 0 || S.launchTime > 0) return false;
    if (S.gate.kind) { tell(GATE_SPECS[S.gate.kind].help, "A SMALL COMPLICATION"); worldDirty = true; return false; }
    if (S.presses >= MAX_PRESSES) return false;
    unlockAudio();
    S.presses++;
    S.patience = 0;
    S.scene = sceneForPress(S.presses);
    S.tea = false; S.doorOpen = false;
    let b = beatAt(S.presses);
    record("press:" + S.presses);
    tell(b[1], S.presses >= 60 && S.presses <= 61 ? "DUCK TV / LIVE" : "THE ROOM");
    flashEffect(b[3], 0.8);
    if (S.presses === 80 || S.presses === 100) stopAmbience();
    playSound(b[2], 0.7);
    // Brief debounce protects each punchline from accidental double taps. Never queued.
    cooldown = b[4] ? 0.2 : (b[3] === "crash" || b[3] === "finale" ? 0.8 : 0.34);
    if (b[4]) startGate(b[4]);
    if (S.presses === 80) {
        S.launchTime = settings.reducedMotion ? 1.2 : 4.2;
        S.scene = "launch";
    }
    if (S.presses === 100) {
        S.phase = "finale"; S.finaleTime = 0; S.scene = "cosmos";
        cooldown = 0; flashEffect("confetti", 5);
    }
    profile.best = Math.max(profile.best, S.presses);
    worldDirty = true;
    persist(); publish(); return true;
}
function startGate(kind) {
    S.gate = { kind: kind, progress: 0, bits: 0, variant: Math.floor(rnd() * 3), age: 0, mistakes: 0 };
    hintShown = settings.assist;
    worldDirty = true;
}
function finishGate(assisted) {
    let kind = S.gate.kind;
    if (!kind) return;
    if (assisted) { S.assisted++; record("assisted:" + S.presses); }
    record("solved:" + S.presses);
    let endings = {
        inspect: "Certified finger. You may proceed.", lunch: "Everyone gets a crumb. Industrial action concluded.",
        permit: "Your permission to request permission has been approved.", crank: "The factory is alive. It is already asking for a raise.",
        clones: "The other two were potatoes. Very ambitious potatoes.", bouncer: "The bouncer loves you. This is a security breach.",
        chase: "Caught. It would like a sit-down.", tiny: "Found it. Large target, tiny dignity.",
        tune: "DUCK TV. Unbiased. Unblinking. Unreasonably yellow.", gravity: "Down has been reassigned. Please update your paperwork.",
        search: "Property recovered. The duck denies everything.", launch: "Ready for a completely irresponsible departure.",
        dish: "Signal found. The other planet is asking for bread.", customs: "Contents of reality: mostly duck. Nothing to declare."
    };
    S.gate.kind = "";
    cooldown = 0.32;
    hintShown = false;
    tell(assisted ? "A helpful duck quietly sorted that out. No points lost. There are no points." : endings[kind], "RESOLVED / MORE OR LESS");
    flashEffect(kind === "bouncer" || kind === "inspect" ? "hearts" : "confetti", 1.2);
    playSound("ding", 0.6); worldDirty = true;
}
function advanceSimulation(dt) {
    if (!S || paused || overlay) return;
    if (!isNumber(dt, 0, 86400)) return;
    dt = clamp(dt, 0, 0.2); // Never catch up a background tab or stalled animation.
    cooldown = Math.max(0, cooldown - dt);
    actionCooldown = Math.max(0, actionCooldown - dt);
    if (effectLife > 0) {
        effectLife = Math.max(0, effectLife - dt);
        if (!effectLife) { effectKind = ""; particles = []; worldDirty = true; }
    }
    if (S.phase === "play") {
        S.time = Math.min(1000000, S.time + dt);
        if (S.presses === 0) advancePatience(dt);
        if (S.gate.kind) {
            let oldHelp = S.gate.age >= GATE_HELP_SECONDS;
            S.gate.age = Math.min(3600, S.gate.age + dt);
            if (!oldHelp && S.gate.age >= GATE_HELP_SECONDS) worldDirty = true;
        }
        if (S.launchTime > 0) {
            let oldPhase = Math.ceil(S.launchTime);
            S.launchTime = Math.max(0, S.launchTime - dt);
            if (Math.ceil(S.launchTime) !== oldPhase) worldDirty = true;
            if (S.launchTime <= 0) {
                S.launched = true; S.scene = "space";
                tell("Ground successfully uninstalled. Welcome to the duckosphere.", "FLIGHT CONTROL");
                flashEffect("stars", 2); playSound("orbit", 0.65); persist();
            }
        }
    } else if (S.phase === "finale") {
        let old = Math.floor(S.finaleTime * 2);
        S.finaleTime = Math.min(8, S.finaleTime + dt);
        if (Math.floor(S.finaleTime * 2) !== old) worldDirty = true;
    }
    advanceAudio(dt);
    saveClock += dt;
    if (saveClock >= 5) { saveClock = 0; persist(); }
    if (worldDirty) publish();
}
