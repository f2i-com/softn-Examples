<logic src="../logic/main.logic" />

<style>
.vs-root, .vs-root * { box-sizing: border-box; }
.vs-root {
  position: relative;
  display: flex;
  flex-direction: row;
  width: 100%;
  height: 100%;
  min-height: 0;
  overflow: hidden;
  background: #080d17;
  color: #e2e8f0;
  font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
}

.vs-stage {
  position: relative;
  flex: 1 1 54%;
  min-width: 0;
  height: 100%;
  background: radial-gradient(circle at 50% 44%, #17243c 0%, #0b1220 64%, #060a13 100%);
  overflow: hidden;
  transition: height 180ms ease, flex-basis 180ms ease;
}

.vs-scene-wrap {
  position: absolute;
  inset: 0;
}

.vs-stage-top {
  position: absolute;
  top: 12px;
  left: 12px;
  right: 12px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 8px;
  pointer-events: none;
  z-index: 12;
}

.vs-glass-pill {
  pointer-events: auto;
  background: rgba(10, 17, 30, 0.80);
  border: 1px solid rgba(56, 189, 248, 0.24);
  border-radius: 12px;
  backdrop-filter: blur(10px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.42);
}

.vs-title-pill {
  padding: 7px 12px;
  flex-shrink: 0;
}

.vs-stage-sub {
  display: block;
  font-size: 10.5px;
  color: #94a3b8;
  margin-top: 2px;
}

.vs-cam-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  padding: 5px;
  max-width: 100%;
}

.vs-cam-btn {
  padding: 6px 10px !important;
  font-size: 11px !important;
  font-weight: 700 !important;
  border-radius: 8px !important;
  border: 1px solid rgba(148, 163, 184, 0.22) !important;
  background: rgba(15, 23, 42, 0.78) !important;
  color: #cbd5e1 !important;
  cursor: pointer;
  white-space: nowrap;
}

.vs-cam-btn-active {
  background: linear-gradient(135deg, #0284c7, #2563eb) !important;
  border-color: #7dd3fc !important;
  color: #ffffff !important;
}

.vs-mobile-size-btn {
  display: none !important;
}

.vs-stage-bottom {
  position: absolute;
  left: 12px;
  right: 12px;
  bottom: 12px;
  padding: 9px 12px;
  display: flex;
  flex-direction: column;
  gap: 7px;
  z-index: 12;
}

.vs-wave-row {
  display: flex;
  align-items: flex-end;
  gap: 3px;
  height: 30px;
  padding: 1px 0;
}

.vs-wave-bar {
  flex: 1 1 0;
  min-width: 2px;
  border-radius: 99px;
  background: linear-gradient(180deg, #38bdf8, #818cf8);
  transition: height 80ms ease, opacity 100ms ease;
}

.vs-panel {
  width: 490px;
  max-width: 49vw;
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #0d1526 0%, #090f1c 100%);
  border-left: 1px solid rgba(56, 189, 248, 0.18);
  z-index: 15;
}

.vs-studio-scroll {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
  padding: 12px 14px 20px 14px;
  display: flex;
  flex-direction: column;
  gap: 11px;
}

.vs-card {
  padding: 11px 12px;
  border-radius: 12px;
  background: rgba(15, 23, 42, 0.72);
  border: 1px solid rgba(56, 189, 248, 0.18);
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.vs-speak-card {
  background: linear-gradient(180deg, rgba(14, 28, 52, 0.90) 0%, rgba(15, 23, 42, 0.80) 100%);
  border-color: rgba(56, 189, 248, 0.34);
}

.vs-speak-input {
  width: 100% !important;
  font-size: 14px !important;
}

.vs-primary-speak-btn {
  flex: 1 1 auto;
  padding: 10px 16px !important;
  font-weight: 800 !important;
  font-size: 13px !important;
  border-radius: 9px !important;
  background: linear-gradient(135deg, #0284c7, #4f46e5) !important;
  color: #ffffff !important;
  border: 1px solid #7dd3fc !important;
  box-shadow: 0 4px 14px rgba(2, 132, 199, 0.32);
  cursor: pointer;
}

.vs-chip-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.vs-preset-chip {
  padding: 5px 10px !important;
  font-size: 11px !important;
  font-weight: 700 !important;
  border-radius: 999px !important;
  border: 1px solid rgba(148, 163, 184, 0.24) !important;
  background: rgba(15, 23, 42, 0.90) !important;
  color: #cbd5e1 !important;
  cursor: pointer;
  white-space: nowrap;
}

.vs-preset-chip-on {
  background: rgba(56, 189, 248, 0.24) !important;
  border-color: #38bdf8 !important;
  color: #e0f2fe !important;
}

.vs-seg-group {
  display: flex;
  background: #070b14;
  padding: 3px;
  border-radius: 10px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  gap: 4px;
}

.vs-seg-btn {
  flex: 1 1 0;
  padding: 8px 10px !important;
  font-size: 12px !important;
  font-weight: 800 !important;
  border-radius: 7px !important;
  border: none !important;
  background: transparent !important;
  color: #94a3b8 !important;
  cursor: pointer;
}

.vs-seg-male-on {
  background: linear-gradient(135deg, #0ea5e9, #2563eb) !important;
  color: #ffffff !important;
  box-shadow: 0 2px 10px rgba(14, 165, 233, 0.35);
}

.vs-seg-female-on {
  background: linear-gradient(135deg, #ec4899, #db2777) !important;
  color: #ffffff !important;
  box-shadow: 0 2px 10px rgba(236, 72, 153, 0.35);
}

.vs-slider-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.vs-slider-label {
  font-size: 11.5px;
  color: #cbd5e1;
  min-width: 136px;
}

.vs-range {
  flex: 1 1 auto;
  min-width: 70px;
  accent-color: #38bdf8;
  cursor: pointer;
  height: 6px;
}

.vs-num-box {
  width: 60px !important;
  min-width: 60px !important;
  padding: 4px 6px !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  text-align: center;
}

/* Tablet & Mobile Portrait Responsive Layout */
@media (max-width: 860px) {
  .vs-root {
    flex-direction: column;
  }
  .vs-stage {
    flex: 0 0 38%;
    height: 38%;
  }
  .vs-stage-compact {
    flex: 0 0 26% !important;
    height: 26% !important;
  }
  .vs-panel {
    width: 100%;
    max-width: 100%;
    flex: 1 1 62%;
    height: auto;
    border-left: none;
    border-top: 1px solid rgba(56, 189, 248, 0.24);
  }
  .vs-mobile-size-btn {
    display: inline-flex !important;
  }
  .vs-stage-top {
    top: 8px;
    left: 8px;
    right: 8px;
    flex-direction: row;
    align-items: center;
    gap: 6px;
  }
  .vs-cam-bar {
    flex-wrap: nowrap;
    overflow-x: auto;
    max-width: 58vw;
    padding: 4px;
  }
  .vs-stage-bottom {
    left: 8px;
    right: 8px;
    bottom: 8px;
    padding: 6px 10px;
    gap: 5px;
  }
  .vs-wave-row {
    height: 20px;
  }
  .vs-speak-input {
    font-size: 16px !important;
  }
  .vs-cam-btn, .vs-preset-chip {
    min-height: 34px;
  }
  .vs-range {
    height: 10px;
  }
}

/* Phone Portrait Compact Polish */
@media (max-width: 560px) {
  .vs-stage-sub, .vs-ipa-text {
    display: none !important;
  }
  .vs-title-pill {
    padding: 6px 9px;
  }
  .vs-chip-strip {
    flex-wrap: nowrap;
    overflow-x: auto;
    padding-bottom: 3px;
  }
  .vs-slider-label {
    min-width: 112px;
    font-size: 11px;
  }
  .vs-studio-scroll {
    padding: 10px 10px 24px 10px;
    gap: 9px;
  }
}

/* Phone Landscape Side-by-Side Layout */
@media (max-height: 540px) and (orientation: landscape) {
  .vs-root {
    flex-direction: row;
  }
  .vs-stage, .vs-stage-compact {
    flex: 0 0 45% !important;
    height: 100% !important;
  }
  .vs-panel {
    width: 55%;
    max-width: 55%;
    height: 100%;
    border-top: none;
    border-left: 1px solid rgba(56, 189, 248, 0.22);
  }
  .vs-mobile-size-btn, .vs-stage-sub {
    display: none !important;
  }
}
</style>

<Box className="vs-root">
  <Loop frame={true} running={true} @tick={stepSimulation} />

  <AudioStream
    getSamples={sampleSource}
    sampleRate={24000}
    channels={1}
    format="i16"
    bufferMs={65}
    running={!muted}
    muted={muted}
    volume={masterVolume}
    showControls={false}
    @ready={onAudioStreamReady}
  />

  <!-- Left / Top Hero 3D Human Mouth Viewport -->
  <Box className={mobileStageCompact ? "vs-stage vs-stage-compact" : "vs-stage"}>
    <Box className="vs-scene-wrap">
      <Scene3D
        fill={true}
        objects={sceneObjects}
        lights={sceneLights}
        camera={cameraConfig}
        orbitControls={orbitEnabled}
        orbit={{ minPolar: 0.45, maxPolar: 2.45, minDistance: 0.72, maxDistance: 3.2 }}
        antialias={true}
        shadows={true}
        environment={{ url: "assets/env/vocal-studio.hdr", background: false }}
        environmentIntensity={0.78}
        sky={{ top: "#111b2e", middle: "#17243b", bottom: "#070c16" }}
        toneMapping="agx"
        toneMappingExposure={1.04}
        effects={sceneEffects}
      >
        <SceneAnchor
          if={isSpeaking}
          object="hero_mouth"
          offset={{ y: 0.22 }}
          place="above"
          clickThrough={true}
        >
          <Box
            style={{
              padding: "4px 10px",
              borderRadius: "999px",
              background: "rgba(8, 15, 28, 0.86)",
              border: "1px solid rgba(56, 189, 248, 0.55)",
              boxShadow: "0 4px 14px rgba(0,0,0,0.5)"
            }}
          >
            <Text style={{ fontSize: "11px", fontWeight: 800, color: "#7dd3fc", letterSpacing: "0.04em" }}>
              {"/" + mouthAnim.activePhone + "/  " + (mouthAnim.activeWord ? ("·  " + mouthAnim.activeWord) : "")}
            </Text>
          </Box>
        </SceneAnchor>
      </Scene3D>
    </Box>

    <!-- Top Floating Title + Mouth Camera Bar -->
    <Box className="vs-stage-top">
      <Box className="vs-glass-pill vs-title-pill">
        <Stack direction="horizontal" gap={7} style={{ alignItems: "center" }}>
          <Box
            style={{
              width: "8px",
              height: "8px",
              borderRadius: "99px",
              background: isSpeaking ? "#38bdf8" : "#475569",
              boxShadow: isSpeaking ? "0 0 10px #38bdf8" : "none"
            }}
          />
          <Text style={{ fontSize: "12px", fontWeight: 800, letterSpacing: "0.05em", color: "#f8fafc" }}>
            VOICE SIMULATOR
          </Text>
          <Text style={{ fontSize: "11px", fontWeight: 700, color: gender === "female" ? "#f472b6" : "#38bdf8" }}>
            {(whisper ? "WHISPER · " : (gender === "female" ? "♀ " : "♂ ")) + pitchHz + " Hz"}
          </Text>
        </Stack>
        <Text className="vs-stage-sub">
          {isSpeaking
            ? ("Live 24 kHz Lip-Sync · Jaw " + Math.round(mouthAnim.jawOpen * 100) + "% · F1 " + mouthAnim.f1 + " / F2 " + mouthAnim.f2 + " Hz")
            : "Pure-code human vocal folds + chest resonance + 3D mouth"}
        </Text>
      </Box>

      <Box className="vs-glass-pill vs-cam-bar">
        <Button
          variant="ghost"
          className={cameraPreset === "front" ? "vs-cam-btn vs-cam-btn-active" : "vs-cam-btn"}
          @click={setCameraView("front")}
        >
          Front
        </Button>
        <Button
          variant="ghost"
          className={cameraPreset === "three_quarter" ? "vs-cam-btn vs-cam-btn-active" : "vs-cam-btn"}
          @click={setCameraView("three_quarter")}
        >
          3/4 View
        </Button>
        <Button
          variant="ghost"
          className={cameraPreset === "closeup" ? "vs-cam-btn vs-cam-btn-active" : "vs-cam-btn"}
          @click={setCameraView("closeup")}
        >
          Inside
        </Button>
        <Button
          variant="ghost"
          className={cameraPreset === "side" ? "vs-cam-btn vs-cam-btn-active" : "vs-cam-btn"}
          @click={setCameraView("side")}
        >
          Side
        </Button>
        <Button
          variant="ghost"
          className={orbitEnabled ? "vs-cam-btn vs-cam-btn-active" : "vs-cam-btn"}
          @click={toggleOrbitControls}
        >
          {orbitEnabled ? "Orbit: ON" : "Orbit"}
        </Button>
        <Button
          variant="ghost"
          className="vs-cam-btn vs-mobile-size-btn"
          @click={toggleMobileStageSize}
        >
          {mobileStageCompact ? "▼ Expand" : "▲ Compact"}
        </Button>
      </Box>
    </Box>

    <!-- Status Toast -->
    <Box
      if={statusBanner !== ""}
      className="vs-glass-pill"
      style={{
        position: "absolute",
        top: "66px",
        left: "12px",
        padding: "6px 12px",
        borderColor: "#38bdf8",
        zIndex: 14
      }}
    >
      <Text style={{ fontSize: "11.5px", fontWeight: 700, color: "#bae6fd" }}>{statusBanner}</Text>
    </Box>

    <!-- Bottom Waveform & Playback Bar -->
    <Box className="vs-glass-pill vs-stage-bottom">
      <Stack direction="horizontal" gap={8} style={{ justifyContent: "space-between", alignItems: "center", flexWrap: "wrap" }}>
        <Stack direction="horizontal" gap={8} style={{ alignItems: "center", flexWrap: "wrap" }}>
          <Text style={{ fontSize: "10.5px", fontWeight: 800, color: "#38bdf8" }}>
            {"F0 " + mouthAnim.f0 + " Hz"}
          </Text>
          <Text style={{ fontSize: "10.5px", fontWeight: 700, color: "#cbd5e1" }}>
            {"F1 " + mouthAnim.f1 + " · F2 " + mouthAnim.f2 + " Hz"}
          </Text>
          #if (lastIpa !== "")
            <Text className="vs-ipa-text" style={{ fontSize: "10.5px", color: "#a5b4fc", fontStyle: "italic" }}>
              {(lastIpa.length > 42 ? (lastIpa.slice(0, 42) + "…") : lastIpa)}
            </Text>
          #end
        </Stack>

        <Stack direction="horizontal" gap={5} style={{ alignItems: "center" }}>
          <Button variant="ghost" className="vs-cam-btn" @click={replayLastUtterance}>
            ▶ Replay
          </Button>
          #if (isSpeaking)
            <Button variant="ghost" className="vs-cam-btn" @click={stopCurrentPlayback}>
              ■ Stop
            </Button>
          #end
          <Button variant="ghost" className="vs-cam-btn" @click={exportLastWav}>
            ⬇ WAV
          </Button>
          <Button variant="ghost" className="vs-cam-btn" @click={toggleMute}>
            {muted ? "🔇 Muted" : "🔊 Audio"}
          </Button>
        </Stack>
      </Stack>

      <Box className="vs-wave-row">
        #each (barH, bIdx in waveformBars)
          <Box
            className="vs-wave-bar"
            style={{
              height: (isSpeaking ? Math.max(4, Math.round(barH * (0.45 + 0.65 * mouthAnim.rms))) : Math.max(4, Math.round(barH * 0.78))) + "px",
              opacity: isSpeaking && (playbackDurationSec > 0 && (bIdx / 36) <= (playbackElapsedSec / playbackDurationSec)) ? 1.0 : 0.45
            }}
          />
        #end
      </Box>
    </Box>
  </Box>

  <!-- Right / Bottom Unified Speak + Presets + Always-Visible Full Voice Lab Panel -->
  <Box className="vs-panel">
    <Box className="vs-studio-scroll">

      <!-- 1. Type & Speak Section -->
      <Box className="vs-card vs-speak-card">
        <Stack direction="horizontal" gap={8} style={{ justifyContent: "space-between", alignItems: "center" }}>
          <Text style={{ fontSize: "11px", fontWeight: 800, color: "#7dd3fc", letterSpacing: "0.05em" }}>
            TYPE & SPEAK
          </Text>
          <Button variant="ghost" className="vs-cam-btn" @click={clearDirectSpeakInput}>
            Clear
          </Button>
        </Stack>

        <Input
          value={directSpeakInput}
          @change={onDirectSpeakInputChange}
          @keydown={onDirectSpeakKeyDown}
          className="vs-speak-input"
          placeholder="Type words, numbers, or a paragraph for the mouth to say..."
        />

        <Stack direction="horizontal" gap={7} style={{ alignItems: "center" }}>
          <Button className="vs-primary-speak-btn" @click={triggerDirectSpeak}>
            🔊 Speak Text
          </Button>
          #if (isSpeaking)
            <Button variant="ghost" className="vs-cam-btn" @click={stopCurrentPlayback}>
              ■ Stop
            </Button>
          #end
          <Button variant="ghost" className="vs-cam-btn" @click={exportLastWav}>
            ⬇ WAV
          </Button>
        </Stack>

        <Box className="vs-chip-strip">
          #each (phr in QUICK_SPEAK_PHRASES)
            <Button
              variant="ghost"
              className="vs-preset-chip"
              @click={speakQuickPhrase(phr.text)}
            >
              {"▶ " + phr.label}
            </Button>
          #end
        </Box>
      </Box>

      <!-- 2. Male / Female & Curated Human Voice Presets -->
      <Box className="vs-card">
        <Stack direction="horizontal" gap={8} style={{ justifyContent: "space-between", alignItems: "center" }}>
          <Text style={{ fontSize: "11px", fontWeight: 800, color: "#38bdf8", letterSpacing: "0.05em" }}>
            HUMAN VOICE PRESETS
          </Text>
          <Button variant="ghost" className="vs-cam-btn" @click={resetVoiceToDefaults}>
            ↺ Reset
          </Button>
        </Stack>

        <Box className="vs-seg-group">
          <Button
            variant="ghost"
            className={gender === "male" ? "vs-seg-btn vs-seg-male-on" : "vs-seg-btn"}
            @click={setVoiceGender("male")}
          >
            ♂ Male Voice
          </Button>
          <Button
            variant="ghost"
            className={gender === "female" ? "vs-seg-btn vs-seg-female-on" : "vs-seg-btn"}
            @click={setVoiceGender("female")}
          >
            ♀ Female Voice
          </Button>
        </Box>

        <Box className="vs-chip-strip">
          #each (pr in VOICE_PRESETS)
            <Button
              variant="ghost"
              className={presetId === pr.id ? "vs-preset-chip vs-preset-chip-on" : "vs-preset-chip"}
              @click={selectVoicePreset(pr.id)}
            >
              {pr.label}
            </Button>
          #end
        </Box>
      </Box>

      <!-- 3. Always-Visible Full Voice Lab: Pitch, Vocal Tract & Speed -->
      <Box className="vs-card">
        <Text style={{ fontSize: "11px", fontWeight: 800, color: "#7dd3fc", letterSpacing: "0.05em" }}>
          VOICE LAB · PITCH, TRACT SIZE & SPEED
        </Text>

        <Box className="vs-slider-row">
          <Text style={{ fontSize: "11.5px", color: "#cbd5e1", minWidth: "82px" }}>
            Pitch (F0)
          </Text>
          <Button variant="ghost" className="vs-cam-btn" @click={adjustPitchBy(-10)}>-10</Button>
          <input
            type="range"
            className="vs-range"
            min="70"
            max="310"
            step="1"
            value={pitchHz}
            @input={onPitchSliderChange}
            @change={onPitchSliderChange}
          />
          <Button variant="ghost" className="vs-cam-btn" @click={adjustPitchBy(10)}>+10</Button>
          <Input
            value={pitchInputText}
            @change={onPitchTextInput}
            @keydown={onVoiceNumKeyDown}
            className="vs-num-box"
          />
          <Text style={{ fontSize: "10.5px", color: "#94a3b8", minWidth: "18px" }}>Hz</Text>
        </Box>

        <Box className="vs-slider-row">
          <Text style={{ fontSize: "11.5px", color: "#cbd5e1", minWidth: "82px" }}>
            Vocal Tract
          </Text>
          <input
            type="range"
            className="vs-range"
            min="12.5"
            max="21.0"
            step="0.1"
            value={tractLengthCm}
            @input={onTractSliderChange}
            @change={onTractSliderChange}
          />
          <Input
            value={tractInputText}
            @change={onTractTextInput}
            @keydown={onVoiceNumKeyDown}
            className="vs-num-box"
          />
          <Text style={{ fontSize: "10.5px", color: "#94a3b8", minWidth: "18px" }}>cm</Text>
        </Box>

        <Box className="vs-slider-row">
          <Text style={{ fontSize: "11.5px", color: "#cbd5e1", minWidth: "82px" }}>
            Speak Rate
          </Text>
          <input
            type="range"
            className="vs-range"
            min="0.60"
            max="1.60"
            step="0.05"
            value={speed}
            @input={onSpeedSliderChange}
            @change={onSpeedSliderChange}
          />
          <Input
            value={speedInputText}
            @change={onSpeedTextInput}
            @keydown={onVoiceNumKeyDown}
            className="vs-num-box"
          />
          <Text style={{ fontSize: "10.5px", color: "#94a3b8", minWidth: "18px" }}>x</Text>
        </Box>
      </Box>

      <!-- 4. Always-Visible Full Voice Lab: Vocal Folds & Chest Warmth -->
      <Box className="vs-card">
        <Text style={{ fontSize: "11px", fontWeight: 800, color: "#f472b6", letterSpacing: "0.05em" }}>
          VOCAL FOLDS & CHEST TIMBRE
        </Text>

        <Box className="vs-slider-row">
          <Text className="vs-slider-label">
            {"Glottal Warmth: " + Math.round(warmth * 100) + "%"}
          </Text>
          <input
            type="range"
            className="vs-range"
            min="0.0"
            max="1.0"
            step="0.02"
            value={warmth}
            @input={onWarmthSliderChange}
            @change={onWarmthSliderChange}
          />
        </Box>

        <Box className="vs-slider-row">
          <Text className="vs-slider-label">
            {"Chest Body: " + Math.round(chestResonance * 100) + "%"}
          </Text>
          <input
            type="range"
            className="vs-range"
            min="0.0"
            max="1.0"
            step="0.02"
            value={chestResonance}
            @input={onChestSliderChange}
            @change={onChestSliderChange}
          />
        </Box>

        <Box className="vs-slider-row">
          <Text className="vs-slider-label">
            {"Breathiness: " + Math.round(breathiness * 100) + "%"}
          </Text>
          <input
            type="range"
            className="vs-range"
            min="0.0"
            max="0.80"
            step="0.02"
            value={breathiness}
            @input={onBreathSliderChange}
            @change={onBreathSliderChange}
          />
        </Box>

        <Box className="vs-slider-row">
          <Text className="vs-slider-label">
            {"Vocal Fry / Grit: " + Math.round(roughness * 100) + "%"}
          </Text>
          <input
            type="range"
            className="vs-range"
            min="0.0"
            max="0.70"
            step="0.02"
            value={roughness}
            @input={onRoughnessSliderChange}
            @change={onRoughnessSliderChange}
          />
        </Box>
      </Box>

      <!-- 5. Always-Visible Full Voice Lab: Resonance, Diction, Prosody & Appearance -->
      <Box className="vs-card">
        <Text style={{ fontSize: "11px", fontWeight: 800, color: "#a5b4fc", letterSpacing: "0.05em" }}>
          RESONANCE, PROSODY & APPEARANCE
        </Text>

        <Box className="vs-slider-row">
          <Text className="vs-slider-label">
            {"Nasal Resonance: " + Math.round(nasality * 100) + "%"}
          </Text>
          <input
            type="range"
            className="vs-range"
            min="0.0"
            max="0.75"
            step="0.02"
            value={nasality}
            @input={onNasalitySliderChange}
            @change={onNasalitySliderChange}
          />
        </Box>

        <Box className="vs-slider-row">
          <Text className="vs-slider-label">
            {"Crisp Diction: " + Math.round(crispness * 100) + "%"}
          </Text>
          <input
            type="range"
            className="vs-range"
            min="0.50"
            max="1.50"
            step="0.04"
            value={crispness}
            @input={onCrispnessSliderChange}
            @change={onCrispnessSliderChange}
          />
        </Box>

        <Box className="vs-slider-row">
          <Text className="vs-slider-label">
            {"Intonation: " + Math.round(expressiveness * 100) + "%"}
          </Text>
          <input
            type="range"
            className="vs-range"
            min="0.0"
            max="1.70"
            step="0.05"
            value={expressiveness}
            @input={onExpressSliderChange}
            @change={onExpressSliderChange}
          />
        </Box>

        <Box className="vs-slider-row">
          <Text className="vs-slider-label">
            {"Vocal Vibrato: " + Math.round(vibrato * 100) + "%"}
          </Text>
          <input
            type="range"
            className="vs-range"
            min="0.0"
            max="0.85"
            step="0.02"
            value={vibrato}
            @input={onVibratoSliderChange}
            @change={onVibratoSliderChange}
          />
        </Box>

        <Box className="vs-slider-row">
          <Text className="vs-slider-label">
            {"Master Volume: " + Math.round(masterVolume * 100) + "%"}
          </Text>
          <input
            type="range"
            className="vs-range"
            min="0.0"
            max="1.0"
            step="0.02"
            value={masterVolume}
            @input={onMasterVolumeChange}
            @change={onMasterVolumeChange}
          />
        </Box>

        <Stack direction="horizontal" gap={8} style={{ alignItems: "center", justifyContent: "space-between", flexWrap: "wrap", marginTop: "2px" }}>
          <Button
            variant="ghost"
            className={whisper ? "vs-cam-btn vs-cam-btn-active" : "vs-cam-btn"}
            @click={toggleWhisperMode}
          >
            {whisper ? "🌬 Whisper: ON" : "🌬 Whisper: OFF"}
          </Button>

          <Stack direction="horizontal" gap={5} style={{ alignItems: "center" }}>
            <Text style={{ fontSize: "10.5px", color: "#94a3b8" }}>Lips:</Text>
            #each (sw in LIP_TINT_SWATCHES)
              <Button
                variant="ghost"
                @click={setLipTintColor(sw.id)}
                style={{
                  width: "22px",
                  height: "22px",
                  minWidth: "22px",
                  padding: "0",
                  borderRadius: "99px",
                  background: sw.id === "#ffffff" ? "#e0727c" : sw.id,
                  border: lipTint === sw.id ? "2px solid #38bdf8" : "1px solid rgba(255,255,255,0.3)",
                  cursor: "pointer"
                }}
              />
            #end
          </Stack>
        </Stack>
      </Box>

    </Box>
  </Box>
</Box>
