  "alveolar:AE2_L_V_IY1_AX_L_ER bilabial:B_AY0_L_EY1_B_IY0_AX_L velar:V_IY1_L_ER uvula:Y_UW1_V_Y_AX_L_AX " +
  "pharynx:F_AE1_R_IH0_NG_K_S trachea:T_R_EY1_K_IY0_AX incisors:IH0_N_S_AY1_Z_ER_Z gums:G_AH1_M_Z enamel:IH0_N_AE1_M_AX_L " +
  "muscle:M_AH1_S_AX_L muscles:M_AH1_S_AX_L_Z gentle:JH_EH1_N_T_AX_L smooth:S_M_UW1_DH smoothly:S_M_UW1_DH_L_IY0 " +
  "crisp:K_R_IH1_S_P vivid:V_IH1_V_IH0_D purely:P_Y_UH1_R_L_IY0 entirely:IH0_N_T_AY1_R_L_IY0 instantly:IH1_N_S_T_AX_N_T_L_IY0 " +
  "woman:W_UH1_M_AX_N women:W_IH1_M_AX_N man:M_AE1_N men:M_EH1_N child:CH_AY1_L_D children:CH_IH1_L_D_R_AX_N " +
  "button:B_AH1_T_AX_N buttons:B_AH1_T_AX_N_Z click:K_L_IH1_K challenge:CH_AE1_L_AX_N_JH round:R_AW1_N_D"
]

// Natural spoken English contractions (spoken as single fluid phonological words!)
let _CONTRACTION_PHONES = {
  "i'm": ["AY1", "M"],
  "i've": ["AY1", "V"],
  "i'll": ["AY1", "L"],
  "i'd": ["AY1", "D"],
  "you're": ["Y", "UH1", "R"],
  "you've": ["Y", "UW1", "V"],
  "you'll": ["Y", "UW1", "L"],
  "you'd": ["Y", "UW1", "D"],
  "he's": ["HH", "IY1", "Z"],
  "she's": ["SH", "IY1", "Z"],
  "it's": ["IH1", "T", "S"],
  "we're": ["W", "IH1", "R"],
  "we've": ["W", "IY1", "V"],
  "we'll": ["W", "IY1", "L"],
  "they're": ["DH", "EH1", "R"],
  "they've": ["DH", "EY1", "V"],
  "they'll": ["DH", "EY1", "L"],
  "that's": ["DH", "AE1", "T", "S"],
  "there's": ["DH", "EH1", "R", "Z"],
  "here's": ["HH", "IH1", "R", "Z"],
  "what's": ["W", "AH1", "T", "S"],
  "who's": ["HH", "UW1", "Z"],
  "how's": ["HH", "AW1", "Z"],
  "where's": ["W", "EH1", "R", "Z"],
  "let's": ["L", "EH1", "T", "S"],
  "can't": ["K", "AE1", "N", "T"],
  "won't": ["W", "OW1", "N", "T"],
  "don't": ["D", "OW1", "N", "T"],
  "doesn't": ["D", "AH1", "Z", "AX", "N", "T"],
  "didn't": ["D", "IH1", "D", "AX", "N", "T"],
  "isn't": ["IH1", "Z", "AX", "N", "T"],
  "aren't": ["AA1", "R", "N", "T"],
  "wasn't": ["W", "AA1", "Z", "AX", "N", "T"],
  "weren't": ["W", "ER1", "N", "T"],
  "haven't": ["HH", "AE1", "V", "AX", "N", "T"],
  "hasn't": ["HH", "AE1", "Z", "AX", "N", "T"],
  "hadn't": ["HH", "AE1", "D", "AX", "N", "T"],
  "wouldn't": ["W", "UH1", "D", "AX", "N", "T"],
  "couldn't": ["K", "UH1", "D", "AX", "N", "T"],
  "shouldn't": ["SH", "UH1", "D", "AX", "N", "T"]
}

let _CONTRACTIONS = {
  "cannot": "can not"
}

function initPhonetics() {
  if (_LEXICON_READY) { return }
  _LEXICON = {}
  for (let c = 0; c < _RAW_LEXICON_CHUNKS.length; c = c + 1) {
    let parts = _RAW_LEXICON_CHUNKS[c].trim().split(/\s+/)
    for (let i = 0; i < parts.length; i = i + 1) {
      let kv = parts[i].split(":")
      if (kv.length === 2 && kv[0].length > 0) {
        _LEXICON[kv[0]] = kv[1].split("_")
      }
    }
  }
  _LEXICON_READY = true
}

function isVowelPhone(ph) {
  let base = ph.replace(/[012]/g, "")
  return (
    base === "IY" || base === "IH" || base === "EH" || base === "AE" ||
    base === "AA" || base === "AO" || base === "UH" || base === "UW" ||
    base === "AH" || base === "AX" || base === "ER" ||
    base === "EY" || base === "AY" || base === "OY" || base === "AW" || base === "OW"
  )
}

function isVoicedPhone(ph) {
  let base = ph.replace(/[012]/g, "")
  if (isVowelPhone(base)) { return true }
  return (
    base === "B" || base === "D" || base === "G" || base === "JH" ||
    base === "V" || base === "DH" || base === "Z" || base === "ZH" ||
    base === "M" || base === "N" || base === "NG" ||
    base === "L" || base === "R" || base === "W" || base === "Y"
  )
}

function numberToWords(n) {
  n = Math.floor(Math.abs(n))
  if (n === 0) { return "zero" }
  let ones = ["", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
              "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen",
              "seventeen", "eighteen", "nineteen"]
  let tens = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"]
  if (n < 20) { return ones[n] }
  if (n < 100) {
    let t = Math.floor(n / 10)
    let r = n % 10
    return r === 0 ? tens[t] : (tens[t] + " " + ones[r])
  }
  if (n < 1000) {
    let h = Math.floor(n / 100)
    let r = n % 100
    return r === 0 ? (ones[h] + " hundred") : (ones[h] + " hundred " + numberToWords(r))
  }
  if (n < 1000000) {
    let th = Math.floor(n / 1000)
    let r = n % 1000
    return r === 0 ? (numberToWords(th) + " thousand") : (numberToWords(th) + " thousand " + numberToWords(r))
  }
  return String(n)
}

function normalizeEnglishText(raw) {
  let s = String(raw || "").trim()
  if (!s) { return "" }
  // Domain & tech terms
  s = s.replace(/\bSoftN\b/gi, "soft en")
  s = s.replace(/\b3D\b/gi, "three dee")
  s = s.replace(/\b2D\b/gi, "two dee")
  s = s.replace(/\bAI\b/g, "ay eye")
  s = s.replace(/\bHz\b/gi, "hertz")
  s = s.replace(/\bkHz\b/gi, "kilohertz")
  s = s.replace(/\bdB\b/g, "decibels")
  s = s.replace(/\bIPA\b/g, "eye pee ay")
  s = s.replace(/\bTTS\b/g, "text to speech")
  s = s.replace(/\bMr\./gi, "mister")
  s = s.replace(/\bMrs\./gi, "missus")
  s = s.replace(/\bDr\./gi, "doctor")
  s = s.replace(/%/g, " percent ")
  s = s.replace(/&/g, " and ")
  s = s.replace(/\+/g, " plus ")
  s = s.replace(/=/g, " equals ")

  // Ordinals: 1st, 2nd, 3rd, 4th...
  s = s.replace(/\b(\d+)(st|nd|rd|th)\b/gi, function(_m, d) {
    let v = parseInt(d, 10)
    if (v === 1) { return "first" }
    if (v === 2) { return "second" }
    if (v === 3) { return "third" }
    if (v === 5) { return "fifth" }
    if (v === 8) { return "eighth" }
    if (v === 9) { return "ninth" }
    if (v === 12) { return "twelfth" }
    return numberToWords(v) + "th"
  })

  // Plain numbers (including 4-digit years like 2026 -> twenty twenty six)
  s = s.replace(/\b\d+\b/g, function(m) {
    let v = parseInt(m, 10)
    if (!Number.isFinite(v)) { return m }
    if (v >= 2010 && v <= 2099) {
      let hi = Math.floor(v / 100)
      let lo = v % 100
      return lo === 0 ? numberToWords(v) : (numberToWords(hi) + " " + numberToWords(lo))
    }
    if (v <= 999999) { return numberToWords(v) }
    let digits = []
    for (let i = 0; i < m.length; i = i + 1) {
      digits.push(numberToWords(parseInt(m.charAt(i), 10)))
    }
    return digits.join(" ")
  })

  return s
}

// Morphological inflection fallback before raw letter-to-sound rules
function lookupWithMorphology(word) {
  if (_LEXICON[word]) { return _LEXICON[word].slice() }

  // Plural / 3rd person -s / -es / -ies
  if (word.length > 4 && word.endsWith("ies")) {
    let stem = word.slice(0, -3) + "y"
    if (_LEXICON[stem]) {
      let p = _LEXICON[stem].slice()
      p.push("Z")
      return p
    }
  }
  if (word.length > 3 && word.endsWith("es")) {
    let stem1 = word.slice(0, -2)
    if (_LEXICON[stem1]) {
      let p = _LEXICON[stem1].slice()
      let last = p[p.length - 1].replace(/[012]/g, "")
      if (last === "S" || last === "Z" || last === "SH" || last === "ZH" || last === "CH" || last === "JH") {
        p.push("IH0", "Z")
      } else {
        p.push(isVoicedPhone(last) ? "Z" : "S")
      }
      return p
    }
  }
  if (word.length > 2 && word.endsWith("s") && !word.endsWith("ss") && !word.endsWith("us") && !word.endsWith("is")) {
    let stem = word.slice(0, -1)
    if (_LEXICON[stem]) {
      let p = _LEXICON[stem].slice()
      let last = p[p.length - 1].replace(/[012]/g, "")
      p.push(isVoicedPhone(last) ? "Z" : "S")
      return p
    }
  }

  // Progressive -ing
  if (word.length > 4 && word.endsWith("ing")) {
    let stem = word.slice(0, -3)
    if (_LEXICON[stem]) {
      let p = _LEXICON[stem].slice()
      p.push("IH0", "NG")
      return p
    }
    if (_LEXICON[stem + "e"]) {
      let p = _LEXICON[stem + "e"].slice()
      p.push("IH0", "NG")
      return p
    }
    if (stem.length >= 3 && stem.charAt(stem.length - 1) === stem.charAt(stem.length - 2)) {
      let single = stem.slice(0, -1)
      if (_LEXICON[single]) {
        let p = _LEXICON[single].slice()
        p.push("IH0", "NG")
        return p
      }
    }
  }

  // Past -ed
  if (word.length > 3 && word.endsWith("ed")) {
    let stem = word.slice(0, -2)
    let basePhones = _LEXICON[stem] || _LEXICON[word.slice(0, -1)]
    if (!basePhones && stem.length >= 3 && stem.charAt(stem.length - 1) === stem.charAt(stem.length - 2)) {
      basePhones = _LEXICON[stem.slice(0, -1)]
    }
    if (basePhones) {
      let p = basePhones.slice()
      let last = p[p.length - 1].replace(/[012]/g, "")
      if (last === "T" || last === "D") {
        p.push("IH0", "D")
      } else {
        p.push(isVoicedPhone(last) ? "D" : "T")
      }
      return p
    }
  }

  // Adverb -ly
  if (word.length > 4 && word.endsWith("ly")) {
    let stem = word.slice(0, -2)
    if (_LEXICON[stem]) {
      let p = _LEXICON[stem].slice()
      p.push("L", "IY0")
      return p
    }
  }

  // Comparative -er / superlative -est / -ment / -ness
  if (word.length > 4 && word.endsWith("er")) {
    let stem = word.slice(0, -2)
    if (_LEXICON[stem]) {
      let p = _LEXICON[stem].slice()
      p.push("ER0")
      return p
    }
    if (stem.length >= 3 && stem.charAt(stem.length - 1) === stem.charAt(stem.length - 2) && _LEXICON[stem.slice(0, -1)]) {
      let p2 = _LEXICON[stem.slice(0, -1)].slice()
      p2.push("ER0")
      return p2
    }
  }
  if (word.length > 5 && word.endsWith("est")) {
    let stem = word.slice(0, -3)
    if (_LEXICON[stem]) {
      let p = _LEXICON[stem].slice()
      p.push("AX0", "S", "T")
      return p
    }
    if (stem.length >= 3 && stem.charAt(stem.length - 1) === stem.charAt(stem.length - 2) && _LEXICON[stem.slice(0, -1)]) {
      let p2 = _LEXICON[stem.slice(0, -1)].slice()
      p2.push("AX0", "S", "T")
      return p2
    }
  }
  if (word.length > 6 && word.endsWith("ments")) {
    let stem = word.slice(0, -5)
    if (_LEXICON[stem]) {
      let p = _LEXICON[stem].slice()
      p.push("M", "AX0", "N", "T", "S")
      return p
    }
  }
  if (word.length > 5 && word.endsWith("ment")) {
    let stem = word.slice(0, -4)
    if (_LEXICON[stem]) {
      let p = _LEXICON[stem].slice()
      p.push("M", "AX0", "N", "T")
      return p
    }
  }

  return null
}

function isLetterVowel(ch) {
  return ch === "a" || ch === "e" || ch === "i" || ch === "o" || ch === "u" || ch === "y"
}

// Context-sensitive Grapheme-to-Phoneme (G2P) fallback for novel/unseen English words
function g2pWord(word) {
  let w = word.toLowerCase().replace(/[^a-z]/g, "")
  if (!w) { return [] }
  let out = []
  let n = w.length
  let i = 0

  // Detect silent final 'e' (Magic-E) on root: e.g. make, tone, cute, smile, voice
  let hasMagicE = (
    n >= 4 &&
    w.charAt(n - 1) === "e" &&
    !isLetterVowel(w.charAt(n - 2)) &&
    isLetterVowel(w.charAt(n - 3)) &&
    !w.endsWith("le") &&
    !w.endsWith("re") &&
    !w.endsWith("ve")
  )

  while (i < n) {
    let rem = w.slice(i)
    let c = w.charAt(i)
    let next = i + 1 < n ? w.charAt(i + 1) : ""
    let next2 = i + 2 < n ? w.charAt(i + 2) : ""
    let prev = i > 0 ? w.charAt(i - 1) : ""

    // Multi-letter suffixes & clusters
    if (rem.startsWith("tion") || rem.startsWith("sion")) {
      out.push(rem.startsWith("sion") && isLetterVowel(prev) ? "ZH" : "SH", "AX0", "N")
      i = i + 4
      continue
    }
    if (rem.startsWith("ture") && i > 0) {
      out.push("CH", "ER0")
      i = i + 4
      continue
    }
    if (rem.startsWith("ough")) {
      out.push("OW1")
      i = i + 4
      continue
    }
    if (rem.startsWith("igh")) {
      out.push("AY1")
      i = i + 3
      continue
    }
    if (rem.startsWith("tch")) {
      out.push("CH")
      i = i + 3
      continue
    }
    if (rem.startsWith("dge")) {
      out.push("JH")
      i = i + 3
      continue
    }
    if (rem.startsWith("ing") && i + 3 === n && n > 4) {
      out.push("IH0", "NG")
      i = i + 3
      continue
    }

    // Consonant digraphs
    if (i === 0 && (rem.startsWith("kn") || rem.startsWith("gn") || rem.startsWith("pn"))) {
      out.push("N")
      i = i + 2
      continue
    }
    if (i === 0 && rem.startsWith("wr")) {
      out.push("R")
      i = i + 2
      continue
    }
    if (rem.startsWith("wh")) {
      if (next2 === "o") { out.push("HH") } else { out.push("W") }
      i = i + 2
      continue
    }
    if (rem.startsWith("ph")) { out.push("F"); i = i + 2; continue }
    if (rem.startsWith("sh")) { out.push("SH"); i = i + 2; continue }
    if (rem.startsWith("ch")) { out.push("CH"); i = i + 2; continue }
    if (rem.startsWith("th")) {
      let voicedTh = (i === 0 && (w === "than" || w === "then" || w === "thus")) || (i > 0 && isLetterVowel(prev) && next === "e")
      out.push(voicedTh ? "DH" : "TH")
      i = i + 2
      continue
    }
    if (rem.startsWith("ng")) {
      out.push("NG")
      i = i + 2
      continue
    }
    if (rem.startsWith("nk")) {
      out.push("NG", "K")
      i = i + 2
      continue
    }
    if (rem.startsWith("qu")) {
      out.push("K", "W")
      i = i + 2
      continue
    }
    if (rem.startsWith("ck")) {
      out.push("K")
      i = i + 2
      continue
    }
    if (rem.startsWith("gh")) {
      if (i === 0) { out.push("G") }
      i = i + 2
      continue
    }

    // Vowel digraphs & r-colored vowels
    if (rem.startsWith("ee") || rem.startsWith("ea")) {
      if (rem.startsWith("ear") && i + 3 === n) { out.push("IH1", "R"); i = i + 3; continue }
      out.push("IY1")
      i = i + 2
      continue
    }
    if (rem.startsWith("oo")) {
      if (next2 === "k" || next2 === "d") { out.push("UH1") } else { out.push("UW1") }
      i = i + 2
      continue
    }
    if (rem.startsWith("ou")) {
      out.push("AW1")
      i = i + 2
      continue
    }
    if (rem.startsWith("ow")) {
      out.push(i + 2 === n ? "OW1" : "AW1")
      i = i + 2
      continue
    }
    if (rem.startsWith("oi") || rem.startsWith("oy")) {
      out.push("OY1")
      i = i + 2
      continue
    }
    if (rem.startsWith("ai") || rem.startsWith("ay") || rem.startsWith("ei") || rem.startsWith("ey")) {
      out.push("EY1")
      i = i + 2
      continue
    }
    if (rem.startsWith("oa") || rem.startsWith("oe")) {
      out.push("OW1")
      i = i + 2
      continue
    }
    if (rem.startsWith("au") || rem.startsWith("aw")) {
      out.push("AO1")
      i = i + 2
      continue
    }
    if (rem.startsWith("ie")) {
      out.push(i + 2 === n && n <= 4 ? "AY1" : "IY1")
      i = i + 2
      continue
    }
    if (rem.startsWith("ar") && !isLetterVowel(next2)) {
      out.push("AA1", "R")
      i = i + 2
      continue
    }
    if (rem.startsWith("or") && !isLetterVowel(next2)) {
      out.push("AO1", "R")
      i = i + 2
      continue
    }
    if ((rem.startsWith("er") || rem.startsWith("ir") || rem.startsWith("ur")) && !isLetterVowel(next2)) {
      out.push(i + 2 === n && n > 4 ? "ER0" : "ER1")
      i = i + 2
      continue
    }
    if (rem.startsWith("le") && i + 2 === n && i > 0 && !isLetterVowel(prev)) {
      out.push("AX0", "L")
      i = i + 2
      continue
    }
    if (rem.startsWith("ed") && i + 2 === n && n > 3) {
      let lastOut = out.length > 0 ? out[out.length - 1].replace(/[012]/g, "") : ""
      if (lastOut === "T" || lastOut === "D") {
        out.push("IH0", "D")
      } else {
        out.push(isVoicedPhone(lastOut) ? "D" : "T")
      }
      i = i + 2
      continue
    }

    // Double consonants collapse cleanly
    if (c === next && !isLetterVowel(c)) {
      i = i + 1
      continue
    }

    // Single vowels
    if (c === "a") {
      if (hasMagicE && i === n - 3) { out.push("EY1") }
      else if (i === n - 1 && n > 2) { out.push("AX0") }
      else { out.push("AE1") }
      i = i + 1
      continue
    }
    if (c === "e") {
      if (i === n - 1 && n > 2) {
        // Silent final e (unless short word like "be", "me", "he")
        i = i + 1
        continue
      }
      if (hasMagicE && i === n - 3) { out.push("IY1") }
      else { out.push("EH1") }
      i = i + 1
      continue
    }
    if (c === "i") {
      if (hasMagicE && i === n - 3) { out.push("AY1") }
      else { out.push("IH1") }
      i = i + 1
      continue
    }
    if (c === "o") {
      if (hasMagicE && i === n - 3) { out.push("OW1") }
      else if (i === n - 1) { out.push("OW1") }
      else { out.push("AA1") }
      i = i + 1
      continue
    }
    if (c === "u") {
      if (hasMagicE && i === n - 3) { out.push("Y", "UW1") }
      else { out.push("AH1") }
      i = i + 1
      continue
    }
    if (c === "y") {
      if (i === 0) { out.push("Y") }
      else if (i === n - 1 && n <= 3) { out.push("AY1") }
      else if (i === n - 1) { out.push("IY0") }
      else { out.push("IH1") }
      i = i + 1
      continue
    }

    // Single consonants
    if (c === "b") { out.push("B") }
    else if (c === "c") {
      if (next === "e" || next === "i" || next === "y") { out.push("S") } else { out.push("K") }
    }
    else if (c === "d") { out.push("D") }
    else if (c === "f") { out.push("F") }
    else if (c === "g") {
      if (next === "e" || next === "i" || next === "y") { out.push("JH") } else { out.push("G") }
    }
    else if (c === "h") { out.push("HH") }
    else if (c === "j") { out.push("JH") }
    else if (c === "k") { out.push("K") }
    else if (c === "l") { out.push("L") }
    else if (c === "m") { out.push("M") }
    else if (c === "n") { out.push("N") }
    else if (c === "p") { out.push("P") }
    else if (c === "q") { out.push("K") }
    else if (c === "r") { out.push("R") }
    else if (c === "s") {
      if (i === n - 1 && out.length > 0 && isVoicedPhone(out[out.length - 1])) { out.push("Z") }
      else { out.push("S") }
    }
    else if (c === "t") { out.push("T") }
    else if (c === "v") { out.push("V") }
    else if (c === "w") { out.push("W") }
    else if (c === "x") { out.push(i === 0 ? "Z" : "K", i === 0 ? "" : "S") }
    else if (c === "z") { out.push("Z") }

    i = i + 1
  }

  // Clean empty tokens & normalize primary stress so only the first main vowel carries '1'
  let cleaned = []
  let seenPrimary = false
  for (let k = 0; k < out.length; k = k + 1) {
    let tok = out[k]
    if (!tok) { continue }
    if (tok.indexOf("1") >= 0) {
      if (!seenPrimary) {
        seenPrimary = true
      } else {
        tok = tok.replace("1", "0")
      }
    }
    cleaned.push(tok)
  }
  return cleaned
}

let _FUNCTION_WORDS = {
  "a": 1, "an": 1, "the": 1, "to": 1, "of": 1, "in": 1, "on": 1, "at": 1, "for": 1, "by": 1, "with": 1,
  "and": 1, "or": 1, "but": 1, "if": 1, "as": 1, "is": 1, "am": 1, "are": 1, "was": 1, "were": 1, "be": 1,
  "it": 1, "its": 1, "my": 1, "your": 1, "his": 1, "her": 1, "our": 1, "their": 1, "that": 1, "from": 1
}

let _IPA_MAP = {
  "IY": "iː", "IH": "ɪ", "EH": "ɛ", "AE": "æ", "AA": "ɑː", "AO": "ɔː", "UH": "ʊ", "UW": "uː",
  "AH": "ʌ", "AX": "ə", "ER": "ɝ", "EY": "eɪ", "AY": "aɪ", "OY": "ɔɪ", "AW": "aʊ", "OW": "oʊ",
  "P": "p", "B": "b", "T": "t", "D": "d", "K": "k", "G": "ɡ", "CH": "tʃ", "JH": "dʒ",
  "F": "f", "V": "v", "TH": "θ", "DH": "ð", "S": "s", "Z": "z", "SH": "ʃ", "ZH": "ʒ", "HH": "h",
  "M": "m", "N": "n", "NG": "ŋ", "L": "l", "R": "ɹ", "W": "w", "Y": "j", "SIL": "·"
}

function phoneToIpa(ph) {
  let base = ph.replace(/[012]/g, "")
  return _IPA_MAP[base] || base.toLowerCase()
}

// Tokenize full sentence into clause-aware word & phoneme plan
function textToUtterancePlan(rawText) {
  initPhonetics()
  let norm = normalizeEnglishText(rawText)
  if (!norm) {
    return { normalized: "", words: [], ipaString: "", clauses: [] }
  }

  // Split into prosodic clauses keeping trailing punctuation (.,?!;:)
  let rawClauses = norm.match(/[^.!?,;:]+[.!?,;:]*/g) || [norm]
  let clauses = []
  let allWords = []
  let ipaParts = []

  for (let ci = 0; ci < rawClauses.length; ci = ci + 1) {
    let ctext = rawClauses[ci].trim()
    if (!ctext) { continue }
    let puncMatch = ctext.match(/([.!?,;:]+)$/)
    let punc = puncMatch ? puncMatch[1].charAt(0) : "."
    let body = puncMatch ? ctext.slice(0, ctext.length - puncMatch[1].length) : ctext

    // Preserve natural contractions (e.g., I'm, don't, can't, let's) while expanding multi-word tokens
    let rawTokens = body.toLowerCase().replace(/[\u2018\u2019]/g, "'").split(/\s+/)
    let expanded = []
    for (let ti = 0; ti < rawTokens.length; ti = ti + 1) {
      let cleanTok = rawTokens[ti].replace(/^[^a-z0-9']+|[^a-z0-9']+$/g, "")
      if (!cleanTok) { continue }
      if (_CONTRACTION_PHONES[cleanTok]) {
        expanded.push(cleanTok)
      } else if (_CONTRACTIONS[cleanTok]) {
        let splitC = _CONTRACTIONS[cleanTok].split(" ")
        for (let si = 0; si < splitC.length; si = si + 1) { expanded.push(splitC[si]) }
      } else {
        let sub = cleanTok.replace(/'s$/g, "s").split(/[^a-z0-9]+/)
        for (let si = 0; si < sub.length; si = si + 1) {
          if (sub[si]) { expanded.push(sub[si]) }
        }
      }
    }

    if (expanded.length === 0) { continue }

    let firstWord = expanded[0]
    let isYesNoQ = punc === "?" && (
      firstWord === "can" || firstWord === "could" || firstWord === "do" || firstWord === "does" ||
      firstWord === "did" || firstWord === "are" || firstWord === "is" || firstWord === "am" ||
      firstWord === "was" || firstWord === "were" || firstWord === "will" || firstWord === "would" ||
      firstWord === "have" || firstWord === "has" || firstWord === "should" || firstWord === "may"
    )

    let clauseWords = []
    for (let wi = 0; wi < expanded.length; wi = wi + 1) {
      let w = expanded[wi]
      let phones = _CONTRACTION_PHONES[w] ? _CONTRACTION_PHONES[w].slice() : lookupWithMorphology(w)
      if (!phones || phones.length === 0) {
        phones = g2pWord(w)
      }
      if (!phones || phones.length === 0) { continue }

      // Natural connected-speech weak-form reductions for non-clause-final function words
      let isNonFinal = wi + 1 < expanded.length
      if (isNonFinal) {
        let nw = expanded[wi + 1]
        let nextPhones = _CONTRACTION_PHONES[nw] || lookupWithMorphology(nw) || g2pWord(nw)
        let nextStartsVowel = !!(nextPhones && nextPhones.length > 0 && isVowelPhone(nextPhones[0]))
        if (w === "the") {
          phones = nextStartsVowel ? ["DH", "IY0"] : ["DH", "AX0"]
        } else if (w === "to") {
          phones = ["T", "UW0"]
        } else if (w === "a") {
          phones = ["AX0"]
        } else if (w === "an") {
          phones = ["AE0", "N"]
        } else if (w === "of") {
          phones = ["AH0", "V"]
        }
      }

      // Function-word destressing unless clause-final
      let isFunc = _FUNCTION_WORDS[w] === 1 && isNonFinal
      if (isFunc) {
        for (let pi = 0; pi < phones.length; pi = pi + 1) {
          phones[pi] = phones[pi].replace("1", "0")
        }
      }

      let wordIpa = ""
      for (let pi = 0; pi < phones.length; pi = pi + 1) {
        wordIpa = wordIpa + phoneToIpa(phones[pi])
      }
      let wObj = {
        word: w,
        phones: phones,
        ipa: wordIpa,
        isContent: !isFunc,
        isClauseFinal: wi === expanded.length - 1
      }
      clauseWords.push(wObj)
      allWords.push(wObj)
      ipaParts.push(wordIpa)
    }

    if (clauseWords.length > 0) {
      clauses.push({
        words: clauseWords,
        punc: punc,
        isQuestion: punc === "?",
        isYesNoQuestion: isYesNoQ,
        isExclaim: punc === "!"
      })
    }
  }

  return {
    normalized: norm,
    words: allWords,
    ipaString: "/" + ipaParts.join(" ") + "/",
    clauses: clauses
  }
}

// Splits arbitrary long speech into natural human breath-groups (<= maxWords words each)
// so synthesis starts speaking within milliseconds and never approaches VM instruction limits.
function splitIntoBreathClauses(rawText, maxWords) {
  let limit = (maxWords && maxWords > 3) ? maxWords : 9
  let text = String(rawText || "").replace(/\s+/g, " ").trim()
  if (!text) { return [] }

  // First split at natural sentence/clause punctuation (. ! ? ; : , —)
  let rawParts = text.match(/[^.!?;:,—]+[.!?;:,—]*/g) || [text]
  let out = []

  for (let pi = 0; pi < rawParts.length; pi = pi + 1) {
    let seg = rawParts[pi].trim()
    if (!seg) { continue }
    let words = seg.split(/\s+/)
    if (words.length <= limit) {
      // Merge tiny 1-2 word comma fragments (like "Hello," or "Well,") with the next short clause if comfortable
      if (out.length > 0 && words.length <= 3) {
        let prevWords = out[out.length - 1].split(/\s+/)
        if (prevWords.length + words.length <= limit && /[,—]$/.test(out[out.length - 1])) {
          out[out.length - 1] = out[out.length - 1] + " " + seg
          continue
        }
      }
      out.push(seg)
      continue
    }

    // Long unpunctuated clause: split at natural prosodic conjunctions/prepositions near ~limit
    let start = 0
    while (start < words.length) {
      if (words.length - start <= limit) {
        out.push(words.slice(start).join(" "))
        break
      }
      let bestBreak = start + limit
      let minLook = start + Math.max(4, Math.floor(limit * 0.55))
      let maxLook = Math.min(words.length - 2, start + limit)
      for (let k = maxLook; k >= minLook; k = k - 1) {
        let lw = words[k].toLowerCase().replace(/[^a-z']/g, "")
        if (
          lw === "and" || lw === "but" || lw === "or" || lw === "so" || lw === "because" ||
          lw === "while" || lw === "when" || lw === "where" || lw === "which" || lw === "that" ||
          lw === "with" || lw === "from" || lw === "into" || lw === "through" || lw === "using"
        ) {
          bestBreak = k
          break
        }
      }
      let sliceText = words.slice(start, bestBreak).join(" ")
      if (!/[.!?;:,]$/.test(sliceText)) { sliceText = sliceText + "," }
      out.push(sliceText)
      start = bestBreak
    }
  }

  return out
}
