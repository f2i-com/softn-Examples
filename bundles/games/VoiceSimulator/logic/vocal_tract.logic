// Voice Simulator — Natural Human Vocal-Tract & KLGLOTT88/HNM Speech Synthesis Engine (v3)
// Pure-code human speech production physics:
//  1. Solved C2 Fant-Liljencrants-Lin (LF) analytical glottal derivative wavetables (Modal, Warm, Lax)
//     with dynamic syllable-onset/offset Open Quotient trajectories — zero numerical differentiation aliasing!
//  2. Harmonic + Noise Model (HNM) pitch-synchronous glottal-chink air + subglottal tracheal chest body.
//  3. Pitch-synchronous open-phase F1 tracheal damping (eliminates static biquad "hollow pipe" robotic buzz)
//     + Piriform Fossa (~4.45 kHz) laryngeal anti-resonance notch + Klatt Cascade/Parallel F2-F3 presence hybrid.
//  4. Dedicated nostril nasal tract (/m, n, ng/ with true oral-seal lip attenuation & place zeros),
//     warm open-glottis vowel-colored /h/ & stop VOT aspiration, lip-coarticulated sibilants, and locus transitions.
//  5. Fujisaki phrase + Gaussian syllable-arch prosody (with English peak delay, consonantal microprosody,
//     and polysyllabic foot compression) + unified real-time <AudioStream> & offline WAV synthesis.

let VS_SAMPLE_RATE = 24000
let VS_FRAME_MS = 5
let VS_SAMPLES_PER_FRAME = 120 // 5 ms at 24 kHz
let VS_SUBSTEP_SAMPLES = 30    // 4 substeps per frame (1.25 ms = 800 Hz filter update rate)

let _TAU = 6.283185307179586
let _PI = 3.141592653589793

// Precomputed 4096-point Solved Analytical LF Glottal Derivative E(u) & Flow Envelope Ug(u) Tables
let _UG_SIZE = 4096
let _UG_READY = false
let _EG_MODAL = null
let _EG_WARM = null
let _EG_LAX = null
let _UG_ENV = null
let _UG_BODY = null
let _IDLE_SILENT_B64 = ""

function _buildSolvedLfTables(dstDeriv, dstFlow, tp, te, ta) {
  let eps = 1.0 / Math.max(0.006, ta)
  let spanRet = Math.max(0.01, 1.0 - te)
  let retDenom = Math.max(1e-6, 1.0 - Math.exp(-eps * spanRet))
  // Return phase integral for Ee = 1.0:
  let retArea = (1.0 / eps) * (1.0 - Math.exp(-eps * spanRet)) - spanRet * Math.exp(-eps * spanRet)
  retArea = retArea / retDenom

  // Solve growth parameter `alpha` via binary search so integral_0^1 E(u) du === 0 (zero net DC drift!)
  let omegaG = _PI / tp
  let sinTe = Math.sin(omegaG * te) // negative since te > tp
  let lo = -12.0
  let hi = 28.0
  for (let it = 0; it < 22; it = it + 1) {
    let mid = 0.5 * (lo + hi)
    // E0 chosen so E(te-) == -1.0 -> E0 * exp(mid * te) * sinTe = -1.0
    let e0 = -1.0 / (Math.exp(mid * te) * sinTe)
    // Exact integral of e0 * exp(mid * u) * sin(omegaG * u) from 0 to te:
    let openArea = e0 * (
      (Math.exp(mid * te) * (mid * Math.sin(omegaG * te) - omegaG * Math.cos(omegaG * te)) + omegaG) /
      (mid * mid + omegaG * omegaG)
    )
    if (openArea > retArea) {
      lo = mid
    } else {
      hi = mid
    }
  }
  let alpha = 0.5 * (lo + hi)
  let e0Final = -1.0 / (Math.exp(alpha * te) * sinTe)

  let meanE = 0.0
  let flowAcc = 0.0
  let maxFlow = 1e-6
  let du = 1.0 / _UG_SIZE

  for (let i = 0; i < _UG_SIZE; i = i + 1) {
    let u = (i + 0.5) * du
    let eVal = 0.0
    if (u < te) {
      eVal = e0Final * Math.exp(alpha * u) * Math.sin(omegaG * u)
    } else {
      eVal = -(Math.exp(-eps * (u - te)) - Math.exp(-eps * spanRet)) / retDenom
    }
    dstDeriv[i] = eVal
    meanE = meanE + eVal
    if (dstFlow) {
      flowAcc = Math.max(0.0, flowAcc + eVal * du)
      dstFlow[i] = flowAcc
      if (flowAcc > maxFlow) { maxFlow = flowAcc }
    }
  }

  meanE = meanE / _UG_SIZE
  for (let i = 0; i < _UG_SIZE; i = i + 1) {
    dstDeriv[i] = dstDeriv[i] - meanE
  }

  // Soft mucosal-wave zipper closure smoothing (radius = 16 samples = ~0.39% of T0):
  // Real human vocal folds close progressively along their wet mucosal margin rather than
  // snapping at a mathematical C0 corner, eliminating high-frequency impulse buzz while keeping crisp F2/F3!
  let tmpSmooth = new Float32Array(_UG_SIZE)
  let kRad = 16
  let mask = _UG_SIZE - 1
  for (let i = 0; i < _UG_SIZE; i = i + 1) {
    let acc = 0.0
    let wSum = 0.0
    for (let d = -kRad; d <= kRad; d = d + 1) {
      let w = 0.5 * (1.0 + Math.cos((_PI * d) / (kRad + 1)))
      acc = acc + dstDeriv[(i + d) & mask] * w
      wSum = wSum + w
    }
    tmpSmooth[i] = acc / wSum
  }

  let sqSum = 0.0
  for (let i = 0; i < _UG_SIZE; i = i + 1) {
    let d = tmpSmooth[i]
    dstDeriv[i] = d
    sqSum = sqSum + d * d
  }
  let invRms = 1.0 / Math.max(1e-6, Math.sqrt(sqSum / _UG_SIZE))
  for (let i = 0; i < _UG_SIZE; i = i + 1) {
    dstDeriv[i] = dstDeriv[i] * invRms
  }

  if (dstFlow) {
    let invMax = 1.0 / maxFlow
    for (let i = 0; i < _UG_SIZE; i = i + 1) {
      dstFlow[i] = dstFlow[i] * invMax
    }
  }
}

function _initGlottalTables() {
  if (_UG_READY) { return }
  _EG_MODAL = new Float32Array(_UG_SIZE)
  _EG_WARM = new Float32Array(_UG_SIZE)
  _EG_LAX = new Float32Array(_UG_SIZE)
  _UG_ENV = new Float32Array(_UG_SIZE)
  _UG_BODY = new Float32Array(_UG_SIZE)
  let warmFlow = new Float32Array(_UG_SIZE)

  // 1. Clear human modal fold closure (smooth mucosal return, rich F1-F3 clarity without buzz)
  _buildSolvedLfTables(_EG_MODAL, _UG_ENV, 0.43, 0.58, 0.024)
  // 2. Warm natural chest-head fold closure (velvety human conversational tone)
  _buildSolvedLfTables(_EG_WARM, warmFlow, 0.46, 0.64, 0.044)
  // 3. Soft / breathy fold closure (gentle voice onset/offset, female OQ warmth & unstressed syllables)
  _buildSolvedLfTables(_EG_LAX, null, 0.49, 0.71, 0.075)

  // Demeaned & RMS-normalized smooth glottal volume-flow pulse for direct subglottal/chest H1 warmth
  let meanBody = 0.0
  for (let i = 0; i < _UG_SIZE; i = i + 1) { meanBody = meanBody + warmFlow[i] }
  meanBody = meanBody / _UG_SIZE
  let bodySq = 0.0
  for (let i = 0; i < _UG_SIZE; i = i + 1) {
    let b = warmFlow[i] - meanBody
    _UG_BODY[i] = b
    bodySq = bodySq + b * b
  }
  let invBodyRms = 1.0 / Math.max(1e-6, Math.sqrt(bodySq / _UG_SIZE))
  for (let i = 0; i < _UG_SIZE; i = i + 1) {
    _UG_BODY[i] = _UG_BODY[i] * invBodyRms
  }

  // Precomputed 540-sample (22.5 ms @ 24 kHz = 1080 zero bytes = 1440 'A' base64 chars) keepalive block
  let aChunk = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
  let outB64 = ""
  for (let k = 0; k < 22; k = k + 1) { outB64 = outB64 + aChunk }
  _IDLE_SILENT_B64 = outB64 + "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"

  _UG_READY = true
}

function getIdleAudioStreamBlock() {
  _initGlottalTables()
  return {
    pcm: _IDLE_SILENT_B64,
    frames: 540,
    rate: VS_SAMPLE_RATE,
    channels: 1,
    format: "i16"
  }
}

