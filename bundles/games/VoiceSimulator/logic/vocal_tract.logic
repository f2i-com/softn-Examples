  "Z":   { f1: 300, f2: 1740, f3: 2540, b1: 85,  b2: 120, b3: 180, dur: 70,  av: 0.66, ah: 0.02, af: 0.21, avb: 0.26, nasal: 0.0, oralSeal: 0.0, fnz: 500,  fricF1: 5400, fricB1: 980,  fricF2: 7300, fricB2: 1550, fricG1: 0.64, fricG2: 0.46, stiff: 0.76, jaw: 0.12, tH: 0.74, tF: 0.78, tTip: 0.90, lipR: 0.0,  lipS: 0.36, lipC: 0.0,  velum: 0.0 },
  "SH":  { f1: 330, f2: 1960, f3: 2620, b1: 130, b2: 145, b3: 205, dur: 94,  av: 0.0,  ah: 0.02, af: 0.31, avb: 0.0,  nasal: 0.0, oralSeal: 0.0, fnz: 500,  fricF1: 2650, fricB1: 700,  fricF2: 3950, fricB2: 1080, fricG1: 0.68, fricG2: 0.42, stiff: 0.78, jaw: 0.16, tH: 0.78, tF: 0.82, tTip: 0.74, lipR: 0.58, lipS: 0.0,  lipC: 0.0,  velum: 0.0 },
  "ZH":  { f1: 310, f2: 1940, f3: 2600, b1: 85,  b2: 120, b3: 180, dur: 70,  av: 0.66, ah: 0.02, af: 0.20, avb: 0.26, nasal: 0.0, oralSeal: 0.0, fnz: 500,  fricF1: 2600, fricB1: 700,  fricF2: 3850, fricB2: 1080, fricG1: 0.68, fricG2: 0.42, stiff: 0.78, jaw: 0.16, tH: 0.78, tF: 0.82, tTip: 0.74, lipR: 0.58, lipS: 0.0,  lipC: 0.0,  velum: 0.0 }
}

// Diphthong Dual Targets (Lehiste & Peterson / Hillenbrand General American nucleus-to-offglide targets)
let _DIPHTHONGS = {
  "EY": { a: "EH", b: "IY", dur: 150, split: 0.54, f1a: 495, f2a: 1960, f1b: 300, f2b: 2310 },
  "AY": { a: "AA", b: "IH", dur: 168, split: 0.58, f1a: 735, f2a: 1190, f1b: 375, f2b: 2070 },
  "OY": { a: "AO", b: "IH", dur: 172, split: 0.58, f1a: 565, f2a: 850,  f1b: 375, f2b: 2050 },
  "AW": { a: "AA", b: "UH", dur: 170, split: 0.60, f1a: 735, f2a: 1280, f1b: 435, f2b: 960  },
  "OW": { a: "AO", b: "UW", dur: 152, split: 0.56, f1a: 515, f2a: 990,  f1b: 340, f2b: 845  }
}

// Plosive & Affricate Sub-Segmental Anatomy (Delattre/Klatt Locus + Warm Open-Glottis VOT)
let _STOPS = {
  "P":  { voiced: false, closeMs: 48, burstMs: 12, votMs: 36, f1: 245, f2: 740,  f3: 2120, bF1: 1120, bB1: 900,  bF2: 2450, bB2: 1550, burstAf: 0.40, votAh: 0.34, jaw: 0.06, tH: 0.45, tF: 0.45, tTip: 0.18, lipR: 0.05, lipC: 1.0, labial: true },
  "B":  { voiced: true,  closeMs: 42, burstMs: 10, votMs: 9,  f1: 235, f2: 740,  f3: 2120, bF1: 1080, bB1: 900,  bF2: 2350, bB2: 1550, burstAf: 0.26, votAh: 0.04, jaw: 0.06, tH: 0.45, tF: 0.45, tTip: 0.18, lipR: 0.05, lipC: 1.0, labial: true },
  "T":  { voiced: false, closeMs: 46, burstMs: 13, votMs: 40, f1: 290, f2: 1790, f3: 2620, bF1: 3900, bB1: 1100, bF2: 6200, bB2: 1800, burstAf: 0.34, votAh: 0.36, jaw: 0.14, tH: 0.72, tF: 0.76, tTip: 0.98, lipR: 0.0,  lipC: 0.0, alveolar: true },
  "D":  { voiced: true,  closeMs: 38, burstMs: 9,  votMs: 8,  f1: 275, f2: 1790, f3: 2600, bF1: 3700, bB1: 1100, bF2: 5800, bB2: 1800, burstAf: 0.18, votAh: 0.04, jaw: 0.14, tH: 0.72, tF: 0.76, tTip: 0.98, lipR: 0.0,  lipC: 0.0, alveolar: true },
  "K":  { voiced: false, closeMs: 48, burstMs: 16, votMs: 42, f1: 295, f2: 1850, f3: 2240, bF1: 1950, bB1: 720,  bF2: 3650, bB2: 1300, burstAf: 0.36, votAh: 0.38, jaw: 0.22, tH: 0.95, tF: 0.36, tTip: 0.16, lipR: 0.04, lipC: 0.0, velar: true },
  "G":  { voiced: true,  closeMs: 38, burstMs: 10, votMs: 9,  f1: 280, f2: 1850, f3: 2240, bF1: 1900, bB1: 720,  bF2: 3450, bB2: 1300, burstAf: 0.20, votAh: 0.05, jaw: 0.22, tH: 0.95, tF: 0.36, tTip: 0.16, lipR: 0.04, lipC: 0.0, velar: true },
  "CH": { voiced: false, closeMs: 42, burstMs: 54, votMs: 14, f1: 310, f2: 1960, f3: 2620, bF1: 2720, bB1: 680,  bF2: 4100, bB2: 1100, burstAf: 0.36, votAh: 0.18, jaw: 0.16, tH: 0.80, tF: 0.82, tTip: 0.86, lipR: 0.52, lipC: 0.0 },
  "JH": { voiced: true,  closeMs: 36, burstMs: 38, votMs: 8,  f1: 295, f2: 1940, f3: 2600, bF1: 2580, bB1: 680,  bF2: 3650, bB2: 1100, burstAf: 0.20, votAh: 0.04, jaw: 0.16, tH: 0.80, tF: 0.82, tTip: 0.86, lipR: 0.52, lipC: 0.0 }
}

function clampVal(v, lo, hi) {
  if (v < lo) { return lo }
  if (v > hi) { return hi }
  return v
}

function cloneSpec(s) {
  return {
    f1: s.f1, f2: s.f2, f3: s.f3, b1: s.b1, b2: s.b2, b3: s.b3,
    dur: s.dur, av: s.av, ah: s.ah, af: s.af, avb: s.avb,
    nasal: s.nasal || 0.0, oralSeal: s.oralSeal || 0.0, fnz: s.fnz,
    fricF1: s.fricF1, fricB1: s.fricB1, fricF2: s.fricF2, fricB2: s.fricB2,
    fricG1: s.fricG1, fricG2: s.fricG2, stiff: s.stiff,
    jaw: s.jaw, tH: s.tH, tF: s.tF, tTip: s.tTip,
    lipR: s.lipR, lipS: s.lipS, lipC: s.lipC, velum: s.velum,
    stress: 0, segShape: "flat", isPhraseTail: false, isClosure: false,
    accentBoost: 0.0, microF0: 0.0, clauseIdx: 0
  }
}

function peekAdjacentVowelSpec(flatPhones, idx) {
  for (let d = 1; d <= 3; d = d + 1) {
    if (idx + d < flatPhones.length) {
      let nb = flatPhones[idx + d].base
      if (_PHONEME_SPECS[nb] && isVowelPhone(nb)) { return _PHONEME_SPECS[nb] }
      if (_DIPHTHONGS[nb]) { return _PHONEME_SPECS[_DIPHTHONGS[nb].a] }
    }
  }
  for (let d = 1; d <= 2; d = d + 1) {
    if (idx - d >= 0) {
      let pb = flatPhones[idx - d].base
      if (_PHONEME_SPECS[pb] && isVowelPhone(pb)) { return _PHONEME_SPECS[pb] }
      if (_DIPHTHONGS[pb]) { return _PHONEME_SPECS[_DIPHTHONGS[pb].b] }
    }
  }
  return _PHONEME_SPECS["AX"]
}

function buildAcousticTimeline(plan, voiceCfg) {
  let baseF0 = voiceCfg.pitchHz || (voiceCfg.gender === "female" ? 186 : 110)
  let speed = clampVal(voiceCfg.speed || 1.0, 0.55, 1.75)
  let rateScale = 1.0 / speed
  let expressiveness = clampVal(voiceCfg.expressiveness !== undefined ? voiceCfg.expressiveness : 1.0, 0.0, 1.8)
  let crispness = clampVal(voiceCfg.crispness !== undefined ? voiceCfg.crispness : 1.0, 0.45, 1.6)
  let whisperMode = voiceCfg.whisper === true

  let segments = []
  let silLead = cloneSpec(_PHONEME_SPECS["SIL"])
  silLead.dur = 75
  silLead.f0Start = baseF0 * 1.04
  silLead.f0End = baseF0 * 1.04
  silLead.isClosure = true
  silLead.clauseIdx = -1
  silLead.phone = "SIL"
  silLead.word = ""
  segments.push(silLead)

  let maxPhonesBudget = 1200
  let totalPhonesEmitted = 0
  let nClauses = plan.clauses.length
  let clauseMeta = []

  for (let ci = 0; ci < nClauses; ci = ci + 1) {
    if (totalPhonesEmitted >= maxPhonesBudget) { break }
    let clause = plan.clauses[ci]
    let flat = []

    let nuclearWordIdx = -1
    for (let wi = clause.words.length - 1; wi >= 0; wi = wi - 1) {
      if (clause.words[wi].isContent) {
        nuclearWordIdx = wi
        break
      }
    }
    if (nuclearWordIdx < 0 && clause.words.length > 0) {
      nuclearWordIdx = clause.words.length - 1
    }

    for (let wi = 0; wi < clause.words.length; wi = wi + 1) {
      let wObj = clause.words[wi]
      // Count vowel nuclei in this word for Lehiste polysyllabic foot compression
      let nSylls = 0
      for (let pk = 0; pk < wObj.phones.length; pk = pk + 1) {
        let bCheck = wObj.phones[pk].replace(/[012]/g, "")
        if (isVowelPhone(bCheck)) { nSylls = nSylls + 1 }
      }
      if (nSylls < 1) { nSylls = 1 }
      let polyScale = nSylls === 1 ? 1.0 : (nSylls === 2 ? 0.91 : (nSylls === 3 ? 0.84 : 0.79))
      if (!wObj.isContent && nSylls === 1 && !wObj.isClauseFinal && wi > 0) {
        polyScale = 0.80
      }

      for (let pi = 0; pi < wObj.phones.length; pi = pi + 1) {
        if (totalPhonesEmitted + flat.length >= maxPhonesBudget) { break }
        let rawP = wObj.phones[pi]
        let stress = 0
        if (rawP.indexOf("1") >= 0) { stress = 1 }
        else if (rawP.indexOf("2") >= 0) { stress = 2 }
        let base = rawP.replace(/[012]/g, "")
        flat.push({
          raw: rawP,
          base: base,
          stress: stress,
          polyScale: polyScale,
          word: wObj.word,
          isNuclearWord: wi === nuclearWordIdx,
          ipa: wObj.ipa,
          isContent: wObj.isContent,
          isWordInitial: pi === 0,
          isWordFinal: pi === wObj.phones.length - 1,
          isClauseFinalWord: wObj.isClauseFinal
        })
      }
    }
    totalPhonesEmitted = totalPhonesEmitted + flat.length

    clauseMeta.push({
      punc: clause.punc || ".",
      isQuestion: !!clause.isQuestion,
      isYesNoQuestion: !!clause.isYesNoQuestion,
      isExclaim: !!clause.isExclaim,
      isFirst: ci === 0,
      isLast: ci === nClauses - 1
    })

    let nPhones = flat.length
    let contentSeen = 0

    for (let i = 0; i < nPhones; i = i + 1) {
      let item = flat[i]
      let base = item.base
      let prevBase = i > 0 ? flat[i - 1].base : "SIL"
      let nextBase = i + 1 < nPhones ? flat[i + 1].base : "SIL"

      // Fujisaki accent amplitude (smooth Gaussian pitch arch centered on stressed vowel in rasterizeVocalFrames)
      let accentBoost = 0.0
      if (isVowelPhone(base)) {
        if (item.stress === 1 && item.isNuclearWord) {
          accentBoost = 0.145 * expressiveness
        } else if (item.stress === 1 && item.isContent) {
          let downstep = Math.max(0.68, 1.0 - contentSeen * 0.075)
          accentBoost = 0.125 * downstep * expressiveness
          contentSeen = contentSeen + 1
        } else if (item.stress === 1) {
          accentBoost = 0.050 * expressiveness
        } else if (item.stress === 2) {
          accentBoost = 0.042 * expressiveness
        }
      }

      // Consonantal microprosody: voiceless obstruents gently raise onset F0 (+3.2%); voiced stops gently dip (-1.8%)
      let prevVoiceless = (prevBase === "P" || prevBase === "T" || prevBase === "K" || prevBase === "F" || prevBase === "TH" || prevBase === "S" || prevBase === "SH" || prevBase === "CH" || prevBase === "HH")
      let microF0 = (isVowelPhone(base) && prevVoiceless) ? 0.030 : 0.0

      let prevSameWordCons = i > 0 && flat[i - 1].word === item.word && !isVowelPhone(prevBase)
      let nextSameWordCons = i + 1 < nPhones && flat[i + 1].word === item.word && !isVowelPhone(nextBase)
      let clusterScale = (!isVowelPhone(base) && (prevSameWordCons || nextSameWordCons)) ? 0.80 : 1.0

      let durMult = rateScale * item.polyScale
      if (isVowelPhone(base)) {
        if (item.stress === 1 && item.isNuclearWord) { durMult = durMult * 1.26 }
        else if (item.stress === 1 && item.isContent) { durMult = durMult * 1.18 }
        else if (item.stress === 1) { durMult = durMult * 0.96 }
        else if (item.stress === 2) { durMult = durMult * 1.02 }
        else { durMult = durMult * 0.78 }

        if (item.isWordFinal && nextBase !== "SIL") { durMult = durMult * 1.04 }
        if (nextBase !== "SIL" && !isVowelPhone(nextBase)) {
          if (isVoicedPhone(nextBase)) { durMult = durMult * 1.10 }
          else { durMult = durMult * 0.88 }
        }
      } else {
        durMult = durMult * clusterScale
        if (item.isWordInitial && item.isContent) { durMult = durMult * 1.05 }
      }
      if (item.isClauseFinalWord) {
        durMult = durMult * (item.isWordFinal ? 1.24 : 1.08)
      }

      let effortGain = 1.0
      if (isVowelPhone(base)) {
        if (item.stress === 1 && item.isContent) { effortGain = 1.03 }
        else if (item.stress === 1) { effortGain = 0.96 }
        else if (item.stress === 2) { effortGain = 0.93 }
        else { effortGain = 0.85 }
      }
      let isPhraseTailVowel = item.isClauseFinalWord && isVowelPhone(base) && (nextBase === "SIL" || i >= nPhones - 2)

      // 1. Diphthongs
      if (_DIPHTHONGS[base]) {
        let dp = _DIPHTHONGS[base]
        let sA = cloneSpec(_PHONEME_SPECS[dp.a])
        let sB = cloneSpec(_PHONEME_SPECS[dp.b])
        sA.f1 = dp.f1a
        sA.f2 = dp.f2a
        if (dp.f1b) { sB.f1 = dp.f1b }
        if (dp.f2b) { sB.f2 = dp.f2b }
        let totalDur = Math.max(82, dp.dur * durMult)
        sA.dur = totalDur * dp.split
        sB.dur = totalDur * (1.0 - dp.split)
        sA.av = Math.min(1.0, sA.av * effortGain)
        sB.av = Math.min(1.0, sB.av * effortGain * 0.95)
        sA.stress = item.stress
        sB.stress = item.stress
        sA.accentBoost = accentBoost
        sB.accentBoost = 0.0 // accent center sits in nucleus sA (with slight peak delay into sB via Gaussian width)
        sA.microF0 = microF0
        sA.clauseIdx = ci
        sB.clauseIdx = ci
        sA.segShape = "dipA"
        sB.segShape = "dipB"
        sB.isPhraseTail = isPhraseTailVowel
        sA.phone = base
        sB.phone = base
        sA.word = item.word
        sB.word = item.word
        segments.push(sA, sB)
        continue
      }

      // 2. Plosive Stops, Affricates & Word-Internal Alveolar Tap [ɾ]
      if (_STOPS[base]) {
        let st = _STOPS[base]
        let vAdj = peekAdjacentVowelSpec(flat, i)
        let nextStress = (i + 1 < nPhones) ? flat[i + 1].stress : 0
        let next2Stress = (i + 2 < nPhones && (nextBase === "R" || nextBase === "L" || nextBase === "W" || nextBase === "Y")) ? flat[i + 2].stress : 0
        let stressedOnset = (nextStress === 1 || next2Stress === 1) && (i === 0 || prevBase !== "S")
        let prevStress = i > 0 ? flat[i - 1].stress : 0
        let intervocalicAlveolar = (
          (base === "T" || base === "D") &&
          !item.isWordInitial &&
          !item.isWordFinal &&
          i > 0 && isVowelPhone(prevBase) && prevStress === 1 &&
          i + 1 < nPhones && isVowelPhone(nextBase) && nextStress === 0 && nextBase !== "ER"
        )

        // True Delattre/Klatt Consonant Locus (coarticulated with following vowel!)
        let locF1 = st.f1
        let locF2 = st.f2
        let locF3 = st.f3
        let burstF1 = st.bF1
        if (st.labial) {
          locF2 = clampVal(740.0 + (vAdj.f2 - 1150.0) * 0.24, 640.0, 1180.0)
        } else if (st.alveolar) {
          locF2 = clampVal(1780.0 + (vAdj.f2 - 1650.0) * 0.18, 1580.0, 2050.0)
        } else if (st.velar) {
          if (vAdj.f2 > 1580.0) {
            locF2 = 2160.0
            locF3 = 2480.0
            burstF1 = 2350.0
          } else {
            locF2 = clampVal(vAdj.f2 * 0.85 + 240.0, 1020.0, 1650.0)
            locF3 = 2140.0
            burstF1 = clampVal(vAdj.f2 * 1.05 + 220.0, 1250.0, 1950.0)
          }
        }

        let nextIsStop = !!_STOPS[nextBase] && base !== "CH" && base !== "JH"
        let nextIsSonorant = (nextBase === "L" || nextBase === "R" || nextBase === "W" || nextBase === "Y")
        let nextIsObstruentOrNasal = !isVowelPhone(nextBase) && !nextIsSonorant && nextBase !== "SIL"

        let closeBaseMs = st.closeMs * (stressedOnset ? 1.0 : 0.74) * clusterScale
        if (intervocalicAlveolar) { closeBaseMs = 20 }
        else if (nextIsStop) { closeBaseMs = 28 }
        let segClose = cloneSpec(_PHONEME_SPECS["SIL"])
        segClose.dur = Math.max(18, closeBaseMs * rateScale * (i === 0 ? 0.55 : 0.88))
        segClose.f1 = locF1
        segClose.f2 = locF2
        segClose.f3 = locF3
        segClose.av = intervocalicAlveolar ? 0.48 : 0.0
        segClose.avb = (st.voiced || intervocalicAlveolar) && !whisperMode ? 0.42 : 0.0
        segClose.jaw = st.jaw
        segClose.tH = st.tH
        segClose.tF = st.tF
        segClose.tTip = st.tTip
        segClose.lipR = st.lipR
        segClose.lipC = st.lipC
        segClose.isClosure = true
        segClose.microF0 = st.voiced ? -0.018 : 0.0
        segClose.clauseIdx = ci
        segClose.phone = base
        segClose.word = item.word
        segments.push(segClose)

        if (nextBase !== base) {
          let vTarget = (nextIsSonorant && _PHONEME_SPECS[nextBase]) ? _PHONEME_SPECS[nextBase] : vAdj
          if (st.velar && nextBase === "W") {
            locF2 = 860.0
            burstF1 = 1350.0
          }
          let segBurst = cloneSpec(vTarget)
          let burstScale = intervocalicAlveolar ? 0.45 : (nextIsStop ? 0.42 : (nextIsObstruentOrNasal ? 0.50 : (stressedOnset ? 1.0 : 0.82)))
          segBurst.dur = Math.max(5, st.burstMs * burstScale * clampVal(rateScale, 0.80, 1.25))
          segBurst.f1 = locF1 * 0.65 + vTarget.f1 * 0.35
          segBurst.f2 = locF2 * 0.75 + vTarget.f2 * 0.25
          segBurst.f3 = locF3 * 0.70 + vTarget.f3 * 0.30
          segBurst.av = ((st.voiced || intervocalicAlveolar) && nextBase !== "SIL" && !nextIsObstruentOrNasal && !nextIsStop && !whisperMode) ? (base === "JH" ? 0.70 : 0.48) : 0.0
          segBurst.af = st.burstAf * crispness * (intervocalicAlveolar ? 0.45 : (nextIsStop ? 0.48 : (nextIsObstruentOrNasal ? 0.55 : (nextBase === "SIL" ? 0.72 : 1.0))))
          segBurst.ah = (st.voiced || intervocalicAlveolar || nextIsObstruentOrNasal || nextIsStop) ? 0.02 : (stressedOnset ? 0.14 : 0.08)
          segBurst.fricF1 = burstF1
          segBurst.fricB1 = st.bB1
          segBurst.fricF2 = st.bF2
          segBurst.fricB2 = st.bB2
          segBurst.fricG1 = 0.68
          segBurst.fricG2 = 0.44
          segBurst.jaw = st.jaw * 0.45 + vTarget.jaw * 0.55
          segBurst.tTip = st.tTip * 0.55 + vTarget.tTip * 0.45
          segBurst.lipR = Math.max(st.lipR, vTarget.lipR * 0.85)
          segBurst.lipC = st.lipC * 0.20
          segBurst.segShape = "burst"
          segBurst.clauseIdx = ci
          segBurst.phone = base
          segBurst.word = item.word
          segments.push(segBurst)

          let votDur = st.votMs * clusterScale * clampVal(rateScale, 0.78, 1.22)
          if (!st.voiced && !stressedOnset && base !== "CH") { votDur = 14 * clusterScale * clampVal(rateScale, 0.8, 1.2) }
          if (intervocalicAlveolar || nextIsSonorant || nextIsObstruentOrNasal) { votDur = 0 }
          if (i > 0 && prevBase === "S" && !st.voiced && isVowelPhone(nextBase)) { votDur = 9 }
          if (nextBase === "SIL") { votDur = st.voiced ? 6 : 16 }
          if (votDur >= 6) {
            let segVot = cloneSpec(vTarget)
            segVot.dur = votDur
            segVot.f1 = locF1 * 0.34 + vTarget.f1 * 0.66
            segVot.f2 = locF2 * 0.40 + vTarget.f2 * 0.60
            segVot.f3 = locF3 * 0.34 + vTarget.f3 * 0.66
            segVot.b1 = vTarget.b1 + (st.voiced ? 12 : 185)
            segVot.av = (st.voiced && nextBase !== "SIL" && !whisperMode) ? 0.88 : 0.0
            segVot.ah = st.votAh * crispness * (stressedOnset ? 1.0 : 0.55) * (nextBase === "SIL" ? 0.60 : 1.0)
            segVot.af = 0.0
            segVot.lipR = vTarget.lipR
            segVot.lipC = 0.0
            segVot.microF0 = st.voiced ? -0.01 : 0.025
            segVot.clauseIdx = ci
            segVot.phone = base
            segVot.word = item.word
            segments.push(segVot)
          }
        }
        continue
      }

      // 3. Vowels, Nasals, Liquids, Glides, Fricatives
      let spec = _PHONEME_SPECS[base] ? cloneSpec(_PHONEME_SPECS[base]) : cloneSpec(_PHONEME_SPECS["AX"])
      spec.dur = Math.max(32, spec.dur * durMult)
      spec.stress = item.stress
      spec.accentBoost = accentBoost
      spec.microF0 = microF0
      spec.clauseIdx = ci
      spec.isPhraseTail = isPhraseTailVowel

      // English dark coda [ɫ] ("male", "will", "welcome") vs clear prevocalic [l] ("lazy", "lips")
      if (base === "L") {
        if (!isVowelPhone(nextBase)) {
          spec.f1 = 425
          spec.f2 = 880
          spec.f3 = 2580
        } else {
          spec.f1 = 345
          spec.f2 = 1240
          spec.f3 = 2620
        }
      }

      // Partial onset devoicing/aspiration on sonorants after voiceless stops ([pʰl̥iːz], [kʰw̥ɪk], [tʰɹ̥iː])
      let isSonorant = (base === "L" || base === "R" || base === "W" || base === "Y")
      if (isSonorant && (prevBase === "P" || prevBase === "T" || prevBase === "K") && !(i >= 2 && flat[i - 2].base === "S")) {
        spec.onsetDevoice = 1.0
        spec.dur = Math.max(60, spec.dur * 1.08)
      }

      if (isVowelPhone(base)) {
        spec.av = Math.min(1.0, spec.av * effortGain)
        spec.segShape = "vowel"
      } else if (spec.af > 0.02) {
        spec.af = spec.af * crispness
        spec.segShape = "fric"
      }

      if (spec.stiff < 0.75) {
        let vAdj2 = peekAdjacentVowelSpec(flat, i)
        let blend = 1.0 - spec.stiff
        spec.f1 = spec.f1 * spec.stiff + vAdj2.f1 * blend
        spec.f2 = spec.f2 * spec.stiff + vAdj2.f2 * blend
        spec.f3 = spec.f3 * spec.stiff + vAdj2.f3 * blend
        spec.jaw = spec.jaw * spec.stiff + vAdj2.jaw * blend
        spec.tH = spec.tH * spec.stiff + vAdj2.tH * blend
        spec.tF = spec.tF * spec.stiff + vAdj2.tF * blend
        spec.lipR = spec.lipR * spec.stiff + vAdj2.lipR * blend
        spec.lipS = spec.lipS * spec.stiff + vAdj2.lipS * blend
      }

      // Coarticulate sibilant/fricative constriction spectrum with adjacent vowel lip rounding!
      if (spec.af > 0.02) {
        let vRound = peekAdjacentVowelSpec(flat, i).lipR || 0.0
        let lipDarken = 1.0 - 0.16 * Math.max(spec.lipR, vRound)
        spec.fricF1 = spec.fricF1 * lipDarken
        spec.fricF2 = spec.fricF2 * lipDarken
      }

      // Anticipatory velum lowering on vowels before /m, n, ng/ (nasalizes vowel without sealing lips!)
      if (isVowelPhone(base) && (nextBase === "M" || nextBase === "N" || nextBase === "NG")) {
        spec.nasal = Math.max(spec.nasal, 0.24)
        spec.oralSeal = 0.0
        spec.velum = Math.max(spec.velum, 0.38)
      }

      spec.phone = base
      spec.word = item.word
      segments.push(spec)
    }

    // Inter-clause pause (+ subtle natural breath intake before a brand-new sentence!)
    let isSentenceBreak = (clause.punc === "." || clause.punc === "!" || clause.punc === "?") && (ci < nClauses - 1)
    let pauseMs = 150
    if (clause.punc === ",") { pauseMs = 105 }
    else if (clause.punc === ";" || clause.punc === ":") { pauseMs = 140 }
    else if (ci === nClauses - 1) { pauseMs = 95 }

    let silEnd = cloneSpec(_PHONEME_SPECS["SIL"])
    silEnd.dur = (isSentenceBreak ? 110 : pauseMs) * clampVal(rateScale, 0.82, 1.18)
    silEnd.isClosure = true
    silEnd.clauseIdx = -1
    silEnd.phone = "SIL"
    silEnd.word = ""
    segments.push(silEnd)

    if (isSentenceBreak && !whisperMode) {
      // Subtle, soft human oral breath inhalation (~65ms at -28dB) between full sentences
      let breathSeg = cloneSpec(_PHONEME_SPECS["SIL"])
      breathSeg.dur = 65
      breathSeg.f1 = 510
      breathSeg.f2 = 1490
      breathSeg.f3 = 2480
      breathSeg.b1 = 260
      breathSeg.b2 = 220
      breathSeg.ah = 0.055
      breathSeg.jaw = 0.16
      breathSeg.isClosure = true
      breathSeg.clauseIdx = -1
      breathSeg.phone = "SIL"
      breathSeg.word = ""
      segments.push(breathSeg)
    }
  }

  for (let si = 0; si < segments.length; si = si + 1) {
    if (segments[si].phone === "SIL" && segments[si].ah < 0.01) {
      let refSeg = null
      if (si + 1 < segments.length && segments[si + 1].phone !== "SIL") {
        refSeg = segments[si + 1]
      } else if (si > 0 && segments[si - 1].phone !== "SIL") {
        refSeg = segments[si - 1]
      }
      if (refSeg) {
        segments[si].f1 = refSeg.f1
        segments[si].f2 = refSeg.f2
        segments[si].f3 = refSeg.f3
      }
    }
  }

  segments._clauseMeta = clauseMeta
  return segments
}

// Convert segmental timeline into 5 ms (200 Hz) frames with Fujisaki human intonation & locus-preserving coarticulation
function rasterizeVocalFrames(segments, voiceCfg) {
  let gender = voiceCfg.gender || "male"
  let baseF0 = voiceCfg.pitchHz || (gender === "female" ? 186 : 110)
  let defaultTract = gender === "female" ? 16.0 : 17.5
  let tractCm = clampVal(voiceCfg.tractLengthCm || defaultTract, 12.2, 21.5)
  let formantScale = 17.5 / tractCm
  let f1Scale = 1.0 + (formantScale - 1.0) * (gender === "female" ? 0.88 : 0.75)
  let f2Scale = formantScale
  let f3Scale = 1.0 + (formantScale - 1.0) * 0.90

  let breathiness = clampVal(voiceCfg.breathiness !== undefined ? voiceCfg.breathiness : (gender === "female" ? 0.09 : 0.05), 0.0, 0.85)
  let baseNasality = clampVal(voiceCfg.nasality !== undefined ? voiceCfg.nasality : 0.04, 0.0, 0.80)
  let crispness = clampVal(voiceCfg.crispness !== undefined ? voiceCfg.crispness : 1.0, 0.45, 1.6)
  let expressiveness = clampVal(voiceCfg.expressiveness !== undefined ? voiceCfg.expressiveness : 1.0, 0.0, 1.8)
  let whisperMode = voiceCfg.whisper === true
  let femaleGlottalDamp = gender === "female" ? 36.0 : 0.0
  let clauseMeta = segments._clauseMeta || []

  // Pass 1: Collect per-clause timing bounds & Fujisaki syllable-accent centers (with 56% English peak delay!)
  let clauseSpans = []
  for (let c = 0; c < clauseMeta.length; c = c + 1) {
    clauseSpans.push({ startSec: -1.0, endSec: 0.0, accents: [], meta: clauseMeta[c] })
  }

  let rawFrames = []
  let maxFramesBudget = 10000
  let segCursor = 0.0

  for (let si = 0; si < segments.length; si = si + 1) {
    if (rawFrames.length >= maxFramesBudget) { break }
    let seg = segments[si]
    let nF = Math.max(1, Math.round(seg.dur / VS_FRAME_MS))
    let segDurSec = nF * (VS_FRAME_MS / 1000.0)
    let cIdx = seg.clauseIdx !== undefined ? seg.clauseIdx : -1

      if (cIdx >= 0 && cIdx < clauseSpans.length) {
        let cs = clauseSpans[cIdx]
        if (cs.startSec < 0.0) { cs.startSec = segCursor }
        cs.endSec = segCursor + segDurSec
        if (seg.accentBoost && seg.accentBoost > 0.01) {
          cs.accents.push({
            tPeak: segCursor + segDurSec * 0.54,
            amp: seg.accentBoost,
            sigma: Math.max(0.068, Math.min(0.105, segDurSec * 0.72))
          })
        }
      }

    for (let fi = 0; fi < nF; fi = fi + 1) {
      if (rawFrames.length >= maxFramesBudget) { break }
      let u = nF > 1 ? (fi / (nF - 1)) : 0.5
      let f1 = clampVal(seg.f1 * f1Scale, 200, 1180)
      let f2 = clampVal(seg.f2 * f2Scale, 540, 3250)
      let f3 = clampVal(seg.f3 * f3Scale, 1380, 4150)

      let openDamp = Math.max(0.0, (f1 - 460.0) * 0.07)
      let proxDamp = Math.max(0.0, (460.0 - (f2 - f1)) * 0.12)
      let devoiceDamp = 0.0

      let segAv = seg.av
      let segAh = seg.ah
      let segAf = seg.af
      let laxExtra = 0.0

      if (seg.onsetDevoice && seg.onsetDevoice > 0.1) {
        // Aspirated/devoiced sonorant onset after voiceless stop ([pʰl̥iːz], [kʰw̥ɪk], [tʰɹ̥iː])
        let vRamp = clampVal((u - 0.22) / 0.48, 0.0, 1.0)
        segAv = seg.av * (0.08 + 0.92 * vRamp)
        segAh = Math.max(seg.ah, (1.0 - vRamp) * 0.26 * crispness)
        laxExtra = (1.0 - vRamp) * 0.50
        devoiceDamp = (1.0 - vRamp) * 150.0
      } else if (seg.phone === "HH") {
        let hEnv = Math.sin(_PI * clampVal(u * 0.90 + 0.05, 0.0, 1.0))
        segAh = seg.ah * hEnv
        segAv = seg.av * (u * u)
        laxExtra = 0.42
      } else if (seg.segShape === "vowel" || seg.segShape === "dipA" || seg.segShape === "dipB") {
        let arch = 0.92 + 0.10 * Math.sin(_PI * clampVal(u * 0.92 + 0.05, 0.0, 1.0))
        segAv = segAv * arch
        if (seg.isPhraseTail && u > 0.55) {
          let tailFrac = (u - 0.55) / 0.45
          segAv = segAv * (1.0 - tailFrac * 0.34)
          laxExtra = tailFrac * 0.42
        }
      } else if (seg.segShape === "fric") {
        let fEnv = 0.48 + 0.62 * Math.sin(_PI * u)
        segAf = segAf * fEnv
      } else if (seg.phone === "SIL" && seg.ah > 0.01) {
        segAh = seg.ah * Math.sin(_PI * u)
      }

      let segNasal = seg.nasal || 0.0
      let segOralSeal = seg.oralSeal || 0.0
      let segFnz = seg.fnz
      let segVelum = seg.velum
      if (segAv > 0.4 && segNasal < baseNasality) {
        segNasal = baseNasality
        segVelum = Math.max(segVelum, baseNasality * 0.85)
      }

      let microDecay = (seg.microF0 || 0.0) * Math.exp(-u * 2.6)
      let estEnergy = clampVal(segAv * 0.88 + segAf * 0.58 + segAh * 0.42 + (seg.avb || 0.0) * 0.35, 0.0, 1.0)

      rawFrames.push({
        tSec: segCursor,
        clauseIdx: cIdx,
        microF0: microDecay,
        f0: baseF0,
        f1: f1,
        f2: f2,
        f3: f3,
        b1: seg.b1 * (1.0 + breathiness * 0.20) + openDamp + proxDamp + femaleGlottalDamp + devoiceDamp,
        b2: seg.b2 * (1.0 + breathiness * 0.16) + proxDamp * 0.75 + femaleGlottalDamp * 0.5,
        b3: seg.b3 * (1.0 + breathiness * 0.12) + femaleGlottalDamp * 0.3,
        av: whisperMode ? 0.0 : segAv,
        ah: whisperMode ? Math.max(segAh, segAv * 0.65) : (segAh + segAv * breathiness * 0.16),
        af: segAf,
        avb: whisperMode ? 0.0 : seg.avb,
        nasal: whisperMode ? 0.0 : segNasal,
        oralSeal: segOralSeal,
        fnz: segFnz * f1Scale,
        lax: laxExtra + (seg.stress === 0 ? 0.14 : 0.0),
        fricF1: clampVal(seg.fricF1 * (1.0 + (formantScale - 1.0) * 0.65), 600, 9500),
        fricB1: seg.fricB1 * formantScale,
        fricF2: clampVal(seg.fricF2 * (1.0 + (formantScale - 1.0) * 0.60), 1200, 10200),
        fricB2: seg.fricB2 * formantScale,
        fricG1: seg.fricG1,
        fricG2: seg.fricG2,
        isClosure: !!seg.isClosure,
        isBurst: seg.segShape === "burst",
        stress: seg.stress || 0,
        jaw: seg.jaw,
        tH: seg.tH,
        tF: seg.tF,
        tTip: seg.tTip,
        lipR: seg.lipR,
        lipS: seg.lipS,
        lipC: seg.lipC,
        velum: segVelum,
        phone: seg.phone,
        word: seg.word,
        rms: estEnergy
      })
      segCursor = segCursor + (VS_FRAME_MS / 1000.0)
    }
  }

  if (rawFrames.length === 0) { return [] }

  // Pass 2: Mean-Centered Fujisaki Phrase + Gaussian Syllable-Arch Pitch Contour!
  // Centers clause F0 around the speaker's true `baseF0` so accented syllables rise ~8-12% above baseF0
  // while unaccented/post-tonic syllables settle naturally ~4-9% below baseF0 (zero runaway +25% pitch inflation!).
  let n = rawFrames.length
  let rawLogF0 = new Float32Array(n)
  let clauseLogSum = []
  let clauseVoicedCnt = []
  for (let c = 0; c < clauseSpans.length; c = c + 1) {
    clauseLogSum.push(0.0)
    clauseVoicedCnt.push(0)
  }

  for (let i = 0; i < n; i = i + 1) {
    let fr = rawFrames[i]
    let ci = fr.clauseIdx
    if (ci >= 0 && ci < clauseSpans.length && clauseSpans[ci].endSec > clauseSpans[ci].startSec) {
      let cs = clauseSpans[ci]
      let meta = cs.meta
      let dur = Math.max(0.18, cs.endSec - cs.startSec)
      let tRel = clampVal(fr.tSec - cs.startSec, 0.0, dur)
      let posFrac = tRel / dur

      // Smooth human phrase onset arch + natural subglottal declination
      let onsetArch = 0.045 * (1.0 - Math.exp(-tRel / 0.090)) * Math.exp(-tRel / Math.max(0.45, dur * 0.75))
      let phraseLog = ((meta.isFirst ? 0.018 : 0.0) + onsetArch - 0.105 * posFrac) * expressiveness

      // Terminal boundary tones (statement fall, comma continuation rise, question rise)
      if (meta.isYesNoQuestion && posFrac > 0.60) {
        let q = (posFrac - 0.60) / 0.40
        phraseLog = phraseLog + 0.22 * q * q * expressiveness
      } else if (meta.isQuestion && posFrac > 0.70) {
        let qw = (posFrac - 0.70) / 0.30
        phraseLog = phraseLog + 0.07 * qw * expressiveness
      } else if (meta.isExclaim) {
        phraseLog = phraseLog + 0.07 * (1.0 - 0.55 * posFrac) * expressiveness
      } else if ((meta.punc === "," || meta.punc === ";" || meta.punc === ":") && posFrac > 0.72) {
        let cr = (posFrac - 0.72) / 0.28
        phraseLog = phraseLog + 0.075 * cr * cr * expressiveness
      } else if (!meta.isQuestion && posFrac > 0.78) {
        let sf = (posFrac - 0.78) / 0.22
        phraseLog = phraseLog - (meta.isLast ? 0.105 : 0.060) * sf * sf * expressiveness
      }

      // Superimpose Gaussian syllable pitch accents (smooth bell arches across tonic & post-tonic frames)
      let accLog = 0.0
      for (let ai = 0; ai < cs.accents.length; ai = ai + 1) {
        let ac = cs.accents[ai]
        let dz = (fr.tSec - ac.tPeak) / ac.sigma
        if (dz > -2.8 && dz < 2.8) {
          accLog = accLog + ac.amp * Math.exp(-0.5 * dz * dz)
        }
      }

      let totLog = phraseLog + accLog + fr.microF0
      rawLogF0[i] = totLog
      if (fr.av > 0.35) {
        clauseLogSum[ci] = clauseLogSum[ci] + totLog
        clauseVoicedCnt[ci] = clauseVoicedCnt[ci] + 1
      }
    }
  }

  let lastValidF0 = baseF0
  for (let i = 0; i < n; i = i + 1) {
    let fr = rawFrames[i]
    let ci = fr.clauseIdx
    if (ci >= 0 && ci < clauseSpans.length && clauseSpans[ci].endSec > clauseSpans[ci].startSec) {
      let meanClauseLog = clauseVoicedCnt[ci] > 0 ? (clauseLogSum[ci] / clauseVoicedCnt[ci]) : 0.0
      let centeredLog = rawLogF0[i] - meanClauseLog * 0.96
      lastValidF0 = clampVal(baseF0 * Math.exp(centeredLog), 62.0, 440.0)
      fr.f0 = lastValidF0
    } else {
      fr.f0 = lastValidF0
    }
  }

  // Pass 3: Locus-Preserving Biomechanical Coarticulation
  // Fast snap into consonant locus during silent closure; natural ~22ms forward glide into vowels;
  // gentle anticipatory lookahead that NEVER smears backward across stop bursts!
  let crispSpeed = clampVal(0.85 + crispness * 0.15, 0.75, 1.18)
  let aFormantGlide = 0.29 * crispSpeed
  let aFormantAnticipate = 0.16 * crispSpeed
  let aMouth = 0.24

  for (let i = 1; i < n; i = i + 1) {
    let p = rawFrames[i - 1]
    let c = rawFrames[i]
    let aF = c.isClosure ? 0.62 : aFormantGlide
    c.f1 = p.f1 + (c.f1 - p.f1) * aF
    c.f2 = p.f2 + (c.f2 - p.f2) * aF
    c.f3 = p.f3 + (c.f3 - p.f3) * aF
    c.fnz = p.fnz + (c.fnz - p.fnz) * 0.35
    c.jaw = p.jaw + (c.jaw - p.jaw) * aMouth
    c.tH = p.tH + (c.tH - p.tH) * aMouth
    c.tF = p.tF + (c.tF - p.tF) * aMouth
    c.tTip = p.tTip + (c.tTip - p.tTip) * 0.34
    c.lipR = p.lipR + (c.lipR - p.lipR) * aMouth
    c.lipS = p.lipS + (c.lipS - p.lipS) * aMouth
    c.lipC = p.lipC + (c.lipC - p.lipC) * 0.38
    c.velum = p.velum + (c.velum - p.velum) * aMouth

    // Soft vocal-fold adduction onset (~18ms) vs soft abduction offset (~14ms) — zero organ-pipe clicks!
    let aAv = c.av > p.av ? 0.42 : 0.48
    if (c.av > p.av + 0.08) {
      c.lax = Math.min(0.85, c.lax + (c.av - p.av) * 0.55) // gentle breathy-soft voice onset!
    }
    c.av = p.av + (c.av - p.av) * aAv
    c.ah = p.ah + (c.ah - p.ah) * 0.52
    c.lax = p.lax + (c.lax - p.lax) * 0.35

    if (c.af < 0.002 && p.af > 0.015 && c.fricG1 < 0.01) {
      c.fricF1 = p.fricF1
      c.fricB1 = p.fricB1
      c.fricF2 = p.fricF2
      c.fricB2 = p.fricB2
      c.fricG1 = p.fricG1
      c.fricG2 = p.fricG2
    }
    // Keep stop bursts crisp on onset while decaying smoothly into following vowel
    c.af = c.isBurst ? c.af : (c.af > p.af ? (p.af + (c.af - p.af) * 0.85) : (p.af + (c.af - p.af) * 0.55))
    c.avb = p.avb + (c.avb - p.avb) * 0.55
    c.nasal = p.nasal + (c.nasal - p.nasal) * 0.48
    c.oralSeal = p.oralSeal + (c.oralSeal - p.oralSeal) * 0.48
    c.rms = p.rms + (c.rms - p.rms) * 0.36
  }

  for (let i = n - 2; i >= 0; i = i - 1) {
    let nx = rawFrames[i + 1]
    let c = rawFrames[i]
    // Never smear vowel formants backward across a plosive burst or silence!
    let blockBack = nx.isBurst || nx.isClosure || c.isClosure
    let aB = blockBack ? 0.03 : aFormantAnticipate
    c.f1 = c.f1 + (nx.f1 - c.f1) * aB
    c.f2 = c.f2 + (nx.f2 - c.f2) * aB
    c.f3 = c.f3 + (nx.f3 - c.f3) * aB
    c.jaw = c.jaw + (nx.jaw - c.jaw) * aMouth
    c.tH = c.tH + (nx.tH - c.tH) * aMouth
    c.tF = c.tF + (nx.tF - c.tF) * aMouth
    c.tTip = c.tTip + (nx.tTip - c.tTip) * 0.32
    c.lipR = c.lipR + (nx.lipR - c.lipR) * aMouth
    c.lipS = c.lipS + (nx.lipS - c.lipS) * aMouth
    c.lipC = c.lipC + (nx.lipC - c.lipC) * aMouth
    c.velum = c.velum + (nx.velum - c.velum) * aMouth
  }

  // Light final smoothing on F0 so microprosody blends seamlessly into Fujisaki curve
  for (let i = 1; i < n; i = i + 1) {
    rawFrames[i].f0 = rawFrames[i - 1].f0 + (rawFrames[i].f0 - rawFrames[i - 1].f0) * 0.35
  }

  return rawFrames
}

// ---------------------------------------------------------------------------
// Unified Stateful Vocal-Tract Synthesizer (Powers Live Streaming & WAV Export)
// ---------------------------------------------------------------------------

function createSpeechStreamRenderer(frames, voiceCfg) {
  _initGlottalTables()
  let cfg = voiceCfg || {}
  let fs = VS_SAMPLE_RATE
  let invFs = 1.0 / fs
  let gender = cfg.gender || "male"
  let defaultTract = gender === "female" ? 16.0 : 17.5
  let tractCm = clampVal(cfg.tractLengthCm || defaultTract, 12.2, 21.5)
  let formantScale = 17.5 / tractCm
  let f1Scale = 1.0 + (formantScale - 1.0) * (gender === "female" ? 0.88 : 0.75)

  let breathiness = clampVal(cfg.breathiness !== undefined ? cfg.breathiness : (gender === "female" ? 0.09 : 0.05), 0.0, 0.85)
  let warmth = clampVal(cfg.warmth !== undefined ? cfg.warmth : (gender === "female" ? 0.62 : 0.56), 0.0, 1.0)
  let chestResonance = clampVal(cfg.chestResonance !== undefined ? cfg.chestResonance : (gender === "female" ? 0.48 : 0.54), 0.0, 1.0)
  let roughness = clampVal(cfg.roughness !== undefined ? cfg.roughness : 0.03, 0.0, 0.75)
  let vibrato = clampVal(cfg.vibrato !== undefined ? cfg.vibrato : 0.12, 0.0, 1.0)
  let baseRefF0 = cfg.pitchHz || (gender === "female" ? 186.0 : 110.0)

  // Higher laryngeal formants F4 (coarticulated per frame) & F5 (flesh-damped)
  let f4Base = clampVal(3460.0 * (1.0 + (formantScale - 1.0) * 0.78), 2600.0, 4950.0)
  let b4Hz = (gender === "female" ? 310.0 : 270.0) * formantScale
  let f5Hz = clampVal(4420.0 * (1.0 + (formantScale - 1.0) * 0.72), 3450.0, 6200.0)
  let b5Hz = (gender === "female" ? 450.0 : 380.0) * formantScale

  let r5 = Math.exp(-_PI * b5Hz * invFs)
  let b5c = 2.0 * r5 * Math.cos(_TAU * f5Hz * invFs)
  let c5c = -r5 * r5
  let a5c = 1.0 - b5c - c5c

  // Piriform Fossa Laryngeal Side-Branch Anti-Resonator (~4.45 kHz male / ~4.80 kHz female; Dang & Honda 1996)
  // True unity-passband pole-zero biquad notch (ZERO high-frequency FIR boost!)
  let fPirHz = clampVal((gender === "female" ? 4780.0 : 4420.0) * (1.0 + (formantScale - 1.0) * 0.50), 3800.0, 5600.0)
  let cosPir = Math.cos(_TAU * fPirHz * invFs)
  let rPirZ = 0.91
  let rPirP = 0.79
  let pirB1 = -2.0 * rPirZ * cosPir
  let pirB2 = rPirZ * rPirZ
  let pirA1 = -2.0 * rPirP * cosPir
  let pirA2 = rPirP * rPirP
  let pirNorm = (1.0 + pirA1 + pirA2) / Math.max(0.15, 1.0 + pirB1 + pirB2)

  // Soft wet-mucosa pharyngeal tissue rolloff (~4.95 kHz 2-pole lowpass on voiced cascade eliminates digital buzz!)
  let mucCutHz = gender === "female" ? 5150.0 : 4850.0
  let mucPole = Math.exp(-_TAU * mucCutHz * invFs)
  let mucGain = 1.0 - mucPole

  // Dedicated 2-Resonator Nostril Tract: FN1 (~260 Hz Helmholtz murmur) + FN2 (~1020 Hz nasal sinus)
  let fn1Hz = 260.0 * f1Scale
  let rn1 = Math.exp(-_PI * 105.0 * f1Scale * invFs)
  let bn1 = 2.0 * rn1 * Math.cos(_TAU * fn1Hz * invFs)
  let cn1 = -rn1 * rn1
  let an1 = 1.0 - bn1 - cn1

  let fn2Hz = 1020.0 * formantScale
  let rn2 = Math.exp(-_PI * 220.0 * formantScale * invFs)
  let bn2 = 2.0 * rn2 * Math.cos(_TAU * fn2Hz * invFs)
  let cn2 = -rn2 * rn2
  let an2 = 1.0 - bn2 - cn2

  // Cheek-wall low-frequency voice bar resonator (~175 Hz) for voiced stops /b, d, g, v, z/
  let fvbHz = 175.0 * f1Scale
  let rvb = Math.exp(-_PI * 72.0 * invFs)
  let bvb = 2.0 * rvb * Math.cos(_TAU * fvbHz * invFs)
  let cvb = -rvb * rvb
  let avbC = 1.0 - bvb - cvb

  // Direct Subglottal / Tracheal Chest & Fundamental H1 Body Resonator (gives rich human H1-H2 warmth!)
  let fChest = clampVal(baseRefF0 * 1.04, 86.0, 255.0)
  let bChest = clampVal(baseRefF0 * 0.62, 62.0, 155.0)
  let rCh = Math.exp(-_PI * bChest * invFs)
  let bCh = 2.0 * rCh * Math.cos(_TAU * fChest * invFs)
  let cCh = -rCh * rCh
  let aCh = 1.0 - bCh - cCh

  return {
    frames: frames || [],
    frameIdx: 0,
    tailFramesLeft: 2,
    done: !frames || frames.length === 0,
    gender: gender,
    baseRefF0: baseRefF0,
    f4Base: f4Base,
    b4Hz: b4Hz,
    a5c: a5c, b5c: b5c, c5c: c5c,
    pirB1: pirB1, pirB2: pirB2, pirA1: pirA1, pirA2: pirA2, pirNorm: pirNorm,
    mucPole: mucPole, mucGain: mucGain,
    an1: an1, bn1: bn1, cn1: cn1,
    an2: an2, bn2: bn2, cn2: cn2,
    avbC: avbC, bvb: bvb, cvb: cvb,
    aCh: aCh, bCh: bCh, cCh: cCh,
    warmth: warmth,
    breathiness: breathiness,
    hnmAirGain: (gender === "female" ? 0.085 : 0.052) + breathiness * 0.22,
    chestMix: chestResonance * (gender === "female" ? 0.52 : 0.22),
    roughness: roughness,
    vibratoDepth: vibrato * 0.014,
    // Calibrated real-time output gain (~0.55 peak, zero clipping, natural conversational loudness!)
    outGain: gender === "female" ? 0.20 : 0.19,
    glotPhase: 0.0,
    subHarmToggle: 1.0,
    fltPhase1: 0.0,
    fltPhase2: 0.27,
    fltPhase3: 0.61,
    vibPhase: 0.0,
    jitterWalk: 0.0,
    shimmerWalk: 0.0,
    rng: 0x564F4943,
    nm1_1: 0.0, nm1_2: 0.0,
    nm2_1: 0.0, nm2_2: 0.0,
    nzX1: 0.0, nzX2: 0.0,
    y1_1: 0.0, y1_2: 0.0,
    y2_1: 0.0, y2_2: 0.0,
    y3_1: 0.0, y3_2: 0.0,
    y4_1: 0.0, y4_2: 0.0,
    y5_1: 0.0, y5_2: 0.0,
    p2_1: 0.0, p2_2: 0.0,
    p3_1: 0.0, p3_2: 0.0,
    pirX1: 0.0, pirX2: 0.0, pirY1: 0.0, pirY2: 0.0,
    muc1: 0.0, muc2: 0.0,
    vb1: 0.0, vb2: 0.0,
    ch1: 0.0, ch2: 0.0,
    fr1X1: 0.0, fr1X2: 0.0, fr1Y1: 0.0, fr1Y2: 0.0,
    fr2X1: 0.0, fr2X2: 0.0, fr2Y1: 0.0, fr2Y2: 0.0,
    aspLp: 0.0, aspLp2: 0.0,
    hnmPrev: 0.0, hnmLp: 0.0,
    prevParIn: 0.0,
    prevOral: 0.0,
    roomBuf: new Float32Array(512),
    roomIdx: 0,
    dcX1: 0.0, dcY1: 0.0
  }
}

function _synthesizeFramesIntoFloat(st, frameCount, outFloat, outOffset) {
  let frames = st.frames
  let totalFrames = frames.length
  let fs = VS_SAMPLE_RATE
  let invFs = 1.0 / fs
  let egModal = _EG_MODAL
  let egWarm = _EG_WARM
  let egLax = _EG_LAX
  let ugEnv = _UG_ENV
  let ugBody = _UG_BODY
  let ugMask = _UG_SIZE - 1
  let nSubsteps = Math.floor(VS_SAMPLES_PER_FRAME / VS_SUBSTEP_SAMPLES)
  let invSubsteps = 1.0 / nSubsteps

  let glotPhase = st.glotPhase
  let subHarmToggle = st.subHarmToggle
  let fltPhase1 = st.fltPhase1
  let fltPhase2 = st.fltPhase2
  let fltPhase3 = st.fltPhase3
  let vibPhase = st.vibPhase
  let jitterWalk = st.jitterWalk
  let shimmerWalk = st.shimmerWalk
  let rng = st.rng

  let nm1_1 = st.nm1_1, nm1_2 = st.nm1_2
  let nm2_1 = st.nm2_1, nm2_2 = st.nm2_2
  let nzX1 = st.nzX1, nzX2 = st.nzX2
  let y1_1 = st.y1_1, y1_2 = st.y1_2
  let y2_1 = st.y2_1, y2_2 = st.y2_2
  let y3_1 = st.y3_1, y3_2 = st.y3_2
  let y4_1 = st.y4_1, y4_2 = st.y4_2
  let y5_1 = st.y5_1, y5_2 = st.y5_2
  let p2_1 = st.p2_1, p2_2 = st.p2_2
  let p3_1 = st.p3_1, p3_2 = st.p3_2
  let pirX1 = st.pirX1, pirX2 = st.pirX2, pirY1 = st.pirY1, pirY2 = st.pirY2
  let muc1 = st.muc1, muc2 = st.muc2
  let vb1 = st.vb1, vb2 = st.vb2
  let ch1 = st.ch1, ch2 = st.ch2
  let fr1X1 = st.fr1X1, fr1X2 = st.fr1X2, fr1Y1 = st.fr1Y1, fr1Y2 = st.fr1Y2
  let fr2X1 = st.fr2X1, fr2X2 = st.fr2X2, fr2Y1 = st.fr2Y1, fr2Y2 = st.fr2Y2
  let aspLp = st.aspLp, aspLp2 = st.aspLp2
  let hnmPrev = st.hnmPrev, hnmLp = st.hnmLp
  let prevParIn = st.prevParIn
  let prevOral = st.prevOral
  let roomBuf = st.roomBuf
  let roomIdx = st.roomIdx
  let dcX1 = st.dcX1, dcY1 = st.dcY1

  let a5c = st.a5c, b5c = st.b5c, c5c = st.c5c
  let pirB1 = st.pirB1, pirB2 = st.pirB2, pirA1 = st.pirA1, pirA2 = st.pirA2, pirNorm = st.pirNorm
  let mucPole = st.mucPole, mucGain = st.mucGain
  let an1 = st.an1, bn1 = st.bn1, cn1 = st.cn1
  let an2 = st.an2, bn2 = st.bn2, cn2 = st.cn2
  let avbC = st.avbC, bvb = st.bvb, cvb = st.cvb
  let aCh = st.aCh, bCh = st.bCh, cCh = st.cCh
  let warmth = st.warmth
  let hnmAirGain = st.hnmAirGain
  let chestMix = st.chestMix
  let roughness = st.roughness
  let vibratoDepth = st.vibratoDepth
  let outGain = st.outGain
  let f4Base = st.f4Base
  let r4 = Math.exp(-_PI * st.b4Hz * invFs)
  let c4c = -r4 * r4
  let baseRefF0 = st.baseRefF0
  let isFemale = st.gender === "female"

  let silentTailSpec = {
    f0: baseRefF0 * 0.92, f1: 500, f2: 1480, f3: 2480,
    b1: 110, b2: 130, b3: 185, fnz: 500,
    av: 0.0, ah: 0.0, af: 0.0, avb: 0.0, nasal: 0.0, oralSeal: 0.0, lax: 0.5,
    fricF1: 2000, fricB1: 1000, fricF2: 4500, fricB2: 1500,
    fricG1: 0.0, fricG2: 0.0, stress: 0, rms: 0.0
  }

  let writeIdx = outOffset
  let framesSynthesized = 0

  for (let k = 0; k < frameCount; k = k + 1) {
    let fi = st.frameIdx
    let fCur = null
    let fNext = null
    let isRealFrame = fi < totalFrames
    if (isRealFrame) {
      fCur = frames[fi]
      fNext = (fi + 1 < totalFrames) ? frames[fi + 1] : silentTailSpec
      st.frameIdx = fi + 1
    } else if (st.tailFramesLeft > 0) {
      fCur = silentTailSpec
      fNext = silentTailSpec
      st.tailFramesLeft = st.tailFramesLeft - 1
    } else {
      st.done = true
      break
    }
    framesSynthesized = framesSynthesized + 1

    let isSilentFrame = (
      fCur.av < 0.0004 && fNext.av < 0.0004 &&
      fCur.ah < 0.0004 && fNext.ah < 0.0004 &&
      fCur.af < 0.0004 && fNext.af < 0.0004 &&
      fCur.avb < 0.0004 && fNext.avb < 0.0004 &&
      Math.abs(y1_1) < 0.0001 && Math.abs(y1_2) < 0.0001 &&
      Math.abs(y2_1) < 0.0001 && Math.abs(y2_2) < 0.0001 &&
      Math.abs(muc2) < 0.0001 &&
      Math.abs(nm1_1) < 0.0001 && Math.abs(dcY1) < 0.0001
    )
    if (isSilentFrame) {
      for (let z = 0; z < VS_SAMPLES_PER_FRAME; z = z + 1) {
        outFloat[writeIdx] = 0.0
        writeIdx = writeIdx + 1
      }
      if (isRealFrame) { fCur.rms = 0.0 }
      continue
    }

    // Dynamic F4 coarticulation with tongue frontness & pitch
    let f4Dyn = clampVal(f4Base * (1.0 + 0.035 * ((fCur.f2 - 1450.0) * 0.001) + 0.020 * ((fCur.f0 - baseRefF0) / baseRefF0)), 2550.0, 5050.0)
    let b4c = 2.0 * r4 * Math.cos(_TAU * f4Dyn * invFs)
    let a4c = 1.0 - b4c - c4c

    let frameSqSum = 0.0

    for (let sub = 0; sub < nSubsteps; sub = sub + 1) {
      let alpha = sub * invSubsteps
      let f0 = fCur.f0 + (fNext.f0 - fCur.f0) * alpha
      let f1 = fCur.f1 + (fNext.f1 - fCur.f1) * alpha
      let f2 = fCur.f2 + (fNext.f2 - fCur.f2) * alpha
      let f3 = fCur.f3 + (fNext.f3 - fCur.f3) * alpha
      let b1 = fCur.b1 + (fNext.b1 - fCur.b1) * alpha
      let b2 = fCur.b2 + (fNext.b2 - fCur.b2) * alpha
      let b3 = fCur.b3 + (fNext.b3 - fCur.b3) * alpha
      let fnz = fCur.fnz + (fNext.fnz - fCur.fnz) * alpha
      let av = fCur.av + (fNext.av - fCur.av) * alpha
      let ah = fCur.ah + (fNext.ah - fCur.ah) * alpha
      let af = fCur.af + (fNext.af - fCur.af) * alpha
      let avb = fCur.avb + (fNext.avb - fCur.avb) * alpha
      let nasal = fCur.nasal + (fNext.nasal - fCur.nasal) * alpha
      let oralSeal = (fCur.oralSeal || 0.0) + ((fNext.oralSeal || 0.0) - (fCur.oralSeal || 0.0)) * alpha
      let lax = (fCur.lax || 0.0) + ((fNext.lax || 0.0) - (fCur.lax || 0.0)) * alpha

      if (f2 < f1 + 170.0) { f2 = f1 + 170.0 }
      if (f3 < f2 + 210.0) { f3 = f2 + 210.0 }
      if (f0 > 135.0) {
        let hDist = Math.abs(f1 - f0 * 2.0)
        if (hDist < 110.0) { b1 = b1 + (110.0 - hDist) * 1.15 }
      }

      let r1 = Math.exp(-_PI * b1 * invFs)
      let b1c = 2.0 * r1 * Math.cos(_TAU * f1 * invFs)
      let c1c = -r1 * r1
      let a1c = 1.0 - b1c - c1c

      let r2 = Math.exp(-_PI * b2 * invFs)
      let b2c = 2.0 * r2 * Math.cos(_TAU * f2 * invFs)
      let c2c = -r2 * r2
      let a2c = 1.0 - b2c - c2c

      let r3 = Math.exp(-_PI * b3 * invFs)
      let b3c = 2.0 * r3 * Math.cos(_TAU * f3 * invFs)
      let c3c = -r3 * r3
      let a3c = 1.0 - b3c - c3c

      // Place-specific oral side-cavity zero inside the nasal branch (distinguishes /m/ 780Hz vs /n/ 1680Hz vs /ng/ 2150Hz!)
      let rnz = Math.exp(-_PI * 240.0 * invFs)
      let nzB1 = -2.0 * rnz * Math.cos(_TAU * clampVal(fnz, 450.0, 2800.0) * invFs)
      let nzB2 = rnz * rnz
      let nzNorm = 1.0 / Math.max(0.20, 1.0 + nzB1 + nzB2)

      let hasFric = (
        af > 0.0005 ||
        Math.abs(fr1Y1) > 0.0001 || Math.abs(fr1Y2) > 0.0001 ||
        Math.abs(fr2Y1) > 0.0001 || Math.abs(fr2Y2) > 0.0001
      )
      let rf1 = 0.0, bf1 = 0.0, cf1 = 0.0, gf1 = 0.0
      let rf2 = 0.0, bf2 = 0.0, cf2 = 0.0, gf2 = 0.0
      if (hasFric) {
        let frF1 = fCur.fricF1 + (fNext.fricF1 - fCur.fricF1) * alpha
        let frB1 = fCur.fricB1 + (fNext.fricB1 - fCur.fricB1) * alpha
        let frF2 = fCur.fricF2 + (fNext.fricF2 - fCur.fricF2) * alpha
        let frB2 = fCur.fricB2 + (fNext.fricB2 - fCur.fricB2) * alpha

        rf1 = Math.exp(-_PI * frB1 * invFs)
        bf1 = 2.0 * rf1 * Math.cos(_TAU * frF1 * invFs)
        cf1 = -rf1 * rf1
        gf1 = (1.0 - rf1) * fCur.fricG1

        rf2 = Math.exp(-_PI * frB2 * invFs)
        bf2 = 2.0 * rf2 * Math.cos(_TAU * frF2 * invFs)
        cf2 = -rf2 * rf2
        gf2 = (1.0 - rf2) * fCur.fricG2
      }

      // Natural human laryngeal micro-flutter + vibrato + jitter/shimmer
      let subSec = VS_SUBSTEP_SAMPLES * invFs
      fltPhase1 = fltPhase1 + 4.3 * subSec
      if (fltPhase1 >= 1.0) { fltPhase1 = fltPhase1 - 1.0 }
      fltPhase2 = fltPhase2 + 7.1 * subSec
      if (fltPhase2 >= 1.0) { fltPhase2 = fltPhase2 - 1.0 }
      fltPhase3 = fltPhase3 + 12.7 * subSec
      if (fltPhase3 >= 1.0) { fltPhase3 = fltPhase3 - 1.0 }
      vibPhase = vibPhase + 5.2 * subSec
      if (vibPhase >= 1.0) { vibPhase = vibPhase - 1.0 }

      let flutter = 0.0052 * Math.sin(_TAU * fltPhase1) + 0.0034 * Math.sin(_TAU * fltPhase2) + 0.0020 * Math.sin(_TAU * fltPhase3)
      let vibMod = vibratoDepth * Math.sin(_TAU * vibPhase)
      rng = (rng ^ (rng << 13)) | 0
      rng = (rng ^ (rng >>> 17)) | 0
      rng = (rng ^ (rng << 5)) | 0
      let rNorm = ((rng & 0x7fffffff) * 4.65661287e-10) - 0.5
      jitterWalk = jitterWalk * 0.90 + rNorm * (0.0035 + roughness * 0.032)
      shimmerWalk = shimmerWalk * 0.90 + rNorm * (0.015 + roughness * 0.14)

      let instF0 = clampVal(f0 * (1.0 + flutter + vibMod + jitterWalk), 55.0, 520.0)
      let phaseInc = instF0 * invFs

      // Dynamic vocal-fold Open Quotient blend: modal <-> warm <-> lax with organic 4-7 Hz OQ breathing
      let oqMod = 0.08 * Math.sin(_TAU * fltPhase1) + 0.05 * Math.sin(_TAU * fltPhase2)
      let laxWeight = clampVal(lax + (1.0 - av) * 0.35, 0.0, 0.92)
      let remWeight = 1.0 - laxWeight
      let warmFrac = clampVal(warmth * (isFemale ? 0.76 : 0.64) + (fCur.stress === 1 ? -0.08 : 0.09) + oqMod, 0.05, 0.95)
      let wWarm = remWeight * warmFrac
      let wModal = remWeight * (1.0 - warmFrac)

      // Single-differentiated LF E(t) -> V(z) ALREADY has true human intrinsic vowel loudness & H1-H2 warmth!
      let voicedGain = av * (1.0 + shimmerWalk)

      // Oral output scales down smoothly when lips/tongue seal the mouth during /m, n, ng/!
      let oralOpenFactor = 1.0 - 0.85 * oralSeal
      // Subtle Klatt parallel F2 - F3 articulation presence tap (front vowels & plosive loci)
      let par2Gain = a2c * 0.085 * oralOpenFactor
      let par3Gain = a3c * 0.075 * oralOpenFactor
      let openTrachDamp = isFemale ? 0.012 : 0.008

      let needNoise = (ah > 0.0003 || av > 0.12 || hasFric)

      for (let s = 0; s < VS_SUBSTEP_SAMPLES; s = s + 1) {
        // 1. Analytical LF Glottal Derivative + Diplophonic Roughness + Subglottal Chest Body
        glotPhase = glotPhase + phaseInc
        if (glotPhase >= 1.0) {
          glotPhase = glotPhase - 1.0
          subHarmToggle = -subHarmToggle
        }

        let fIdx = glotPhase * _UG_SIZE
        let idx0 = fIdx | 0
        let frac = fIdx - idx0
        let idx1 = (idx0 + 1) & ugMask

        let eMod = egModal[idx0] + (egModal[idx1] - egModal[idx0]) * frac
        let eWrm = egWarm[idx0] + (egWarm[idx1] - egWarm[idx0]) * frac
        let eLx = egLax[idx0] + (egLax[idx1] - egLax[idx0]) * frac
        let flowEnv = ugEnv[idx0] + (ugEnv[idx1] - ugEnv[idx0]) * frac

        let creakScale = 1.0 + subHarmToggle * roughness * 0.28
        let glotExcite = (eMod * wModal + eWrm * wWarm + eLx * laxWeight) * creakScale
        let voicedSrc = glotExcite * voicedGain
        let chestIn = ugBody[idx0] * av * creakScale * 0.50

        // 2. Aerodynamic Turbulence: 2-Stage Warm Tracheal Breath (/h/, VOT) + Band-Limited HNM Chink Air
        let white = 0.0
        let aspSrc = 0.0
        let hnmSrc = 0.0
        if (needNoise) {
          rng = (rng ^ (rng << 13)) | 0
          rng = (rng ^ (rng >>> 17)) | 0
          rng = (rng ^ (rng << 5)) | 0
          let n1 = ((rng & 0xffff) * 0.000030517578125) - 1.0
          rng = (rng ^ (rng << 13)) | 0
          rng = (rng ^ (rng >>> 17)) | 0
          rng = (rng ^ (rng << 5)) | 0
          let n2 = ((rng & 0xffff) * 0.000030517578125) - 1.0
          white = (n1 + n2) * 0.5

          // 2-stage warm tracheal breath: cancels lip differentiator above ~950 Hz so /h/ & VOT never click like /k, t/!
          if (ah > 0.0003) {
            aspLp = aspLp * 0.78 + white * 0.22
            aspLp2 = aspLp2 * 0.68 + aspLp * 0.32
            let glotMod = av > 0.15 ? (0.38 + 0.62 * flowEnv) : 1.0
            aspSrc = aspLp2 * ah * glotMod * 2.35
          }

          // Band-limited (1.5-4.5 kHz) HNM glottal-chink air modulated by open glottis flow envelope
          if (av > 0.12) {
            let hiAir = white - hnmPrev * 0.84
            hnmPrev = white
            hnmLp = hnmLp * 0.44 + hiAir * 0.56
            hnmSrc = hnmLp * flowEnv * av * hnmAirGain
          }
        }

        let glotTotal = voicedSrc + aspSrc + hnmSrc

        // 3. Dedicated Nostril Nasal Branch (/m, n, ng/ & nasalized vowels — direct nostril radiation!)
        let yNostril = 0.0
        if (nasal > 0.002 || Math.abs(nm1_1) > 0.0001) {
          let nasIn = (voicedSrc + aspSrc * 0.3) * nasal
          // Place-specific oral side-cavity zero (780 Hz /m/, 1680 Hz /n/, 2150 Hz /ng/)
          let nasZero = (nasIn + nzB1 * nzX1 + nzB2 * nzX2) * nzNorm
          nzX2 = nzX1
          nzX1 = nasIn

          let yn1 = an1 * nasZero + bn1 * nm1_1 + cn1 * nm1_2
          nm1_2 = nm1_1
          nm1_1 = yn1

          let yn2 = an2 * nasZero + bn2 * nm2_1 + cn2 * nm2_2
          nm2_2 = nm2_1
          nm2_1 = yn2

          yNostril = yn1 * 0.62 + yn2 * 0.32
        }

        // 4. Oral Cavity Cascade (F1 with pitch-synchronous open-phase tracheal damping -> F2 -> F3 -> F4 -> F5)
        let y1 = (a1c * glotTotal + b1c * y1_1 + c1c * y1_2) * (1.0 - flowEnv * openTrachDamp)
        y1_2 = y1_1
        y1_1 = y1

        let y2 = a2c * y1 + b2c * y2_1 + c2c * y2_2
        y2_2 = y2_1
        y2_1 = y2

        let y3 = a3c * y2 + b3c * y3_1 + c3c * y3_2
        y3_2 = y3_1
        y3_1 = y3

        let y4 = a4c * y3 + b4c * y4_1 + c4c * y4_2
        y4_2 = y4_1
        y4_1 = y4

        let y5 = a5c * y4 + b5c * y5_1 + c5c * y5_2
        y5_2 = y5_1
        y5_1 = y5

        // Unity-passband Pole-Zero Piriform Fossa Anti-Resonator (~4.45 kHz male / ~4.78 kHz female)
        let yPir = pirNorm * (y5 + pirB1 * pirX1 + pirB2 * pirX2) - pirA1 * pirY1 - pirA2 * pirY2
        pirX2 = pirX1
        pirX1 = y5
        pirY2 = pirY1
        pirY1 = yPir

        // True +6 dB/oct Lip Radiation + Klatt Parallel F2-F3 Articulation Presence Tap
        let oralCascade = (yPir - prevOral) * 1.58 * oralOpenFactor
        prevOral = yPir

        let parDiff = glotTotal - prevParIn
        prevParIn = glotTotal
        let yp2 = par2Gain * parDiff + b2c * p2_1 + c2c * p2_2
        p2_2 = p2_1
        p2_1 = yp2
        let yp3 = par3Gain * parDiff + b3c * p3_1 + c3c * p3_2
        p3_2 = p3_1
        p3_1 = yp3

        // 2-pole wet-mucosa pharyngeal tissue rolloff (~4.9 kHz) eliminates high-frequency digital buzz!
        let oralRaw = oralCascade + (yp2 - yp3)
        muc1 = mucPole * muc1 + mucGain * oralRaw
        muc2 = mucPole * muc2 + mucGain * muc1

        // Direct Subglottal/Tracheal H1 Chest Body + Cheek-Wall Voice Bar
        let yCh = aCh * chestIn + bCh * ch1 + cCh * ch2
        ch2 = ch1
        ch1 = yCh

        let yVb = avbC * (voicedSrc * avb) + bvb * vb1 + cvb * vb2
        vb2 = vb1
        vb1 = yVb

        // 5. Mouth Constriction Frication & Plosive Bursts (generated at lips/teeth, bypassing pharyngeal mucosa LP)
        let fricOut = 0.0
        if (hasFric) {
          let fricMod = av > 0.2 ? (0.56 + 0.44 * flowEnv) : 1.0
          let frIn = white * af * fricMod

          let yFr1 = gf1 * (frIn - rf1 * fr1X2) + bf1 * fr1Y1 + cf1 * fr1Y2
          fr1X2 = fr1X1
          fr1X1 = frIn
          fr1Y2 = fr1Y1
          fr1Y1 = yFr1

          let yFr2 = gf2 * (frIn - rf2 * fr2X2) + bf2 * fr2Y1 + cf2 * fr2Y2
          fr2X2 = fr2X1
          fr2X1 = frIn
          fr2Y2 = fr2Y1
          fr2Y1 = yFr2

          fricOut = (yFr1 + yFr2) * 2.10
        }

        let dry = muc2 + yCh * chestMix + yNostril * 0.54 + yVb * 0.15 + fricOut
        let rTap1 = roomBuf[(roomIdx - 203) & 511]
        let rTap2 = roomBuf[(roomIdx - 347) & 511]
        roomBuf[roomIdx] = dry
        roomIdx = (roomIdx + 1) & 511
        let studioSig = dry + rTap1 * 0.044 - rTap2 * 0.025

        let clean = studioSig - dcX1 + 0.993 * dcY1
        dcX1 = studioSig
        dcY1 = clean

        let v = clean * outGain
        if (v > 0.72) {
          let ex = v - 0.72
          v = 0.72 + 0.24 * (ex / (0.28 + ex))
        } else if (v < -0.72) {
          let ex = -v - 0.72
          v = -0.72 - 0.24 * (ex / (0.28 + ex))
        }

        outFloat[writeIdx] = v
        writeIdx = writeIdx + 1
        frameSqSum = frameSqSum + v * v
      }
    }

    if (isRealFrame) {
      let rawRms = Math.sqrt(frameSqSum / VS_SAMPLES_PER_FRAME)
      fCur.rms = clampVal(rawRms * 3.1, 0.0, 1.0)
    }
  }

  if (st.frameIdx >= totalFrames && st.tailFramesLeft <= 0) {
    st.done = true
  }

  st.glotPhase = glotPhase
  st.subHarmToggle = subHarmToggle
  st.fltPhase1 = fltPhase1
  st.fltPhase2 = fltPhase2
  st.fltPhase3 = fltPhase3
  st.vibPhase = vibPhase
  st.jitterWalk = jitterWalk
  st.shimmerWalk = shimmerWalk
  st.rng = rng
  st.nm1_1 = nm1_1; st.nm1_2 = nm1_2
  st.nm2_1 = nm2_1; st.nm2_2 = nm2_2
  st.nzX1 = nzX1; st.nzX2 = nzX2
  st.y1_1 = y1_1; st.y1_2 = y1_2
  st.y2_1 = y2_1; st.y2_2 = y2_2
  st.y3_1 = y3_1; st.y3_2 = y3_2
  st.y4_1 = y4_1; st.y4_2 = y4_2
  st.y5_1 = y5_1; st.y5_2 = y5_2
  st.p2_1 = p2_1; st.p2_2 = p2_2
  st.p3_1 = p3_1; st.p3_2 = p3_2
  st.pirX1 = pirX1; st.pirX2 = pirX2; st.pirY1 = pirY1; st.pirY2 = pirY2
  st.muc1 = muc1; st.muc2 = muc2
  st.vb1 = vb1; st.vb2 = vb2
  st.ch1 = ch1; st.ch2 = ch2
  st.fr1X1 = fr1X1; st.fr1X2 = fr1X2; st.fr1Y1 = fr1Y1; st.fr1Y2 = fr1Y2
  st.fr2X1 = fr2X1; st.fr2X2 = fr2X2; st.fr2Y1 = fr2Y1; st.fr2Y2 = fr2Y2
  st.aspLp = aspLp; st.aspLp2 = aspLp2
  st.hnmPrev = hnmPrev; st.hnmLp = hnmLp
  st.prevParIn = prevParIn
  st.prevOral = prevOral
  st.roomIdx = roomIdx
  st.dcX1 = dcX1; st.dcY1 = dcY1

  return framesSynthesized * VS_SAMPLES_PER_FRAME
}

// Real-time streaming pull (~25-45 ms per call = < 0.35M Zipp instructions -> zero main-thread freeze!)
function renderSpeechStreamBlock(st, wantSamples, streamRate) {
  if (!st || st.done) {
    return null
  }
  let target24k = Math.round((wantSamples || 600) * (VS_SAMPLE_RATE / (streamRate || VS_SAMPLE_RATE)))
  let wantVocalFrames = clampVal(Math.ceil(target24k / VS_SAMPLES_PER_FRAME), 3, 12)
  let maxSamples = wantVocalFrames * VS_SAMPLES_PER_FRAME
  let f32 = new Float32Array(maxSamples)
  let actualSamples = _synthesizeFramesIntoFloat(st, wantVocalFrames, f32, 0)
  if (actualSamples <= 0) {
    st.done = true
    return null
  }

  let i16 = new Int16Array(actualSamples)
  for (let i = 0; i < actualSamples; i = i + 1) {
    let s = f32[i]
    if (s > 0.98) { s = 0.98 }
    else if (s < -0.98) { s = -0.98 }
    i16[i] = s < 0.0 ? ((s * 32768.0) | 0) : ((s * 32767.0) | 0)
  }
  let bytes = new Uint8Array(i16.buffer)
  return {
    pcm: bytesToBase64Compat(bytes),
    frames: actualSamples,
    rate: VS_SAMPLE_RATE,
    channels: 1,
    format: "i16"
  }
}

// Offline full-utterance Float32 PCM synthesis (used by Export WAV & automated acoustic/ASR tests)
function renderVocalTractPcm(frames, voiceCfg) {
  if (!frames || frames.length === 0) {
    return new Float32Array(0)
  }
  let st = createSpeechStreamRenderer(frames, voiceCfg)
  let totalSamples = frames.length * VS_SAMPLES_PER_FRAME
  let pcm = new Float32Array(totalSamples)
  _synthesizeFramesIntoFloat(st, frames.length, pcm, 0)

  let peakAbs = 0.001
  for (let i = 0; i < totalSamples; i = i + 1) {
    let a = pcm[i] < 0.0 ? -pcm[i] : pcm[i]
    if (a > peakAbs) { peakAbs = a }
  }
  let targetPeak = 0.86
  let gain = peakAbs > 0.001 ? clampVal(targetPeak / peakAbs, 0.65, 3.2) : 1.0
  let fadeSamples = totalSamples > 576 ? 144 : Math.floor(totalSamples * 0.25)
  let tailStart = totalSamples - fadeSamples
  let invFade = fadeSamples > 0 ? (1.0 / fadeSamples) : 1.0

  for (let i = 0; i < totalSamples; i = i + 1) {
    let g = gain
    if (i < fadeSamples) { g = gain * (i * invFade) }
    else if (i > tailStart) { g = gain * ((totalSamples - i) * invFade) }
    let v = pcm[i] * g
    if (v > 0.96) { v = 0.96 }
    else if (v < -0.96) { v = -0.96 }
    pcm[i] = v
  }

  let maxRms = 0.001
  for (let fi = 0; fi < frames.length; fi = fi + 1) {
    if (frames[fi].rms > maxRms) { maxRms = frames[fi].rms }
  }
  let invMaxRms = 1.0 / maxRms
  for (let fi = 0; fi < frames.length; fi = fi + 1) {
    frames[fi].rms = clampVal(frames[fi].rms * invMaxRms, 0.0, 1.0)
  }

  return pcm
}

function synthesizeSpeechUtterance(text, voiceCfg) {
  let cfg = voiceCfg || {}
  let plan = textToUtterancePlan(text)
  if (!plan.words || plan.words.length === 0) {
    return {
      ok: false,
      pcm: new Float32Array(0),
      sampleRate: VS_SAMPLE_RATE,
      durationSec: 0,
      frames: [],
      ipa: "",
      normalized: ""
    }
  }
  let segments = buildAcousticTimeline(plan, cfg)
  let frames = rasterizeVocalFrames(segments, cfg)
  let pcm = renderVocalTractPcm(frames, cfg)
  return {
    ok: pcm.length > 0,
    pcm: pcm,
    sampleRate: VS_SAMPLE_RATE,
    durationSec: pcm.length / VS_SAMPLE_RATE,
    frames: frames,
    ipa: plan.ipaString,
    normalized: plan.normalized,
    words: plan.words
  }
}

// ---------------------------------------------------------------------------
// WAV Encoding & Waveform Utilities (Fast Direct Int16 Buffer Packing)
// ---------------------------------------------------------------------------

let _B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

function bytesToBase64Compat(bytes) {
  if (bytes && typeof bytes.toBase64 === "function") {
    return bytes.toBase64()
  }
  let chunks = []
  let len = bytes.length
  let i = 0
  while (i < len) {
    let b0 = bytes[i]
    let b1 = i + 1 < len ? bytes[i + 1] : 0
    let b2 = i + 2 < len ? bytes[i + 2] : 0
    chunks.push(
      _B64_CHARS.charAt(b0 >>> 2) +
      _B64_CHARS.charAt(((b0 & 3) << 4) | (b1 >>> 4)) +
      (i + 1 < len ? _B64_CHARS.charAt(((b1 & 15) << 2) | (b2 >>> 6)) : "=") +
      (i + 2 < len ? _B64_CHARS.charAt(b2 & 63) : "=")
    )
    i = i + 3
  }
  return chunks.join("")
}

function pcmFloatToWavBytes(pcm, sampleRate) {
  let n = pcm.length
  let dataBytes = n * 2
  let total = 44 + dataBytes
  let buf = new Uint8Array(total)
  let view = new DataView(buf.buffer)

  buf[0] = 82; buf[1] = 73; buf[2] = 70; buf[3] = 70
  view.setUint32(4, 36 + dataBytes, true)
  buf[8] = 87; buf[9] = 65; buf[10] = 86; buf[11] = 69
  buf[12] = 102; buf[13] = 109; buf[14] = 116; buf[15] = 32
  view.setUint32(16, 16, true)
  view.setUint16(20, 1, true)
  view.setUint16(22, 1, true)
  view.setUint32(24, sampleRate, true)
  view.setUint32(28, sampleRate * 2, true)
  view.setUint16(32, 2, true)
  view.setUint16(34, 16, true)
  buf[36] = 100; buf[37] = 97; buf[38] = 116; buf[39] = 97
  view.setUint32(40, dataBytes, true)

  let i16 = new Int16Array(buf.buffer, 44, n)
  for (let i = 0; i < n; i = i + 1) {
    let s = pcm[i]
    if (s > 1.0) { s = 1.0 }
    else if (s < -1.0) { s = -1.0 }
    i16[i] = s < 0.0 ? ((s * 32768.0) | 0) : ((s * 32767.0) | 0)
  }
  return buf
}

function pcmFloatToWavDataUrl(pcm, sampleRate) {
  let bytes = pcmFloatToWavBytes(pcm, sampleRate)
  return "data:audio/wav;base64," + bytesToBase64Compat(bytes)
}

function buildWaveformBars(pcm, count) {
  let bars = []
  if (!pcm || pcm.length === 0) {
    for (let i = 0; i < count; i = i + 1) { bars.push(6) }
    return bars
  }
  let step = Math.max(1, Math.floor(pcm.length / count))
  for (let i = 0; i < count; i = i + 1) {
    let start = i * step
    let end = Math.min(pcm.length, start + step)
    let peak = 0.0
    for (let j = start; j < end; j = j + 8) {
      let a = pcm[j]
      if (a < 0.0) { a = -a }
      if (a > peak) { peak = a }
    }
    if (peak > 1.0) { peak = 1.0 }
    bars.push(Math.round(6 + peak * 34))
  }
  return bars
}

function buildWaveformBarsFromFrames(frames, count) {
  let bars = []
  if (!frames || frames.length === 0) {
    for (let i = 0; i < count; i = i + 1) { bars.push(6) }
    return bars
  }
  let n = frames.length
  for (let i = 0; i < count; i = i + 1) {
    let start = Math.floor((i * n) / count)
    let end = Math.max(start + 1, Math.floor(((i + 1) * n) / count))
    let peak = 0.0
    for (let j = start; j < end && j < n; j = j + 1) {
      let e = frames[j].rms || frames[j].av || 0.0
      if (e > peak) { peak = e }
    }
    if (peak > 1.0) { peak = 1.0 }
    bars.push(Math.round(6 + peak * 30))
  }
  return bars
}
