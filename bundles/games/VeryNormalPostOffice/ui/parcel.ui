<div className="parcel-host" style={V.parcelStyle}>
#each (slot in V.slots)
 <Draggable disabled={V.dragDisabled} className="parcel-drag" @dragstart={startDrag} @dragend={endDrag}>
  <button className={V.cartonClass} aria-label={"Inspect " + V.serial + ". " + V.witness} disabled={V.toolsDisabled} @click={parcelClick}>
   <span className="carton-shadow">
</span>
<span className="carton-top">
</span>
<span className="carton-side">
</span>
<span className="carton-front">
</span>
<span className="packing-tape">
</span>
   <span if={V.nested} className="nested-box nested-one">
</span>
<span if={V.nested && V.nestedLayers > 1} className="nested-box nested-two">
</span>
   <span if={V.face === 0} className={V.labelClass}>
<small>MUNICIPAL POST / {V.serial}</small>
<strong>{V.labelDamaged ? "ADDRESS MISSING" : (V.hasParcel ? S.current.recipient : "")}</strong>
<span>{V.labelDamaged ? "[paper has been eaten]" : (V.hasParcel ? S.current.street : "")}</span>
<b>{V.labelDamaged ? "?? / ??" : (V.hasParcel ? S.current.printedDistrict : "")}</b>
<span className="label-bottom">
<i>{V.labelPrefix}</i>
<span className="barcode">
</span>
</span>
</span>
   <span if={V.face === 1} className="rear-label">
<small>DO NOT BREAK SEAL<br />WITHOUT OBSERVATION</small>
<span className="flap-tab">
</span>
<b>{V.rearSeal}</b>
<span>{V.fed ? "BISCUIT ACCEPTED" : "CONTENTS NOT CERTIFIED"}</span>
</span>
   <span if={V.face === 2} className="base-label">
<small>PERMANENT CONSIGNMENT MARK</small>
<b>{V.baseCode}</b>
<span className="barcode">
</span>
<strong>{V.baseDimensions}</strong>
<span className="permit-mark">{V.nested ? "▣ NESTED / SAFE FLAP" : V.basePermit}</span>
</span>
   <span if={V.nested && V.nestedLayers === 0} className="core-window">
<i className="miniature-window">
</i>
<b className="miniature-desk">
<i>
</i>
</b>
<small>WINDOW 04</small>
</span>
   <span className={V.stampClass}>INSPECTED<small>M.P.O. / WINDOW 04</small>
</span>
   <span if={V.actualType === "hungry"} className="parcel-mouth">
<i className="upper-teeth">
</i>
<i className="lower-teeth">
</i>
<b className="tongue">
</b>
</span>
   <span if={V.actualType === "bees"} className="air-holes">•••</span>
   <span if={V.actualType === "bees"} className="bee bee-one">
</span>
<span if={V.actualType === "bees"} className="bee bee-two">
</span>
<span if={V.actualType === "bees"} className="bee bee-three">
</span>
   <span if={V.actualType === "whisper"} className="whisper-evidence">p s s t<span>p s s t</span>
</span>
   <span if={V.actualType === "runner"} className="runner-foot foot-one">
</span>
<span if={V.actualType === "runner"} className="runner-foot foot-two">
</span>
   <span if={V.actualType === "portal"} className="portal-seam">
<i>
</i>
<b>
</b>
</span>
   <span if={V.actualType === "teleport"} className="displaced-outline outline-one">
</span>
<span if={V.actualType === "teleport"} className="displaced-outline outline-two">
</span>
   <span if={V.clamp} className="clamp-strap strap-one">
</span>
<span if={V.clamp} className="clamp-strap strap-two">
</span>
   <span if={V.xrayActive} className={"radiograph ray-" + V.actualType}>
<span className="ray-object object-one">
</span>
<span className="ray-object object-two">
</span>
<span className="ray-object object-three">
</span>
<span className="ray-object object-four">
</span>
<span className="ray-ring">
</span>
<strong>{V.nested ? "▣" : ""}</strong>
</span>
  </button>
 </Draggable>
#end
</div>
