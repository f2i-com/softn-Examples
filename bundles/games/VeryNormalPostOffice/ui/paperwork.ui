<aside className="paperwork-column" aria-label="Inspection paperwork and postal handbook">
 <div className="intake-clipboard">
<i className="clipboard-clip">
</i>
<div className="intake-sheet">
<p className="form-number">FORM 04 / INTAKE RECORD</p>
<div className="form-title">
<h2>Consignment</h2>
<span>{V.serial}</span>
</div>
<div className="address-transcript">
<strong>{V.recipient}</strong>
<span>{V.street}</span>
<b>{V.district}</b>
</div>
  <dl className="evidence-list">
#each (line in V.evidence)
<div className={line.ready ? "evidence-row recorded" : "evidence-row"}>
<dt>{line.label}</dt>
<dd>{line.value}</dd>
</div>
#end
</dl>
  <p className="witness-note">
<span>CLERK'S OBSERVATION</span>{V.witness}</p>
 </div>
</div>
 <button className="handbook-cover" @click={openBook("today")} disabled={V.overlay}>
<span className="book-spine">
</span>
<small>MUNICIPAL POSTAL SERVICE</small>
<strong>THE POSTAL<br />HANDBOOK</strong>
<i>REGULATIONS &amp; OTHER<br />NEGOTIABLE REALITIES</i>
<span className="book-edition">EDITION 04 <b>OPEN / H ↗</b>
</span>
</button>
 <div className="pinned-circular">
<i className="pin">
</i>
<span className="circular-number">{"CIRCULAR " + (V.stageNumber * 10 + V.revision) + " / " + V.day}</span>
<p>{V.circular}</p>
<button className="paper-link" @click={openBook("directory")} disabled={V.overlay}>Consult district directory →</button>
</div>
 <div className="shift-ledger">
<span className="form-number">OUTGOING REGISTER</span>
<div className="ledger-cases">
#each (entry in V.circles)
<span className={entry.className}>{entry.label}</span>
#end
</div>
<div className="ledger-total">
<span>PARCEL {V.progress}<small>NO COUNTDOWN / INSPECT AT YOUR PACE</small>
</span>
<strong>{V.score}<small>MERIT POINTS</small>
</strong>
</div>
<div className="integrity-label">
<span>DESK INTEGRITY</span>
<b>{V.integrity + "%"}</b>
</div>
<div className="integrity-track">
<span style={V.integrityStyle}>
</span>
</div>
</div>
</aside>
