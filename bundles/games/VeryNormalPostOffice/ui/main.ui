@media(prefers-reduced-motion:reduce) {
  .po-root:not(.motion-full) * {
    animation:none!important;
    transition:none!important
  }
}
/* Physical finishing details and thumb-accessible reference tab. */
.carton.turning {
  animation:po-turn .32s ease-out
}
.type-infinite {
  transition:transform .5s ease
}
.type-infinite.nest-depth-1 {
  transform:scale(.83)
}
.type-infinite.nest-depth-0 {
  transform:scale(.63)
}
.type-infinite.nest-depth-0 .nested-box {
  display:none
}
.type-infinite.nest-depth-0 .carton-shadow {
  width:340%;
  left:-110%;
  height:70%;
  filter:blur(2px)
}
.core-window {
  position:absolute;
  inset:25px 28px 22px;
  background:#213f36;
  border:4px solid #536d59;
  z-index:14;
  box-shadow:inset 0 0 18px #081a14
}
.core-window>small {
  position:absolute;
  bottom:5px;
  left:0;
  right:0;
  text-align:center;
  font:9px 'Courier New',monospace;
  color:#d5cb9c
}
.miniature-window {
  position:absolute;
  left:24%;
  top:12%;
  width:54%;
  height:37%;
  background:linear-gradient(90deg,transparent 45%,#6d877550 45%,#6d877550 51%,transparent 51%),#14332b;
  border:3px solid #738774
}
.miniature-desk {
  position:absolute;
  left:14%;
  right:14%;
  height:32%;
  bottom:21%;
  background:#8b9776;
  border-top:5px solid #b9b091;
  box-shadow:0 6px 0 #324f3e
}
.miniature-desk>i {
  position:absolute;
  width:28%;
  height:75%;
  background:#bca171;
  border:2px solid #756749;
  left:36%;
  top:-60%;
  transform:rotate(-4deg)
}
.temporal-disturbance .fluorescent {
  animation:po-power-dip 3.8s ease-in-out infinite
}
.final-delivery {
  display:flex;
  gap:18px;
  align-items:center;
  border-top:1px dashed #9a9978;
  border-bottom:1px dashed #9a9978;
  padding:18px 0;
  margin:16px 0
}
.miniature-office {
  position:relative;
  width:160px;
  height:122px;
  flex-shrink:0;
  background:#3d5949;
  border:8px solid #928363;
  box-shadow:4px 5px 0 #4a493535;
  transform:rotate(-3deg)
}
.miniature-office>small {
  position:absolute;
  bottom:2px;
  left:0;
  right:0;
  font:8px 'Courier New',monospace;
  text-align:center;
  color:#d8d7b3
}
.final-letter {
  padding:14px 16px;
  background:#f2e9cd;
  box-shadow:2px 3px 0 #93876845;
  transform:rotate(2deg)
}
.final-letter>small,.final-letter>span {
  display:block;
  font:8px/1.5 'Courier New',monospace
}
.final-letter>strong {
  display:block;
  font:italic 19px/1.3 Georgia,serif;
  margin:7px 0 10px
}
.touch-handbook-tab {
  display:none
}
@keyframes po-turn {
  0% {
    transform:perspective(600px) rotateY(-24deg) rotateZ(5deg)
  }
  100% {
    transform:perspective(600px) rotateY(0) rotateZ(0)
  }
}
@keyframes po-power-dip {
  0%,68%,82%,100% {
    opacity:1;
    box-shadow:0 6px 26px #f1f4bf70
  }
  74% {
    opacity:.34;
    box-shadow:none
  }
}
@media(max-width:850px) {
  .touch-handbook-tab {
    display:block;
    position:static;
    margin:10px 12px 6px auto;
    z-index:2;
    min-height:44px;
    padding:10px 15px;
    background:#ded2a9;
    border:2px solid #95845d;
    box-shadow:0 3px 8px #10291c60;
    font:bold 11px 'Courier New',monospace!important
  }
  .final-delivery {
    gap:10px
  }
  .miniature-office {
    width:105px;
    height:105px
  }
  .final-letter {
    padding:10px
  }
  .final-letter>strong {
    font-size:16px
  }
}
/* This rule stays last so newly added motion also respects both preferences. */
.po-root.reduced-motion *,.po-root.reduced-motion *::before,.po-root.reduced-motion *::after {
  animation:none!important;
  transition:none!important
}
@media(prefers-reduced-motion:reduce) {
  .po-root *,.po-root *::before,.po-root *::after {
    animation:none!important;
    transition:none!important
  }
}


/* MOBILE EDITION START */
/* Mobile edition: compact desk, persistent tools and readable paperwork. */
.po-root button {touch-action:manipulation;}
.po-root .reference-weight,.po-root .zero-knob,.po-root .paper-link {min-width:44px!important;min-height:44px!important;}
.po-root .scale-pan {min-height:44px;}
.po-root .small-switch,.po-root .ink-pad,.po-root .cal-weight,.po-root .zero-button,.po-root .admit-button {min-width:44px!important;min-height:44px!important;}
@media(min-width:851px) and (max-height:860px) {
 .po-root .po-scroll {padding:8px 14px;}
 .po-root .office-mast {padding:8px 18px;}
 .po-root .back-office {height:96px;}
 .po-root .shift-docket {top:8px;min-height:78px;padding:7px 12px 6px;}
 .po-root .observation-window {height:78px;bottom:6px;}
 .po-root .scene-shell {padding:10px 14px;}
 .po-root .conveyor-strip {height:58px;}
 .po-root .waiting-box {top:4px;height:36px;}
 .po-root .separator-button,.po-root .jam-lever {top:4px;min-height:44px;padding:6px 8px 4px 28px;}
 .po-root .worktop {height:325px;}
 .po-root .drag-hint {bottom:4px;}
 .po-root .face-caption {bottom:20px;}
 .po-root .instrument-shelf {min-height:78px;padding:6px 8px;}
 .po-root .tool-key {min-height:58px;}
 .po-root .stamp-shelf {height:92px;padding:8px 13px;}
}
@media(max-width:850px) {
 .po-root .po-scroll {padding:8px 8px max(16px,env(safe-area-inset-bottom));}
 .po-root .office-mast {padding:8px 12px;gap:8px;}
 .po-root .tool-controls {position:static;background:transparent;padding:0;border:0;box-shadow:none;}
 .po-root .tool-key {font-size:12px!important;min-height:50px;}
 .po-root .tool-key kbd {display:none;}
 .po-root .small-switch {font-size:11px!important;}
 .po-root .tool-key span {font-size:10px!important;padding-right:0!important;}
 .po-root .evidence-row dt {font-size:11px;}
 .po-root .paperwork-column {gap:12px;}
 .po-root .scale-pan {min-height:44px;}
 .po-root .modal,.po-root .handbook-modal {overscroll-behavior:contain;}
}
@media(max-width:560px) {
 .po-root .po-scroll {padding:5px 5px max(16px,env(safe-area-inset-bottom));}
 .po-root .office-mast {padding:7px 9px;gap:6px;}
 .po-root .office-mast h1 {font-size:17px;}
 .po-root .postal-emblem {width:36px;height:36px;font-size:24px;line-height:19px;padding-top:3px;}
 .po-root .back-office {height:74px;}
 .po-root .shift-docket {min-height:60px;top:5px;padding:5px 8px;}
 .po-root .shift-docket h2 {font-size:14px;margin:2px 0;}
 .po-root .observation-window {height:60px;bottom:5px;}
 .po-root .scene-shell {padding:6px;}
 .po-root .desk-layout {gap:10px;}
 .po-root .conveyor-strip {height:58px;}
 .po-root .waiting-box {top:8px;height:30px;}
 .po-root .separator-button,.po-root .jam-lever {top:4px;min-height:44px;padding:5px 4px 4px 20px;}
 .po-root .worktop {height:316px;}
 .po-root .drag-hint {bottom:4px;}
 .po-root .face-caption {bottom:20px;}
 .po-root .instrument-shelf {padding:6px;gap:6px;}
 .po-root .scanner-display {height:50px;min-height:50px;padding:4px 9px;}
 .po-root .route-cage {min-height:94px;}
 .po-root .brass-plate {top:25px;}
 .po-root .handbook-cover {min-height:116px;padding-top:12px;padding-bottom:12px;}
 .po-root .handbook-cover>strong {font-size:22px;}
 .po-root .tool-controls {gap:4px;}
 .po-root .tool-key {padding:4px 2px;}
 .po-root .tool-key>b {font-size:19px;margin-bottom:3px;}
}
@media(max-height:520px) {
 .po-root .po-scroll {padding:4px 8px;}
 .po-root .office-mast {flex-wrap:nowrap;padding:4px 10px;gap:8px;}
 .po-root .department-brand {width:auto;}
 .po-root .postal-emblem {width:30px;height:30px;font-size:19px;line-height:16px;padding-top:2px;}
 .po-root .office-mast h1 {font-size:15px;}
 .po-root .office-mast .eyebrow {display:none;}
 .po-root .small-switch {min-height:36px!important;min-width:36px!important;padding:4px 8px;font-size:10px!important;}
 .po-root .back-office {display:none;}
 .po-root .scene-shell {padding:6px;}
 .po-root .desk-layout {display:grid;grid-template-columns:minmax(0,1fr) 235px;gap:10px;}
 .po-root .conveyor-strip {height:50px;border-width:3px;}
 .po-root .separator-button,.po-root .jam-lever {top:3px;min-height:38px;padding:4px 4px 3px 20px;font-size:8px!important;}
 .po-root .separator-button small,.po-root .jam-lever small {display:none;}
 .po-root .worktop {height:220px;border-width:3px;}
 .po-root .inspection-mat {top:32px;height:152px;}
 .po-root .scale-station {top:90px;transform:scale(0.78);transform-origin:top center;}
 .po-root .xray-cabinet {top:24px;transform:scale(0.78);transform-origin:top center;}
 .po-root .parcel-host {transform:scale(0.78);transform-origin:top center;}
 .po-root .paperwork-column {display:flex;flex-direction:column;gap:8px;}
 .po-root .intake-clipboard {grid-row:auto;}
 .po-root .handbook-cover,.po-root .pinned-circular,.po-root .shift-ledger {min-height:0;}
 .po-root .touch-handbook-tab {margin:8px 10px 4px auto;}
}

/* MOBILE EDITION END */
</style>
<main className={V.rootClass}>
 <div className="po-scroll">
  <div className="postal-facility" inert={V.overlay}>
   <Office />
   <fieldset className="scene-shell" disabled={V.overlay} aria-label="Inspection desk">
    <div className="desk-layout"><Desk /><Paperwork /></div>
   </fieldset>
   <button if={!V.overlay} className="touch-handbook-tab" @click={openBook("today")}>HANDBOOK ↗</button>
   <footer className="facility-footer"><span>WINDOW 04 / THE MAIL HAS RIGHTS. YOU HAVE A STAMP.</span><span>{V.saveStatus}</span></footer>
  </div>
 </div>
 <Handbook /><Screens />
 <Loop interval={50} running={S.phase === "work" && !paused && !bookOpen && !helpOpen && !confirmReset} @tick={tick} />
</main>
