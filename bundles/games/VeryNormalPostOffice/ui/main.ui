<logic src="../logic/main.logic" />
<import Office from="./office.ui" />
<import Desk from="./desk.ui" />
<import Paperwork from="./paperwork.ui" />
<import Handbook from="./handbook.ui" />
<import Screens from="./screens.ui" />
<style>
/* The entire municipal scene is local CSS geometry. No external fonts or textures. */
.po-root {
  --paper:#e4dac0;
  --paper-light:#f0e7d0;
  --ink:#29362f;
  --faded:#87928a;
  --red:#a94e3d;
  --green:#31554e;
  --brass:#c6ad73;
  --desk:#68746b;
  color:var(--ink);
  background:#182725;
  height:100%;
  min-height:0;
  padding:0;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  font-family:Arial,Helvetica,sans-serif;
  font-size:13px;
  line-height:1.5;
  position:relative;
  color-scheme:light
}
.po-scroll {
  flex:1 1 0;
  min-height:0;
  overflow-y:auto;
  overflow-x:hidden;
  overscroll-behavior:contain;
  padding:14px 18px max(18px,env(safe-area-inset-bottom));
  -webkit-overflow-scrolling:touch
}
.po-root *,.po-root *:before,.po-root *:after {
  box-sizing:border-box
}
.po-root button,.po-root input {
  font:inherit
}
.po-root button {
  cursor:pointer;
  touch-action:manipulation
}
.po-root button:disabled {
  cursor:default
}
.po-root button:focus-visible {
  outline:3px solid #f2ce73;
  outline-offset:4px
}
.po-root p,.po-root h1,.po-root h2,.po-root h3,.po-root dl,.po-root dd {
  margin:0
}
.po-root button {
  color:inherit
}
.po-root kbd {
  font-family:'Courier New',monospace
}
.po-root .hidden {
  display:none!important
}
.postal-facility {
  max-width:1500px;
  margin:0 auto;
  background:#34463f;
  border:1px solid #64716a;
  box-shadow:0 18px 70px #0008;
  overflow:clip
}
.eyebrow,.form-number {
  font:10px/1.45 'Courier New',monospace;
  letter-spacing:1.4px
}
.office-mast {
  padding:17px 24px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
  background:#253c35;
  border-bottom:2px solid #a59d7a;
  color:#e5dcc1
}
.department-brand {
  display:flex;
  gap:13px;
  align-items:center
}
.office-mast h1 {
  font:700 clamp(17px,1.8vw,26px)/1.3 Georgia,serif;
  letter-spacing:1.2px
}
.office-mast .eyebrow {
  font-size:9px;
  color:#b6c2af;
  margin-bottom:3px
}
.postal-emblem {
  font:bold 32px/25px Georgia,serif;
  width:46px;
  height:45px;
  border:1px solid #ada98a;
  display:block;
  text-align:center;
  padding-top:5px;
  position:relative
}
.postal-emblem>span {
  display:block;
  font:8px/9px 'Courier New',monospace;
  letter-spacing:4px;
  padding-left:4px
}
.mast-controls {
  display:flex;
  gap:6px;
  flex-shrink:0
}
.small-switch {
  background:#364e44;
  border:1px solid #748273;
  box-shadow:0 2px 0 #10201c;
  border-radius:2px;
  padding:8px 10px;
  min-height:40px;
  color:#e1d9c1!important;
  font:10px 'Courier New',monospace!important
}
.small-switch:hover {
  background:#526257
}
.small-switch:disabled {
  opacity:.45
}
.back-office {
  height:154px;
  position:relative;
  background:linear-gradient(0deg,#899587 0%,#a2aa96 82%,#6c786b 83%,#566557 100%);
  overflow:hidden;
  border-bottom:9px solid #394a40;
  box-shadow:inset 0 -10px 30px #293a3b48
}
.back-office:before {
  content:'';
  position:absolute;
  inset:0;
  background:repeating-linear-gradient(90deg,transparent 0px,transparent 150px,#20362910 151px,#20362910 152px),linear-gradient(180deg,#edf0bb20,transparent)
}
.fluorescent {
  height:10px;
  width:38%;
  left:31%;
  top:6px;
  position:absolute;
  border:2px solid #4c5d4c;
  background:#e9edc7;
  box-shadow:0 6px 26px #f1f4bf70;
  z-index:3
}
.fluorescent>span {
  display:block;
  margin:1px 8px;
  border-top:2px solid #ffffe8
}
.shift-docket {
  position:absolute;
  left:24px;
  top:25px;
  width:265px;
  max-width:28%;
  min-height:112px;
  background:#ded5bb;
  transform:rotate(-2deg);
  padding:11px 15px 8px;
  border:1px solid #b9b099;
  box-shadow:2px 4px 4px #243a3650
}
.shift-docket h2 {
  font:italic 700 19px/1.2 Georgia,serif;
  max-width:220px;
  margin:5px 0
}
.shift-docket p:not(.eyebrow) {
  font:9px/1.4 'Courier New',monospace;
  margin-bottom:12px
}
.shift-docket .eyebrow {
  font-size:8px;
  letter-spacing:.8px
}
.date-stamp {
  position:absolute;
  right:10px;
  bottom:7px;
  color:#8d4636;
  border:2px solid #985541;
  padding:1px 6px;
  transform:rotate(-6deg);
  font:bold 10px 'Courier New',monospace
}
.paperclip {
  position:absolute;
  width:11px;
  height:31px;
  border:2px solid #7a8073;
  right:50px;
  top:-8px;
  border-radius:7px
}
.observation-window {
  position:absolute;
  left:32%;
  width:38%;
  height:116px;
  bottom:8px;
  border:8px solid #50675d;
  background:linear-gradient(130deg,#bfd2bc26,transparent 55%),#2b4940;
  box-shadow:0 0 0 3px #738678,inset 0 0 35px #172c2bd0;
  overflow:hidden
}
.observation-window:after {
  content:'';
  position:absolute;
  inset:0;
  background:linear-gradient(125deg,transparent 29%,#bbcfb416 30%,#bbcfb416 35%,transparent 36%),repeating-linear-gradient(0deg,#e8edcf05 0px,#e8edcf05 1px,transparent 2px,transparent 5px);
  pointer-events:none
}
.glass-lettering {
  position:absolute;
  top:10px;
  left:15px;
  color:#b1be9e;
  font:9px 'Courier New',monospace;
  letter-spacing:3px
}
.window-grille {
  position:absolute;
  height:100%;
  width:5px;
  left:49%;
  background:#526c5e;
  box-shadow:80px 0 0 #50695b;
  top:0
}
.distant-belt {
  position:absolute;
  bottom:10px;
  height:20px;
  background:repeating-linear-gradient(90deg,#1b302b 0,#1b302b 18px,#465c4b 19px,#465c4b 21px);
  width:100%;
  border-top:3px solid #6a7d67;
  animation:po-belt 6s linear infinite
}
.worker {
  position:absolute;
  bottom:22px;
  height:57px;
  width:30px;
  opacity:.82;
  animation:po-worker 19s linear infinite
}
.worker-one {
  left:18%
}
.worker-two {
  left:70%;
  animation-delay:-9s
}
.worker i {
  display:block;
  width:17px;
  height:19px;
  background:#8f9a83;
  border-radius:45%;
  margin-left:5px;
  border-top:6px solid #354638
}
.worker b {
  display:block;
  width:26px;
  height:35px;
  border-radius:9px 9px 0 0;
  background:#405b4b;
  border-left:7px solid #647b65
}
.worker>span {
  position:absolute;
  top:28px;
  left:19px;
  width:21px;
  height:19px;
  background:#8d8462;
  border:1px solid #b4a279;
  transform:rotate(-9deg)
}
.supervisor {
  position:absolute;
  right:10%;
  bottom:-10px;
  width:61px;
  height:83px;
  opacity:0;
  transform:translateY(50px);
  transition:transform 2s,opacity 2s
}
.supervisor.visible {
  opacity:.9;
  transform:translateY(0)
}
.supervisor i {
  display:block;
  width:25px;
  height:29px;
  margin:auto;
  background:#172920;
  border-radius:40% 40% 35% 35%;
  position:relative
}
.supervisor i:after {
  content:'';
  position:absolute;
  top:13px;
  left:5px;
  width:5px;
  height:2px;
  background:#d7cd92;
  box-shadow:10px 0 #d7cd92
}
.supervisor b {
  display:block;
  background:#192c24;
  height:62px;
  border-radius:20px 20px 0 0
}
.wall-poster {
  position:absolute;
  top:31px;
  left:73%;
  width:94px;
  background:#b7ad87;
  padding:8px;
  transform:rotate(3deg);
  border:1px solid #8d927c;
  box-shadow:1px 1px 2px #37463850
}
.wall-poster strong {
  font:900 11px/1.2 Arial;
  letter-spacing:.6px;
  display:block
}
.wall-poster>span {
  font:8px/1.3 'Courier New',monospace;
  display:block;
  border-top:1px solid #8b896c;
  padding-top:4px;
  margin-top:5px
}
.wall-clock {
  position:absolute;
  right:6%;
  top:27px;
  width:70px;
  height:70px;
  background:#d6d7b9;
  border:6px solid #40564b;
  border-radius:50%;
  box-shadow:2px 3px 5px #0005
}
.wall-clock>span {
  position:absolute;
  font:9px 'Courier New',monospace;
  left:22px
}
.clock-twelve {
  top:2px
}
.clock-six {
  bottom:1px;
  left:26px!important
}
.wall-clock i {
  position:absolute;
  bottom:50%;
  left:50%;
  transform-origin:50% 100%;
  background:#34493b;
  width:2px
}
.clock-minute {
  height:22px
}
.clock-hour {
  height:16px;
  transform:rotate(112deg)
}
.wall-clock>b {
  position:absolute;
  width:5px;
  height:5px;
  left:calc(50% - 1.5px);
  top:calc(50% - 2.5px);
  border-radius:50%;
  background:#936447
}
.office-number {
  position:absolute;
  right:4%;
  bottom:6px;
  font:8px/1.1 'Courier New',monospace;
  letter-spacing:2px;
  text-align:center;
  color:#324939
}
.office-number b {
  font:bold 23px Georgia,serif;
  letter-spacing:1px
}
.tube {
  position:absolute;
  left:88%;
  height:190px;
  top:-50px;
  width:14px;
  border-left:4px solid #566e60;
  border-right:4px solid #788b74;
  background:#a5b399;
  box-shadow:2px 0 0 #354e41
}
.tube-canister {
  display:block;
  position:absolute;
  width:8px;
  height:23px;
  background:#aa7746;
  left:0;
  top:30px;
  border-top:3px solid #475b4a;
  border-bottom:3px solid #475b4a
}
.tube-canister.moving {
  animation:po-tube 4s ease-in-out infinite
}
.scene-shell {
  border:0;
  margin:0;
  padding:18px;
  min-width:0
}
.desk-layout {
  display:grid;
  grid-template-columns:minmax(0,1fr) 286px;
  gap:18px;
  align-items:start
}
.desk-column {
  min-width:0;
  box-shadow:0 4px 12px #172b2870
}
.conveyor-strip {
  height:78px;
  position:relative;
  background:#2d3f37;
  border:5px solid #485d4f;
  border-bottom:5px solid #1f342e;
  overflow:hidden
}
.conveyor-belt {
  position:absolute;
  inset:0;
  background:repeating-linear-gradient(90deg,#202f29 0px,#202f29 13px,#4c5b4c 14px,#263b30 17px);
  background-size:40px 100%;
  animation:po-belt 2.4s linear infinite;
  box-shadow:inset 0 7px 8px #0005,inset 0 -5px 7px #0005
}
.conveyor-belt.jammed {
  animation-play-state:paused
}
.belt-caption {
  position:absolute;
  bottom:1px;
  left:12px;
  font:8px 'Courier New',monospace;
  letter-spacing:1.5px;
  color:#b3b695
}
.waiting-box {
  position:absolute;
  top:9px;
  width:73px;
  height:40px;
  background:#a98b5d;
  border:2px solid #5d5038;
  box-shadow:5px 5px 0 #131f2260;
  transform:rotate(-7deg)
}
.waiting-box:before {
  content:'';
  position:absolute;
  top:-6px;
  height:6px;
  left:1px;
  right:-2px;
  background:#c1a376;
  transform:skewX(-30deg);
  transform-origin:bottom left
}
.waiting-box>span {
  position:absolute;
  width:12px;
  background:#d7c28a90;
  inset:0 0 0 40%
}
.waiting-box b {
  font:8px 'Courier New',monospace;
  background:#dbd2b5;
  position:absolute;
  left:8px;
  right:8px;
  top:12px;
  padding:2px;
  transform:rotate(5deg)
}
.waiting-box.label-missing b {
  background:#b49b76;
  color:#514532;
  clip-path:polygon(2% 5%,17% 15%,28% 0,39% 22%,54% 0,77% 20%,96% 0,92% 100%,68% 90%,52% 100%,31% 80%,12% 100%)
}
.separator-fin {
  position:absolute;
  left:48%;
  bottom:0;
  width:5px;
  height:8px;
  background:#b7bbab;
  border:1px solid #394c43;
  transform:skewY(-18deg);
  transition:height .4s
}
.separator-fin.raised {
  height:66px;
  box-shadow:6px 0 0 #778b7a
}
.separator-button,.jam-lever {
  position:absolute;
  top:8px;
  border:1px solid #67776a;
  background:#405b4a;
  box-shadow:2px 2px 0 #162c22;
  color:#e1dbc1!important;
  padding:10px 8px 5px 31px;
  min-height:49px;
  font:bold 9px/1.3 'Courier New',monospace!important;
  text-align:left
}
.separator-button {
  left:51%;
  width:23%
}
.jam-lever {
  right:1%;
  width:24%
}
.separator-button small,.jam-lever small {
  display:block;
  font-size:8px;
  color:#c1c4ab;
  font-weight:normal;
  margin-top:4px
}
.separator-button i,.jam-lever i {
  position:absolute;
  left:12px;
  top:7px;
  width:5px;
  height:21px;
  background:#a4a99a;
  border:1px solid #d5d6b7;
  transform:rotate(18deg);
  transform-origin:bottom;
  transition:transform .25s
}
.separator-button i:before,.jam-lever i:before {
  content:'';
  position:absolute;
  top:-3px;
  left:-5px;
  width:12px;
  height:10px;
  background:#bcc8a6;
  border:1px solid #4c5d4d;
  border-radius:3px
}
.separator-button.engaged i {
  transform:rotate(-25deg)
}
.jam-lever.is-jammed {
  background:#744735;
  border-color:#b57b53
}
.jam-lever.is-jammed i:before {
  background:#d89553
}
.worktop {
  height:365px;
  position:relative;
  overflow:hidden;
  background:repeating-linear-gradient(162deg,transparent 0px,transparent 101px,#d2d3b30b 102px,#d2d3b30b 103px,transparent 104px,transparent 179px),linear-gradient(125deg,#849081,#6c7d70 48%,#556c5d);
  border-left:5px solid #485e50;
  border-right:5px solid #344e40;
  border-bottom:5px solid #293e34;
  box-shadow:inset 0 6px 10px #243d3040,inset 0 -9px 0 #526858
}
.worktop:after {
  content:'';
  position:absolute;
  width:160px;
  height:9px;
  left:26%;
  bottom:26px;
  border-bottom:1px solid #c5c6a738;
  transform:rotate(-14deg);
  box-shadow:18px 5px 0 -4px #d9d9b344,46px 20px 0 -4px #364e3650;
  pointer-events:none
}
.desk-engraving {
  position:absolute;
  left:15px;
  top:9px;
  font:8px 'Courier New',monospace;
  letter-spacing:1.5px;
  color:#263e30aa;
  text-shadow:0 1px #d9e1be20
}
.desk-case-number {
  position:absolute;
  right:12px;
  top:9px;
  font:9px 'Courier New',monospace;
  color:#d2dbc9a0;
  letter-spacing:1px
}
.inspection-mat {
  position:absolute;
  left:29%;
  top:65px;
  width:42%;
  height:245px;
  background:radial-gradient(ellipse,#405b4e 20%,#3d5749 90%);
  transform:perspective(700px) rotateX(14deg);
  border:1px solid #2b4237;
  border-radius:7px;
  box-shadow:0 3px 2px #193c3045,inset 0 0 40px #243d3450
}
.inspection-mat>span {
  position:absolute;
  bottom:10px;
  left:0;
  width:100%;
  text-align:center;
  font:9px 'Courier New',monospace;
  letter-spacing:2px;
  color:#bec6a354
}
.inspection-mat>i {
  position:absolute;
  inset:12px;
  border:1px dashed #9db49728;
  border-radius:5px
}
.scale-station {
  position:absolute;
  left:calc(18% - 76px);
  top:176px;
  width:152px;
  z-index:3
}
.scale-pan {
  position:absolute;
  top:-14px;
  left:-7px;
  width:167px;
  height:17px;
  background:linear-gradient(#b9c4ad,#698376);
  border:2px solid #425e4b;
  border-radius:45% 45% 24% 24%;
  box-shadow:0 3px 0 #2e4a3d
}
.scale-body {
  position:relative;
  width:152px;
  height:126px;
  background:linear-gradient(100deg,#a3b19a,#7d9782);
  border:3px solid #3d5846;
  border-radius:9px 9px 5px 5px;
  box-shadow:4px 6px 0 #233f3450;
  padding:0
}
.scale-brand {
  position:absolute;
  top:3px;
  left:0;
  width:100%;
  text-align:center;
  font:7px 'Courier New',monospace;
  letter-spacing:1px;
  color:#213d2d
}
.scale-dial {
  position:absolute;
  left:34px;
  top:19px;
  width:81px;
  height:73px;
  border:4px solid #425d49;
  border-radius:50%;
  background:#d9d8b9;
  box-shadow:inset 0 1px 5px #2b413e40
}
.scale-ticks {
  position:absolute;
  inset:3px;
  border-radius:50%;
  background:repeating-conic-gradient(from -125deg,#40563e 0deg 1deg,transparent 1.5deg 15deg);
  mask-image:radial-gradient(ellipse,transparent 56%,#000 58%,#000 72%,transparent 74%)
}
.scale-dial>span:not(.scale-ticks) {
  position:absolute;
  font:8px 'Courier New',monospace
}
.dial-zero {
  left:5px;
  bottom:13px
}
.dial-ten {
  top:7px;
  left:30px
}
.dial-twenty {
  right:4px;
  bottom:13px
}
.scale-needle {
  position:absolute;
  left:50%;
  bottom:50%;
  width:2px;
  height:27px;
  background:#ac4934;
  transform-origin:50% 100%;
  transition:transform .5s cubic-bezier(.2,1.5,.4,1)
}
.scale-dial>b {
  position:absolute;
  left:calc(50% - 3px);
  top:calc(50% - 3px);
  width:6px;
  height:6px;
  border-radius:50%;
  background:#5e5037
}
.scale-readout {
  position:absolute;
  bottom:5px;
  left:30px;
  width:85px;
  border:1px solid #546449;
  background:#dad9bb;
  font:16px/20px 'Courier New',monospace;
  text-align:center;
  color:#2b432f
}
.scale-readout small {
  font-size:10px
}
.calibration-seal {
  position:absolute;
  bottom:-14px;
  left:20px;
  right:20px;
  font:7px/15px 'Courier New',monospace;
  text-align:center;
  color:#dfe2bb;
  background:#4b634d;
  border:1px solid #92a27e;
  letter-spacing:1px
}
.calibration-seal.unverified {
  background:#8b5c37;
  border-color:#c6a369;
  color:#fff0bb
}
.calibration-tools {
  position:absolute;
  left:-31px;
  top:42px;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:3px
}
.reference-weight {
  height:43px;
  width:34px;
  background:linear-gradient(90deg,#8e784d,#bda467 40%,#8a7446);
  border:2px solid #625435;
  border-radius:9px 9px 3px 3px;
  box-shadow:2px 2px 0 #31452d50;
  padding:3px 0 0;
  font:bold 14px/1 Georgia,serif!important
}
.reference-weight:before {
  content:'';
  position:absolute;
  width:15px;
  height:8px;
  border:3px solid #7c693b;
  border-radius:7px;
  top:-6px;
  left:9px
}
.reference-weight small {
  display:block;
  font:9px Georgia,serif
}
.reference-weight.on-pan {
  box-shadow:0 0 0 2px #e4d189
}
.zero-knob {
  width:42px;
  height:43px;
  position:relative;
  background:none;
  border:0;
  font:7px/1 'Courier New',monospace!important;
  padding:27px 0 0;
  color:#e5e3bd!important
}
.zero-knob i {
  position:absolute;
  left:9px;
  top:0;
  width:25px;
  height:25px;
  background:#2d4437;
  border:3px solid #93a084;
  border-radius:50%
}
.zero-knob i:after {
  content:'';
  position:absolute;
  left:8px;
  top:2px;
  height:7px;
  width:2px;
  background:#d5d7b1
}
.xray-cabinet {
  position:absolute;
  width:174px;
  left:calc(81% - 87px);
  top:65px;
  height:229px;
  background:linear-gradient(90deg,#465d50,#60776b);
  border:4px solid #2f4a3b;
  border-radius:6px;
  box-shadow:5px 8px 0 #2b443345
}
.xray-title {
  display:block;
  text-align:center;
  font:bold 8px 'Courier New',monospace;
  letter-spacing:1px;
  color:#d1d8b9;
  padding:9px 1px
}
.xray-window {
  position:absolute;
  left:9px;
  right:9px;
  top:31px;
  bottom:43px;
  background:#172f2c;
  border:5px solid #263c31;
  box-shadow:inset 0 0 25px #7fbc7940;
  padding:0;
  overflow:hidden
}
.xray-window small {
  position:absolute;
  top:4px;
  left:0;
  width:100%;
  font:7px 'Courier New',monospace;
  letter-spacing:1.5px;
  color:#a4c8a270
}
.xray-grid {
  position:absolute;
  inset:0;
  background:repeating-linear-gradient(0deg,transparent 0,transparent 14px,#89bba20d 15px,#89bba20d 16px),repeating-linear-gradient(90deg,transparent 0,transparent 14px,#89bba20d 15px,#89bba20d 16px)
}
.xray-beam {
  display:none;
  position:absolute;
  top:0;
  left:0;
  width:100%;
  height:2px;
  background:#b9e4a8;
  box-shadow:0 0 14px #b1eb94
}
.xray-window.scanning .xray-beam {
