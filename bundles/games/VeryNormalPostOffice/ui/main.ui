  font-size:6px;
  display:block;
  border-bottom:1px solid #a6a286;
  padding-bottom:4px;
  letter-spacing:.4px
}
.shipping-label strong {
  display:block;
  font-size:10px;
  margin-top:5px;
  line-height:1.15
}
.shipping-label>span:not(.label-bottom) {
  font-size:8px;
  display:block
}
.shipping-label>b {
  font-size:10px;
  letter-spacing:1px;
  display:block;
  margin-top:4px
}
.label-bottom {
  display:flex;
  justify-content:space-between;
  margin-top:5px;
  align-items:center
}
.label-bottom>i {
  font:bold 18px/1 Georgia,serif;
  font-style:normal
}
.barcode {
  display:block;
  width:65px;
  height:17px;
  background:repeating-linear-gradient(90deg,#373e2d 0px,#373e2d 1px,transparent 1px,transparent 3px,#373e2d 3px,#373e2d 5px,transparent 5px,transparent 8px,#373e2d 8px,#373e2d 9px,transparent 9px,transparent 10px,#373e2d 10px,#373e2d 13px,transparent 13px,transparent 17px)
}
.reverse-print {
  transform:rotate(-2deg) scaleX(-1)
}
.rear-label,.base-label {
  position:absolute;
  left:20px;
  right:16px;
  top:14px;
  bottom:11px;
  display:flex;
  align-items:center;
  flex-direction:column;
  justify-content:space-around;
  text-align:center;
  font:10px/1.3 'Courier New',monospace;
  border:1px dashed #5f563754;
  background:#dac38b30;
  padding:7px
}
.rear-label small {
  font-size:8px
}
.rear-label b {
  font-size:10px
}
.rear-label>span:last-child {
  font-size:7px
}
.flap-tab {
  width:64px;
  height:25px;
  background:#dac698;
  border:1px solid #806b42;
  box-shadow:2px 3px 0 #846b3e6a;
  clip-path:polygon(0 0,100% 0,85% 100%,10% 100%)
}
.flap-open .flap-tab {
  transform:perspective(100px) rotateX(155deg)
}
.base-label {
  background:#e4d7b3;
  transform:rotate(2deg)
}
.base-label small {
