}
.scanner-display strong {
  font:24px/1.25 'Courier New',monospace;
  letter-spacing:3px;
  text-shadow:0 0 7px #b0d79950
}
.scanner-display>span {
  font:6px 'Courier New',monospace;
  letter-spacing:1px;
  color:#86a27c
}
.scanner-display.active strong {
  opacity:.6
}
.machine-screw {
  position:absolute;
  width:4px;
  height:4px;
  background:#3b5138;
  border-radius:50%;
  top:2px
}
.screw-one {
  left:2px
}
.screw-two {
  right:2px
}
.tool-controls {
  display:grid;
  grid-template-columns:repeat(6,minmax(0,1fr));
  gap:5px;
  align-items:stretch
}
.tool-key {
  position:relative;
  background:linear-gradient(#acb6a0,#7f947c);
  border:1px solid #2d4936;
  border-radius:4px;
  box-shadow:0 3px 0 #1c3527;
  padding:5px 2px;
  color:#253d2a!important;
  min-height:64px
}
.tool-key:hover:not(:disabled) {
  background:#c2c7a9
}
.tool-key:active:not(:disabled) {
  transform:translateY(2px);
  box-shadow:0 1px 0 #1c3527
}
.tool-key>b {
  font:25px/1.1 Georgia,serif;
  display:block;
  margin-bottom:6px
}
.tool-key>span {
  display:block;
  font:bold 9px/1.15 Arial;
  position:relative;
  min-height:16px;
  padding-right:8px
}
.tool-key kbd {
  position:absolute;
  right:0;
  bottom:-2px;
  font:7px 'Courier New',monospace;
  border:1px solid #566b4d;
  color:#4b6245;
  padding:0 1px;
  line-height:10px
}
.tool-key:disabled {
  filter:saturate(.5);
  opacity:.74
}
.flap-key {
  background:linear-gradient(#bcac84,#9c8f65)
}
.stamp-shelf {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  padding:10px 13px;
  height:108px;
  border:4px solid #2b4334;
  border-top:0;
  background:repeating-linear-gradient(172deg,transparent 0,transparent 65px,#ccd4b90a 66px,transparent 67px),#667964;
  box-shadow:inset 0 1px #899981
}
.stamp-assembly {
  display:flex;
  align-items:center;
  gap:11px;
  flex-shrink:0
}
.wooden-stamp {
  position:relative;
  background:transparent;
  border:0;
  width:104px;
  height:82px;
  padding:0;
  appearance:none;
  isolation:isolate
}
.stamp-handle {
  position:absolute;
  top:2px;
  left:33px;
  width:37px;
  height:46px;
  border-radius:45% 45% 20% 20%;
  background:repeating-linear-gradient(92deg,transparent 0px,transparent 5px,#66482b40 6px,transparent 7px),linear-gradient(90deg,#714d30,#ab7950 45%,#6b4c2d);
  border:2px solid #533c27;
  box-shadow:4px 4px 0 #293b2550
}
.stamp-base {
  position:absolute;
  top:41px;
  left:8px;
  width:88px;
  height:22px;
  background:linear-gradient(#c0ac7d,#8e7c50 60%,#343e2c 61%);
  border:2px solid #3d4b30;
  font:bold 8px/13px 'Courier New',monospace;
  color:#3c422d;
  box-shadow:4px 6px 0 #2f472f55
}
.wooden-stamp>span {
  position:absolute;
  bottom:0;
  left:0;
  right:0;
  font:bold 8px 'Courier New',monospace;
  letter-spacing:.6px;
  color:#d7dbc0
}
.wooden-stamp:hover:not(:disabled) .stamp-handle {
  filter:brightness(1.12)
}
.wooden-stamp.stamping {
  animation:po-stamp .55s ease-in-out
}
.ink-pad {
  position:relative;
  width:48px;
  height:60px;
  background:#c0bca0;
  border:2px solid #46553a;
  border-radius:3px;
  box-shadow:3px 3px 0 #263e2e60;
  padding:4px 4px 18px
}
.ink-pad i {
  display:block;
  width:100%;
  height:100%;
  background:repeating-linear-gradient(25deg,#9b493a 0,#9b493a 1px,#874331 2px,#874331 3px);
  border:2px solid #593e2d;
  border-radius:2px
}
.black-pad i {
  background:repeating-linear-gradient(25deg,#30372b 0,#30372b 1px,#252e25 2px,#252e25 3px)
}
.ink-pad b {
  font:bold 8px 'Courier New',monospace;
  position:absolute;
  left:0;
  bottom:3px;
  width:100%;
  letter-spacing:.5px
}
.ink-pad.selected {
  outline:2px solid #d9cc86;
  outline-offset:3px;
  transform:rotate(-3deg)
}
.stamp-instruction {
  font:9px/1.5 'Courier New',monospace;
  color:#e3e1bf;
  max-width:165px;
  letter-spacing:.7px
}
.stamp-instruction small {
  display:block;
  font-size:7px;
  color:#c0cba9;
  margin-top:4px;
  letter-spacing:1px
}
.biscuit-tin {
  position:relative;
  min-width:108px;
  height:75px;
  background:#adbcaa;
  border:3px double #4d6450;
  border-radius:11px 11px 4px 4px;
  box-shadow:2px 3px 0 #31453080;
  padding:34px 8px 3px;
  color:#3b4f38!important
}
.biscuit-tin b {
  font:bold 8px 'Courier New',monospace;
  display:block
}
.biscuit-tin small {
  font:6px 'Courier New',monospace;
  display:block;
  margin-top:3px
}
.biscuit {
  position:absolute;
  top:5px;
  left:calc(50% - 22px);
  width:44px;
  height:24px;
  background:radial-gradient(circle at center,#876b3e 1px,transparent 1.5px);
  background-size:9px 7px;
  background-color:#cab37e;
  border:2px solid #998053;
  border-radius:40%;
  box-shadow:1px 2px #6b644350;
  transform:rotate(-8deg)
}
.routing-cages {
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  background:#2e4236;
  border:5px solid #253c2f;
  border-top:0;
  gap:7px;
  padding:10px 8px 8px;
  min-height:133px
}
.route-cage {
  position:relative;
  background:#233d31;
  border:3px solid #4f6953;
  box-shadow:2px 3px 0 #172a1f;
  min-height:105px;
  padding:0;
  overflow:hidden;
  border-radius:3px
}
.cage-wire {
  position:absolute;
  inset:19px 0 0;
  background:repeating-linear-gradient(0deg,transparent 0,transparent 17px,#6c806448 18px,#6c806448 19px),repeating-linear-gradient(90deg,transparent 0,transparent 19px,#6c80644d 20px,#6c80644d 21px);
  box-shadow:inset 0 0 19px #0f251da0
}
.electric-destination {
  position:absolute;
  left:5px;
  right:5px;
  top:2px;
  font:7px/12px 'Courier New',monospace;
  letter-spacing:2px;
  color:#a8c487;
  background:#1e3524;
  border:1px solid #5d7853
}
.brass-plate {
  position:absolute;
  top:34px;
  left:9px;
  right:9px;
  min-height:45px;
  border:2px solid #8c794b;
  background:linear-gradient(115deg,#cbbc84,#b4a275 85%);
  box-shadow:2px 3px 0 #172a2070;
  padding:8px 2px 5px
}
.brass-plate:before,.brass-plate:after {
  content:'+';
  position:absolute;
  font:8px 'Courier New',monospace;
  color:#615734;
  top:1px
}
.brass-plate:before {
  left:2px
}
.brass-plate:after {
  right:2px
}
.brass-plate strong {
  display:block;
  font:bold 13px/1.1 'Courier New',monospace;
  letter-spacing:1.5px;
  color:#334132
}
.brass-plate small {
  display:block;
  font:6px 'Courier New',monospace;
  letter-spacing:.6px;
  margin-top:4px;
  color:#4f563b
}
.brass-plate kbd {
  position:absolute;
  left:4px;
  bottom:-20px;
  color:#bbc9a4;
  font:9px 'Courier New',monospace
}
.cage-quarantine .brass-plate {
  background:#b87c62;
  border-color:#92644a
}
.cage-quarantine .brass-plate strong {
  font-size:11px;
  letter-spacing:.4px
}
.cage-freight .brass-plate {
  background:#c4aa70
}
.cage-latch {
  position:absolute;
  bottom:2px;
  right:12px;
  width:16px;
  height:9px;
  background:#718366;
  border:2px solid #344a33
}
.route-cage:hover:not(:disabled) {
  border-color:#a7b88b;
  background:#314e39
}
.route-cage:hover:not(:disabled) .brass-plate {
  filter:brightness(1.12)
}
.route-cage:active:not(:disabled) .brass-plate {
  transform:translateY(2px)
}
.cage-active .cage-wire {
  transform:perspective(200px) rotateX(30deg);
  transform-origin:top
}
.cage-active {
  box-shadow:inset 0 0 22px #becba547
}
.receipt-slot {
  min-height:71px;
  background:#d7d1b6;
  border:1px solid #aaa78d;
  padding:10px 14px 10px 115px;
  position:relative;
  box-shadow:inset 0 6px 0 #273c301c
}
.receipt-slot:after {
  content:'';
  position:absolute;
  left:0;
  right:0;
  bottom:0;
  border-bottom:2px dashed #87917855
}
.receipt-slot-label {
  position:absolute;
  left:14px;
  top:14px;
  font:bold 8px 'Courier New',monospace;
  letter-spacing:1px;
  color:#61715b;
  width:85px;
  border-right:1px solid #989c7e;
  padding:3px 8px 13px 0
}
.receipt-slot p {
  font:11px/1.65 'Courier New',monospace;
  color:#384934
}
.paperwork-column {
  display:flex;
  flex-direction:column;
  gap:14px;
  min-width:0
}
.intake-clipboard {
  position:relative;
  background:#927b52;
  border:1px solid #655a3d;
  box-shadow:3px 5px 4px #152d2750;
  padding:17px 10px 10px;
  border-radius:7px 7px 3px 3px;
  transform:rotate(.5deg)
}
.clipboard-clip {
  position:absolute;
  top:-4px;
  left:calc(50% - 38px);
  width:76px;
  height:26px;
  background:linear-gradient(#8a9785,#b7c1a6 35%,#788976 70%);
  border:2px solid #4b6250;
  border-radius:5px 5px 2px 2px;
  z-index:3;
  box-shadow:0 2px 2px #273c283f
}
.clipboard-clip:after {
  content:'';
  position:absolute;
  width:45px;
  height:4px;
  left:13px;
  top:10px;
  border:1px solid #697b60;
  border-radius:3px
}
.intake-sheet {
  background:linear-gradient(90deg,#d6cdb2,#eee4ca 8%,#e5dbc0 96%,#c9bfa5);
  padding:17px 13px 13px;
  box-shadow:1px 2px 0 #5b503341;
  color:#3c4635
}
.form-number {
  font-size:8px;
  letter-spacing:1.2px;
  color:#7b785d
}
.form-title {
  border-bottom:2px solid #8d8e72;
  margin-top:3px;
  padding-bottom:6px;
  display:flex;
  justify-content:space-between;
  align-items:center
}
.form-title h2 {
  font:italic 20px Georgia,serif
}
.form-title>span {
  font:9px 'Courier New',monospace;
  letter-spacing:1px
}
.address-transcript {
  margin-top:11px;
  padding-bottom:11px;
  border-bottom:1px solid #a2a183;
  font:11px/1.55 'Courier New',monospace;
  min-height:66px
}
.address-transcript>* {
  display:block
}
.address-transcript strong {
  font-size:11px
}
.address-transcript>b {
  font-size:10px;
  letter-spacing:1px;
  margin-top:3px;
  color:#6b6d50
}
.evidence-list {
  margin-top:4px!important
}
.evidence-row {
  padding:6px 0 5px;
  border-bottom:1px dotted #aaa88e
}
.evidence-row dt {
  font:7px 'Courier New',monospace;
  letter-spacing:1px;
  color:#777d64
}
.evidence-row dd {
  font:11px/1.4 'Courier New',monospace;
  margin-top:2px;
  color:#878875
}
.evidence-row.recorded dd {
  color:#324f3e
}
.witness-note {
  font:italic 11px/1.6 Georgia,serif;
  margin-top:10px!important;
  color:#5d654e
}
.witness-note>span {
  font:7px 'Courier New',monospace;
  letter-spacing:1.2px;
  display:block;
  margin-bottom:4px;
  color:#787c61
}
.handbook-cover {
  position:relative;
  display:block;
  width:100%;
  text-align:left;
  padding:17px 21px 11px 27px;
  border:2px solid #627051;
  border-right:6px solid #d0c5a4;
  border-radius:3px 6px 6px 2px;
  background:repeating-linear-gradient(90deg,#304e37 0px,#304e37 2px,#324f38 3px,#324f38 4px);
  color:#d4c896!important;
  box-shadow:4px 5px 0 #162e2670;
  transform:rotate(-1deg);
  min-height:151px;
  transition:transform .15s
}
.handbook-cover:hover:not(:disabled) {
  transform:rotate(-3deg) translateY(-2px)
}
.handbook-cover>small {
  font:6px 'Courier New',monospace;
  letter-spacing:1.8px;
  display:block;
  border-bottom:1px solid #84906a70;
  padding-bottom:5px
}
.handbook-cover>strong {
  font:700 22px/1 Georgia,serif;
  display:block;
  margin:9px 0 7px;
  letter-spacing:1px
}
.handbook-cover>i {
  font:7px/1.4 'Courier New',monospace;
  letter-spacing:1px
}
.book-spine {
  position:absolute;
  left:6px;
  top:0;
  width:3px;
  bottom:0;
  border-left:1px solid #9dba6840;
  border-right:1px solid #162c24
}
.book-edition {
  display:flex;
  justify-content:space-between;
  font:7px 'Courier New',monospace;
  letter-spacing:1px;
  padding-top:9px;
  border-top:1px solid #87937466;
  margin-top:8px
}
.book-edition b {
  font-size:8px
}
.pinned-circular {
  position:relative;
  background:#d5bc80;
  border:1px solid #b29561;
  padding:13px 14px 9px;
  transform:rotate(1.5deg);
  box-shadow:2px 4px 4px #1b332746;
  min-height:105px
}
.pin {
  position:absolute;
  width:9px;
  height:9px;
  border-radius:50%;
  background:#a2523d;
  left:50%;
  top:-3px;
  border:1px solid #6b4630;
  box-shadow:2px 3px 1px #524d3440
}
.circular-number {
  font:7px 'Courier New',monospace;
  letter-spacing:1.3px;
  color:#745e38;
  border-bottom:1px solid #a58e56;
  padding-bottom:4px;
  display:block
}
.pinned-circular p {
  font:bold 11px/1.4 'Courier New',monospace;
  margin-top:7px;
  color:#534f34
}
.paper-link {
  padding:7px 0 0;
  background:none;
  border:0;
  text-decoration:underline;
  text-underline-offset:3px;
  font:10px 'Courier New',monospace!important;
  min-height:33px;
  text-align:left;
  color:#3d6348!important
}
.pinned-circular .paper-link {
  font-size:9px!important
}
.shift-ledger {
  border:1px solid #8b9278;
  background:#adb49a;
  padding:10px 11px 9px;
  color:#3c513b;
  box-shadow:2px 3px 0 #1e362b60
}
.shift-ledger .form-number {
  color:#54664c
}
.ledger-cases {
  display:flex;
  gap:4px;
  margin-top:6px;
  flex-wrap:wrap
}
.ledger-box {
  width:18px;
  height:18px;
  border:1px solid #6c7c5d;
  text-align:center;
  font:10px/17px 'Courier New',monospace;
  color:#637958
}
.ledger-box.complete {
  background:#596f4d;
  color:#d2d7b5;
  position:relative
}
.ledger-box.complete:after {
  content:'';
  position:absolute;
  inset:2px;
  border-top:1px solid #d4d9b7;
  transform:rotate(-45deg);
  top:8px
}
.ledger-box.current {
  border:2px solid #9b5d3e;
  color:#654c32;
  line-height:15px;
  transform:rotate(-5deg)
}
.ledger-total {
  margin-top:7px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  font:10px 'Courier New',monospace
}
.ledger-total small {
  display:block;
  font:5px/1.6 'Courier New',monospace;
  letter-spacing:.3px
}
.ledger-total>strong {
  font:bold 19px/1 'Courier New',monospace;
  letter-spacing:1px;
  text-align:right
}
.ledger-total>strong small {
  font-size:6px;
  letter-spacing:1px;
  margin-top:3px
}
.integrity-label {
  display:flex;
  justify-content:space-between;
  font:6px 'Courier New',monospace;
  letter-spacing:1px;
  margin-top:8px
}
.integrity-track {
  height:4px;
  background:#899b7e;
  margin-top:3px
}
.integrity-track>span {
  display:block;
  height:100%;
  background:#4e714c;
  transition:width .5s
}
.facility-footer {
  padding:0 20px 12px;
  display:flex;
  justify-content:space-between;
  gap:10px;
  font:8px 'Courier New',monospace;
  letter-spacing:.6px;
  color:#a9b69d
}
.modal-scrim {
  position:absolute;
  inset:0;
  z-index:100;
  background:#0e241fc4;
  backdrop-filter:blur(3px);
  display:flex;
  align-items:center;
  justify-content:center;
  padding:25px;
  overflow:auto
}
.briefing-sheet,.tea-sheet {
  position:relative;
  background:linear-gradient(100deg,#e8dfc6,#e1d5b8);
  border:1px solid #b5b095;
  box-shadow:12px 15px 0 #10291c35,0 16px 80px #0006;
  width:620px;
  max-width:100%;
  padding:34px 40px 25px;
  max-height:calc(100% - 20px);
  overflow:auto;
  transform:rotate(-.7deg);
  color:#354732
}
.briefing-sheet:before {
  content:'';
  position:absolute;
  inset:10px;
  border:1px solid #acaf8f70;
  pointer-events:none
}
.large-paperclip {
  position:absolute;
  top:-2px;
  right:90px;
  width:16px;
  height:52px;
  border:3px solid #8c9981;
  border-radius:11px;
  box-shadow:1px 1px 0 #4a624770
}
.briefing-topline {
  display:flex;
  justify-content:space-between;
  font:8px 'Courier New',monospace;
  letter-spacing:1px;
  border-bottom:1px solid #a9a98a;
  padding-bottom:13px;
  margin-bottom:24px
}
.red-type {
  font:bold 9px/1.4 'Courier New',monospace!important;
  letter-spacing:1.5px;
  color:#96513d;
  margin-bottom:14px!important
}
.briefing-sheet h2,.tea-sheet h2 {
  font:700 38px/1.05 Georgia,serif;
  letter-spacing:-.8px;
  max-width:470px
}
.briefing-date {
  display:inline-block;
  margin-top:19px;
  border:2px solid #925b43;
  color:#925b43;
  padding:4px 12px;
  font:bold 11px 'Courier New',monospace;
  letter-spacing:2px;
  transform:rotate(-4deg)
}
.briefing-intro {
  font:14px/1.85 Georgia,serif;
  margin-top:22px!important;
  max-width:510px
}
.training-note {
  margin-top:21px;
  border-left:3px solid #637955;
  background:#c7c7a640;
  padding:12px 15px
}
.training-note>b {
  font:9px 'Courier New',monospace;
  letter-spacing:1.6px
}
.training-note>p {
  margin-top:7px;
  font:12px/1.7 'Courier New',monospace
}
.briefing-foot {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:18px;
  margin-top:28px
}
.briefing-foot>span {
  font:italic 12px/1.6 Georgia,serif;
  color:#77785a
}
.approve-button {
  background:#335a42;
  color:#ece4c6!important;
  border:1px solid #233e2b;
  box-shadow:0 4px 0 #183524;
  border-radius:2px;
  padding:15px 22px;
  font:bold 11px 'Courier New',monospace!important;
  letter-spacing:1px;
  min-height:48px
}
.approve-button:hover {
  background:#426d4c
}
.approve-button:active {
  transform:translateY(2px);
  box-shadow:0 2px 0 #183524
}
.paper-fineprint {
  display:block;
  font:8px/1.6 'Courier New',monospace;
  color:#85866a;
  border-top:1px solid #b3b395;
  padding-top:12px;
  margin-top:24px
}
.amendment-sheet {
  background:#e4cd99;
  border-top:10px solid #a45e40;
  transform:rotate(1deg)
}
.amendment-sheet>.approve-button {
  margin-top:24px
}
.amendment-sheet h2 {
  font-size:36px
}
.tea-sheet {
  text-align:center;
  width:460px;
  padding:32px
}
.tea-sheet h2 {
  font-size:34px
}
.tea-sheet>p:not(.red-type) {
  font:14px/1.8 Georgia,serif;
  margin:16px 0 24px
}
.tea-sheet>.paper-link {
  display:block;
  margin:14px auto 0
}
.tea-cup {
  width:66px;
  height:52px;
  background:linear-gradient(90deg,#b0b6a1,#e3e2c4);
  margin:0 auto 26px;
  border:3px solid #778875;
  border-radius:4px 4px 35% 35%;
  box-shadow:0 9px 0 -4px #9aa785;
  position:relative
}
.tea-cup:before {
  content:'';
  position:absolute;
  width:25px;
  height:32px;
  border:6px solid #aab5a0;
  right:-24px;
  top:4px;
  border-left:0;
  border-radius:0 50% 50% 0
}
.tea-cup:after {
  content:'';
  position:absolute;
  left:10px;
  right:10px;
  top:-5px;
  height:10px;
  background:#676143;
  border-radius:50%;
  border:3px solid #cbd0b5
}
.settings-sheet {
  width:610px
}
.settings-sheet>p:not(.red-type):not(.briefing-intro) {
  font:12px/1.75 'Courier New',monospace;
  margin:15px 0
}
.settings-controls {
  display:flex;
  gap:10px;
  margin-top:22px
}
.paper-button,.book-tab {
  background:#d7d4b6;
  border:1px solid #8f9e7b;
  color:#405938!important;
  padding:11px 15px;
  min-height:44px;
  font:10px 'Courier New',monospace!important;
  box-shadow:0 2px 0 #66745140
}
.paper-button:hover,.book-tab:hover {
  background:#ece5c9
}
.settings-keys {
  border-top:1px solid #b5b497;
  border-bottom:1px solid #b5b497;
  padding:12px 0
}
.settings-sheet>.paper-link {
  display:block;
  margin-top:14px
}
.danger-link {
  color:#944f3c!important
}
.danger-button {
  background:#8e513b;
  margin-top:12px
}
.tea-sheet>.paper-button {
  margin-right:8px
}
.report-ledger {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  margin-top:24px;
  border-top:1px solid #919a7b;
  border-bottom:1px solid #919a7b;
  padding:13px 0;
  gap:16px
}
.report-ledger>span {
  font:8px 'Courier New',monospace;
  letter-spacing:1px
}
.report-ledger strong {
  display:block;
  font:26px 'Courier New',monospace;
  margin-top:6px
}
.report-memory {
  padding:15px 18px;
  margin:21px 0;
  border-left:2px solid #a3a587;
  background:#d3cfb047
}
.report-memory small {
  font:8px 'Courier New',monospace;
  letter-spacing:1px
}
.report-memory p {
  font:italic 13px/1.7 Georgia,serif;
  margin-top:7px
}
.report-sheet>.approve-button {
  margin-top:22px
}
.open-handbook {
  width:880px;
  max-width:100%;
  max-height:calc(100% - 20px);
  overflow:hidden;
  border:9px solid #35563c;
  border-left:17px solid #2a4932;
  background:#e6ddc2;
  box-shadow:0 20px 80px #0008,9px 8px 0 #bbba99;
  color:#35482e;
  display:flex;
  flex-direction:column
}
.book-header {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  padding:23px 26px 17px;
  border-bottom:1px solid #a2ad88;
  background:#dcd6b8
}
.book-header h2 {
  font:28px/1.2 Georgia,serif;
  margin-top:4px
}
.book-header .eyebrow {
  font-size:8px;
  color:#6c805d
}
.book-tabs {
  display:flex;
  gap:4px;
  padding:0 22px;
  background:#dcd6b8;
  border-bottom:2px solid #8c9e74
}
.book-tab {
  border-bottom:0;
  box-shadow:none;
  letter-spacing:.3px;
  border-radius:4px 4px 0 0;
  font-size:10px!important
}
.book-tab.active {
  background:#526e46;
  color:#e9e3c8!important;
  border-color:#465e38
}
.book-pages {
  padding:22px 27px 26px;
  overflow:auto;
  max-height:67dvh;
  background:linear-gradient(90deg,transparent 48%,#959c7315 49%,#586f4620 50%,transparent 52%);
  overscroll-behavior:contain
}
.rule-spread {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:21px 33px
}
.book-notice {
  background:#d2cfac77;
  border:1px solid #a3ad87;
  padding:12px 15px;
  grid-column:1 / -1
}
.book-notice b {
  font:bold 9px 'Courier New',monospace;
  letter-spacing:1px
}
.book-notice p {
  font:12px/1.7 Georgia,serif;
  margin-top:5px
}
.regulation {
  display:flex;
  gap:11px;
  border-bottom:1px dotted #a3a788;
  padding-bottom:14px
}
.clause-number {
  flex:0 0 30px;
  align-self:flex-start;
  background:#566e47;
  color:#ece5c4;
  padding:4px 1px;
  text-align:center;
  font:11px 'Courier New',monospace
}
.regulation h3 {
  font:bold 10px/1.5 'Courier New',monospace;
  margin-bottom:6px
}
.regulation p {
  font:12px/1.7 Georgia,serif
}
.book-introduction {
  font:13px/1.8 Georgia,serif;
  margin-bottom:20px!important
}
.directory-table {
  width:100%;
  border-collapse:collapse;
  background:#e9e1c9b0;
  margin-bottom:22px
}
.directory-table th {
  font:8px 'Courier New',monospace;
  text-align:left;
  letter-spacing:1px;
  padding:10px;
  border-bottom:2px solid #81946f
}
.directory-table td {
  padding:12px 10px;
  border-bottom:1px solid #afb799;
  font:12px 'Courier New',monospace
}
.directory-table td:first-child {
  font-size:25px;
  font-weight:bold
}
.directory-table td strong {
  font:bold 11px 'Courier New',monospace
}
.directory-table td small {
  display:block;
  font:10px/1.6 Georgia,serif;
  margin-top:5px;
  color:#6a795b
}
.handling-page {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:22px 32px
}
.handling-page h3,.incident-entry h3 {
  font:bold 13px/1.4 Georgia,serif;
  margin-bottom:7px
}
.handling-page p,.incident-entry p {
  font:12px/1.75 Georgia,serif
}
.incident-entry {
  margin-bottom:17px;
  border-bottom:1px dashed #aeb495;
  padding-bottom:16px
}
.incident-entry small {
  font:8px 'Courier New',monospace;
  letter-spacing:1px;
  color:#727e60;
  display:block;
  margin-bottom:5px
}
.book-footer {
  display:flex;
  justify-content:space-between;
  gap:12px;
  background:#d4d0af;
  border-top:1px solid #a3ad89;
  padding:10px 22px;
  font:6px 'Courier New',monospace;
  letter-spacing:1px
}
.frozen .postal-facility * {
  animation-play-state:paused!important
}
.reduced-motion * {
  animation:none!important;
  transition:none!important;
  scroll-behavior:auto!important
}
.reduced-motion .parcel-host {
  will-change:auto
}
.reduced-motion .stolen-label {
  left:48%;
  top:60%;
  transform:rotate(22deg)
}
.reduced-motion .whisper-evidence {
  opacity:1
}
.reduced-motion .xray-window.scanning .xray-beam {
  top:50%
}
@keyframes po-belt {
  to {
    background-position:120px 0
  }
}
@keyframes po-worker {
  0%,100% {
    transform:translateX(-45px)
  }
  45%,55% {
    transform:translateX(70px)
  }
}
@keyframes po-tube {
  0%,30% {
    transform:translateY(-60px)
  }
  75%,100% {
    transform:translateY(220px)
  }
}
@keyframes po-breathe {
  0%,100% {
    height:16px
  }
  50% {
    height:34px
  }
}
@keyframes po-tongue {
  0%,100% {
    height:15px;
    transform:rotate(10deg)
  }
  50% {
    height:35px;
    transform:rotate(-15deg)
  }
}
@keyframes po-buzz {
  0%,100% {
    transform:translate(0,0)
  }
  30% {
    transform:translate(1px,-.5px)
  }
  70% {
    transform:translate(-1px,.5px)
  }
}
@keyframes po-bee {
  0%,100% {
    transform:translate(0,0) rotate(6deg)
  }
  30% {
    transform:translate(18px,-12px) rotate(30deg)
  }
  70% {
    transform:translate(-12px,14px) rotate(-10deg)
  }
}
@keyframes po-whisper {
  0%,100% {
    opacity:.45;
    transform:translateY(0) rotate(-12deg)
  }
  50% {
    opacity:1;
    transform:translateY(-6px) rotate(-8deg)
  }
}
@keyframes po-foot {
  from {
    transform:rotate(-12deg)
  }
  to {
    transform:rotate(20deg)
  }
}
@keyframes po-portal {
  to {
    transform:rotate(360deg)
  }
}
@keyframes po-xray {
  to {
    top:100%
  }
}
@keyframes po-scan {
  0% {
    left:30%
  }
  100% {
    left:70%
  }
}
@keyframes po-stamp {
  0% {
    transform:translateY(0) rotate(0)
  }
  35% {
    transform:translateY(-22px) rotate(-5deg)
  }
  65% {
    transform:translateY(6px) rotate(0)
  }
  100% {
    transform:translateY(0)
  }
}
@keyframes po-label {
  0% {
    left:24%;
    top:-10%;
    transform:rotate(0) scale(1)
  }
  100% {
    left:48%;
    top:68%;
    transform:rotate(95deg) scale(.25)
  }
}
