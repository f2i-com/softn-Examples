  padding:9px;
  gap:10px
}
.scanner-unit {
  position:relative;
  background:#778371;
  border:2px solid #2f4737;
  border-radius:3px;
  padding:6px;
  box-shadow:2px 2px 0 #203c2d77
}
.scanner-display {
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  justify-content:center;
  background:repeating-linear-gradient(0deg,#203b2f 0px,#203b2f 2px,#223f31 3px,#223f31 4px);
