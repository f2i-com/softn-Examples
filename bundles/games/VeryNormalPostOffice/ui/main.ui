  top:72px
}
.ray-bees .object-three {
  display:block;
  left:48px;
  top:96px
}
.ray-bees .object-four {
  display:block;
  left:141px;
  top:31px
}
.ray-bees .ray-object:before {
  content:'';
  position:absolute;
  width:24px;
  height:14px;
  border-radius:50%;
  border:1px solid #afc68c;
  left:-4px;
  top:-10px
}
