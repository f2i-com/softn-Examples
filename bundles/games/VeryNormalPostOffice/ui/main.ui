  color:#cbe2b1;
  font:9px 'Courier New',monospace
}
.radiation-label {
  position:absolute;
  bottom:4px;
  left:5px;
  right:5px;
  background:#afaa74;
  font:6px/13px 'Courier New',monospace;
  text-align:center;
  border:1px solid #3b523a
}
.parcel-host {
  position:absolute;
  width:226px;
  height:168px;
  z-index:8;
  will-change:left,top,transform;
  transition:left .12s linear,top .12s linear,transform .16s,opacity .1s
}
.parcel-drag {
  width:100%;
  height:100%;
  touch-action:none
}
.carton {
  position:relative;
  display:block;
  width:100%;
  height:100%;
  border:0;
  padding:0;
  background:transparent;
  cursor:grab!important;
  appearance:none;
  touch-action:none;
  user-select:none;
  outline-offset:18px!important;
  color:#3d392c!important
}
.carton:active {
  cursor:grabbing!important
}
.carton-shadow {
  position:absolute;
  left:0;
  top:80%;
  width:125%;
  height:28%;
  border-radius:50%;
  background:#142d2360;
  filter:blur(10px);
  transform:rotate(3deg)
}
.carton-front {
  position:absolute;
  inset:0;
  background:repeating-linear-gradient(2deg,transparent 0px,transparent 4px,#75552d08 5px,#75552d08 6px),linear-gradient(130deg,#c9a36f,#b28c59 75%);
  border:2px solid #795b36;
  box-shadow:inset 0 0 9px #7d62372a,0 2px 2px #0003
}
.carton-top {
  position:absolute;
  bottom:100%;
  left:0;
  width:100%;
  height:31px;
  background:repeating-linear-gradient(90deg,#c4a16f 0,#c4a16f 56px,#b18d5b 57px,#c4a16f 59px);
  border:2px solid #82643b;
  transform:skewX(-32deg);
  transform-origin:bottom left
}
.carton-side {
  position:absolute;
  left:100%;
  bottom:0;
  width:20px;
  height:100%;
  background:linear-gradient(90deg,#8e6e42,#aa8550);
  border:2px solid #71532f;
  transform:skewY(-58deg);
  transform-origin:bottom left
}
.packing-tape {
  position:absolute;
  left:39%;
  top:0;
  width:30px;
  height:100%;
  background:linear-gradient(90deg,#dfc89570,#c4ab7880,#dfc89560);
  border-left:1px dashed #ad976254;
  border-right:1px dashed #947b4940
}
.packing-tape:before {
  content:'';
  position:absolute;
  bottom:100%;
  left:0;
  width:30px;
  height:31px;
  transform:skewX(-32deg);
  transform-origin:bottom left;
  background:#dbc48990;
  border:1px solid #a88d6050
}
.shipping-label {
  position:absolute;
  left:27px;
  right:23px;
  top:27px;
  padding:9px 9px 6px;
  background:#e6debf;
  box-shadow:1px 2px 0 #6c593a55;
  transform:rotate(2deg);
  display:block;
