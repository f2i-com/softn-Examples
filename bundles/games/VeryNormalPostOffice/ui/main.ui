  font-weight:700;
  letter-spacing:2px
}
.base-label>.barcode {
  width:100px;
  height:14px
}
.base-label strong {
  font-size:10px
}
.permit-mark {
  font:bold 8px 'Courier New',monospace;
  border:1px solid #6f7459;
  padding:4px
}
.ink-imprint {
  position:absolute;
  bottom:12px;
  right:-7px;
  padding:3px 7px;
  border:3px double currentColor;
  transform:rotate(-13deg);
