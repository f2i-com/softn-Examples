}
.bee {
  position:absolute;
  width:11px;
  height:8px;
  border-radius:50%;
  background:repeating-linear-gradient(90deg,#c7aa58 0,#c7aa58 3px,#334032 3px,#334032 6px);
  box-shadow:0 2px 3px #263b2a40;
  z-index:20
}
.bee:before,.bee:after {
  content:'';
  position:absolute;
  top:-5px;
  width:8px;
  height:7px;
  background:#d6e6c6c9;
  border:1px solid #a0b79c;
  border-radius:50%;
  transform:rotate(35deg);
  left:0
}
.bee:after {
  left:6px;
  transform:rotate(-35deg)
}
.bee-one {
  top:15px;
  right:-26px;
  animation:po-bee 4s ease-in-out infinite
}
.bee-two {
  top:-42px;
  right:33px;
  animation:po-bee 3s ease-in-out -1s infinite
}
.bee-three {
  bottom:32px;
  right:-35px;
  animation:po-bee 3.8s ease-in-out -2s infinite
}
.whisper-evidence {
  position:absolute;
  right:-26px;
  top:-35px;
  color:#dde0bf;
  font:italic 12px Georgia,serif;
  letter-spacing:5px;
