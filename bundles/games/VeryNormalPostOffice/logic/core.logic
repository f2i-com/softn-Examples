// Shared state and platform boundary. Gameplay never reaches into the DOM.
let S = null;
let V = {};
let settings = { muted: false, reducedMotion: false };
let profile = { best: 0, completed: 0 };
let paused = false;
let bookOpen = false;
let bookPage = "today";
let helpOpen = false;
let confirmReset = false;
let saveStatus = "Local file cabinet ready";
let fx = { kind: "", ticks: 0, serial: 0 };
let lastClock = 0;
let accumulator = 0;
let saveTicks = 0;
let dragSerial = 0;
let dragActive = false;
let dragStartedAt = 0;
let suppressClickTicks = 0;
let inputInstalled = false;
let soundTicks = {};
let soundUnavailable = false;
function clamp(n, lo, hi) { return Math.max(lo, Math.min(hi, n)); }
function copy(value) { return JSON.parse(JSON.stringify(value)); }
function rng() { S.seed = (S.seed * 48271) % 2147483647; return S.seed / 2147483647; }
function randomInt(a, b) { return a + Math.floor(rng() * (b - a + 1)); }
function currentParcel() { return S && S.current ? S.current : null; }
function isWorking() { return !!S && S.phase === "work" && !paused && !bookOpen && !helpOpen && !confirmReset; }
function interactionReady() { return isWorking() && !S.transit && !S.toolJob; }
function note(text) { if (S)
    S.message = String(text); }
function triggerFx(kind, ticks) { fx = { kind: kind, ticks: ticks || 20, serial: fx.serial + 1 }; }
function playSound(name) {
    if (settings.muted || !S)
        return;
    let stamp = soundTicks[name];
    if (stamp !== undefined && S.tick - stamp < 3)
        return;
    soundTicks[name] = S.tick;
    try {
        softn.audio.play("assets/sfx/" + name + ".wav", { volume: name === "buzz" ? 0.18 : 0.34 });
    }
    catch (err) {
        soundUnavailable = true;
    }
}
function resetTransient() {
    paused = false;
    bookOpen = false;
    helpOpen = false;
    confirmReset = false;
    dragActive = false;
    dragStartedAt = 0;
    dragSerial++;
    accumulator = 0;
    saveTicks = 0;
    lastClock = 0;
    soundTicks = {};
    suppressClickTicks = 0;
    fx = { kind: "", ticks: 0, serial: 0 };
}
function rememberIncident(title, text, parcel) {
    S.incidents.unshift({ title: title, text: text, parcel: parcel ? parcel.serial : "FACILITY", shift: S.stage + 1 });
    if (S.incidents.length > 16)
        S.incidents.pop();
}
function action(id) {
    if (id === "book") {
        if (S && S.phase === "work") {
            bookOpen = !bookOpen;
            dragActive = false;
            lastClock = 0;
            playSound("paper");
        }
        publish();
        return;
    }
    if (id === "help") {
        helpOpen = !helpOpen;
        dragActive = false;
        lastClock = 0;
        publish();
        return;
    }
    if (id === "pause") {
        if (S && S.phase === "work") {
            paused = !paused;
            dragActive = false;
            lastClock = 0;
            persist();
        }
        publish();
        return;
    }
    if (id === "sound") {
        settings.muted = !settings.muted;
        if (settings.muted) {
            try {
                softn.audio.stopAll();
            }
            catch (e) { }
        }
        persist();
        publish();
        return;
    }
    if (id === "motion") {
        settings.reducedMotion = !settings.reducedMotion;
        persist();
        publish();
        return;
    }
    if (id === "reset-request") {
        confirmReset = !confirmReset;
        publish();
        return;
    }
    if (id === "reset-confirm") {
        if (confirmReset)
            newCampaign(9041968);
        publish();
        return;
    }
    if (id === "begin") {
        beginShift();
        publish();
        return;
    }
    if (id === "acknowledge") {
        acknowledgeNotice();
        publish();
        return;
    }
    if (id === "next-shift") {
        advanceShift();
        publish();
        return;
    }
    if (id === "retry") {
        retryShift();
        publish();
        return;
    }
    if (!isWorking())
        return;
    if (id === "separator") {
        S.machine.separator = !S.machine.separator;
        triggerFx("separator", 12);
        playSound("lever");
        note(S.machine.separator ? "Separator raised. No neighbouring paperwork within reach." : "Separator lowered. Please keep your labels to yourself.");
    }
    else if (id === "jam") {
        if (S.machine.jam) {
            S.machine.jam = false;
            playSound("lever");
            triggerFx("cleared", 18);
            note("Belt cleared. The offending claim form has been shredded in self-defence.");
        }
    }
    else if (id === "reference") {
        referenceWeight();
    }
    else if (id === "zero") {
        calibrateScale();
    }
    else if (id === "ink-red" || id === "ink-black") {
        if (!S.toolJob && !S.transit) {
            S.ink = id === "ink-red" ? "red" : "black";
            playSound("paper");
        }
    }
    else if (id.indexOf("route:") === 0) {
        dispatchParcel(id.slice(6));
    }
    else if (id === "receive") {
        receiveParcel();
    }
    else {
        useTool(id);
    }
    persist();
    publish();
}
function openBook(page) { bookPage = page; bookOpen = true; dragActive = false; lastClock = 0; playSound("paper"); publish(); }
function turnPage(page) { bookPage = page; playSound("paper"); publish(); }
function parcelClick() { if (suppressClickTicks <= 0)
    action("inspect"); }
function startDrag() { if (interactionReady() && S.current) {
    dragActive = true;
    dragStartedAt = Date.now();
    publish();
} }
function endDrag(pos) {
    dragActive = false;
    dragSerial++;
    suppressClickTicks = 5;
    if (!interactionReady() || !S.current || !pos) {
        publish();
        return;
    }
    let x = Number(pos.x || 0);
    let y = Number(pos.y || 0);
    if (Math.abs(x) > Math.abs(y) && x < -55)
        useTool("weigh");
    else if (Math.abs(x) > Math.abs(y) && x > 55)
        useTool("xray");
    else if (y > 55)
        useTool("stamp");
    else if (y < -55)
        useTool("rotate");
    else
        useTool("inspect");
    persist();
    publish();
}
function keyDown(e) {
    let k = String(e.key || "");
    if (k.length === 1)
        k = k.toLowerCase();
    let tag = String(e.targetTag || (e.target && e.target.tagName) || "").toLowerCase();
    if (tag === "input" || tag === "textarea" || tag === "select" || e.repeat)
        return;
    if ((k === " " || k === "Enter") && tag === "button")
        return;
    if (k === "Escape") {
        if (confirmReset)
            confirmReset = false;
        else if (helpOpen)
            helpOpen = false;
        else if (bookOpen)
            bookOpen = false;
        else if (S && S.phase === "work")
            paused = !paused;
        lastClock = 0;
        publish();
        return;
    }
    if (k === "p") {
        action("pause");
        return;
    }
    if (k === "h") {
        action("book");
        return;
    }
    if (k === "m") {
        action("sound");
        return;
    }
    if (k === "Enter" && S && S.phase === "briefing") {
        action("begin");
        return;
    }
    if (!isWorking())
        return;
    let mapping = { i: "inspect", r: "rotate", e: "scan", w: "weigh", x: "xray", s: "stamp", c: "clamp", q: "flap", b: "biscuit", g: "separator", z: "zero", j: "jam", " ": "receive", "1": "route:LOCAL", "2": "route:FAR", "3": "route:FREIGHT", "4": "route:QUARANTINE" };
    if (mapping[k]) {
        if (e.preventDefault)
            e.preventDefault();
        action(mapping[k]);
    }
}
function cancelDrag() { if (dragActive) {
    dragActive = false;
    dragSerial++;
    suppressClickTicks = 5;
    publish();
} }
function loseFocus() { if (S && S.phase === "work") {
    paused = true;
    dragActive = false;
    dragSerial++;
    lastClock = 0;
    persist();
    publish();
} }
function installInput() {
    if (inputInstalled)
        return;
    try {
        window.addEventListener("keydown", keyDown);
        window.addEventListener("blur", loseFocus);
        inputInstalled = true;
    }
    catch (err) { }
    // Pointer cancellation is optional in older hosts; the drag lease below
    // provides a safe tea break if a host never delivers pointer-up/cancel.
    try {
        window.addEventListener("pointercancel", cancelDrag);
    }
    catch (err) { }
}
function disposeInput() {
    if (!inputInstalled)
        return;
    try {
        window.removeEventListener("keydown", keyDown);
        window.removeEventListener("blur", loseFocus);
        window.removeEventListener("pointercancel", cancelDrag);
    }
    catch (err) { }
    inputInstalled = false;
}
