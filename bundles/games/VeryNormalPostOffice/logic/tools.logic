// Inspection tools expose evidence, never the computed destination.
function markTool(p, kind) { p.seen[kind] = true; }
function referenceWeight() {
    if (!interactionReady())
        return;
    S.machine.referenceOn = true;
    S.viewTool = "weigh";
    note("Certified reference: 1 kg. Dial reads " + (1 + S.machine.bias) + " kg." + (S.machine.bias ? " Turn ZERO while the reference is on the pan." : " Calibration agrees."));
    triggerFx("reference", 18);
    playSound("metal");
}
function calibrateScale() {
    if (!interactionReady())
        return;
    if (!S.machine.referenceOn) {
        note("Place the certified 1 kg reference on the scale before turning ZERO.");
        return;
    }
    if (S.machine.calibrated && S.machine.bias === 0) {
        note("Reference reads 1 kg. The scale is already verified. Weigh the parcel next.");
        return;
    }
    S.machine.bias = 0;
    S.machine.calibrated = true;
    S.machine.calibration++;
    note("Calibration corrected. Reference reads 1 kg. Take a NEW reading of the parcel.");
    rememberIncident("A trustworthy kilogram", "The certified 1 kg weight corrected the municipal scale.", null);
    playSound("lever");
    triggerFx("calibrated", 20);
    persist();
}
function useTool(kind) {
    if (!interactionReady())
        return;
    let p = currentParcel();
    if (!p) {
        note("The next parcel is arriving. Keep the mat clear.");
        return;
    }
    let allowed = ["inspect", "rotate", "scan", "weigh", "xray", "stamp", "clamp", "flap", "biscuit"];
    if (allowed.indexOf(kind) < 0)
        return;
    if (kind === "inspect") {
        p.inspected = true;
        markTool(p, kind);
        S.viewTool = "inspect";
        note(p.labelDamaged ? "The paper address has been eaten. Scan the permanent underside barcode; compare it with the directory." : "Read the parcel's district code. Compare it with the postal handbook directory. Rotate for the base and seals.");
        playSound("paper");
        return;
    }
    if (kind === "rotate") {
        p.face = (p.face + 1) % 3;
        p.inspected = true;
        markTool(p, kind);
        S.viewTool = "inspect";
        if (p.face === 2)
            p.measured = true;
        note(p.face === 0 ? "Address face." : (p.face === 1 ? "Rear face. The flap and seal are visible; behaviour is evidence too." : "Base face. Width, permit and permanent barcode. Compare with today's circular."));
        triggerFx("rotate", 10);
        playSound("paper");
        return;
    }
    if (kind === "clamp" && p.clamped) {
        note("The parcel is already secured to this particular location.");
        return;
    }
    if (kind === "biscuit" && p.fed) {
        note("One certified packing biscuit per parcel. Procurement insists.");
        return;
    }
    if (kind === "flap" && p.type === "infinite" && p.layers === 0) {
        note("Core exposed. Scan it before quarantine.");
        return;
    }
    if (kind === "stamp" && !p.inspected) {
        note("Read the label before certifying its inspection.");
        return;
    }
    let duration = { scan: 18, weigh: 20, xray: 24, stamp: 12, clamp: 12, flap: 16, biscuit: 14 };
    S.toolJob = { kind: kind, ticks: duration[kind], total: duration[kind], ink: S.ink };
    S.viewTool = kind;
    if (kind === "flap")
        p.face = 1;
    if (kind === "weigh")
        S.machine.referenceOn = false;
    if (kind === "stamp")
        triggerFx("stamp", 16);
    else
        triggerFx(kind, duration[kind]);
    playSound(kind === "weigh" ? (p.weight > 10 ? "heavy" : "metal") : (kind === "flap" ? "paper" : kind));
}
function finishTool() {
    let job = S.toolJob;
    let p = S.current;
    S.toolJob = null;
    if (!job || !p)
        return;
    markTool(p, job.kind);
    if (job.kind === "scan") {
        p.scanned = true;
        if (p.type === "infinite" && p.layers === 0)
            p.coreScanned = true;
        note(p.coreScanned ? "Core serial verified. The nested consignment is now resolved; consult clause D4." : "Permanent code: " + p.code + ". Cross-reference the directory. Scanner cannot certify mass or live contents.");
        playSound("scan-done");
    }
    else if (job.kind === "weigh") {
        p.weighed = true;
        p.weightReading = p.weight + S.machine.bias;
        p.weightCalibration = S.machine.calibration;
        note("Exterior mass: " + p.weightReading + " kg." + (S.machine.calibrated ? " Verified reading." : " UNVERIFIED: compare the 1 kg reference and zero the scale."));
    }
    else if (job.kind === "xray") {
        p.xrayed = true;
        note("X-ray complete. Interior mass: " + p.innerWeight + " kg. Study the silhouette; this device does not make routing decisions.");
        playSound("scan-done");
    }
    else if (job.kind === "stamp") {
        p.stampInk = job.ink;
        p.stampRevision = S.revision;
        note("INSPECTED / " + job.ink.toUpperCase() + " INK. Choose a destination using the brass cage plates.");
        triggerFx("imprint", 18);
        playSound("stamp");
    }
    else if (job.kind === "clamp") {
        p.clamped = true;
        p.position = 0;
        note("Containment clamp secured. Movement is not a forwarding address.");
        playSound("metal");
    }
    else if (job.kind === "biscuit") {
        p.fed = true;
        note(p.type === "hungry" ? "The mouth accepts the packing biscuit. It will leave its neighbour alone. Its handling classification has NOT changed." : "Biscuit placed beside parcel. The parcel declines to comment.");
        if (p.type === "hungry")
            rememberIncident("A negotiated lunch break", "A packing biscuit saved the adjacent address label. Teeth still require quarantine.", p);
        triggerFx("crumbs", 26);
        playSound("paper");
    }
    else if (job.kind === "flap") {
        if (p.type !== "infinite" && p.flapOpened) {
            p.flapOpened = false;
            note("Inspection flap closed. Any recorded breach remains on the incident form.");
            triggerFx("flap", 18);
            persist();
            return;
        }
        p.flapOpened = true;
        if (p.type === "infinite") {
            p.layers--;
            p.scanned = false;
            p.coreScanned = false;
            p.xrayed = false;
            note(p.layers ? "Inside: another box. The nested mark persists. " + p.layers + " sealed layers remain." : "A very small core casts a very large shadow. Scan the exposed serial before quarantine.");
            triggerFx("nested", 30);
            playSound("warp");
        }
        else if (p.type === "whisper" || p.type === "hungry" || p.type === "bees" || p.type === "portal") {
            if (!p.breached) {
                p.breached = true;
                safetyBreach(p);
            }
        }
        else {
            note("Under the inspection flap: two socks and an apologetic note. Please reseal by stamping.");
            triggerFx("flap", 25);
        }
    }
    persist();
}
