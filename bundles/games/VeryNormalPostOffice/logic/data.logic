// Municipal Post Office 04. Pure catalogue; no presentation or platform calls.
let GAME_ID = "very-normal-post-office";
let GAME_VERSION = 2;
let SAVE_KEY = "very-normal-post-office:inspection:v2";
let TITLE = "VERY NORMAL POST OFFICE";
let ROUTES = ["LOCAL", "FAR", "FREIGHT", "QUARANTINE"];
let PARCEL_TYPES = ["normal", "fragile", "runner", "heavy", "reverse", "bees", "hungry", "whisper", "teleport", "portal", "density", "infinite"];
let DIRECTORY = [
    { code: "LS", name: "LOWER STAIR", route: "LOCAL", note: "Including the stairs below the stairs." },
    { code: "NW", name: "NORTH WEIR", route: "LOCAL", note: "Both banks. Not the water." },
    { code: "WF", name: "WEST FEN", route: "FAR", note: "Ferry service remains technically operational." },
    { code: "RD", name: "RED DALE", route: "FAR", note: "No connection to the colour of postage." },
    { code: "X0", name: "NULL WARD", route: "QUARANTINE", note: "District erased in 1968. DO NOT deliver." }
];
let SHIFT_DEFS = [
    { name: "A respectable occupation", day: "MONDAY", subtitle: "Orientation / window 04", intro: "Read the address label. Cross-reference its two-letter district in the directory. Apply an INSPECTED stamp, then send it to the right cage. Nothing is timed. Probably for the best.", lesson: "Click the arriving parcel to read its label. LS and NW are LOCAL; WF and RD are FAR. Use the wooden stamp before a cage.", types: ["normal", "normal", "fragile", "normal", "normal", "fragile"], revisionAt: 0 },
    { name: "Weight of evidence", day: "MONDAY", subtitle: "Late collection / do not chase the mail", intro: "Use the analogue scale: over 10 kg is FREIGHT. Moving parcels must be clamped. Labels with reversed print cannot be trusted: scan their permanent barcode and consult the directory.", lesson: "Weigh parcels. Clamp anything trying to leave. A reversed label is not a reversed destination: read the barcode.", types: ["heavy", "runner", "reverse", "normal", "heavy", "runner", "reverse"], revisionAt: 0 },
    { name: "A permit for the bees", day: "TUESDAY", subtitle: "Live freight / keep your fingers", intro: "Bees may travel ONLY on Tuesday with a BEE-2 permit on the base. All other bees go to QUARANTINE. Talking parcels and parcels with teeth also go there. Never open a whispering parcel.", lesson: "Rotate to the base to check permits. X-ray shows physical contents, not the correct route. Observe before touching the flap.", types: ["bees", "bees", "whisper", "normal", "hungry", "heavy", "bees", "whisper"], revisionAt: 0 },
    { name: "Correction, effective now", day: "WEDNESDAY", subtitle: "Circular 33 / please initial the amendment", intro: "The shift begins under yesterday's handling rules. A new circular will arrive after parcel 4. Incoming mail stops while you read it. Amendments never change a parcel already being processed.", lesson: "Keep the notice board in view. An amendment will suspend red ink and parcels exactly 33 cm wide.", types: ["normal", "bees", "heavy", "reverse", "normal", "fragile", "normal", "heavy"], revisionAt: 4 },
    { name: "Please respect personal space", day: "THURSDAY", subtitle: "Shared conveyor / approved biscuit provided", intro: "Hungry parcels will eat a neighbouring address label. Raise the separator or offer the packing biscuit. A missing paper label is recoverable: the permanent barcode is on the parcel's underside. Do not punish its neighbour for being lunch.", lesson: "A hungry parcel can reach the next box. Use the separator or biscuit. Scan a damaged label to recover its district code.", types: ["hungry", "normal", "teleport", "hungry", "reverse", "normal", "bees", "whisper"], revisionAt: 0 },
    { name: "The equipment is trustworthy", day: "FRIDAY", subtitle: "Calibration day / statement under review", intro: "The scale has drifted. Put the certified 1 kg weight on it, then turn ZERO. Only a verified scale reading counts. The electronic cage signs have also crossed their wires: trust the fixed brass plates, not the illuminated signs.", lesson: "Check the 1 kg reference weight and zero the scale before weighing. Brass destination plates remain correct.", types: ["normal", "heavy", "runner", "normal", "reverse", "heavy", "bees", "whisper"], revisionAt: 0 },
    { name: "Additional interior space", day: "SATURDAY", subtitle: "Dimensional services / appendix 8,412", intro: "If the X-ray's interior mass exceeds the scale's exterior mass, use FREIGHT. Portals still go to QUARANTINE. A parcel with the nested-box symbol may be safely unwrapped, one layer at a time. Scan the bare core before quarantine. Clamp a parcel that changes position without crossing the space between.", lesson: "Compare X-ray mass with scale mass. Not all impossible parcels are prohibited. The nested-box mark identifies the safe flap.", types: ["density", "teleport", "portal", "infinite", "heavy", "reverse", "density", "normal"], revisionAt: 0 },
    { name: "Return to sender", day: "TUESDAY", subtitle: "Tuesday again / final collection", intro: "It is officially Tuesday, whatever the clock says. All learned handling rules apply. Red ink and 33 cm widths are suspended from the start. Calibrate the scale. After parcel 5, FAR service is suspended. Resolve the final nested core and quarantine it. You have all the time you need.", lesson: "Safety overrides freight, freight overrides the address. Circulars stop the belt. Read, observe, cross-reference. Do not let the post office hurry you.", types: ["bees", "density", "hungry", "reverse", "runner", "normal", "teleport", "whisper", "bees", "infinite"], revisionAt: 5 }
];
let RECIPIENTS = ["MRS. E. BELL", "DEPT. OF SMALL ERRORS", "A. PERSON, ESQ.", "THE OTHER POST OFFICE", "DR. M. OTH", "MUNICIPAL AQUARIUM", "OFFICE OF LOST TUESDAYS", "N. O. BODY", "MISS I. N. TRAY", "THE LAST TENANT", "B. KEEPING", "MR. L. ATER"];
let STREETS = ["8 Stair Street", "4 Municipal Lane", "11 Receipt Row", "2 Sorting Court", "19 Paper Mill Road", "6 Latch Close", "12 Queue Avenue", "1 Unfinished Street"];
let INCIDENT_NAMES = { bees: "Unscheduled pollination", hungry: "A form has been consumed", whisper: "Confidential correspondence", runner: "Mail without a forwarding address", teleport: "A continuity complaint", portal: "Another entrance, no exit", density: "More inside than advertised", infinite: "Appendix 8,412" };
