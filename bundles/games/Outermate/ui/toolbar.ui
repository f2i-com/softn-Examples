<nav className="om-toolbar" aria-label="Game panels">
 <button className={activePanel === "day" ? "is-active" : ""} @click={() => setPanel("day")}><img src={asset("assets/sprites/icon-clock.svg")} alt="" /><span>Day</span></button>
 <button className={activePanel === "routine" ? "is-active" : ""} @click={() => setPanel("routine")}><img src={asset("assets/sprites/icon-plan.svg")} alt="" /><span>Routine</span></button>
 <button className={activePanel === "crew" ? "is-active" : ""} @click={() => setPanel("crew")}><img src={asset("assets/sprites/icon-crew.svg")} alt="" /><span>Crew</span></button>
 <button className={activePanel === "inventory" ? "is-active" : ""} @click={() => setPanel("inventory")}><img src={asset("assets/sprites/icon-bag.svg")} alt="" /><span>Pockets</span></button>
 <button className={"om-tab-extra "+(activePanel === "security" ? "is-active" : "")} @click={() => setPanel("security")}><img src={asset("assets/sprites/icon-eye.svg")} alt="" /><span>Security</span></button>
 <button className={"om-tab-extra "+(activePanel === "schemes" ? "is-active" : "")} @click={() => setPanel("schemes")}><img src={asset("assets/sprites/icon-plan.svg")} alt="" /><span>Projects</span></button>
 <button className={activePanel === "escape" ? "is-active" : ""} @click={() => setPanel("escape")}><img src={asset("assets/sprites/icon-exit.svg")} alt="" /><span>Escape</span></button>
 <button className={"om-tab-extra "+(activePanel === "notebook" ? "is-active" : "")} @click={() => setPanel("notebook")}><img src={asset("assets/sprites/icon-map.svg")} alt="" /><span>Notebook</span></button>
 <button className={"om-tab-extra "+(activePanel === "map" ? "is-active" : "")} @click={() => setPanel("map")}><img src={asset("assets/sprites/icon-map.svg")} alt="" /><span>Directory</span></button>
 <button className={"om-tab-more "+((moreOpen || ["security","schemes","notebook","map"].indexOf(activePanel) >= 0) ? "is-active" : "")} aria-haspopup="menu" aria-expanded={moreOpen} @click={toggleMore}><img src={asset("assets/sprites/icon-plan.svg")} alt="" /><span>More</span></button>
 #if (moreOpen)<div className="om-more" role="menu"><button role="menuitem" className={activePanel === "security" ? "is-active" : ""} @click={() => setPanel("security")}><img src={asset("assets/sprites/icon-eye.svg")} alt="" /><div><span>Security</span><small>Alert level, cameras, evidence</small></div></button><button role="menuitem" className={activePanel === "schemes" ? "is-active" : ""} @click={() => setPanel("schemes")}><img src={asset("assets/sprites/icon-plan.svg")} alt="" /><div><span>Projects</span><small>Prepare a route</small></div></button><button role="menuitem" className={activePanel === "notebook" ? "is-active" : ""} @click={() => setPanel("notebook")}><img src={asset("assets/sprites/icon-map.svg")} alt="" /><div><span>Notebook</span><small>What you have learned</small></div></button><button role="menuitem" className={activePanel === "map" ? "is-active" : ""} @click={() => setPanel("map")}><img src={asset("assets/sprites/icon-map.svg")} alt="" /><div><span>Directory</span><small>Every fixture and room</small></div></button><button role="menuitem" @click={() => [toggleMore(), openDialog("menu")]}><img src={asset("assets/sprites/icon-bag.svg")} alt="" /><div><span>Save and menu</span><small>Saves, settings, handbook</small></div></button></div>#end
 <div className="om-toolbar-stamp">FIRST COUNT<span>{"OUTERMATE " + OM_VERSION}</span></div>
</nav>
