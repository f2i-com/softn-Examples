<p>Projects change what is possible. They reserve materials when work begins, keep progress through interruptions, and still require you to reach the work site.</p>
<div className="om-note">The material cost is charged once. Reusable tools stay in your pockets. If a search damages a route, repair the lost progress rather than paying twice.</div>
#each (p in projectCards) key={p.id}<div className={"om-card om-project "+(p.complete?"ready":"")}><span className="om-label">{p.subtitle}</span><h3>{p.name}</h3><p>{p.description}</p><div className="om-recipe-cost">{p.cost}</div><small>{p.tools}</small><small>{p.site + " · " + p.seconds + "s remaining"}</small><div className="om-row om-between"><span>{p.complete ? "READY" : p.paid ? "MATERIALS RESERVED" : "NOT STARTED"}</span><strong>{p.progress + "%"}</strong></div><div className="om-meter"><i style={p.bar} /></div><button className="om-btn om-wide" disabled={p.disabled} @click={() => requestProject(p.id)}>{p.complete ? "Prepared" : p.paid ? "Resume project" : "Walk there and prepare"}</button><small>{p.reason}</small>
 <div className="om-row"><button className="om-link" @click={() => focusSite(p.siteId)}>Locate work site</button>#if (p.paid && !p.complete)<button className="om-link" @click={() => cancelProject(p.id)}>Cancel and refund</button>#end</div>
</div>#end
