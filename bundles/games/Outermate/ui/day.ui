<import Guide from="./guide.ui" />
<Guide />

#if (nextStepCard && !(guideCard && guideCard.route))<div className="om-next-step"><span className="om-label">WHAT NOW</span><small>{nextStepCard.chapter}</small><strong>{nextStepCard.title}</strong><p>{nextStepCard.text}</p>#if (nextStepCard.label)<button className="om-btn om-primary om-wide" @click={() => nextStepAction(nextStepCard.action)}>{nextStepCard.label}</button>#end</div>#end
#if (orderCards.length || progressCard)<div className="om-orders"><div className="om-row om-between"><span className="om-label">YOUR ORDERS</span>#if (orderCards.length)<button className="om-link om-small" @click={clearOrders}>Clear all</button>#end</div>
 #if (progressCard && !progressCard.waiting)<div className="om-order is-active"><b>▶</b><div><strong>{progressCard.name}</strong><small>{progressCard.detail}</small></div><button className="om-btn" @click={cancelPlayerTask}>{progressCard.stopLabel}</button></div>#end
 #each (o in orderCards) key={o.id}<div className={"om-order "+(o.blocked?"is-blocked":"")}><b>{o.id + 1}</b><div><strong>{o.name}</strong><small>{o.status}</small></div><button className="om-btn" @click={() => cancelOrder(o.id)}>Cancel</button></div>#end
 <small>Orders run in turn. Routine and Auto day carry on in the gaps, stop for counts and lock-in, and resume afterwards. An order that cannot be done yet waits and says why.</small></div>#end
<div className="om-care"><span className="om-label">LOOK AFTER YOURSELF</span><div className="om-care-stats">#each (n in careCards) key={n.id}<div className={n.low?"needs-care":""}><span>{n.name}</span><strong>{n.value}<small>/ 100</small></strong></div>#end</div><div className="om-care-actions"><button className="om-btn" disabled={careActions.disabled} @click={() => requestAction("bunk","rest")}>Lie down in your bunk</button><button className="om-btn" disabled={careActions.disabled} @click={() => requestAction("infirmaryBed","rest")}>Visit infirmary</button><button className="om-btn" disabled={careActions.disabled} @click={() => requestAction("bench","rest")}>Rest at a table</button><button className="om-btn" disabled={!careActions.tea} @click={useTea}>Drink carried tea</button><button className="om-btn" disabled={!careActions.meal} @click={() => requestAction("canteen","eat")}>Get a meal</button></div><small>{careActions.mealReason}</small>#if (careActions.injury)<small className="om-injury">{careActions.injury}</small>#end<small>Rest restores energy, health and calm gradually. You keep recovery earned if interrupted. Lights out is at 22:30: a full night in your bunk eases stress by morning.</small></div>
#if (priorityCard)<div className="om-shift-card om-compact"><div className="om-row om-between"><span className="om-label">TODAY'S PRIORITY DETAIL</span><button className="om-link om-small" @click={() => setPanel("routine")}>View jobs and colleagues</button></div><div className="om-row om-between"><h3>{priorityCard.job}</h3><strong>{priorityCard.progress + " / " + priorityCard.target}</strong></div><p>{priorityCard.claimed ? "Order fulfilled. Your 5-scrip bonus has been paid." : "Complete " + priorityCard.target + " batches on this detail today for a 5-scrip bonus · " + priorityCard.pay + " scrip per batch"}</p><div className="om-shift-track"><i style={priorityCard.style} /></div></div>#end
#if (storyCard)<div className="om-chapter"><div className="om-row om-between"><span className="om-label">YOUR PERSONAL STORY</span><button className="om-link om-small" @click={toggleStory}>{storyOpen ? "Hide" : "Show"}</button></div><h3>{storyCard.title}</h3>#if (storyOpen)<p>{storyCard.body}</p><small>{storyCard.prison + " / " + storyCard.shape + " / Seed: " + storyCard.seed + " / " + storyCard.layout}</small><p className="om-layout-hint">{storyCard.layoutHint}</p>#if (storyCard.history)<p className="om-layout-hint">{storyCard.history + " " + storyCard.historyPlay}</p>#end
 #each (g in storyGoals) key={g.id}<div className={"om-goal "+(g.done?"done":"")}><b>{g.done ? "✓" : "○"}</b><span>{g.text}</span></div>#end
 <div className="om-story-reveal"><span className="om-label">{storyCard.chapter}</span><p>{storyCard.revelation}</p></div>
 <div className="om-story-voice"><img src={asset(storyCard.portrait)} alt="" /><div><span className="om-label">{storyCard.name}</span><blockquote>{storyCard.quote}</blockquote></div></div>
 #if (storyCard.choiceReady)<div className="om-story-choice"><h3>What will you promise?</h3><p>Your contact has shared something worth protecting. Make this choice in person; it is kept with your save.</p><button className="om-btn om-wide" disabled={!storyCard.choiceAllowed} @click={() => chooseStoryApproach("protect")}>Protect their identity · +10 trust</button><button className="om-btn om-wide" disabled={!storyCard.choiceAllowed} @click={() => chooseStoryApproach("share")}>Share their account · +1 favour</button>#if (!storyCard.choiceAllowed)<small>{storyCard.choiceReason}</small><button className="om-btn om-wide" @click={meetStoryContact}>Meet to discuss the promise</button>#end<small>Both choices leave every escape route open.</small></div>#end
 #if (storyCard.approach)<div className="om-note">{storyCard.approach}</div>#end
 <button className="om-btn om-wide" @click={() => selectPerson(storyCard.contact,true)}>{"Find " + storyCard.name}</button><button className="om-btn om-wide" @click={() => [selectRoute(storyCard.route),setPanel("escape")]}>Follow this escape lead</button><small>Optional: every escape route remains available.</small>#end</div>#end
#if (!(guideCard && guideCard.route))<div className="om-chapter"><span className="om-label">YOUR FIRST PLAN</span><h3>{chapterCard.title}</h3><p>{chapterCard.line}</p>
 #each (g in goalCards) key={g.id}<div className={"om-goal "+(g.done?"done":"")}><b>{g.done ? "✓" : "○"}</b><span>{g.text}</span></div>#end
</div>#end
<div className="om-now"><div><span className="om-label">RIGHT NOW · {hud.time}</span><strong>{hud.routine}</strong><small>{hud.routineHint}</small></div><small className="om-now-next">{"Next: " + hud.next}</small></div>
#if (searchCard)<div className="om-warning"><strong>Search: {searchCard.name}</strong><span>{searchCard.when}</span><p>Items are only searched when an officer reaches the stash.</p></div>#end
<div className="om-pa-note"><span className="om-label">PUBLIC ADDRESS</span><p>{statusText}</p></div>
<button className="om-link" @click={() => openDialog("help")}>Read the inmate handbook ↗</button>
