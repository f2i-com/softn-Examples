#if (guideCard)<div className="om-guide"><div className="om-row om-between"><span className="om-label">ESCAPE GUIDE</span><button className="om-link om-small" @click={toggleGuide}>Hide guide</button></div>
 #if (!guideCard.route)<h3>Choose a way out</h3><p>Pick a route and the guide lays out each step as a choice. Every choice adds orders to your list; with Auto day on they run themselves.</p>
  <div className="om-guide-routes">#each (r in guideCard.routes) key={r.id}<button className={"om-btn om-wide om-guide-route "+(r.recommended?"om-primary":"")} @click={() => guideChooseRoute(r.id)}><span>{r.name}#if (r.recommended)<i>YOUR LEAD</i>#end</span><small>{r.pace}</small>#if (r.risk)<small className="om-guide-risk">{"Risk: " + r.risk}</small>#end</button>#end</div>
 #else
  <small className="om-guide-status">{guideCard.routeName + " · " + (guideCard.escape ? "the plan is in motion" : guideCard.remaining ? "step " + guideCard.index + " of " + guideCard.remaining : "no steps left")}</small>
  #if (guideCard.current)<h3>{guideCard.current.title}</h3><p>{guideCard.current.text}</p>
   #if (guideCard.current.queued)<div className="om-guide-queued"><b>✓</b><span>{"In your order list · " + guideCard.current.queued + (guideCard.current.queued === 1 ? " order" : " orders") + (guideCard.autoDay ? ". It runs by itself under Auto day; the next step appears when it is done." : ". Turn on Auto day, or take control, to run it.")}</span></div>#end
   #each (c in guideCard.current.choices) key={c.id}<button className={"om-btn om-wide "+(c.primary && !guideCard.current.queued?"om-primary":"")} disabled={c.locked} @click={() => guideChoose(guideCard.current.id,c.id)}>{(guideCard.current.queued ? "Again · " : "") + c.label}</button><small className="om-guide-hint">{c.hint}</small>#end
   <div className="om-row"><button className="om-link" @click={() => guideSkip(guideCard.current.id)}>Skip this step</button><button className="om-link" @click={guideReset}>Change route</button></div>
  #else<h3>{guideCard.escape ? "The plan is running" : "Nothing left to plan"}</h3><p>{guideCard.escape ? "Reach the marked exit. Under Auto day the run leaves by itself." : "Every step is queued, done or skipped. Watch the order list and the map."}</p><button className="om-link" @click={guideReset}>Change route</button>#end
  #if (!guideCard.escape)<button className={"om-btn om-wide om-guide-auto "+(guideCard.auto?"is-on":"")} @click={guideToggleAuto}>{guideCard.auto ? "✓ The guide is choosing for you · switch off" : "Let the guide choose for me"}</button><small className="om-guide-hint">{guideCard.auto ? "Whenever your list runs dry, the guide queues its first choice. Skip or change route at any time." : "Hands-off play: the guide queues its first choice each time your list runs dry, with Auto day on."}</small>#end
  #if (!guideCard.autoDay && !guideCard.escape && !guideCard.auto)<button className="om-btn om-wide" @click={startAutoDay}>Turn on Auto day to run the orders</button>#end
  #if (guideCard.steps.length)<div className="om-guide-list">#each (s in guideCard.steps) key={s.id}<div className={"om-guide-step "+(s.current?"is-current ":"")+(s.queued?"is-queued ":"")+(s.skipped?"is-skipped":"")}><b>{s.queued && !s.skipped ? "✓" : s.n}</b><span>{s.title}</span>#if (s.skipped)<button className="om-link" @click={() => guideUnskip(s.id)}>Restore</button>#else<small>{s.state}</small>#end</div>#end</div>#end
 #end</div>#else<div className="om-guide om-guide-off"><div className="om-row om-between"><span className="om-label">ESCAPE GUIDE</span><small>Hidden</small></div><p>The guide lays out any route as choices and can play them for you. Show it any time; the game is the same without it.</p><button className="om-btn om-wide" @click={toggleGuide}>Show the escape guide</button></div>#end
