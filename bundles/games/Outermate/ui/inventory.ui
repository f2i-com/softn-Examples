<div className="om-section-title"><span>POCKETS</span><strong>{inventorySummary}</strong></div>
#if (inventoryCards.length === 0)<div className="om-empty">Empty pockets are easy to explain.</div>#end
#each (i in inventoryCards) key={i.id}
 <div className="om-item"><img src={asset(i.icon)} alt="" /><div><strong>{i.name + " "}<b>{"×" + i.count}</b></strong><small>{i.kind + " · " + i.bulk + " space each"}</small></div><button className="om-btn" disabled={!cellCard.near} title="Deposit one in the selected stash" @click={() => transferItem(i.id,cellCard.id,false)}>↓</button><button className="om-btn" disabled={!cellCard.near} title="Store as many of this item as fit" @click={() => transferItem(i.id,cellCard.id,false,true)}>All ↓</button></div>
#end
<div className="om-row"><button className="om-btn om-grow" @click={useTea}>Drink tea</button>#if (hud.hasGuardUniform)<button className={"om-btn om-grow "+(hud.guardUniform?"is-active":"")} @click={toggleGuardUniform}>{hud.guardUniform ? "Remove officer uniform" : "Wear officer uniform"}</button>#end<button className={"om-btn om-grow "+(hud.uniform?"is-active":"")} @click={toggleUniform}>{hud.uniform ? "Remove uniform" : "Wear uniform"}</button></div>
<p className="om-small">A uniform needs a pass to provide cover. Tool kits are reusable. Keep restricted materials out of your pockets before trouble finds you.</p>
<div className="om-section-title"><span>COMMISSARY</span><span>{shopCard.status}</span></div>
<div className="om-card om-shop">
 #each (s in shopCards) key={s.id}<div className="om-shop-line"><div><strong>{s.name + " "}<b>{s.price + " scrip"}</b></strong><small>{s.description}</small><small className="om-muted">{s.reason}</small></div><button className="om-btn" disabled={s.disabled} @click={() => s.near ? buyShop(s.id) : requestBuy(s.id)}>{s.label}</button></div>#end
 #if (!shopCard.near)<button className="om-btn om-wide" @click={() => goToSite("canteen")}>Walk to the meal counter</button>#end
</div>
<div className="om-section-title"><span>STASHES</span><span>PHYSICAL ACCESS</span></div>
<div className="om-stash-tabs">#each (s in stashChoiceCards) key={s.id}<button className={"om-btn "+(s.selected?"is-active":"")} @click={() => selectStash(s.id)}>{s.name}</button>#end</div>
<div className="om-card"><div className="om-row om-between"><h3>{cellCard.name}</h3><span>{cellCard.summary}</span></div><small>{"Base search risk " + cellCard.risk + "% · " + (cellCard.near ? "Within reach" : "Not within reach")}</small>
 #if (stashCards.length === 0)<div className="om-empty">Nothing stored here.</div>#end
 #each (s in stashCards) key={s.id}<div className="om-item"><img src={asset(s.icon)} alt="" /><div><strong>{s.name + " ×" + s.count}</strong></div><button className="om-btn" disabled={s.disabled} title="Withdraw one item" @click={() => transferItem(s.id,cellCard.id,true)}>↑</button><button className="om-btn" disabled={s.disabled} title="Withdraw as many of this item as fit" @click={() => transferItem(s.id,cellCard.id,true,true)}>All ↑</button></div>#end
 <button className="om-btn om-wide" @click={() => requestAction(cellCard.site,"stash")}>Walk to this stash</button>
</div>
<div className="om-section-title">MAKE SOMETHING USEFUL</div>
<p className="om-small">Batch orders make one item at a time and stop if supplies, pocket space or access run out. Cancel anytime to recover the current item's reserved materials.</p>
#each (r in recipeCards) key={r.id}<div className="om-card"><div className="om-row"><img className="om-inline-icon" src={asset(r.icon)} alt="" /><h3>{r.name}</h3></div><p>{r.description}</p><div className="om-recipe-cost">{r.cost}</div><small>{r.site + " · " + r.seconds + "s work"}</small><button className="om-btn om-wide" disabled={r.disabled} @click={() => requestCraft(r.id)}>Walk there and craft</button><div className="om-row"><button className="om-btn om-grow" disabled={r.disabled} @click={() => requestCraft(r.id,3)}>Make up to 3</button><button className="om-btn om-grow" disabled={r.disabled} @click={() => requestCraft(r.id,5)}>Make up to 5</button></div><small>{r.reason}</small></div>#end
