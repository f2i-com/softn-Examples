 .has-attendance .om-paused,.has-attendance .om-task-toast{display:none}
 .om-attendance{flex-wrap:wrap}.om-attendance>div{flex-basis:100%}.om-attendance .om-attendance-cancel{display:inline-flex}
}
@media(max-height:500px) and (min-width:500px){
 .om-attendance{top:59px;left:10px;right:140px;width:auto;transform:none}.has-attendance .om-paused,.has-attendance .om-task-toast{display:none}
