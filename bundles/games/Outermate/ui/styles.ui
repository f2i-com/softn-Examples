}
.om-story-reveal{border-left:2px solid #a0b8a2;padding:10px 13px;margin:16px 0;background:#132c3299}.om-story-reveal p{margin:7px 0 0}.om-story-choice{margin:16px 0;padding:13px;border:1px solid #76846b;border-radius:5px;background:#253b37}.om-story-choice h3{font-size:15px}.om-story-choice .om-btn{white-space:normal}
.om-brand-symbol{display:none!important}.om-brand-wordmark{filter:drop-shadow(0 1px 3px #0004)}
.om-story-voice{display:flex;gap:12px;align-items:flex-start;padding:14px 0;margin:12px 0;border-top:1px solid #78908655;border-bottom:1px solid #78908655}.om-story-voice>img{width:38px;height:48px;flex:none;image-rendering:pixelated;background:#172b31;border-radius:5px}.om-story-voice>div{min-width:0}.om-story-voice blockquote{margin:7px 0 0;font-size:13px;line-height:1.7;color:#e1dcc5;font-style:italic}.om-story-voice blockquote:before{content:'“';color:#efbc76}.om-story-voice blockquote:after{content:'”';color:#efbc76}
.om-chapter{border-radius:7px}.om-story-choice{box-shadow:inset 0 1px 0 #d0be8833}.om-story-reveal .om-label{color:#dec28f}
@media(max-width:440px){.om-brand{width:38px}.om-brand-wordmark{display:none!important}.om-brand-symbol{display:block!important;width:38px;height:38px}.om-story-voice{gap:9px}.om-story-voice blockquote{font-size:12px}}
.om-design-card{padding:13px 15px;border:1px solid #63766a;border-left:3px solid #dbb877;border-radius:5px;background:linear-gradient(120deg,#243c3c,#192f36);display:grid;gap:7px}.om-design-card strong{font-size:17px;color:#eee6ce}.om-design-card p{margin:0;color:#bdccc6;font-size:12px;line-height:1.6}.om-layout-hint{border-left:2px solid #dbb877;padding-left:10px;color:#d2d5be;font-size:12px!important}
.om-shift-card{padding:16px;margin-bottom:20px;border:1px solid #a69262;border-top:3px solid #e1bc75;border-radius:7px;background:linear-gradient(135deg,#35483d,#1e343c)}.om-shift-card h3{margin:8px 0;color:#f0dec0;font-size:18px}.om-shift-card p{font-size:12px;line-height:1.6}.om-shift-card .om-row{font-size:12px;color:#ddcfac}.om-shift-track{height:5px;background:#172c30;margin:12px 0;border-radius:5px;overflow:hidden}.om-shift-track i{display:block;height:100%;background:#dab975}.om-shift-card small{display:block;margin-top:10px;font-size:11px;line-height:1.5;color:#bacac1}
.om-auto-card{padding:16px;margin-bottom:18px;border:1px solid #6f9584;border-top:3px solid #97c3a5;border-radius:7px;background:linear-gradient(135deg,#2d493f,#1b323c)}.om-auto-card h3{font-size:18px;margin:9px 0;color:#dcebd5}.om-auto-card p{font-size:12px;line-height:1.7}.om-auto-card small{display:block;margin-top:10px;line-height:1.6;color:#b5cac1}@media(max-width:440px){.om-routine-bar .om-mode{font-size:10px;padding:4px 7px;min-height:36px}.om-routine-bar>div:first-child{flex:1;min-width:0}.om-routine-bar strong{overflow:hidden;text-overflow:ellipsis}}
/* Keep routine controls tappable after compact-screen overrides. */
@media(pointer:coarse){.om-routine-bar{height:50px}.om-routine-bar .om-btn{min-height:44px}}
