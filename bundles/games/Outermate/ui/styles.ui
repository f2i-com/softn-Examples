.om-title-gameplay{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:flex-start;padding:32px;background:radial-gradient(ellipse at 45% 40%,#304943,#10232a 75%);overflow:hidden auto;min-height:0}.om-title-gameplay>:first-child{margin-top:auto}.om-title-gameplay>:last-child{margin-bottom:auto}.om-demo-header{max-width:680px;margin:0 auto 20px;width:100%}.om-demo-header>strong{display:block;font-size:38px;color:#ede3c6;margin:8px 0}.om-demo-header p{font-size:14px;color:#bdd0c2;max-width:480px}.om-demo-frame{width:100%;max-width:760px;margin:0 auto;overflow:hidden;border:1px solid #688279;border-radius:8px;box-shadow:0 20px 55px #0005}.om-demo-scene{position:relative;width:100%;aspect-ratio:48/37;overflow:hidden;background:#233d40}.om-demo-live .om-map-shell{position:absolute;inset:0}.om-demo-live .om-mapviewport{cursor:default}.om-demo-live .om-path-dot,.om-demo-live .om-map-marker.destination,.om-demo-live .om-map-caption,.om-demo-live .om-map-tools,.om-demo-live .om-crew-strip,.om-demo-live .om-player-dock,.om-demo-live .om-mini-wrap,.om-demo-live .om-task-toast,.om-demo-live .om-map-footer,.om-demo-live .om-attendance,.om-demo-live .om-paused,.om-demo-live .om-escape-banner,.om-demo-live .om-context{display:none!important}.om-demo-live .om-weather{pointer-events:none}.om-demo-terrain{position:absolute;width:100%;height:100%;left:0;top:0;image-rendering:pixelated}.om-demo-prop{position:absolute;object-fit:fill;pointer-events:none}.om-demo-actor{position:absolute;z-index:3;transition:left .5s linear,top .5s linear}.om-demo-actor img{width:100%;height:100%;object-fit:contain}.om-demo-actor.is-player{filter:drop-shadow(0 0 3px #ffc876)}.om-demo-actor span{position:absolute;bottom:100%;left:50%;transform:translateX(-50%);font-size:9px;font-weight:700;background:#d2b477;color:#172b31;padding:2px 4px;border-radius:2px}.om-demo-footer{display:flex;gap:12px;align-items:center;justify-content:space-between;width:100%;max-width:760px;margin:14px auto 0}.om-demo-footer strong{display:block;color:#d5dfcf;margin-top:5px;font-size:13px}.om-demo-caption{display:flex;gap:24px;justify-content:center;color:#a5b9aa;font-size:10px;letter-spacing:.13em;margin-top:24px}.reduce-motion .om-demo-actor{transition:none}
@media(max-width:900px){.om-title-gameplay{flex:none;min-height:0;padding:24px}.om-demo-header>strong{font-size:28px}.om-demo-frame{max-width:500px}.om-demo-header,.om-demo-footer{max-width:500px}.om-demo-caption{margin-top:16px}}
@media(max-height:780px) and (min-width:901px){.om-title-gameplay{padding:20px}.om-demo-frame{max-width:570px}.om-demo-header>strong{font-size:28px}.om-demo-header{margin-bottom:10px}.om-demo-caption{margin-top:10px}}

.om-directory-search{display:grid;gap:7px;margin:16px 0}.om-directory-search input{width:100%;min-width:0}.om-access-ok{color:#bad7a6}.om-access-locked{color:#ebbc8d}.om-directory-card .om-row{flex-wrap:wrap}.om-attendance{position:absolute;top:88px;left:50%;transform:translateX(-50%);width:min(480px,65%);display:flex;gap:12px;align-items:center;padding:12px 14px;background:#283b32f5;border:1px solid #c8ae76;border-radius:6px;z-index:21;box-shadow:0 4px 20px #0004}.has-attendance .om-paused{display:none}.om-attendance>div{flex:1;min-width:0}.om-attendance strong{display:block;font-size:13px;margin:4px 0}.om-attendance small{display:block;font-size:11px}.om-attendance .om-btn{flex:none}
@media(max-width:730px){.om-attendance{top:84px;left:10px;right:10px;width:auto;transform:none;padding:9px;gap:8px}.om-attendance .om-label{font-size:8px}.om-attendance small{font-size:10px}.om-attendance .om-btn{font-size:10px;min-height:40px;padding:8px}}

.om-actor.pose-eat .om-person-sprite{transform:translateY(2px);transform-origin:bottom}.om-meal-seat{position:absolute;left:7px;bottom:2px;width:19px;height:8px;border:2px solid #899c91;border-radius:3px;background:#445e55;z-index:1}.om-meal-tray{z-index:3;position:absolute;left:7px;bottom:4px;width:20px;height:9px;background:linear-gradient(90deg,#9caa93 0 25%,#ddc783 25% 55%,#74966e 55% 80%,#bdc8b0 80%);border:2px solid #d3d8c2;border-radius:3px;box-shadow:0 2px 3px #0005}.om-actor.pose-work .om-person-sprite{animation:duty-motion 1.4s ease-in-out infinite}@keyframes duty-motion{0%,100%{transform:rotate(-3deg)}50%{transform:translateY(2px) rotate(3deg)}}
.is-paused .om-actor *{animation-play-state:paused!important}

.om-actor.pose-eat.facing-s .om-meal-tray{bottom:-10px}
.om-actor.pose-eat.facing-n .om-meal-tray{bottom:25px;z-index:1}
.om-actor.pose-eat.facing-e .om-meal-tray{left:30px;bottom:8px}
.om-actor.pose-eat.facing-w .om-meal-tray{left:-18px;bottom:8px}
.om-meal-spoon{position:absolute;left:22px;bottom:13px;width:3px;height:10px;border-radius:3px;background:#dce6df;z-index:4;transform-origin:bottom;animation:meal-bite 1.8s ease-in-out infinite;animation-delay:inherit}
.om-actor.facing-n .om-meal-spoon{left:23px;bottom:22px;z-index:1}
.om-actor.facing-e .om-meal-spoon{left:27px;bottom:15px}
.om-actor.facing-w .om-meal-spoon{left:3px;bottom:15px}
.om-chat-bubble{position:absolute;right:-14px;top:-10px;z-index:5;color:#233c40;background:#dae3c8;border:1px solid #718d83;border-radius:8px 8px 8px 1px;padding:0 5px;font-size:13px;line-height:15px;animation:chat-beat 2.8s ease-in-out infinite;animation-delay:inherit}
.om-actor.pose-chat .om-person-sprite{animation:chat-gesture 2.8s ease-in-out infinite;animation-delay:inherit;transform-origin:bottom}
@keyframes meal-bite{0%,25%,100%{transform:rotate(35deg)}55%,70%{transform:translateY(-6px) rotate(-15deg)}}
@keyframes chat-beat{0%,15%,100%{opacity:.45;transform:translateY(0)}40%,70%{opacity:1;transform:translateY(-2px)}}
@keyframes chat-gesture{0%,100%{transform:rotate(0)}35%{transform:rotate(-4deg)}55%{transform:translateY(-1px) rotate(2deg)}}
.om-context{position:absolute;z-index:150;display:flex;flex-direction:column;width:248px;max-height:72%;padding:6px;border:1px solid #74877a;border-radius:9px;background:#122631f4;box-shadow:0 12px 40px #02111bcc;backdrop-filter:blur(4px);animation:speech-pop .18s ease-out;box-sizing:border-box}.om-context-head{flex:none;display:flex;flex-wrap:wrap;align-items:center;gap:0 8px;padding:5px 8px 8px;border-bottom:1px solid #35505888;margin-bottom:4px}.om-context-head strong{flex:1;font-size:13px;color:#e8dcb8;line-height:1.3;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.om-context-head small{flex:1 1 100%;font-size:10px;color:#93a9a4;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.om-context-head .om-link{padding:0 8px;min-height:32px;font-size:18px;line-height:1}.om-context-list{flex:1;min-height:0;overflow-y:auto;scrollbar-width:thin;overscroll-behavior:contain}.om-context-item{display:flex;align-items:center;gap:9px;width:100%;text-align:left;padding:7px 9px;border:0;border-radius:6px;background:transparent;color:#d6e0d9;font-size:12px;line-height:1.35}.om-context-item>b{flex:none;width:22px;text-align:center;font-weight:400;font-size:14px;opacity:.9}.om-context-item>div{flex:1;min-width:0}.om-context-item:hover:not(:disabled),.om-context-item:focus-visible{background:#22434a}.om-context-item:disabled{opacity:.55;cursor:not-allowed}.om-context-item span{display:block}.om-context-item small{display:block;font-size:10px;color:#93a9a4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.om-context-item:disabled small{white-space:normal;color:#b8a27a}.om-context.is-sheet{left:0;right:0;bottom:0;top:auto;width:auto;max-height:min(58%,420px);border-radius:14px 14px 0 0;border-bottom:0;padding:4px 10px calc(10px + env(safe-area-inset-bottom,0px));animation:sheet-up .22s ease-out}.om-context-grip{flex:1 1 100%;width:38px;height:4px;margin:2px auto 8px;border-radius:2px;background:#5f7a78;max-width:38px}.om-context.is-sheet .om-context-item{min-height:48px;padding:9px 10px;font-size:13px}.om-context.is-sheet .om-context-item small{white-space:normal}.om-context.is-sheet .om-context-head strong{font-size:14px}@keyframes sheet-up{from{transform:translateY(24px);opacity:0}to{transform:translateY(0);opacity:1}}@media(pointer:coarse){.om-context-item{min-height:44px;padding:9px 10px}}
.om-speech{position:absolute;left:50%;bottom:54px;transform:translateX(-50%);z-index:7;white-space:nowrap;max-width:190px;overflow:hidden;text-overflow:ellipsis;padding:2px 7px;border:1px solid #718d83;border-radius:7px;background:#e9efdc;color:#1f3236;font-size:10px;line-height:1.5;box-shadow:0 2px 4px #07182470;animation:speech-pop .25s ease-out}.om-speech::after{content:"";position:absolute;left:50%;bottom:-5px;width:7px;height:7px;transform:translateX(-50%) rotate(45deg);background:#e9efdc;border-right:1px solid #718d83;border-bottom:1px solid #718d83}.om-actor-player .om-speech{background:#f3e3bd}@keyframes speech-pop{from{opacity:0;transform:translate(-50%,4px)}to{opacity:1;transform:translate(-50%,0)}}.om-actor.pose-play .om-person-sprite{animation:hoop-jump 1.5s ease-in-out infinite;animation-delay:inherit;transform-origin:bottom}@keyframes hoop-jump{0%,60%,100%{transform:translateY(0)}30%{transform:translateY(-6px)}}.om-ball{position:absolute;left:22px;bottom:16px;width:8px;height:8px;border-radius:50%;background:#d98b3c;border:1px solid #6b3f1a;z-index:3;animation:ball-arc 1.5s ease-in-out infinite;animation-delay:inherit}@keyframes ball-arc{0%,100%{transform:translate(0,0)}40%{transform:translate(4px,-22px)}}.om-next-step{padding:14px 16px;margin-bottom:18px;border:1px solid #8ea38f;border-left:3px solid #dbb877;border-radius:7px;background:linear-gradient(135deg,#213a40,#1a3038)}.om-next-step strong{display:block;font-size:16px;margin:4px 0 6px;color:#e8dcb8}.om-next-step p{margin:0 0 10px;font-size:12px}.om-next-step small{display:block;color:#93a9a4;font-size:10px;letter-spacing:.12em;margin-bottom:2px}
.om-guide-btn{min-height:33px;font-size:10px;padding:5px 10px;border-color:#a69262;color:#e8dcb8}.om-guide-btn.is-active{background:#3d4d3a;border-color:#e1bc75}.om-guide-sheet{position:absolute;right:14px;top:14px;width:min(380px,calc(100% - 28px));max-height:calc(100% - 28px);display:flex;flex-direction:column;z-index:30;background:#13232bf8;border:1px solid #a69262;border-radius:9px;box-shadow:0 12px 40px #020c15b0;backdrop-filter:blur(6px)}.om-guide-sheet-head{display:flex;align-items:center;gap:10px;padding:8px 8px 8px 14px;border-bottom:1px solid #35505888}.om-guide-sheet-head strong{flex:1;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#efbc76}.om-guide-sheet-head .om-link{font-size:22px;line-height:1;min-width:40px;min-height:40px;padding:0;text-align:center}.om-guide-sheet-head .om-context-grip{display:none}.om-guide-sheet-body{overflow-y:auto;overscroll-behavior:contain;padding:10px 12px 12px;scrollbar-width:thin}.om-guide-off{background:#1a2d33;border-color:#4f6662;border-top-color:#a69262}.om-guide-off p{color:#b7c8c3}.om-guide-sheet-body .om-guide{margin-bottom:0;border-top-width:1px}.om-guide-sheet-body .om-guide>.om-row:first-child>.om-label{visibility:hidden}@media(max-width:730px){.om-guide-sheet{left:0;right:0;top:auto;bottom:0;width:auto;max-height:78%;border-radius:14px 14px 0 0;border-bottom:0}.om-guide-sheet-head{padding-top:6px;flex-wrap:wrap}.om-guide-sheet-head .om-context-grip{display:block;width:100%;order:-1;margin:0 auto 4px}.om-guide-sheet-body{padding-bottom:calc(12px + env(safe-area-inset-bottom,0px))}}
.om-guide{padding:14px 16px;margin-bottom:18px;border:1px solid #a69262;border-top:3px solid #e1bc75;border-radius:7px;background:linear-gradient(180deg,#25403f,#1b3238)}.om-guide h3{margin:8px 0 6px;font-size:16px;color:#e8dcb8}.om-guide p{font-size:12px;margin:0 0 10px}.om-guide-status{display:block;font-size:10px;letter-spacing:.1em;color:#c9b183;text-transform:uppercase}.om-guide-hint{display:block;font-size:10px;color:#93a9a4;margin:-4px 0 8px;line-height:1.45}.om-guide-routes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:8px}.om-guide-routes .om-btn.om-wide{width:auto;margin:0}.om-guide-route{display:flex;flex-direction:column;align-items:flex-start;gap:2px;text-align:left;min-height:56px}@media(max-width:440px){.om-guide-routes{grid-template-columns:1fr}}.om-guide-route span{display:flex;align-items:center;gap:6px;flex-wrap:wrap}.om-guide-route i{font-style:normal;font-size:8px;letter-spacing:.12em;padding:2px 5px;border-radius:3px;background:#1c3037;color:#f0d7a4}.om-guide-route small{font-size:10px;font-weight:400}.om-guide-risk{opacity:.72}.om-guide-queued{display:flex;gap:8px;align-items:flex-start;padding:8px 10px;margin:0 0 10px;border-radius:6px;background:#1e3a34;border:1px solid #5e8a6c;color:#d6ecd8;font-size:12px;line-height:1.45}.om-guide-queued b{color:#8fd4a0;flex:none}.om-guide-queued span{display:block;min-width:0}.om-guide-auto{margin-top:12px}.om-guide-auto.is-on{background:#2f5347;border-color:#7cbf95;color:#eaf5ea}.om-guide-auto.is-on:hover:not(:disabled){background:#386052}.om-guide-list{display:grid;gap:4px;margin-top:10px}.om-guide-step{display:flex;align-items:center;gap:8px;padding:5px 8px;border-radius:5px;background:#1a2d33;border:1px solid #35505866;font-size:11px;color:#b7c8c3;line-height:1.35}.om-guide-step b{flex:none;width:18px;height:18px;border-radius:9px;display:inline-flex;align-items:center;justify-content:center;font-size:10px;font-weight:600;background:#2a4249;color:#c9d6d1}.om-guide-step span{flex:1;min-width:0}.om-guide-step small{font-size:9px;flex:none;color:#93a9a4;letter-spacing:.08em;text-transform:uppercase}.om-guide-step .om-link{flex:none;min-height:22px;padding:0 4px;font-size:10px}.om-guide-step.is-current{background:#2c4238;border-color:#dbb877;color:#f0e6cc}.om-guide-step.is-current b{background:#dbb877;color:#1d2f34}.om-guide-step.is-current small{color:#e5c88e}.om-guide-step.is-queued b{background:#6fb08a;color:#12261f}.om-guide-step.is-queued small{color:#9bd6ab}.om-guide-step.is-skipped{opacity:.65}.om-guide-step.is-skipped span{text-decoration:line-through}
.om-shift-card.om-compact{padding:11px 14px;margin-bottom:16px}.om-shift-card.om-compact h3{margin:6px 0 2px;font-size:15px}.om-shift-card.om-compact p{margin:2px 0 8px;font-size:11px}.om-shift-card.om-compact strong{font-size:14px}.om-now{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:10px 12px;margin:4px 0 14px;border:1px solid var(--om-line);border-radius:6px;background:#15282f}.om-now>div{min-width:0}.om-now strong{display:block;font-size:14px;margin:2px 0}.om-now small{display:block;font-size:10px;color:#93a9a4;line-height:1.45}.om-now-next{flex:none;text-align:right;max-width:38%;padding-top:2px}
.om-orders{padding:12px 14px;margin-bottom:18px;border:1px solid #6f8f9a;border-left:3px solid #9bc0cf;border-radius:7px;background:#17303a}.om-orders>small{display:block;margin-top:8px;font-size:10px;color:#93a9a4;line-height:1.5}.om-order{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid #35505888}.om-order:last-of-type{border-bottom:0}.om-order>b{flex:none;width:22px;height:22px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;background:#274852;color:#cfe1dc}.om-order.is-active>b{background:#dbb877;color:#1d2f34}.om-order>div{flex:1;min-width:0}.om-order strong{display:block;font-size:12px;color:#e0e8de;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.om-order small{display:block;font-size:10px;color:#93a9a4;line-height:1.4}.om-order.is-blocked small{color:#c9b183}.om-order .om-btn{flex:none;min-height:30px;padding:4px 9px;font-size:11px}.om-task-toast.is-waiting{border-left:3px solid #c9b183}
.om-shop{padding:12px 14px}.om-shop-line{display:flex;align-items:center;gap:12px;padding:9px 0;border-bottom:1px solid #35505888}.om-shop-line:last-of-type{border-bottom:0}.om-shop-line>div{flex:1;min-width:0;display:grid;gap:2px}.om-shop-line strong{font-size:13px}.om-shop-line strong>b{color:#e5c88e;font-weight:500;margin-left:6px}.om-shop-line small{font-size:11px;line-height:1.45;color:#aebeb7}.om-shop-line .om-btn{flex:none;min-width:58px}
.om-care{padding:16px;border:1px solid var(--om-line);border-radius:6px;background:#1a3037;margin-bottom:22px}
.om-care-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:12px 0 16px}
.om-care-stats span{font-size:10px;color:var(--om-muted)}.om-care-stats strong{display:block;font-size:22px;line-height:1.25}.om-care-stats small{font-size:9px;font-weight:400}.om-care-stats .needs-care strong{color:var(--om-red)}
.om-care-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-bottom:10px}.om-care-actions .om-btn{font-size:11px;padding:9px 7px}.om-injury{color:#e89681!important}.om-care>small{font-size:11px;margin-top:7px}
.om-task-toast small{font-size:10px;line-height:1.4;margin:0 0 8px;color:#b7ccc5}.om-task-toast strong{margin-bottom:4px}.om-task-toast .om-meter{height:5px}
.om-actor.pose-sit .om-person-sprite{transform:translateY(2px)}
.om-rest-breath{position:absolute;right:-5px;top:-8px;color:#b9e1d8;font-size:20px;z-index:4;animation:rest-breathe 3s ease-in-out infinite;animation-delay:inherit}
.om-actor.pose-recover .om-person-sprite{animation:rest-breathe 3s ease-in-out infinite;transform-origin:bottom}
.om-work-hands{position:absolute;left:17px;bottom:9px;width:10px;height:5px;border-radius:3px;background:#e2c2a0;border:1px solid #765944;z-index:3;animation:work-hands .9s ease-in-out infinite;animation-delay:inherit}
.om-actor.facing-w .om-work-hands{left:1px}.om-actor.facing-n .om-work-hands{z-index:1;bottom:17px}
@keyframes rest-breathe{0%,100%{opacity:.65;transform:translateY(0)}50%{opacity:1;transform:translateY(-2px)}}
@keyframes work-hands{0%,100%{transform:translate(0,0) rotate(-10deg)}50%{transform:translate(3px,-4px) rotate(15deg)}}
/* Keep map controls reachable across touch devices, not only portrait phones. */
.om-app{padding-left:env(safe-area-inset-left,0px);padding-right:env(safe-area-inset-right,0px);padding-top:env(safe-area-inset-top,0px)}
.om-toolbar{padding-bottom:env(safe-area-inset-bottom,0px);height:calc(65px + env(safe-area-inset-bottom,0px))}
.om-speed-cycle{display:none}.om-sidebar,.om-panel-head>div{min-width:0}.om-panel-body,.om-modal{overscroll-behavior:contain;overflow-wrap:break-word}.om-panel-head{gap:10px}.om-close-panel{flex-shrink:0}.om-app button{touch-action:manipulation}
.om-player-heading>div{min-width:0}.om-player-heading strong{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.om-attendance-cancel{display:none}
@media(max-width:730px){
 .om-speed>.om-btn:nth-child(2),.om-speed>.om-btn:nth-child(3),.om-speed>.om-btn:nth-child(4){display:none}
 .om-speed>.om-speed-cycle{display:inline-flex}.om-hud{gap:5px}.om-brand{width:95px}
 .om-map-tools{top:58px}.om-crew-strip{top:114px}.om-paused{top:115px;left:auto;right:10px;transform:none}
 .om-task-toast{left:10px;right:10px;max-width:none}
 .om-panel-head h2{font-size:18px}.om-panel-body{padding:15px}.om-sidebar{max-width:calc(100% - 24px)}
}
@media(max-width:440px){
 .om-hud{padding:6px;gap:6px}.om-brand{width:60px}.om-hud-values{gap:8px}
 .om-clock>strong{font-size:18px}.om-map-caption{max-width:180px}
}
@media(pointer:coarse){
 .om-app .om-btn,.om-app .om-link,.om-toolbar>button{min-height:44px}
 .om-speed .om-btn,.om-menu-button,.om-map-tools .om-btn,.om-close-panel{min-width:44px;min-height:44px;width:auto}
 .om-map-tools .om-btn{width:44px}.om-routine-bar{height:50px}.om-routine-bar .om-btn{min-height:44px}
