<style>
:root{color-scheme:dark;--om-bg:#0b1418;--om-panel:#13232b;--om-panel2:#1a2f37;--om-line:#355058;--om-text:#d6e0d9;--om-muted:#9fb4b5;--om-amber:#efba72;--om-cyan:#8dc8c9;--om-red:#e89681}
.om-app{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--om-bg);color:var(--om-text);height:100%;width:100%;display:flex;flex-direction:column;overflow:hidden;font-size:14px;line-height:1.5;isolation:isolate}
.om-app *{box-sizing:border-box}.om-app button,.om-app input,.om-app textarea{font:inherit}.om-app button{cursor:pointer}.om-app button:disabled{cursor:not-allowed}.om-app button:focus-visible,.om-app input:focus-visible,.om-app textarea:focus-visible{outline:2px solid var(--om-amber);outline-offset:3px}.om-app h1,.om-app h2,.om-app h3,.om-app p{margin:0}.om-app h2{font-size:23px;line-height:1.25;font-weight:650;letter-spacing:-.025em}.om-app h3{font-size:16px;font-weight:650;line-height:1.35}.om-app p{margin:10px 0 16px;color:#b5c5c3;line-height:1.65}.om-app small{font-size:12px;color:var(--om-muted);line-height:1.55;display:block}.om-app img{max-width:100%}.om-app input,.om-app textarea{width:100%;border:1px solid var(--om-line);border-radius:5px;padding:11px 12px;background:#0e1d24;color:var(--om-text);resize:vertical}.om-app textarea{min-height:90px}.om-app label{display:grid;gap:7px}.om-btn{display:inline-flex;justify-content:center;align-items:center;gap:8px;min-height:42px;padding:9px 13px;border:1px solid #3a555e;border-radius:5px;background:#203740;color:#d1dfd9;font-weight:550;font-size:13px;line-height:1.35;transition:background .13s,border-color .13s}.om-btn:hover:not(:disabled){background:#304c54;border-color:#8caba7}.om-btn:disabled{opacity:.48}.om-btn small{color:inherit;opacity:.82;line-height:1.4}.om-btn.om-primary small{color:#243a3c;opacity:1}.om-btn.is-active,.is-active.om-background{background:#3b493f;border-color:#b49b6b;color:#f6dcaa}.om-btn.om-primary{background:#e1b578;border-color:#eac998;color:#1c3037;box-shadow:0 3px 12px #030d1740}.om-btn.om-primary:hover:not(:disabled){background:#f2cb92}.om-wide{width:100%;margin:7px 0}.om-grow{flex:1;min-width:0}.om-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.om-between{justify-content:space-between}.om-label,.om-eyebrow{font-size:10px;font-weight:650;letter-spacing:.17em;color:var(--om-amber);display:block;line-height:1.7}.om-eyebrow{letter-spacing:.21em;font-size:9px}.om-muted{color:var(--om-muted)}.om-cyan{color:var(--om-cyan)!important}.om-small{font-size:12px!important}.om-danger-text{color:var(--om-red)!important}.om-link{border:0;background:transparent;color:var(--om-cyan);padding:8px 2px;font-size:12px;min-height:36px;text-align:left}.om-link:hover{text-decoration:underline;color:#c2e4de}.om-link.om-small{min-height:30px;padding:4px 6px}.om-player-heading .om-link{min-width:30px;padding:0 8px}.om-section-title{display:flex;justify-content:space-between;gap:8px;color:#a2b8b8;font-size:10px;letter-spacing:.1em;margin:22px 0 10px;font-weight:600}.om-section-title strong{color:var(--om-amber);letter-spacing:0}.om-note{padding:13px 14px;background:#22353b;border-left:2px solid #9bae99;border-radius:2px;color:#bacbc7;font-size:12px;line-height:1.65;margin:12px 0}.om-note strong{color:#e1cfaa}.om-chip{display:inline-flex;white-space:nowrap;background:#2e484d;border:1px solid #48636a;color:#bfd6d2;font-size:9px;letter-spacing:.06em;padding:3px 6px;border-radius:3px;text-transform:uppercase}.om-chip.confirmed{color:#b5dac1;border-color:#609277}.om-chip.rumor,.om-chip.changed{color:#e5bc84;border-color:#89764c}.om-led{display:inline-block;width:6px;height:6px;border-radius:50%;background:#acc996;box-shadow:0 0 8px #b2d19166;flex-shrink:0}.om-led-red{background:#e39379;box-shadow:0 0 10px #d77b6d88}.om-led-off{background:#5e7278;box-shadow:none}.om-meter{height:5px;border-radius:3px;background:#0d222c;overflow:hidden;flex:1;min-width:20px}.om-meter>i{display:block;height:100%;background:#8fbec0;border-radius:3px}.om-meter-food>i{background:#aeb994}.om-meter-stress>i{background:#d29874}.om-empty{border:1px dashed #334a51;border-radius:4px;padding:18px 13px;color:#91aaa9;font-size:12px;margin:12px 0}.om-warning{padding:14px;border:1px solid #806249;background:#44372e;border-radius:5px;font-size:13px;color:#edc397;margin:15px 0}.om-warning strong,.om-warning span{display:block}.om-warning p{font-size:12px;margin-bottom:0;color:#d6be9f}.om-toast{position:absolute;left:50%;bottom:80px;transform:translateX(-50%);z-index:250;width:max-content;max-width:min(680px,92%);padding:13px 19px;border:1px solid #8d9670;border-radius:5px;background:#213a3cf5;box-shadow:0 8px 35px #020c1590;font-size:13px;color:#e0ddc2;pointer-events:none;transition:bottom .15s}.om-toast.is-raised{bottom:164px}
/* A poster is for the title. Gameplay below is the real tile and sprite world. */
.om-title{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(390px,1fr);grid-template-rows:minmax(0,1fr);height:100%;overflow:auto}.om-title-art{position:relative;min-height:680px;background-size:cover;background-position:60% center;overflow:hidden}.om-title-art-shade{position:absolute;inset:0;background:linear-gradient(180deg,#08172280 0%,#091b2440 38%,#071820eb 83%,#071820 100%)}.om-title-stamp{position:absolute;left:36px;top:30px;letter-spacing:.22em;font-size:10px;color:#d3d3bd}.om-title-caption{position:absolute;left:clamp(26px,5vw,75px);bottom:58px;right:32px}.om-title-caption h1{font-size:clamp(30px,3.7vw,57px);line-height:1.08;letter-spacing:-.045em;margin:16px 0;color:#e3e5d4;font-weight:570;text-shadow:0 2px 20px #091b29}.om-title-caption p{color:#b6c9c7;font-size:15px}.om-title-pills{display:flex;gap:22px;font-size:9px;letter-spacing:.16em;color:#dcb783;margin-top:32px;flex-wrap:wrap}.om-title-pane{padding:clamp(30px,4.5vw,70px);background:radial-gradient(ellipse at top right,#243b41 0%,#14232b 45%,#0c1c25 100%);display:flex;flex-direction:column;justify-content:flex-start;gap:6px;min-height:0;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin}.om-title-pane>:first-child{margin-top:auto}.om-title-pane>:last-child{margin-bottom:auto}.om-title-logo{width:100%;margin:8px 0 18px}.om-title-pane .om-lead{font-size:19px;line-height:1.35;color:#dbdac6;letter-spacing:-.02em;margin:0}.om-title-form{display:grid;gap:13px;margin:15px 0 5px}.om-backgrounds{display:grid;grid-template-columns:1fr 1fr;gap:8px}.om-background{padding:12px;background:#152a32;border:1px solid #385158;color:#d5ded4;text-align:left;border-radius:4px}.om-background strong{font-size:13px}.om-background small{font-size:11px;margin-top:5px}.om-face-choice{padding:3px;width:33px;height:45px;background:#29404a;border:1px solid #4a6567;border-radius:3px}.om-title .om-start{justify-content:space-between;min-height:51px;padding:13px 17px;font-size:15px;margin:7px 0}.om-guided{border-color:#6fae88;background:#22403a;color:#e2f1e5;text-align:left}.om-guided:hover:not(:disabled){background:#2b4f45}.om-guided-text{display:grid;gap:2px;min-width:0}.om-guided-text strong{font-size:14px}.om-guided-text small{font-size:11px;font-weight:400;color:#b9d3c1;line-height:1.35}.om-title-footer{font-size:9px;line-height:1.9;letter-spacing:.09em;color:#8fa7aa;margin-top:25px}.om-credit{color:#c9d6d1;text-decoration:underline;text-underline-offset:3px;text-decoration-color:#5d7a78}.om-credit:hover{color:#efbc76}.om-title-footer span{letter-spacing:0;color:#bfd0ca}
/* Fixed-height HUD, flexible map, compact panel. */
.om-hud{flex:none;height:74px;display:flex;align-items:center;gap:18px;padding:10px 20px;border-bottom:1px solid #29454e;background:linear-gradient(180deg,#182d36,#10222c);z-index:30;box-shadow:0 2px 16px #05101a80}.om-brand{width:215px;padding:0;background:none;border:0;flex:none}.om-brand img{display:block;width:100%}.om-hud-values{display:flex;align-items:center;gap:24px;flex:1}.om-stat{border-left:1px solid #3b555b;padding-left:18px}.om-stat>span{display:block;letter-spacing:.12em;font-size:9px;color:#9db4b5}.om-stat>strong{font-size:23px;font-weight:550;line-height:1.1;font-variant-numeric:tabular-nums;color:#d1dcca}.om-stat small{display:inline;font-size:12px;color:#96b2b3}.om-alert-status{display:flex;align-items:center;gap:9px;background:#21363a;border:1px solid #3e5654;color:#c3cdad;font-size:11px;padding:7px 9px;border-radius:3px;min-height:32px}.om-clock{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}.om-clock>span{display:block;letter-spacing:.14em;font-size:9px;color:#c1b48e}.om-clock small{font-size:9px;display:inline;letter-spacing:0;color:#8facad}.om-clock>strong{font-size:24px;font-weight:540;line-height:1.1}.om-speed{display:flex;gap:3px}.om-speed .om-btn{min-width:34px;min-height:36px;padding:7px;font-size:13px}.om-menu-button{padding:8px 12px}.om-routine-bar{height:43px;flex:none;background:#23383b;border-bottom:1px solid #41544f;display:flex;align-items:center;justify-content:space-between;padding:0 20px;gap:12px;font-size:12px}.om-routine-bar>div{display:flex;align-items:center;gap:12px;min-width:0}.om-routine-bar strong{font-weight:550;white-space:nowrap}.om-routine-bar span{color:#a3b9b2;font-size:10px;letter-spacing:.02em}.om-routine-bar .om-btn{min-height:30px;font-size:11px;padding:5px 10px;border-color:#526652;background:#2e4340}.om-routine-bar .om-mode.is-active{background:#394f43;border-color:#a59f72}.om-workspace{position:relative;flex:1;min-height:0;display:flex;overflow:hidden}.om-map-shell{position:relative;flex:1;min-width:0;overflow:hidden;background:#263d43}.om-map-shell.is-alarm::after{content:"";position:absolute;inset:0;pointer-events:none;z-index:9;box-shadow:inset 0 0 90px #b8322a90;animation:alarm-pulse 1.1s ease-in-out infinite}@keyframes alarm-pulse{0%,100%{opacity:.3}50%{opacity:.95}}.reduce-motion .om-map-shell.is-alarm::after{animation:none;opacity:.6}.om-actor.pose-idle img{animation:idle-breathe 3.4s ease-in-out infinite}@keyframes idle-breathe{0%,100%{transform:translateY(0)}50%{transform:translateY(-1px)}}.reduce-motion .om-actor.pose-idle img{animation:none}.om-mapviewport{position:absolute;inset:0;overflow:hidden;touch-action:none;cursor:crosshair;user-select:none}.om-world{position:absolute;left:50%;top:50%;transform-origin:center;pointer-events:none;will-change:transform}.om-tilemap{position:absolute;inset:0;width:3072px;height:3072px;image-rendering:pixelated}.om-prop{position:absolute;filter:drop-shadow(2px 4px 1px #081b2260);pointer-events:none}.om-prop img{width:100%;height:100%;display:block}.om-map-door{position:absolute;pointer-events:none}.om-map-door img{height:100%;width:100%}.om-map-door>i{position:absolute;right:3px;top:3px;width:4px;height:4px;background:#d89570;border:1px solid #352d29}.om-map-door.permitted>i{background:#add59e;border-color:#233e34}.om-night{position:absolute;inset:0;background:#052747;z-index:5;pointer-events:none}.om-light{position:absolute;border-radius:50%;background:radial-gradient(ellipse,#f1c16845 0%,#d0aa5e1c 32%,transparent 70%);mix-blend-mode:screen;pointer-events:none}.om-cone{position:absolute;z-index:7;background:#d8c78330;pointer-events:none}.om-cone-camera{background:#70c6d134}.om-cone-backup{background:#e8b15a42}.om-cone-danger{background:#ea6d5252}.om-actor{position:absolute;width:32px;height:40px;pointer-events:none}.om-person-sprite{position:relative;width:32px!important;height:40px!important;max-width:none!important;z-index:2;filter:drop-shadow(0 1px 1px #07101d)}.om-feet-ring{position:absolute;left:4px;bottom:1px;width:25px;height:10px;display:none;border:2px solid #efbf7b;border-radius:50%;z-index:1}.om-actor-player .om-feet-ring,.om-actor.selected .om-feet-ring,.om-actor.crew .om-feet-ring{display:block}.om-actor-player .om-feet-ring{box-shadow:0 0 8px #f5d69488}.om-actor.crew .om-feet-ring{border-color:#98d6c4}.om-actor-label{position:absolute;left:50%;bottom:40px;transform:translateX(-50%);padding:1px 5px;border:1px solid #718b8566;background:#0b253de6;border-radius:3px;white-space:nowrap;color:#dbe9e0;font-size:10px;line-height:1.5;z-index:4;box-shadow:0 2px 4px #07182470}.om-actor-player .om-actor-label{background:#665333;border-color:#e3b777;color:#fff0cb;font-weight:700;font-size:9px;letter-spacing:.1em}.om-notice-track{position:absolute;left:1px;top:-23px;width:30px;height:4px;background:#213540}.om-notice-track i{display:block;background:#df997d;height:100%}.om-sleep{position:absolute;top:-10px;right:-4px;color:#d7e7e0;font-size:14px;line-height:1;z-index:5;animation:sleep-drift 2.6s ease-in-out infinite;animation-delay:inherit;text-shadow:0 1px 2px #07101d}.om-sleep>i{position:absolute;left:8px;top:-9px;font-size:10px;font-style:normal;opacity:.7}.om-blanket{position:absolute;left:1px;top:19px;width:30px;height:23px;z-index:3;border-radius:5px 5px 3px 3px;background:repeating-linear-gradient(180deg,#6f9184 0 5px,#628376 5px 7px);border:1px solid #38524a;box-shadow:inset 0 2px 0 #9ab7a9,0 2px 3px #07101d66}.om-actor.pose-sleep .om-person-sprite{filter:none;opacity:.96}.om-actor.pose-sleep .om-feet-ring,.om-actor.pose-bedsit .om-feet-ring{bottom:-6px;opacity:.7}.om-actor.pose-sleep .om-actor-label{bottom:44px}.om-actor.pose-bedsit .om-person-sprite{transform:translateY(2px)}.om-actor.pose-doze .om-person-sprite{filter:drop-shadow(0 1px 1px #07101d) brightness(.85)}@keyframes sleep-drift{0%,100%{transform:translate(0,0);opacity:.55}50%{transform:translate(2px,-5px);opacity:1}}.om-work-spark{position:absolute;right:-3px;top:22px;width:5px;height:5px;border-radius:50%;background:#e1c782;animation:workpulse 1s infinite}.om-room-label{position:absolute;z-index:160;text-align:center;font-size:9px;letter-spacing:.19em;line-height:1.6;font-weight:650;color:#d0dad0;text-shadow:0 1px 4px #0e2836,0 0 3px #0e2836;pointer-events:none;padding:2px;background:linear-gradient(90deg,transparent,#23384099,transparent)}.om-path-dot{position:absolute;z-index:160;transform:translate(-50%,-50%);width:5px;height:5px;border-radius:50%;background:#d0e5c9;box-shadow:0 0 2px #2c4e57}.om-map-selection{position:absolute;border:2px solid #f1c67f;border-radius:4px;box-shadow:0 0 10px #e6c77d55;pointer-events:none}.om-map-marker{position:absolute;pointer-events:none}.om-map-marker>i{position:absolute;inset:0;border:2px dashed #e8c795;border-radius:3px}.om-map-marker>span{position:absolute;bottom:100%;left:50%;transform:translateX(-50%);font-size:9px;letter-spacing:.13em;color:#f3d3a0;white-space:nowrap;background:#213e47;padding:2px 5px}.om-map-marker.exit>i{border-color:#e6dcb3;box-shadow:0 0 20px #ddc892b0}.om-map-marker.truck img{width:100%;height:100%}.om-weather{position:absolute;inset:0;pointer-events:none;overflow:hidden}.om-weather.rain>i,.om-weather.storm>i{position:absolute;inset:-70%;background-image:repeating-linear-gradient(111deg,transparent 0 42px,#c3d4dc38 43px,transparent 44px 130px);animation:rainfall .65s linear infinite;opacity:.3;transform:rotate(3deg)}.om-weather.storm>i{opacity:.55}.om-weather.fog{background:linear-gradient(115deg,#aac0c326,transparent 40%,#8fa7ad20)}.om-map-caption{position:absolute;left:22px;top:18px;padding:8px 13px;background:#092235db;border-left:2px solid #d9b479;border-radius:2px;pointer-events:none;z-index:15;backdrop-filter:blur(3px)}.om-map-caption>span{display:block;color:#a5bfbd;letter-spacing:.14em;font-size:9px}.om-map-caption>strong{font-size:16px;font-weight:550;letter-spacing:-.025em}.om-map-caption>small{font-size:10px;color:#8eaead}.om-map-tools{position:absolute;right:16px;top:18px;display:flex;gap:4px;z-index:20}.om-map-tools .om-btn{background:#193744ed;padding:7px;min-width:34px;min-height:34px;font-size:16px;box-shadow:0 4px 7px #0c1f2666}.om-paused{position:absolute;left:50%;top:23px;transform:translateX(-50%);background:#d1b783e8;padding:6px 16px;border-radius:3px;color:#1e3440;font-size:10px;letter-spacing:.17em;text-align:center;z-index:12;font-weight:750}.om-paused span{display:block;font-size:8px;font-weight:400;letter-spacing:.03em}.om-crew-strip{position:absolute;left:22px;top:112px;display:flex;flex-direction:column;gap:6px;z-index:15}.om-crew-face{width:53px;height:65px;border:1px solid #738981;background:#153341e8;border-radius:4px;padding:4px;color:#c9dcca;display:grid;justify-items:center;font-size:9px}.om-crew-face img{height:40px;width:32px;object-fit:contain}.om-crew-face.is-active{border-color:#e8c183;background:#465345ee}.om-crew-face>span{font-size:8px;line-height:1}.om-player-dock{position:absolute;left:22px;bottom:42px;width:246px;background:#0d2836ed;border:1px solid #6c8a8b80;border-radius:5px;padding:10px 13px;box-shadow:0 4px 22px #08212a66;z-index:15;backdrop-filter:blur(4px)}.om-player-heading{display:flex;gap:12px;margin-bottom:9px;align-items:center}.om-player-heading>img{width:30px;height:39px}.om-player-heading>div{flex:1;min-width:0}.om-player-heading strong{font-size:12px;display:block;color:#dfdfc2;font-weight:600}.om-player-heading span{font-size:9px;color:#a6c0bd;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.om-need{display:flex;align-items:center;gap:8px;margin:5px 0;font-size:9px;color:#afc7c5}.om-need>span{width:42px;flex:none}.om-need b{font-size:9px;width:20px;text-align:right;color:#c5d5c7;font-variant-numeric:tabular-nums;font-weight:500}.om-mini-wrap{position:absolute;right:16px;bottom:39px;width:134px;background:#12303de8;border:1px solid #577b8066;border-radius:4px;padding:6px;z-index:15;box-shadow:0 3px 16px #04172766}.om-minimap{width:120px;height:120px;background:#2