 .om-toolbar{height:calc(48px + env(safe-area-inset-bottom,0px))}.om-toolbar>button{min-height:44px;padding:3px 9px;gap:1px}.om-toolbar>button>img{width:17px;height:17px}
 .om-map-tools{top:8px}.om-map-caption{top:8px;max-width:160px}.om-map-caption small{display:none}.om-crew-strip{display:none}.om-paused{top:62px;right:12px;left:auto;transform:none}
 .om-player-dock{width:166px;left:10px;bottom:25px;padding:5px 8px}.om-player-heading{margin-bottom:1px}.om-player-heading>img{width:22px;height:28px}.om-player-heading .om-link{display:none}.om-player-dock .om-desktop-only{display:none}.om-player-heading span{max-width:112px;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}
 .om-mini-wrap{width:112px;bottom:25px}.om-minimap{display:none}.om-mini-wrap .om-link{font-size:10px!important;min-height:40px}
 .om-task-toast{left:186px;right:140px;bottom:25px;padding:7px;max-width:none}.om-task-toast strong{font-size:10px;margin:2px 0}.om-task-toast small{font-size:9px;margin-bottom:4px}
 .om-panel-head{padding:8px 14px}.om-panel-head .om-eyebrow,.om-panel-foot{display:none}.om-panel-body{padding:12px 16px}.om-modal-backdrop{padding:8px}.om-modal{max-height:100%;padding:18px}
 .om-attendance{top:59px;left:10px;right:140px;transform:none;width:auto}.om-attendance small{display:none}
}
