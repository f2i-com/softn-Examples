#if (dialog)
<div className="om-modal-backdrop"><section className={"om-modal "+(dialog === "help" || dialog === "saves" ? "om-modal-wide" : "")} role="dialog" aria-modal="true" aria-label="Outermate dialog">
 #if (dialog === "arrival")
  <div className="om-modal-banner"><img src={asset("assets/art/logo-mark.svg")} alt="" /><span className="om-eyebrow">INTAKE COMPLETE / DAY 1 / 05:50</span><h2>Your number is not your name.</h2></div>
  <p>{"Welcome to " + prisonName() + ", " + playerCard.name + ". Morning count begins at 06:00. Your assignment gives you legitimate work access. Your longer-term plans were not requested on the intake form."}</p>
  #if (storyCard)<div className="om-note"><strong>{storyCard.title}</strong><p>{storyCard.body}</p><small>{"Your contact: " + storyCard.name + " / Seed: " + storyCard.seed}</small><p className="om-layout-hint">{storyCard.layout + ": " + storyCard.layoutHint}</p>#if (storyCard.history)<p className="om-layout-hint">{storyCard.history}</p>#end</div>#end
  <div className="om-note"><strong>Routine mode is on.</strong> Your inmate will walk to count, eat, work and sleep in their bunk automatically. Any move or interaction gives you manual control. Use <strong>Return to routine</strong> when you finish.</div>
  <div className="om-onboarding"><div><b>01</b><span><strong>Look around.</strong> Tap people, fixtures and doors for their action menu. Drag to pan. Zoom out for the whole prison.</span></div><div><b>02</b><span><strong>Choose, then go.</strong> Nothing moves until you pick an action or Walk here; your inmate walks into range first. Work access depends on your assignment and the time.</span></div><div><b>03</b><span><strong>Learn first.</strong>{" " + laundryContactName + " works the laundry detail. Inspect fixtures to discover their routes. Your cell has a stash and an old drainage cover. Pause whenever you need to plan."}</span></div></div>
  <button className="om-btn om-wide" @click={watchFirstDay}>Watch my day automatically</button><button className="om-btn om-primary om-wide" @click={beginFirstCount}>Answer the first count →</button><small className="om-muted">The first missed count is a warning, not game over.</small>
 #end
 #if (dialog === "menu")
  <span className="om-eyebrow">PERSONAL EFFECTS</span><h2>Take a moment.</h2><p>The simulation is paused while this menu is open.</p>
  <button className="om-btn om-primary om-wide" @click={closeDialog}>Return to the prison</button>
  <button className="om-btn om-wide" @click={() => openDialog("saves")}>Save, load and export</button>
  <button className="om-btn om-wide" @click={() => openDialog("settings")}>Picture, sound and accessibility</button>
  <button className="om-btn om-wide" @click={() => openDialog("help")}>Inmate handbook</button>
  <button className="om-btn om-wide" @click={returnToTitle}>Save and return to title</button>
  <div className="om-note">{"OUTERMATE / FIRST COUNT " + OM_VERSION}<br /><a className="om-credit" href="https://www.lance.name" target="_blank" rel="noopener">Created by Lance</a> · <a className="om-credit" href="https://www.softn.com" target="_blank" rel="noopener">Powered by SoftN</a></div>
 #end
 #if (dialog === "settings")
  <span className="om-eyebrow">PICTURE / SOUND / ASSIST</span><h2>Make the place readable.</h2>
  <button className="om-setting" @click={toggleAmbience}><div><strong>Prison ambience</strong><small>{ambienceFailed ? "Waiting for your first click or key press before audio can start." : "Quiet ventilation and distant wind. Plays during the game; stops when paused."}</small></div><b>{ambienceEnabled ? "ON" : "OFF"}</b></button>
  <button className="om-setting" @click={() => toggleSetting("background")}><div><strong>Keep running when not in focus</strong><small>The day carries on while you are in another window. Off: the game pauses the moment it loses focus. Browsers slow background tabs, so a switched-away run may crawl rather than race.</small></div><b>{runInBackground ? "ON" : "OFF"}</b></button>
  <button className="om-setting" @click={toggleMusic}><div><strong>Music</strong><small>A title theme, a routine piece, a night piece and an escape underscore. Plays quietly under the game.</small></div><b>{musicEnabled ? "ON" : "OFF"}</b></button>
  <button className="om-setting" @click={toggleVoice}><div><strong>Voices</strong><small>Public-address announcements, officer challenges, the narrator and inmates who pass close by.</small></div><b>{voiceEnabled ? "ON" : "OFF"}</b></button>
  <button className="om-setting" @click={toggleGuide}><div><strong>Escape guide</strong><small>A choice-driven planner on the Day panel. Optional; the game plays the same without it.</small></div><b>{guideEnabled ? "ON" : "OFF"}</b></button>
  <button className="om-setting" @click={() => toggleSetting("sound")}><div><strong>Sound effects</strong><small>Doors, alarms, work, meals, the yard and the night rounds.</small></div><b>{soundEnabled ? "ON" : "OFF"}</b></button>
  <button className="om-setting" @click={() => toggleSetting("motion")}><div><strong>Reduced motion</strong><small>Static walking frames. No animated rain or pulses.</small></div><b>{reducedMotion ? "ON" : "OFF"}</b></button>
  <button className="om-setting" @click={() => toggleSetting("contrast")}><div><strong>High contrast</strong><small>Stronger borders, text and character labels.</small></div><b>{highContrast ? "ON" : "OFF"}</b></button>
  <button className="om-setting" @click={() => toggleSetting("security")}><div><strong>Security coverage</strong><small>Draw coverage you have studied in person.</small></div><b>{showSecurity ? "ON" : "OFF"}</b></button>
  <button className="om-setting" @click={() => toggleSetting("full")}><div><strong>Reveal all security cones</strong><small>Optional planning assist. No ending penalty.</small></div><b>{fullSecurity ? "ON" : "OFF"}</b></button>
  <button className="om-setting" @click={() => toggleSetting("pause")}><div><strong>Pause on guard challenge</strong><small>Choose a response before pursuit continues.</small></div><b>{pauseOnNotice ? "ON" : "OFF"}</b></button>
  <button className="om-btn om-primary om-wide" @click={closeDialog}>Done</button>
 #end
 #if (dialog === "saves")
  <span className="om-eyebrow">YOUR RUN / YOUR FILE</span><h2>Keep an exit copy.</h2><p>Three manual slots and three rotating autosaves. Loading always begins paused. There is no offline simulation.</p>
  <div className="om-save-grid">#each (s in slotCards) key={s.id}<div className="om-card"><h3>{s.name}</h3><small>{s.detail}</small><div className="om-row">#if (!s.automatic)<button className="om-btn om-grow" disabled={!playerCard.name} @click={() => saveSlot(s.index,false)}>Save</button>#end<button className="om-btn om-grow" disabled={!s.exists} @click={() => loadSlot(s.index,s.automatic)}>Load</button></div></div>#end</div>
  <div className="om-section-title">PORTABLE SAVE TEXT</div><textarea className="om-save-text" :bind={saveText} spellcheck={false} rows={5} placeholder="Export your current run, or paste an Outermate save here." />
  <div className="om-row"><button className="om-btn om-grow" disabled={!playerCard.name} @click={exportSave}>Export current run</button><button className="om-btn om-grow" @click={importSaveFile}>Open save file…</button><button className="om-btn om-grow" @click={importSave}>Import pasted text</button></div>
  <p className="om-note" role="status">{saveMessage || "Browser storage is not a backup. Keep an exported file before clearing site data or updating the game."}</p>
  <button className="om-btn om-wide" @click={closeDialog}>Close</button>
 #end
 #if (dialog === "help")
  <span className="om-eyebrow">THE UNOFFICIAL INMATE HANDBOOK</span><h2>Build a plan, not a bigger prison.</h2>
  <div className="om-help-grid"><div><h3>Control your inmate</h3><p>Tap a person, fixture, door or tile to open its action menu; nothing moves until you choose. The <strong>escape guide</strong> at the top of the Day panel lays out a route as choices; each choice adds the right orders, a tick shows when a step is already in your list, and <strong>Let the guide choose for me</strong> makes it queue its own first choice whenever the list runs dry. <strong>Guided start</strong> on the title does both for your story's route in one tap. It can be hidden in settings. Every choice joins your <strong>order list</strong> on the Day panel: orders run one after another, and on Auto day the routine carries on in the gaps, pauses for counts and lock-in, and resumes. An order that cannot be done yet waits and says why; cancel any order from the list. Right-click walks straight away on desktop. Drag to pan, scroll or use +/− to zoom; on touch, pinch to zoom.</p><p><strong>Space:</strong> pause. <strong>1 / 2 / 4:</strong> speed. <strong>R:</strong> routine/manual. <strong>F:</strong> follow yourself. <strong>G:</strong> escape guide. <strong>M:</strong> whole map. <strong>I:</strong> pockets. <strong>E:</strong> escape. <strong>N:</strong> notebook. <strong>? / H:</strong> handbook.</p></div><div><h3>Learn the day</h3><p>Count is at 06:00 and 21:00, with a short arrival grace period. Work shifts are 07:15–11:30 and 13:00–16:30. Doors recognise assignments during those shifts. Complete two lawful batches to unlock advanced jobs, then visit the noticeboard in Association to switch.</p><p>Lock-in is at 22:00 and lights out at 22:30. Sleeping in your bunk restores energy and eases stress; five hours or more earns a calmer morning, and a night without sleep costs you. An officer walks the cell fronts at about 23:30 and 03:00 and looks through the bars: an empty bunk is written down, and during an escape it raises the alarm. A decoy covers one check. Your cellmate talks before the lights go out. Routine mode handles everyday life. It is not a pause button: the entire prison keeps moving.</p></div><div><h3>Materials, people and privacy</h3><p>Collect materials from a station, or buy them from inmates. Racks refill after 45 game minutes. Inmate trades have their own cooldown. The commissary window at the meal counter sells tea, blank forms, an extra ration and a letter home, with small daily limits; open it from the Pockets panel when you are at the counter.</p><p>Talk, accept a favour, then deliver the item in person. Joining a yard game or a hand of cards during social time also builds a little trust. A completed favour and enough trust allow recruitment: 35 as a rule, 25 for the bold, 50 for the cautious, and rivals will not share a plan below 60. Every inmate has traits, a skill they share at 30 trust, a weakness and a bias; they are friends, family, rivals or debtors to one another, come to you with their own wants at meals and in the yard, and remember what you do. An inmate who owes you a favour will hold a piece of contraband where searches never look. Three allies is a crew, not an army.</p><p><strong>Force.</strong> Sharpen a shank at the workshop bench. Any person can be attacked from their action menu: officers are tough, so a shank, allies nearby and no other officer in view matter, and losing means isolation. A downed officer can be dragged out of camera cones and patrol routes, and stripped of their uniform, which reads as staff from a distance until they are found; the Maintenance Ghost route accepts it. Inmates who carry a grudge and a blade wait for a quiet moment at meals or in the yard. Stressed hot-heads fight their rivals, and enough fights on a hot day, or a crew and a favour, start a riot: officers converge on it, the tunnel and the fence can be worked in daylight, and lockdown follows. Use physical stashes and a concealment project to protect supplies.</p></div><div><h3>Your first complete route</h3><p><strong>Under the Walls:</strong> observe your cell's drainage cover. Make a tool kit at the workshop using two salvage pieces. Bring the kit, two more salvage pieces and one cloth bundle to the drainage project. It can only be worked after lock-in, over two or three nights; stop before the night rounds pass at about 23:30 and 03:00, and resume once the officer has moved on. Work persists across interruptions. Once it is ready, begin the route, travel outside, then choose <strong>Leave prison</strong> at the marked canyon exit.</p><p><strong>Wrong Truck:</strong> observe the laundry cart, prepare its concealment project, then gain Loading access. Reach the dock between 13:30 and 14:30. Keep personal suspicion below 60 and avoid lockdown at the departure inspection.</p><p><strong>Timing rules:</strong> the drainage tunnel is worked after lock-in, the east fence only at dusk (19:00 to 21:00), the blackout only during a work shift, and the paper release is reviewed 08:00 to 18:00. The escape planner shows each route's usual pace.</p></div><div><h3>Suspicion is not magic</h3><p>Guards and cameras need a visible violation. Walls and closed solid doors block sight. Known cones are available after observation; an assist option can reveal them all. A main-power failure disables only main-circuit cameras. Emergency coverage stays alive.</p><p>Guards pursue last-seen positions. Break line of sight or answer the challenge. A capture confiscates restricted pocket items and sends you to brief isolation. Stashes and most project progress remain.</p></div><div><h3>The wall is not the ending</h3><p>Prepare a route, study its timing and call allies to a rendezvous. Only allies who actually get there join the attempt. Cross the perimeter, reach extraction, and decide when to leave. You can wait for your crew.</p><p>Carrying quota evidence changes the epilogue. Leaving a promised ally behind changes it too. All six route families are playable in this First Count build; underground travel and freight transit are deliberately compact sequences, not separate open-world simulations.</p></div></div>
  <div className="om-note">First Count is a playable foundation, not the entire long-term design. No combat simulator, multiplayer, general underground floor, advanced mod API or full voice campaign is included.</div><button className="om-btn om-primary om-wide" @click={closeDialog}>Back to the plan</button>
 #end
 #if (dialog === "challenge" && eventCard)
  <span className="om-eyebrow om-danger-text">YOU HAVE SOME EXPLAINING TO DO</span><h2>{eventCard.name}</h2><p>“Hold there. What exactly are you doing?”</p><div className="om-warning">{eventCard.reason}</div><p>A valid uniform and pass can explain legitimate access, not exposed project work. A bluff is a chance, not a guarantee.</p>
  <button className="om-btn om-wide" disabled={!eventCard.pass} @click={() => answerChallenge("pass")}>Show your work pass</button>
  <button className="om-btn om-wide" @click={() => answerChallenge("bluff")}>Try an explanation</button>
  <button className="om-btn om-primary om-wide" @click={() => answerChallenge("run")}>Run and break line of sight</button>
  <button className="om-link" @click={() => answerChallenge("submit")}>Submit to the search</button>
 #end
 #if (dialog === "detained")
  <span className="om-eyebrow">{hud.detainedWhere === "infirmary" ? "INFIRMARY REST BAY" : "SHORT-STAY ISOLATION"}</span><h2>{hud.detainedWhere === "infirmary" ? "Patched up, not finished." : "A setback, not an ending."}</h2><p>{hud.detainedWhere === "infirmary" ? "You are on a rest bay until the orderly signs you off. Nothing was confiscated; the bruises will remember for a while." : "Your restricted pocket items were confiscated. Most project work and hidden supplies are still there. The record now has one more entry."}</p><div className="om-note">{playerCard.detention + " game minutes remain. The next button advances the live prison at 4×. Return to your cell, rebuild what was lost, and choose a quieter opportunity."}</div><button className="om-btn om-primary om-wide" @click={serveDetention}>Serve the short stay →</button>
 #end
 #if (dialog === "ending" && endingCard)
  <div className="om-ending-mark"><img src={asset("assets/art/logo-mark.svg")} alt="" /></div><span className="om-eyebrow">{"BEYOND THE WALLS / DAY " + endingCard.day + " / " + endingCard.time}</span><h2 className="om-ending-title">{endingCard.title}</h2><p className="om-ending-body">{endingCard.body}</p><div className="om-note"><strong>{endingCard.route}</strong><br />{"Escaped with: " + (endingCard.escaped.length ? endingCard.escaped.join(", ") : "No one. This was your own way out.")}<br />{"Still inside: " + (endingCard.left.length ? endingCard.left.join(", ") : "No promises left behind.")}<br />{"Previous captures: " + endingCard.captures}<br />{"Days inside: " + endingCard.day + " · Work batches: " + endingCard.work + " · Contacts made: " + endingCard.met + " · Favours kept: " + endingCard.favors + " · Scrip left behind: " + endingCard.scrip}</div><button className="om-btn om-primary om-wide" @click={returnToTitle}>Keep the story. Return to title.</button><button className="om-link" @click={() => openDialog("saves")}>Export the completed run</button>
 #end
 #if (dialog === "restart")<span className="om-eyebrow">A NEW INTAKE</span><h2>Begin a different run?</h2><p>The current run will be placed in a rotating autosave first. Manual saves are not overwritten.</p><button className="om-btn om-primary om-wide" @click={newGame}>Start a new sentence</button><button className="om-btn om-wide" @click={closeDialog}>Keep the current run</button>#end
 #if (dialog === "surrender")<span className="om-eyebrow">ANOTHER DAY IS STILL A CHANCE</span><h2>Call it off?</h2><p>Surrender returns you to brief isolation and confiscates restricted pocket items. Undiscovered stashes and most project progress remain.</p><button className="om-btn om-primary om-wide" @click={surrender}>Surrender</button><button className="om-btn om-wide" @click={closeDialog}>Keep going</button>#end
 #if (dialog === "error")<span className="om-eyebrow om-danger-text">SIMULATION PAUSED</span><h2>Something interrupted the run.</h2><p>{lastError}</p><p>Keep an export before restarting. The game will not continue ticking over a failed step.</p><button className="om-btn om-primary om-wide" @click={() => openDialog("saves")}>Export or restore a save</button><button className="om-btn om-wide" @click={returnToTitle}>Return to title</button>#end
</section></div>
#end
