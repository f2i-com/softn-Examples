<div className="om-note">{crewSummary}<br />Complete an inmate's favour and earn their trust to recruit them: 35 as a rule, 25 for the bold, 50 for the cautious. Rivals will not share a plan below 60 trust. Allies must physically reach the rendezvous to leave with you.</div>
<div className="om-row"><button className="om-btn om-grow" @click={requestCrewMeet}>Meet for selected route</button><button className="om-btn" @click={releaseCrew}>Stand down</button></div>
#each (c in inmateCards) key={c.id}<button className={"om-contact "+(c.crew?"crew":"")} @click={() => selectPerson(c.id,true)}><img src={asset(c.portrait)} alt="" /><div><div className="om-row om-between"><strong>{c.name}</strong><span className="om-chip">{c.crew ? "CREW" : c.trust+" TRUST"}</span></div><span>{c.trait + " · " + c.job}</span>#if (c.traits)<small className="om-traits">{c.traits + (c.skill ? " · knows " + c.skill.toLowerCase() : "")}</small>#end#if (c.relations)<small className="om-relations">{c.relations}</small>#end<small>{c.favor}</small><small className="om-cyan">{c.location + " · " + c.action}</small></div></button>#end
