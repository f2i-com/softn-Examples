// Layout (0.11.0): what a seed moves. Rooms with a matching footprint swap places, the starting cell
// is drawn from the seed, and every fixture, door, anchor and piece of furniture that belongs to a room
// goes with it. The authored tables stay the source of truth: a layout is applied on top of a snapshot
// of them and taken off again before the next game, so classic Greywall is always classic.
const LAYOUT_SWAPS=[["laundry","workshop"],["maintenance","records"]];
const PLAYER_CELLS=["A1","A2","A3","A4","B1","B2"];
const ROOM_PROPS=[
 {zone:"laundry",kind:"washer",x:20,y:65,w:3,h:2},{zone:"laundry",kind:"locker",x:29,y:59,w:1,h:3},
 {zone:"workshop",kind:"locker",x:46,y:57,w:1,h:3},{zone:"workshop",kind:"workbench",x:37,y:65,w:3,h:2},{zone:"workshop",kind:"shelf",x:45,y:65,w:2,h:2},
 {zone:"maintenance",kind:"battery",x:60,y:58,w:1,h:3},{zone:"maintenance",kind:"battery",x:60,y:64,w:1,h:3},
 {zone:"records",kind:"shelf",x:69,y:65,w:3,h:2},{zone:"records",kind:"desk",x:74,y:62,w:2,h:2}
];
// Seeded interior kits: what the generator may add to a room beyond the authored furniture.
const ROOM_KITS={laundry:[["washer",3,2],["locker",1,3],["shelf",2,1]],workshop:[["crates",2,2],["locker",1,3],["shelf",2,2]],maintenance:[["battery",1,3],["shelf",2,2],["crates",2,2]],records:[["desk",2,2],["shelf",3,1],["shelf",1,3]],canteen:[["table",4,2],["shelf",2,1]],loading:[["crates",3,3],["crates",2,2]],association:[["table",3,2],["shelf",2,1],["bench",1,3]],yard:[["bench",1,4],["bench",4,1],["rock",2,2]]};
let layoutBase=null,layoutApplied=null,layoutShift={};
function layoutSnapshot(){
 if(layoutBase)return;
 layoutBase={zones:ZONES.map(function(z){return {x:z.x,y:z.y,w:z.w,h:z.h,ax:z.anchor.x,ay:z.anchor.y};}),sites:SITES.map(function(s){return {x:s.x,y:s.y,w:s.w,h:s.h,ax:s.ax,ay:s.ay,zone:s.zone};}),doors:DOORS.map(function(d){return {x:d.x,y:d.y};}),staff:STAFF.map(function(d){return d.route.map(function(p){return [p[0],p[1]];});})};
}
function layoutForSeed(seed){
 let h=hashSeed(String(seed).slice(0,48)+":layout-rooms:v1"),swaps=[];
 for(let i=0;i<LAYOUT_SWAPS.length;i++)if((h>>>(i*3))&1)swaps.push(LAYOUT_SWAPS[i].slice());
 return {version:1,swaps:swaps,cell:PLAYER_CELLS[(h>>>8)%PLAYER_CELLS.length]};
}
function validLayout(l){
 if(!l||typeof l!=="object"||l.version!==1||!Array.isArray(l.swaps)||PLAYER_CELLS.indexOf(l.cell)<0||l.swaps.length>LAYOUT_SWAPS.length)return false;
 let seen={};for(let pair of l.swaps){if(!Array.isArray(pair)||pair.length!==2)return false;let known=LAYOUT_SWAPS.some(function(p){return p[0]===pair[0]&&p[1]===pair[1];});if(!known||seen[pair[0]])return false;seen[pair[0]]=true;}
 return true;
}
function currentLayout(){return omGame&&omGame.generation&&omGame.generation.layout?omGame.generation.layout:null;}
function playerCellId(){return layoutApplied?layoutApplied.cell:"A1";}
function cellById(id){for(let c of CELLS)if(c.id===id)return c;return null;}
function clampInto(z,x,y,w,h){return {x:clamp(x,z.x+1,z.x+z.w-1-(w||1)),y:clamp(y,z.y+1,z.y+z.h-1-(h||1))};}
function layoutPoint(zoneId,x,y,w,h){let s=layoutShift[zoneId];if(!s)return {x:x,y:y};let z=zoneById(zoneId);return clampInto(z,x+s.dx,y+s.dy,w,h);}
function restoreLayout(){
 for(let i=0;i<ZONES.length;i++){let z=ZONES[i],b=layoutBase.zones[i];z.x=b.x;z.y=b.y;z.w=b.w;z.h=b.h;z.anchor.x=b.ax;z.anchor.y=b.ay;}
 for(let i=0;i<SITES.length;i++){let s=SITES[i],b=layoutBase.sites[i];s.x=b.x;s.y=b.y;s.w=b.w;s.h=b.h;s.ax=b.ax;s.ay=b.ay;s.zone=b.zone;}
 for(let i=0;i<DOORS.length;i++){DOORS[i].x=layoutBase.doors[i].x;DOORS[i].y=layoutBase.doors[i].y;}
 for(let i=0;i<STAFF.length;i++)STAFF[i].route=layoutBase.staff[i].map(function(p){return [p[0],p[1]];});
 layoutShift={};layoutApplied=null;
}
function applyLayout(layout){
 layoutSnapshot();if(!validLayout(layout))layout=null;
 if(JSON.stringify(layout)===JSON.stringify(layoutApplied))return;
 restoreLayout();if(!layout)return;
 layoutApplied=JSON.parse(JSON.stringify(layout));
 for(let pair of layout.swaps){
  let a=zoneById(pair[0]),b=zoneById(pair[1]),ra={x:a.x,y:a.y,w:a.w,h:a.h},rb={x:b.x,y:b.y,w:b.w,h:b.h};
  a.x=rb.x;a.y=rb.y;a.w=rb.w;a.h=rb.h;b.x=ra.x;b.y=ra.y;b.w=ra.w;b.h=ra.h;
  layoutShift[a.id]={dx:rb.x-ra.x,dy:rb.y-ra.y};layoutShift[b.id]={dx:ra.x-rb.x,dy:ra.y-rb.y};
  moveZoneContents(a,ra);moveZoneContents(b,rb);
 }
 applyPlayerCell(layout.cell);
}
// Everything that lived in the room moves with it: anchor, fixtures and their approach tiles, the
// district door along its frontage, and any staff waypoint inside.
function moveZoneContents(z,old){
 let s=layoutShift[z.id],dx=s.dx,dy=s.dy,inside=function(x,y){return x>old.x&&x<old.x+old.w-1&&y>old.y&&y<old.y+old.h-1;};
 let a=clampInto(z,z.anchor.x+dx,z.anchor.y+dy,1,1);z.anchor.x=a.x;z.anchor.y=a.y;
 for(let site of SITES){if(site.zone!==z.id)continue;let p=clampInto(z,site.x+dx,site.y+dy,site.w,site.h),q=clampInto(z,site.ax+dx,site.ay+dy,1,1);site.x=p.x;site.y=p.y;site.ax=q.x;site.ay=q.y;}
 for(let d of DOORS){if(d.job!==z.id||["block","public","work","staff"].indexOf(d.kind)<0)continue;
  let y=d.y===old.y?z.y:d.y===old.y+old.h-1?z.y+z.h-1:d.y+dy;d.x=clamp(d.x+dx,z.x+2,z.x+z.w-3);d.y=y;}
 for(let st of STAFF)for(let pt of st.route)if(inside(pt[0],pt[1])){let p=clampInto(z,pt[0]+dx,pt[1]+dy,1,1);pt[0]=p.x;pt[1]=p.y;}
}
// The player's bunk and the drain below the block follow the chosen cell; every cell shares the same
// geometry (beds on the left, sink on the right), so the drain sits under the sink as it does in A1.
function applyPlayerCell(id){
 let cell=cellById(id);if(!cell)return;let bed=cell.beds[0],bunk=siteById("bunk")||SITES.find(function(s){return s.id==="bunk";}),drain=SITES.find(function(s){return s.id==="cellDrain";});
 bunk.x=bed.x;bunk.y=bed.y;bunk.ax=bed.side.x;bunk.ay=bed.side.y;bunk.zone=cell.block;
 drain.x=cell.sink.x;drain.y=cell.sink.y+1;drain.ax=cell.sink.x;drain.ay=cell.sink.y+3;drain.zone=cell.block;
}
// Prison history: two seeded facts with a bearing on play, shown at intake and in the personal story.
const HISTORY_EVENTS=[
 {id:"tunnels",title:"the riot of {year}",text:"Utility runs below the blocks were damaged in the riot of {year} and never fully refilled.",play:"Tunnel work goes a fifth faster."},
 {id:"fence",title:"the perimeter upgrade",text:"The east perimeter electronics were replaced {ago} years ago; the searchlight sweeps quicker than the old one did.",play:"The east searchlight sweeps a quarter faster."},
 {id:"staffing",title:"the staffing cut",text:"Night staffing was cut after the {year} budget. Cell searches come around less often.",play:"Searches are half again as far apart."},
 {id:"workshop",title:"the workshop fire",text:"The workshop was rebuilt after a fire in {year}; its tool accounting is new and strict.",play:"The salvage rack refills in 60 minutes instead of 45."},
 {id:"laundry",title:"the condemned annex",text:"Half the laundry annex is condemned, so carts turn around faster than the rota says.",play:"The cloth rack refills in 30 minutes instead of 45."}
];
function historyForSeed(seed){
 let h=hashSeed(String(seed).slice(0,48)+":history:v1"),built=2031+(h%19),expanded=built+4+((h>>>5)%11),year=expanded+1+((h>>>9)%7),first=(h>>>13)%HISTORY_EVENTS.length,second=(first+1+((h>>>17)%(HISTORY_EVENTS.length-1)))%HISTORY_EVENTS.length;
 return {version:1,built:built,expanded:expanded,year:year,events:[HISTORY_EVENTS[first].id,HISTORY_EVENTS[second].id]};
}
function historyHas(id){let h=omGame&&omGame.history;return !!(h&&h.events&&h.events.indexOf(id)>=0);}
function historyFactor(id){if(!historyHas(id))return 1;return id==="tunnels"?1.2:id==="fence"?0.75:id==="staffing"?1.5:1;}
function refillMinutes(siteId){if(siteId==="workbench"&&historyHas("workshop"))return 60;if(siteId==="laundryBench"&&historyHas("laundry"))return 30;return 45;}
function historyLines(h){if(!h)return [];let now=2060+((h.year*7)%9);return h.events.map(function(id){let e=HISTORY_EVENTS.find(function(x){return x.id===id;});return e?e.text.replace("{year}",String(h.year)).replace("{ago}",String(Math.max(2,now-h.year))):"";});}
function historyText(h){if(!h)return "";return "Built "+h.built+", expanded "+h.expanded+". "+historyLines(h).join(" ");}
function historyPlayText(h){if(!h)return "";return h.events.map(function(id){let e=HISTORY_EVENTS.find(function(x){return x.id===id;});return e?e.play:"";}).join(" ");}
function intakeHistory(){return prisonMode==="procedural"?historyText(historyForSeed(seedText)):"";}
