const INCIDENTS = [
 {id:"visitor",title:"A visiting delegation",body:"An inspection delegation is touring the public corridors. Searches are suspended for the day and every officer is on best behaviour.",effect:"visitor"},
 {id:"shortage",title:"Kitchen shortage",body:"The delivery was short. Meals are thin today and the kitchen rack is bare until the evening.",effect:"shortage"},
 {id:"camera",title:"Camera fault in the workrooms",body:"The workshop camera is down for repair for the next three hours. Maintenance has been notified, in writing, twice.",effect:"camera"},
 {id:"wellness",title:"Mandatory optimism",body:"The PA reminds everyone that an improved attitude is not an approved substitute for an improved uniform.",effect:"calm"},
 {id:"inspection",title:"An unexpected inspection",body:"A compliance team is checking the public corridors. Keep restricted work out of sight.",effect:"watch"},
 {id:"tea",title:"A rare supply success",body:"The canteen's tea is almost recognisable today. An extra ration finds its way to your cell stash.",effect:"tea"},
 {id:"fault",title:"Maintenance advisory",body:"A main-circuit fault has darkened the workrooms. Backup security is still running.",effect:"fault"},
 {id:"swap",title:"A different pair of boots",body:"Two officers reverse their patrols. Old observations are still useful, but not a guarantee.",effect:"swap"},
 {id:"yard",title:"A matter of volleyball",body:"Kesh disputes whether the fence counts as out of bounds. Nearby staff go to restore the concept of rules.",effect:"distraction"},
 {id:"count",title:"The form for the other form",body:"Silas requests a form to explain a shortage of forms. Administration has opened an investigation into stationery.",effect:"paper"},
 {id:"review",title:"Quarterly review",body:"An investigator is reviewing access records. A clean routine will help more than a convincing smile.",effect:"investigation"},
 {id:"rain",title:"Weather advisory",body:"A rain front rolls in over Greywall. Outdoor sight lines shorten; nobody issues a raincoat.",effect:"rain"},
 {id:"quiet",title:"A brief, unofficial kindness",body:"Someone has repaired the association room's kettle. The institution declines to take credit until a form is completed.",effect:"calm"}
];
// Cameras are also physical, inspectable fixtures, not just HUD decoration.
const CAMERA_APPROACHES = [[39,32],[50,54],[79,53],[79,61],[77,81],[79,40]];
for(let i=0;i<CAMERAS.length;i++){
  let c=CAMERAS[i],a=CAMERA_APPROACHES[i];
  INTEL[c.id]={title:c.name,body:"Sweep cycle: "+c.period+" simulation seconds. "+(c.backup?"Emergency circuit: remains on during a main-power fault.":"Main circuit: goes dark during an outage.")+" Opaque walls block both sight and the overlay."};
  SITES.push({id:c.id,name:c.name,kind:c.id==="lightEast"?"searchlight":"camera",x:Math.floor(c.x),y:Math.floor(c.y),w:1,h:1,ax:a[0],ay:a[1],zone:"grounds",verbs:["observe"],intel:c.id,description:INTEL[c.id].body});
}
