 .uw-commandbar { padding:4px 8px; }
 .uw-welcome { display:block; overflow-y:auto; max-height:100%; }
 .uw-welcome-art { width:100%; height:130px; min-height:130px; }
 .uw-welcome-form { padding:14px 18px 18px; min-width:0; justify-content:flex-start; }
 .uw-welcome-headline { font-size:24px; }
 .uw-welcome-copy p,.uw-logo { display:none; }
}
@media(prefers-reduced-motion:reduce) { .uw-root * { transition:none !important; } }
/* Matching rails for the command, map overlay and tool-category strips. */
.uw-commandbar,.uw-overlay-strip,.uw-toolbox .uw-categories {
 scrollbar-width:thin;
 scrollbar-color:#68a9cb #15394f;
 overscroll-behavior-x:contain;
 scroll-padding-inline:8px;
}
.uw-commandbar::-webkit-scrollbar,.uw-overlay-strip::-webkit-scrollbar,.uw-toolbox .uw-categories::-webkit-scrollbar { height:7px; }
.uw-commandbar::-webkit-scrollbar-track,.uw-overlay-strip::-webkit-scrollbar-track,.uw-toolbox .uw-categories::-webkit-scrollbar-track { background:#15394f; border-radius:8px; margin-inline:8px; }
.uw-commandbar::-webkit-scrollbar-thumb,.uw-overlay-strip::-webkit-scrollbar-thumb,.uw-toolbox .uw-categories::-webkit-scrollbar-thumb { background:#68a9cb; border-radius:8px; border:1px solid #15394f; }
.uw-commandbar::-webkit-scrollbar-thumb:hover,.uw-overlay-strip::-webkit-scrollbar-thumb:hover,.uw-toolbox .uw-categories::-webkit-scrollbar-thumb:hover { background:#f5cb62; }
@supports selector(::-webkit-scrollbar) {
 .uw-commandbar,.uw-overlay-strip,.uw-toolbox .uw-categories { scrollbar-width:auto; scrollbar-color:auto; }
}
@media(max-width:980px) {
 .uw-commandbar,.uw-overlay-strip,.uw-toolbox .uw-categories { padding-bottom:7px; }
}
@media(forced-colors:active) {
 .uw-commandbar,.uw-overlay-strip,.uw-toolbox .uw-categories { scrollbar-color:auto; }
}
