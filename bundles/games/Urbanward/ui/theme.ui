 .uw-commandbar { flex-wrap:wrap; overflow-x:visible; flex:none; padding:5px 8px; gap:4px; }
 .uw-commandbar .uw-city-name,.uw-commandbar .uw-spacer { display:none; }
 .uw-root .uw-commandbar button { min-height:36px; min-width:36px; padding:5px 9px; font-size:11px; }
 .uw-commandbar button:last-child { display:none; }
