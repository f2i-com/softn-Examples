 .uw-root input,.uw-root textarea,.uw-root select { font-size:16px; }
 .uw-ticker { display:none; }
 .uw-view-controls { max-width:200px; gap:4px; }
 .uw-root .uw-view-controls button { width:40px; height:40px; min-width:40px; min-height:40px; }
 .uw-view-controls button:nth-child(n+5):nth-child(-n+8) { display:none; }
 .uw-map-badge { max-width:130px; }
 .uw-map-help { display:none; }
