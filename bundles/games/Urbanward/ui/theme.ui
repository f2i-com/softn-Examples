/* Illustrated tool palette: shared icon geometry, clear labels and prices. */
.uw-tool-glyph { width:34px; height:34px; flex:none; }
.uw-category-glyph { width:28px; height:28px; flex:none; }
.uw-action-glyph { width:23px; height:23px; flex:none; }
.uw-tool-top button { display:flex; align-items:center; justify-content:center; gap:6px; }
.uw-tool-copy { flex:1; min-width:0; }
.uw-root .uw-tool-card { gap:8px; padding:9px 8px; min-height:66px; border-radius:10px; }
.uw-tool-card-title { line-height:1.3; }
.uw-tool-card-price { font-size:11px; color:#f5d785; }
.uw-tool-card.uw-active .uw-tool-card-price { color:#153a53; }
.uw-tool-card.uw-active { box-shadow:inset 3px 0 #ffd353; }
.uw-root .uw-category-tab { align-items:center; justify-content:center; }
.uw-root .uw-category-tab.uw-active { box-shadow:inset 0 -3px #ffd353; }
.uw-root button:focus-visible { outline:3px solid #ffd353; outline-offset:-3px; }
@media(min-width:981px) { .uw-toolbox { width:250px; flex-shrink:0; } .uw-tool-card-title { font-size:12px; } }
@media(max-width:980px) {
 .uw-toolbox { width:min(420px,100%); }
 .uw-toolbox .uw-category-tab { flex-direction:row; min-width:104px; gap:6px; }
 .uw-category-glyph { width:24px; height:24px; }
 .uw-toolbox .uw-tool-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:6px; align-content:start; padding:6px; }
 .uw-root .uw-tool-card { display:grid; grid-template-columns:32px minmax(0,1fr); align-items:center; gap:5px 7px; margin:0; min-height:84px; }
 .uw-tool-glyph { width:32px; height:32px; grid-row:1 / 3; }
 .uw-tool-copy { align-self:end; }
 .uw-tool-card-title { font-size:11px; }
 .uw-tool-card-price { grid-column:2; align-self:start; font-size:12px; }
 .uw-tool-card-cost { display:none; }
 .uw-toolbox .uw-tool-footer { padding:7px 10px; }
 .uw-toolbox .uw-brush-row { margin-top:4px; }
