 .uw-toolbox .uw-categories { display:flex; flex-shrink:0; overflow-x:auto; padding:4px; gap:4px; }
 .uw-toolbox .uw-category-tab { min-width:78px; flex-shrink:0; }
 .uw-toolbox .uw-category-icon,.uw-toolbox .uw-tool-description { display:none; }
 .uw-toolbox .uw-tool-top,.uw-toolbox .uw-tool-footer { flex-shrink:0; }
 .uw-root .uw-tool-card { min-height:54px; flex-direction:row; align-items:center; }
