}
function uwStreetCrossings(i, links) {
    let t = uwWorld.tiles[i], out = [];
    if (t.wet || t.flood || links.count < 3) return out;
    let p = uwXZ(i), civic = false;
    for (let dz = -2; dz <= 2; dz++)
        for (let dx = -2; dx <= 2; dx++) {
            if (Math.abs(dx) + Math.abs(dz) > 2) continue;
            let j = uwIndex(p.x+dx,p.z+dz);
            if (j >= 0 && ["school","university","park","plaza","stop","hall"].indexOf(uwWorld.tiles[j].build) >= 0) civic = true;
        }
    if (t.road !== 2 && !civic) return out;
    let vertical = 0, horizontal = 0;
    if (links.north >= 0) vertical += uwWorld.tiles[links.north].road;
    if (links.south >= 0) vertical += uwWorld.tiles[links.south].road;
    if (links.east >= 0) horizontal += uwWorld.tiles[links.east].road;
    if (links.west >= 0) horizontal += uwWorld.tiles[links.west].road;
