            uwBox(x + (alongZ ? lanes[k] : 0), yy + 0.065, z + (alongX ? lanes[k] : 0), alongX ? 0.62 : 0.025, 0.012, alongX ? 0.025 : 0.62, "#bbbca5", "roadmark", false);
    }
