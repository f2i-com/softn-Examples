            let clear = ends[0] >= 0 && ends[1] >= 0 && uwStreetLinks(ends[0]).count === 2 && uwStreetLinks(ends[1]).count === 2;
            if (clear && t.road === 2 && (p.x + p.z) % 3 === 0) {
                uwBox(x, yy + 0.085, z, alongX ? 1.12 : 0.18, 0.07, alongX ? 0.18 : 1.12, "#b3b8a2", "medianrim", false);
                uwBox(x, yy + 0.13, z, alongX ? 0.95 : 0.12, 0.045, alongX ? 0.12 : 0.95, "#81b844", "medianplanting", false);
            }
            for (let k = 0; k < nn.length; k++) {
