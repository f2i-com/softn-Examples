    uwSpecialMeshes.push({ id: "uw-water", type: "box", position: { x: 0, y: -0.22, z: 0 }, width: n * 2 + 2, height: 0.13, depth: n * 2 + 2, color: lightMode === "night" ? "#245570" : "#259cc1", metalness: 0.38, roughness: 0.24, receiveShadow: true });
    for (let i = 0; i < uwWorld.tiles.length; i = i + 1) {
        let t = uwWorld.tiles[i], p = uwWorldPosition(i), y = uwGround(i), x = p.x, z = p.z;
        if (t.wet && !t.road && quality !== "low") {
            let banks = uwNeighbours(i);
            for (let k = 0; k < banks.length; k++) {
                if (uwWorld.tiles[banks[k]].wet) continue;
                let bank = uwWorldPosition(banks[k]), dx = (bank.x-x)/2, dz = (bank.z-z)/2;
                uwBox(x+dx*0.8, -0.15, z+dz*0.8, dx ? 0.4 : 2, 0.025, dx ? 2 : 0.4, lightMode === "night" ? "#356778" : "#66ced0", "shallows", false);
                if (t.variant % 3 === 0) {
                    uwPart("dodecahedron", x+dx*0.75, -0.03, z+dz*0.75, 0.55, 0.55, 0.55, "#b0b3a2", "coastrock", false);
                    uwPart("dodecahedron", x+dx*0.72+dz*0.32, -0.08, z+dz*0.72+dx*0.32, 0.35, 0.35, 0.35, "#a0a797", "coastpebble", false);
                }
            }
        }
        if (!t.wet) {
            let base = greens[t.variant % greens.length], nearWater = false, nn = uwNeighbours(i);
            for (let k = 0; k < nn.length; k = k + 1)
                if (uwWorld.tiles[nn[k]].wet)
                    nearWater = true;
            if (nearWater)
                base = "#ead69b";
            if (t.h >= 3)
                base = t.h >= 4 ? "#a7a596" : "#a3ab8e";
            uwBox(x, (y - 0.9) / 2, z, 2, y + 0.9, 2, uwOverlayColour(i, base), "ground", false);
            if (nearWater && quality !== "low") {
                for (let k = 0; k < nn.length; k++) {
                    if (!uwWorld.tiles[nn[k]].wet) continue;
                    let edge = uwWorldPosition(nn[k]), dx = (edge.x - x) / 2, dz = (edge.z - z) / 2;
                    if (t.road || t.build)
                        uwBox(x + dx * 0.94, y - 0.13, z + dz * 0.94, dx ? 0.12 : 2, 0.42, dx ? 2 : 0.12, "#a8b4a7", "quaywall", false);
                    else if (!t.zone && i % 3 === 0) {
                        uwBox(x + dx * 0.8, y + 0.15, z + dz * 0.8, 0.05, 0.3, 0.05, "#7a9059", "reed", false);
                        uwBox(x + dx * 0.8 + 0.13, y + 0.21, z + dz * 0.8 + 0.1, 0.04, 0.42, 0.04, "#91a564", "reed", false);
                    }
                }
