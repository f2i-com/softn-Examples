                if (lot.build === "stop") {
                    let stop = uwWorldPosition(nn[k]), dx = (stop.x-x)/2, dz = (stop.z-z)/2;
                    uwBox(x+dx*0.78,yy+0.07,z+dz*0.78,dx?0.055:0.9,0.014,dx?0.9:0.055,"#81bcc0","buscurb",false);
                }
            }
