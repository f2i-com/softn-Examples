            for (let a = -1; a <= 1; a++)
                uwBox(x + (acrossX ? a * 0.34 : sign * 0.66), yy + 0.069, z + (acrossX ? sign * 0.66 : a * 0.34), acrossX ? 0.14 : 0.22, 0.012, acrossX ? 0.22 : 0.14, "#cbd0bc", "crosswalk", false);
