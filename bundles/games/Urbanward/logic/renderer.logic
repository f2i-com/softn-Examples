        else if (t.build)
            uwFacility(x, y, z, t.build, uwNet.power[i] > 0.6);
        else if (t.zone && (t.level || t.stage)) {
            uwBox(x, y + 0.015, z, 1.92, 0.03, 1.92, t.zone === 3 ? "#aaa58e" : "#c7cead", "lot", false);
            if (t.stage)
                uwConstruction(x, y, z, t);
            else if (t.zone === 3)
                uwFactory(x, y, z, t, uwNet.power[i] > 0.6);
            else if (t.zone === 1 && t.level <= 2)
                uwHouse(x, y, z, t, uwNet.power[i] > 0.6);
            else
                uwUrbanBlock(x, y, z, t, uwNet.power[i] > 0.6);
            uwLotCondition(i, x, y, z, t);
        }
        else {
            if (t.zone && !t.wet) {
                uwBox(x, y + 0.017, z, 1.82, 0.028, 1.82, ["#9ab386", "#84b59a", "#8ab6c1", "#c6b576", "#ada5bd"][t.zone], "zonepad", false);
                if (quality !== "low") {
                    if (t.age > 0 && t.neglect > 0) {
                        uwBox(x, y + 0.07, z, 1.35, 0.14, 1.2, "#8b8d7d", "ruinfoundation", false);
                        uwBox(x - 0.45, y + 0.18, z - 0.35, 0.24, 0.36, 0.55, "#a29985", "ruinwall", false);
                    }
                    uwBox(x - 0.84, y + 0.1, z - 0.84, 0.055, 0.2, 0.055, "#ddd5b9", "zonestake", false);
                    uwBox(x + 0.84, y + 0.1, z + 0.84, 0.055, 0.2, 0.055, "#ddd5b9", "zonestake", false);
                }
            }
            if (t.tree && !t.wet && (quality !== "low" || i % 2 === 0))
                uwTree(x + (t.variant % 3 - 1) * 0.24, y, z + (t.variant % 2 - 0.5) * 0.38, t.variant);
        }
        if (t.wire && !t.road) {
            uwBox(x, y + 1.12, z, 0.08, 2.2, 0.08, "#7d8072", "powerpole", false);
            uwBox(x, y + 2.12, z, 0.8, 0.07, 0.07, "#7d8072", "powerarm", false);
        }
        if (t.pipe && activeOverlay === "water")
            uwBox(x, y + 0.07, z, 1.9, 0.1, 0.12, "#7bd3dd", "watermain", false);
        if (t.fire > 0) {
            if (uwIncidents.length < 8) uwIncidents.push(i);
            uwPart("cone", x, y + 1.1, z, 0.7, 1.9, 0.7, "#e7a252", "flame", true);
            uwPart("cone", x + 0.35, y + 0.8, z + 0.25, 0.45, 1.2, 0.45, "#d8754d", "flame", true);
        }
    }
    let result = [], instances = 0;
    for (let k = 0; k < uwBatchOrder.length; k = k + 1) {
        let b = uwBatchMap[uwBatchOrder[k]].spec;
        result.push(b);
        instances += b.instances.length / 4;
    }
    for (let k = 0; k < uwSpecialMeshes.length; k = k + 1)
        result.push(uwSpecialMeshes[k]);
    staticObjects = result;
    uwRendererStats = { batches: result.length, instances: instances };
    uwStaticDirty = false;
    // Construction changes may invalidate vehicle routes. Re-seed only when needed.
    uwRefreshCars();
    uwRenderMotion();
    uwBatchMap = {};
    uwBatchOrder = [];
    uwSpecialMeshes = [];
    uwPerfEnd("Static draw lists", renderStart);
}
function uwSetOverlay(id) {
    activeOverlay = id;
    let legends = { none: "Natural colours. Inspect any lot for detailed information.", zones: "Green: homes · Blue: commerce · Gold: industry · Violet: mixed use.", power: "Red: disconnected / insufficient · Green: full electrical supply. Roads contain utility ducts.", water: "Red: disconnected / insufficient · Green: full water supply. Water facilities require power.", traffic: "Green: free-flowing · Gold: pressure · Red: overloaded. Traffic is aggregate commuting demand.", value: "Red: low amenity · Green: high land value. Services, parks and pollution shape this map.", pollution: "Red: high pollution · Green: cleaner air and effective waste service.", services: "Combined school, clinic and fire coverage. Catchments follow roads and congestion.", districts: "Sixteen neighbourhoods. Select a lot to inspect and rename its district." };
    overlayLegend = legends[id] || legends.none;
    uwStaticDirty = true;
    uwRenderStatic();
    uwRefreshUI();
}
function uwApplyLighting() {
    skyName = lightMode === "night" ? "night" : lightMode === "dusk" ? "dusk" : "day";
    envUrl = lightMode === "night" ? "assets/env/night-moon.hdr" : lightMode === "dusk" ? "assets/env/studio-dusk.hdr" : "assets/env/sunny-meadow.hdr";
    exposure = lightMode === "night" ? 1.25 : 1.06;
    lights = [
        { id: "ambient", type: "ambient", color: lightMode === "night" ? "#9fb5d6" : "#fff2d5", intensity: lightMode === "night" ? 0.55 : 0.9 },
        { id: "skyfill", type: "hemisphere", color: lightMode === "night" ? "#a8c1e1" : "#c6e7ff", groundColor: "#668849", intensity: lightMode === "night" ? 0.35 : 0.6 },
        { id: "sun", type: "directional", color: lightMode === "dusk" ? "#f5c29d" : lightMode === "night" ? "#90a9d0" : "#fff5df", intensity: lightMode === "night" ? 0.45 : 2.1, position: { x: -40, y: 85, z: 40 }, castShadow: quality !== "low", follow: "view", shadowCameraSize: 30, shadowMapSize: quality === "high" ? 2048 : 1024, shadowFar: 260, shadowBias: -0.0008 }
    ];
    uwStaticDirty = true;
}
function uwCycleLight() { lightMode = lightMode === "day" ? "dusk" : lightMode === "dusk" ? "night" : "day"; uwApplyLighting(); uwRenderStatic(); }
function uwChangeQuality() { quality = quality === "low" ? "balanced" : quality === "balanced" ? "high" : "low"; uwApplyLighting(); uwStaticDirty = true; uwRenderStatic(); uwRefreshUI(); }
function uwUpdateCamera() {
    if (!uwWorld)
        return;
    let angle = Math.PI / 4 + viewAngle * Math.PI / 2, radius = uwWorld.n * 2.65 * uwZoom;
    camera = { position: { x: uwCamX + Math.cos(angle) * radius, y: radius * 0.78, z: uwCamZ + Math.sin(angle) * radius }, lookAt: { x: uwCamX, y: 0, z: uwCamZ }, fov: 32 };
}
function uwPan(dx, dz) { if (!uwWorld)
    return; let angle = viewAngle * Math.PI / 2; uwCamX = uwClamp(uwCamX + dx * Math.cos(angle) - dz * Math.sin(angle), -uwWorld.n, uwWorld.n); uwCamZ = uwClamp(uwCamZ + dx * Math.sin(angle) + dz * Math.cos(angle), -uwWorld.n, uwWorld.n); uwUpdateCamera(); }
function uwZoomBy(factor) { uwZoom = uwClamp(uwZoom * factor, 0.25, 1.7); uwUpdateCamera(); }
function uwRotate(amount) { viewAngle = (viewAngle + amount + 4) % 4; uwUpdateCamera(); }
function uwResetCamera() { if (!uwWorld)
    return; uwCamX = -uwWorld.n * 0.14; uwCamZ = 0; uwZoom = 1; viewAngle = 0; uwUpdateCamera(); }
