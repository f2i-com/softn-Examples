    if (t.neglect >= 4) {
        let front = t.zone === 1 && t.level <= 2 ? 0.69 : t.zone === 3 ? 0.8 : t.level === 4 ? 0.66 : 0.79;
        for (let side = -1; side <= 1; side += 2) {
            uwBox(x + side * 0.34, y + 0.38, z + front, 0.3, 0.23, 0.055, "#927b60", "boardedwindow", false);
            uwBox(x + side * 0.34, y + 0.39, z + front + 0.035, 0.32, 0.045, 0.025, "#b59c75", "boardbrace", false);
        }
        uwBox(x + 0.6, y + 0.1, z + 0.87, 0.25, 0.18, 0.16, "#74756a", "litter", false);
    }
    else if (uwNet.value[i] >= 65 && t.zone !== 3) {
        uwPlanter(x - 0.52, y, z - 0.86, t.variant, true);
        uwPlanter(x + 0.52, y, z - 0.86, t.variant + 1, true);
    }
    if (uwNet.pollution[i] > 45)
        uwBox(x - 0.87, y + 0.021, z, 0.16, 0.012, 1.5, "#8d9274", "pollutionstain", false);
}
function uwOverlayColour(i, base) {
    let t = uwWorld.tiles[i], value = 0;
    if (activeOverlay === "none")
        return base;
    if (activeOverlay === "zones")
        return [base, "#80b98d", "#6fabc2", "#c5ad65", "#a49bc1"][t.zone];
    if (activeOverlay === "districts")
        return ["#9eae88", "#76a4a8", "#c1aa83", "#939fb5", "#b498a9", "#80b196", "#ae9a7b", "#83a9bd"][uwDistrictOf(i) % 8];
    if (activeOverlay === "power")
        value = uwNet.power[i] * 100;
    else if (activeOverlay === "water")
        value = uwNet.water[i] * 100;
    else if (activeOverlay === "value")
        value = uwNet.value[i];
    else if (activeOverlay === "pollution")
        value = 100 - uwNet.pollution[i];
    else if (activeOverlay === "traffic")
        value = t.road ? 100 - Math.min(100, uwNet.traffic[i] / 1.5) : 60;
    else if (activeOverlay === "services")
        value = (uwNet.service.school[i] + uwNet.service.health[i] + uwNet.service.fire[i]) / 3;
    return value < 20 ? "#b56f64" : value < 40 ? "#c1986c" : value < 60 ? "#c4bc79" : value < 80 ? "#9bb686" : "#70aa96";
}
function uwStreetLinks(i) {
    let nn = uwNeighbours(i), me = uwXZ(i), links = { north:-1, south:-1, east:-1, west:-1, count:0 };
    for (let k = 0; k < nn.length; k = k + 1)
        if (uwRoadPassable(i, nn[k])) {
            let p = uwXZ(nn[k]);
            if (p.x > me.x) links.east = nn[k];
            if (p.x < me.x) links.west = nn[k];
