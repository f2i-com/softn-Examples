let uwSmokeSources = [];
let uwWalkSegments = [];
let uwIncidents = [];
function uwArchitecture(t) {
    return Math.min(2, Math.floor(Math.max(0, uwWorld.month - t.age) / 120));
}
function uwLotCondition(i, x, y, z, t) {
