function uwFacility(x, y, z, type, powered) {
    let f = UW_FACILITIES[type], color = f.color;
    uwBox(x, y + 0.025, z, 1.82, 0.05, 1.82, type === "park" ? "#8bbe59" : "#b9b7a5", "civic-pad", false);
    if (type === "park" || type === "plaza") {
        uwPart("cylinder", x, y + 0.17, z, 0.95, 0.24, 0.95, "#d4cfb8", "fountain", false);
        uwPart("cylinder", x, y + 0.3, z, 0.79, 0.04, 0.79, "#39bed9", "fountainwater", powered);
        uwPart("cone", x, y + 0.56, z, 0.16, 0.55, 0.16, "#9dddd9", "fountainjet", false);
        uwTree(x - 0.64, y, z - 0.6, 2);
        uwTree(x + 0.64, y, z + 0.6, 1);
        uwBench(x + 0.57, y, z - 0.5);
        if (quality !== "low") {
            uwBox(x, y + 0.033, z, 0.28, 0.016, 1.8, "#ded5b9", "parkpath", false);
            uwBench(x - 0.57, y, z + 0.5);
            uwPlanter(x - 0.57, y, z + 0.82, 0, true);
            uwPlanter(x + 0.57, y, z - 0.82, 2, true);
        }
        return;
    }
    if (type === "tower") {
        for (let a = -1; a <= 1; a += 2)
            for (let b = -1; b <= 1; b += 2)
                uwBox(x + a * 0.39, y + 0.85, z + b * 0.39, 0.09, 1.7, 0.09, "#6e7d84", "watertowerleg", false);
        uwPart("cylinder", x, y + 1.93, z, 1.35, 0.7, 1.35, color, "watertank", false);
        uwPart("cone", x, y + 2.4, z, 1.43, 0.28, 1.43, "#c7dfe3", "watertankroof", false);
        uwPart("cylinder", x, y + 1.95, z, 1.37, 0.15, 1.37, "#e8e4d3", "tankstripe", false);
        return;
    }
    if (type === "wind") {
        uwSpecialMeshes.push({ id: "wind-tower-" + x + "-" + z, type: "model", modelUrl: "assets/models/wind-tower.glb", position: { x: x, y: y, z: z }, castShadow: quality !== "low", receiveShadow: true });
        uwSpecialMeshes.push({ id: "wind-" + x + "-" + z, type: "model", modelUrl: "assets/models/wind-rotor.glb", position: { x: x, y: y + 3.52, z: z + 0.19 }, animate: { rotateZ: 0.035 }, castShadow: quality !== "low" });
        return;
    }
    if (type === "solar") {
        for (let a = -1; a <= 1; a += 2) {
            uwBox(x, y + 0.34, z + a * 0.39, 1.55, 0.09, 0.57, "#316b92", "solar", false);
            uwBox(x, y + 0.16, z + a * 0.39, 0.1, 0.3, 0.1, "#b3c2c4", "solarstand", false);
        }
        return;
    }
    if (type === "lighthouse" || type === "monument") {
        uwSpecialMeshes.push({ id: type + "-" + x + "-" + z, type: "model", modelUrl: type === "lighthouse" ? "assets/models/lighthouse.glb" : "assets/models/monument.glb", position: { x: x, y: y, z: z }, castShadow: quality !== "low", receiveShadow: true });
        return;
    }
    if (type === "stop") {
        uwBox(x, y + 0.88, z, 1.3, 0.075, 0.68, "#267eaa", "shelterroof", false);
        uwBox(x, y + 0.45, z - 0.28, 1.18, 0.78, 0.04, "#91bbc0", "shelterglass", false);
        for (let side = -1; side <= 1; side += 2)
            uwBox(x + side * 0.58, y + 0.45, z - 0.25, 0.055, 0.86, 0.055, "#566f73", "shelterframe", false);
        if (quality !== "low") {
            uwBox(x, y + 0.28, z - 0.05, 0.85, 0.065, 0.24, "#b4a182", "busbench", false);
            uwBox(x, y + 0.16, z - 0.05, 0.09, 0.25, 0.15, "#566f73", "busbenchleg", false);
            uwBox(x - 0.34, y + 0.6, z - 0.248, 0.24, 0.28, 0.025, "#e5dfc9", "timetable", false);
            uwBox(x - 0.34, y + 0.67, z - 0.23, 0.19, 0.035, 0.012, "#4d929b", "timetableheader", false);
            uwBox(x, y + 0.825, z + 0.24, 0.85, 0.025, 0.04, "#e6d7aa", "shelterlight", powered);
        }
        uwBox(x + 0.68, y + 0.65, z + 0.25, 0.06, 1.3, 0.06, "#667986", "buspole", false);
        uwBox(x + 0.68, y + 1.2, z + 0.25, 0.33, 0.3, 0.08, "#ffd353", "bussign", false);
        return;
    }
    if (type === "pump") {
        uwPart("cylinder", x - 0.42, y + 0.33, z, 0.72, 0.55, 0.72, "#b9c8bd", "watertreatment", false);
        uwPart("cylinder", x + 0.42, y + 0.33, z, 0.72, 0.55, 0.72, "#a9c6bc", "watertreatment", false);
        uwPart("cylinder", x - 0.42, y + 0.62, z, 0.62, 0.025, 0.62, "#6baec2", "treatmentwater", false);
        uwBox(x, y + 0.42, z - 0.62, 1.25, 0.8, 0.35, "#92b0af", "utilityoffice", false);
        return;
    }
    if (type === "hall") {
        uwSpecialMeshes.push({ id: "hall-" + x + "-" + z, type: "model", modelUrl: "assets/models/city-hall.glb", position: { x: x, y: y, z: z }, castShadow: quality !== "low", receiveShadow: true });
        return;
    }
    let h = type === "university" ? 1.55 : 0.95;
    uwBox(x, y + h / 2, z, 1.62, h, 1.38, color, "facility", false);
    uwBox(x, y + h + 0.06, z, 1.76, 0.14, 1.5, "#627c80", "publicroof", false);
    uwWindows(x, y, z, 1.62, h, 1.38, 2, powered);
    if (type === "power") {
        for (let a = -1; a <= 1; a += 2) {
            uwPart("cylinder", x + a * 0.48, y + 1.7, z - 0.43, 0.26, 3.4, 0.26, "#b97058", "powerstack", false);
            uwPart("cylinder", x + a * 0.48, y + 2.8, z - 0.43, 0.27, 0.25, 0.27, "#decda8", "powerband", false);
            if (!uwWorld.policies.clean)
                uwSmokeSources.push({ x: x + a * 0.48, y: y + 3.4, z: z - 0.43 });
        }
    }
    if (type === "clinic") {
        uwBox(x, y + h + 0.2, z, 0.67, 0.06, 0.2, "#bb685f", "cross", false);
        uwBox(x, y + h + 0.2, z, 0.2, 0.06, 0.67, "#bb685f", "cross", false);
    }
    if (type === "fire" || type === "depot")
        for (let a = -1; a <= 1; a += 2)
            uwBox(x + a * 0.4, y + 0.33, z + 0.71, 0.5, 0.6, 0.04, type === "fire" ? "#e6d7bc" : "#6b7c7d", "garagedoor", false);
    if (type === "police") {
        uwBox(x, y + h + 0.4, z, 0.045, 0.7, 0.045, "#d0d9d6", "antenna", false);
        uwBox(x, y + 0.65, z + 0.75, 0.4, 0.18, 0.05, "#d4ba76", "badge", false);
    }
    if (type === "school" || type === "university") {
        uwBox(x + 0.73, y + 1.2, z + 0.7, 0.04, 2.4, 0.04, "#d2d9d0", "flagpole", false);
        uwBox(x + 0.5, y + 2.23, z + 0.7, 0.47, 0.27, 0.035, "#65a6b4", "flag", false);
    }
    if (type === "university")
        uwPart("cone", x, y + h + 0.65, z, 1.1, 1.08, 1.1, "#8aafa6", "campusdome", false);
    if (type === "recycler")
        for (let a = -1; a <= 1; a += 2)
            uwBox(x + a * 0.55, y + 0.17, z + 0.86, 0.3, 0.34, 0.24, "#5c8e77", "bin", false);
}
