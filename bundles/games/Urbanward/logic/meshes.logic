    }
}
function uwFactory(x, y, z, t, powered) {
    let h = 0.7 + t.level * 0.28;
    uwBox(x, y + h / 2, z, 1.65, h, 1.5, ["#9caba9", "#ac9b87", "#9c9c94", "#8a9ba2"][t.variant % 4], "warehouse", false);
    uwPart("prism", x - 0.4, y + h + 0.12, z, 0.8, 0.32, 1.65, "#637b83", "shedroof", false);
    uwPart("prism", x + 0.4, y + h + 0.12, z, 0.8, 0.32, 1.65, "#637b83", "shedroof", false);
    uwBox(x, y + 0.34, z + 0.76, 0.65, 0.62, 0.045, "#59676b", "loadingbay", false);
    if (t.variant % 3 !== 0) {
        let chimney = 1.9 + t.level * 0.3;
        uwPart("cylinder", x + 0.62, y + chimney / 2, z - 0.53, 0.22, chimney, 0.22, "#b47b66", "stack", false);
        uwPart("cylinder", x + 0.62, y + chimney - 0.32, z - 0.53, 0.23, 0.16, 0.23, "#e4d9bc", "stackband", false);
        if (powered)
            uwSmokeSources.push({ x: x + 0.62, y: y + chimney, z: z - 0.53 });
    }
    if (t.level >= 2)
        uwBox(x - 0.52, y + h + 0.36, z + 0.15, 0.5, 0.5, 0.58, "#9ebabe", "tank", false);
    if (quality !== "low") {
        uwBox(x - 0.63, y + 0.04, z + 0.86, 0.36, 0.08, 0.2, "#8f795b", "pallet", false);
        uwBox(x - 0.63, y + 0.19, z + 0.86, 0.28, 0.22, 0.18, "#bcaa7e", "cargo", false);
        for (let stripe = -1; stripe <= 1; stripe++)
