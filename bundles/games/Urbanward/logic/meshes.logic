        if (level >= 3 && t.variant % 2 === 1) {
            uwPlanter(x - 0.4, y + h + 0.08, z + 0.45, t.variant, t.neglect < 4);
            uwPlanter(x + 0.4, y + h + 0.08, z + 0.45, t.variant + 1, t.neglect < 4);
        }
    }
    if (level >= 3) {
        uwBox(x, y + h + 0.26, z, width * 0.58, 0.5, depth * 0.58, base, "setback", false);
        uwBox(x, y + h + 0.52, z, width * 0.66, 0.07, depth * 0.66, "#dde1d8", "cornice", false);
        if (t.variant % 3 === 0)
            uwPart("cylinder", x - 0.25, y + h + 0.83, z + 0.2, 0.38, 0.4, 0.38, "#95887b", "roof-tank", false);
    }
    if (level === 4) {
        uwBox(x, y + h + 1.2, z, 0.055, 1.4, 0.055, "#ccd7d7", "antenna", false);
        uwBox(x, y + h + 1.9, z, 0.075, 0.075, 0.075, "#f4b47e", "beacon", powered);
        for (let side = -1; side <= 1; side += 2)
