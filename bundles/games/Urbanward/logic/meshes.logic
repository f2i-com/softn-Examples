// Original procedural city kit. Parts are grouped by geometry and material;
// per-instance palettes avoid a draw call for each facade or tree colour.
function uwBeginMeshes() { uwBatchMap = {}; uwBatchOrder = []; uwSpecialMeshes = []; }
function uwPart(shape, x, y, z, w, h, d, color, tag, glow) {
    let key = tag + "/" + shape + "/" + w + "/" + h + "/" + d + "/" + (glow ? "lit" : "matte"), batch = uwBatchMap[key];
    if (!batch) {
        let spec = { id: "uw-" + uwBatchOrder.length, type: "instanced", shape: shape, width: w, height: h, depth: d, radius: w / 2, instances: [], palette: [], flatShading: true, metalness: tag === "glass" ? 0.22 : 0, roughness: tag === "glass" ? 0.38 : 0.86, castShadow: tag !== "ground" && tag !== "road" && tag !== "window", receiveShadow: tag !== "window" && !glow };
        if (glow) {
            spec.emissive = "#ffda8a";
            spec.emissiveIntensity = lightMode === "night" ? 0.85 : lightMode === "dusk" ? 0.3 : 0;
        }
        batch = { spec: spec, colors: {} };
        uwBatchMap[key] = batch;
        uwBatchOrder.push(key);
    }
    let paletteIndex = batch.colors[color];
    if (paletteIndex === undefined) {
        paletteIndex = batch.spec.palette.length;
        batch.colors[color] = paletteIndex;
        batch.spec.palette.push(color);
    }
    batch.spec.instances.push(x, y, z, paletteIndex);
}
function uwBox(x, y, z, w, h, d, color, tag, glow) { uwPart("box", x, y, z, w, h, d, color, tag || "solid", !!glow); }
function uwTree(x, y, z, variant) {
    let colors = ["#32824d", "#62a938", "#a1ca43", "#22745a"];
    uwBox(x, y + 0.3, z, 0.12, 0.6, 0.12, "#715c44", "trunk", false);
    if (variant % 3 === 0) {
        uwPart("cone", x, y + 1.08, z, 1.05, 1.65, 1.05, colors[variant % 4], "tree", false);
        uwPart("cone", x, y + 1.6, z, 0.62, 0.9, 0.62, colors[(variant + 1) % 4], "tree", false);
    }
    else {
        uwPart("dodecahedron", x, y + 0.98, z, 1.2, 1.2, 1.2, colors[variant % 4], "tree", false);
        if (quality === "high") uwPart("dodecahedron", x + 0.27, y + 1.35, z - 0.13, 0.8, 0.8, 0.8, colors[(variant + 1) % 4], "treecrown", false);
    }
}
function uwWindows(x, y, z, w, h, d, levels, powered) {
    let glow = powered && lightMode !== "day", glass = powered ? lightMode === "day" ? "#b9e4ff" : "#ffdf94" : "#374b5a";
    if (quality === "low") {
        uwBox(x, y + h * 0.5, z + d / 2 + 0.018, w * 0.66, h * 0.55, 0.025, glass, "window", glow);
        return;
    }
    let rows = Math.min(12, Math.max(1, levels)), columns = w > 1.15 ? 3 : 2;
    for (let r = 0; r < rows; r = r + 1) {
        let yy = y + 0.23 + (h - 0.3) * (r + 0.35) / rows;
        for (let c = 0; c < columns; c = c + 1) {
            let lit = glow && Math.abs(Math.floor(x * 7 + z * 11) + r * 3 + c * 7) % 5 !== 0;
            let pane = glow && !lit ? "#46616c" : glass;
            let offset = ((c + 0.5) / columns - 0.5) * w * 0.78;
            uwBox(x + offset, yy, z + d / 2 + 0.014, 0.19, 0.17, 0.026, pane, "window", lit);
            uwBox(x + offset, yy, z - d / 2 - 0.014, 0.19, 0.17, 0.026, pane, "window", lit);
            if (quality === "high" || r % 2 === 0) {
                let offZ = ((c + 0.5) / columns - 0.5) * d * 0.78;
                uwBox(x + w / 2 + 0.014, yy, z + offZ, 0.026, 0.17, 0.19, pane, "window", lit);
                uwBox(x - w / 2 - 0.014, yy, z + offZ, 0.026, 0.17, 0.19, pane, "window", lit);
            }
        }
    }
}
function uwConstruction(x, y, z, t) {
    uwBox(x, y + 0.06, z, 1.65, 0.12, 1.65, "#bcb5a3", "foundation", false);
    let h = t.stage === 2 ? 0.65 : 1.3;
    for (let ax = -1; ax <= 1; ax += 2)
        for (let az = -1; az <= 1; az += 2)
            uwBox(x + ax * 0.63, y + h / 2, z + az * 0.63, 0.09, h, 0.09, "#ba985c", "scaffold", false);
    uwBox(x, y + h, z - 0.63, 1.35, 0.08, 0.08, "#d5b473", "scaffold", false);
    uwBox(x, y + h, z + 0.63, 1.35, 0.08, 0.08, "#d5b473", "scaffold", false);
    uwBox(x + 0.63, y + h, z, 0.08, 0.08, 1.35, "#d5b473", "scaffold", false);
    if (t.level >= 2) {
        uwBox(x - 0.65, y + 1.8, z - 0.65, 0.1, 3.6, 0.1, "#dbb350", "crane", false);
        uwBox(x - 0.12, y + 3.55, z - 0.65, 1.65, 0.09, 0.09, "#dbb350", "crane", false);
        uwBox(x + 0.58, y + 2.9, z - 0.65, 0.025, 1.2, 0.025, "#4c5459", "crane", false);
    }
}
function uwHouse(x, y, z, t, powered) {
    let walls = ["#fff0cb", "#efbc87", "#b4dcbf", "#f0d698", "#a4d4ee", "#edb29a", "#d6e9ef", "#fff2d7"], roofs = ["#cb7550", "#326f99", "#31877a", "#aa684b"];
    let h = t.level === 1 ? 0.7 : 1.4, w = t.variant % 2 ? 1.28 : 1.4, d = 1.3;
    uwBox(x, y + h / 2, z, w, h, d, t.neglect >= 4 ? "#827d70" : walls[t.variant], "house", false);
    let era = uwArchitecture(t);
    if (era < 2)
        uwPart("prism", x, y + h + 0.23, z, w + 0.16, 0.5, d + 0.22, roofs[t.variant % 4], "roof", false);
    else {
        uwBox(x, y + h + 0.06, z, w + 0.16, 0.12, d + 0.22, "#799485", "greenroof", false);
        uwBox(x + 0.32, y + h + 0.16, z - 0.2, 0.58, 0.04, 0.35, "#396880", "roofsolar", false);
    }
    uwBox(x + 0.36, y + h + 0.3, z - 0.25, 0.15, 0.6, 0.16, "#ac8671", "chimney", false);
    uwWindows(x, y, z, w, h, d, t.level, powered && t.neglect < 4);
    uwBox(x, y + 0.23, z + d / 2 + 0.02, 0.23, 0.46, 0.045, "#5d6d69", "door", false);
    uwBox(x, y + 0.015, z + 0.82, 0.28, 0.03, 0.32, "#cec8b5", "path", false);
    if (quality !== "low" && t.variant % 2 === 0)
        uwBox(x - 0.76, y + 0.14, z, 0.08, 0.28, 1.6, "#e5ddc6", "fence", false);
    if (quality !== "low") {
        uwPlanter(x + 0.52, y, z + 0.82, t.variant, t.neglect < 4);
        uwBox(x - 0.4, y + 0.12, z + 0.84, 0.035, 0.24, 0.035, "#657c7c", "mailpost", false);
        uwBox(x - 0.4, y + 0.27, z + 0.84, 0.16, 0.12, 0.12, roofs[t.variant % 4], "mailbox", false);
        if (t.variant % 3 === 1) {
            uwBox(x, y + h + 0.28, z + 0.23, 0.58, 0.04, 0.35, "#396880", "roofsolar", false);
        }
    }
}
// Shared small dimensions keep neighbourhood ornament in instanced batches.
function uwPlanter(x, y, z, variant, healthy) {
    uwBox(x, y + 0.065, z, 0.38, 0.13, 0.16, "#ad8166", "planter", false);
    uwBox(x, y + 0.15, z, 0.34, 0.08, 0.13, healthy ? "#65aa3e" : "#928368", "planterleaf", false);
    if (healthy) {
        let flowers = ["#ffc94f", "#ec8b75", "#b89ee6", "#fff2b7"];
        uwBox(x - 0.1, y + 0.21, z, 0.09, 0.06, 0.1, flowers[variant % 4], "flowers", false);
        uwBox(x + 0.1, y + 0.21, z, 0.09, 0.06, 0.1, flowers[(variant + 1) % 4], "flowers", false);
    }
}
function uwBench(x, y, z) {
    uwBox(x, y + 0.18, z, 0.48, 0.07, 0.18, "#a28a65", "benchseat", false);
    uwBox(x, y + 0.31, z - 0.08, 0.48, 0.19, 0.045, "#a28a65", "benchback", false);
    for (let side = -1; side <= 1; side += 2)
        uwBox(x + side * 0.17, y + 0.08, z, 0.045, 0.16, 0.14, "#526b6c", "benchleg", false);
}
function uwUrbanBlock(x, y, z, t, powered) {
    let level = t.level, commercial = t.zone === 2, mixed = t.zone === 4;
    let heights = [0, 0.85, 1.8, 3.8, 7.2], h = heights[level] + (level >= 3 ? (t.variant % 3 - 1) * (level === 4 ? 1.2 : 0.5) : 0), width = level === 4 ? 1.22 : 1.55, depth = level === 4 ? 1.24 : 1.5;
    let facades = commercial ? ["#297bbb", "#48a4d0", "#27649d", "#94cddd"] : ["#e6ba73", "#f4ddad", "#b3d9dd", "#e7aa85"];
    let era = uwArchitecture(t);
    let base = t.neglect >= 4 ? "#787f7b" : era === 0 ? facades[t.variant % 4] : era === 1 ? ["#d9c693", "#e3e8d7", "#4299be", "#a9d8ee"][t.variant % 4] : ["#d9efd7", "#33a9b3", "#7fceba", "#fae8b7"][t.variant % 4];
    uwBox(x, y + h / 2, z, width, h, depth, base, commercial ? "glass" : "apartment", false);
    uwBox(x, y + h + 0.04, z, width + 0.08, 0.08, depth + 0.08, "#f4edda", "cornice", false);
    if (quality !== "low" && level >= 3) {
        // Slim glazed highlights and cream corner fins give the skyline depth.
        // Keep these off neglected lots so decline remains visible.
        if (commercial && t.neglect < 4) {
            uwBox(x - width * 0.27, y + h * 0.52, z + depth / 2 + 0.018, 0.12, h * 0.76, 0.018, "#83cef0", "glassreflection", false);
            uwBox(x + width / 2 + 0.025, y + h / 2, z - depth * 0.32, 0.055, h, 0.075, "#f7eac7", "facadefin", false);
        }
        uwBox(x, y + 0.11, z, 1.72, 0.22, 1.72, "#b1b9ab", "towerpodium", false);
        if (t.variant % 3 === 1) {
            uwBox(x, y + h + 0.75, z, 0.64, 0.5, 0.64, commercial ? "#388dc0" : "#edd19a", "towercrown", false);
            uwPart("prism", x, y + h + 1.15, z, 0.7, 0.35, 0.7, "#256d98", "crownroof", false);
        }
        if (commercial && t.variant % 3 === 2)
            for (let band = 1; band <= 3; band++)
                uwBox(x, y + h * band / 4, z, width + 0.07, 0.055, depth + 0.07, "#a5d9ef", "officebelt", false);
    }
    if (commercial || mixed) {
        uwBox(x, y + 0.28, z + depth / 2 + 0.035, width * 0.85, 0.47, 0.04, "#227fb0", "shop-glass", powered && lightMode !== "day");
        uwBox(x, y + 0.62, z + depth / 2 + 0.12, width + 0.1, 0.13, 0.35, t.variant % 2 ? "#269cb3" : "#f1bf4e", "awning", false);
    }
    uwWindows(x, y, z, width, h, depth, level === 4 ? 12 : level === 3 ? 6 : level === 2 ? 3 : 1, powered && t.neglect < 4);
    if (quality !== "low" && era === 0 && t.age >= 120)
        uwBox(x, y + h - 0.12, z + depth / 2 + 0.04, width, 0.09, 0.08, "#d6bb94", "heritageband", false);
    if (quality !== "low" && era === 2) {
        uwBox(x - width / 2 - 0.035, y + h / 2, z, 0.07, h, 0.5, "#789574", "livingwall", false);
        uwBox(x - 0.25, y + h + 0.12, z + 0.32, 0.58, 0.04, 0.35, "#396880", "roofsolar", false);
    }
    if (level >= 2)
        uwBox(x + 0.25, y + h + 0.17, z - 0.24, 0.43, 0.26, 0.38, "#929d9e", "hvac", false);
    if (quality !== "low") {
        if (commercial || mixed) {
            uwBox(x - 0.48, y + 0.18, z + 0.89, 0.2, 0.36, 0.06, "#485f5b", "shopboard", false);
            uwBox(x - 0.48, y + 0.23, z + 0.927, 0.13, 0.025, 0.015, "#e5ddbd", "shopletter", false);
            uwPlanter(x + 0.45, y, z + 0.86, t.variant, t.neglect < 4);
        }
        if (!commercial && level >= 2) {
            for (let floor = 1; floor <= Math.min(level, 3); floor++) {
                let by = y + h * floor / (Math.min(level, 3) + 1);
                uwBox(x, by, z - depth / 2 - 0.09, 0.78, 0.07, 0.22, "#e0d6c0", "balconyslab", false);
                uwBox(x, by + 0.14, z - depth / 2 - 0.19, 0.78, 0.23, 0.035, "#718b8b", "balconyrail", false);
            }
