// AI Chat — a chat with Qwen3-0.6B, run on this device by SoftN, with conversation history

// Model state
let modelLoaded = false
let modelHandle = ""
let modelLoading = false
let statusText = "Model not downloaded yet"

// Conversation state
let conversations = []
let activeConversationId = ""
let chatMessages = []

// Input state
let inputText = ""
let generating = false

// Settings. Each number keeps a text twin so a half-typed value ("0.") is
// not snapped back to the last good number under the user's cursor.
let showSettings = false
let temperature = 0.7
let maxTokens = 256
let topP = 0.8
let temperatureText = "0.7"
let maxTokensText = "256"
let topPText = "0.8"
let settingsError = ""
let settingsErrorField = ""

// Two-step delete: the first click arms a conversation, the second deletes
// it. The arm expires after three ticks of the one-second Loop.
let confirmDeleteId = ""
let confirmDeleteTicks = 0

// UI state
let showSidebar = false
let isMobile = false

// ── Helpers ──

function refreshConversations() {
  let rows = db.query("conversations")
  if (!rows) rows = []
  rows.sort(function(a, b) {
    let ta = a.data.updatedAt || a.updatedAt || ""
    let tb = b.data.updatedAt || b.updatedAt || ""
    if (ta > tb) return -1
    if (ta < tb) return 1
    return 0
  })
  conversations = rows
}

function reloadChatMessages() {
  let allMsgs = db.query("messages")
  chatMessages = []
  if (allMsgs) {
    let i = 0
    while (i < allMsgs.length) {
      if (allMsgs[i].data.conversationId === activeConversationId) {
        chatMessages.push(allMsgs[i])
      }
      i = i + 1
    }
    chatMessages.sort(function(a, b) {
      let ta = a.data.timestamp || ""
      let tb = b.data.timestamp || ""
      if (ta < tb) return -1
      if (ta > tb) return 1
      return 0
    })
  }
}

// ── Init ──

function _init() {
  refreshConversations()
  // Enter sends, Shift+Enter breaks the line. A template handler is never
  // handed the key, so this is a window listener; the composer is the only
  // textarea on the page.
  if (!window.__aicKeyBound) {
    window.__aicKeyBound = true
    window.addEventListener("keydown", function (e) {
      if (e.key !== "Enter" || e.shiftKey || e.targetTag !== "textarea") { return }
      e.preventDefault()
      if (canSend()) { sendMessage() }
    }, true)
  }
  // Detect mobile on init
  try {
    isMobile = window.innerWidth < 640
    showSidebar = !isMobile
  } catch(e) {
    showSidebar = true
  }
}

// ── Model Management ──

function loadModel() {
  if (modelLoading || modelLoaded) return
  modelLoading = true
  statusText = "Downloading the model (about 400 MB)... a few minutes the first time"
  // A GGUF checkpoint from Hugging Face; SoftN keeps its quantized weights as
  // they are on the GPU. Room for 2048 tokens of conversation and reply, of
  // which a reply may take up to half.
  softn.ai.model.load("unsloth/Qwen3-0.6B-GGUF:Q4_K_M", { context: 2048 }, function(result) {
    if (!result || result.error || !result.modelHandle) {
      modelLoading = false
      modelLoaded = false
      statusText = "Could not download the model: " + (result && result.error ? result.error : "no model handle") + ". Try again."
      return
    }
    modelHandle = result.modelHandle
    modelLoaded = true
    modelLoading = false
    statusText = "Ready. Everything runs on this device."
  })
}

function unloadModel() {
  if (!modelLoaded) return
  softn.ai.model.release(modelHandle, function() {
    modelLoaded = false
    modelHandle = ""
    statusText = "Model unloaded"
  })
}

// ── Conversation CRUD ──

function newConversation() {
  let now = new Date().toISOString()
  db.create("conversations", {
    title: "New chat",
    createdAt: now,
    updatedAt: now
  })
  refreshConversations()
  if (conversations.length > 0) {
    activeConversationId = conversations[0].id
  }
  chatMessages = []
  inputText = ""
  confirmDeleteId = ""
  // Close sidebar on mobile after creating
  if (isMobile) showSidebar = false
}

function conversationExists(id) {
  let i = 0
  while (i < conversations.length) {
    if (conversations[i].id === id) return true
    i = i + 1
  }
  return false
}

function selectConversation(conv) {
  let id = ""
  if (typeof conv === "string") {
    id = conv
  } else if (conv && conv.id) {
    id = conv.id
  }
  if (!id || id === activeConversationId) {
    // On mobile, just close sidebar if tapping same conversation
    if (isMobile) showSidebar = false
    return
  }
  // A click that bubbles up from a just-deleted row must not select a ghost.
  if (!conversationExists(id)) return
  activeConversationId = id
  reloadChatMessages()
  inputText = ""
  // Close sidebar on mobile after selecting
  if (isMobile) showSidebar = false
}

function deleteConversation(id) {
  if (!id) return
  let allMsgs = db.query("messages")
  if (allMsgs) {
    let i = 0
    while (i < allMsgs.length) {
      if (allMsgs[i].data.conversationId === id) {
        db.delete(allMsgs[i].id)
      }
      i = i + 1
    }
  }
  db.delete(id)
  refreshConversations()
  confirmDeleteId = ""
  confirmDeleteTicks = 0
  if (activeConversationId === id) {
    activeConversationId = ""
    chatMessages = []
  }
}

// First click arms the row ("Delete?"), a second click within three seconds
// deletes it. Any other click leaves the arm to expire on its own.
function requestDelete(id) {
  if (!id) return
  if (confirmDeleteId === id) {
    deleteConversation(id)
    return
  }
  confirmDeleteId = id
  confirmDeleteTicks = 0
}

function tickDeleteConfirm() {
  if (!confirmDeleteId) return
  confirmDeleteTicks = confirmDeleteTicks + 1
  if (confirmDeleteTicks >= 3) {
    confirmDeleteId = ""
    confirmDeleteTicks = 0
  }
}

function isConfirmingDelete(conv) {
  return !!conv && conv.id === confirmDeleteId
}

// ── Message Handling ──

function sendMessage() {
  if (!inputText) return
  if (!modelLoaded) {
    statusText = "Download the model first"
    return
  }
  if (generating) return

  // Save input before newConversation() clears it
  let userContent = inputText

  // Auto-create conversation if none active
  if (!activeConversationId) {
    newConversation()
  }

  let now = new Date().toISOString()

  db.create("messages", {
    conversationId: activeConversationId,
    role: "user",
    content: userContent,
    imageDataUrl: "",
    timestamp: now
  })

  // Auto-title from first user message
  let convRows = db.query("conversations")
  let i = 0
  while (i < convRows.length) {
    if (convRows[i].id === activeConversationId) {
      if (convRows[i].data.title === "New chat" && userContent) {
        let title = userContent
        if (title.length > 40) {
          title = title.substring(0, 37) + "..."
        }
        db.update(activeConversationId, { title: title, updatedAt: now })
      } else {
        db.update(activeConversationId, { updatedAt: now })
      }
      break
    }
    i = i + 1
  }

  refreshConversations()
  reloadChatMessages()

  inputText = ""

  generating = true
  statusText = "Generating..."

  // The model reads text: an image kept from an older chat stays on screen
  // and its message goes to the model as its words. The oldest turns are let
  // go by the runtime when a conversation outgrows the model's room.
  let aiMessages = []
  let j = 0
  while (j < chatMessages.length) {
    let m = chatMessages[j]
    if (m.data.content) {
      aiMessages.push({ role: m.data.role, content: m.data.content })
    }
    j = j + 1
  }

  softn.ai.model.generate(modelHandle, aiMessages, {
    max_new_tokens: maxTokens,
    temperature: temperature,
    top_p: topP,
    top_k: 20,
    do_sample: true
  }, function(result) {
    if (!result || result.error) {
      generating = false
      statusText = "The model could not answer: " + (result && result.error ? result.error : "unknown error")
      return
    }
    let responseText = result.text || ""
    let respNow = new Date().toISOString()
    db.create("messages", {
      conversationId: activeConversationId,
      role: "assistant",
      content: responseText,
      imageDataUrl: "",
      timestamp: respNow
    })
    reloadChatMessages()
    generating = false
    statusText = "Ready. Everything runs on this device."
  })
}

// Start a conversation with a pre-filled prompt (for suggestion cards)
function startWithPrompt(text) {
  if (!modelLoaded || generating) return
  inputText = text
  sendMessage()
}

// Check if send is possible
function canSend() {
  return inputText && modelLoaded && !generating
}

// ── Input Handlers ──

function updateInput(val) {
  inputText = val
}

// ── Settings ──

function toggleSettings() {
  showSettings = !showSettings
}

function clearSettingsError(field) {
  if (settingsErrorField === field) {
    settingsError = ""
    settingsErrorField = ""
  }
}

function setTemperature(val) {
  temperatureText = "" + val
  let n = parseFloat(val)
  if (isNaN(n) || n < 0 || n > 2) {
    settingsError = "Temperature must be a number from 0 to 2. Still using " + temperature + "."
    settingsErrorField = "temperature"
    return
  }
  temperature = n
  clearSettingsError("temperature")
}

function setMaxTokens(val) {
  maxTokensText = "" + val
  let n = parseInt(val)
  if (isNaN(n) || n < 1 || n > 1024) {
    settingsError = "Max tokens must be a whole number from 1 to 1024. Still using " + maxTokens + "."
    settingsErrorField = "maxTokens"
    return
  }
  maxTokens = n
  clearSettingsError("maxTokens")
}

function setTopP(val) {
  topPText = "" + val
  let n = parseFloat(val)
  if (isNaN(n) || n < 0 || n > 1) {
    settingsError = "Top-P must be a number from 0 to 1. Still using " + topP + "."
    settingsErrorField = "topP"
    return
  }
  topP = n
  clearSettingsError("topP")
}

// ── UI ──

function toggleSidebar() {
  showSidebar = !showSidebar
}

function closeSidebar() {
  showSidebar = false
}

// ── Template Helpers ──

function isActiveConv(conv) {
  return conv.id === activeConversationId
}

function getConvTitle(conv) {
  return conv.data.title || "Untitled"
}

function getConvTime(conv) {
  let ts = conv.data.updatedAt || conv.updatedAt || ""
  if (!ts) return ""
  try {
    let d = new Date(ts)
    let now = new Date()
    let diff = now.getTime() - d.getTime()
    let mins = Math.floor(diff / 60000)
    if (mins < 1) return "now"
    if (mins < 60) return mins + "m"
    let hrs = Math.floor(mins / 60)
    if (hrs < 24) return hrs + "h"
    let days = Math.floor(hrs / 24)
    if (days < 7) return days + "d"
    return d.getMonth() + 1 + "/" + d.getDate()
  } catch(e) {
    return ""
  }
}

function getMsgTime(msg) {
  let ts = msg.data.timestamp || ""
  if (!ts) return ""
  try {
    let d = new Date(ts)
    let h = d.getHours()
    let m = d.getMinutes()
    let ampm = h >= 12 ? "PM" : "AM"
    h = h % 12
    if (h === 0) h = 12
    let mStr = m < 10 ? "0" + m : "" + m
    return h + ":" + mStr + " " + ampm
  } catch(e) {
    return ""
  }
}

function isUserMsg(msg) {
  return msg.data.role === "user"
}

function isAssistantMsg(msg) {
  return msg.data.role === "assistant"
}

function hasImage(msg) {
  return msg.data.imageDataUrl && msg.data.imageDataUrl !== ""
}

function hasContent(msg) {
  return msg.data.content && msg.data.content !== ""
}

function msgCount() {
  return chatMessages.length
}
