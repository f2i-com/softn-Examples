// WarbleWire — the QXW acoustic transport, as a SoftN app.

import "./warble.logic"

// --- Navigation ------------------------------------------------------------
let currentPage = "compose"

// --- Composing -------------------------------------------------------------
let message = "Meet me by the old gum tree."
let byteCount = 28
let overLimit = false
let maxBytes = 52

let speedId = "wren"
let voiceId = "meadow"
let noiseIndex = 0

let speeds = []
let voices = []
let noiseLevels = []

// --- The signal ------------------------------------------------------------
let cleanPcm = null
let signalPcm = null

let hasSignal = false
let signalStale = false
let generating = false
let durationLabel = "—"
let tempoLabel = "—"
let voiceLabel = "—"
let payloadLabel = "—"
let channelLabel = "Clean"
let channelDetail = "Unaltered generated PCM"
let rawRateLabel = "—"
let syllables = ""
let syllableOverflow = ""
let waveformSvg = ""
let errorText = ""
let encodedMessage = ""

let wavUrl = ""
let wavName = "warble.wav"

// --- Verifying -------------------------------------------------------------
let verifyState = "idle"
let verifyTitle = "Waiting for a signal"
let verifyDetail = "Generate a song, then ask the local decoder to inspect it."
let verifyMark = "○"

// --- Listening -------------------------------------------------------------
let listening = false
let heardState = "idle"
let heardTitle = "Nothing heard yet"
let heardDetail = "Play a song on another device — or import a WAV / test loopback here."
let heardText = ""
let heardConfidence = ""
let heardOffset = ""
let heardWaveformSvg = ""
let micRate = ""
let copiedHeard = false

function _init() {
  speeds = []
  for (let i = 0; i < WARBLE_SPEEDS.length; i = i + 1) {
    let s = WARBLE_SPEEDS[i]
    speeds.push({
      id: s.id,
      name: s.name,
      symbolMs: Math.round(s.symbolDurationMs),
      rawBitRate: Math.round(s.rawBitRate),
      seconds: s.frameDurationSeconds.toFixed(2)
    })
  }
  voices = []
  for (let i = 0; i < WARBLE_VOICES.length; i = i + 1) {
    voices.push({ id: WARBLE_VOICES[i].id, name: WARBLE_VOICES[i].name })
  }
  noiseLevels = [
    { id: 0, name: "Clean", detail: "Unaltered generated PCM" },
    { id: 1, name: "Faint", detail: "34 dB signal-to-noise" },
    { id: 2, name: "Light", detail: "26 dB signal-to-noise" },
    { id: 3, name: "Busy", detail: "18 dB signal-to-noise" },
    { id: 4, name: "Challenging", detail: "10 dB signal-to-noise" }
  ]
  maxBytes = MAX_PAYLOAD_BYTES
  recount()
  // Synthesize the starter message immediately so the waveform, syllables,
  // and local decoder are ready on launch.
  generate()
}

function _onHide() {
  try { softn.audio.stopAll() } catch (e) {}
}

// --- Composing -------------------------------------------------------------

function recount() {
  byteCount = utf8Encode(message).length
  overLimit = byteCount > maxBytes
}

function messageChanged() {
  recount()
  if (hasSignal && message !== encodedMessage) {
    signalStale = true
  } else {
    signalStale = false
  }
}

function setPresetMessage(text) {
  message = text
  recount()
  generate()
}

function setSpeed(id) {
  speedId = id
  if (!overLimit && byteCount > 0) {
    generate()
  } else {
    forgetSignal()
  }
}

function setVoice(id) {
  voiceId = id
  if (!overLimit && byteCount > 0) {
    generate()
  } else {
    forgetSignal()
  }
}

function setNoise(index) {
  noiseIndex = index
  channelLabel = noiseLevels[index].name
  channelDetail = noiseLevels[index].detail
  try { softn.audio.stopAll() } catch (e) {}
  if (!hasSignal) { return }
  applyChannel()
  verifyState = "idle"
  verifyTitle = "Channel changed (" + channelLabel + ")"
  verifyDetail = "Tap Verify signal to test convolutional + Viterbi recovery through this channel."
  verifyMark = "○"
}

function snrForIndex(index) {
  if (index === 1) { return 34 }
  if (index === 2) { return 26 }
  if (index === 3) { return 18 }
  if (index === 4) { return 10 }
  return null
}

function applyChannel() {
  let snr = snrForIndex(noiseIndex)
  if (snr === null) {
    signalPcm = cleanPcm
  } else {
    signalPcm = addSeededNoise(cleanPcm.slice(), snr, 0x717877)
  }
  waveformSvg = waveformPath(signalPcm, 360, 104, "ww-wave-compose", true)
  wavUrl = ""
}

function forgetSignal() {
  try { softn.audio.stopAll() } catch (e) {}
  cleanPcm = null
  signalPcm = null
  hasSignal = false
  signalStale = false
  wavUrl = ""
  waveformSvg = ""
  syllables = ""
  syllableOverflow = ""
  durationLabel = "—"
  tempoLabel = "—"
  voiceLabel = "—"
  payloadLabel = "—"
  rawRateLabel = "—"
  errorText = ""
  encodedMessage = ""
  verifyState = "idle"
  verifyTitle = "Waiting for a signal"
  verifyDetail = "Generate a song, then ask the local decoder to inspect it."
  verifyMark = "○"
}

function generate() {
  if (overLimit || byteCount === 0 || generating) { return }
  try { softn.audio.stopAll() } catch (e) {}
  generating = true
  errorText = ""

  let encoded = encodeWarbleMessage(message, { speedId: speedId, voiceId: voiceId })
  if (!encoded || !encoded.pcm) {
    errorText = "The encoder could not build a frame from that message."
    generating = false
    return
  }

  cleanPcm = encoded.pcm
  encodedMessage = message
  hasSignal = true
  signalStale = false

  durationLabel = encoded.durationSeconds.toFixed(2) + " s"
  tempoLabel = encoded.speedName
  voiceLabel = encoded.voiceName
  rawRateLabel = Math.round(encoded.rawBitRate) + " bit/s"
  payloadLabel = encoded.textBytes.length + " bytes"
  channelLabel = noiseLevels[noiseIndex].name
  channelDetail = noiseLevels[noiseIndex].detail
  wavName = "qxw-warble-" + encoded.speedId + "-" + encoded.voiceId + ".wav"

  let shown = []
  let limit = encoded.syllables.length
  if (limit > 28) { limit = 28 }
  for (let i = 0; i < limit; i = i + 1) { shown.push(encoded.syllables[i]) }
  syllables = shown.join(" ")
  if (encoded.syllables.length > 28) {
    syllableOverflow = "+" + (encoded.syllables.length - 28) + " more symbols"
  } else {
    syllableOverflow = ""
  }

  applyChannel()

  verifyState = "idle"
  verifyTitle = "Ready to verify"
  verifyDetail = "Ask the local decoder to inspect this signal and verify CRC-32 recovery."
  verifyMark = "○"
  generating = false
}

function ensureCurrentSignal() {
  if (signalStale && !overLimit && byteCount > 0) {
    generate()
  }
}

function play() {
  ensureCurrentSignal()
  if (!hasSignal) { return }
  try { softn.audio.stopAll() } catch (e) {}
  errorText = ""
  softn.audio.play(wavDataUrl(signalPcm, 48000), {}, function (r) {
    if (r && r.blocked) {
      errorText = "The browser is holding sound back until the page is tapped."
    }
  })
}

function stop() {
  try { softn.audio.stopAll() } catch (e) {}
}

function downloadWav() {
  ensureCurrentSignal()
  if (!hasSignal) { return }
  let bytes = pcmToWavBytes(signalPcm, 48000)
  if (typeof softn !== "undefined" && softn.files && typeof softn.files.saveFile === "function") {
    try {
      softn.files.saveFile(wavName, bytes, "audio/wav")
      return
    } catch (e) {}
  }
  wavUrl = "data:audio/wav;base64," + _bytesToBase64(bytes)
}

function verify() {
  ensureCurrentSignal()
  if (!hasSignal) { return }
  verifyState = "working"
  verifyTitle = "Listening closely…"
  verifyDetail = "Correlating 267 symbols against sixteen candidate calls each."
  verifyMark = "…"

  let result = decodeWarblePcm(signalPcm)
  if (!result.ok) {
    verifyState = "rejected"
    verifyTitle = "Rejected safely"
    verifyDetail = "The decoder refused this signal: " + result.reason + "."
    verifyMark = "×"
    return
  }

  if (result.text !== encodedMessage) {
    verifyState = "rejected"
    verifyTitle = "Rejected safely"
    verifyDetail = "The recovered text did not match the generated payload, so the lab rejected it."
    verifyMark = "×"
    return
  }

  verifyState = "verified"
  verifyTitle = "Verified"
  verifyDetail = "CRC-32 checked and \"" + result.text + "\" matches at " +
    Math.round(result.confidence * 100) + "% symbol confidence."
  verifyMark = "✓"
}

// --- Listening -------------------------------------------------------------

function startListening() {
  listening = true
  copiedHeard = false
  heardState = "working"
  heardTitle = "Listening…"
  heardDetail = "Recording raw 48 kHz audio. Play a WarbleWire song near this device, then release."
  heardText = ""
  heardConfidence = ""
  heardOffset = ""
  heardWaveformSvg = ""
}

function stopListening() {
  listening = false
}

function playForListener() {
  ensureCurrentSignal()
  if (!hasSignal) { return }
  try { softn.audio.stopAll() } catch (e) {}
  // Shorter lead if user is already holding Record so mouse click transient decays quickly;
  // longer lead if they still need to press Record.
  let leadSeconds = listening ? 0.45 : 2.2
  let lead = Math.round(48000 * leadSeconds)
  let padded = new Float32Array(lead + signalPcm.length)
  padded.set(signalPcm, lead)
  softn.audio.play(wavDataUrl(padded, 48000), {}, function (r) {
    if (r && r.blocked) {
      heardDetail = "The browser is holding sound back until the page is tapped."
    }
  })
}

function decodeLoopbackDirect() {
  ensureCurrentSignal()
  if (!hasSignal) { return }
  copiedHeard = false
  // Simulate room lead-in & tail padding through the full blind capture detector!
  let lead = 19200
  let tail = 9600
  let captured = new Float32Array(lead + signalPcm.length + tail)
  captured.set(signalPcm, lead)
  let noisy = snrForIndex(noiseIndex) === null ? addSeededNoise(captured, 32, 0x51a7) : captured
  decodePcmBuffer(noisy, 48000, "Loopback capture (48000 Hz)")
}

function importWavForListen() {
  if (typeof softn === "undefined" || !softn.files || typeof softn.files.openFile !== "function") {
    heardState = "rejected"
    heardTitle = "File picker unavailable"
    heardDetail = "Allow file access or use Loopback / Microphone to inspect a signal."
    return
  }
  try {
    softn.files.openFile({ accept: ".wav,audio/wav" }, function(file) {
      if (!file) return
      let dataUrl = ""
      if (typeof file.dataUrl === "string") {
        dataUrl = file.dataUrl
      } else if (file.bytes || file.data) {
        let rawBytes = file.bytes || file.data
        let u8 = rawBytes instanceof Uint8Array ? rawBytes : new Uint8Array(rawBytes)
        dataUrl = "data:audio/wav;base64," + _bytesToBase64(u8)
      }
      if (!dataUrl) {
        heardState = "rejected"
        heardTitle = "Could not read file"
        heardDetail = "Select a valid PCM or float .wav recording."
        return
      }
      handleHeard({ dataUrl: dataUrl })
    })
  } catch (err) {
    heardState = "rejected"
    heardTitle = "Could not open WAV file"
    heardDetail = String(err && err.message ? err.message : err)
  }
}

function decodePcmBuffer(pcm, sampleRate, rateText) {
  listening = false
  copiedHeard = false
  micRate = rateText || (sampleRate + " Hz")
  heardWaveformSvg = waveformPath(pcm, 360, 96, "ww-wave-listen", false)

  let result = decodeCapturedPcm(pcm, sampleRate)
  if (!result.ok) {
    heardState = "rejected"
    heardTitle = "No frame recovered"
    heardText = ""
    heardConfidence = ""
    heardOffset = ""
    heardDetail = "Nothing in that clip decoded (" + result.reason +
      "). Try moving closer in a quieter room or lowering channel noise."
    return
  }

  heardState = "verified"
  heardTitle = "Message recovered"
  heardText = result.text
  heardConfidence = Math.round(result.confidence * 100) + "%"
  heardOffset = "found " + (result.offset / 48000).toFixed(2) + " s in"
  heardDetail = "Decoded blindly as " + result.speedName + " · " + result.voiceName + " (CRC-32 valid)."
}

function handleHeard(clip) {
  listening = false
  copiedHeard = false
  heardState = "working"
  heardTitle = "Decoding…"
  heardDetail = "Searching the recording for a WarbleWire preamble and frame."

  let audio = pcmFromWavDataUrl(clip ? clip.dataUrl : "")
  if (!audio || !audio.pcm) {
    heardState = "rejected"
    heardTitle = "Could not read the recording"
    heardText = ""
    heardConfidence = ""
    heardOffset = ""
    heardWaveformSvg = ""
    heardDetail = "Unsupported WAV format (" + (audio && audio.reason ? audio.reason : "unreadable") + ")."
    return
  }

  decodePcmBuffer(audio.pcm, audio.sampleRate, audio.sampleRate + " Hz")
}

function handleMicError(reason) {
  listening = false
  copiedHeard = false
  heardState = "rejected"
  heardTitle = "The microphone did not open"
  heardText = ""
  heardConfidence = ""
  heardOffset = ""
  heardWaveformSvg = ""
  if (typeof reason === "string" && reason.length > 0) {
    heardDetail = reason
  } else if (reason && typeof reason.message === "string" && reason.message.length > 0) {
    heardDetail = reason.message
  } else {
    heardDetail = "Microphone access was denied or no audio input device is available. You can still test decoding via Loopback or Import WAV."
  }
}

function copyHeardText() {
  if (!heardText) return
  try {
    if (typeof navigator !== "undefined" && navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(heardText)
    }
  } catch (e) {}
  copiedHeard = true
}

// --- Drawing ---------------------------------------------------------------

function waveformPath(pcm, columns, height, gradId, showPilots) {
  if (!pcm || pcm.length === 0) { return "" }

  let gid = gradId || "ww-wave"
  let mid = height / 2
  let perColumn = Math.floor(pcm.length / columns)
  if (perColumn < 1) { perColumn = 1 }

  let d = []
  for (let x = 0; x < columns; x = x + 1) {
    let start = x * perColumn
    let end = start + perColumn
    if (end > pcm.length) { end = pcm.length }
    if (start >= end) { break }

    let lo = pcm[start]
    let hi = pcm[start]
    for (let i = start + 1; i < end; i = i + 1) {
      let v = pcm[i]
      if (v < lo) { lo = v }
      if (v > hi) { hi = v }
    }

    let px = x + 0.5
    let top = mid - hi * (mid - 4)
    let bottom = mid - lo * (mid - 4)
    if (bottom - top < 1.2) { bottom = top + 1.2 }
    d.push("M" + px.toFixed(1) + " " + top.toFixed(1) + "V" + bottom.toFixed(1))
  }

  let guides = '<line x1="0" y1="' + mid.toFixed(1) + '" x2="' + columns + '" y2="' + mid.toFixed(1) + '" stroke="#324954" stroke-width="1" stroke-dasharray="3 3"/>'
  if (showPilots) {
    for (let p = 0; p < 8; p = p + 1) {
      let px = Math.round(((10 + p * 33) / 267) * columns) + 0.5
      guides = guides + '<line x1="' + px + '" y1="3" x2="' + px + '" y2="' + (height - 3) + '" stroke="rgba(251,227,160,0.22)" stroke-width="1"/>'
    }
  }

  return '<svg viewBox="0 0 ' + columns + ' ' + height + '" preserveAspectRatio="none" width="100%" height="' + height + '">' +
    '<defs><linearGradient id="' + gid + '" x1="0" y1="0" x2="1" y2="0">' +
    '<stop offset="0" stop-color="#c7ee53"/>' +
    '<stop offset="0.52" stop-color="#7de8cf"/>' +
    '<stop offset="1" stop-color="#a9dce8"/>' +
    '</linearGradient></defs>' +
    guides +
    '<path d="' + d.join("") + '" stroke="url(#' + gid + ')" stroke-width="1.25" fill="none"/>' +
    '</svg>'
}

// --- Navigation ------------------------------------------------------------

function setPage(page) {
  if (page !== currentPage) {
    try { softn.audio.stopAll() } catch (e) {}
  }
  if (page !== "listen") { listening = false }
  currentPage = page
}
