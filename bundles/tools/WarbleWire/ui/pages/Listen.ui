// Listen.ui — record from microphone, import a WAV file, or run a blind loopback capture.

<Stack direction=vertical gap=md if={currentPage === "listen"}>

  <Grid columns={{ sm: 1, lg: 2 }} gap=md>

    // ── The ear ─────────────────────────────────────────────────────────────
    <Card className="ww-hard" padding=lg style={{ background: "#20343d", borderRadius: "0", color: "#f4eddc" }}>
      <Stack direction=vertical gap=md>
        <Text className="ww-mono" style={{ fontSize: "0.625rem", color: "#a9dce8" }}>01 — Capture or Import</Text>

        <Text style={{ fontSize: "0.8125rem", color: "#d5e1e6", lineHeight: 1.55 }}>
          Play a WarbleWire song on another device and hold Record below for the full burst (a Wren frame runs ~8.5 s). Raw 48 kHz capture disables speech noise-suppression so pure bird tones survive intact.
        </Text>

        <Box style={{ display: "flex", alignItems: "center", gap: "0.5rem", flexWrap: "wrap" }}>
          <Button @click={playForListener} disabled={!hasSignal} variant=ghost style={{
            minHeight: "38px", borderRadius: "999px", border: "1px solid #c7ee53", background: "transparent",
            color: "#c7ee53", fontWeight: 600, fontSize: "0.78rem", padding: "0.45rem 0.85rem"
          }}>Speaker → Mic test</Button>

          <Button @click={decodeLoopbackDirect} disabled={!hasSignal} variant=ghost style={{
            minHeight: "38px", borderRadius: "999px", border: "1px solid #a9dce8", background: "transparent",
            color: "#a9dce8", fontWeight: 600, fontSize: "0.78rem", padding: "0.45rem 0.85rem"
          }}>Loopback decode</Button>

          <Button @click={importWavForListen} variant=ghost style={{
            minHeight: "38px", borderRadius: "999px", border: "1px solid #fbe3a0", background: "transparent",
            color: "#fbe3a0", fontWeight: 600, fontSize: "0.78rem", padding: "0.45rem 0.85rem"
          }}>Import .wav</Button>
        </Box>

        <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#9ab0ba" }}>
          {listening ? "Recording active — Speaker test starts after 0.45 s" : "Hold Record first (or press Speaker → Mic test for a 2.2 s countdown)"}
        </Text>

        <Microphone
          mode="clip"
          sampleRate={48000}
          processing={false}
          maxSeconds={20}
          height={72}
          onCapture={handleHeard}
          onError={handleMicError}
          onStart={startListening}
          style={{ background: "#18262d", border: "1px solid #3f4f57", borderRadius: "0" }}
        />

        <Text if={micRate !== ""} className="ww-mono" style={{ fontSize: "0.5625rem", color: "#b0c2ca" }}>
          {"Captured source: " + micRate}
        </Text>

        <Box if={heardWaveformSvg !== ""} style={{ background: "#18262d", border: "1px solid #3f4f57", overflow: "hidden" }}>
          <Icon svg={heardWaveformSvg} size="100%" style={{ width: "100%", display: "block" }} />
        </Box>
      </Stack>
    </Card>

    // ── What came back ──────────────────────────────────────────────────────
    <Card className="ww-hard" padding=lg style={{
      background: heardState === "verified" ? "#e9f0dd" : heardState === "rejected" ? "#fde8e3" : "#fffaf0",
      borderRadius: "0"
    }}>
      <Stack direction=vertical gap=md>
        <Box style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
          <Text className="ww-mono" style={{ fontSize: "0.625rem", color: "#6d7f88" }}>02 — Recovered Frame</Text>
          <Button if={heardText !== ""} size=xs variant=ghost @click={copyHeardText} style={{
            border: "1px solid #18262d", borderRadius: "999px", padding: "0.2rem 0.65rem",
            background: copiedHeard ? "#c7ee53" : "#f4eddc", color: "#18262d",
            fontSize: "0.68rem", fontWeight: 600
          }}>{copiedHeard ? "✓ Copied" : "Copy message"}</Button>
        </Box>

        <Text style={{ fontSize: "1rem", fontWeight: 700, letterSpacing: "-0.02em" }}>{heardTitle}</Text>

        <Box if={heardText !== ""} className="ww-hard" style={{
          background: "#f4eddc",
          padding: "0.875rem",
          fontSize: "1.0625rem",
          lineHeight: 1.45,
          wordBreak: "break-word"
        }}>
          <Text>{heardText}</Text>
        </Box>

        <Text style={{ fontSize: "0.8125rem", color: "#3d4f58", lineHeight: 1.55 }}>{heardDetail}</Text>

        <Stack if={heardConfidence !== ""} direction=vertical gap=xs style={{ borderTop: "1px solid #18262d", paddingTop: "0.625rem" }}>
          <Box style={{ display: "flex", justifyContent: "space-between" }}>
            <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#6d7f88" }}>Symbol confidence</Text>
            <Text className="ww-mono" style={{ fontSize: "0.5625rem", fontWeight: 600 }}>{heardConfidence}</Text>
          </Box>
          <Box style={{ display: "flex", justifyContent: "space-between" }}>
            <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#6d7f88" }}>Frame onset</Text>
            <Text className="ww-mono" style={{ fontSize: "0.5625rem", fontWeight: 600 }}>{heardOffset}</Text>
          </Box>
        </Stack>
      </Stack>
    </Card>
  </Grid>

  <Text style={{ fontSize: "0.6875rem", color: "#6d7f88", lineHeight: 1.5 }}>
    Tip: No microphone handy? Use Loopback decode or Export WAV in Compose and Import .wav here to inspect full blind preamble detection across all 12 tempo × voice profiles.
  </Text>
</Stack>
