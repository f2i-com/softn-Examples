// Compose.ui — write a message, turn it into a song, prove it survived.

<Stack direction=vertical gap=md if={currentPage === "compose"}>

  <Grid columns={{ sm: 1, lg: 3 }} gap=md>

    // ── The composer ────────────────────────────────────────────────────────
    <Card className="ww-hard" padding=lg style={{ background: "#fffaf0", borderRadius: "0" }}>
      <Stack direction=vertical gap=md>
        <Text className="ww-mono" style={{ fontSize: "0.625rem", color: "#6d7f88" }}>01 — Message</Text>

        <Box style={{ display: "flex", flexWrap: "wrap", gap: "0.45rem" }}>
          <Box @click={setPresetMessage("Meet me by the old gum tree.")} style={{ cursor: "pointer", border: "1px solid #18262d", padding: "0.45rem 0.7rem", minHeight: "36px", display: "flex", alignItems: "center", fontSize: "0.6875rem", background: "#f4eddc" }}>
            <Text className="ww-mono" style={{ fontSize: "0.625rem" }}>Gum tree</Text>
          </Box>
          <Box @click={setPresetMessage("CQ CQ DE VK2 SOFTN K")} style={{ cursor: "pointer", border: "1px solid #18262d", padding: "0.45rem 0.7rem", minHeight: "36px", display: "flex", alignItems: "center", fontSize: "0.6875rem", background: "#f4eddc" }}>
            <Text className="ww-mono" style={{ fontSize: "0.625rem" }}>CQ call</Text>
          </Box>
          <Box @click={setPresetMessage("All sensors green; telemetry nominal.")} style={{ cursor: "pointer", border: "1px solid #18262d", padding: "0.45rem 0.7rem", minHeight: "36px", display: "flex", alignItems: "center", fontSize: "0.6875rem", background: "#f4eddc" }}>
            <Text className="ww-mono" style={{ fontSize: "0.625rem" }}>Telemetry</Text>
          </Box>
        </Box>

        // :bind writes the value back and @change runs after it, so the handler
        // sees the new text — the renderer keeps both rather than overwriting one.
        <TextArea
          :bind={message}
          @change={messageChanged()}
          rows={3}
          placeholder="Up to 52 bytes."
          style={{
            width: "100%",
            border: "1px solid #18262d",
            borderRadius: "0",
            background: "#f4eddc",
            padding: "0.625rem",
            fontSize: "0.9375rem",
            color: "#18262d",
            outlineColor: overLimit ? "#a7291b" : "#3156c9"
          }}
        />

        <Box style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
          <Text className="ww-mono" style={{ fontSize: "0.625rem", color: overLimit ? "#a7291b" : "#6d7f88" }}>
            {byteCount + " / " + maxBytes + " UTF-8 bytes"}
          </Text>
          <Text if={overLimit} className="ww-mono" style={{ fontSize: "0.625rem", color: "#a7291b" }}>Too long for one frame</Text>
        </Box>

        // Tempo
        <Text className="ww-mono" style={{ fontSize: "0.625rem", color: "#6d7f88", marginTop: "0.25rem" }}>02 — Pip tempo</Text>
        <Stack direction=vertical gap=xs>
          #each (choice in speeds)
            <Box @click={setSpeed(choice.id)} style={{
              cursor: "pointer",
              border: "1px solid #18262d",
              background: speedId === choice.id ? "#c7ee53" : "transparent",
              padding: "0.55rem 0.65rem",
              minHeight: "42px",
              display: "flex",
              flexWrap: "wrap",
              justifyContent: "space-between",
              alignItems: "center",
              gap: "0.25rem 0.5rem"
            }}>
              <Text style={{ fontSize: "0.8125rem", fontWeight: 600 }}>{choice.name}</Text>
              <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#6d7f88" }}>
                {choice.symbolMs + " ms · " + choice.rawBitRate + " raw bit/s"}
              </Text>
            </Box>
          #end
        </Stack>

        // Voice
        <Text className="ww-mono" style={{ fontSize: "0.625rem", color: "#6d7f88", marginTop: "0.25rem" }}>03 — Synthetic voice</Text>
        <Grid columns={{ sm: 2 }} gap=xs>
          #each (choice in voices)
            <Box @click={setVoice(choice.id)} style={{
              cursor: "pointer",
              border: "1px solid #18262d",
              background: voiceId === choice.id ? "#a9dce8" : "transparent",
              padding: "0.55rem 0.65rem",
              minHeight: "42px",
              display: "flex",
              alignItems: "center"
            }}>
              <Text style={{ fontSize: "0.8125rem", fontWeight: 600 }}>{choice.name}</Text>
            </Box>
          #end
        </Grid>

        <Button
          @click={generate}
          disabled={overLimit || byteCount === 0 || generating}
          className="ww-hard"
          style={{
            marginTop: "0.5rem",
            width: "100%",
            minHeight: "44px",
            borderRadius: "999px",
            background: "#18262d",
            color: "#f4eddc",
            padding: "0.625rem",
            fontWeight: 600,
            fontSize: "0.875rem"
          }}
        >
          {generating ? "Synthesising…" : "Generate song"}
        </Button>
      </Stack>
    </Card>

    // ── The signal ──────────────────────────────────────────────────────────
    <Card className="ww-hard" padding=lg style={{ background: "#20343d", borderRadius: "0", color: "#f4eddc" }}>
      <Stack direction=vertical gap=md>
        <Text className="ww-mono" style={{ fontSize: "0.625rem", color: "#a9dce8" }}>04 — Signal</Text>

        <Box style={{ background: "#18262d", border: "1px solid #3f4f57", minHeight: "96px", display: "flex", alignItems: "center" }}>
          <Icon if={hasSignal} svg={waveformSvg} size="100%" style={{ width: "100%", display: "block" }} />
          <Text if={!hasSignal} className="ww-mono" style={{ fontSize: "0.625rem", color: "#6d7f88", margin: "0 auto" }}>
            No waveform yet
          </Text>
        </Box>

        // Channel — five levels of noise, each named under its bar
        <Stack direction=vertical gap=xs>
          <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#a9dce8" }}>{"Test channel — " + channelLabel}</Text>
          <Box style={{ display: "flex", gap: "0.3rem", flexWrap: "wrap" }}>
            #each (level in noiseLevels)
              <Box @click={setNoise(level.id)} style={{
                cursor: "pointer",
                flex: "1 1 48px",
                minWidth: 0,
                minHeight: "42px",
                display: "flex",
                flexDirection: "column",
                justifyContent: "center",
                gap: "0.25rem"
              }}>
                <Box style={{
                  height: "28px",
                  border: "1px solid " + (noiseIndex === level.id ? "#c7ee53" : "#3f4f57"),
                  background: noiseIndex === level.id ? "#c7ee53" : "transparent"
                }} />
                <Text style={{
                  fontFamily: "ui-monospace, Menlo, Consolas, monospace",
                  fontSize: "0.5625rem",
                  letterSpacing: "0.02em",
                  textAlign: "center",
                  whiteSpace: "nowrap",
                  color: noiseIndex === level.id ? "#c7ee53" : "#8fa1a9"
                }}>{level.name}</Text>
              </Box>
            #end
          </Box>
          <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#9ab0ba" }}>{channelDetail}</Text>
        </Stack>

        // Stats
        <Stack direction=vertical gap=xs style={{ borderTop: "1px solid #3f4f57", paddingTop: "0.625rem" }}>
          <Box style={{ display: "flex", justifyContent: "space-between" }}>
            <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#9ab0ba" }}>Duration</Text>
            <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#f4eddc" }}>{durationLabel}</Text>
          </Box>
          <Box style={{ display: "flex", justifyContent: "space-between" }}>
            <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#9ab0ba" }}>Tempo</Text>
            <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#f4eddc" }}>{tempoLabel + " · " + rawRateLabel}</Text>
          </Box>
          <Box style={{ display: "flex", justifyContent: "space-between" }}>
            <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#9ab0ba" }}>Voice</Text>
            <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#f4eddc" }}>{voiceLabel}</Text>
          </Box>
          <Box style={{ display: "flex", justifyContent: "space-between" }}>
            <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#9ab0ba" }}>Payload</Text>
            <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#f4eddc" }}>{payloadLabel}</Text>
          </Box>
        </Stack>

        <Box style={{ display: "flex", gap: "0.375rem", flexWrap: "wrap" }}>
          <Button @click={play} disabled={!hasSignal} style={{
            flex: 1, minHeight: "40px", borderRadius: "999px", background: "#c7ee53", color: "#18262d",
            fontWeight: 600, fontSize: "0.8125rem", padding: "0.5rem"
          }}>Play song</Button>
          <Button @click={stop} disabled={!hasSignal} variant=ghost style={{
            minHeight: "40px", borderRadius: "999px", border: "1px solid #a9dce8", color: "#a9dce8", fontSize: "0.8125rem", padding: "0.5rem 0.875rem"
          }}>Stop</Button>
        </Box>

        // The href has to be a data: URL — there is no createObjectURL in a
        // .logic script — so it is built when asked for rather than on every
        // encode. The button builds it and turns into the link in place.
        <Box if={hasSignal} style={{ display: "flex", flexDirection: "column", gap: "0.25rem" }}>
          <Button if={wavUrl === ""} @click={prepareDownload} variant=ghost style={{
            width: "100%", minHeight: "40px", borderRadius: "999px", border: "1px solid #a9dce8",
            background: "transparent", color: "#a9dce8", fontWeight: 600,
            fontSize: "0.8125rem", padding: "0.5rem"
          }}>Download WAV</Button>
          <a
            if={wavUrl !== ""}
            href={wavUrl}
            download={wavName}
            style={{
              display: "flex", alignItems: "center", justifyContent: "center",
              boxSizing: "border-box", width: "100%", minHeight: "40px", borderRadius: "999px",
              border: "1px solid #c7ee53", background: "#c7ee53", color: "#18262d",
              fontWeight: 600, fontSize: "0.8125rem", padding: "0.5rem", textDecoration: "none"
            }}
          >Save WAV file</a>
          <Text if={wavUrl !== ""} className="ww-mono" style={{ fontSize: "0.5625rem", color: "#6d7f88", textAlign: "center" }}>{wavName}</Text>
        </Box>
      </Stack>
    </Card>

    // ── The verdict ─────────────────────────────────────────────────────────
    <Card className="ww-hard" padding=lg style={{
      background: verifyState === "verified" ? "#e9f0dd" : verifyState === "rejected" ? "#fde8e3" : "#f4eddc",
      borderRadius: "0"
    }}>
      <Stack direction=vertical gap=md>
        <Text className="ww-mono" style={{ fontSize: "0.625rem", color: "#6d7f88" }}>05 — Local decoder</Text>

        // The status glyph: grey while waiting, amber while working, red on a
        // rejection, green once verified.
        <Box style={{ display: "flex", alignItems: "center", gap: "0.625rem" }}>
          <Box style={{
            width: "40px", height: "40px", borderRadius: "50%", flexShrink: 0,
            border: "1px solid #18262d",
            background: verifyState === "verified" ? "#c7ee53" : verifyState === "rejected" ? "#f37561" : verifyState === "working" ? "#fbe3a0" : "transparent",
            display: "flex", alignItems: "center", justifyContent: "center"
          }}>
            <Text style={{
              fontSize: "1.375rem", fontWeight: 700, lineHeight: 1,
              color: verifyState === "verified" ? "#1f4a2c" : verifyState === "rejected" ? "#7a1d12" : verifyState === "working" ? "#7a4b00" : "#6d7f88"
            }}>{verifyMark}</Text>
          </Box>
          <Text style={{ fontSize: "0.9375rem", fontWeight: 700, letterSpacing: "-0.02em" }}>{verifyTitle}</Text>
        </Box>

        <Text style={{ fontSize: "0.8125rem", color: "#3d4f58", lineHeight: 1.5 }}>{verifyDetail}</Text>

        <Button @click={verify} disabled={!hasSignal} className="ww-hard" style={{
          minHeight: "42px", borderRadius: "999px", background: "#3156c9", color: "#ffffff",
          fontWeight: 600, fontSize: "0.875rem", padding: "0.5rem"
        }}>Verify signal</Button>

        // Pip syllables — the wire, spelled out
        <Stack if={hasSignal} direction=vertical gap=xs style={{ borderTop: "1px solid #18262d", paddingTop: "0.625rem" }}>
          <Text className="ww-mono" style={{ fontSize: "0.5625rem", color: "#6d7f88" }}>Pip-16 syllables</Text>
          <Text className="ww-mono" style={{ fontSize: "0.6875rem", lineHeight: 1.7, wordBreak: "break-word" }}>{syllables}</Text>
          <Text if={syllableOverflow !== ""} className="ww-mono" style={{ fontSize: "0.5625rem", color: "#6d7f88" }}>{syllableOverflow}</Text>
        </Stack>

        <Alert if={errorText !== ""} variant=error>{errorText}</Alert>
      </Stack>
    </Card>
  </Grid>
</Stack>
