// AI Chat — private on-device Qwen3-0.6B chat with conversation history

let MODEL_SPEC = "unsloth/Qwen3-0.6B-GGUF:Q4_K_M"

// Model state
let modelLoaded = false
let modelHandle = ""
let modelLoading = false
let loadError = ""
let statusText = "Model not downloaded yet"
let pendingPrompt = ""

// Conversation state
let conversations = []
let filteredConversations = []
let searchQuery = ""
let activeConversationId = ""
let chatMessages = []

// Input & generation state
let inputText = ""
let generating = false
let generatingConvId = ""

// Settings
let showSettings = false
let thinkingMode = false
let systemPrompt = "You are a helpful, clear, and concise assistant."
let temperature = 0.7
let maxTokens = 512
let topP = 0.85
let temperatureText = "0.7"
let maxTokensText = "512"
let topPText = "0.85"
let settingsError = ""
let settingsErrorField = ""

// Two-step delete & click-bubbling guard
let confirmDeleteId = ""
let confirmDeleteTicks = 0
let suppressSelectUntil = 0

// Copy feedback & expanded reasoning tracking
let showSidebar = true
let isMobile = false
let copiedMsgId = ""
let copiedTicks = 0
let expandedThinkId = ""

function copyReply(id, msg) {
  let clean = getMsgAnswer(msg)
  if (!clean) clean = (msg && msg.data && msg.data.content) ? msg.data.content : ""
  if (!clean) return
  try {
    if (typeof navigator !== "undefined" && navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(clean)
    }
  } catch (e) {}
  copiedMsgId = id
  copiedTicks = 0
}

// ── Reasoning (<think>...</think>) Parser ──

function extractThinkParts(raw) {
  let text = String(raw || "")
  let openIdx = text.indexOf("<think>")
  if (openIdx < 0) {
    return { think: "", answer: text.trim() }
  }
  let closeIdx = text.indexOf("</think>", openIdx + 7)
  if (closeIdx < 0) {
    let partialThink = text.substring(openIdx + 7).trim()
    let prefix = text.substring(0, openIdx).trim()
    return {
      think: partialThink,
      answer: prefix || "(Reasoning finished at token limit — increase Max tokens in Settings for longer answers.)"
    }
  }
  let thinkBody = text.substring(openIdx + 7, closeIdx).trim()
  let rest = (text.substring(0, openIdx) + " " + text.substring(closeIdx + 8)).trim()
  return {
    think: thinkBody,
    answer: rest || thinkBody
  }
}

function hasMsgThink(msg) {
  if (!msg || !msg.data || msg.data.role !== "assistant") return false
  let parts = extractThinkParts(msg.data.content)
  return parts.think.length > 0
}

function getMsgThink(msg) {
  if (!msg || !msg.data) return ""
  return extractThinkParts(msg.data.content).think
}

function getMsgAnswer(msg) {
  if (!msg || !msg.data) return ""
  if (msg.data.role !== "assistant") return msg.data.content || ""
  return extractThinkParts(msg.data.content).answer
}

function toggleThink(id) {
  if (expandedThinkId === id) {
    expandedThinkId = ""
  } else {
    expandedThinkId = id
  }
}

function isThinkOpen(msg) {
  return !!msg && expandedThinkId === msg.id
}

// ── Helpers ──

function applyConversationFilter() {
  let q = searchQuery.trim().toLowerCase()
  if (!q) {
    filteredConversations = conversations
    return
  }
  let out = []
  let i = 0
  while (i < conversations.length) {
    let title = String(conversations[i].data.title || "").toLowerCase()
    if (title.indexOf(q) >= 0) {
      out.push(conversations[i])
    }
    i = i + 1
  }
  filteredConversations = out
}

function setSearchQuery(val) {
  searchQuery = val || ""
  applyConversationFilter()
}

function refreshConversations() {
  let rows = db.query("conversations")
  if (!rows) rows = []
  rows.sort(function(a, b) {
    let ta = a.data.updatedAt || a.updatedAt || ""
    let tb = b.data.updatedAt || b.updatedAt || ""
    if (ta > tb) return -1
    if (ta < tb) return 1
    return 0
  })
  conversations = rows
  applyConversationFilter()
}

function reloadChatMessages() {
  let allMsgs = db.query("messages")
  let next = []
  if (allMsgs && activeConversationId) {
    let i = 0
    while (i < allMsgs.length) {
      if (allMsgs[i].data.conversationId === activeConversationId) {
        next.push(allMsgs[i])
      }
      i = i + 1
    }
    next.sort(function(a, b) {
      let ta = a.data.timestamp || ""
      let tb = b.data.timestamp || ""
      if (ta < tb) return -1
      if (ta > tb) return 1
      return 0
    })
  }
  chatMessages = next
}

function scrollChatToBottom() {
  try {
    setTimeout(function() {
      let el = document.querySelector(".chat-scroll-area")
      if (el) el.scrollTop = el.scrollHeight
    }, 30)
  } catch (e) {}
}

// ── Init & Lifecycle ──

function syncViewport() {
  try {
    let nextMobile = window.innerWidth < 680
    if (nextMobile !== isMobile) {
      isMobile = nextMobile
      showSidebar = !nextMobile
    }
  } catch (e) {}
}

function _init() {
  refreshConversations()
  if (conversations.length > 0 && !activeConversationId) {
    activeConversationId = conversations[0].id
    reloadChatMessages()
  }

  try {
    isMobile = window.innerWidth < 680
    showSidebar = !isMobile

    if (window.__aicKeyHandler) {
      window.removeEventListener("keydown", window.__aicKeyHandler, true)
    }
    window.__aicKeyHandler = function(e) {
      let tag = e.targetTag || (e.target && e.target.tagName ? String(e.target.tagName).toLowerCase() : "")
      if (e.key !== "Enter" || e.shiftKey || tag !== "textarea") return
      if (e.target && e.target.classList && e.target.classList.contains("sys-prompt-input")) return
      e.preventDefault()
      if (canSend()) sendMessage()
    }
    window.addEventListener("keydown", window.__aicKeyHandler, true)

    if (window.__aicResizeHandler) {
      window.removeEventListener("resize", window.__aicResizeHandler)
    }
    window.__aicResizeHandler = function() { syncViewport() }
    window.addEventListener("resize", window.__aicResizeHandler)
  } catch (e) {
    showSidebar = true
  }
}

function _onHide() {
  try {
    if (window.__aicKeyHandler) {
      window.removeEventListener("keydown", window.__aicKeyHandler, true)
      window.__aicKeyHandler = null
    }
    if (window.__aicResizeHandler) {
      window.removeEventListener("resize", window.__aicResizeHandler)
      window.__aicResizeHandler = null
    }
  } catch (e) {}
}

// ── Model Management ──

function loadModel() {
  if (modelLoading || modelLoaded) return
  loadError = ""
  if (typeof softn === "undefined" || !softn.ai || !softn.ai.model || typeof softn.ai.model.load !== "function") {
    loadError = "Local AI runtime is unavailable in this environment. Make sure AI permissions are allowed and WebGPU/WASM is supported."
    statusText = "Local AI unavailable"
    return
  }
  modelLoading = true
  statusText = "Downloading Qwen3-0.6B (~400 MB)…"
  try {
    softn.ai.model.load(MODEL_SPEC, { context: 2048 }, function(result) {
      if (!result || result.error || !result.modelHandle) {
        modelLoading = false
        modelLoaded = false
        let reason = result && result.error ? String(result.error) : "no model handle returned"
        loadError = "Could not load Qwen3-0.6B: " + reason
        statusText = "Download failed — tap Retry"
        pendingPrompt = ""
        return
      }
      modelHandle = result.modelHandle
      modelLoaded = true
      modelLoading = false
      loadError = ""
      statusText = "Qwen3-0.6B ready · on-device"
      if (pendingPrompt) {
        let queued = pendingPrompt
        pendingPrompt = ""
        inputText = queued
        sendMessage()
      }
    })
  } catch (err) {
    modelLoading = false
    modelLoaded = false
    loadError = "Could not start model download: " + String(err && err.message ? err.message : err)
    statusText = "Model load error"
    pendingPrompt = ""
  }
}

function unloadModel() {
  if (!modelLoaded || generating) return
  try {
    softn.ai.model.release(modelHandle, function() {
      modelLoaded = false
      modelHandle = ""
      statusText = "Model unloaded from memory"
    })
  } catch (e) {
    modelLoaded = false
    modelHandle = ""
    statusText = "Model unloaded"
  }
}

// ── Conversation CRUD ──

function newConversation() {
  let now = new Date().toISOString()
  db.create("conversations", {
    title: "New chat",
    createdAt: now,
    updatedAt: now
  })
  refreshConversations()
  if (conversations.length > 0) {
    activeConversationId = conversations[0].id
  }
  chatMessages = []
  inputText = ""
  confirmDeleteId = ""
  if (isMobile) showSidebar = false
}

function conversationExists(id) {
  let i = 0
  while (i < conversations.length) {
    if (conversations[i].id === id) return true
    i = i + 1
  }
  return false
}

function selectConversation(conv) {
  if (Date.now() < suppressSelectUntil) return
  let id = ""
  if (typeof conv === "string") {
    id = conv
  } else if (conv && conv.id) {
    id = conv.id
  }
  if (!id || id === activeConversationId) {
    if (isMobile) showSidebar = false
    return
  }
  if (!conversationExists(id)) return
  activeConversationId = id
  reloadChatMessages()
  confirmDeleteId = ""
  if (isMobile) showSidebar = false
  scrollChatToBottom()
}

function deleteConversation(id) {
  if (!id) return
  suppressSelectUntil = Date.now() + 150
  let allMsgs = db.query("messages")
  if (allMsgs) {
    let i = 0
    while (i < allMsgs.length) {
      if (allMsgs[i].data.conversationId === id) {
        db.delete(allMsgs[i].id)
      }
      i = i + 1
    }
  }
  db.delete(id)
  refreshConversations()
  confirmDeleteId = ""
  confirmDeleteTicks = 0
  if (activeConversationId === id) {
    if (conversations.length > 0) {
      activeConversationId = conversations[0].id
      reloadChatMessages()
    } else {
      activeConversationId = ""
      chatMessages = []
    }
  }
}

function clearActiveConversation() {
  if (!activeConversationId || generating) return
  let allMsgs = db.query("messages")
  if (allMsgs) {
    let i = 0
    while (i < allMsgs.length) {
      if (allMsgs[i].data.conversationId === activeConversationId) {
        db.delete(allMsgs[i].id)
      }
      i = i + 1
    }
  }
  db.update(activeConversationId, { title: "New chat", updatedAt: new Date().toISOString() })
  refreshConversations()
  reloadChatMessages()
}

function requestDelete(id) {
  if (!id) return
  suppressSelectUntil = Date.now() + 150
  if (confirmDeleteId === id) {
    deleteConversation(id)
    return
  }
  confirmDeleteId = id
  confirmDeleteTicks = 0
}

function tickUiTimers() {
  if (confirmDeleteId) {
    confirmDeleteTicks = confirmDeleteTicks + 1
    if (confirmDeleteTicks >= 4) {
      confirmDeleteId = ""
      confirmDeleteTicks = 0
    }
  }
  if (copiedMsgId) {
    copiedTicks = copiedTicks + 1
    if (copiedTicks >= 2) {
      copiedMsgId = ""
      copiedTicks = 0
    }
  }
}

function isConfirmingDelete(conv) {
  return !!conv && conv.id === confirmDeleteId
}

// ── Message Generation ──

function runGenerationForConversation(targetConvId) {
  if (!targetConvId || !modelLoaded || generating) return
  let allMsgs = db.query("messages") || []
  let thread = []
  let i = 0
  while (i < allMsgs.length) {
    if (allMsgs[i].data.conversationId === targetConvId) {
      thread.push(allMsgs[i])
    }
    i = i + 1
  }
  thread.sort(function(a, b) {
    let ta = a.data.timestamp || ""
    let tb = b.data.timestamp || ""
    if (ta < tb) return -1
    if (ta > tb) return 1
    return 0
  })

  let aiMessages = []
  let sys = systemPrompt.trim()
  let modeDirective = thinkingMode ? " /think" : " /no_think"
  if (sys) {
    aiMessages.push({ role: "system", content: sys + modeDirective })
  } else {
    aiMessages.push({ role: "system", content: "You are a helpful assistant." + modeDirective })
  }

  let j = 0
  while (j < thread.length) {
    let m = thread[j]
    if (m.data.content) {
      let cleanContent = m.data.role === "assistant" ? getMsgAnswer(m) : m.data.content
      aiMessages.push({ role: m.data.role, content: cleanContent })
    }
    j = j + 1
  }

  generating = true
  generatingConvId = targetConvId
  statusText = thinkingMode ? "Reasoning on device…" : "Generating reply…"
  scrollChatToBottom()

  try {
    softn.ai.model.generate(modelHandle, aiMessages, {
      max_new_tokens: maxTokens,
      temperature: temperature,
      top_p: topP,
      top_k: 20,
      do_sample: temperature > 0
    }, function(result) {
      generating = false
      generatingConvId = ""
      if (!result || result.error) {
        statusText = "Generation error: " + (result && result.error ? result.error : "unknown error")
        return
      }
      if (!conversationExists(targetConvId)) {
        statusText = "Qwen3-0.6B ready · on-device"
        return
      }
      let responseText = result.text || ""
      let respNow = new Date().toISOString()
      db.create("messages", {
        conversationId: targetConvId,
        role: "assistant",
        content: responseText,
        timestamp: respNow
      })
      db.update(targetConvId, { updatedAt: respNow })
      refreshConversations()
      if (activeConversationId === targetConvId) {
        reloadChatMessages()
        scrollChatToBottom()
      }
      statusText = "Qwen3-0.6B ready · on-device"
    })
  } catch (err) {
    generating = false
    generatingConvId = ""
    statusText = "Generation failed: " + String(err && err.message ? err.message : err)
  }
}

function sendMessage() {
  let trimmed = inputText ? inputText.trim() : ""
  if (!trimmed) return
  if (!modelLoaded) {
    pendingPrompt = trimmed
    inputText = ""
    loadModel()
    return
  }
  if (generating) return

  if (!activeConversationId) {
    newConversation()
  }
  let targetConvId = activeConversationId
  let now = new Date().toISOString()

  db.create("messages", {
    conversationId: targetConvId,
    role: "user",
    content: trimmed,
    timestamp: now
  })

  let convRows = db.query("conversations") || []
  let i = 0
  while (i < convRows.length) {
    if (convRows[i].id === targetConvId) {
      if (convRows[i].data.title === "New chat") {
        let title = trimmed.length > 42 ? trimmed.substring(0, 39) + "…" : trimmed
        db.update(targetConvId, { title: title, updatedAt: now })
      } else {
        db.update(targetConvId, { updatedAt: now })
      }
      break
    }
    i = i + 1
  }

  inputText = ""
  refreshConversations()
  reloadChatMessages()
  runGenerationForConversation(targetConvId)
}

function regenerateLastReply() {
  if (!modelLoaded || generating || !activeConversationId || chatMessages.length === 0) return
  let last = chatMessages[chatMessages.length - 1]
  if (last && last.data.role === "assistant") {
    db.delete(last.id)
    reloadChatMessages()
  }
  runGenerationForConversation(activeConversationId)
}

function isLastAssistantMsg(msg) {
  if (!msg || chatMessages.length === 0 || generating) return false
  let last = chatMessages[chatMessages.length - 1]
  return last.id === msg.id && msg.data.role === "assistant"
}

function startWithPrompt(text) {
  if (generating) return
  if (!modelLoaded) {
    pendingPrompt = text
    loadModel()
    return
  }
  inputText = text
  sendMessage()
}

function canSend() {
  let trimmed = inputText ? inputText.trim() : ""
  return trimmed.length > 0 && !generating && !modelLoading
}

function updateInput(val) {
  inputText = val
}

// ── Settings ──

function toggleSettings() {
  showSettings = !showSettings
}

function toggleThinkingMode() {
  thinkingMode = !thinkingMode
  if (thinkingMode && maxTokens < 512) {
    maxTokens = 512
    maxTokensText = "512"
  }
}

function setSystemPrompt(val) {
  systemPrompt = val
}

function clearSettingsError(field) {
  if (settingsErrorField === field) {
    settingsError = ""
    settingsErrorField = ""
  }
}

function setTemperature(val) {
  temperatureText = "" + val
  let n = parseFloat(val)
  if (isNaN(n) || n < 0 || n > 2) {
    settingsError = "Temperature must be 0–2 (using " + temperature + ")."
    settingsErrorField = "temperature"
    return
  }
  temperature = n
  clearSettingsError("temperature")
}

function setMaxTokens(val) {
  maxTokensText = "" + val
  let n = parseInt(val)
  if (isNaN(n) || n < 16 || n > 1536) {
    settingsError = "Max tokens must be 16–1536 (using " + maxTokens + ")."
    settingsErrorField = "maxTokens"
    return
  }
  maxTokens = n
  clearSettingsError("maxTokens")
}

function setTopP(val) {
  topPText = "" + val
  let n = parseFloat(val)
  if (isNaN(n) || n < 0 || n > 1) {
    settingsError = "Top-P must be 0–1 (using " + topP + ")."
    settingsErrorField = "topP"
    return
  }
  topP = n
  clearSettingsError("topP")
}

// ── UI Helpers ──

function toggleSidebar() {
  showSidebar = !showSidebar
}

function closeSidebar() {
  showSidebar = false
}

function isActiveConv(conv) {
  return conv.id === activeConversationId
}

function getConvTitle(conv) {
  return conv.data.title || "Untitled"
}

function getActiveTitle() {
  if (!activeConversationId) return "AI Chat"
  let i = 0
  while (i < conversations.length) {
    if (conversations[i].id === activeConversationId) {
      return conversations[i].data.title || "New chat"
    }
    i = i + 1
  }
  return "AI Chat"
}

function getConvTime(conv) {
  let ts = conv.data.updatedAt || conv.updatedAt || ""
  if (!ts) return ""
  try {
    let d = new Date(ts)
    let now = new Date()
    let diff = now.getTime() - d.getTime()
    let mins = Math.floor(diff / 60000)
    if (mins < 1) return "now"
    if (mins < 60) return mins + "m"
    let hrs = Math.floor(mins / 60)
    if (hrs < 24) return hrs + "h"
    let days = Math.floor(hrs / 24)
    if (days < 7) return days + "d"
    return (d.getMonth() + 1) + "/" + d.getDate()
  } catch (e) {
    return ""
  }
}

function getMsgTime(msg) {
  let ts = msg.data.timestamp || ""
  if (!ts) return ""
  try {
    let d = new Date(ts)
    let h = d.getHours()
    let m = d.getMinutes()
    let ampm = h >= 12 ? "PM" : "AM"
    h = h % 12
    if (h === 0) h = 12
    let mStr = m < 10 ? "0" + m : "" + m
    return h + ":" + mStr + " " + ampm
  } catch (e) {
    return ""
  }
}

function isUserMsg(msg) {
  return msg.data.role === "user"
}

function isAssistantMsg(msg) {
  return msg.data.role === "assistant"
}

function hasContent(msg) {
  return msg.data.content && msg.data.content !== ""
}
