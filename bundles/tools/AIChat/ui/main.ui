// main.ui - AI Chat
// Private on-device Qwen3-0.6B studio · responsive layout

<logic src="../logic/main.logic" />

<style>
@keyframes dot-bounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.45; }
  40% { transform: translateY(-4px); opacity: 1; }
}
@keyframes msg-in {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes sidebar-slide {
  from { transform: translateX(-100%); }
  to { transform: translateX(0); }
}
@keyframes backdrop-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes fade-up {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes dl-slide {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(300%); }
}

.msg-enter { animation: msg-in 0.2s ease-out; }
.dot-1 { animation: dot-bounce 1.3s ease-in-out infinite; }
.dot-2 { animation: dot-bounce 1.3s ease-in-out 0.18s infinite; }
.dot-3 { animation: dot-bounce 1.3s ease-in-out 0.36s infinite; }
.fade-up { animation: fade-up 0.35s ease-out; }
.fade-up-delay { animation: fade-up 0.35s 0.06s ease-out both; }
.fade-up-delay2 { animation: fade-up 0.35s 0.12s ease-out both; }

.sidebar {
  width: 268px;
  min-width: 268px;
  display: flex;
  flex-direction: column;
  border-right: 1px solid rgba(148, 163, 184, 0.12);
  background: #0b101b;
  z-index: 20;
}
.sidebar-item {
  padding: 0.5rem 0.65rem;
  border-radius: 10px;
  cursor: pointer;
  transition: background 120ms ease, border-color 120ms ease;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 2px;
  border: 1px solid transparent;
}
.sidebar-item:hover { background: rgba(148, 163, 184, 0.07); }
.sidebar-item .del-btn { opacity: 0.55; transition: opacity 120ms; }
.sidebar-item:hover .del-btn { opacity: 1; }
.sidebar-item .del-btn.del-btn-confirm { opacity: 1; }

.dl-bar {
  width: 100%;
  height: 5px;
  border-radius: 999px;
  background: rgba(148, 163, 184, 0.14);
  overflow: hidden;
}
.dl-bar-fill {
  width: 35%;
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, rgba(16,185,129,0.2), #10b981, #34d399, rgba(16,185,129,0.2));
  animation: dl-slide 1.5s ease-in-out infinite;
}

.bubble-user {
  background: linear-gradient(135deg, #059669, #047857);
  border: 1px solid rgba(52, 211, 153, 0.25);
  border-radius: 18px 18px 4px 18px;
  padding: 0.65rem 0.95rem;
  color: #ecfdf5;
  font-size: 0.85rem;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
  max-width: 76%;
  box-shadow: 0 4px 14px rgba(4, 120, 87, 0.22);
}
.bubble-ai {
  background: #111827;
  border: 1px solid rgba(148, 163, 184, 0.14);
  border-radius: 18px 18px 18px 4px;
  padding: 0.7rem 1rem;
  color: #e2e8f0;
  font-size: 0.85rem;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
  max-width: 100%;
}
.think-box {
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid rgba(16, 185, 129, 0.22);
  border-radius: 10px;
  padding: 0.55rem 0.75rem;
  margin-bottom: 0.45rem;
  color: #94a3b8;
  font-size: 0.75rem;
  line-height: 1.55;
  white-space: pre-wrap;
}

.input-container {
  background: #111827;
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 16px;
  display: flex;
  align-items: flex-end;
  gap: 0.375rem;
  padding: 0.35rem 0.45rem 0.35rem 0.75rem;
  transition: border-color 180ms, box-shadow 180ms;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
}
.input-container:focus-within {
  border-color: rgba(16, 185, 129, 0.55);
  box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.12);
}

.send-btn {
  width: 36px;
  height: 36px;
  border-radius: 11px;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  flex-shrink: 0;
  transition: transform 150ms ease, opacity 150ms ease;
  min-width: auto;
  padding: 0;
}
.send-btn:hover { transform: translateY(-1px); }

.suggestion-card {
  background: rgba(17, 24, 39, 0.85);
  border: 1px solid rgba(148, 163, 184, 0.14);
  border-radius: 14px;
  padding: 0.85rem 1rem;
  cursor: pointer;
  transition: all 160ms ease;
  flex: 1 1 200px;
  max-width: 240px;
}
.suggestion-card:hover {
  background: rgba(16, 185, 129, 0.09);
  border-color: rgba(16, 185, 129, 0.38);
  transform: translateY(-2px);
}

.scroll-thin::-webkit-scrollbar { width: 5px; }
.scroll-thin::-webkit-scrollbar-track { background: transparent; }
.scroll-thin::-webkit-scrollbar-thumb { background: rgba(148, 163, 184, 0.18); border-radius: 4px; }
.scroll-thin::-webkit-scrollbar-thumb:hover { background: rgba(148, 163, 184, 0.32); }

.backdrop {
  position: absolute;
  inset: 0;
  background: rgba(2, 6, 23, 0.65);
  backdrop-filter: blur(2px);
  z-index: 15;
  animation: backdrop-in 0.15s ease-out;
}

@media (max-width: 679px) {
  .sidebar {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 282px;
    min-width: 282px;
    animation: sidebar-slide 0.2s ease-out;
    box-shadow: 8px 0 32px rgba(0, 0, 0, 0.55);
  }
  .bubble-user { max-width: 88%; }
  .suggestion-card {
    flex: 1 1 145px;
    max-width: none;
    padding: 0.75rem 0.85rem;
  }
}
</style>

<Loop interval={1000} running={confirmDeleteId !== "" || copiedMsgId !== ""} @tick={tickUiTimers} />

<App theme="dark">
  <Box style={{
    display: "flex",
    width: "100%",
    height: "100%",
    overflow: "hidden",
    background: "#070b14",
    color: "#e2e8f0",
    position: "relative",
    fontFamily: "-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, system-ui, sans-serif"
  }}>

    <Box if={showSidebar && isMobile} className="backdrop" @click={closeSidebar} />

    // ═══════ SIDEBAR ═══════
    <Box if={showSidebar} className="sidebar">
      <Box style={{
        padding: "0.8rem 0.85rem",
        display: "flex",
        alignItems: "center",
        gap: "0.625rem",
        borderBottom: "1px solid rgba(148, 163, 184, 0.1)"
      }}>
        <Box style={{
          width: "32px",
          height: "32px",
          borderRadius: "10px",
          background: "linear-gradient(135deg, #10b981, #047857)",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          flexShrink: 0,
          boxShadow: "0 4px 12px rgba(16, 185, 129, 0.25)"
        }}>
          <Text style={{ color: "#fff", fontSize: "0.72rem", fontWeight: 700 }}>AI</Text>
        </Box>
        <Box style={{ flex: 1, minWidth: 0 }}>
          <Text style={{ fontSize: "0.875rem", fontWeight: 600, color: "#f1f5f9", display: "block" }}>AI Chat</Text>
          <Text style={{ fontSize: "0.65rem", color: "#94a3b8", display: "block" }}>Qwen3-0.6B · Local</Text>
        </Box>
        <Button if={isMobile} variant=ghost @click={closeSidebar} ariaLabel="Close sidebar" title="Close" style={{
          padding: "5px",
          color: "#94a3b8",
          minWidth: "auto"
        }}><Icon name="close" size={16} color="#94a3b8" /></Button>
      </Box>

      <Box style={{ padding: "0.625rem 0.7rem 0.4rem", display: "flex", flexDirection: "column", gap: "0.45rem" }}>
        <Button @click={newConversation} style={{
          width: "100%",
          background: "rgba(16, 185, 129, 0.14)",
          color: "#34d399",
          border: "1px solid rgba(16, 185, 129, 0.3)",
          borderRadius: "10px",
          padding: "0.52rem",
          fontSize: "0.8125rem",
          fontWeight: 600,
          cursor: "pointer"
        }}>+ New Chat</Button>

        <Input
          if={conversations.length > 2}
          value={searchQuery}
          @change={setSearchQuery}
          placeholder="Filter chats…"
          style={{
            width: "100%",
            background: "#111827",
            border: "1px solid rgba(148, 163, 184, 0.16)",
            borderRadius: "8px",
            padding: "0.38rem 0.6rem",
            fontSize: "0.75rem",
            color: "#e2e8f0"
          }}
        />
      </Box>

      <Box className="scroll-thin" style={{
        flex: 1,
        overflowY: "auto",
        padding: "0.25rem 0.55rem"
      }}>
        #each (conv in filteredConversations)
          <Box className="sidebar-item" @click={selectConversation(conv)} style={{
            background: isActiveConv(conv) ? "rgba(16, 185, 129, 0.11)" : "transparent",
            borderColor: isActiveConv(conv) ? "rgba(16, 185, 129, 0.24)" : "transparent"
          }}>
            <Box style={{
              width: "6px",
              height: "6px",
              borderRadius: "50%",
              background: isActiveConv(conv) ? "#10b981" : "rgba(148, 163, 184, 0.3)",
              flexShrink: 0
            }} />
            <Box style={{ flex: 1, minWidth: 0 }}>
              <Text style={{
                fontSize: "0.8125rem",
                color: isActiveConv(conv) ? "#ecfdf5" : "#cbd5e1",
                whiteSpace: "nowrap",
                overflow: "hidden",
                textOverflow: "ellipsis",
                fontWeight: isActiveConv(conv) ? 600 : 400,
                display: "block"
              }}>{getConvTitle(conv)}</Text>
            </Box>
            <Text style={{
              fontSize: "0.65rem",
              color: "#64748b",
              flexShrink: 0,
              whiteSpace: "nowrap"
            }}>{getConvTime(conv)}</Text>
            <Button className={isConfirmingDelete(conv) ? "del-btn del-btn-confirm" : "del-btn"} variant=ghost @click={requestDelete(conv.id)} ariaLabel={isConfirmingDelete(conv) ? "Confirm delete" : "Delete conversation"} title={isConfirmingDelete(conv) ? "Tap again to delete" : "Delete conversation"} style={{
              padding: "3px 6px",
              fontSize: "0.65rem",
              fontWeight: 600,
              color: isConfirmingDelete(conv) ? "#fecaca" : "#94a3b8",
              background: isConfirmingDelete(conv) ? "rgba(239, 68, 68, 0.24)" : "transparent",
              borderRadius: "6px",
              flexShrink: 0,
              minWidth: "auto",
              display: "flex",
              alignItems: "center"
            }}>
              <Icon if={!isConfirmingDelete(conv)} name="close" size={12} color="#94a3b8" />
              <Text if={isConfirmingDelete(conv)} style={{ fontSize: "0.65rem", color: "#fecaca", fontWeight: 600, whiteSpace: "nowrap" }}>Delete?</Text>
            </Button>
          </Box>
        #empty
          <Box style={{ padding: "2.25rem 1rem", textAlign: "center" }}>
            <Text style={{ fontSize: "0.78rem", color: "#64748b", lineHeight: 1.6 }}>
              {conversations.length > 0 ? "No matching chats" : "No conversations yet"}
            </Text>
          </Box>
        #end
      </Box>

      // Model & Generation Settings
      <Box style={{ borderTop: "1px solid rgba(148, 163, 184, 0.1)", background: "#090e18" }}>
        <Button variant=ghost @click={toggleSettings} style={{
          width: "100%",
          textAlign: "left",
          padding: "0.6rem 0.85rem",
          fontSize: "0.75rem",
          fontWeight: 500,
          color: "#cbd5e1",
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between"
        }}>
          <Text style={{ fontSize: "0.75rem", color: "#cbd5e1" }}>{(showSettings ? "▾ " : "▸ ") + "Model Settings"}</Text>
          <Text style={{ fontSize: "0.65rem", color: "#64748b" }}>{"T=" + temperature}</Text>
        </Button>

        <Box if={showSettings} style={{ padding: "0.15rem 0.85rem 0.8rem" }}>
          <Stack direction=vertical gap=xs>
            <Stack direction=horizontal gap=xs align=center justify="space-between">
              <Text style={{ fontSize: "0.72rem", color: "#94a3b8" }}>Reasoning (&lt;think&gt;)</Text>
              <Button size=xs variant=ghost @click={toggleThinkingMode} style={{
                padding: "3px 9px",
                borderRadius: "999px",
                fontSize: "0.68rem",
                fontWeight: 600,
                background: thinkingMode ? "rgba(16, 185, 129, 0.2)" : "rgba(148, 163, 184, 0.12)",
                color: thinkingMode ? "#34d399" : "#94a3b8",
                border: thinkingMode ? "1px solid rgba(16, 185, 129, 0.4)" : "1px solid rgba(148, 163, 184, 0.2)"
              }}>{thinkingMode ? "On" : "Off (Fast)"}</Button>
            </Stack>

            <Stack direction=horizontal gap=xs align=center justify="space-between">
              <Text style={{ fontSize: "0.72rem", color: "#94a3b8" }}>Temperature (0–2)</Text>
              <Input type="number" min={0} max={2} step={0.1} value={temperatureText} @change={setTemperature} style={{
                width: "68px", height: "auto", background: "#111827",
                border: settingsErrorField === "temperature" ? "1px solid #f87171" : "1px solid rgba(148, 163, 184, 0.2)",
                color: "#f1f5f9", borderRadius: "6px", padding: "3px 6px", fontSize: "0.72rem", textAlign: "center"
              }} />
            </Stack>

            <Stack direction=horizontal gap=xs align=center justify="space-between">
              <Text style={{ fontSize: "0.72rem", color: "#94a3b8" }}>Max tokens (16–1536)</Text>
              <Input type="number" min={16} max={1536} step={32} value={maxTokensText} @change={setMaxTokens} style={{
                width: "68px", height: "auto", background: "#111827",
                border: settingsErrorField === "maxTokens" ? "1px solid #f87171" : "1px solid rgba(148, 163, 184, 0.2)",
                color: "#f1f5f9", borderRadius: "6px", padding: "3px 6px", fontSize: "0.72rem", textAlign: "center"
              }} />
            </Stack>

            <Stack direction=horizontal gap=xs align=center justify="space-between">
              <Text style={{ fontSize: "0.72rem", color: "#94a3b8" }}>Top-P (0–1)</Text>
              <Input type="number" min={0} max={1} step={0.05} value={topPText} @change={setTopP} style={{
                width: "68px", height: "auto", background: "#111827",
                border: settingsErrorField === "topP" ? "1px solid #f87171" : "1px solid rgba(148, 163, 184, 0.2)",
                color: "#f1f5f9", borderRadius: "6px", padding: "3px 6px", fontSize: "0.72rem", textAlign: "center"
              }} />
            </Stack>

            <Box style={{ marginTop: "0.25rem" }}>
              <Text style={{ fontSize: "0.68rem", color: "#94a3b8", display: "block", marginBottom: "0.25rem" }}>System prompt</Text>
              <TextArea
                className="sys-prompt-input"
                value={systemPrompt}
                @change={setSystemPrompt}
                rows={2}
                style={{
                  width: "100%",
                  background: "#111827",
                  border: "1px solid rgba(148, 163, 184, 0.2)",
                  borderRadius: "6px",
                  color: "#e2e8f0",
                  fontSize: "0.72rem",
                  padding: "0.35rem 0.5rem",
                  lineHeight: 1.4
                }}
              />
            </Box>

            <Text if={settingsError} style={{ fontSize: "0.68rem", color: "#fca5a5", lineHeight: 1.4 }}>{settingsError}</Text>
          </Stack>
        </Box>
      </Box>
    </Box>

    // ═══════ MAIN CHAT AREA ═══════
    <Box style={{
      flex: 1,
      display: "flex",
      flexDirection: "column",
      minWidth: 0,
      overflow: "hidden"
    }}>

      // ── Top bar ──
      <Box style={{
        display: "flex",
        alignItems: "center",
        justifyContent: "space-between",
        padding: "0.45rem 0.75rem",
        borderBottom: "1px solid rgba(148, 163, 184, 0.1)",
        background: "#0b101b",
        flexShrink: 0,
        minHeight: "46px",
        gap: "0.5rem"
      }}>
        <Stack direction=horizontal gap=sm align=center style={{ flex: 1, minWidth: 0 }}>
          <Button variant=ghost @click={toggleSidebar} ariaLabel="Toggle sidebar" title="Conversations" style={{
            padding: "6px",
            minWidth: "34px",
            height: "34px",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            borderRadius: "8px"
          }}>
            <Box style={{
              width: "16px",
              height: "12px",
              display: "flex",
              flexDirection: "column",
              justifyContent: "space-between"
            }}>
              <Box style={{ height: "1.75px", background: "#cbd5e1", borderRadius: "1px" }} />
              <Box style={{ height: "1.75px", background: "#cbd5e1", borderRadius: "1px", width: "72%" }} />
              <Box style={{ height: "1.75px", background: "#cbd5e1", borderRadius: "1px" }} />
            </Box>
          </Button>

          <Box style={{
            width: "8px", height: "8px", borderRadius: "50%", flexShrink: 0,
            background: modelLoaded ? "#10b981" : modelLoading ? "#f59e0b" : loadError ? "#ef4444" : "#64748b",
            boxShadow: modelLoaded ? "0 0 8px rgba(16, 185, 129, 0.5)" : "none"
          }} />
          <Text style={{
            fontSize: "0.75rem",
            color: loadError ? "#fca5a5" : "#94a3b8",
            whiteSpace: "nowrap",
            overflow: "hidden",
            textOverflow: "ellipsis"
          }}>{statusText}</Text>
        </Stack>

        <Box style={{ display: "flex", alignItems: "center", gap: "0.4rem", flexShrink: 0 }}>
          <Button if={chatMessages.length > 0 && !generating} variant=ghost @click={clearActiveConversation} title="Clear messages in this chat" style={{
            fontSize: "0.7rem", color: "#94a3b8", padding: "0.3rem 0.55rem"
          }}>Clear</Button>

          <Button if={!modelLoaded && !modelLoading} @click={loadModel} style={{
            background: "linear-gradient(135deg, #10b981, #059669)",
            color: "#fff", border: "none", borderRadius: "8px",
            padding: "0.35rem 0.8rem", fontSize: "0.72rem", fontWeight: 600
          }}>{loadError ? "Retry download" : "Download & start"}</Button>

          <Button if={modelLoading} style={{
            background: "rgba(245, 158, 11, 0.12)", color: "#fbbf24",
            border: "1px solid rgba(245, 158, 11, 0.3)", borderRadius: "8px",
            padding: "0.35rem 0.8rem", fontSize: "0.72rem", cursor: "wait"
          }}>Downloading…</Button>

          <Button if={modelLoaded} disabled={generating} variant=ghost @click={unloadModel} style={{
            fontSize: "0.7rem", color: "#94a3b8", padding: "0.3rem 0.55rem",
            opacity: generating ? 0.45 : 1
          }}>Unload</Button>
        </Box>
      </Box>

      // ── Messages ──
      <Box className="scroll-thin chat-scroll-area" style={{
        flex: 1, overflowY: "auto", padding: "0.85rem 0", minHeight: 0
      }}>

        // ─── Welcome state ───
        <Box if={chatMessages.length === 0} style={{
          display: "flex", flexDirection: "column", alignItems: "center",
          justifyContent: "center", minHeight: "100%", gap: "1.25rem", padding: "1.5rem 1.25rem"
        }}>
          <Box className="fade-up" style={{
            width: "68px", height: "68px", borderRadius: "20px",
            background: "linear-gradient(135deg, #10b981 0%, #059669 55%, #047857 100%)",
            display: "flex", alignItems: "center", justifyContent: "center",
            boxShadow: "0 12px 36px rgba(16, 185, 129, 0.25), 0 0 0 1px rgba(52, 211, 153, 0.2)"
          }}>
            <Icon name="chat" size={32} color="#fff" />
          </Box>

          <Stack className="fade-up-delay" direction=vertical gap=xs align=center>
            <Text style={{ fontSize: "1.45rem", fontWeight: 700, color: "#f8fafc", letterSpacing: "-0.02em" }}>Chat privately on your device</Text>
            <Text style={{
              fontSize: "0.84rem", color: "#94a3b8", textAlign: "center",
              maxWidth: "430px", lineHeight: 1.65
            }}>
              Qwen3-0.6B (~400 MB GGUF) downloads once from Hugging Face and runs locally via WebGPU/WASM. Every prompt and reply stays on this machine.
            </Text>
          </Stack>

          <Box if={loadError !== ""} style={{
            maxWidth: "460px", width: "100%",
            background: "rgba(239, 68, 68, 0.1)",
            border: "1px solid rgba(248, 113, 113, 0.35)",
            borderRadius: "12px",
            padding: "0.75rem 1rem"
          }}>
            <Text style={{ fontSize: "0.78rem", color: "#fecaca", lineHeight: 1.55, display: "block" }}>{loadError}</Text>
          </Box>

          <Box if={!modelLoaded && !modelLoading} className="fade-up-delay2">
            <Button @click={loadModel} style={{
              background: "linear-gradient(135deg, #10b981, #059669)",
              color: "#fff", border: "none", borderRadius: "12px",
              padding: "0.65rem 1.65rem", fontSize: "0.875rem", fontWeight: 600,
              boxShadow: "0 6px 24px rgba(16, 185, 129, 0.28)"
            }}>{loadError ? "Retry model download" : "Download model & start"}</Button>
          </Box>

          <Box if={modelLoading} className="fade-up-delay2" style={{
            display: "flex", flexDirection: "column", alignItems: "center", gap: "0.55rem",
            width: "min(340px, 100%)"
          }}>
            <Box className="dl-bar">
              <Box className="dl-bar-fill" />
            </Box>
            <Text style={{ fontSize: "0.8125rem", color: "#6ee7b7", textAlign: "center", fontWeight: 500 }}>
              {pendingPrompt ? "Downloading model, then sending your prompt…" : "Downloading Qwen3-0.6B…"}
            </Text>
            <Text style={{ fontSize: "0.72rem", color: "#94a3b8", textAlign: "center", lineHeight: 1.5 }}>
              Cached by your browser after the first download so future launches start right away.
            </Text>
          </Box>

          // Starter prompts — clickable anytime (auto-loads model if needed)
          <Box if={!modelLoading} className="fade-up-delay2" style={{
            display: "flex", flexWrap: "wrap", gap: "0.625rem", justifyContent: "center",
            maxWidth: "520px", width: "100%", marginTop: "0.25rem"
          }}>
            <Box className="suggestion-card" @click={startWithPrompt("Explain how WebGPU speeds up local AI models in plain English.")}>
              <Text style={{ fontSize: "0.72rem", color: "#34d399", fontWeight: 600, marginBottom: "0.25rem", display: "block" }}>Explain</Text>
              <Text style={{ fontSize: "0.78rem", color: "#cbd5e1", lineHeight: 1.45, display: "block" }}>How WebGPU speeds up local AI</Text>
            </Box>
            <Box className="suggestion-card" @click={startWithPrompt("Write a crisp haiku about coding late at night.")}>
              <Text style={{ fontSize: "0.72rem", color: "#34d399", fontWeight: 600, marginBottom: "0.25rem", display: "block" }}>Create</Text>
              <Text style={{ fontSize: "0.78rem", color: "#cbd5e1", lineHeight: 1.45, display: "block" }}>A haiku about late-night coding</Text>
            </Box>
            <Box className="suggestion-card" @click={startWithPrompt("Give me a 3-step checklist for debugging tricky async race conditions.")}>
              <Text style={{ fontSize: "0.72rem", color: "#34d399", fontWeight: 600, marginBottom: "0.25rem", display: "block" }}>Debug</Text>
              <Text style={{ fontSize: "0.78rem", color: "#cbd5e1", lineHeight: 1.45, display: "block" }}>3-step async race checklist</Text>
            </Box>
            <Box className="suggestion-card" @click={startWithPrompt("Share 4 surprising facts about deep-sea bioluminescence.")}>
              <Text style={{ fontSize: "0.72rem", color: "#34d399", fontWeight: 600, marginBottom: "0.25rem", display: "block" }}>Discover</Text>
              <Text style={{ fontSize: "0.78rem", color: "#cbd5e1", lineHeight: 1.45, display: "block" }}>Deep-sea bioluminescence facts</Text>
            </Box>
          </Box>
        </Box>

        // ─── Chat messages ───
        <Box if={chatMessages.length > 0} style={{
          display: "flex", flexDirection: "column", gap: "0.4rem", maxWidth: "860px", margin: "0 auto", width: "100%"
        }}>
          #each (msg in chatMessages)
            <Box if={isUserMsg(msg)} className="msg-enter" style={{
              display: "flex", flexDirection: "column", alignItems: "flex-end",
              padding: "0.25rem 1rem 0.25rem 2.25rem"
            }}>
              <Box if={hasContent(msg)} className="bubble-user">{msg.data.content}</Box>
              <Text style={{
                fontSize: "0.65rem", color: "#64748b", marginTop: "0.22rem", paddingRight: "0.2rem"
              }}>{getMsgTime(msg)}</Text>
            </Box>

            <Box if={isAssistantMsg(msg)} className="msg-enter" style={{
              display: "flex", gap: "0.6rem", alignItems: "flex-start",
              padding: "0.35rem 1.5rem 0.35rem 1rem"
            }}>
              <Box style={{
                width: "28px", height: "28px", borderRadius: "9px",
                background: "linear-gradient(135deg, #10b981, #059669)",
                display: "flex", alignItems: "center", justifyContent: "center",
                flexShrink: 0, marginTop: "2px"
              }}>
                <Text style={{ color: "#fff", fontSize: "0.62rem", fontWeight: 700 }}>Q3</Text>
              </Box>

              <Box style={{ minWidth: 0, maxWidth: "82%" }}>
                <Box if={hasMsgThink(msg)} style={{ marginBottom: "0.3rem" }}>
                  <Button variant=ghost size=xs @click={toggleThink(msg.id)} style={{
                    fontSize: "0.68rem", color: "#34d399", padding: "2px 8px",
                    background: "rgba(16, 185, 129, 0.1)", borderRadius: "999px",
                    border: "1px solid rgba(16, 185, 129, 0.25)"
                  }}>
                    {(isThinkOpen(msg) ? "▾ Hide reasoning" : "▸ Show reasoning")}
                  </Button>
                </Box>

                <Box if={hasMsgThink(msg) && isThinkOpen(msg)} className="think-box">
                  {getMsgThink(msg)}
                </Box>

                <Box className="bubble-ai">{getMsgAnswer(msg)}</Box>

                <Box style={{ display: "flex", alignItems: "center", gap: "0.6rem", marginTop: "0.25rem", paddingLeft: "0.2rem" }}>
                  <Text style={{ fontSize: "0.65rem", color: "#64748b" }}>{getMsgTime(msg)}</Text>
                  <Button variant=ghost size=xs @click={copyReply(msg.id, msg)} style={{
                    fontSize: "0.68rem", padding: "1px 6px",
                    color: copiedMsgId === msg.id ? "#34d399" : "#94a3b8",
                    minHeight: "auto", height: "auto"
                  }}>
                    {copiedMsgId === msg.id ? "✓ Copied" : "Copy"}
                  </Button>
                  <Button if={isLastAssistantMsg(msg) && modelLoaded} variant=ghost size=xs @click={regenerateLastReply} style={{
                    fontSize: "0.68rem", padding: "1px 6px", color: "#94a3b8",
                    minHeight: "auto", height: "auto"
                  }}>
                    Regenerate
                  </Button>
                </Box>
              </Box>
            </Box>
          #end

          <Box if={generating && generatingConvId === activeConversationId} style={{
            display: "flex", gap: "0.6rem", alignItems: "flex-start",
            padding: "0.35rem 1.5rem 0.35rem 1rem"
          }}>
            <Box style={{
              width: "28px", height: "28px", borderRadius: "9px",
              background: "linear-gradient(135deg, #10b981, #059669)",
              display: "flex", alignItems: "center", justifyContent: "center",
              flexShrink: 0, marginTop: "2px"
            }}>
              <Text style={{ color: "#fff", fontSize: "0.62rem", fontWeight: 700 }}>Q3</Text>
            </Box>
            <Box className="bubble-ai" style={{
              display: "flex", gap: "6px", alignItems: "center", padding: "0.75rem 1rem"
            }}>
              <Box className="dot-1" style={{ width: "6px", height: "6px", borderRadius: "50%", background: "#34d399" }} />
              <Box className="dot-2" style={{ width: "6px", height: "6px", borderRadius: "50%", background: "#34d399" }} />
              <Box className="dot-3" style={{ width: "6px", height: "6px", borderRadius: "50%", background: "#34d399" }} />
              <Text style={{ fontSize: "0.72rem", color: "#94a3b8", marginLeft: "0.25rem" }}>
                {thinkingMode ? "Reasoning…" : "Thinking…"}
              </Text>
            </Box>
          </Box>
        </Box>
      </Box>

      // ── Input area ──
      <Box style={{
        padding: "0.55rem 0.9rem 0.75rem", flexShrink: 0, maxWidth: "860px", width: "100%", margin: "0 auto", boxSizing: "border-box"
      }}>
        <Box className="input-container">
          <Box style={{ flex: 1, minWidth: 0 }}>
            <TextArea
              value={inputText}
              @change={updateInput}
              placeholder={modelLoaded ? "Ask anything… (Enter sends, Shift+Enter for new line)" : "Type a prompt to auto-download Qwen3-0.6B and send…"}
              rows=1
              autoResize={true}
              fullWidth={true}
              minHeight="36px"
              maxHeight="120px"
              resize="none"
              style={{
                background: "transparent", border: "none",
                color: "#f1f5f9", fontSize: "0.85rem",
                padding: "0.45rem 0.25rem", lineHeight: 1.5, outline: "none",
                boxShadow: "none", width: "100%"
              }}
            />
          </Box>

          <Button variant=ghost size=xs @click={toggleThinkingMode} title="Toggle Qwen3 step-by-step reasoning" style={{
            height: "32px",
            marginBottom: "2px",
            padding: "0 0.55rem",
            borderRadius: "9px",
            fontSize: "0.68rem",
            fontWeight: 600,
            background: thinkingMode ? "rgba(16, 185, 129, 0.16)" : "rgba(148, 163, 184, 0.08)",
            color: thinkingMode ? "#34d399" : "#94a3b8",
            border: thinkingMode ? "1px solid rgba(16, 185, 129, 0.35)" : "1px solid rgba(148, 163, 184, 0.14)",
            flexShrink: 0
          }}>
            {thinkingMode ? "Think: ON" : "Fast"}
          </Button>

          <Button className="send-btn" @click={sendMessage} title="Send message" style={{
            background: canSend() ? "linear-gradient(135deg, #10b981, #059669)" : "rgba(148, 163, 184, 0.1)",
            cursor: generating ? "wait" : "pointer",
            opacity: generating ? 0.5 : 1,
            boxShadow: canSend() ? "0 3px 10px rgba(16, 185, 129, 0.3)" : "none"
          }}>
            <Icon name="send" size=16 color={canSend() ? "#fff" : "#64748b"} />
          </Button>
        </Box>

        <Text style={{
          fontSize: "0.65rem", color: "#64748b", textAlign: "center", marginTop: "0.45rem", display: "block"
        }}>100% private · Runs locally in your browser via WebGPU / WASM</Text>
      </Box>
    </Box>
  </Box>
</App>
