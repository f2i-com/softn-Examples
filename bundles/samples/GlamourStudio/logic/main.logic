  let sidebarCollapsed = false
  let showAddModal = false
  let showAddClientModal = false
  let showAddStaffModal = false
  let showAddServiceModal = false
  let showEditClientModal = false
  let editingClient = null
  let showEditStaffModal = false
  let editingStaff = null
  let showEditServiceModal = false
  let editingService = null
  let showEditAppointmentModal = false
  let editingAppointment = null
  let showDataModal = false
  let exportedData = ""
  let copiedExport = false
  let darkMode = (function() { try { var v = localStorage.getItem("softn-theme-preference"); if (v === "light") return false; if (v === "dark") return true; } catch(e) {} return true; })()
  let confirmClearData = false
  let importData = ""
  let showSyncModal = false
  let syncRoom = ""
  let syncConnected = false
  let syncConnecting = false
  let syncPeers = 0
  let copiedRoom = false

  // ── Beauty & Lighting Studio state (works immediately without webcam) ──
  let studioMuse = "balayage"
  let studioPreset = "golden"
  let studioExposure = 104
  let studioWarmth = 18
  let studioContrast = 106
  let studioGlow = 35
  let studioVignette = 28
  let studioCameraOn = false
  let studioCameraAvailable = false
  let studioCapturedUrl = ""
  let studioToast = ""

  // Field lists for the appointment forms, rebuilt each time a form opens
  let appointmentFormFields = []
  let appointmentEditFields = []

  // Line icons drawn with currentColor
  let iconOpen = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="100%" height="100%" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'
  let iconCalendar = iconOpen + '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>'
  let iconUsers = iconOpen + '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>'
  let iconScissors = iconOpen + '<circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>'
  let iconList = iconOpen + '<line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>'
  let iconSparkles = iconOpen + '<path d="M12 3l1.9 5.8L20 10.7l-6.1 1.9L12 18.4l-1.9-5.8L4 10.7l6.1-1.9L12 3z"/><path d="M19 15l.9 2.6L22.5 18.5l-2.6.9L19 22l-.9-2.6-2.6-.9 2.6-.9L19 15z"/></svg>'
  let iconCamera = iconOpen + '<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>'
  let iconSun = iconOpen + '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>'
  let iconMoon = iconOpen + '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>'

  // App icon as inline SVG data URL
  let appIconUrl = "data:image/svg+xml," + encodeURIComponent("<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100' viewBox='0 0 100 100'><defs><linearGradient id='bg-grad' x1='0%' y1='0%' x2='100%' y2='100%'><stop offset='0%' stop-color='#b08d60'/><stop offset='100%' stop-color='#9a7a52'/></linearGradient><mask id='g-mask'><rect width='100' height='100' fill='black'/><circle cx='50' cy='50' r='34' fill='white'/><circle cx='50' cy='50' r='20' fill='black'/><path d='M 50 50 L 75 -10 L 110 -10 L 110 44 L 40 44 Z' fill='black'/><rect x='46' y='44' width='40' height='14' fill='white'/><circle cx='50' cy='50' r='68' stroke='black' stroke-width='68' fill='none'/></mask></defs><rect width='100' height='100' rx='22' fill='url(#bg-grad)'/><rect width='100' height='100' fill='white' mask='url(#g-mask)'/></svg>")

  // Theme colors — warm luxury palette
  function getBgColor() {
    return darkMode ? "#0c0a09" : "#faf9f7"
  }

  function getSidebarBg() {
    return darkMode ? "#211f1d" : "#ffffff"
  }

  function getCardBg() {
    return darkMode ? "#1c1917" : "#ffffff"
  }

  function getRaisedBg() {
    return darkMode ? "#292524" : "#f5f5f4"
  }

  function getBorderColor() {
    return darkMode ? "rgba(214, 191, 167, 0.10)" : "rgba(28, 25, 23, 0.08)"
  }

  function getSubtleBorder() {
    return darkMode ? "rgba(214, 191, 167, 0.06)" : "rgba(28, 25, 23, 0.05)"
  }

  function getTextColor() {
    return darkMode ? "#faf9f7" : "#1c1917"
  }

  function getMutedColor() {
    return darkMode ? "#a8a29e" : "#78716c"
  }

  function getHeadingColor() {
    return darkMode ? "#faf9f7" : "#1c1917"
  }

  function getAccentColor() {
    return darkMode ? "#d4a574" : "#b08d60"
  }

  function getAccentHover() {
    return darkMode ? "#c2956a" : "#9a7a52"
  }

  function getAccentMuted() {
    return darkMode ? "rgba(212, 165, 116, 0.15)" : "rgba(176, 141, 96, 0.12)"
  }

  function getGreeting() {
    let hour = new Date().getHours()
    if (hour < 12) return "Good morning"
    if (hour < 17) return "Good afternoon"
    return "Good evening"
  }

  function logActivity(title, description, status, actor) {
    try {
      db.create("activity", {
        title: title,
        description: description,
        time: new Date().toISOString(),
        status: status || "info",
        actor: actor || "Front desk"
      })
    } catch (e) {}
  }

  function pickField(name, label, records, key, placeholder) {
    let options = []
    let list = records || []
    for (let i = 0; i < list.length; i = i + 1) {
      let value = list[i].data ? list[i].data[key] : list[i][key]
      if (value) { options.push({ value: value, label: value }) }
    }
    if (options.length === 0) {
      return { name: name, type: "text", label: label, required: true, placeholder: placeholder }
    }
    return { name: name, type: "select", label: label, required: true, options: options }
  }

  function buildAppointmentFields() {
    let fields = [
      pickField("client", "Client", db.query("clients"), "name", "Client's full name"),
      pickField("stylist", "Stylist", db.query("staff"), "name", "Stylist's full name"),
      pickField("service", "Service", db.query("services"), "name", "Service name"),
      {
        name: "time",
        type: "text",
        label: "Time",
        required: true,
        placeholder: "HH:MM, e.g. 14:30",
        pattern: "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
        helpText: "24-hour clock"
      }
    ]
    fields.push({
      name: "status",
      type: "select",
      label: "Status",
      defaultValue: "scheduled",
      options: [
        { value: "scheduled", label: "Scheduled" },
        { value: "in-progress", label: "In progress" },
        { value: "completed", label: "Completed" }
      ]
    })
    fields.push({ name: "price", type: "number", label: "Price ($)", min: 0, defaultValue: 0, placeholder: "0" })
    return fields
  }

  function toggleTheme() {
    darkMode = !darkMode
    try { localStorage.setItem("softn-theme-preference", darkMode ? "dark" : "light") } catch(e) {}
  }

  function navigate(page) {
    currentPage = page
    selectedItem = null
    if (page !== "studio") {
      studioCameraOn = false
    }
  }

  function toggleSidebar() {
    sidebarCollapsed = !sidebarCollapsed
  }

  function selectItem(item) {
    selectedItem = item
  }

  function clearSelection() {
    selectedItem = null
  }

  function viewAppointment(item) {
    selectedItem = item
    currentPage = "appointments"
    studioCameraOn = false
  }

  function viewStaff(item) {
    selectedItem = item
    currentPage = "staff"
    studioCameraOn = false
  }

  function viewClient(item) {
    selectedItem = item
    currentPage = "clients"
    studioCameraOn = false
  }

  function viewService(item) {
    selectedItem = item
    currentPage = "services"
    studioCameraOn = false
  }

  // CRUD handlers using XDB
  function addClient(data) {
    db.create("clients", {
      name: data.name,
      email: data.email,
      phone: data.phone,
      visits: 0,
      totalSpent: 0,
      vip: false
    })
    logActivity("New client added", data.name + " was added as a client", "success")
    showAddClientModal = false
  }

  function editClient(row) {
    editingClient = row
    showEditClientModal = true
  }

  function saveEditClient(data) {
    if (editingClient) {
      let updated = {
        name: data.name || editingClient.data.name,
        email: data.email || editingClient.data.email,
        phone: data.phone !== undefined ? data.phone : editingClient.data.phone,
        visits: editingClient.data.visits || 0,
        totalSpent: editingClient.data.totalSpent || 0,
        vip: !!editingClient.data.vip
      }
      db.update(editingClient.id, updated)
      if (selectedItem && selectedItem.id === editingClient.id) {
        selectedItem = { id: editingClient.id, data: updated }
      }
      logActivity("Client updated", updated.name + " was updated", "info")
    }
    showEditClientModal = false
    editingClient = null
  }

  function closeEditClientModal() {
    showEditClientModal = false
    editingClient = null
  }

  function deleteClient(row) {
    if (!row) return
    db.delete(row.id)
    if (selectedItem && selectedItem.id === row.id) {
      selectedItem = null
    }
    logActivity("Client removed", (row.data && row.data.name ? row.data.name : "Client") + " was removed", "warning")
  }

  function addStaff(data) {
    db.create("staff", {
      name: data.name,
      role: data.role,
      email: data.email,
      status: "online",
      rating: 0,
      appointments: 0
    })
    logActivity("New staff added", data.name + " joined as " + data.role, "success")
    showAddStaffModal = false
  }

  function editStaff(row) {
    editingStaff = row
    showEditStaffModal = true
  }

  function saveEditStaff(data) {
    if (editingStaff) {
      let updated = {
        name: data.name || editingStaff.data.name,
        role: data.role || editingStaff.data.role,
        email: data.email || editingStaff.data.email,
        status: editingStaff.data.status || "online",
        rating: editingStaff.data.rating || 0,
        appointments: editingStaff.data.appointments || 0
      }
      db.update(editingStaff.id, updated)
      if (selectedItem && selectedItem.id === editingStaff.id) {
        selectedItem = { id: editingStaff.id, data: updated }
      }
      logActivity("Staff updated", updated.name + " was updated", "info")
    }
    showEditStaffModal = false
    editingStaff = null
  }

  function closeEditStaffModal() {
    showEditStaffModal = false
    editingStaff = null
  }

  function deleteStaff(row) {
    if (!row) return
    db.delete(row.id)
    if (selectedItem && selectedItem.id === row.id) {
      selectedItem = null
    }
    logActivity("Staff removed", (row.data && row.data.name ? row.data.name : "Staff") + " was removed", "warning")
  }

  function addService(data) {
    db.create("services", {
      name: data.name,
      category: data.category,
      price: data.price !== undefined && data.price !== "" ? Number(data.price) : 0,
      duration: data.duration !== undefined && data.duration !== "" ? Number(data.duration) : 30
    })
    logActivity("New service added", data.name + " (" + data.category + ")", "success")
    showAddServiceModal = false
  }

  function editService(row) {
    editingService = row
    showEditServiceModal = true
  }

  function saveEditService(data) {
    if (editingService) {
      let updated = {
        name: data.name || editingService.data.name,
        category: data.category || editingService.data.category,
        price: data.price !== undefined && data.price !== "" ? Number(data.price) : editingService.data.price,
        duration: data.duration !== undefined && data.duration !== "" ? Number(data.duration) : editingService.data.duration
      }
      db.update(editingService.id, updated)
      if (selectedItem && selectedItem.id === editingService.id) {
        selectedItem = { id: editingService.id, data: updated }
      }
      logActivity("Service updated", updated.name + " was updated", "info")
    }
    showEditServiceModal = false
    editingService = null
  }

  function closeEditServiceModal() {
    showEditServiceModal = false
    editingService = null
  }

  function deleteService(row) {
    if (!row) return
    db.delete(row.id)
    if (selectedItem && selectedItem.id === row.id) {
      selectedItem = null
    }
    logActivity("Service removed", (row.data && row.data.name ? row.data.name : "Service") + " was removed", "warning")
  }

  function addAppointment(data) {
    db.create("appointments", {
      client: data.client,
      stylist: data.stylist,
      service: data.service,
      time: data.time,
      status: "scheduled",
      price: data.price !== undefined && data.price !== "" ? Number(data.price) : 0
    })
    logActivity("Appointment booked", data.client + " - " + data.service + " at " + data.time, "success")
    showAddModal = false
  }

  function editAppointment(row) {
    editingAppointment = row
    appointmentEditFields = buildAppointmentFields()
    showEditAppointmentModal = true
  }

  function saveEditAppointment(data) {
    if (editingAppointment) {
      let updated = {
        client: data.client || editingAppointment.data.client,
        stylist: data.stylist || editingAppointment.data.stylist,
        service: data.service || editingAppointment.data.service,
        time: data.time || editingAppointment.data.time,
        status: data.status || editingAppointment.data.status,
        price: data.price !== undefined && data.price !== "" ? Number(data.price) : editingAppointment.data.price
      }
      db.update(editingAppointment.id, updated)
      if (selectedItem && selectedItem.id === editingAppointment.id) {
        selectedItem = { id: editingAppointment.id, data: updated }
      }
      logActivity("Appointment updated", updated.client + " appointment was updated", "info")
    }
    showEditAppointmentModal = false
    editingAppointment = null
  }

  function closeEditAppointmentModal() {
    showEditAppointmentModal = false
    editingAppointment = null
  }

  function deleteAppointment(row) {
    if (!row) return
    db.delete(row.id)
    if (selectedItem && selectedItem.id === row.id) {
      selectedItem = null
    }
    logActivity("Appointment cancelled", (row.data && row.data.client ? row.data.client : "Booking") + " cancelled", "warning")
  }

  function onAppointmentSaved() {
    logActivity("Appointment booked", "New appointment created", "success")
    showAddModal = false
  }

  function onClientSaved() {
    logActivity("New client added", "Client registered", "success")
    showAddClientModal = false
  }

  function onStaffSaved() {
    logActivity("New staff added", "Staff member added", "success")
    showAddStaffModal = false
  }

  function onServiceSaved() {
    logActivity("New service added", "Service created", "success")
    showAddServiceModal = false
  }

  function openAddModal() {
    appointmentFormFields = buildAppointmentFields()
    showAddModal = true
  }

  function closeAddModal() {
    showAddModal = false
  }

  function openAddClientModal() {
    showAddClientModal = true
  }

  function closeAddClientModal() {
    showAddClientModal = false
  }

  function openAddStaffModal() {
    showAddStaffModal = true
  }

  function closeAddStaffModal() {
    showAddStaffModal = false
  }

  function openAddServiceModal() {
    showAddServiceModal = true
  }

  function closeAddServiceModal() {
    showAddServiceModal = false
  }

  function viewAllAppointments() {
    navigate("appointments")
  }

  function viewAllClients() {
    navigate("clients")
  }

  function viewAllStaff() {
    navigate("staff")
  }

  function viewAllServices() {
    navigate("services")
  }

  function openStudioPage() {
    navigate("studio")
  }

  // Data Management Modal
  function openDataModal() {
    copiedExport = false
    showDataModal = true
  }

  function closeDataModal() {
    showDataModal = false
    exportedData = ""
    importData = ""
    confirmClearData = false
    copiedExport = false
  }

  function exportAllData() {
    let data = {
      clients: db.query("clients"),
      staff: db.query("staff"),
      services: db.query("services"),
      appointments: db.query("appointments"),
      activity: db.query("activity")
    }
    exportedData = JSON.stringify(data, null, 2)
    copiedExport = false
  }

  function copyToClipboard() {
    if (!exportedData) return
    try {
      if (typeof navigator !== "undefined" && navigator.clipboard && typeof navigator.clipboard.writeText === "function") {
        navigator.clipboard.writeText(exportedData)
        copiedExport = true
      }
    } catch (e) {}
  }

  function setImportData(value) {
    if (value && value.target !== undefined) {
      importData = value.target.value
    } else {
      importData = value
    }
  }

  function importAllData() {
    if (!importData) return

    try {
      let parsed = JSON.parse(importData)
      let count = 0

      if (parsed.clients) {
        parsed.clients.forEach(function(r) {
          db.create("clients", r.data || r)
          count = count + 1
        })
      }
      if (parsed.staff) {
        parsed.staff.forEach(function(r) {
          db.create("staff", r.data || r)
          count = count + 1
        })
      }
      if (parsed.services) {
        parsed.services.forEach(function(r) {
          db.create("services", r.data || r)
          count = count + 1
        })
      }
      if (parsed.appointments) {
        parsed.appointments.forEach(function(r) {
          db.create("appointments", r.data || r)
          count = count + 1
        })
      }
      if (parsed.activity) {
        parsed.activity.forEach(function(r) {
          db.create("activity", r.data || r)
          count = count + 1
        })
      }

      logActivity("Data imported", count + " records imported", "success")
      importData = ""
    } catch (e) {
      logActivity("Import failed", "Invalid JSON data", "error")
    }
  }

  function clearAllData() {
    if (!confirmClearData) {
      confirmClearData = true
      return
    }

    let clients = db.query("clients") || []
    let staff = db.query("staff") || []
    let services = db.query("services") || []
    let appointments = db.query("appointments") || []
    let activity = db.query("activity") || []

    clients.forEach(function(r) { db.delete(r.id) })
    staff.forEach(function(r) { db.delete(r.id) })
    services.forEach(function(r) { db.delete(r.id) })
    appointments.forEach(function(r) { db.delete(r.id) })
    activity.forEach(function(r) { db.delete(r.id) })

    selectedItem = null
    confirmClearData = false
    closeDataModal()
  }

  function cancelClearData() {
    confirmClearData = false
  }

  // ── Beauty & Lighting Studio functions ──

  function parseNumericInput(val, fallback) {
    let raw = val
    if (val && typeof val === "object" && val.target !== undefined) {
      raw = val.target.value
    }
    let n = Number(raw)
    if (isNaN(n)) return fallback
    return Math.round(n)
  }

  function setStudioMuse(m) {
    studioMuse = m
    studioCapturedUrl = ""
    studioToast = ""
  }

  function applyStudioPreset(preset) {
    studioPreset = preset
    studioToast = ""
    if (preset === "golden") {
      studioExposure = 104
      studioWarmth = 18
      studioContrast = 106
      studioGlow = 35
      studioVignette = 28
    } else if (preset === "editorial") {
      studioExposure = 108
      studioWarmth = -12
      studioContrast = 116
      studioGlow = 20
      studioVignette = 34
    } else if (preset === "rose") {
      studioExposure = 105
      studioWarmth = 10
      studioContrast = 102
      studioGlow = 48
      studioVignette = 22
    } else if (preset === "noir") {
      studioExposure = 96
      studioWarmth = -20
      studioContrast = 126
      studioGlow = 15
      studioVignette = 52
    } else {
      studioExposure = 100
      studioWarmth = 0
      studioContrast = 100
      studioGlow = 12
      studioVignette = 14
    }
  }

  function setStudioExposure(v) {
    studioExposure = parseNumericInput(v, studioExposure)
  }

  function setStudioWarmth(v) {
    studioWarmth = parseNumericInput(v, studioWarmth)
  }

  function setStudioContrast(v) {
    studioContrast = parseNumericInput(v, studioContrast)
  }

  function setStudioGlow(v) {
    studioGlow = parseNumericInput(v, studioGlow)
  }

  function setStudioVignette(v) {
    studioVignette = parseNumericInput(v, studioVignette)
  }

  function resetStudioControls() {
    applyStudioPreset("golden")
  }

  function toggleStudioCamera() {
    studioCameraOn = !studioCameraOn
    studioToast = ""
  }

  function onStudioCapture(data) {
    if (data && data.dataUrl) {
      studioCapturedUrl = data.dataUrl
      studioCameraOn = false
      studioToast = "Client consultation photo captured — adjust lighting & LUT presets live."
    }
  }

  function clearStudioCapture() {
    studioCapturedUrl = ""
    studioToast = "Switched back to built-in Studio Portrait preview."
  }

  function getStudioFilterCss() {
    let bright = studioExposure / 100
    let cont = studioContrast / 100
    let sat = studioPreset === "noir" ? 0.15 : (1 + (studioWarmth / 140))
    let sepia = studioWarmth > 0 ? (studioWarmth / 120) : 0
    let hue = studioPreset === "rose" ? -8 : (studioWarmth < 0 ? (studioWarmth * 0.4) : 0)
    return "brightness(" + bright + ") contrast(" + cont + ") saturate(" + sat + ") sepia(" + sepia + ") hue-rotate(" + hue + "deg)"
  }

  function getStudioMuseLabel() {
    if (studioCapturedUrl !== "") return "Live Camera Capture"
    if (studioMuse === "platinum") return "Platinum Silk"
    if (studioMuse === "rosegold") return "Rose Gold Glow"
    if (studioMuse === "espresso") return "Espresso Velvet"
    return "Warm Balayage"
  }

  function getStudioPresetLabel() {
    if (studioPreset === "editorial") return "Editorial Cool"
    if (studioPreset === "rose") return "Velvet Rose"
    if (studioPreset === "noir") return "Noir Luxe"
    if (studioPreset === "natural") return "Natural Daylight"
    return "Golden Hour"
  }

  function buildStudioPortraitSvg(includeLutFooter) {
    let hairMain = "#9a6b44"
    let hairHi = "#e0b483"
    let bgA = "#231915"
    let bgB = "#3d2c24"
    let lip = "#b85d5c"
    if (studioMuse === "platinum") {
      hairMain = "#cbd5e1"
      hairHi = "#f8fafc"
      bgA = "#181c26"
      bgB = "#2c3446"
      lip = "#c06c78"
    } else if (studioMuse === "rosegold") {
      hairMain = "#b8746c"
      hairHi = "#f1bfb5"
      bgA = "#27181c"
      bgB = "#462931"
      lip = "#c46271"
    } else if (studioMuse === "espresso") {
      hairMain = "#2e1f1a"
      hairHi = "#6e4e3e"
      bgA = "#171413"
      bgB = "#2e2623"
      lip = "#9f3f47"
    }

    let glowOpacity = Math.round(studioGlow) / 160
    let vigOpacity = Math.round(studioVignette) / 110
    let tintColor = studioWarmth >= 0 ? "rgba(251,191,36," + (studioWarmth / 260) + ")" : "rgba(96,165,250," + ((-studioWarmth) / 240) + ")"
    if (studioPreset === "rose") {
      tintColor = "rgba(244,114,182,0.12)"
    }

    let s = "<svg xmlns='http://www.w3.org/2000/svg' width='640' height='520' viewBox='0 0 640 520'>"
    s = s + "<defs>"
    s = s + "<linearGradient id='bg' x1='0%' y1='0%' x2='100%' y2='100%'><stop offset='0%' stop-color='" + bgA + "'/><stop offset='100%' stop-color='" + bgB + "'/></linearGradient>"
    s = s + "<linearGradient id='hair' x1='0%' y1='0%' x2='100%' y2='100%'><stop offset='0%' stop-color='" + hairMain + "'/><stop offset='55%' stop-color='" + hairHi + "'/><stop offset='100%' stop-color='" + hairMain + "'/></linearGradient>"
    s = s + "<radialGradient id='keylight' cx='32%' cy='24%' r='65%'><stop offset='0%' stop-color='rgba(255,247,237," + glowOpacity + ")'/><stop offset='100%' stop-color='rgba(255,247,237,0)'/></radialGradient>"
    s = s + "<radialGradient id='vig' cx='50%' cy='48%' r='62%'><stop offset='55%' stop-color='rgba(0,0,0,0)'/><stop offset='100%' stop-color='rgba(0,0,0," + vigOpacity + ")'/></radialGradient>"
    s = s + "</defs>"
    s = s + "<rect width='640' height='520' fill='url(#bg)'/>"
    s = s + "<circle cx='490' cy='118' r='130' fill='rgba(212,165,116,0.12)'/>"
    s = s + "<circle cx='160' cy='390' r='150' fill='rgba(212,165,116,0.08)'/>"
    // Back hair silhouette
    s = s + "<path d='M195 210 C190 105, 450 105, 445 210 C458 315, 472 395, 430 455 L210 455 C168 395, 182 315, 195 210 Z' fill='url(#hair)'/>"
    // Shoulders & luxury gown neckline
    s = s + "<path d='M130 520 C155 430, 235 408, 320 408 C405 408, 485 430, 510 520 Z' fill='#141211'/>"
    s = s + "<path d='M255 415 L320 468 L385 415' fill='none' stroke='#d4a574' stroke-width='2.5' opacity='0.75'/>"
    // Neck & face
    s = s + "<rect x='294' y='320' width='52' height='98' rx='24' fill='#dfb195'/>"
    s = s + "<ellipse cx='320' cy='246' rx='74' ry='94' fill='#eac0a6'/>"
    // Soft cheek contour
    s = s + "<ellipse cx='274' cy='266' rx='20' ry='12' fill='rgba(196,108,108,0.22)'/>"
    s = s + "<ellipse cx='366' cy='266' rx='20' ry='12' fill='rgba(196,108,108,0.22)'/>"
    // Brows & lashes
    s = s + "<path d='M268 220 Q288 210 305 218' fill='none' stroke='#4a352c' stroke-width='3.2' stroke-linecap='round'/>"
    s = s + "<path d='M335 218 Q352 210 372 220' fill='none' stroke='#4a352c' stroke-width='3.2' stroke-linecap='round'/>"
    s = s + "<path d='M271 236 Q288 244 303 236' fill='none' stroke='#291d18' stroke-width='2.8' stroke-linecap='round'/>"
    s = s + "<path d='M337 236 Q352 244 369 236' fill='none' stroke='#291d18' stroke-width='2.8' stroke-linecap='round'/>"
    // Nose & lips
    s = s + "<path d='M320 236 L316 272 Q320 276 325 272' fill='none' stroke='rgba(140,92,72,0.45)' stroke-width='2' stroke-linecap='round'/>"
    s = s + "<path d='M296 296 Q320 287 344 296 Q320 312 296 296 Z' fill='" + lip + "'/>"
    s = s + "<path d='M302 296 Q320 301 338 296' fill='none' stroke='rgba(255,255,255,0.35)' stroke-width='1.2'/>"
    // Sweeping front hair highlights
    s = s + "<path d='M242 205 C250 142, 330 132, 396 196 C382 162, 305 154, 246 232 Z' fill='" + hairHi + "' opacity='0.65'/>"
    s = s + "<path d='M396 196 C428 245, 424 335, 398 398 C436 340, 442 250, 404 184 Z' fill='" + hairHi + "' opacity='0.45'/>"
    // Studio lighting & LUT overlays
    s = s + "<rect width='640' height='520' fill='" + tintColor + "'/>"
    s = s + "<rect width='640' height='520' fill='url(#keylight)'/>"
    s = s + "<rect width='640' height='520' fill='url(#vig)'/>"
    if (includeLutFooter) {
      s = s + "<rect x='24' y='454' width='592' height='44' rx='10' fill='rgba(12,10,9,0.78)' stroke='rgba(212,165,116,0.35)'/>"
      s = s + "<text x='42' y='481' fill='#faf9f7' font-family='Georgia, serif' font-size='15' font-weight='bold'>Glamour Studio · " + getStudioMuseLabel() + " · " + getStudioPresetLabel() + "</text>"
      s = s + "<text x='440' y='481' fill='#d4a574' font-family='monospace' font-size='12'>EXP " + studioExposure + "% · WRM " + studioWarmth + "</text>"
    }
    s = s + "</svg>"
    return "data:image/svg+xml;charset=utf-8," + encodeURIComponent(s)
  }

  function getStudioPortraitUrl() {
    if (studioCapturedUrl !== "") {
      return studioCapturedUrl
    }
    return buildStudioPortraitSvg(false)
  }

  function getStudioExportUrl() {
    if (studioCapturedUrl !== "") {
      return studioCapturedUrl
    }
    return buildStudioPortraitSvg(true)
  }

  function saveLookToActivity() {
    let summary = getStudioMuseLabel() + " with " + getStudioPresetLabel() + " lighting (Exp " + studioExposure + "%, Warmth " + studioWarmth + ")"
    logActivity("Lookbook consultation saved", summary, "success", "Styling Studio")
    studioToast = "Saved '" + getStudioPresetLabel() + "' recipe to Salon Activity Log."
  }

  // Lifecycle hooks
  function _init() {
    try {
      studioCameraAvailable = typeof navigator !== "undefined" && !!(navigator.mediaDevices && typeof navigator.mediaDevices.getUserMedia === "function")
    } catch (e) {
      studioCameraAvailable = false
    }

    try {
      if (typeof db !== "undefined" && typeof db.getSavedSyncRoom === "function") {
        let savedRoom = db.getSavedSyncRoom()
        if (savedRoom) {
          syncRoom = savedRoom
          syncConnecting = true
          db.startSync(savedRoom)
        }
      }
    } catch (e) {}
  }

  function _onHide() {
    // Release active camera stream cleanly when hidden
    studioCameraOn = false
  }

  function getTotalBookedRevenue() {
    let appts = db.query("appointments") || []
    let svcs = db.query("services") || []
    let svcPrice = {}
    svcs.forEach(function(s) {
      if (s && s.data && s.data.name) {
        svcPrice[s.data.name] = Number(s.data.price) || 0
      }
    })
    let total = 0
    appts.forEach(function(a) {
      if (!a || !a.data) return
      if (a.data.status === "cancelled" || a.data.status === "Cancelled") return
      let p = Number(a.data.price)
      if (!p && a.data.service && svcPrice[a.data.service]) {
        p = svcPrice[a.data.service]
      }
      if (p > 0) total = total + p
    })
    return "$" + Math.round(total).toLocaleString()
  }

  // P2P Sync functions
  function openSyncModal() {
    copiedRoom = false
    showSyncModal = true
    refreshSyncStatus()
  }

  function closeSyncModal() {
    showSyncModal = false
  }

  function setSyncRoom(value) {
    copiedRoom = false
    if (value && value.target !== undefined) {
      syncRoom = value.target.value
    } else {
      syncRoom = value
    }
  }

  function copySyncRoom() {
    if (!syncRoom) return
    try {
      if (typeof navigator !== "undefined" && navigator.clipboard && typeof navigator.clipboard.writeText === "function") {
        navigator.clipboard.writeText(syncRoom)
        copiedRoom = true
      }
    } catch (e) {}
  }

  function generateRoomCode() {
    let chars = "abcdefghijklmnopqrstuvwxyz0123456789"
    let code = "glamour-"
    let i = 0
    while (i < 6) {
      code = code + chars.charAt(Math.floor(Math.random() * chars.length))
      i = i + 1
    }
    syncRoom = code
    copiedRoom = false
  }

  function joinSync() {
    if (!syncRoom) return
    syncConnecting = true
    syncConnected = false
    try {
      db.startSync(syncRoom)
    } catch (e) {
      syncConnecting = false
    }
  }

  function leaveSync() {
    try {
      db.stopSync(syncRoom)
    } catch (e) {}
    syncConnected = false
    syncConnecting = false
    syncPeers = 0
  }

  function refreshSyncStatus() {
    try {
      let status = db.getSyncStatus(syncRoom)
      if (status) {
        syncConnected = status.connected
        syncPeers = status.peers
        if (status.connected) {
          syncConnecting = false
        }
      } else if (syncConnecting) {
        syncConnecting = false
      }
    } catch (e) {
      syncConnecting = false
    }
  }
