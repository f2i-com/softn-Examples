// Studio.ui - Interactive Beauty Lighting, Glamour LUTs & Consultation Portrait Studio
// Works 100% immediately out of the box with procedural studio portraits when no webcam is attached.

<Stack direction=vertical gap=lg if={currentPage === "studio"}>
  <Card padding=lg style={{ background: darkMode ? "linear-gradient(135deg, #1c1917 0%, #292524 100%)" : "linear-gradient(135deg, #ffffff 0%, #f5f5f4 100%)", borderRadius: "16px", border: "1px solid " + getBorderColor() }}>
    <Box style={{ display: "flex", flexWrap: "wrap", alignItems: "center", justifyContent: "space-between", gap: "0.75rem" }}>
      <Stack direction=vertical gap=xs style={{ minWidth: 0 }}>
        <Text size=xs style={{ color: getAccentColor(), textTransform: "uppercase", letterSpacing: "0.08em", fontWeight: 600 }}>Consultation Lookbook</Text>
        <Heading level={2} style={{ color: getTextColor(), fontSize: "1.375rem", fontFamily: "Georgia, 'Times New Roman', serif", fontWeight: 600 }}>Beauty & Lighting Studio</Heading>
        <Text size=sm style={{ color: getMutedColor() }}>Preview hair tones, glamour LUTs, and key-light balance live — works immediately with built-in studio portraits or a live camera.</Text>
      </Stack>
      <Stack direction=horizontal gap=xs align=center style={{ flexWrap: "wrap" }}>
        <Badge variant={studioCameraOn ? "info" : "success"} size=sm>
          {studioCameraOn ? "Live Camera View" : (studioCapturedUrl !== "" ? "Captured Photo" : "Studio Portrait Ready")}
        </Badge>
        <Button variant={studioCameraOn ? "outline" : "secondary"} size=sm @click={toggleStudioCamera} style={{ gap: "0.35rem" }}>
          <Icon svg={iconCamera} size={14} style={{ color: getTextColor() }} />
          <Text size=xs style={{ color: getTextColor(), fontWeight: 600 }}>{studioCameraOn ? "Close Camera" : "Live Camera"}</Text>
        </Button>
      </Stack>
    </Box>
  </Card>

  <Grid columns={{ sm: 1, lg: 2 }} gap=lg>
    // Left Column: Portrait Preview / Camera Stage
    <Card padding=lg style={{ background: getCardBg(), borderRadius: "14px", border: "1px solid " + getBorderColor(), minWidth: 0 }}>
      <Stack direction=vertical gap=md>
        <Box style={{ display: "flex", flexWrap: "wrap", alignItems: "center", justifyContent: "space-between", gap: "0.5rem" }}>
          <Text fontWeight=semibold size=sm style={{ color: getHeadingColor(), textTransform: "uppercase", letterSpacing: "0.04em", fontSize: "0.75rem" }}>
            {getStudioMuseLabel() + " · " + getStudioPresetLabel()}
          </Text>
          <Button if={studioCapturedUrl !== ""} variant=ghost size=xs @click={clearStudioCapture} style={{ color: getAccentColor() }}>
            Use Studio Muse
          </Button>
        </Box>

        // Muse Selector Pills
        <Box if={!studioCameraOn} style={{ display: "flex", flexWrap: "wrap", gap: "0.4rem" }}>
          <Button variant={studioMuse === "balayage" && studioCapturedUrl === "" ? "primary" : "secondary"} size=xs @click={setStudioMuse("balayage")}>Warm Balayage</Button>
          <Button variant={studioMuse === "platinum" && studioCapturedUrl === "" ? "primary" : "secondary"} size=xs @click={setStudioMuse("platinum")}>Platinum Silk</Button>
          <Button variant={studioMuse === "rosegold" && studioCapturedUrl === "" ? "primary" : "secondary"} size=xs @click={setStudioMuse("rosegold")}>Rose Gold</Button>
          <Button variant={studioMuse === "espresso" && studioCapturedUrl === "" ? "primary" : "secondary"} size=xs @click={setStudioMuse("espresso")}>Espresso Velvet</Button>
        </Box>

        // Live Camera Viewfinder (mounted only when requested; unmounts on _onHide)
        <Box if={studioCameraOn} style={{ borderRadius: "12px", overflow: "hidden", border: "1px solid " + getBorderColor(), background: "#0c0a09", padding: "0.5rem" }}>
          <Camera
            mode="photo"
            onCapture={onStudioCapture}
            style={{ width: "100%", borderRadius: "10px", filter: getStudioFilterCss() }}
          />
          <Text size=xs style={{ color: getMutedColor(), marginTop: "0.5rem", display: "block", textAlign: "center" }}>
            {studioCameraAvailable ? "Capture a photo to grade it with the studio LUT controls." : "No webcam detected in this browser — click 'Close Camera' to use the interactive Studio Portrait muses."}
          </Text>
        </Box>

        // Built-in / Captured Portrait Stage
        <Box if={!studioCameraOn} style={{
          borderRadius: "12px",
          overflow: "hidden",
          border: "1px solid " + getBorderColor(),
          background: "#141211",
          display: "flex",
          alignItems: "center",
          justifyContent: "center"
        }}>
          <Image
            src={getStudioPortraitUrl()}
            alt="Glamour Studio Portrait Preview"
            style={{
              width: "100%",
              maxHeight: "380px",
              objectFit: "cover",
              display: "block",
              filter: getStudioFilterCss(),
              transition: "filter 160ms ease"
            }}
          />
        </Box>

        // Export & Salon Log Actions
        <Box style={{ display: "flex", flexWrap: "wrap", alignItems: "center", justifyContent: "space-between", gap: "0.5rem" }}>
          <a
            href={getStudioExportUrl()}
            download="glamour-studio-look.svg"
            style={{
              display: "inline-flex",
              alignItems: "center",
              gap: "0.4rem",
              padding: "0.5rem 0.9rem",
              borderRadius: "8px",
              background: "linear-gradient(135deg, " + getAccentColor() + ", " + getAccentHover() + ")",
              color: darkMode ? "#1c1917" : "#ffffff",
              fontWeight: 600,
              fontSize: "0.8rem",
              textDecoration: "none"
            }}
          >
            <Icon name="download" size={14} color={darkMode ? "#1c1917" : "#ffffff"} />
            Export Snapshot
          </a>

          <Button variant=secondary size=sm @click={saveLookToActivity}>
            Save Recipe to Salon Log
          </Button>
        </Box>

        <Text if={studioToast !== ""} size=xs style={{ color: getAccentColor(), fontWeight: 500 }}>{studioToast}</Text>
      </Stack>
    </Card>

    // Right Column: Glamour LUT Presets & Lighting Sliders
    <Card padding=lg style={{ background: getCardBg(), borderRadius: "14px", border: "1px solid " + getBorderColor(), minWidth: 0 }}>
      <Stack direction=vertical gap=md>
        <Box style={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: "0.5rem" }}>
          <Text fontWeight=semibold size=sm style={{ color: getHeadingColor(), textTransform: "uppercase", letterSpacing: "0.04em", fontSize: "0.75rem" }}>Glamour LUT Presets</Text>
          <Button variant=ghost size=xs @click={resetStudioControls} style={{ color: getAccentColor() }}>Reset</Button>
        </Box>

        <Box style={{ display: "flex", flexWrap: "wrap", gap: "0.4rem" }}>
          <Button variant={studioPreset === "golden" ? "primary" : "secondary"} size=xs @click={applyStudioPreset("golden")}>Golden Hour</Button>
          <Button variant={studioPreset === "editorial" ? "primary" : "secondary"} size=xs @click={applyStudioPreset("editorial")}>Editorial Cool</Button>
          <Button variant={studioPreset === "rose" ? "primary" : "secondary"} size=xs @click={applyStudioPreset("rose")}>Velvet Rose</Button>
          <Button variant={studioPreset === "noir" ? "primary" : "secondary"} size=xs @click={applyStudioPreset("noir")}>Noir Luxe</Button>
          <Button variant={studioPreset === "natural" ? "primary" : "secondary"} size=xs @click={applyStudioPreset("natural")}>Natural</Button>
        </Box>

        <Divider style={{ borderColor: getBorderColor() }} />

        <Stack direction=vertical gap=md>
          <Box>
            <Box style={{ display: "flex", justifyContent: "space-between", marginBottom: "0.25rem" }}>
              <Text size=xs style={{ color: getTextColor(), fontWeight: 500 }}>Key Light Exposure</Text>
              <Text size=xs style={{ color: getAccentColor(), fontFamily: "monospace" }}>{studioExposure + "%"}</Text>
            </Box>
            <Slider value={studioExposure} min={80} max={130} step={1} @change={setStudioExposure} />
          </Box>

          <Box>
            <Box style={{ display: "flex", justifyContent: "space-between", marginBottom: "0.25rem" }}>
              <Text size=xs style={{ color: getTextColor(), fontWeight: 500 }}>Color Warmth (Kelvin Shift)</Text>
              <Text size=xs style={{ color: getAccentColor(), fontFamily: "monospace" }}>{(studioWarmth > 0 ? "+" : "") + studioWarmth}</Text>
            </Box>
            <Slider value={studioWarmth} min={-30} max={40} step={1} @change={setStudioWarmth} />
          </Box>

          <Box>
            <Box style={{ display: "flex", justifyContent: "space-between", marginBottom: "0.25rem" }}>
              <Text size=xs style={{ color: getTextColor(), fontWeight: 500 }}>Editorial Contrast</Text>
              <Text size=xs style={{ color: getAccentColor(), fontFamily: "monospace" }}>{studioContrast + "%"}</Text>
            </Box>
            <Slider value={studioContrast} min={80} max={135} step={1} @change={setStudioContrast} />
          </Box>

          <Box>
            <Box style={{ display: "flex", justifyContent: "space-between", marginBottom: "0.25rem" }}>
              <Text size=xs style={{ color: getTextColor(), fontWeight: 500 }}>Soft Key Diffusion</Text>
              <Text size=xs style={{ color: getAccentColor(), fontFamily: "monospace" }}>{studioGlow + "%"}</Text>
            </Box>
            <Slider value={studioGlow} min={0} max={100} step={1} @change={setStudioGlow} />
          </Box>

          <Box>
            <Box style={{ display: "flex", justifyContent: "space-between", marginBottom: "0.25rem" }}>
              <Text size=xs style={{ color: getTextColor(), fontWeight: 500 }}>Portrait Vignette</Text>
              <Text size=xs style={{ color: getAccentColor(), fontFamily: "monospace" }}>{studioVignette + "%"}</Text>
            </Box>
            <Slider value={studioVignette} min={0} max={80} step={1} @change={setStudioVignette} />
          </Box>
        </Stack>
      </Stack>
    </Card>
  </Grid>
</Stack>
