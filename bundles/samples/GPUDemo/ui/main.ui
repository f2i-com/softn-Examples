// main.ui - GPU Compute Demo

<logic src="../logic/main.logic" />

<style>
.gpu-wrap { max-width: 860px; margin: 0 auto; }
.gpu-card {
  background: #0f1a14;
  border: 1px solid #1a3a2a;
  border-radius: 10px;
  padding: 1.25rem;
  margin-bottom: 1rem;
}
.gpu-result {
  background: #0a1510;
  border: 1px solid #1a3a2a;
  border-radius: 8px;
  padding: 1rem;
  font-family: monospace;
  font-size: 0.875rem;
  color: #6ee7b7;
  white-space: pre-wrap;
  word-break: break-all;
  min-height: 2.5rem;
  max-height: 10rem;
  overflow-y: auto;
}
.gpu-status {
  background: #0a1510;
  border: 1px solid #1a3a2a;
  border-radius: 6px;
  padding: 0.625rem 0.875rem;
  font-family: monospace;
  font-size: 0.75rem;
  color: #34d399;
}
@keyframes gpu-pulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}
.gpu-running {
  animation: gpu-pulse 0.8s ease-in-out infinite;
}
</style>

<App theme="dark">
<Box direction="column" gap="0" padding="1.5rem" className="gpu-wrap" style={{ background: "#071210", minHeight: "100vh" }}>

  // Header
  <Box direction="column" gap="0.25rem" padding="0 0 1rem 0">
    <Text variant="h5" style={{ display: "block", color: "#10b981", fontWeight: "700" }}>GPU Compute</Text>
    <Text variant="caption" style={{ display: "block", color: "#94a3b8" }}>Run selectable WebGPU WGSL compute kernels on your graphics card across 8 to 4096 floats with dispatch timing.</Text>
  </Box>

  // Status
  <Box className={running ? "gpu-status gpu-running" : "gpu-status"} padding="0.625rem 0.875rem" style={{ marginBottom: "1rem" }}>
    <Text variant="caption">{status}</Text>
  </Box>

  // Input card
  <Box className="gpu-card" direction="column" gap="0.75rem">
    <Text variant="subtitle2" style={{ color: "#a7f3d0" }}>Input Data</Text>
    <Box direction="column" gap="0.5rem">
      <Text variant="caption" style={{ color: "#6ee7b7" }}>Vector A:</Text>
      <Input value={inputA || ""} onInput="inputA = $value" placeholder="1, 2, 3, 4" style={{ background: "#0a1510", color: "#e2e8f0", border: "1px solid #1a3a2a", borderRadius: "6px", padding: "0.5rem", fontFamily: "monospace", fontSize: "0.8125rem" }} />
    </Box>
    <Box direction="column" gap="0.5rem">
      <Text variant="caption" style={{ color: "#6ee7b7" }}>Vector B:</Text>
      <Input value={inputB || ""} onInput="inputB = $value" placeholder="10, 20, 30, 40" style={{ background: "#0a1510", color: "#e2e8f0", border: "1px solid #1a3a2a", borderRadius: "6px", padding: "0.5rem", fontFamily: "monospace", fontSize: "0.8125rem" }} />
    </Box>
    <Box direction="row" gap="0.4rem" style={{ flexWrap: "wrap", alignItems: "center" }}>
      <Text variant="caption" style={{ color: "#6ee7b7", marginRight: "0.25rem" }}>Preset:</Text>
      <Button @click={loadBenchPreset(8)} style={{ padding: "0.25rem 0.6rem", fontSize: "12px", background: "rgba(16,185,129,0.12)", color: "#a7f3d0", border: "1px solid #1a3a2a", borderRadius: "6px", cursor: "pointer" }}>8 floats</Button>
      <Button @click={loadBenchPreset(1024)} style={{ padding: "0.25rem 0.6rem", fontSize: "12px", background: "rgba(16,185,129,0.12)", color: "#a7f3d0", border: "1px solid #1a3a2a", borderRadius: "6px", cursor: "pointer" }}>1K benchmark</Button>
      <Button @click={loadBenchPreset(4096)} style={{ padding: "0.25rem 0.6rem", fontSize: "12px", background: "rgba(16,185,129,0.12)", color: "#a7f3d0", border: "1px solid #1a3a2a", borderRadius: "6px", cursor: "pointer" }}>4K benchmark</Button>
    </Box>
    <Box direction="row" gap="0.4rem" style={{ flexWrap: "wrap", alignItems: "center" }}>
      <Text variant="caption" style={{ color: "#6ee7b7", marginRight: "0.25rem" }}>Kernel:</Text>
      <Button @click={setKernelOp("add")} style={{ padding: "0.25rem 0.6rem", fontSize: "12px", background: kernelOp === "add" ? "#10b981" : "transparent", color: kernelOp === "add" ? "#fff" : "#6ee7b7", border: "1px solid #1a3a2a", borderRadius: "6px", cursor: "pointer" }}>A + B</Button>
      <Button @click={setKernelOp("mul")} style={{ padding: "0.25rem 0.6rem", fontSize: "12px", background: kernelOp === "mul" ? "#10b981" : "transparent", color: kernelOp === "mul" ? "#fff" : "#6ee7b7", border: "1px solid #1a3a2a", borderRadius: "6px", cursor: "pointer" }}>A * B</Button>
      <Button @click={setKernelOp("saxpy")} style={{ padding: "0.25rem 0.6rem", fontSize: "12px", background: kernelOp === "saxpy" ? "#10b981" : "transparent", color: kernelOp === "saxpy" ? "#fff" : "#6ee7b7", border: "1px solid #1a3a2a", borderRadius: "6px", cursor: "pointer" }}>2.5*A + B</Button>
      <Button @click={setKernelOp("relu")} style={{ padding: "0.25rem 0.6rem", fontSize: "12px", background: kernelOp === "relu" ? "#10b981" : "transparent", color: kernelOp === "relu" ? "#fff" : "#6ee7b7", border: "1px solid #1a3a2a", borderRadius: "6px", cursor: "pointer" }}>ReLU(A*B-0.5)</Button>
    </Box>
  </Box>

  // Actions
  <Box direction="row" gap="0.5rem" style={{ flexWrap: "wrap", marginBottom: "1rem" }}>
    <Button @click={runAddition} style={{ padding: "0.5rem 1.2rem", fontSize: "14px", background: "#10b981", color: "#fff", border: "none", borderRadius: "8px", cursor: "pointer", fontWeight: "600" }}>
      Run WGSL Kernel
    </Button>
    <Button @click={runInlineShader} style={{ padding: "0.5rem 1.2rem", fontSize: "14px", background: "transparent", color: "#6ee7b7", border: "1px solid #1a3a2a", borderRadius: "8px", cursor: "pointer", fontWeight: "600" }}>
      Double A
    </Button>
    <Button @click={cleanup} style={{ padding: "0.5rem 1rem", fontSize: "13px", background: "transparent", color: "#94a3b8", border: "1px solid #1a3a2a", borderRadius: "8px", cursor: "pointer" }}>
      Release GPU
    </Button>
  </Box>

  // Result
  <Box className="gpu-card" direction="column" gap="0.5rem">
    <Box direction="row" gap="0.75rem" style={{ display: "flex", width: "100%", justifyContent: "space-between", alignItems: "center" }}>
      <Text variant="subtitle2" style={{ color: "#a7f3d0" }}>Result</Text>
      <Text if={gpuElapsedMs > 0} variant="caption" style={{ color: "#6ee7b7", fontFamily: "monospace" }}>{gpuElapsedMs + " ms"}</Text>
    </Box>
    <Box className="gpu-result">
      <Text style={{ color: gpuMissing ? "#fca5a5" : "#ffffff" }}>{result || "Press a button: the answer comes back from the GPU."}</Text>
    </Box>
  </Box>

  // Active WGSL source preview
  <Box className="gpu-card" direction="column" gap="0.5rem">
    <Text variant="subtitle2" style={{ color: "#a7f3d0" }}>Active WGSL Kernel</Text>
    <Box className="gpu-result" style={{ maxHeight: "12rem", color: "#93c5fd", fontSize: "0.78rem" }}>
      <Text>{currentWgsl}</Text>
    </Box>
  </Box>

</Box>
</App>
