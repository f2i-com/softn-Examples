// GPU Compute & Interactive Field Simulation Demo
// Uses WebGPU WGSL compute shaders when available, and gracefully falls back to
// deterministic CPU vector execution + live particle field simulation when WebGPU is absent.

let status = "Initializing GPU compute pipeline..."
let result = ""
let deviceReady = false
let running = false
let gpuMissing = false
let backendMode = "probing"
let backendLabel = "Checking WebGPU..."

// Vector input data
let inputA = "1, 2, 3, 4, 5, 6, 7, 8"
let inputB = "10, 20, 30, 40, 50, 60, 70, 80"

let kernelOp = "add"
let currentWgsl = ""
let gpuElapsedMs = 0
let vectorSummary = ""
let spectrumBars = []
let _dispatchAt = 0

// Flat WebGPU state machine storage
let _bufAId = ""
let _bufBId = ""
let _bufOutId = ""
let _shaderId = ""
let _pipeId = ""
let _len = 0
let _dataA = []
let _dataB = []

// Interactive Visual Simulation state
let simRunning = true
let simPreset = "vortex"
let simTargetCount = 48
let simSpeed = 1.0
let simTime = 0
let simFps = 60
let simParticles = []
let _fpsAccum = 0
let _fpsFrames = 0

function unwrapVal(val) {
  if (val && typeof val === "object" && val.target !== undefined) {
    return String(val.target.value || "")
  }
  return val === undefined || val === null ? "" : String(val)
}

function updateInputA(val) {
  inputA = unwrapVal(val)
}

function updateInputB(val) {
  inputB = unwrapVal(val)
}

function computeShaderCode(op) {
  let opExpr = "a[i] + b[i]"
  if (op === "mul") { opExpr = "a[i] * b[i]" }
  else if (op === "saxpy") { opExpr = "2.5 * a[i] + b[i]" }
  else if (op === "relu") { opExpr = "max(0.0, a[i] * b[i] - 0.5)" }
  else if (op === "harmonic") { opExpr = "sin(a[i] * 0.5) * cos(b[i] * 0.25) * 10.0" }
  let code = "@group(0) @binding(0) var<storage, read> a : array<f32>;\n"
  code = code + "@group(0) @binding(1) var<storage, read> b : array<f32>;\n"
  code = code + "@group(0) @binding(2) var<storage, read_write> result : array<f32>;\n"
  code = code + "@compute @workgroup_size(64)\n"
  code = code + "fn main(@builtin(global_invocation_id) gid : vec3u) {\n"
  code = code + "  let i = gid.x;\n"
  code = code + "  if (i < arrayLength(&a)) {\n"
  code = code + "    result[i] = " + opExpr + ";\n"
  code = code + "  }\n"
  code = code + "}\n"
  return code
}

function doubleShaderCode() {
  let code = "@group(0) @binding(0) var<storage, read> input : array<f32>;\n"
  code = code + "@group(0) @binding(1) var<storage, read_write> output : array<f32>;\n"
  code = code + "@compute @workgroup_size(64)\n"
  code = code + "fn main(@builtin(global_invocation_id) gid : vec3u) {\n"
  code = code + "  let i = gid.x;\n"
  code = code + "  if (i < arrayLength(&input)) {\n"
  code = code + "    output[i] = input[i] * 2.0;\n"
  code = code + "  }\n"
  code = code + "}\n"
  return code
}

function log(msg) {
  status = msg
}

function hasGpuBridge() {
  try {
    return typeof softn !== "undefined" && !!(softn.ai && softn.ai.gpu && typeof softn.ai.gpu.requestDevice === "function")
  } catch (e) {
    return false
  }
}

function formatVector(data) {
  if (!data || !data.length) { return "(empty)" }
  let parts = []
  let i = 0
  while (i < data.length && i < 24) {
    let v = Math.round(data[i] * 1000) / 1000
    parts.push(String(v))
    i = i + 1
  }
  return "[ " + parts.join(", ") + (data.length > 24 ? (", ... (" + data.length + " floats)") : "") + " ]"
}

function updateOutputAnalytics(data) {
  if (!data || !data.length) {
    vectorSummary = ""
    spectrumBars = []
    return
  }
  let minV = data[0]
  let maxV = data[0]
  let sum = 0
  let i = 0
  while (i < data.length) {
    let v = Number(data[i]) || 0
    if (v < minV) minV = v
    if (v > maxV) maxV = v
    sum = sum + v
    i = i + 1
  }
  let mean = Math.round((sum / data.length) * 100) / 100
  minV = Math.round(minV * 100) / 100
  maxV = Math.round(maxV * 100) / 100
  vectorSummary = data.length + " elements · min " + minV + " · max " + maxV + " · mean " + mean

  let bars = []
  let span = Math.max(0.0001, Math.abs(maxV - minV))
  let count = data.length < 16 ? data.length : 16
  let b = 0
  while (b < count) {
    let val = Number(data[b]) || 0
    let norm = maxV === minV ? 60 : Math.round(((val - minV) / span) * 82) + 14
    if (norm < 12) norm = 12
    if (norm > 100) norm = 100
    bars.push({
      idx: b,
      heightPct: norm,
      label: String(Math.round(val * 10) / 10)
    })
    b = b + 1
  }
  spectrumBars = bars
}

function executeCpuKernel(op, a, b) {
  let t0 = Date.now()
  let out = []
  let i = 0
  while (i < a.length) {
    let va = a[i]
    let vb = b && i < b.length ? b[i] : 0
    let r = 0
    if (op === "double") { r = va * 2.0 }
    else if (op === "mul") { r = va * vb }
    else if (op === "saxpy") { r = 2.5 * va + vb }
    else if (op === "relu") {
      let t = va * vb - 0.5
      r = t > 0 ? t : 0
    } else if (op === "harmonic") {
      r = Math.sin(va * 0.5) * Math.cos(vb * 0.25) * 10.0
    } else {
      r = va + vb
    }
    out.push(r)
    i = i + 1
  }
  gpuElapsedMs = Math.max(1, Date.now() - t0)
  backendMode = "cpu"
  backendLabel = "CPU Compute Fallback"
  result = formatVector(out)
  updateOutputAnalytics(out)
  running = false
  log("Completed via CPU fallback (" + gpuElapsedMs + " ms): " + op.toUpperCase() + " over " + out.length + " floats (WebGPU adapter unavailable).")
}

function _fallbackOrError(res, fallbackOp) {
  if (res && res.error) {
    _cleanupResources()
    let msg = String(res.error)
    let lower = msg.toLowerCase()
    if (lower.indexOf("adapter") >= 0 || lower.indexOf("device") >= 0 || lower.indexOf("webgpu") >= 0 || lower.indexOf("gpu") >= 0 || lower.indexOf("not supported") >= 0) {
      gpuMissing = true
      executeCpuKernel(fallbackOp, _dataA, _dataB)
      return true
    }
    running = false
    log("Shader error: " + msg)
    result = msg
    return true
  }
  return false
}

function setKernelOp(op) {
  kernelOp = op
  currentWgsl = computeShaderCode(op)
  runAddition()
}

function loadBenchPreset(count) {
  if (count === 8) {
    inputA = "1, 2, 3, 4, 5, 6, 7, 8"
    inputB = "10, 20, 30, 40, 50, 60, 70, 80"
    log("Loaded 8-float vectors")
    runAddition()
    return
  }
  let a = []
  let b = []
  let i = 0
  while (i < count) {
    a.push(String((i % 17) + 1))
    b.push(String(((i * 3) % 19) + 0.5))
    i = i + 1
  }
  inputA = a.join(", ")
  inputB = b.join(", ")
  log("Loaded " + count + "-float benchmark vectors")
  runAddition()
}

function parseNumbers(str) {
  let parts = String(str || "").split(",")
  let nums = []
  let i = 0
  while (i < parts.length) {
    let n = parseFloat(parts[i].trim())
    if (!isNaN(n)) {
      nums.push(n)
    }
    i = i + 1
  }
  return nums
}

// ── Two-input WGSL compute kernels ──

function runAddition() {
  if (running) return
  let a = parseNumbers(inputA)
  let b = parseNumbers(inputB)

  if (a.length === 0 || b.length === 0) {
    log("Enter comma-separated numbers in both Vector A and Vector B.")
    return
  }
  if (a.length !== b.length) {
    log("Vector length mismatch: Vector A has " + a.length + " numbers, Vector B has " + b.length + ".")
    return
  }

  running = true
  gpuElapsedMs = 0
  currentWgsl = computeShaderCode(kernelOp)
  _len = a.length
  _dataA = a
  _dataB = b

  if (!hasGpuBridge()) {
    gpuMissing = true
    executeCpuKernel(kernelOp, _dataA, _dataB)
    return
  }

  log("Dispatching WebGPU " + kernelOp.toUpperCase() + " kernel...")
  try {
    softn.ai.gpu.requestDevice(function(dev) {
      if (_fallbackOrError(dev, kernelOp)) return
      deviceReady = true
      backendMode = "webgpu"
      backendLabel = "WebGPU Hardware"
      _addStep2()
    })
  } catch (e) {
    gpuMissing = true
    executeCpuKernel(kernelOp, _dataA, _dataB)
  }
}

function _addStep2() {
  softn.ai.gpu.createBuffer({ data: _dataA }, "storage", function(res) {
    if (_fallbackOrError(res, kernelOp)) return
    _bufAId = res.bufferId
    _addStep3()
  })
}

function _addStep3() {
  softn.ai.gpu.createBuffer({ data: _dataB }, "storage", function(res) {
    if (_fallbackOrError(res, kernelOp)) return
    _bufBId = res.bufferId
    _addStep4()
  })
}

function _addStep4() {
  softn.ai.gpu.createBuffer({ size: _len * 4 }, "storage", function(res) {
    if (_fallbackOrError(res, kernelOp)) return
    _bufOutId = res.bufferId
    _addStep5()
  })
}

function _addStep5() {
  let code = computeShaderCode(kernelOp)
  currentWgsl = code
  softn.ai.gpu.createShader({ code: code }, function(res) {
    if (_fallbackOrError(res, kernelOp)) return
    _shaderId = res.shaderId
    _addStep6()
  })
}

function _addStep6() {
  softn.ai.gpu.createPipeline({ shader: _shaderId }, function(res) {
    if (_fallbackOrError(res, kernelOp)) return
    _pipeId = res.pipelineId
    _addStep7()
  })
}

function _addStep7() {
  _dispatchAt = Date.now()
  let wgCount = Math.ceil(_len / 64)
  softn.ai.gpu.dispatch(_pipeId, [
    { binding: 0, buffer: _bufAId },
    { binding: 1, buffer: _bufBId },
    { binding: 2, buffer: _bufOutId }
  ], [wgCount, 1, 1], function(res) {
    if (_fallbackOrError(res, kernelOp)) return
    _addStep8()
  })
}

function _addStep8() {
  softn.ai.gpu.readBuffer(_bufOutId, function(res) {
    if (_fallbackOrError(res, kernelOp)) return
    gpuMissing = false
    backendMode = "webgpu"
    backendLabel = "WebGPU Hardware"
    gpuElapsedMs = _dispatchAt > 0 ? Math.max(1, Date.now() - _dispatchAt) : 1
    result = formatVector(res.data)
    updateOutputAnalytics(res.data)
    log("WebGPU dispatch complete (" + gpuElapsedMs + " ms): " + kernelOp.toUpperCase() + " over " + _len + " floats.")
    running = false
    _cleanupResources()
  })
}

function _cleanupResources() {
  try {
    if (_bufAId !== "") { softn.ai.gpu.release(_bufAId, function(r) {}) }
    if (_bufBId !== "") { softn.ai.gpu.release(_bufBId, function(r) {}) }
    if (_bufOutId !== "") { softn.ai.gpu.release(_bufOutId, function(r) {}) }
    if (_shaderId !== "") { softn.ai.gpu.release(_shaderId, function(r) {}) }
    if (_pipeId !== "") { softn.ai.gpu.release(_pipeId, function(r) {}) }
  } catch (e) {}
  _bufAId = ""
  _bufBId = ""
  _bufOutId = ""
  _shaderId = ""
  _pipeId = ""
}

// ── Inline Double Shader ──

function runInlineShader() {
  if (running) return
  let a = parseNumbers(inputA)
  _len = a.length
  if (_len === 0) {
    log("Enter comma-separated numbers in Vector A.")
    return
  }

  running = true
  gpuElapsedMs = 0
  currentWgsl = doubleShaderCode()
  _dataA = a
  _dataB = []

  if (!hasGpuBridge()) {
    gpuMissing = true
    executeCpuKernel("double", _dataA, [])
    return
  }

  log("Dispatching inline Double WGSL shader...")
  try {
    softn.ai.gpu.requestDevice(function(dev) {
      if (_fallbackOrError(dev, "double")) return
      deviceReady = true
      backendMode = "webgpu"
      backendLabel = "WebGPU Hardware"
      _mulStep2()
    })
  } catch (e) {
    gpuMissing = true
    executeCpuKernel("double", _dataA, [])
  }
}

function _mulStep2() {
  softn.ai.gpu.createBuffer({ data: _dataA }, "storage", function(res) {
    if (_fallbackOrError(res, "double")) return
    _bufAId = res.bufferId
    _mulStep3()
  })
}

function _mulStep3() {
  softn.ai.gpu.createBuffer({ size: _len * 4 }, "storage", function(res) {
    if (_fallbackOrError(res, "double")) return
    _bufOutId = res.bufferId
    _mulStep4()
  })
}

function _mulStep4() {
  let code = doubleShaderCode()
  currentWgsl = code
  softn.ai.gpu.createShader({ code: code }, function(res) {
    if (_fallbackOrError(res, "double")) return
    _shaderId = res.shaderId
    _mulStep5()
  })
}

function _mulStep5() {
  softn.ai.gpu.createPipeline({ shader: _shaderId }, function(res) {
    if (_fallbackOrError(res, "double")) return
    _pipeId = res.pipelineId
    _mulStep6()
  })
}

function _mulStep6() {
  _dispatchAt = Date.now()
  let wgCount = Math.ceil(_len / 64)
  softn.ai.gpu.dispatch(_pipeId, [
    { binding: 0, buffer: _bufAId },
    { binding: 1, buffer: _bufOutId }
  ], [wgCount, 1, 1], function(res) {
    if (_fallbackOrError(res, "double")) return
    _mulStep7()
  })
}

function _mulStep7() {
  softn.ai.gpu.readBuffer(_bufOutId, function(res) {
    if (_fallbackOrError(res, "double")) return
    gpuMissing = false
    backendMode = "webgpu"
    backendLabel = "WebGPU Hardware"
    gpuElapsedMs = _dispatchAt > 0 ? Math.max(1, Date.now() - _dispatchAt) : 1
    result = formatVector(res.data)
    updateOutputAnalytics(res.data)
    log("WebGPU inline shader complete (" + gpuElapsedMs + " ms): doubled " + _len + " values.")
    running = false
    _cleanupResources()
  })
}

function cleanup() {
  _cleanupResources()
  if (hasGpuBridge() && typeof softn.ai.gpu.releaseAll === "function") {
    try {
      softn.ai.gpu.releaseAll(function(res) {
        deviceReady = false
        log("All GPU buffers and pipelines released.")
      })
      return
    } catch (e) {}
  }
  deviceReady = false
  log("Compute buffers cleared.")
}

// ── Live Visual Particle Field Simulation ──

function initParticles(count) {
  let palette = ["#34d399", "#10b981", "#2dd4bf", "#38bdf8", "#a7f3d0"]
  let list = []
  let i = 0
  while (i < count) {
    let frac = i / count
    let ang = frac * Math.PI * 2
    let rad = 14 + (i % 7) * 5
    list.push({
      idx: i,
      x: 50 + Math.cos(ang) * rad,
      y: 50 + Math.sin(ang) * rad,
      vx: -Math.sin(ang) * 0.4,
      vy: Math.cos(ang) * 0.4,
      phase: frac * Math.PI * 4,
      size: 5 + (i % 4) * 2,
      color: palette[i % palette.length]
    })
    i = i + 1
  }
  simParticles = list
}

function setSimPreset(preset) {
  simPreset = preset
  if (!simRunning) {
    stepSimulation(0.032)
  }
}

function setSimCount(count) {
  simTargetCount = count
  initParticles(count)
}

function setSimSpeed(spd) {
  simSpeed = spd
}

function toggleSimRunning() {
  simRunning = !simRunning
}

function pulseSimField() {
  let next = []
  let i = 0
  while (i < simParticles.length) {
    let p = simParticles[i]
    let dx = p.x - 50
    let dy = p.y - 50
    let dist = Math.sqrt(dx * dx + dy * dy) + 0.5
    next.push({
      idx: p.idx,
      x: Math.max(6, Math.min(94, p.x + (dx / dist) * 12)),
      y: Math.max(8, Math.min(92, p.y + (dy / dist) * 12)),
      vx: (dx / dist) * 1.4,
      vy: (dy / dist) * 1.4,
      phase: p.phase + 0.9,
      size: p.size,
      color: p.color
    })
    i = i + 1
  }
  simParticles = next
}

function stepSimulation(rawDt) {
  let dt = typeof rawDt === "number" && rawDt > 0 ? Math.min(rawDt, 0.08) : 0.016
  _fpsAccum = _fpsAccum + dt
  _fpsFrames = _fpsFrames + 1
  if (_fpsAccum >= 0.4) {
    simFps = Math.max(1, Math.min(120, Math.round(_fpsFrames / _fpsAccum)))
    _fpsAccum = 0
    _fpsFrames = 0
  }

  simTime = simTime + dt * simSpeed
  let count = simParticles.length
  let next = []
  let i = 0
  while (i < count) {
    let p = simParticles[i]
    let nx = p.x
    let ny = p.y
    let nvx = p.vx
    let nvy = p.vy
    let frac = i / Math.max(1, count)

    if (simPreset === "vortex") {
      let ang = simTime * (0.9 + (i % 5) * 0.16) + frac * Math.PI * 2
      let r = 12 + (i % 8) * 4.4 + Math.sin(simTime * 1.8 + p.phase) * 3.5
      nx = 50 + Math.cos(ang) * r * 0.88
      ny = 50 + Math.sin(ang) * r * 0.72
    } else if (simPreset === "wave") {
      nx = 6 + frac * 88
      ny = 50 + Math.sin(frac * 9.0 + simTime * 2.6) * 26 + Math.cos(frac * 4.0 - simTime * 1.7) * 10
    } else if (simPreset === "attractor") {
      let ax = 50 + Math.cos(simTime * 1.1) * 22
      let ay = 50 + Math.sin(simTime * 1.5) * 18
      let dx = ax - p.x
      let dy = ay - p.y
      nvx = (p.vx + dx * dt * 2.2) * 0.94
      nvy = (p.vy + dy * dt * 2.2) * 0.94
      nx = p.x + nvx * simSpeed * 2.2
      ny = p.y + nvy * simSpeed * 2.2
    } else {
      let cols = 8
      let row = Math.floor(i / cols)
      let col = i % cols
      let rows = Math.max(1, Math.ceil(count / cols))
      let gx = 12 + (col / Math.max(1, cols - 1)) * 76
      let gy = 16 + (row / Math.max(1, rows - 1)) * 68
      let wave = Math.sin(simTime * 2.8 + col * 0.7 + row * 0.7)
      nx = gx + wave * 3.5
      ny = gy + Math.cos(simTime * 2.4 + col * 0.6 - row * 0.5) * 5.0
    }

    if (nx < 4) nx = 4
    if (nx > 96) nx = 96
    if (ny < 6) ny = 6
    if (ny > 94) ny = 94

    next.push({
      idx: p.idx,
      x: nx,
      y: ny,
      vx: nvx,
      vy: nvy,
      phase: p.phase,
      size: p.size,
      color: p.color
    })
    i = i + 1
  }
  simParticles = next
}

function _init() {
  currentWgsl = computeShaderCode(kernelOp)
  initParticles(simTargetCount)
  let navHasGpu = false
  try {
    navHasGpu = typeof navigator !== "undefined" && !!navigator.gpu
  } catch (e) {}
  if (navHasGpu && hasGpuBridge()) {
    backendMode = "webgpu"
    backendLabel = "WebGPU Available"
  } else {
    backendMode = "cpu"
    backendLabel = "CPU Fallback Ready"
  }
  runAddition()
}

function _onHide() {
  simRunning = false
  running = false
  cleanup()
}
