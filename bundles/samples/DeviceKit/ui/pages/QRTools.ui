// QRTools.ui - QR code generation and permission-gated scanning

<Stack direction=vertical gap=lg if={currentPage === "qr"}>
  <Stack direction=vertical gap=xs>
    <Box style={{ display: "flex", alignItems: "center", justifyContent: "space-between", flexWrap: "wrap", gap: "0.5rem" }}>
      <Heading level={2} style={{ fontSize: "1.3125rem", fontWeight: 700, color: "#0f172a" }}>QR Tools</Heading>
      <Stack direction=horizontal gap=xs align=center style={{ flexWrap: "wrap" }}>
        <Badge variant="success" size=sm>qr: Enabled</Badge>
        <Badge variant={capBadgeVariant(capMedia)} size=sm>{"camera: " + capMedia}</Badge>
      </Stack>
    </Box>
    <Text style={{ color: "#64748b", fontSize: "0.85rem" }}>Encode text or deep-links into crisp QR symbols and decode codes locally on-device.</Text>
  </Stack>

  <Grid columns={{ sm: 1, lg: 2 }} gap=lg>
    // QR Generator Card
    <Card padding=lg style={{ background: "#ffffff", borderRadius: "14px", border: "1px solid #e2e8f0", minWidth: 0 }}>
      <Stack direction=vertical gap=md>
        <Text fontWeight=semibold size=sm style={{ color: "#0f172a", textTransform: "uppercase", letterSpacing: "0.04em", fontSize: "0.75rem" }}>Generate QR Code</Text>

        <Input
          value={qrValue}
          @change={updateQrValue}
          placeholder="Enter text or URL..."
          style={{
            width: "100%",
            boxSizing: "border-box",
            padding: "0.6rem 0.8rem",
            borderRadius: "8px",
            border: "1px solid #cbd5e1",
            fontSize: "0.8125rem"
          }}
        />

        <Stack direction=horizontal gap=xs style={{ flexWrap: "wrap" }}>
          <Button variant=ghost size=sm @click={updateQrValue("https://softn.com")} style={{
            fontSize: "0.7rem", padding: "0.25rem 0.6rem", borderRadius: "6px", background: "#f1f5f9", color: "#334155"
          }}>softn.com</Button>
          <Button variant=ghost size=sm @click={updateQrValue("Hello from DeviceKit!")} style={{
            fontSize: "0.7rem", padding: "0.25rem 0.6rem", borderRadius: "6px", background: "#f1f5f9", color: "#334155"
          }}>Hello text</Button>
          <Button variant=ghost size=sm @click={updateQrValue("softn://app/devicekit")} style={{
            fontSize: "0.7rem", padding: "0.25rem 0.6rem", borderRadius: "6px", background: "#f1f5f9", color: "#334155"
          }}>Deep link</Button>
        </Stack>

        <Box style={{
          display: "flex",
          justifyContent: "center",
          padding: "1.25rem",
          background: "#ffffff",
          borderRadius: "12px",
          border: "1px solid #e2e8f0"
        }}>
          <QRCode value={qrValue || "https://softn.com"} size={176} />
        </Box>

        <Box style={{
          background: "#f8fafc",
          borderRadius: "8px",
          padding: "0.7rem 0.85rem",
          border: "1px solid #e2e8f0",
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          gap: "0.5rem"
        }}>
          <Box style={{ minWidth: 0, flex: 1 }}>
            <Text size=xs style={{ color: "#94a3b8", display: "block" }}>{"Encoded payload (" + (qrValue ? qrValue.length : 17) + " chars)"}</Text>
            <Text style={{ fontFamily: "monospace", fontSize: "0.75rem", color: "#334155", wordBreak: "break-all" }}>{qrValue || "https://softn.com"}</Text>
          </Box>
          <Button variant=outline size=xs @click={copyQrValue}>{qrCopied ? "Copied" : "Copy"}</Button>
        </Box>
      </Stack>
    </Card>

    // QR Scanner Card
    <Card padding=lg style={{ background: "#ffffff", borderRadius: "14px", border: "1px solid #e2e8f0", minWidth: 0 }}>
      <Stack direction=vertical gap=md>
        <Box style={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: "0.5rem" }}>
          <Text fontWeight=semibold size=sm style={{ color: "#0f172a", textTransform: "uppercase", letterSpacing: "0.04em", fontSize: "0.75rem" }}>Scan QR Code</Text>
          <Badge variant={scanning ? "info" : "secondary"} size=sm>{scanning ? "Camera Active" : "Standby"}</Badge>
        </Box>

        <Box style={{
          borderRadius: "12px",
          overflow: "hidden",
          border: "1px solid #e2e8f0",
          minHeight: "210px",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          background: "#f8fafc"
        }}>
          <QRReader if={scanning} onScan={handleScan} />
          <Stack if={!scanning} direction=vertical gap=sm align=center style={{ padding: "1.25rem", textAlign: "center" }}>
            <Box style={{
              width: "48px",
              height: "48px",
              borderRadius: "12px",
              background: "#e2e8f0",
              display: "flex",
              alignItems: "center",
              justifyContent: "center"
            }}>
              <Icon svg={iconSvg("scan", "#64748b")} size={22} />
            </Box>
            <Text size=xs style={{ color: "#64748b", maxWidth: "260px" }}>
              The camera stays off until you start scanning, and automatically releases when you leave or hide the app.
            </Text>
            <Stack direction=horizontal gap=xs style={{ flexWrap: "wrap", justifyContent: "center" }}>
              <Button variant=primary size=sm @click={startScanning} style={{
                background: "linear-gradient(135deg, #2563eb, #4f46e5)",
                color: "#ffffff",
                fontWeight: 600
              }}>{scannedCode ? "Scan With Camera" : "Start Camera Scan"}</Button>
              <Button variant=outline size=sm @click={simulateQrScan}>Simulate Scan</Button>
            </Stack>
          </Stack>
        </Box>

        <Stack if={scanning} direction=horizontal gap=sm align=center justify="space-between" style={{ flexWrap: "wrap" }}>
          <Text size=xs style={{ color: "#64748b", flex: 1 }}>Point camera at a QR code — stops automatically after first read.</Text>
          <Button variant=outline size=xs @click={stopScanning}>Stop Camera</Button>
        </Stack>

        <Text if={scanStatusNote !== ""} size=xs style={{ color: "#64748b" }}>{scanStatusNote}</Text>

        <Box if={scannedCode !== ""} style={{
          background: "#f0fdf4",
          borderRadius: "10px",
          padding: "0.875rem",
          border: "1px solid #bbf7d0"
        }}>
          <Box style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: "0.35rem", gap: "0.5rem" }}>
            <Text size=xs style={{ color: "#15803d", fontWeight: 600 }}>Decoded Payload</Text>
            <Stack direction=horizontal gap=xs>
              <Button variant=outline size=xs @click={copyScannedCode}>{scanCopied ? "Copied" : "Copy"}</Button>
              <Button variant=ghost size=xs @click={clearScannedCode}>Clear</Button>
            </Stack>
          </Box>
          <Text style={{ fontFamily: "monospace", fontSize: "0.8125rem", color: "#166534", wordBreak: "break-all" }}>{scannedCode}</Text>
        </Box>
      </Stack>
    </Card>
  </Grid>

  <Box style={{ display: "flex", alignItems: "flex-start", gap: "0.5rem", padding: "0 0.25rem" }}>
    <Icon svg={iconSvg("shield", "#64748b")} size={15} />
    <Text style={{ fontSize: "0.75rem", color: "#64748b", lineHeight: 1.5 }}>
      QR generation runs offline in memory; scanning mounts the camera only while active and tears down cleanly on tab change or app hide.
    </Text>
  </Box>
</Stack>
