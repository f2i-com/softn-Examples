// CameraDemo.ui - Permission-gated camera photo capture with headless test-card fallback

<Stack direction=vertical gap=lg if={currentPage === "camera"}>
  <Stack direction=vertical gap=xs>
    <Box style={{ display: "flex", alignItems: "center", justifyContent: "space-between", flexWrap: "wrap", gap: "0.5rem" }}>
      <Heading level={2} style={{ fontSize: "1.3125rem", fontWeight: 700, color: "#0f172a" }}>Camera Demo</Heading>
      <Stack direction=horizontal gap=xs align=center style={{ flexWrap: "wrap" }}>
        <Badge variant={capBadgeVariant(capMedia)} size=sm>{"mediaDevices: " + capMedia}</Badge>
        <Badge variant={cameraActive ? "info" : "secondary"} size=sm>{cameraActive ? "Stream Open" : "Stream Off"}</Badge>
      </Stack>
    </Box>
    <Text style={{ color: "#64748b", fontSize: "0.85rem" }}>Capture a local photo frame via camera permission, or generate a studio calibration frame when no webcam is attached.</Text>
  </Stack>

  <Grid columns={{ sm: 1, lg: 2 }} gap=lg>
    // Viewfinder Card
    <Card padding=lg style={{ background: "#ffffff", borderRadius: "14px", border: "1px solid #e2e8f0", minWidth: 0 }}>
      <Stack direction=vertical gap=md>
        <Box style={{ display: "flex", alignItems: "center", justifyContent: "space-between", flexWrap: "wrap", gap: "0.5rem" }}>
          <Text fontWeight=semibold size=sm style={{ color: "#0f172a", textTransform: "uppercase", letterSpacing: "0.04em", fontSize: "0.75rem" }}>Viewfinder</Text>
          <Stack direction=horizontal gap=xs>
            <Button variant={cameraActive ? "outline" : "primary"} size=xs @click={toggleCamera}>
              {cameraActive ? "Close Camera" : "Open Camera"}
            </Button>
            <Button variant=outline size=xs @click={generateTestFrame}>Test Frame</Button>
          </Stack>
        </Box>

        <Camera
          if={cameraActive}
          mode="photo"
          onCapture={handleCapture}
          style={{ width: "100%", borderRadius: "12px" }}
        />

        <Box if={!cameraActive} style={{
          borderRadius: "12px",
          border: "2px dashed #cbd5e1",
          minHeight: "240px",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          background: "#f8fafc",
          padding: "1.25rem"
        }}>
          <Stack direction=vertical gap=sm align=center style={{ textAlign: "center" }}>
            <Box style={{
              width: "48px",
              height: "48px",
              borderRadius: "12px",
              background: "#e2e8f0",
              display: "flex",
              alignItems: "center",
              justifyContent: "center"
            }}>
              <Icon svg={iconSvg("camera", "#64748b")} size={22} />
            </Box>
            <Text size=sm fontWeight=medium style={{ color: "#334155" }}>Camera Standby</Text>
            <Text size=xs style={{ color: "#64748b", maxWidth: "260px" }}>
              Click "Open Camera" to request webcam access, or "Test Frame" to verify capture handling on desktop/headless setups.
            </Text>
          </Stack>
        </Box>

        <Text size=xs style={{ color: "#64748b" }}>{cameraStatusText}</Text>
      </Stack>
    </Card>

    // Captured Photo Card
    <Card padding=lg style={{ background: "#ffffff", borderRadius: "14px", border: "1px solid #e2e8f0", minWidth: 0 }}>
      <Stack direction=vertical gap=md>
        <Box style={{ display: "flex", alignItems: "center", justifyContent: "space-between", flexWrap: "wrap", gap: "0.5rem" }}>
          <Text fontWeight=semibold size=sm style={{ color: "#0f172a", textTransform: "uppercase", letterSpacing: "0.04em", fontSize: "0.75rem" }}>Captured Frame</Text>
          <Text if={capturedMeta !== ""} size=xs style={{ color: "#64748b", fontFamily: "monospace" }}>{capturedMeta}</Text>
        </Box>

        <Box if={capturedPhoto !== ""} style={{
          borderRadius: "12px",
          overflow: "hidden",
          border: "1px solid #e2e8f0",
          minHeight: "240px",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          background: "#0f172a"
        }}>
          <Image src={capturedPhoto} alt="Captured frame" style={{
            maxWidth: "100%",
            maxHeight: "340px",
            objectFit: "contain"
          }} />
        </Box>

        <Box if={capturedPhoto === ""} style={{
          borderRadius: "12px",
          border: "2px dashed #e2e8f0",
          minHeight: "240px",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          background: "#f8fafc",
          padding: "1.25rem"
        }}>
          <Stack direction=vertical gap=xs align=center style={{ textAlign: "center" }}>
            <Text size=sm style={{ color: "#94a3b8" }}>No frame captured yet</Text>
            <Text size=xs style={{ color: "#94a3b8" }}>Frames stay in local memory until saved or cleared</Text>
          </Stack>
        </Box>

        <Box if={capturedPhoto !== ""} style={{
          background: "#f0fdf4",
          borderRadius: "8px",
          padding: "0.625rem 0.75rem",
          border: "1px solid #bbf7d0",
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          gap: "0.75rem",
          flexWrap: "wrap"
        }}>
          <Text size=xs style={{ color: "#15803d", fontWeight: 500 }}>Ready to save locally.</Text>
          <Box style={{ display: "flex", alignItems: "center", gap: "0.5rem" }}>
            <a
              href={capturedPhoto}
              download="devicekit-capture.svg"
              style={{ display: "inline-flex", alignItems: "center", gap: "0.35rem", fontSize: "0.75rem", fontWeight: 600, color: "#15803d", textDecoration: "none", padding: "0.25rem 0.65rem", borderRadius: "6px", border: "1px solid #bbf7d0", background: "#ffffff" }}
            ><Icon name="download" size={13} color="#15803d" />Save</a>
            <Button variant=ghost size=xs @click={clearPhoto}>Clear</Button>
          </Box>
        </Box>
      </Stack>
    </Card>
  </Grid>

  <Box style={{ display: "flex", alignItems: "flex-start", gap: "0.5rem", padding: "0 0.25rem" }}>
    <Icon svg={iconSvg("shield", "#64748b")} size={15} />
    <Text style={{ fontSize: "0.75rem", color: "#64748b", lineHeight: 1.5 }}>
      Camera streams are unmounted automatically when leaving this tab or when _onHide() fires. Nothing is uploaded.
    </Text>
  </Box>
</Stack>
