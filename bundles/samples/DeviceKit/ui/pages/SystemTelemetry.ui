// SystemTelemetry.ui - Hardware, sensor, clipboard, vibration, storage & media capability matrix

<Stack direction=vertical gap=lg if={currentPage === "telemetry"}>
  <Loop interval={1000} running={currentPage === "telemetry" && telemetryActive} @tick={tickTelemetry} />

  <Stack direction=vertical gap=xs>
    <Box style={{ display: "flex", alignItems: "center", justifyContent: "space-between", flexWrap: "wrap", gap: "0.5rem" }}>
      <Heading level={2} style={{ fontSize: "1.3125rem", fontWeight: 700, color: "#0f172a" }}>Capabilities & Telemetry</Heading>
      <Stack direction=horizontal gap=xs align=center>
        <Badge variant={telemetryActive ? "success" : "secondary"} size=sm>
          {telemetryActive ? ("Live · " + telemetryTicks + "s") : "Paused"}
        </Badge>
        <Button variant=outline size=xs @click={toggleTelemetryLive}>
          {telemetryActive ? "Pause Polling" : "Resume Polling"}
        </Button>
      </Stack>
    </Box>
    <Text style={{ color: "#64748b", fontSize: "0.85rem" }}>
      Graceful capability detection across desktop, mobile, and headless browsers — unsupported or permission-gated APIs degrade cleanly without errors.
    </Text>
  </Stack>

  // Live Environment Readout Grid
  <Grid columns={{ sm: 1, md: 2, lg: 3 }} gap=md>
    <Card padding=md style={{ background: "#ffffff", borderRadius: "12px", border: "1px solid #e2e8f0" }}>
      <Stack direction=vertical gap=xs>
        <Text size=xs style={{ color: "#64748b", textTransform: "uppercase", letterSpacing: "0.04em" }}>Viewport & Scale</Text>
        <Text style={{ fontFamily: "monospace", fontSize: "1rem", fontWeight: 700, color: "#0f172a" }}>{telViewport}</Text>
        <Text size=xs style={{ color: "#94a3b8" }}>{"Device pixel ratio: " + telPixelRatio}</Text>
      </Stack>
    </Card>

    <Card padding=md style={{ background: "#ffffff", borderRadius: "12px", border: "1px solid #e2e8f0" }}>
      <Stack direction=vertical gap=xs>
        <Text size=xs style={{ color: "#64748b", textTransform: "uppercase", letterSpacing: "0.04em" }}>Compute & Memory</Text>
        <Text style={{ fontFamily: "monospace", fontSize: "1rem", fontWeight: 700, color: "#0f172a" }}>{telCores}</Text>
        <Text size=xs style={{ color: "#94a3b8" }}>{"Memory hint: " + telMemory}</Text>
      </Stack>
    </Card>

    <Card padding=md style={{ background: "#ffffff", borderRadius: "12px", border: "1px solid #e2e8f0" }}>
      <Stack direction=vertical gap=xs>
        <Text size=xs style={{ color: "#64748b", textTransform: "uppercase", letterSpacing: "0.04em" }}>Network & Locale</Text>
        <Text style={{ fontFamily: "monospace", fontSize: "1rem", fontWeight: 700, color: "#0f172a" }}>{telOnline + " · " + telLocale}</Text>
        <Text size=xs style={{ color: "#94a3b8" }}>Auto-pauses on _onHide() lifecycle</Text>
      </Stack>
    </Card>
  </Grid>

  // Interactive Hardware / API Capability Cards
  <Grid columns={{ sm: 1, lg: 2 }} gap=md>
    // Clipboard Card
    <Card padding=lg style={{ background: "#ffffff", borderRadius: "14px", border: "1px solid #e2e8f0", minWidth: 0 }}>
      <Stack direction=vertical gap=sm>
        <Box style={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: "0.5rem" }}>
          <Stack direction=horizontal gap=sm align=center>
            <Icon svg={iconSvg("clipboard", "#2563eb")} size={18} />
            <Text fontWeight=semibold style={{ color: "#0f172a", fontSize: "0.9rem" }}>Clipboard API</Text>
          </Stack>
          <Badge variant={capBadgeVariant(capClipboard)} size=sm>{capClipboard}</Badge>
        </Box>
        <Text size=xs style={{ color: "#64748b" }}>{telClipboardNote}</Text>
        <Box>
          <Button variant=outline size=xs @click={testClipboardProbe}>Test Clipboard Write</Button>
        </Box>
      </Stack>
    </Card>

    // Vibration / Haptics Card
    <Card padding=lg style={{ background: "#ffffff", borderRadius: "14px", border: "1px solid #e2e8f0", minWidth: 0 }}>
      <Stack direction=vertical gap=sm>
        <Box style={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: "0.5rem" }}>
          <Stack direction=horizontal gap=sm align=center>
            <Icon svg={iconSvg("vibrate", "#2563eb")} size={18} />
            <Text fontWeight=semibold style={{ color: "#0f172a", fontSize: "0.9rem" }}>Haptics & Vibration</Text>
          </Stack>
          <Badge variant={capBadgeVariant(capVibrate)} size=sm>{capVibrate}</Badge>
        </Box>
        <Text size=xs style={{ color: "#64748b" }}>{telVibrateNote}</Text>
        <Box>
          <Button variant=outline size=xs @click={testVibrateProbe}>Pulse Haptics</Button>
        </Box>
      </Stack>
    </Card>

    // Storage Card
    <Card padding=lg style={{ background: "#ffffff", borderRadius: "14px", border: "1px solid #e2e8f0", minWidth: 0 }}>
      <Stack direction=vertical gap=sm>
        <Box style={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: "0.5rem" }}>
          <Stack direction=horizontal gap=sm align=center>
            <Icon svg={iconSvg("database", "#2563eb")} size={18} />
            <Text fontWeight=semibold style={{ color: "#0f172a", fontSize: "0.9rem" }}>Browser Storage</Text>
          </Stack>
          <Badge variant={capBadgeVariant(capStorage)} size=sm>{capStorage}</Badge>
        </Box>
        <Text size=xs style={{ color: "#64748b" }}>{telStorageProbe}</Text>
        <Box>
          <Button variant=outline size=xs @click={testStorageProbe}>Re-verify Storage</Button>
        </Box>
      </Stack>
    </Card>

    // Media & Sensors Card
    <Card padding=lg style={{ background: "#ffffff", borderRadius: "14px", border: "1px solid #e2e8f0", minWidth: 0 }}>
      <Stack direction=vertical gap=sm>
        <Box style={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: "0.5rem" }}>
          <Stack direction=horizontal gap=sm align=center>
            <Icon svg={iconSvg("cpu", "#2563eb")} size={18} />
            <Text fontWeight=semibold style={{ color: "#0f172a", fontSize: "0.9rem" }}>Media & Motion Sensors</Text>
          </Stack>
          <Badge variant={capBadgeVariant(capMotion)} size=sm>{capMotion}</Badge>
        </Box>
        <Text size=xs style={{ color: "#64748b" }}>
          {"Camera: " + capMedia + " · Motion/Geo: " + capMotion + " · Network: " + capNet}
        </Text>
        <Box>
          <Button variant=outline size=xs @click={probeCapabilities}>Refresh Probes</Button>
        </Box>
      </Stack>
    </Card>
  </Grid>
</Stack>
