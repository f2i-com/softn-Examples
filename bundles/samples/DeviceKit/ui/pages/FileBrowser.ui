// FileBrowser.ui - Scoped file chooser, interactive file list, and content preview

<Stack direction=vertical gap=lg if={currentPage === "files"}>
  <Stack direction=vertical gap=xs>
    <Box style={{ display: "flex", alignItems: "center", justifyContent: "space-between", flexWrap: "wrap", gap: "0.5rem" }}>
      <Heading level={2} style={{ fontSize: "1.3125rem", fontWeight: 700, color: "#0f172a" }}>File Browser</Heading>
      <Badge variant={capBadgeVariant(capFiles)} size=sm>{"files (user_selected): " + capFiles}</Badge>
    </Box>
    <Text style={{ color: "#64748b", fontSize: "0.85rem" }}>Select files from your device or load sample sandbox files to inspect metadata and preview text or images.</Text>
  </Stack>

  <Card padding=lg style={{ background: "#ffffff", borderRadius: "14px", border: "1px solid #e2e8f0", minWidth: 0 }}>
    <Stack direction=vertical gap=md>
      <Box style={{ display: "flex", alignItems: "center", justifyContent: "space-between", flexWrap: "wrap", gap: "0.5rem" }}>
        <Text fontWeight=semibold size=sm style={{ color: "#0f172a", textTransform: "uppercase", letterSpacing: "0.04em", fontSize: "0.75rem" }}>Select Files</Text>
        <Stack direction=horizontal gap=xs>
          <Button variant=outline size=xs @click={loadSampleFile}>Load Sample Files</Button>
          <Button if={selectedFiles.length > 0} variant=ghost size=xs @click={clearSelectedFiles}>Clear</Button>
        </Stack>
      </Box>

      <Box style={{
        borderRadius: "12px",
        border: "2px dashed #cbd5e1",
        padding: "1.25rem",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        background: "#f8fafc"
      }}>
        <FileChooser onSelect={handleFileSelect} multiple={true} />
      </Box>
    </Stack>
  </Card>

  <Grid columns={{ sm: 1, lg: 2 }} gap=lg>
    // Selected Files List
    <Card padding=lg style={{ background: "#ffffff", borderRadius: "14px", border: "1px solid #e2e8f0", minWidth: 0 }}>
      <Stack direction=vertical gap=md>
        <Stack direction=horizontal justify="space-between" align=center>
          <Text fontWeight=semibold size=sm style={{ color: "#0f172a", textTransform: "uppercase", letterSpacing: "0.04em", fontSize: "0.75rem" }}>Selected Files</Text>
          <Badge variant=secondary size=sm>{selectedFiles.length + " selected"}</Badge>
        </Stack>

        <Box if={selectedFiles.length > 0} style={{
          background: "#f8fafc",
          borderRadius: "10px",
          border: "1px solid #e2e8f0",
          maxHeight: "280px",
          overflow: "auto"
        }}>
          #each (item in selectedFiles)
            <Box
              @click={inspectFileAt(item.idx)}
              style={{
                padding: "0.75rem 0.9rem",
                borderBottom: "1px solid #e2e8f0",
                background: selectedFileIndex === item.idx ? "#eff6ff" : "transparent",
                display: "flex",
                alignItems: "center",
                gap: "0.75rem",
                cursor: "pointer"
              }}
            >
              <Box style={{
                width: "32px",
                height: "32px",
                borderRadius: "8px",
                background: selectedFileIndex === item.idx ? "#dbeafe" : "#f1f5f9",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                flexShrink: 0
              }}>
                <Icon svg={iconSvg("file", "#2563eb")} size={16} />
              </Box>
              <Stack direction=vertical gap=xs style={{ flex: 1, minWidth: 0 }}>
                <Text size=sm fontWeight=medium style={{ color: "#0f172a", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{item.name}</Text>
                <Text size=xs style={{ color: "#64748b" }}>{(item.type || "unknown MIME") + " · " + formatBytes(item.size)}</Text>
              </Stack>
            </Box>
          #end
        </Box>

        <Box if={selectedFiles.length === 0} style={{
          background: "#f8fafc",
          borderRadius: "10px",
          padding: "2rem 1rem",
          border: "1px solid #e2e8f0",
          textAlign: "center"
        }}>
          <Text size=sm style={{ color: "#94a3b8" }}>No files selected yet. Pick a file above or click "Load Sample Files".</Text>
        </Box>
      </Stack>
    </Card>

    // File Content Preview
    <Card padding=lg style={{ background: "#ffffff", borderRadius: "14px", border: "1px solid #e2e8f0", minWidth: 0 }}>
      <Stack direction=vertical gap=md>
        <Box style={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: "0.5rem", flexWrap: "wrap" }}>
          <Text fontWeight=semibold size=sm style={{ color: "#0f172a", textTransform: "uppercase", letterSpacing: "0.04em", fontSize: "0.75rem" }}>Content Preview</Text>
          <Text if={selectedFileName !== ""} size=xs style={{ color: "#64748b", fontFamily: "monospace" }}>{selectedFileName}</Text>
        </Box>

        <Box if={fileIsImage && filePreviewUrl !== ""} style={{
          background: "#f8fafc",
          borderRadius: "10px",
          padding: "1rem",
          border: "1px solid #e2e8f0",
          maxHeight: "360px",
          overflow: "auto",
          display: "flex",
          alignItems: "center",
          justifyContent: "center"
        }}>
          <Image src={filePreviewUrl} alt="File preview" style={{
            maxWidth: "100%",
            maxHeight: "320px",
            borderRadius: "8px",
            objectFit: "contain"
          }} />
        </Box>

        <Box if={!fileIsImage && fileContent !== ""} style={{
          background: "#0f172a",
          borderRadius: "10px",
          padding: "0.875rem 1rem",
          border: "1px solid #1e293b",
          maxHeight: "360px",
          overflow: "auto"
        }}>
          <Text style={{
            fontFamily: "monospace",
            fontSize: "0.75rem",
            lineHeight: 1.6,
            color: "#e2e8f0",
            whiteSpace: "pre-wrap",
            wordBreak: "break-word"
          }}>{fileContent}</Text>
        </Box>

        <Box if={fileContent === "" && filePreviewUrl === ""} style={{
          background: "#f8fafc",
          borderRadius: "10px",
          padding: "2rem 1rem",
          border: "1px solid #e2e8f0",
          textAlign: "center"
        }}>
          <Stack direction=vertical gap=sm align=center>
            <Box style={{
              width: "44px",
              height: "44px",
              borderRadius: "12px",
              background: "#e2e8f0",
              display: "flex",
              alignItems: "center",
              justifyContent: "center"
            }}>
              <Icon svg={iconSvg("file-text", "#64748b")} size={20} />
            </Box>
            <Text size=sm style={{ color: "#64748b" }}>{fileReadNote || "Select a file to inspect its contents"}</Text>
          </Stack>
        </Box>
      </Stack>
    </Card>
  </Grid>

  <Box style={{ display: "flex", alignItems: "flex-start", gap: "0.5rem", padding: "0 0.25rem" }}>
    <Icon svg={iconSvg("shield", "#64748b")} size={15} />
    <Text style={{ fontSize: "0.75rem", color: "#64748b", lineHeight: 1.5 }}>
      Scoped to files.scopes: ["user_selected"]. Arbitrary filesystem paths cannot be read.
    </Text>
  </Box>
</Stack>
