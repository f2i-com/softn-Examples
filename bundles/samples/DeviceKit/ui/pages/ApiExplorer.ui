// ApiExplorer.ui - Network API fetch demo with host-permission verification

<Stack direction=vertical gap=lg if={currentPage === "api"}>
  <Stack direction=vertical gap=xs>
    <Box style={{ display: "flex", alignItems: "center", justifyContent: "space-between", flexWrap: "wrap", gap: "0.5rem" }}>
      <Heading level={2} style={{ fontSize: "1.3125rem", fontWeight: 700, color: "#0f172a" }}>API Explorer</Heading>
      <Stack direction=horizontal gap=xs align=center style={{ flexWrap: "wrap" }}>
        <Badge variant={capBadgeVariant(capNet)} size=sm>{"net: " + capNet}</Badge>
        <Badge variant={isAllowedApiHost(apiUrl) ? "success" : "warning"} size=sm>
          {isAllowedApiHost(apiUrl) ? "Host Allowed" : "Outside Allowlist"}
        </Badge>
      </Stack>
    </Box>
    <Text style={{ color: "#64748b", fontSize: "0.85rem" }}>Make host-scoped HTTPS requests via softn.net.fetch and inspect response timing and payload.</Text>
  </Stack>

  // Request Card
  <Card padding=lg style={{ background: "#ffffff", borderRadius: "14px", border: "1px solid #e2e8f0", minWidth: 0 }}>
    <Stack direction=vertical gap=md>
      <Text fontWeight=semibold size=sm style={{ color: "#0f172a", textTransform: "uppercase", letterSpacing: "0.04em", fontSize: "0.75rem" }}>Request Builder</Text>

      <Stack className="dk-url-row" direction=horizontal gap=sm align=center style={{ flexWrap: "wrap", minWidth: 0 }}>
        <Stack direction=horizontal gap=xs align=center style={{ flexShrink: 0 }}>
          <Button variant={apiMethod === "GET" ? "primary" : "outline"} size=xs @click={setApiMethod("GET")}>GET</Button>
          <Button variant={apiMethod === "POST" ? "primary" : "outline"} size=xs @click={setApiMethod("POST")}>POST</Button>
        </Stack>
        <Input
          value={apiUrl}
          @change={updateApiUrl}
          placeholder="https://jsonplaceholder.typicode.com/todos/1"
          style={{
            flex: 1,
            minWidth: "0",
            width: "100%",
            boxSizing: "border-box",
            padding: "0.6rem 0.8rem",
            borderRadius: "8px",
            border: "1px solid #cbd5e1",
            fontSize: "0.8125rem",
            fontFamily: "monospace"
          }}
        />
        <Button variant=primary @click={fetchApi} style={{
          padding: "0.6rem 1.25rem",
          borderRadius: "8px",
          background: "linear-gradient(135deg, #2563eb, #4f46e5)",
          color: "#ffffff",
          fontWeight: 600,
          fontSize: "0.8125rem",
          flexShrink: 0
        }}>
          {apiLoading ? "Sending..." : "Send Request"}
        </Button>
      </Stack>

      <Box if={apiMethod === "POST"}>
        <Text size=xs style={{ color: "#64748b", marginBottom: "0.35rem", display: "block" }}>JSON Payload</Text>
        <TextArea
          value={apiRequestBody}
          @change={updateApiBody}
          rows={4}
          style={{
            width: "100%",
            boxSizing: "border-box",
            fontFamily: "monospace",
            fontSize: "0.78rem",
            borderRadius: "8px",
            border: "1px solid #cbd5e1"
          }}
        />
      </Box>

      // Preset URLs
      <Stack direction=horizontal gap=xs style={{ flexWrap: "wrap", alignItems: "center" }}>
        <Text size=xs style={{ color: "#94a3b8", marginRight: "0.25rem" }}>Presets:</Text>
        <Button variant=ghost size=sm @click={updateApiUrl("https://jsonplaceholder.typicode.com/todos/1")} style={{
          fontSize: "0.7rem",
          padding: "0.25rem 0.6rem",
          borderRadius: "6px",
          background: "#f1f5f9",
          color: "#334155"
        }}>/todos/1</Button>
        <Button variant=ghost size=sm @click={updateApiUrl("https://jsonplaceholder.typicode.com/posts/1")} style={{
          fontSize: "0.7rem",
          padding: "0.25rem 0.6rem",
          borderRadius: "6px",
          background: "#f1f5f9",
          color: "#334155"
        }}>/posts/1</Button>
        <Button variant=ghost size=sm @click={updateApiUrl("https://jsonplaceholder.typicode.com/users/1")} style={{
          fontSize: "0.7rem",
          padding: "0.25rem 0.6rem",
          borderRadius: "6px",
          background: "#f1f5f9",
          color: "#334155"
        }}>/users/1</Button>
        <Button variant=ghost size=sm @click={updateApiUrl("https://example.com")} style={{
          fontSize: "0.7rem",
          padding: "0.25rem 0.6rem",
          borderRadius: "6px",
          background: "#fef2f2",
          color: "#b91c1c"
        }}>Blocked host test</Button>
      </Stack>
    </Stack>
  </Card>

  <Card padding=md if={apiLoading} style={{ background: "#eff6ff", borderRadius: "12px", border: "1px solid #bfdbfe" }}>
    <Text style={{ color: "#2563eb", fontSize: "0.85rem", fontWeight: 500 }}>Awaiting response from remote host...</Text>
  </Card>

  <Card padding=md if={apiError !== ""} style={{ background: "#fef2f2", borderRadius: "12px", border: "1px solid #fecaca" }}>
    <Stack direction=vertical gap=xs>
      <Text style={{ color: "#991b1b", fontSize: "0.8125rem", fontWeight: 600 }}>Request Blocked or Failed</Text>
      <Text style={{ color: "#b91c1c", fontSize: "0.8125rem", wordBreak: "break-word" }}>{apiError}</Text>
    </Stack>
  </Card>

  <Card padding=lg if={apiResult !== ""} style={{ background: "#ffffff", borderRadius: "14px", border: "1px solid #e2e8f0", minWidth: 0 }}>
    <Stack direction=vertical gap=md>
      <Box style={{ display: "flex", flexWrap: "wrap", justifyContent: "space-between", alignItems: "center", gap: "0.5rem" }}>
        <Text fontWeight=semibold size=sm style={{ color: "#0f172a", textTransform: "uppercase", letterSpacing: "0.04em", fontSize: "0.75rem" }}>Response</Text>
        <Stack direction=horizontal gap=xs align=center style={{ flexWrap: "wrap" }}>
          <Text size=xs style={{ color: "#64748b", fontFamily: "monospace" }}>{apiElapsedMs + " ms · " + formatBytes(apiBytes)}</Text>
          <Badge variant={apiOk ? "success" : "error"} size=sm>{apiStatus + (apiOk ? " OK" : "")}</Badge>
          <Button variant=outline size=xs @click={copyApiResult}>{apiCopied ? "Copied" : (apiCopyFeedback ? apiCopyFeedback : "Copy JSON")}</Button>
        </Stack>
      </Box>

      <Box style={{
        background: "#0f172a",
        borderRadius: "10px",
        padding: "0.875rem 1rem",
        border: "1px solid #1e293b",
        maxHeight: "360px",
        overflow: "auto"
      }}>
        <Text style={{
          fontFamily: "monospace",
          fontSize: "0.78rem",
          lineHeight: 1.6,
          color: "#e2e8f0",
          whiteSpace: "pre-wrap",
          wordBreak: "break-word"
        }}>{apiResult}</Text>
      </Box>
    </Stack>
  </Card>

  <Box style={{ display: "flex", alignItems: "flex-start", gap: "0.5rem", padding: "0 0.25rem" }}>
    <Icon svg={iconSvg("shield", "#64748b")} size={15} />
    <Text style={{ fontSize: "0.75rem", color: "#64748b", lineHeight: 1.5 }}>
      Gated by permission.json net.allowed_hosts: ["jsonplaceholder.typicode.com"] (HTTPS only). Try the "Blocked host test" preset to verify sandbox enforcement.
    </Text>
  </Box>
</Stack>
