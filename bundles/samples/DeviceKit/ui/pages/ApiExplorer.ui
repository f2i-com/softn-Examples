// ApiExplorer.ui - Network API fetch demo
// Input for URL, fetch button, result display area

<Stack direction=vertical gap=lg if={currentPage === "api"}>
  // Header
  <Stack direction=vertical gap=sm>
    <Heading level={2} style={{ fontSize: "1.375rem", fontWeight: 600, color: "#0f172a" }}>API Explorer</Heading>
    <Text style={{ color: "#64748b", fontSize: "0.875rem" }}>Make HTTP requests using softn.net.fetch and view responses.</Text>
  </Stack>

  // Request Card
  <Card padding=lg style={{ background: "#ffffff", borderRadius: "14px", border: "1px solid #e2e8f0" }}>
    <Stack direction=vertical gap=md>
      <Text fontWeight=semibold size=sm style={{ color: "#0f172a", textTransform: "uppercase", letterSpacing: "0.04em", fontSize: "0.75rem" }}>Request</Text>

      // URL Input Row
      <Stack direction=horizontal gap=sm align=center style={{ flexWrap: "wrap" }}>
        <Stack direction=horizontal gap=xs align=center style={{ flexShrink: 0 }}>
          <Button variant={apiMethod === "GET" ? "primary" : "outline"} size=xs @click={setApiMethod("GET")}>GET</Button>
          <Button variant={apiMethod === "POST" ? "primary" : "outline"} size=xs @click={setApiMethod("POST")}>POST</Button>
        </Stack>
        <Input
          value={apiUrl}
          @change={updateApiUrl}
          placeholder="Enter API URL..."
          style={{
            flex: 1,
            minWidth: "200px",
            padding: "0.625rem 0.875rem",
            borderRadius: "8px",
            border: "1px solid #e2e8f0",
            fontSize: "0.8125rem",
            fontFamily: "monospace"
          }}
        />
        <Button variant=primary @click={fetchApi()} style={{
          padding: "0.625rem 1.25rem",
          borderRadius: "8px",
          background: "linear-gradient(135deg, #3b82f6, #6366f1)",
          color: "#ffffff",
          fontWeight: 600,
          fontSize: "0.8125rem",
          flexShrink: 0
        }}>
          {apiLoading ? "Sending..." : "Send"}
        </Button>
      </Stack>

      <Box if={apiMethod === "POST"}>
        <Text size=xs style={{ color: "#64748b", marginBottom: "0.35rem", display: "block" }}>JSON Body</Text>
        <TextArea
          value={apiRequestBody}
          @change={updateApiBody}
          rows={4}
          style={{
            width: "100%",
            boxSizing: "border-box",
            fontFamily: "monospace",
            fontSize: "0.78rem",
            borderRadius: "8px",
            border: "1px solid #e2e8f0"
          }}
        />
      </Box>

      // Preset URLs
      <Stack direction=horizontal gap=sm style={{ flexWrap: "wrap" }}>
        <Text size=xs style={{ color: "#94a3b8", alignSelf: "center" }}>Presets:</Text>
        <Button variant=ghost size=sm @click={updateApiUrl("https://jsonplaceholder.typicode.com/todos/1")} style={{
          fontSize: "0.6875rem",
          padding: "0.25rem 0.625rem",
          borderRadius: "6px",
          background: "#f1f5f9",
          color: "#475569"
        }}>
          /todos/1
        </Button>
        <Button variant=ghost size=sm @click={updateApiUrl("https://jsonplaceholder.typicode.com/posts/1")} style={{
          fontSize: "0.6875rem",
          padding: "0.25rem 0.625rem",
          borderRadius: "6px",
          background: "#f1f5f9",
          color: "#475569"
        }}>
          /posts/1
        </Button>
        <Button variant=ghost size=sm @click={updateApiUrl("https://jsonplaceholder.typicode.com/users/1")} style={{
          fontSize: "0.6875rem",
          padding: "0.25rem 0.625rem",
          borderRadius: "6px",
          background: "#f1f5f9",
          color: "#475569"
        }}>
          /users/1
        </Button>
        <Button variant=ghost size=sm @click={updateApiUrl("https://jsonplaceholder.typicode.com/comments?postId=1")} style={{
          fontSize: "0.6875rem",
          padding: "0.25rem 0.625rem",
          borderRadius: "6px",
          background: "#f1f5f9",
          color: "#475569"
        }}>
          /comments?postId=1
        </Button>
      </Stack>
    </Stack>
  </Card>

  // Loading Indicator
  <Card padding=md if={apiLoading} style={{ background: "#eff6ff", borderRadius: "14px", border: "1px solid #bfdbfe" }}>
    <Stack direction=horizontal gap=sm align=center>
      <Text style={{ color: "#3b82f6", fontSize: "0.875rem" }}>Loading response...</Text>
    </Stack>
  </Card>

  // Response Card
  <Card padding=lg if={apiError} style={{ background: "#fff5f5", borderRadius: "14px", border: "1px solid #fecaca" }}>
    <Text style={{ color: "#b91c1c", fontSize: "0.875rem" }}>{apiError}</Text>
  </Card>

  <Card padding=lg if={apiResult} style={{ background: "#ffffff", borderRadius: "14px", border: "1px solid #e2e8f0" }}>
    <Stack direction=vertical gap=md>
      <Stack direction=horizontal justify="space-between" align=center>
        <Text fontWeight=semibold size=sm style={{ color: "#0f172a", textTransform: "uppercase", letterSpacing: "0.04em", fontSize: "0.75rem" }}>Response</Text>
        <Stack direction=horizontal gap=sm align=center>
          <Text size=xs style={{ color: "#64748b", fontFamily: "monospace" }}>{apiElapsedMs + " ms · " + formatBytes(apiBytes)}</Text>
          <Badge variant={apiOk ? "success" : "error"} size=sm>{apiStatus + (apiOk ? " OK" : "")}</Badge>
          <Button variant=outline size=xs @click={copyApiResult}>{apiCopied ? "Copied" : "Copy"}</Button>
        </Stack>
      </Stack>

      // Response Body
      <Box style={{
        background: "#f8fafc",
        borderRadius: "10px",
        padding: "1rem",
        border: "1px solid #e2e8f0",
        maxHeight: "400px",
        overflow: "auto"
      }}>
        <Text style={{
          fontFamily: "monospace",
          fontSize: "0.8125rem",
          lineHeight: 1.6,
          color: "#334155",
          whiteSpace: "pre-wrap",
          wordBreak: "break-all"
        }}>{apiResult}</Text>
      </Box>
    </Stack>
  </Card>

  // Permission note
  <Box style={{ display: "flex", alignItems: "center", gap: "0.5rem", padding: "0 0.25rem" }}>
    <Icon svg={iconSvg("shield", "#94a3b8")} size={14} />
    <Text style={{ fontSize: "0.75rem", color: "#94a3b8" }}>This page uses the network permission for jsonplaceholder.typicode.com only. Requests to any other host are blocked.</Text>
  </Box>
</Stack>
