// main.ui - SoftN Showcase
// Interactive demo of UI controls, charts, animations, drag/drop, and PBR 3D scenes

<logic src="../logic/main.logic" />

// Import components
<import Nav from="./components/Nav.ui" />

// Import pages
<import ChartsPage from="./pages/ChartsPage.ui" />
<import AnimationsPage from="./pages/AnimationsPage.ui" />
<import InteractivePage from="./pages/InteractivePage.ui" />
<import ControlsPage from="./pages/ControlsPage.ui" />
<import Scene3DPage from="./pages/Scene3DPage.ui" />

<style>
/* Custom scrollbar */
::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(99, 102, 241, 0.15); border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: rgba(99, 102, 241, 0.3); }

/* Focus rings */
*:focus-visible {
  outline: 2px solid rgba(99, 102, 241, 0.4);
  outline-offset: 2px;
}

/* NavItem active indicator */
.softn-nav-item { position: relative; transition: all 180ms ease; }
.softn-nav-item:hover { transform: translateX(2px); }
.softn-nav-item[data-active="true"]::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 60%;
  background: linear-gradient(180deg, #6366f1, #8b5cf6);
  border-radius: 0 3px 3px 0;
}

/* Card hover */
.softn-page-content [class*="card"] {
  transition: transform 200ms ease, box-shadow 200ms ease !important;
}

.showcase-3d-stage {
  height: 420px;
}

/* Mobile utilities */
.softn-mobile-only {
  display: none;
}

@media (max-width: 640px) {
  .softn-mobile-hide {
    display: none !important;
  }
  .softn-mobile-only {
    display: flex !important;
  }
  .softn-page-content {
    padding: 0.875rem !important;
  }
  .showcase-3d-stage {
    height: 290px !important;
  }
}
</style>

// Main App Layout
<App theme={darkMode ? "dark" : "light"}>
  <Box style={{ display: "flex", flexDirection: "column", width: "100%", height: "100%", overflow: "hidden", background: getBgColor() }}>
    // Mobile Top Nav (wraps cleanly at 390x844 with zero horizontal overflow)
    <Box className="softn-mobile-only" style={{
      background: getSidebarBg(),
      borderBottom: "1px solid " + getBorderColor(),
      padding: "0.35rem 0.5rem",
      gap: "0.15rem",
      flexWrap: "wrap",
      alignItems: "center",
      justifyContent: "space-between",
      flexShrink: 0,
      boxSizing: "border-box"
    }}>
      <Button variant=ghost @click={navigate("charts")} style={{
        padding: "0.45rem 0.5rem", borderRadius: 0, fontSize: "0.72rem", fontWeight: 600, minWidth: 0,
        color: currentPage === "charts" ? "#6366f1" : getMutedColor(),
        borderBottom: currentPage === "charts" ? "2px solid #6366f1" : "2px solid transparent"
      }}>Charts</Button>
      <Button variant=ghost @click={navigate("controls")} style={{
        padding: "0.45rem 0.5rem", borderRadius: 0, fontSize: "0.72rem", fontWeight: 600, minWidth: 0,
        color: currentPage === "controls" ? "#6366f1" : getMutedColor(),
        borderBottom: currentPage === "controls" ? "2px solid #6366f1" : "2px solid transparent"
      }}>Controls</Button>
      <Button variant=ghost @click={navigate("animations")} style={{
        padding: "0.45rem 0.5rem", borderRadius: 0, fontSize: "0.72rem", fontWeight: 600, minWidth: 0,
        color: currentPage === "animations" ? "#6366f1" : getMutedColor(),
        borderBottom: currentPage === "animations" ? "2px solid #6366f1" : "2px solid transparent"
      }}>Motion</Button>
      <Button variant=ghost @click={navigate("interactive")} style={{
        padding: "0.45rem 0.5rem", borderRadius: 0, fontSize: "0.72rem", fontWeight: 600, minWidth: 0,
        color: currentPage === "interactive" ? "#6366f1" : getMutedColor(),
        borderBottom: currentPage === "interactive" ? "2px solid #6366f1" : "2px solid transparent"
      }}>Drag</Button>
      <Button variant=ghost @click={navigate("scene3d")} style={{
        padding: "0.45rem 0.5rem", borderRadius: 0, fontSize: "0.72rem", fontWeight: 600, minWidth: 0,
        color: currentPage === "scene3d" ? "#6366f1" : getMutedColor(),
        borderBottom: currentPage === "scene3d" ? "2px solid #6366f1" : "2px solid transparent"
      }}>3D</Button>
      <Button
        variant=ghost
        @click=toggleTheme
        ariaLabel={darkMode ? "Switch to light" : "Switch to dark"}
        title={darkMode ? "Switch to light" : "Switch to dark"}
        style={{ padding: "0.45rem 0.5rem", borderRadius: 0, flexShrink: 0, color: getMutedColor() }}
      >
        <Icon svg={darkMode ? iconSun : iconMoon} size={15} style={{ color: getMutedColor() }} />
      </Button>
    </Box>

    <Box style={{ display: "flex", flex: 1, overflow: "hidden", minWidth: 0 }}>
      // Sidebar Navigation
      <Nav />

      // Main Content Area
      <Box style={{ flex: 1, display: "flex", flexDirection: "column", overflow: "hidden", minWidth: 0, minHeight: 0 }}>
        // Page Content
        <Box className="softn-page-content" style={{ flex: 1, overflowY: "auto", overflowX: "hidden", padding: "2rem 2.5rem", minHeight: 0, minWidth: 0, boxSizing: "border-box", background: getBgColor() }}>
          <ChartsPage />
          <ControlsPage />
          <AnimationsPage />
          <InteractivePage />
          <Scene3DPage />
        </Box>
      </Box>
    </Box>
  </Box>
</App>
