// main.ui - Notes Master-Detail Workspace

<logic src="../logic/main.logic" />

<style>
.notes-app {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #09090b;
  color: #fafafa;
  box-sizing: border-box;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  flex-wrap: wrap;
  padding: 0.75rem 1.25rem;
  border-bottom: 1px solid rgba(255,255,255,0.07);
  background: rgba(18,18,22,0.92);
  backdrop-filter: blur(12px);
  flex-shrink: 0;
}

.header-icon {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.note-count-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 22px;
  height: 20px;
  padding: 0 7px;
  border-radius: 999px;
  background: rgba(99,102,241,0.18);
  color: #a5b4fc;
  font-size: 0.7rem;
  font-weight: 600;
}

.undo-toast {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  flex-wrap: wrap;
  padding: 0.5rem 1.25rem;
  background: rgba(99, 102, 241, 0.14);
  border-bottom: 1px solid rgba(99, 102, 241, 0.32);
  flex-shrink: 0;
}

.workspace-split {
  display: flex;
  flex: 1;
  min-height: 0;
  min-width: 0;
  overflow: hidden;
}

.notes-master-pane {
  width: 340px;
  flex-shrink: 0;
  border-right: 1px solid rgba(255,255,255,0.07);
  display: flex;
  flex-direction: column;
  min-height: 0;
  background: #0c0c10;
}

.notes-detail-pane {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  min-width: 0;
  background: #09090b;
  overflow: hidden;
}

.notes-scroll-list {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 0.75rem;
}

.note-row-card {
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 10px;
  padding: 0.8rem 0.9rem;
  margin-bottom: 0.55rem;
  background: rgba(24,24,29,0.65);
  cursor: pointer;
  transition: border-color 140ms ease, background 140ms ease;
}
.note-row-card:hover {
  border-color: rgba(129,140,248,0.35);
  background: rgba(30,30,38,0.88);
}

.notes-mobile-back {
  display: none;
}

@media (max-width: 768px) {
  .top-bar {
    padding: 0.65rem 0.875rem;
  }
  .notes-mobile-back {
    display: inline-flex !important;
  }
  .workspace-split[data-mobile-pane="list"] .notes-master-pane {
    width: 100%;
    border-right: none;
    flex: 1;
  }
  .workspace-split[data-mobile-pane="list"] .notes-detail-pane {
    display: none !important;
  }
  .workspace-split[data-mobile-pane="editor"] .notes-master-pane {
    display: none !important;
  }
  .workspace-split[data-mobile-pane="editor"] .notes-detail-pane {
    width: 100%;
    flex: 1;
  }
}
</style>

<App theme="dark">
  <Box className="notes-app">
    // Top Header Bar
    <Box className="top-bar">
      <Box style={{ display: "flex", alignItems: "center", gap: "0.65rem", minWidth: 0 }}>
        <Box className="header-icon">
          <Icon name="edit" size={15} color="white" />
        </Box>
        <Heading level={3} style={{ margin: 0, fontSize: "1rem", fontWeight: 700, color: "#fafafa" }}>Notes</Heading>
        <Box className="note-count-badge">{noteCount}</Box>
        <Box style={{ display: "flex", alignItems: "center", gap: "0.35rem", marginLeft: "0.25rem" }}>
          <Box style={{
            width: "7px",
            height: "7px",
            borderRadius: "50%",
            background: storageMode === "none" ? "#ef4444" : (storageMode === "local" ? "#f59e0b" : "#22c55e"),
            flexShrink: 0
          }} />
          <Text style={{ color: "#a1a1aa", fontSize: "0.72rem" }}>{statusText}</Text>
        </Box>
      </Box>

      <Box style={{ display: "flex", alignItems: "center", gap: "0.45rem", flexWrap: "wrap" }}>
        <Button if={storageMode === "none" || storageMode === "local"} variant="ghost" size=xs @click={refreshNotes} style={{ color: "#a5b4fc", fontSize: "0.72rem" }}>
          Sync Check
        </Button>
        <Button variant="primary" size=xs @click={startNewNote} style={{ background: "linear-gradient(135deg, #6366f1, #8b5cf6)", border: "none", fontWeight: 600 }}>
          + New Note
        </Button>
      </Box>
    </Box>

    // Undo Delete Banner
    <Box if={undoVisible} className="undo-toast">
      <Text style={{ fontSize: "0.78rem", color: "#e0e7ff" }}>{"Deleted \"" + deletedTitle + "\""}</Text>
      <Stack direction=horizontal gap=xs>
        <Button variant="primary" size=xs @click={undoDelete}>Undo</Button>
        <Button variant="ghost" size=xs @click={dismissUndo} style={{ color: "#a5b4fc" }}>Dismiss</Button>
      </Stack>
    </Box>

    // Responsive Master-Detail Workspace
    <Box className="workspace-split" data-mobile-pane={mobilePane}>
      // ── LEFT MASTER PANE (Search, Filters, Notes List) ──
      <Box className="notes-master-pane">
        <Box style={{ padding: "0.75rem", borderBottom: "1px solid rgba(255,255,255,0.06)" }}>
          <Stack direction=vertical gap=xs>
            <Box style={{ display: "flex", gap: "0.4rem", alignItems: "center" }}>
              <Input
                placeholder="Search title, body, or tag..."
                value={searchQuery}
                @change={updateSearchQuery}
                style={{ flex: 1, minWidth: 0, background: "rgba(255,255,255,0.04)", border: "1px solid rgba(255,255,255,0.09)", borderRadius: "8px", fontSize: "0.8rem" }}
              />
              <Button if={searchQuery !== "" || activeFilter !== "all"} variant="ghost" size=xs @click={clearSearch}>Reset</Button>
            </Box>
            <Box style={{ display: "flex", flexWrap: "wrap", gap: "0.3rem" }}>
              <Button variant={activeFilter === "all" ? "primary" : "ghost"} size=xs @click={setActiveFilter("all")}>All</Button>
              <Button variant={activeFilter === "pinned" ? "primary" : "ghost"} size=xs @click={setActiveFilter("pinned")}>Pinned</Button>
              <Button variant={activeFilter === "General" ? "primary" : "ghost"} size=xs @click={setActiveFilter("General")}>General</Button>
              <Button variant={activeFilter === "Idea" ? "primary" : "ghost"} size=xs @click={setActiveFilter("Idea")}>Idea</Button>
              <Button variant={activeFilter === "Todo" ? "primary" : "ghost"} size=xs @click={setActiveFilter("Todo")}>Todo</Button>
              <Button variant={activeFilter === "Work" ? "primary" : "ghost"} size=xs @click={setActiveFilter("Work")}>Work</Button>
            </Box>
          </Stack>
        </Box>

        <Box className="notes-scroll-list">
          #each (note in getFilteredNotes())
            <Box
              className="note-row-card"
              style={{
                borderColor: selectedNoteId === note.id ? "#6366f1" : (isPinned(note.id) ? "rgba(99, 102, 241, 0.4)" : "rgba(255,255,255,0.07)"),
                background: selectedNoteId === note.id ? "rgba(99, 102, 241, 0.12)" : "rgba(24,24,29,0.65)"
              }}
            >
              <Box @click={selectNote(note.id)} style={{ cursor: "pointer" }}>
                <Box style={{ display: "flex", alignItems: "flex-start", justifyContent: "space-between", gap: "0.5rem" }}>
                  <Text style={{ fontWeight: 600, fontSize: "0.875rem", color: "#fafafa", lineHeight: 1.35, wordBreak: "break-word" }}>
                    {(isPinned(note.id) ? "★ " : "") + (note.data.title || "Untitled")}
                  </Text>
                  <Badge if={note.data.tag} variant="info" size="xs">{note.data.tag}</Badge>
                </Box>

                <Text if={note.data.content} style={{
                  display: "-webkit-box",
                  WebkitLineClamp: 2,
                  WebkitBoxOrient: "vertical",
                  overflow: "hidden",
                  color: "#a1a1aa",
                  fontSize: "0.76rem",
                  marginTop: "0.3rem",
                  lineHeight: 1.45
                }}>{note.data.content}</Text>
              </Box>

              <Box style={{ display: "flex", alignItems: "center", justifyContent: "space-between", marginTop: "0.55rem", paddingTop: "0.45rem", borderTop: "1px solid rgba(255,255,255,0.05)" }}>
                <Text @click={selectNote(note.id)} style={{ fontSize: "0.68rem", color: "#71717a", cursor: "pointer" }}>
                  {formatDate(note.data.createdAt) + " · " + getNoteWordCount(note)}
                </Text>
                <Stack direction=horizontal gap=xs>
                  <Button variant="ghost" size=xs @click={togglePin(note.id)} style={{ padding: "2px 6px", fontSize: "0.68rem", color: isPinned(note.id) ? "#818cf8" : "#71717a" }}>
                    {isPinned(note.id) ? "Unpin" : "Pin"}
                  </Button>
                  <Button variant="ghost" size=xs @click={deleteNote(note.id)} style={{ padding: "2px 6px", fontSize: "0.68rem", color: "#f87171" }}>
                    Del
                  </Button>
                </Stack>
              </Box>
            </Box>
          #end

          // Filtered Empty State
          <Box if={noteCount > 0 && getFilteredNotes().length === 0} style={{ textAlign: "center", padding: "2.5rem 1rem" }}>
            <Text style={{ display: "block", color: "#d4d4d8", fontSize: "0.875rem", fontWeight: 600, marginBottom: "0.35rem" }}>No matching notes</Text>
            <Text style={{ display: "block", color: "#71717a", fontSize: "0.75rem", marginBottom: "0.75rem" }}>Try clearing your search or tag filter.</Text>
            <Button variant="outline" size=xs @click={clearSearch}>Clear Filters</Button>
          </Box>

          // Zero Notes Empty State
          <Box if={noteCount === 0} style={{ textAlign: "center", padding: "3rem 1rem" }}>
            <Text style={{ display: "block", color: "#e4e4e7", fontSize: "0.9rem", fontWeight: 600, marginBottom: "0.35rem" }}>Your board is empty</Text>
            <Text style={{ display: "block", color: "#71717a", fontSize: "0.78rem", marginBottom: "0.85rem" }}>
              Create your first note with Markdown formatting and instant browser or shared sync.
            </Text>
            <Button variant="primary" size=sm @click={startNewNote}>Write First Note</Button>
          </Box>
        </Box>
      </Box>

      // ── RIGHT DETAIL / EDITOR PANE ──
      <Box className="notes-detail-pane">
        // Editor Header Toolbar
        <Box style={{
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          flexWrap: "wrap",
          gap: "0.5rem",
          padding: "0.65rem 1rem",
          borderBottom: "1px solid rgba(255,255,255,0.06)",
          background: "#0d0d12",
          flexShrink: 0
        }}>
          <Box style={{ display: "flex", alignItems: "center", gap: "0.5rem", flexWrap: "wrap" }}>
            <Button className="notes-mobile-back" variant="outline" size=xs @click={backToMobileList}>
              ← All Notes
            </Button>
            <Badge variant={selectedNoteId === "" ? "warning" : "secondary"} size="sm">
              {selectedNoteId === "" ? "New Draft" : "Editing Note"}
            </Badge>
            <Text if={editorDirty} style={{ fontSize: "0.72rem", color: "#fbbf24" }}>Unsaved changes</Text>
            <Text if={!editorDirty && saveSuccessMsg !== ""} style={{ fontSize: "0.72rem", color: "#34d399" }}>{saveSuccessMsg}</Text>
          </Box>

          <Box style={{ display: "flex", alignItems: "center", gap: "0.35rem", flexWrap: "wrap" }}>
            <Button variant={previewMode ? "primary" : "outline"} size=xs @click={togglePreviewMode}>
              {previewMode ? "Edit Source" : "Preview MD"}
            </Button>
            <Button if={selectedNoteId !== ""} variant="ghost" size=xs @click={toggleEditorPin} style={{ color: isPinned(selectedNoteId) ? "#818cf8" : "#a1a1aa" }}>
              {isPinned(selectedNoteId) ? "★ Pinned" : "☆ Pin"}
            </Button>
            <Button variant="ghost" size=xs @click={copyActiveEditor} style={{ color: copiedId !== "" ? "#34d399" : "#a1a1aa" }}>
              {copiedId !== "" ? "Copied" : "Copy"}
            </Button>
            <Button if={selectedNoteId !== ""} variant="ghost" size=xs @click={deleteSelectedNote} style={{ color: "#f87171" }}>
              Delete
            </Button>
          </Box>
        </Box>

        // Editor Body
        <Box style={{ flex: 1, display: "flex", flexDirection: "column", padding: "1rem 1.25rem", overflowY: "auto", overflowX: "hidden", minHeight: 0, gap: "0.75rem" }}>
          <Input
            placeholder="Note title..."
            value={editorTitle}
            @change={updateEditorTitle}
            style={{
              width: "100%",
              boxSizing: "border-box",
              background: "rgba(255,255,255,0.03)",
              border: "1px solid rgba(255,255,255,0.09)",
              borderRadius: "8px",
              fontSize: "1rem",
              fontWeight: 600,
              padding: "0.6rem 0.8rem"
            }}
          />

          // Tag & Formatting Helper Bar
          <Box style={{ display: "flex", flexWrap: "wrap", alignItems: "center", justifyContent: "space-between", gap: "0.5rem" }}>
            <Box style={{ display: "flex", flexWrap: "wrap", gap: "0.3rem", alignItems: "center" }}>
              <Text style={{ fontSize: "0.72rem", color: "#71717a", marginRight: "0.2rem" }}>Tag:</Text>
              <Button variant={editorTag === "General" ? "primary" : "ghost"} size=xs @click={setEditorTag("General")}>General</Button>
              <Button variant={editorTag === "Idea" ? "primary" : "ghost"} size=xs @click={setEditorTag("Idea")}>Idea</Button>
              <Button variant={editorTag === "Todo" ? "primary" : "ghost"} size=xs @click={setEditorTag("Todo")}>Todo</Button>
              <Button variant={editorTag === "Work" ? "primary" : "ghost"} size=xs @click={setEditorTag("Work")}>Work</Button>
            </Box>

            <Box if={!previewMode} style={{ display: "flex", flexWrap: "wrap", gap: "0.25rem", alignItems: "center" }}>
              <Button variant="ghost" size=xs @click={insertSnippet("heading")} style={{ border: "1px solid rgba(255,255,255,0.08)", fontSize: "0.7rem" }}>H2</Button>
              <Button variant="ghost" size=xs @click={insertSnippet("bold")} style={{ border: "1px solid rgba(255,255,255,0.08)", fontSize: "0.7rem" }}>Bold</Button>
              <Button variant="ghost" size=xs @click={insertSnippet("bullet")} style={{ border: "1px solid rgba(255,255,255,0.08)", fontSize: "0.7rem" }}>• List</Button>
              <Button variant="ghost" size=xs @click={insertSnippet("todo")} style={{ border: "1px solid rgba(255,255,255,0.08)", fontSize: "0.7rem" }}>☐ Todo</Button>
              <Button variant="ghost" size=xs @click={insertSnippet("code")} style={{ border: "1px solid rgba(255,255,255,0.08)", fontSize: "0.7rem" }}>Code</Button>
            </Box>
          </Box>

          <Text if={formError !== ""} style={{ color: "#f87171", fontSize: "0.78rem" }}>{formError}</Text>

          // Markdown Write Textarea
          <TextArea
            if={!previewMode}
            placeholder="Write your note in plain text or Markdown (# headings, - bullets, - [ ] tasks)..."
            value={editorContent}
            @change={updateEditorContent}
            rows={11}
            style={{
              flex: 1,
              minHeight: "200px",
              width: "100%",
              boxSizing: "border-box",
              background: "rgba(255,255,255,0.03)",
              border: "1px solid rgba(255,255,255,0.08)",
              borderRadius: "10px",
              padding: "0.85rem",
              fontSize: "0.85rem",
              lineHeight: 1.6,
              fontFamily: "ui-monospace, Menlo, Consolas, monospace"
            }}
          />

          // Markdown Preview Surface
          <Box if={previewMode} style={{
            flex: 1,
            minHeight: "200px",
            background: "rgba(24,24,29,0.55)",
            border: "1px solid rgba(255,255,255,0.08)",
            borderRadius: "10px",
            padding: "1rem 1.125rem",
            overflowY: "auto"
          }}>
            <Stack direction=vertical gap=sm>
              #each (blk in getPreviewBlocks())
                <Heading if={blk.kind === "h1"} level={3} style={{ margin: "0.25rem 0", color: "#fafafa", fontSize: "1.2rem" }}>{blk.text}</Heading>
                <Heading if={blk.kind === "h2"} level={4} style={{ margin: "0.2rem 0", color: "#e0e7ff", fontSize: "1.02rem" }}>{blk.text}</Heading>
                <Text if={blk.kind === "todo-done"} style={{ color: "#34d399", fontSize: "0.85rem", textDecoration: "line-through" }}>{"☑ " + blk.text}</Text>
                <Text if={blk.kind === "todo-open"} style={{ color: "#e4e4e7", fontSize: "0.85rem" }}>{"☐ " + blk.text}</Text>
                <Text if={blk.kind === "bullet"} style={{ color: "#d4d4d8", fontSize: "0.85rem", paddingLeft: "0.5rem" }}>{"• " + blk.text}</Text>
                <Box if={blk.kind === "code"} style={{ background: "#18181b", border: "1px solid rgba(255,255,255,0.1)", borderRadius: "6px", padding: "0.4rem 0.65rem" }}>
                  <Text style={{ fontFamily: "monospace", fontSize: "0.8rem", color: "#a5b4fc" }}>{blk.text}</Text>
                </Box>
                <Text if={blk.kind === "p"} style={{ color: "#d4d4d8", fontSize: "0.85rem", lineHeight: 1.6 }}>{blk.text}</Text>
                <Text if={blk.kind === "empty"} style={{ color: "#71717a", fontSize: "0.82rem", fontStyle: "italic" }}>{blk.text}</Text>
              #end
            </Stack>
          </Box>

          // Editor Footer: Word/Char Telemetry + Save Button
          <Box style={{ display: "flex", flexWrap: "wrap", alignItems: "center", justifyContent: "space-between", gap: "0.75rem", paddingTop: "0.25rem" }}>
            <Text style={{ fontSize: "0.75rem", color: "#71717a", fontFamily: "ui-monospace, Menlo, Consolas, monospace" }}>
              {getEditorStatsLabel()}
            </Text>
            <Button variant="primary" size=sm @click={saveNote} style={{ background: "linear-gradient(135deg, #6366f1, #8b5cf6)", border: "none", fontWeight: 600, padding: "0.5rem 1.2rem" }}>
              {selectedNoteId === "" ? "Create Note" : "Save Changes"}
            </Button>
          </Box>
        </Box>
      </Box>
    </Box>
  </Box>
</App>
