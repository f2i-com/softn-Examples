{
  "app": {
    "id": "com.softn.notes",
    "name": "Notes",
    "version": "1.1.0"
  },
  "permissions": {
    "net": {
      "enabled": true,
      "allow_http": true,
      "allowed_hosts": [
        "localhost"
      ]
    },
    "storage": {
      "enabled": true,
      "collections": {
        "notes": "public"
      }
    },
    "sync": {
      "enabled": true
    }
  }
}
