{
  "name": "Notes",
  "version": "1.1.0",
  "description": "A persistent master-detail notes workspace with markdown preview, tag & pin filtering, undo delete, word counts, and multi-tier storage sync",
  "author": "SoftN",
  "main": "ui/main.ui",
  "icon": "assets/icon.svg",
  "files": {
    "ui": [
      "ui/main.ui"
    ],
    "logic": [
      "logic/main.logic"
    ],
    "server": [
      "server/main.logic"
    ],
    "assets": [
      "assets/icon.svg"
    ]
  },
  "server": {
    "entry": "server/main.logic",
    "routes": [
      {
        "method": "POST",
        "path": "/api/create-note",
        "handler": "handleCreateNote",
        "public": true
      },
      {
        "method": "POST",
        "path": "/api/update-note",
        "handler": "handleUpdateNote",
        "public": true
      },
      {
        "method": "GET",
        "path": "/api/notes",
        "handler": "handleGetNotes",
        "public": true
      },
      {
        "method": "POST",
        "path": "/api/delete-note",
        "handler": "handleDeleteNote",
        "public": true
      }
    ]
  },
  "config": {
    "window": {
      "title": "Notes",
      "width": 980,
      "height": 680
    },
    "theme": {
      "primary": "#6366f1",
      "mode": "dark"
    },
    "server": {
      "url": "ws://localhost:9876/sync",
      "auth_token": "test-token-123",
      "collections": [
        "notes"
      ]
    }
  }
}
