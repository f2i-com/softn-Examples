  let objects = []
  let lights = []
  let cameraPreset = "overview"
  let cameraConfig = {
    position: { x: 0, y: 3.4, z: 9.2 },
    lookAt: { x: 0, y: -0.2, z: 0 },
    fov: 48
  }

  let isAnimating = true
  let autoOrbit = true
  let bloomEnabled = true
  let showWireframe = false
  let useTextures = true

  let materialModes = ["pbr", "chrome", "matte", "neon"]
  let materialIdx = 0
  let materialMode = "pbr"

  let skies = ["sunset", "day", "night", "dusk", "overcast"]
  let skyIdx = 0
  let currentSky = "sunset"

  let selectedId = ""
  let selectedLabel = ""
  let selectedMeta = ""
  let objectCount = 0

  let elapsed = 0
  let liveFps = 60
  let _fpsAccum = 0
  let _fpsFrames = 0

  let initialObjects = []

  function cloneObj(o) {
    let copy = {}
    let keys = Object.keys(o)
    let k = 0
    while (k < keys.length) {
      copy[keys[k]] = o[keys[k]]
      k = k + 1
    }
    return copy
  }

  function roundCoord(v) {
    return Math.round((Number(v) || 0) * 10) / 10
  }

  function labelForObject(obj) {
    if (!obj) return ""
    if (obj.label) return obj.label
    if (!obj.type) return "Shape"
    return obj.type.charAt(0).toUpperCase() + obj.type.slice(1)
  }

  function describeObject(obj) {
    if (!obj) return ""
    let p = obj.position || { x: 0, y: 0, z: 0 }
    let posStr = "(" + roundCoord(p.x) + ", " + roundCoord(p.y) + ", " + roundCoord(p.z) + ")"
    if (obj.type === "model") {
      return "GLB PBR Asset · pos " + posStr + " · articulated rig"
    }
    let matInfo = showWireframe ? "wireframe" : (materialMode.toUpperCase() + " finish")
    return labelForObject(obj) + " · " + matInfo + " · pos " + posStr
  }

  function _init() {
    let colors = ["#6366f1", "#ec4899", "#14b8a6", "#f59e0b", "#ef4444", "#8b5cf6", "#22d3ee"]
    let types = ["box", "sphere", "torus", "cone", "dodecahedron", "icosahedron", "octahedron"]
    let textures = ["brick", "checker", "metal", "wood", "stone", "dots", "stripes"]
    let objs = []

    // Blender PBR hero models
    objs.push({
      id: "chrono-orrery",
      label: "Chrono Orrery",
      type: "model",
      modelUrl: "assets/models/chrono-orrery.glb",
      position: { x: 0, y: -1.5, z: 0 },
      scale: { x: 1.05, y: 1.05, z: 1.05 },
      parts: {
        Ring_Outer: { rotation: { x: 0, y: 0, z: 0 } },
        Ring_Mid: { rotation: { x: 0, y: 0, z: 0 } },
        Ring_Inner: { rotation: { x: 0, y: 0, z: 0 } }
      },
      castShadow: true,
      receiveShadow: true,
      interactive: true,
      cursor: "pointer"
    })
    objs.push({
      id: "crystal-relic-0",
      label: "Crystal Relic",
      type: "model",
      modelUrl: "assets/models/crystal-relic.glb",
      position: { x: -4.4, y: -1.5, z: -2.2 },
      scale: { x: 0.9, y: 0.9, z: 0.9 },
      parts: {
        Floating_Shard: { rotation: { x: 0, y: 0, z: 0 } },
        Halo_Ring: { rotation: { x: 0, y: 0, z: 0 } }
      },
      castShadow: true,
      receiveShadow: true,
      interactive: true,
      cursor: "pointer"
    })

    let i = 0
    let count = 7
    while (i < count) {
      let angle = (i / count) * Math.PI * 2
      let x = Math.cos(angle) * 3.4
      let z = Math.sin(angle) * 3.4
      let tName = types[i]
      let obj = {
        id: "shape-" + i,
        label: tName.charAt(0).toUpperCase() + tName.slice(1) + " #" + (i + 1),
        type: tName,
        position: { x: x, y: 0.1, z: z },
        color: colors[i],
        metalness: tName === "torus" || tName === "octahedron" ? 0.78 : 0.35,
        roughness: 0.32,
        wireframe: false,
        baseTexture: textures[i],
        texture: textures[i],
        textureRepeat: { x: 2, y: 2 },
        bumpScale: 0.05,
        castShadow: true,
        interactive: true,
        cursor: "pointer",
        animate: {
          rotateY: 0.005 + (i * 0.003),
          floatAmplitude: 0.28 + (i * 0.04),
          floatSpeed: 0.8 + (i * 0.15)
        }
      }
      if (tName === "torus") { obj.radius = 0.6 }
      if (tName === "cone") { obj.radius = 0.5; obj.height = 1.2 }
      objs.push(obj)
      i = i + 1
    }

    let ground = {
      id: "ground",
      type: "plane",
      position: { x: 0, y: -1.5, z: 0 },
      rotation: { x: -Math.PI / 2, y: 0, z: 0 },
      width: 26,
      height: 26,
      color: "#1e1b4b",
      texture: "grid",
      textureRepeat: { x: 16, y: 16 },
      metalness: 0.2,
      roughness: 0.78,
      receiveShadow: true,
      pickable: false,
      opacity: 0.88
    }
    objs.push(ground)

    objects = objs
    objectCount = objs.length - 1

    let saved = []
    let si = 0
    while (si < objs.length) {
      saved.push(cloneObj(objs[si]))
      si = si + 1
    }
    initialObjects = saved

    lights = [
      { id: "ambient", type: "ambient", color: "#556080", intensity: 0.5 },
      { id: "hemi", type: "hemisphere", color: "#dbeafe", groundColor: "#1e1b4b", intensity: 0.65 },
      { id: "dir1", type: "directional", color: "#fff2dc", intensity: 1.5, position: { x: 6, y: 10, z: 6 }, castShadow: true, shadowMapSize: 2048, follow: "view", shadowBias: -0.0003 },
      { id: "orrery-core", type: "point", color: "#fbbf24", intensity: 4.5, distance: 11, decay: 1.8, position: { x: 0, y: 0.15, z: 0 } },
      { id: "relic-glow", type: "point", color: "#c084fc", intensity: 3.2, distance: 9, decay: 1.8, position: { x: -4.4, y: 0.2, z: -2.2 } }
    ]
  }

  function _onHide() {
    isAnimating = false
    autoOrbit = false
  }

  function getSceneEffects() {
    let fx = {
      ambientOcclusion: { radius: 0.52, intensity: 0.7 }
    }
    if (bloomEnabled) {
      fx.bloom = { strength: 0.34, radius: 0.32, threshold: 0.85 }
    }
    return fx
  }

  function demoStep(rawDt) {
    let dt = typeof rawDt === "number" && rawDt > 0 ? Math.min(rawDt, 0.08) : 0.016
    _fpsAccum = _fpsAccum + dt
    _fpsFrames = _fpsFrames + 1
    if (_fpsAccum >= 0.45) {
      liveFps = Math.max(1, Math.min(120, Math.round(_fpsFrames / _fpsAccum)))
      _fpsAccum = 0
      _fpsFrames = 0
    }

    elapsed = elapsed + dt
    let updated = false
    let newObjs = []
    let i = 0
    while (i < objects.length) {
      let obj = objects[i]
      if (obj.id === "chrono-orrery") {
        let c = cloneObj(obj)
        c.parts = {
          Ring_Outer: { rotation: { x: Math.sin(elapsed * 0.45) * 0.15, y: elapsed * 0.42, z: 0 } },
          Ring_Mid: { rotation: { x: elapsed * 0.62, y: -elapsed * 0.3, z: 0.2 } },
          Ring_Inner: { rotation: { x: 0, y: elapsed * 0.95, z: Math.cos(elapsed * 0.7) * 0.35 } }
        }
        newObjs.push(c)
        updated = true
      } else if (obj.type === "model" && obj.modelUrl === "assets/models/crystal-relic.glb") {
        let c = cloneObj(obj)
        c.parts = {
          Floating_Shard: {
            position: { x: 0, y: Math.sin(elapsed * 2.1 + i) * 0.09, z: 0 },
            rotation: { x: 0, y: elapsed * 1.15, z: 0 }
          },
          Halo_Ring: {
            rotation: { x: Math.cos(elapsed * 1.3 + i) * 0.28, y: -elapsed * 0.85, z: 0 }
          }
        }
        newObjs.push(c)
        updated = true
      } else {
        newObjs.push(obj)
      }
      i = i + 1
    }
    if (updated) { objects = newObjs }
  }

  // Camera presets
  function setCameraPreset(preset) {
    cameraPreset = preset
    if (preset === "orrery") {
      cameraConfig = { position: { x: 2.8, y: 1.5, z: 3.8 }, lookAt: { x: 0, y: -0.1, z: 0 }, fov: 42 }
    } else if (preset === "aerial") {
      cameraConfig = { position: { x: 0.2, y: 10.4, z: 2.6 }, lookAt: { x: 0, y: -0.8, z: 0 }, fov: 50 }
    } else if (preset === "cinematic") {
      cameraConfig = { position: { x: -5.4, y: 0.45, z: 4.8 }, lookAt: { x: -0.6, y: -0.2, z: -0.4 }, fov: 44 }
    } else {
      cameraConfig = { position: { x: 0, y: 3.4, z: 9.2 }, lookAt: { x: 0, y: -0.2, z: 0 }, fov: 48 }
    }
  }

  function focusSelected() {
    if (selectedId === "") return
    let i = 0
    while (i < objects.length) {
      let o = objects[i]
      if (o.id === selectedId && o.position) {
        cameraPreset = "focus"
        cameraConfig = {
          position: { x: o.position.x + 2.6, y: Math.max(0.8, o.position.y + 2.0), z: o.position.z + 3.6 },
          lookAt: { x: o.position.x, y: o.position.y + 0.2, z: o.position.z },
          fov: 42
        }
        return
      }
      i = i + 1
    }
  }

  function toggleAnimating() {
    isAnimating = !isAnimating
  }

  function toggleAutoOrbit() {
    autoOrbit = !autoOrbit
  }

  function toggleBloom() {
    bloomEnabled = !bloomEnabled
  }

  function applyMaterialToShape(copy, mode, isSelected) {
    if (mode === "chrome") {
      copy.metalness = 0.94
      copy.roughness = 0.1
      copy.emissive = isSelected ? (copy.color || "#fbbf24") : "#000000"
      copy.emissiveIntensity = isSelected ? 0.55 : 0
    } else if (mode === "matte") {
      copy.metalness = 0.05
      copy.roughness = 0.88
      copy.emissive = isSelected ? (copy.color || "#fbbf24") : "#000000"
      copy.emissiveIntensity = isSelected ? 0.45 : 0
    } else if (mode === "neon") {
      copy.metalness = 0.45
      copy.roughness = 0.22
      copy.emissive = copy.color || "#38bdf8"
      copy.emissiveIntensity = isSelected ? 1.15 : 0.72
    } else {
      copy.metalness = copy.type === "torus" || copy.type === "octahedron" ? 0.78 : 0.35
      copy.roughness = 0.32
      copy.emissive = isSelected ? (copy.color || "#fbbf24") : "#000000"
      copy.emissiveIntensity = isSelected ? 0.65 : 0
    }
  }

  function cycleMaterialMode() {
    materialIdx = (materialIdx + 1) % materialModes.length
    materialMode = materialModes[materialIdx]
    let newObjs = []
    let i = 0
    while (i < objects.length) {
      let copy = cloneObj(objects[i])
      if (copy.id !== "ground" && copy.type !== "model") {
        applyMaterialToShape(copy, materialMode, copy.id === selectedId)
      }
      if (copy.id === selectedId) {
        selectedMeta = describeObject(copy)
      }
      newObjs.push(copy)
      i = i + 1
    }
    objects = newObjs
  }

  function syncSurfaceTextures(copy) {
    if (copy.id === "ground") {
      copy.wireframe = false
      copy.texture = useTextures ? "grid" : ""
      return
    }
    if (copy.type !== "model") {
      copy.wireframe = showWireframe
      // Scene3D attaches bumpMap alongside procedural textures; on GL_LINES wireframe
      // meshes, screen-space derivative bump perturbation produces NaN fragments that
      // poison bloom/post-processing. Omit procedural bump/map while wireframe is active
      // and restore baseTexture seamlessly when returning to solid mode.
      copy.texture = (useTextures && !showWireframe) ? (copy.baseTexture || "checker") : ""
    }
  }

  function toggleWireframe() {
    showWireframe = !showWireframe
    let newObjs = []
    let i = 0
    while (i < objects.length) {
      let copy = cloneObj(objects[i])
      syncSurfaceTextures(copy)
      if (copy.id === selectedId) {
        selectedMeta = describeObject(copy)
      }
      newObjs.push(copy)
      i = i + 1
    }
    objects = newObjs
  }

  function randomizeColors() {
    let palette = ["#6366f1", "#ec4899", "#14b8a6", "#f59e0b", "#ef4444", "#8b5cf6", "#22d3ee", "#a3e635", "#fb923c", "#38bdf8"]
    let newObjs = []
    let i = 0
    while (i < objects.length) {
      let copy = cloneObj(objects[i])
      if (copy.id !== "ground" && copy.type !== "model") {
        copy.color = palette[Math.floor(Math.random() * palette.length)]
        applyMaterialToShape(copy, materialMode, copy.id === selectedId)
      }
      newObjs.push(copy)
      i = i + 1
    }
    objects = newObjs
  }

  function cycleSky() {
    skyIdx = (skyIdx + 1) % skies.length
    currentSky = skies[skyIdx]
  }

  function toggleTextures() {
    useTextures = !useTextures
    let texList = ["brick", "checker", "metal", "wood", "stone", "dots", "stripes"]
    let newObjs = []
    let i = 0
    while (i < objects.length) {
      let copy = cloneObj(objects[i])
      if (copy.id !== "ground" && copy.type !== "model" && !copy.baseTexture) {
        copy.baseTexture = texList[i % texList.length]
      }
      syncSurfaceTextures(copy)
      newObjs.push(copy)
      i = i + 1
    }
    objects = newObjs
  }

  function addShape() {
    let types = ["box", "sphere", "torus", "cone", "dodecahedron", "icosahedron", "octahedron", "cylinder"]
    let colors = ["#6366f1", "#ec4899", "#14b8a6", "#f59e0b", "#ef4444", "#8b5cf6", "#22d3ee", "#a3e635"]
    let texList = ["brick", "checker", "metal", "wood", "stone", "dots", "stripes"]
    let t = types[Math.floor(Math.random() * types.length)]
    let c = colors[Math.floor(Math.random() * colors.length)]
    let baseTex = texList[Math.floor(Math.random() * texList.length)]
    let x = (Math.random() - 0.5) * 7.6
    let z = (Math.random() - 0.5) * 7.6
    let y = 0.1 + Math.random() * 1.9

    let newObj = {
      id: "shape-" + Date.now(),
      label: t.charAt(0).toUpperCase() + t.slice(1),
      type: t,
      position: { x: x, y: y, z: z },
      color: c,
      metalness: 0.35,
      roughness: 0.35,
      wireframe: showWireframe,
      baseTexture: baseTex,
      texture: (useTextures && !showWireframe) ? baseTex : "",
      textureRepeat: { x: 2, y: 2 },
      bumpScale: 0.05,
      castShadow: true,
      interactive: true,
      cursor: "pointer",
      animate: {
        rotateY: 0.005 + Math.random() * 0.02,
        floatAmplitude: 0.2 + Math.random() * 0.3,
        floatSpeed: 0.8 + Math.random() * 0.5
      }
    }
    applyMaterialToShape(newObj, materialMode, false)
    if (t === "torus") { newObj.radius = 0.55 }
    if (t === "cone" || t === "cylinder") { newObj.radius = 0.48; newObj.height = 1.1 }

    let newObjs = objects.slice()
    newObjs.push(newObj)
    objects = newObjs
    objectCount = newObjs.length - 1
  }

  function addRelic() {
    let ang = Math.random() * Math.PI * 2
    let r = 3.8 + Math.random() * 2.4
    let newRelic = {
      id: "crystal-relic-" + Date.now(),
      label: "Crystal Relic",
      type: "model",
      modelUrl: "assets/models/crystal-relic.glb",
      position: { x: Math.cos(ang) * r, y: -1.5, z: Math.sin(ang) * r },
      rotation: { x: 0, y: Math.random() * Math.PI * 2, z: 0 },
      scale: { x: 0.85, y: 0.85, z: 0.85 },
      parts: {
        Floating_Shard: { rotation: { x: 0, y: 0, z: 0 } },
        Halo_Ring: { rotation: { x: 0, y: 0, z: 0 } }
      },
      castShadow: true,
      receiveShadow: true,
      interactive: true,
      cursor: "pointer"
    }
    let newObjs = objects.slice()
    newObjs.push(newRelic)
    objects = newObjs
    objectCount = newObjs.length - 1
  }

  function clearSelected() {
    selectedId = ""
    selectedLabel = ""
    selectedMeta = ""
    let newObjs = []
    let i = 0
    while (i < objects.length) {
      let copy = cloneObj(objects[i])
      if (copy.id !== "ground" && copy.type !== "model") {
        applyMaterialToShape(copy, materialMode, false)
      }
      newObjs.push(copy)
      i = i + 1
    }
    objects = newObjs
  }

  function resetScene() {
    showWireframe = false
    useTextures = true
    bloomEnabled = true
    isAnimating = true
    autoOrbit = true
    materialIdx = 0
    materialMode = "pbr"
    selectedId = ""
    selectedLabel = ""
    selectedMeta = ""
    setCameraPreset("overview")
    let objs = []
    let i = 0
    while (i < initialObjects.length) {
      objs.push(cloneObj(initialObjects[i]))
      i = i + 1
    }
    objects = objs
    objectCount = objs.length - 1
  }

  // Resolve both GLB rootObjectId and primitive objectId cleanly
  function handleClick(info) {
    let hitId = info ? (info.rootObjectId || info.objectId || "") : ""
    if (!hitId || hitId === "ground") {
      clearSelected()
      return
    }

    let matched = false
    let newObjs = []
    let i = 0
    while (i < objects.length) {
      let obj = objects[i]
      let copy = cloneObj(obj)
      if (obj.id === hitId) {
        matched = true
        selectedId = hitId
        selectedLabel = labelForObject(obj)
        selectedMeta = describeObject(obj)
        if (obj.type !== "model") {
          applyMaterialToShape(copy, materialMode, true)
        }
      } else if (obj.id !== "ground" && obj.type !== "model") {
        applyMaterialToShape(copy, materialMode, false)
      }
      newObjs.push(copy)
      i = i + 1
    }
    if (!matched) {
      clearSelected()
      return
    }
    objects = newObjs
  }

  function removeSelected() {
    if (selectedId === "" || selectedId === "chrono-orrery") { return }
    let newObjs = []
    let i = 0
    while (i < objects.length) {
      if (objects[i].id !== selectedId) { newObjs.push(objects[i]) }
      i = i + 1
    }
    objects = newObjs
    objectCount = newObjs.length - 1
    selectedId = ""
    selectedLabel = ""
    selectedMeta = ""
  }
