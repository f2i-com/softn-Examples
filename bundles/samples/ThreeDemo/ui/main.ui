<logic src="../logic/main.logic" />

<style>
.td-root {
  width: 100%;
  height: 100%;
  overflow-y: auto;
  overflow-x: hidden;
  box-sizing: border-box;
  background: radial-gradient(120% 80% at 50% 0%, #1a1636 0%, #090916 62%);
  padding: 16px 18px 28px;
  font-family: "Segoe UI", system-ui, sans-serif;
  color: #e4e4e7;
}
.td-wrap {
  max-width: 1020px;
  width: 100%;
  margin: 0 auto;
  box-sizing: border-box;
}
.td-holder {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  max-height: 490px;
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.12);
  box-shadow: 0 18px 48px rgba(0,0,0,0.48);
  background: #0a0a1a;
}
.td-scene {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}
.td-hud-top {
  position: absolute;
  top: 10px;
  left: 10px;
  right: 10px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  pointer-events: none;
}
.td-pill {
  font-size: 11px;
  font-family: ui-monospace, Menlo, Consolas, monospace;
  color: #e4e4e7;
  background: rgba(9, 9, 22, 0.72);
  border: 1px solid rgba(255,255,255,0.12);
  padding: 3px 9px;
  border-radius: 999px;
  backdrop-filter: blur(8px);
}
.td-hint {
  position: absolute;
  left: 10px;
  bottom: 10px;
  max-width: calc(100% - 20px);
  font-size: 11px;
  color: rgba(255,255,255,0.72);
  background: rgba(9, 9, 22, 0.65);
  padding: 3px 9px;
  border-radius: 999px;
  pointer-events: none;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.td-inspector {
  margin-top: 10px;
  padding: 10px 14px;
  border-radius: 10px;
  background: rgba(24, 24, 42, 0.85);
  border: 1px solid rgba(251, 191, 36, 0.35);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.td-btn {
  padding: 7px 13px !important;
  font-size: 12.5px !important;
  border-radius: 8px !important;
}

@media (max-width: 640px) {
  .td-root {
    padding: 12px 12px 24px !important;
  }
  .td-holder {
    aspect-ratio: 4 / 3 !important;
    min-height: 265px !important;
  }
  .td-btn {
    padding: 6px 10px !important;
    font-size: 11.5px !important;
  }
}
</style>

<App theme="dark">
  <Box className="td-root">
    <Loop frame={true} running={isAnimating} @tick={demoStep} />

    <Box className="td-wrap">
      // Compact Header
      <Box style={{ display: "flex", flexWrap: "wrap", alignItems: "center", justifyContent: "space-between", gap: "8px", marginBottom: "10px" }}>
        <Box style={{ minWidth: 0 }}>
          <Heading level={2} style={{ margin: 0, fontSize: "1.4rem", fontWeight: 800, letterSpacing: "-0.02em", color: "#ffffff" }}>3D Studio Scene</Heading>
          <Text style={{ display: "block", fontSize: "0.8rem", color: "#a1a1aa", marginTop: "2px" }}>
            Articulated Chrono-Orrery, PBR relics, HDR lighting, camera presets & live material controls.
          </Text>
        </Box>
        <Stack direction="horizontal" gap={6} style={{ flexWrap: "wrap" }}>
          <Badge variant="warning" size="sm">{liveFps + " FPS"}</Badge>
          <Badge variant="info" size="sm">{objectCount + " objects"}</Badge>
        </Stack>
      </Box>

      // 3D Viewport
      <Box className="td-holder">
        <Box className="td-scene">
          <Scene3D
            fill={true}
            objects={objects}
            lights={lights}
            camera={cameraConfig}
            antialias={true}
            shadows={true}
            orbitControls={true}
            autoRotate={autoOrbit}
            autoRotateSpeed={0.8}
            maxPixelRatio={1.5}
            environment={{ url: "assets/env/studio-dusk.hdr", background: false }}
            environmentIntensity={currentSky === "night" ? 0.38 : 0.92}
            sky={currentSky}
            toneMapping="agx"
            toneMappingExposure={1.15}
            effects={getSceneEffects()}
            @click={handleClick}
          >
            #if (selectedId !== "")
              <SceneAnchor object={selectedId} offset={{ y: 1.35 }} place="above" clickThrough={true}>
                <Box style={{ background: "rgba(15, 23, 42, 0.9)", border: "1px solid rgba(251, 191, 36, 0.7)", borderRadius: "999px", padding: "3px 10px", pointerEvents: "none" }}>
                  <Text style={{ fontSize: "11px", fontWeight: 700, color: "#fef08a", whiteSpace: "nowrap" }}>{selectedLabel}</Text>
                </Box>
              </SceneAnchor>
            #end
          </Scene3D>
        </Box>

        // Non-intrusive top HUD pills
        <Box className="td-hud-top">
          <Box className="td-pill">{"sky: " + currentSky + " · mat: " + materialMode}</Box>
          <Box className="td-pill">{isAnimating ? "rig: live" : "rig: paused"}</Box>
        </Box>

        <Box className="td-hint">
          <Text style={{ fontSize: "10.5px", color: "rgba(255,255,255,0.75)" }}>drag to orbit · scroll to zoom · tap object to inspect</Text>
        </Box>
      </Box>

      // Object Selection Inspector Bar
      <Box if={selectedId !== ""} className="td-inspector">
        <Box style={{ minWidth: 0 }}>
          <Text style={{ display: "block", fontSize: "0.82rem", fontWeight: 700, color: "#fef08a" }}>{"Selected: " + selectedLabel}</Text>
          <Text style={{ display: "block", fontSize: "0.73rem", color: "#cbd5e1", fontFamily: "ui-monospace, Menlo, Consolas, monospace" }}>{selectedMeta}</Text>
        </Box>
        <Box style={{ display: "flex", flexWrap: "wrap", gap: "6px" }}>
          <Button className="td-btn" variant="outline" size="xs" @click={focusSelected}>Focus</Button>
          <Button if={selectedId !== "chrono-orrery"} className="td-btn" variant="danger" size="xs" @click={removeSelected}>Remove</Button>
          <Button className="td-btn" variant="ghost" size="xs" @click={clearSelected}>Deselect</Button>
        </Box>
      </Box>

      // Row 1: Camera & Playback Bar
      <Box style={{ display: "flex", flexWrap: "wrap", alignItems: "center", justifyContent: "space-between", gap: "8px", marginTop: "12px" }}>
        <Box style={{ display: "flex", flexWrap: "wrap", gap: "6px", alignItems: "center" }}>
          <Text style={{ fontSize: "0.72rem", color: "#a1a1aa", marginRight: "2px" }}>Camera:</Text>
          <Button className="td-btn" variant={cameraPreset === "overview" ? "primary" : "ghost"} @click={setCameraPreset("overview")} style={{ border: "1px solid rgba(255,255,255,0.12)" }}>Overview</Button>
          <Button className="td-btn" variant={cameraPreset === "orrery" ? "primary" : "ghost"} @click={setCameraPreset("orrery")} style={{ border: "1px solid rgba(255,255,255,0.12)" }}>Orrery</Button>
          <Button className="td-btn" variant={cameraPreset === "aerial" ? "primary" : "ghost"} @click={setCameraPreset("aerial")} style={{ border: "1px solid rgba(255,255,255,0.12)" }}>Top</Button>
          <Button className="td-btn" variant={cameraPreset === "cinematic" ? "primary" : "ghost"} @click={setCameraPreset("cinematic")} style={{ border: "1px solid rgba(255,255,255,0.12)" }}>Low Rim</Button>
        </Box>

        <Box style={{ display: "flex", flexWrap: "wrap", gap: "6px" }}>
          <Button className="td-btn" variant="ghost" @click={toggleAnimating} style={{ border: "1px solid rgba(255,255,255,0.14)", color: "#e4e4e7" }}>
            {isAnimating ? "Pause Rig" : "Play Rig"}
          </Button>
          <Button className="td-btn" variant="ghost" @click={toggleAutoOrbit} style={{ border: "1px solid rgba(255,255,255,0.14)", color: "#e4e4e7" }}>
            {autoOrbit ? "Orbit: Auto" : "Orbit: Manual"}
          </Button>
        </Box>
      </Box>

      // Row 2: Scene, Material, Geometry & Spawn Controls
      <Box style={{ display: "flex", flexWrap: "wrap", gap: "6px", marginTop: "8px" }}>
        <Button className="td-btn" variant="ghost" @click={addShape} style={{ background: "#f59e0b", color: "#1a1200", border: "1px solid #f59e0b", fontWeight: 700 }}>+ Shape</Button>
        <Button className="td-btn" variant="ghost" @click={addRelic} style={{ background: "rgba(168,85,247,0.22)", color: "#e9d5ff", border: "1px solid rgba(168,85,247,0.45)", fontWeight: 700 }}>+ Relic</Button>
        <Button className="td-btn" variant="ghost" @click={cycleMaterialMode} style={{ background: "rgba(255,255,255,0.06)", color: "#e4e4e7", border: "1px solid rgba(255,255,255,0.14)" }}>{"Material: " + materialMode}</Button>
        <Button className="td-btn" variant="ghost" @click={cycleSky} style={{ background: "rgba(255,255,255,0.06)", color: "#e4e4e7", border: "1px solid rgba(255,255,255,0.14)" }}>{"Sky: " + currentSky}</Button>
        <Button className="td-btn" variant="ghost" @click={toggleTextures} style={{ background: "rgba(255,255,255,0.06)", color: "#e4e4e7", border: "1px solid rgba(255,255,255,0.14)" }}>{useTextures ? "Textures: On" : "Textures: Off"}</Button>
        <Button className="td-btn" variant="ghost" @click={toggleWireframe} style={{ background: "rgba(255,255,255,0.06)", color: "#e4e4e7", border: "1px solid rgba(255,255,255,0.14)" }}>{showWireframe ? "Solid" : "Wireframe"}</Button>
        <Button className="td-btn" variant="ghost" @click={toggleBloom} style={{ background: "rgba(255,255,255,0.06)", color: "#e4e4e7", border: "1px solid rgba(255,255,255,0.14)" }}>{bloomEnabled ? "Bloom: On" : "Bloom: Off"}</Button>
        <Button className="td-btn" variant="ghost" @click={randomizeColors} style={{ background: "rgba(255,255,255,0.06)", color: "#e4e4e7", border: "1px solid rgba(255,255,255,0.14)" }}>Recolour</Button>
        <Button className="td-btn" variant="ghost" @click={resetScene} style={{ background: "transparent", color: "#a1a1aa", border: "1px solid rgba(255,255,255,0.1)" }}>Reset</Button>
      </Box>
    </Box>
  </Box>
</App>
